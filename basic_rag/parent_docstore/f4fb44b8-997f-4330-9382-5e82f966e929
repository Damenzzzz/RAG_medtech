5 \u0435\u0435\n\u0430\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0435\u043d\u0435\u0437\u0430\n\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f (\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439, \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0434\u043b\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u041f\u041c\u0421\u041f, \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0440\u0438\u0441\u043a\u0430):\n\u2022 \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445;\n\n\u2022 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u043e\u043a\u0441\u0435\u043c\u0438\u0438;\n\u2022 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438;\n\u2022 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0442\u0435\u043a\u0430, \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f, \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438;\n\u2022 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0440\u043e\u0441\u0442\u0430 \u0438 \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438 \u0440\u0435\u043f\u0430\u0440\u0430\u0446\u0438\u0438 \u043b\u0435\u0433\u043a\u0438