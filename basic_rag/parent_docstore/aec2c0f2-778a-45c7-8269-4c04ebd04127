4\u0423\u0420\u042b \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0418 \u0418\n\u041b\u0415\u0427\u0415\u041d\u0418\u042f\n1. \u0426\u0435\u043b\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:\n\n\u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043e\u0447\u0430\u0433\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0430\u043b\u044c\u0432\u0435\u043e\u043a\u043e\u043a\u043a\u043e\u0437\u043e\u043c \u043f\u0435\u0447\u0435\u043d\u0438 \u0438/\u0438\u043b\u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0438 \u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0436\u0435\u043b\u0442\u0443\u0445\u0438.\n\n26\n\n2. \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\n\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/ \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430: \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0432\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0430\u0440\u0430\u0437\u0438\u0442\u0430\u0440\u043d\u043e\u0433\u043e \u0443\u0437\u043b\u0430, \u04