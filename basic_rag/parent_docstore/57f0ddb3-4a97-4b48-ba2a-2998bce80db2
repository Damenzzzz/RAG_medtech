440\u0430\u043c\u043c\u0430\u0445 \u0438 \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u0445 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0432\n\u0431\u043e\u043a\u043e\u0432\u043e\u0439 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0440\u0435\u0442\u0440\u043e\u0441\u0442\u0435\u0440\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430;\n\n\u2022 \u041a\u0422-\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 (\u0423\u0414-\u0412) \u2013 \u0434\u043b\u044f \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0441 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u043c\u0438 \u0442\u043a\u0430\u043d\u044f\u043c\u0438 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c, \u043f\u0440\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0432\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440, \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430);\n\n6\n\n\u2022 \u0423\u0417\u0418 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 (\u0423\u0414-\u0412) \u2013 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u043f\u0440\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440;\n\u2022 \u0444\u0438\u0431\u0440\u043e\u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u2013 \u043f\u0440\u0438 \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u0442\u0440\u0430\u0445\u0435\u043e\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430;\n\u2022 \u041c\u0420\u0422 - \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u043e\u0439 \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043e\u0441\u0443\u0434\u043e\u0432 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f.\n\n2) \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044e \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0435 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f:\n\n\u041c\u0435\u0442\u043e\u0434 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0417\u0430\u0434\u0430\u0447\u0438\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u041f\u043e\u043b\u0438\u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0430\u044f \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438,\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0438 \u043f\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0444\u043e\u0440\u043c\u044b, \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432, \u043d\u0430\u043b\u0438\u0447\u0438\u044f\n\u043f\u0443\u043b\u044c\u0441\u0430\u0446\u0438\u0438, \u0432\u0437\u0430\u0438\u043c\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\n\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0441\n\u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u043c\u0438 \u043e\u0440\u0433\u0430\u043d\u0430\u043c\u0438\n\u041a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\n\u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f\n\u0424\u0422\u0411\u0421 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0418\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0438\n\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0442\u0440\u0430\u0445\u0435\u043e\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0435\u0440\u0435\u0432\u0430, \u043f\u043e\n\u0432 \u043f\u0435\u0440\u0434\u043d\u0435\u043c \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u0438, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436- \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0422\u0422\u0411\u041f\u0411\n\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438\n\u042d\u0424\u0421 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0423\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0438 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\n\u0432 \u0437\u0430\u0434\u043d\u0435\u043c \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u0438, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436- \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u043a \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0443\n\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0434\u0438\u0441\u0444\u0430\u0433\u0438\u0435\u0439, \u0441\n\u043e\u043f\u0443\u0445\u043e\u043b\u044f\u043c\u0438 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430\n\u041a\u0422\u0413 \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043f\u043e\u0433\u0440\u0430\u043c\u043c\u044b\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430, \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,\n\u043e\u043f\u0443\u0445\u043e\u043b\u0438, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0440\u043e\u0434\u044b \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,\n\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0444\u043e\u0440\u043c\u044b \u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430\n\u0442\u043a\u0430\u043d\u0438, \u0435\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043a \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u043c\n\u043e\u0440\u0433\u0430\u043d\u0430\u043c, \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432\n\u041c\u0420\u0422 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0423\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430,\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0438 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0442\u043a\u0430\u043d\u0438,\n\u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0441\u043e\u0441\u0443\u0434\u043e\u0432, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043f\u043e-\u0433\u0440\u0430\u043c\u043c\u044b\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043b\u0438\u043c\u0444\u043e\u0438\u0434\u043d\u043e\u0439 \u0438 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f,\n\n\u0445\u0440\u044f\u0449\u0435\u0432\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,\n\u0444\u043e\u0440\u043c\u044b \u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432\n\u0423\u0417\u0418 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f, (\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u043d\u043e\u0435, \u0442\u043a\u0430\u043d\u0435\u0432\u043e\u0435) \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439\n\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0442\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0440\u0430\u0441\u043f\u0430\u0434\u0430, \u0432\u044b\u043f\u043e\u0442\u0430 \u0432 \u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\n\u041f\u0440\u0435\u0441\u043a\u0430\u043b\u0435\u043d\u043d\u0430\u044f \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0445 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\n\u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u0430, \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u043e\u0432\n7\n\n\u0422\u0422\u0411\u041f\u0411 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438,\n\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f \u0441 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439\n\u043b\u0438\u043c\u0444\u043e\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f\u043c\u0438 \u0442\u043e\u0439 \u0436\u0435 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\u0422\u0422\u041f\u0411 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0412\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439\n\u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0438\n\u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0439\n\n\u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f\n\u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0420\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,\n\u0442\u043e\u0440\u0430\u043a\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\n\u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u044d\u0442\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0445\n\u0434\u043b\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f.\n\n\u041f\u0440\u0438 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\nI \u044d\u0442\u0430\u043f: \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f.\n\n\u0416\u0430\u043b\u043e\u0431\u044b \u2013 \u043d\u0430 \u043a\u0430\u0448\u0435\u043b\u044c, \u0431\u043e\u043b\u0438 \u0432 \u0410\u043d\u0430\u043c\u043d\u0435\u0437 - \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c\n\u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0435 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u041a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u043c - \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0439 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0442\u044c \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f (\u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u0438\n\u0438\u043d\u0442\u0438\u043c\u043d\u043e \u043f\u0440\u0438\u043c\u044b\u043a\u0430\u044e\u0449\u0435\u0439 \u043a \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435 \u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445) \u0438 \u0442\u0435\u043c\u043f \u0440\u043e\u0441\u0442\u0430 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 (\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u0439\n\n\u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0435. \u043f\u0440\u0438 \u0434\u043e\u0431\u0440\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445).\n\n\u0418 \u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 - \u043f\u0440\u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0445\n\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u0430\u0445 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439, \u0441\u0434\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0439 \u0438\u043b\u0438\n(\u043e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u043f\u043e\u043b\u0438\u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u0439 \u043b\u0435\u0433\u043a\u043e\u0435, \u043b\u0438\u0431\u043e \u043f\u0440\u0438 \u0441\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0438\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0432 \u0438 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438\n\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u044f\u0445, \u043c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u043e\u0441\u0443\u0434\u043e\u0432 \u0438 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0438 \u0432\n\u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f) \u2013 \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0435 \u043e\u0440\u0433\u0430\u043d\u044b, \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432, \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0435\u0433\u043e, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043e \u043d\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u0430\u043c\u0438,\n\u043a\u043e\u0441\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u043c (\u0447\u0435\u0442\u043a\u043e\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442 \u043e \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430,\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0433\u043e\u043c\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u044c) - \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0431\u0438\u043e\u043f\u0441\u0438\u0438 \u0438 \u043f\u0440\u0438 \u043e\u0442\u043a\u0430\u0437\u0435\n\u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043e\u0442 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f.\n\n\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0441 \u043e\u0441 \u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c: \u044d\u043a\u0441\u0441\u0443\u0434\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u043b\u0435\u0432\u0440\u0438\u0442\n\u043f\u0440\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0438 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u043f\u0440\u0438 \u043e\u0431\u044a\u0435\u043c\u043d\u044b \u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u0445, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0421\u0421\u0412\u041f\u0412.\n\nII \u044d\u0442\u0430\u043f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u044f:\n\n8", "type": "Document"}}