9).\n\u0421\u043a\u0435\u043b\u0435\u0442\u043d\u043e-\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c:\n\n\u2022 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0447\u043d\u043e-\u043f\u043e\u043b\u043e\u0441\u0430\u0442\u044b\u0445 \u043c\u044b\u0448\u0446:\n- \u043d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u043c\u044b\u0448\u0446 \u043f\u043b\u0435\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u044f\u0441\u0430 \u0438 \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445\n\u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u043c\u0438\u0430\u043b\u0433\u0438\u0438, \u043e\u0442\u0435\u043a\u0438 \u043c\u044b\u0448\u0446;\n- \u043d\u0430 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u043c\u0438\u043e\u0441\u043a\u043b\u0435\u0440\u043e\u0437, \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0443\u0440\u044b, \u0430\u0442\u0440\u043e\u0444\u0438\u0438 \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432\n\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439.\n\u0412\u0438\u0441\u0446\u0435\u0440\u0430\u043b\u044c\u043d\u043e-\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c:\n\u2022 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u044b\u0448\u0446, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u0443 (\u043e\u0434\u044b\u0448\u043a\u0430, \u0432\u044b\u0441\u043e\u043a\u043e\u0435 \u0441\u0442\u043e\u044f\u043d\u0438\u0435\n\u0438 \u0432\u044f\u043b\u043e\u0441\u0442\u044c \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u044d\u043a\u0441\u043a\u0443\u0440\u0441\u0438\u0438 \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u044b), \u0433\u043b\u043e\u0442\u043a\u0438, \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u0433\u043e\u0440\u0442\u0430\u043d\u0438\n\n(\u0434\u0438\u0441\u0444\u0430\u0433\u0438\u044f, \u043f\u043e\u043f\u0435\u0440\u0445\u0438\u0432\u0430\u043d\u0438\u0435, \u0434\u0438\u0441\u0444\u043e\u043d\u0438\u044f);\n\u2022 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 (\u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0438\u0442, \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f, \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a).\n\u041a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438:\n\u2022 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430;\n\n\u2022 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0432\u043e\u043b\u043e\u0441.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 1. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u041f\u041c/\u0414\u041c, \u0410\u0421\u0421 \u0438 \u043c\u0438\u043e\u0437\u0438\u0442\u0430 \u0441\n\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\u043c\u0438\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0410\u0421\u0421 \u041c\u0438\u043e\u0437\u0438\u0442 \u0441 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\u043c\u0438\n\u041f\u041c/\u0414\u041c\n\u0410.Bohan, J.B. Peter (\u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 R.C. Askanas, Di. Mauro [7]\n(1975 \u0433.) \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438) Solomon (2011\n\n\u0433.)\n1.\u0421\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0430\u044f \u0411\u043e\u043b\u044c\u0448\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438: 1. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435:\n\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f 1. \u0418\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 6 \u043c\u0435\u0441,\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u043c\u044b\u0448\u0446 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445 (\u0418\u041f\u041b), \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u2013 \u0441\u0442\u0430\u0440\u0448\u0435 30\n\n\u043f\u043b\u0435\u0447\u0435\u0432\u043e\u0433\u043e \u0438 \u0442\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0435 \u0441 \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u043b\u0435\u0442, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u0441\u0433\u0438\u0431\u0430\u0442\u0435\u043b\u0435\u0439\n\u043f\u043e\u044f\u0441\u0430, \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u0432 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044b, \u043f\u0430\u043b\u044c\u0446\u0435\u0432, \u0441\u0438\u043b\u0430 \u0441\u0433\u0438\u0431\u0430\u0442\u0435\u043b\u0435\u0439\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u0430\u043f\u044f\u0441\u0442\u044c\u044f \u0438 \u043f\u0430\u043b\u044c\u0446\u0435\u0432 \u2265\n\u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u043f\u0440\u0438\u0435\u043c\u043e\u043c \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0442\u0435\u043b\u0435\u0439\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432 2. \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435:\n\n2.\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0435 \u043a\u043e\u0436\u043d\u044b\u0435 2.\u041f\u043e\u043b\u0438\u043c\u0438\u043e\u0437\u0438\u0442 \u0438\u043b\u0438 \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n4\n\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043c\u0438\u043e\u0437\u0438\u0442, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041a\u0424\u041a\n\n3.\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u0410.Bohan, J.B. 3. \u041c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435:\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u043e \u0418-\u042d\u041c\u0413 Peter \u0438\u043d\u0432\u0430\u0437\u0438\u044f \u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u044b\u043c\u0438\n4.\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041c\u0430\u043b\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438: \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u043b\u0435\u0442\u043a\u0430\u043c\u0438\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f (\u043d\u0435\u043a\u0440\u043e\u0437 \u0438 1. \u0410\u0440\u0442\u0440\u0438\u0442\u044b \u043d\u0435\u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445\n\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f 2. \u0424\u0435\u043d\u043e\u043c\u0435\u043d \u0420\u0435\u0439\u043d\u043e \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0432\u043e\u043b\u043e\u043a\u043e\u043d,\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f 3. \u00ab\u0420\u0443\u043a\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb \u0432\u0430\u043a\u0443\u043e\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435\n\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0432\u043e\u043b\u043e\u043a\u043e\u043d) \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0435 \u0432\u043e\u043b\u043e\u043a\u043d\u0430 \u0438\u043b\u0438\n5.\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0435 \u0434\u0435\u043f\u043e\u0437\u0438\u0442\u044b\n\n\u00ab\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445\u00bb \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u0430 \u0438\u043b\u0438 15-18 \u043d\u043c\n\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432: \u041a\u0424\u041a, \u0442\u0443\u0431\u0443\u043b\u043e\u0444\u0438\u043b\u0430\u043c\u0435\u043d\u0442\u044b \u043d\u0430\n\u043c\u0438\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0438;\n\u0430\u043b\u044c\u0434\u043e\u043b\u0430\u0437\u044b, \u041b\u0414\u0413, \u0410\u0421\u0422, 4.\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u0410\u041b\u0422: \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0439 \u041f\u041c=4 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f \u043f.1-4. \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\n\u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0439 \u0414\u041c=4 \u043d\u0435\u0432\u0440\u043e\u0433\u0435\u043d\u043d\u043e\u043c\u0443 \u0442\u0438\u043f\u0443\n\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f.5. \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u043e\u0432\n\u0412\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u041f\u041c=3\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f \u043f.1-4\n\u0412\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u0414\u041c=3\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f.5.\n\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439 \u041f\u041c=2\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f \u043f.1-4\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439 \u0414\u041c=2\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f.5.\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f[1-3, 5, 7, 8, 15]:\n\u2022 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u2013 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0430\u043d\u0435\u043c\u0438\u044f, \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u043c\n\u0441\u0434\u0432\u0438\u0433\u043e\u043c \u0432\u043b\u0435\u0432\u043e, \u0440\u0435\u0436\u0435 - \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f, \u044d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u0438\u044f, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0421\u041e\u042d\n(\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439);\n\n\u2022 \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0441\u043a\u0435\u043b\u0435\u0442\u043d\u043e\u0439\n\u043c\u0443\u0441\u043a\u0443\u043b\u0430\u0442\u0443\u0440\u044b \u2013 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0444\u043e\u0441\u0444\u043e\u043a\u0438\u043d\u0430\u0437\u044b (\u041a\u0424\u041a), \u043c\u0438\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430, \u0430\u043b\u0430\u043d\u0438\u043d\u043e\u0432\u043e\u0439 (\u0410\u041b\u0422) \u0438\n\u0430\u0441\u043f\u0430\u0440\u0430\u0433\u0438\u043d\u043e\u0432\u043e\u0439 (\u0410\u0421\u0422) \u0442\u0440\u0430\u043d\u0441\u0430\u043c\u0438\u043d\u0430\u0437, \u041b\u0414\u0413;\n\n\u2022 \u0421\u0420\u0411 \u2013 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439;\n\u2022 \u0420\u0424 \u2013 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0442\u0438\u0442\u0440\u044b;\n\u2022 \u0440\u0435\u0430\u043a\u0446\u0438\u044f \u043c\u0438\u043a\u0440\u043e\u043f\u0440\u0435\u0446\u0438\u043f\u0438\u0442\u0430\u0446\u0438\u0438 \u2013 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u0438\u043f\u0438\u043d\u043e\u0432\u044b\u0445 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u043d\u0430 \u0441\u0438\u0444\u0438\u043b\u0438\u0441;\n\n\u2022 \u0418\u0424\u0410 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430 \u0438 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u043a \u0432\u0438\u0440\u0443\u0441\u0430\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u0432 \u0412 \u0438 \u0421, \u0426\u041c\u0412, \u0432\u0438\u0440\u0443\u0441\n\u042d\u043f\u0448\u0442\u0435\u0439\u043d-\u0411\u0430\u0440\u0440\u0430);\n\u2022 \u0418\u0424\u0410 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430 \u0438 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u043a \u0412\u0418\u0427;\n\u2022 \u043e\u043d\u043a\u043e\u043c\u0430\u0440\u043a\u0435\u0440\u044b \u2013 \u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0430\u0440\u0430\u043d\u0435\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0414\u041c (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c);\n\n\u2022 \u04223, \u04224, \u0422\u0422\u0413 \u2013 \u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u043e\u0439 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438.\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f[1-5,7, 8, 15]:\n\u2022 \u043e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u2013 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\n\u043b\u0435\u0433\u043a\u0438\u0445;\n\u2022 \u042d\u041a\u0413 \u2013 \u0441 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u043b\u044c\u044e;\n5\n\n\u2022 \u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043a\u043e\u0436\u043d\u043e-\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u043b\u043e\u0441\u043a\u0443\u0442\u0430 \u2013 \u0434\u043b\u044f \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430.\n\n6\n\n2) \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u0421\u0431\u043e\u0440 \u0436\u0430\u043b\u043e\u0431 \u0438 \u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u2022 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u044b\u0448\u0446\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u0448\u0435\u0438;\n\u2022 \u043f\u0435\u0440\u0438\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u0438 \u043b\u0438\u043b\u043e\u0432\u0430\u044f\n\u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u044d\u0440\u0438\u0442\u0435\u043c\u0430 (\u00ab\u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043c\u0438\u043e\u0437\u0438\u0442\u043d\u044b\u0435 \u043e\u0447\u043a\u0438\u00bb),\n\u2022 \u0413\u0438\u043f\u0435\u0440\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0435\u043c\u0438\u044f - \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u041a\u0424\u041a, \u2022 \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u0438\u0442,\n\u0442\u0440\u0430\u043d\u0441\u0430\u043c\u0438\u043d\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u0435 50% \u043e\u0442 \u043d\u043e\u0440\u043c\u044b; \u2022 \u044d\u0440\u0438\u0442\u0435\u043c\u0430 \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0442\u0435\u043b\u0430;\n\u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043c\u044b\u0448\u0446: \u2022 \u043a\u0430\u043b\u044c\u0446\u0438\u043d\u043e\u0437;\n\u2022 \u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f, \u043d\u0435\u043a\u0440\u043e\u0437 \u0442\u043a\u0430\u043d\u0438; \u2022 \u0434\u0438\u0441\u0444\u0430\u0433\u0438\u044f.\n\n\u2022 \u0431\u0430\u0437\u043e\u0444\u0438\u043b\u0438\u044f, \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u044b, \u0444\u0438\u0431\u0440\u043e\u0437.\n\n\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 3 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 2 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 2\n\u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0438 2 1 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e 2 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0438 2\n\n\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u0432 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f; \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u0432; \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0441\u044b\u043f\u0438; \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u0432 \u0438 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u0432\n\u0441\u044b\u043f\u0438;\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0439 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439\n\n\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0445\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \u0434\u043b\u044f\n\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\n7\n\n3) \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439\n\n[1-3, 5-8]:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u043b\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\n\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u041d\u0435\u0432\u0440\u043e\u0433\u0435\u043d\u043d\u044b\u0435 \u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 -\u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435", "type": "Document"}}