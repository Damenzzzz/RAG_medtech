0442\u0435\u043b\u044c \u0446\u0435\u043d\u0442\u0440\u0430 \u0430\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e \u2013 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438\n\u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb.\n\n2) \u0421\u043c\u0430\u0433\u0443\u043b\u043e\u0432\u0430 \u041a\u0430\u043b\u0434\u044b\u0433\u0443\u043b\u044c \u041a\u0430\u0431\u0430\u043a\u043e\u0432\u043d\u0430 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430 \u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e \u2013\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb.\n3) \u041a\u0438\u043c \u0412\u0438\u043a\u0442\u043e\u0440 \u0411\u043e\u0440\u0438\u0441\u043e\u0432\u0438\u0447 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0426\u0435\u043d\u0442\u0440\u0430", "type": "Document"}}