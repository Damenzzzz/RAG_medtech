26\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1,2,4,6-8,11]:\n\u0432\u0441\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0435\u0439, \u0441 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u044e,\n\n\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u0438 \u0442\u043e\u043a\u0441\u0438\u0433\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\n\u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430.\n\n5.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u0420\u0435\u0436\u0438\u043c: \u0432 \u043e\u0441\u0442\u0440\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438 \u0432 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0437\u0434\u043d\u0438\u0435 \u0441\u0440\u043e\u043a\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0430 \u0438 \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u043d \u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c.\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0441\u0442\u043e\u043b No 10, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f