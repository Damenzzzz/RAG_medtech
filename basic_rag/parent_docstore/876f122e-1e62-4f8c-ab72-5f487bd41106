4e \u0442\u0435\u0440\u0430\u043f\u0438\u044e\n\n\u041f\u0440\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0445 \u0416\u0422 \u0441 \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, IIb \u0421\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u0445 \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0430\u0440\u0434\u0438\u043e\u0432\u0435\u0440\u0441\u0438\u0438,\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d \u043b\u0438\u0434\u043e\u043a\u0430\u0438\u043d, \u0435\u0441\u043b\u0438 \u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b, \u0430\u043c\u0438\u043e\u0434\u0430\u0440\u043e\u043d\n\u0438 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u0430\u044f \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u0430/\u043d\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430\n\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0430\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043d\u0435 III B\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u043f\u0430\u0441\u043d\u043e\n\u041f\u0440\u0438 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0439 \u0438 \u043d\u0435 \u043d\u0430\u0440\u0443\u0448\u0430\u044e\u0449\u0435\u0439 \u0433\u0435\u043c\u043e\u