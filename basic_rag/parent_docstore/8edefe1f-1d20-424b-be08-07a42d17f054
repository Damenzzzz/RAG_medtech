c \u043c\u043e\u0447\u0435\u0432\u043e\u043c \u043f\u0443\u0437\u044b\u0440\u0435. \u041d\u0435\u0440\u043e\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432 \u0447\u0430\u0448\u0435\u0447\u0435\u043a \u0438\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0439 \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0441\u043b\u0435 \u043c\u043e\u0447\u0435\u0438\u0441\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u044f, \u0438\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439\n\u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b.\n\n\u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u0430\u044f \u0443\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u043f\u043e\u0447\u0435\u043a \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043f\u0438\u0435\u043b\u043e\u043d\u0435\u0444\u0440\u0438\u0442\u0430 \u0441\n\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u044d\u043a\u0441\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u043e\u0439\n\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043f\u043e\u0447\u043a\u0438.\n\u041c\u0438\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0446\u0438\u0441\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0443\u0437\u044b\u0440\u043d\u043e-\u043c\u043e\u0447\u0435\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432\u043e\u0433\u043e \u0440\u0435\u0444\u043b\u044e\u043a\u0441\u0430 \u0441\n\n\u043e\u0434\u043d\u043e\u0439 \u0438\u043b\u0438 \u0434\u0432\u0443\u0445 \u0441\