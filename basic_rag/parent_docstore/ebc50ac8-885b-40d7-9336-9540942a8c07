4f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u041e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0418\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u0430\u044f \u043c\u0430\u0441\u0441\u0430 \u0428\u043a\u0430\u043b\u0430 \u042d\u043f\u0444\u043e\u0440\u0442\u0430 \u0438 \u0425\u0440\u0430\u043f; \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0435 (\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u043d\u043e\u0447\u043d\u043e\u0435 \u0430\u043f\u043d\u043e\u044d \u0442\u0435\u043b\u0430, \u0441\u0442\u043e\u0439\u043a\u0430\u044f, \u043f\u043e\u043b\u0438\u0441\u043e\u043c\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u0430\u044f \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u044f); \u0441\u043e\u043d\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0434\u043d\u0435\u043c \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u044f \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f/\u0443\u043f\u043b\u043e \u041a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d \u0438 \u0411\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435; \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b \u043f\u043e\u0447\u0435\u043a \u0442\u043d\u0435\u043d\u0438\u044f \u0432 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u044b \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442; \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043f\u043b\u0430\u0437\u043c\u044b, \u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u044f, \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u044f, (\u043f\u043e\u043b\u0438\u043a\u0438\u0441\u0442\u043e\u0437 \u0421\u041a\u0424; \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u043d\u0438\u043a\u0442\u0443\u0440\u0438\u044f; \u0430\u043d\u0435\u043c\u0438\u044f, \u043f\u043e\u0447\u0435\u043a) \u043d\u0430 \u043a\u0440\u043e\u0432\u044c \u0438 \u0431\u0435\u043b\u043e\u043a, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u043a \u043f\u0440\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u0438\u043a\u0438\u0441\u0442\u043e\u0437\u0435 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d:\u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043c\u043e\u0447\u0435\u0432\u044b\u0432\u043e\u0434\u044f\u0449\u0438\u0445 \u043f\u0443\u0442\u0435\u0439, \u043d \u043c\u043e\u0447\u0438; \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u043c\u0438, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u043a \u0420\u0435\u043d\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0410\u0442\u0435\u0440\u043e\u0441\u043a\u043b\u0435\u0440\u043e\u0437 \u0428\u0443\u043c \u043f\u0440\u0438 \u0414\u0443\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0435 \u041f\u043e\u0436\u0438\u043b\u044b\u0435; \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u0430\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0442\u0435\u0440\u043e\u0441\u043a\u043b\u0435\u0440\u043e\u0437 (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439); \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u0438\u043b\u0438 \u041a\u0422- \u0434\u0438\u0430\u0431\u0435\u0442; \u043a\u0443\u0440\u0435\u043d\u0438\u0435; \u0430\u043d\u0433\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u043e\u0442\u0435\u043a \u043b\u0435\u0433\u043a\u0438\u0445; \u0438\u043b\u0438 \u041c\u0420- \u0448\u0443\u043c \u0432 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 \u0430\u043d\u0433\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439. \u0424\u0438\u0431\u0440\u043e\u043c\u0443\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u0430 \u0428\u0443\u043c \u043f\u0440\u0438 \u0414\u0443\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0435 \u041c\u043e\u043b\u043e\u0434\u044b\u0435; \u0447\u0430\u0449\u0435 \u0443 \u0436\u0435\u043d\u0449\u0438\u043d; \u0448\u0443\u043c \u0432 \u044f \u0434\u0438\u0441\u043f\u043b\u0430\u0437\u0438\u044f \u0430\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u044f \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u0438\u043b\u0438 \u041a\u0422- \u042d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b \u0430\u043d\u0433\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\u043b\u0438 \u041c\u0420\u0430\u043d\u0433\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0413\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u044f \u0410\u043b\u044c\u0434\u043e\u0441\u0442\u0435\u0440\u043e\u043d \u0438 \u0411\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e, \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0430\u043b\u044c\u0434\u043e\u0441\u0442\u0435\u0440\u043e\u043d\u0438\u0437\u043c (\u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u0440\u0435\u043d\u0438\u043d \u043f\u043b\u0430\u0437\u043c\u044b, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u044f \u0432 \u0440\u0430\u043d\u043d\u0435\u043c \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0432 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u043c \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0434\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u0430\u043c\u0438), \u0430\u043b\u044c\u0434\u043e\u0441\u0442\u0435\u0440\u043e\u043d/\u0440\u0435\u043d\u0438\u043d; \u0438\u043b\u0438 \u0421\u0421 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u0434\u043e 40 \u043b\u0435\u0442 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u0430\u044f \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u044f \u043d\u0430\u0445\u043e\u0434\u043a\u0430 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 (\u0440\u0435\u0434\u043a\u043e); \u0432\u0430\u0436\u043d\u043e: \u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432 \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u0441\u043d\u0438\u0436\u0430\u0442\u044c \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0430\u043b\u044c\u0434\u043e\u0441\u0442\u0435\u0440\u043e\u043d/\u0440\u0435\u043d\u0438\u043d \u0424\u0435\u043e\u0445\u0440\u043e\u043c\u043e\u0446\u0438\u0442\u043e\u043c\u0430 \u041a\u043e\u0436\u043d\u044b\u0435 \u041c\u0435\u0442\u0430\u043d\u0435\u0444\u0440\u0438\u043d\u044b \u0432 \u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b: \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0437\u043c\u0435 \u0438\u043b\u0438 \u044d\u043f\u0438\u0437\u043e\u0434\u044b \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u043d\u0435\u0439\u0440\u043e\u0444\u0438\u0431\u0440\u043e\u043c\u0430- \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0410\u0414, \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c, \u0442\u043e\u0437\u0430 (\u043f\u044f\u0442\u043d\u0430 \u201c\u043a\u043e\u0444\u0435 \u043c\u043e\u0447\u0435, \u041a\u0422 \u0438\u043b\u0438 \u041c\u0420\u0422 \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u044f \u0441 \u043c\u043e\u043b\u043e\u043a\u043e\u043c\u201d, \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0438 \u0431\u043b\u0435\u0434\u043d\u043e\u0441\u0442\u044c; \u043b\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u0410\u0414; \u043d\u0435\u0439\u0440\u043e\u0444\u0438\u0431\u0440\u043e\u043c\u044b) \u0438 \u043c\u0430\u043b\u043e\u0433\u043e \u0442\u0430\u0437\u0430; \u043f\u043e\u0434\u044a\u0435\u043c\u044b \u0410\u0414 \u043c\u043e\u0433\u0443\u0442 \u0441\u0446\u0438\u043d\u0442\u0438\u0433\u0440\u0430\u0444\u0438\u044f \u0431\u044b\u0442\u044c \u0441\u043f\u0440\u043e\u0432\u043e\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043f\u0440\u0438\u0435\u043c\u043e\u043c \u043c\u0435\u0442\u0430-123 I-\u0431\u0435\u043d\u0437\u0438\u043b- \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 (\u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432, 15 \u0433\u0443\u0430\u043d\u0438\u0434\u0438\u043d\u043e\u043c; \u043c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434\u0430, \u0441\u0438\u043c\u043f\u0430\u0442\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a\u043e\u0432, \u043e\u043f\u0438\u043e\u0438\u0434\u043e\u0432, \u0442\u0440\u0438\u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u043e\u0432) \u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u041b\u0443\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435 \u043b\u0438\u0446\u043e, \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u041a\u0443\u0448\u0438\u043d\u0433\u0430 \u0432\u0435\u0441\u0430, \u043f\u043e\u043b\u0438\u0443\u0440\u0438\u044f, \u044d\u043a\u0441\u043a\u0440\u0435\u0446\u0438\u044f \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0435, \u043f\u043e\u043b\u0438\u0434\u0438\u043f\u0441\u0438\u044f, \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\u0430 \u0441 \u043c\u043e\u0447\u043e\u0439, \u0430\u0442\u0440\u043e\u0444\u0438\u044f \u043a\u043e\u0436\u0438, \u0441\u0442\u0440\u0438\u0438, \u0434\u0438\u0430\u0431\u0435\u0442, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u0432\u0430\u044f \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u0435\u043c \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0431\u0430 \u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043e\u0432 \u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0423\u0447\u0430\u0449\u0435\u043d\u043d\u043e\u0435 \u041e\u0446\u0435\u043d\u043a\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0433\u0438\u043f\u0435\u0440- \u0438\u043b\u0438 \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u0435, \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u0438\u0440\u0435\u043e\u0437\u0430 \u0436\u0435\u043b\u0435\u0437\u044b \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u044b (\u0433\u0438\u043f\u0435\u0440- \u0438\u043b\u0438 \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c, \u0433\u0438\u043f\u043e\u0442\u0438\u0440\u0435\u043e\u0437) \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u043d\u0435\u0440\u0432\u043e\u0437\u043d\u043e\u0441\u0442\u044c, \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442 \u044c, \u0442\u0440\u0435\u0432\u043e\u0436\u043d\u043e\u0441\u0442\u044c, \u043f\u043e\u0442\u0435\u0440\u044f \u0432\u0435\u0441\u0430 \u0413\u0438\u043f\u0435\u0440\u0430\u043f\u0430\u0440\u0430\u0442\u0438\u0440\u0435\u043e\u0437 \u0411\u043e\u043b\u0438 \u0432 \u043a\u043e\u0441\u0442\u044f\u0445, \u041f\u0430\u0440\u0430\u0442\u0433\u043e\u0440\u043c\u043e\u043d, \u0413\u0438\u043f\u0435\u0440\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c\u0438\u044f, \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0433\u0438\u043f\u043e\u0444\u043e\u0441\u0444\u0430\u0442\u0435\u043c\u0438\u044f \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u044b, \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0441\u043a\u0435\u043b\u0435\u0442\u0430, \u0430\u0440\u0442\u0440\u0430\u043b\u0433\u0438\u0438, \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u0441\u0443\u0434\u043e\u0440\u043e\u0433\u0438, \u0434\u0435\u043f\u0440\u0435\u0441\u0438\u0438, \u044f\u0437\u0432\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0416\u041a\u0422, \u0437\u0430\u043f\u043e\u0440\u044b, \u0430\u0440\u0438\u0442\u043c\u0438\u0438 \u041a\u043e\u0430\u0440\u043a\u0442\u0430\u0446\u0438\u044f \u0430\u043e\u0440\u0442\u044b \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u042d\u0445\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041e\u0431\u044b\u0447\u043d\u043e \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u0438\u043b\u0438 \u0410\u0414 (\u226520/10 \u043c\u043c \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432; \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u0440\u0442.\u0441\u0442.) \u043c\u0435\u0436\u0434\u0443 \u0410\u0414 (\u226520/10 \u043c\u043c \u0440\u0442.\u0441\u0442.) \u043c\u0435\u0436\u0434\u0443 \u0432\u0435\u0440\u0445\u043d\u0438\u043c\u0438 \u0438 \u0432\u0435\u0440\u0445\u043d\u0438\u043c\u0438 \u0438 \u043d\u0438\u0436\u043d\u0438\u043c\u0438 \u043d\u0438\u0436\u043d\u0438\u043c\u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u0438/\u0438\u043b\u0438 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u043f\u0440\u0430\u0432\u043e\u0439 \u0438 \u043b\u0435\u0432\u043e\u0439 \u0440\u0443\u043a\u043e\u0439 \u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0440\u0430\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0444\u0435\u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0443\u043b\u044c\u0441\u0430\u0446\u0438\u0438; \u043d\u0438\u0437\u043a\u0438\u0439 \u041b\u041f\u0418; \u0448\u0443\u043c \u0432\u044b\u0431\u0440\u043e\u0441\u0430 \u0432 \u043c\u0435\u0436\u043b\u043e\u043f\u0430\u0442\u043e\u0447\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430; \u0443\u0437\u0443\u0440\u0430\u0446\u0438\u044f \u0440\u0435\u0431\u0435\u0440 \u043f\u0440\u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438 3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1]: \u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u2022 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0438\u0441\u043a\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0421\u0421\u041e \u0438 \u0441\u043c\u0435\u0440\u0442\u0438; \u2022 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0432\u0441\u0435\u0445 \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u043c\u044b\u0445 \u0424\u0420 (\u043a\u0443\u0440\u0435\u043d\u0438\u0435, \u0434\u0438\u0441\u043b\u0438\u043f\u0435\u0434\u0435\u043c\u0438\u044f, \u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u044f, \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0435, \u0433\u0438\u043f\u0435\u0440\u0443\u0440\u0438\u043a\u0435\u043c\u0438\u044f); \u2022 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435, \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u043f\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438/\u0438\u043b\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u041f\u041e\u041e\u0413; \u2022 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u043d\u044b\u0445 \u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 - \u0418\u0411\u0421, \u0425\u0421\u041d, 16 \u0421\u0414 \u0438 \u0442.\u0434.; \u2022 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0446\u0435\u043b\u0435\u0432\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 \u0410\u0414 <140/90 \u043c\u043c.\u0440\u0442.\u0441\u0442. (IA) \u0438\u043b\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f (\u0442\u0430\u0431\u043b\u0438\u0446\u0430 19). 3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [1]: \u2022 \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0441\u043e\u043b\u0438 \u0434\u043e <5 \u0433/\u0441\u0443\u0442 (\u0423\u0414 \u2013 IA); \u2022 \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f: \u2013 \u043c\u0435\u043d\u0435\u0435 14 \u0435\u0434*/\u043d\u0435\u0434 \u0434\u043b\u044f \u043c\u0443\u0436\u0447\u0438\u043d (\u0423\u0414 \u2013 IA); \u2013 \u043c\u0435\u043d\u0435\u0435 8 \u0435\u0434*/\u043d\u0435\u0434 \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d (\u0423\u0414 \u2013 IA); *-1 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u0430\u044f \u0435\u0434\u0438\u043d\u0438\u0446\u0430 = 125 \u043c\u043b \u0432\u0438\u043d\u0430 \u0438\u043b\u0438 250 \u043c\u043b \u043f\u0438\u0432\u0430 \u2022 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u0437\u0430\u043f\u043e\u0435\u0432 (\u0423\u0414 \u2013 IIIC); \u2022 \u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043e\u0432\u043e\u0449\u0435\u0439, \u0441\u0432\u0435\u0436\u0438\u0445 \u0444\u0440\u0443\u043a\u0442\u043e\u0432, \u0440\u044b\u0431\u044b, \u043e\u0440\u0435\u0445\u043e\u0432 \u0438 \u043d\u0435\u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u044b\u0445 \u0436\u0438\u0440\u043d\u044b\u0445 \u043a\u0438\u0441\u043b\u043e\u0442 (\u043e\u043b\u0438\u0432\u043a\u043e\u0432\u043e\u0435 \u043c\u0430\u0441\u043b\u043e), \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u044c \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043c\u044f\u0441\u0430; \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u043b\u043e\u0447\u043d\u044b\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043d\u0438\u0437\u043a\u043e\u0439 \u0436\u0438\u0440\u043d\u043e\u0441\u0442\u0438 (\u0423\u0414 \u2013 IA); \u2022 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u0441\u0441\u0443 \u0442\u0435\u043b\u0430 \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u044f (\u0418\u041c\u0422 >30 \u043a\u0433/\u043c2 \u0438\u043b\u0438 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c \u0442\u0430\u043b\u0438\u0438 >102 \u0441\u043c \u0443 \u043c\u0443\u0436\u0447\u0438\u043d \u0438 >88 \u0441\u043c \u0443 \u0436\u0435\u043d\u0449\u0438\u043d), \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u0435 \u043a \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0418\u041c\u0422 (\u043e\u043a\u043e\u043b\u043e 20-25 \u043a\u0433/\u043c2) \u0438 \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u0438 \u0442\u0430\u043b\u0438\u0438 <94 \u0441\u043c \u0443 \u043c\u0443\u0436\u0447\u0438\u043d \u0438 <80 \u0441\u043c \u0443 \u0436\u0435\u043d\u0449\u0438\u043d \u0441 \u0446\u0435\u043b\u044c\u044e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u0410\u0414 \u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u0421\u0421\u0420 (\u0423\u0414 \u2013 IA); \u2022 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e\u0442\u0441\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f (\u043d\u0435 \u043c\u0435\u043d\u0435\u0435 30 \u043c\u0438\u043d \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438 5-7 \u0434\u043d\u0435\u0439/\u043d\u0435\u0434) (\u0423\u0414 \u2013 I A); \u2022 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e\u0442\u0441\u044f \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a\u0443\u0440\u0435\u043d\u0438\u044f,", "type": "Document"}}