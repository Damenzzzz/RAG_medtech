f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0433\u043e\n\n\u0440\u0438\u0441\u043a\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043a\u0430\u043a \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c, \u0442\u0430\u043a \u0438 \u043c\u0435\u0434\u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u0430\u043c. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043e\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0430\u0441\u0442\u043c\u044b \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0414\u0410\u0418 \u0447\u0435\u0440\u0435\u0437\n\u0441\u043f\u0435\u0439\u0441\u0435\u0440 \u0441 \u043c\u0443\u043d\u0434\u0448\u0442\u0443\u043a\u043e\u043c \u0438\u043b\u0438 \u043f\u043b\u043e\u0442\u043d\u043e \u043f\u0440\u0438\u043b\u0435\u0433\u0430\u044e\u0449\u0435\u0439 \u043c\u0430\u0441\u043a\u043e\u0439 \u0434\u043b\u044f \u043b\u0438\u0446\u0430.\n\u2022 \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0438\u043d\u0433\u0430\u043b\u044f\u0442\u043e\u0440\u0430 (\u0438\u0413\u041a\u0421, \u0414\u0414\u0411\u0410, \u041a\u0414\u0411\u0410) \u0441\u0442\u0440\u043e\u0433\u043e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f\n\n\u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\n\u2022 \u041d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u043f\u0438\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u044e \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u0430 COVID-19 \u0438\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u043e\u043c.\n\n2.2 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c [1,26]\n\u041e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u044f\u0441\u044c \u043d\u0430 \u0436\u0430\u043b\u043e\u0431\u044b, \u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0434\u0430\u043d\u043d\u044b\u0435 \u0444\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0438\n\u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043f\u043e \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0430\u0441\u0442\u043c\u044b (\u0420\u0438\u0441\u0443\u043d\u043e\u043a 1).\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a 1. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0411\u0410\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 7. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u043e\u0439\n\u0411\u0410 [1, 18]\n\n\u0410\u043d\u0430\u043c\u043d\u0435\u0437 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0414\u0430\u043d\u043d\u044b\u0435, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0438\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u0421\u0432\u0438\u0441\u0442\u044f\u0449\u0435\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u2022 \u0418\u043c\u0435\u0435\u0442\u0441\u044f 2 \u0438 \u0431\u043e\u043b\u0435\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u041e\u0434\u044b\u0448\u043a\u0430 \u2022 \u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0441 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c\n\u041a\u0430\u0448\u0435\u043b\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\n\u0427\u0443\u0432\u0441\u0442\u0432\u043e \u0441\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u0433\u0440\u0443\u0434\u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u2022 \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0447\u0430\u0441\u0442\u043e \u0443\u0445\u0443\u0434\u0448\u0430\u044e\u0442\u0441\u044f \u0432 \u043d\u043e\u0447\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0438\u043b\u0438\n\u043f\u0440\u0438 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430\u0445\n\u2022 \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0447\u0430\u0449\u0435 \u043f\u0440\u043e\u0432\u043e\u0446\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0444\u0438\u0437\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439,\n\u0441\u043c\u0435\u0445\u043e\u043c, \u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u0430\u043c\u0438, \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u043e\u043c,\n\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438\n\n\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u041d\u0430 \u0444\u043e\u043d\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u041e\u0424\u0412 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n1\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0432\u044b\u0434\u043e\u0445\u0430 \u041e\u0424\u0412 /\u0424\u0416\u0415\u041b \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0438\u0436\u043d\u0435\u0439 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043d\u043e\u0440\u043c\u044b\n1\n\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u0430 \u0441 \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u043c \u041f\u0440\u0438\u0440\u043e\u0441\u0442 \u041e\u0424\u04121>12% \u0438 >200 \u043c\u043b (\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u0435\u0435\n\u041e\u0412\u04241>15% \u0438 400 \u043c\u043b). \u0414\u043e \u0442\u0435\u0441\u0442\u0430 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\n\u041a\u0414\u0411\u0410\u22654\u0447, \u0414\u0414\u0411\u0410 \u0434\u0432\u0443\u0445\u043a\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f 24 \u0447,\n\u0414\u0414\u0411\u0410 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0435\u043c\u0430 36 \u0447\n\u0412\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u041f\u0421\u0412, \u0421\u0440\u0435\u0434\u043d\u0435\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0432\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u041f\u0421\u0412>10%\n\u0438\u0437\u043c\u0435\u0440\u044f\u0435\u043c\u043e\u0433\u043e 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2 \u043d\u0435\u0434\u0435\u043b\u044c\n\u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043b\u0435\u0433\u043a\u0438\u0445 \u043f\u043e\u0441\u043b\u0435 4-\u0445 \u043d\u0435\u0434\u0435\u043b\u044c \u041f\u0440\u0438\u0440\u043e\u0441\u0442 \u041e\u0424\u04121> 12% \u0438\u043b\u0438 >200 \u043c\u043b \u0438\u043b\u0438 \u041f\u0421\u0412>20% \u043f\u043e\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c\n\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u0441\u0442 \u0441 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u041e\u0424\u04121>10% \u0438 >200 \u043c\u043b \u043e\u0442 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0433\u043e\n\u0443\u0440\u043e\u0432\u043d\u044f\n\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0431\u0440\u043e\u043d\u0445\u043e\u043f\u0440\u043e\u0432\u043e\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0442\u0435\u0441\u0442 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u041e\u0424\u04121 \u043d\u0430 20% \u043f\u0440\u0438\n\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445 \u043c\u0435\u0442\u0430\u0445\u043e\u043b\u0438\u043d\u0430\n\u0412\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u041a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f \u041e\u0424\u04121>12% \u0438\u043b\u0438 >200 \u043c\u043b \u043c\u0435\u0436\u0434\u0443\n\u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u0438\u0435\u043c\u0430\u043c\u0438 \u043f\u0440\u0438\u0435\u043c\u0430\u043c\u0438, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0441\u043b\u0443\u0447\u0430\u0438\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 8. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0438\u0435 \u0411\u0410 \u043d\u0430 \u0444\u043e\u043d\u0435\n\u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f [1, 18]\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0414\u0430\u043d\u043d\u044b\u0435, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0438\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u0412\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0411\u0410. \u041e\u0446\u0435\u043d\u043a\u0430 \u0443\u0440\u043e\u0432\u043d\u044f\n\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0438 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u0431\u0430\u0437\u0438\u0441\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0412\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432, \u043d\u043e \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043c\u0435\u043d\u044b\n\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0431\u0440\u043e\u043d\u0445\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440\u0430 (4 \u0447 \u041a\u0414\u0411\u0410, 24 \u0447 \u0434\u043b\u044f\n\u0434\u0432\u0443\u0445\u043a\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0413\u041a\u0421-\u0414\u0414\u0411\u0410, 36 \u0447 \u0434\u043b\u044f\n\u0413\u041a\u0421-\u0414\u0414\u0411\u0410 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438) \u0438\u043b\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430.\n\u0415\u0441\u043b\u0438 \u041e\u0424\u04121>70% \u043e\u0442 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0433\u043e: \u043f\u0440\u043e\u0432\u0435\u0434\u0438\u0442\u0435\n\u0431\u0440\u043e\u043d\u0445\u043e\u043f\u0440\u043e\u0432\u043e\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0442\u0435\u0441\u0442. \u0415\u0441\u043b\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439, \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430 \u0441\u0442\u0443\u043f\u0435\u043d\u044c\n\u043d\u0438\u0436\u0435 \u0431\u0430\u0437\u0438\u0441\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0447\u0435\u0440\u0435\u0437 2-4\n\u043d\u0435\u0434\u0435\u043b\u0438\n\u0415\u0441\u043b\u0438 \u041e\u0424\u04121<70% \u043e\u0442 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0433\u043e: \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0441\u0442\u0443\u043f\u0435\u043d\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0447\u0435\u0440\u0435\u0437 3\n\u043c\u0435\u0441\u044f\u0446\u0430 (\u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0438 \u043e\u0446\u0435\u043d\u0438\u0442\u044c\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b)\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432, \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u0441 \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u043c, \u0442\u0430\u043a\u0436\u0435\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043c\u0435\u043d\u044b \u0431\u0440\u043e\u043d\u0445\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440\u0430. \u0415\u0441\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0432\n\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043d\u043e\u0440\u043c\u0435, \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437.\n\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430 \u0441\u0442\u0443\u043f\u0435\u043d\u044c \u043d\u0438\u0436\u0435\n\u0415\u0441\u043b\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u0438\u043b\u0438\u0441\u044c \u0438 \u0441\u043d\u0438\u0436\u0430\u0435\u0442\u0441\u044f\n\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445: \u0430\u0441\u0442\u043c\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f. \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0441\u0442\u0443\u043f\u0435\u043d\u044c \u0434\u043e \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0439 \u043d\u0430\u0438\u043c\u0435\u043d\u044c\u0448\u0435\u0439\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0434\u043e\u0437\u044b\n\u0415\u0441\u043b\u0438 \u043d\u0435\u0442 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0445 \u0438\u043b\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u043b\u0435\u0433\u043a\u0438\u0445 \u043d\u0430 \u0441\u0430\u043c\u044b\u0445 \u043d\u0438\u0437\u043a\u0438\u0445 \u0434\u043e\u0437\u0430\u0445 \u0431\u0430\u0437\u0438\u0441\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438:\n\u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0431\u0430\u0437\u0438\u0441\u043d\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e \u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0437\u0430\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0430 \u0432\u043e\u0437\u0434\u0443\u0445\u0430 \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0441\u0442\u0443\u043f\u0435\u043d\u044c\n\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u0441\u0440\u043e\u043a\u043e\u043c \u043d\u0430 3 \u043c\u0435\u0441\u044f\u0446\u0430, \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043e\u0446\u0435\u043d\u0438\u0442\u044c\n\u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u0415\u0441\u043b\u0438 \u043d\u0435\u0442 \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u044e, \u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u0438\u0442\u044c\n\u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043d\u0430\n\u0434\u043e\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435. \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0430\u0441\u0442\u043c\u0430-\n\u0425\u041e\u0411\u041b \u043e\u0432\u0435\u0440\u043b\u0430\u043f \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n\n\u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0411\u0410 \u043c\u043e\u0433\u0443\u0442 \u0438\u043c\u0435\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, 