2\u041e\u041b\u041e\u0413\u0418\u042f \u041f\u041b\u0410\u0426\u0415\u041d\u0422\u042b\n\n1. \u0412\u0412\u041e\u0414\u041d\u0410\u042f \u0427\u0410\u0421\u0422\u042c\n\n1.1 \u041a\u043e\u0434(\u044b) \u041c\u041a\u0411-10:\n\u041c\u041a\u0411-10\n\u041a\u043e\u0434 \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\n\u041e44 \u041f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\n\u041e44.0 \u041f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u0443\u0442\u043e\u0447\u043d\u0451\u043d\u043d\u043e\u0435 \u043a\u0430\u043a \u0431\u0435\u0437 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f. \u041d\u0438\u0437\u043a\u043e\u0435\n\u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u0443\u0442\u043e\u0447\u043d\u0451\u043d\u043d\u043e\u0435 \u043a\u0430\u043a \u0431\u0435\u0437 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f.\n\u041e44.1 \u041f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u0441 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c.\n\u041d\u0438\u0437\u043a\u043e\u0435 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u0431\u0435\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0438\u043b\u0438 \u0441\n\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c.\n\u041f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b (\u043a\u0440\u0430\u0435\u0432\u043e\u0435, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435, \u043f\u043e\u043b\u043d\u043e\u0435) \u0431\u0435\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0438\u043b\u0438 \u0441 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c\n\n1.2 \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438: 2017 \u0433\u043e\u0434 (\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 2024 \u0433\u043e\u0434).\n\n1.3 \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\u041c\u041a\u0411-10 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 10 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\n\n\u041c\u0420\u0422 \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e-\u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u041f\u041c\u0421\u041f \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u043c\u0435\u0434\u0438\u043a\u043e \u0441\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c\n\u041f\u041e\u0420\u041d\u041f \u043f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0442\u0441\u043b\u043e\u0439\u043a\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0439 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\n\u041f\u041f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\u0422\u0412\u0421 \u0442\u0440\u0430\u043d\u0441\u0432\u0430\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u0423\u0417\u0418 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0426\u0414\u041a \u0426\u0432\u0435\u0442\u043d\u043e\u0435 \u0434\u043e\u043f\u043b\u0435\u0440\u043e\u0432\u0441\u043a\u043e\u0435 \u043a\u0430\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\nFIGO International Federation of Gynecology and Obstetrics (\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f\n\u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f \u0430\u043a\u0443\u0448\u0435\u0440\u043e\u0432-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u043e\u0432)\n\n1.4 \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0430\u043a\u0443\u0448\u0435\u0440\u044b-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438, \u0430\u043d\u0433\u0438\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438, \u0432\u0440\u0430\u0447\u0438\n\u0438\u043d\u0442\u0435\u0440\u0432\u0435\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438.\n1.5 \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435.\n1.6 \u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438[1]:\n\n\u0423\u0440\u043e\u0432\u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0413\u0440\u0430\u0434\u0430\u0446\u0438\u0438\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439\n\u0421\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440, I A\n\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0421\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u043a\u043e\u0433\u043e\u0440\u0442\u043d\u044b\u0445 II B\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u0438\u043b\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0435\n\n\u043a\u043e\u0433\u043e\u0440\u0442\u043d\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u0438\u043f\u0430 \"\u0441\u043b\u0443\u0447\u0430\u0439- III B\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\" (\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0435, \u043b\u0438\u0431\u043e\n\u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440\n\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445)\n\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0441\u0435\u0440\u0438\u0438 \u0441\u043b\u0443\u0447\u0430\u0435\u0432, IV C\n\u043d\u0438\u0437\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043a\u043e\u0433\u043e\u0440\u0442\u043d\u044b\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u041c\u043d\u0435\u043d\u0438\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432 \u0431\u0435\u0437 \u0442\u043e\u0447\u043d\u043e\u0439 V D\n\u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0446\u0435\u043d\u043a\u0438\n\n1.7 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435:\n\u041f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u2013 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0438\u043b\u0438\n\u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0439 \u0437\u0435\u0432[2]. \u041f\u0440\u0438 \u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0438 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430\n\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043f\u0443\u0442\u0438 \u0440\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u043f\u043b\u043e\u0434\u0430.\n\u041d\u0438\u0437\u043a\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u2013 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d\u0430\n\n\u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 20 \u043c\u043c \u043e\u0442 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u043c\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0437\u0435\u0432\u0430, \u043d\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0435\u0433\u043e\n[3,4].\n\u0412\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u2013 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u043d\u0432\u0430\u0437\u0438\u044f \u0442\u0440\u043e\u0444\u043e\u0431\u043b\u0430\u0441\u0442\u0430, \u0447\u0430\u0441\u0442\u0438 \u0438\u043b\u0438 \u0432\u0441\u0435\u0439 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u0432\n\u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u0439 \u043c\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438[5].\n\n\u0421\u0440\u043e\u043a \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u201c\u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u0438\u043b\u0438 \u043d\u0438\u0437\u043a\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\u201d \u043f\u043e\u0441\u043b\u0435 16 \u043d\u0435\u0434\u0435\u043b\u044c \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438[2].\n\n1.8 \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0432\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u043f\u043e FIGO[6]:\n\uf0fc \u043f\u0440\u0438\u0440\u043e\u0441\u0448\u0430\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0443 (placenta accreta) \u2013 \u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u044e;\n\uf0fc \u0432\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430 (placenta increta) \u2013 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438;\n\n\uf0fc \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430 (placenta percreta) \u2013 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0441\u0435\u0440\u043e\u0437\u043d\u043e\u0433\u043e \u0441\u043b\u043e\u044f \u0438/\u0438\u043b\u0438\n\u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432.\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0432\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u043f\u043e FIGO, \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435,\n\u043c\u0430\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0435\u0439 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f\n\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0432 \u0422\u0430\u0431\u043b\u0438\u0446\u0435 1.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0432\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u043f\u043e FIGO[6]\n\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041c\u0430\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0432\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n1 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u041e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041c\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u0433\u0440\u044b\u0436\u0430 \u043d\u0435 \u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f\n(placenta \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u043d\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f, \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u044b\u0439 \u0440\u0438\u0441\u0443\u043d\u043e\u043a\n\nadherenta or \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043f\u0440\u0438 \u043d\u0435\u043e\u0441\u043e\u0441\u0443\u0434\u044b \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u0433\u043e\n\u0430creta) \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0442\u0440\u043e\u0444\u043e\u0431\u043b\u0430\u0441\u0442\u0430,\n\u043f\u043b\u043e\u0442\u043d\u043e\u0435 \u0443\u0442\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432\u044b\u0445\u043e\u0434\u044f\u0449\u0435\u0433\u043e \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430\n\u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0434\u0435\u0446\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439\n\u0438\u043b\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0438 \u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u044f\n\u043f\u0440\u0438\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0442\u0440\u0430\u043a\u0446\u0438\u0439 \u0437\u0430 \u043f\u0440\u0438 \u043e\u043a\u0440\u0430\u0441\u043a\u0435\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u043a \u043f\u0443\u043f\u043e\u0432\u0438\u043d\u0443. \u0433\u0435\u043c\u0430\u0442\u043e\u043a\u0441\u0438\u043b\u0438\u043d-\u044d\u043e\u0437\u0438\u043d\u043e\u043c.\n\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u043c\u0443 \u041f\u043e\u043f\u044b\u0442\u043a\u0438 \u0440\u0443\u0447\u043d\u043e\u0433\u043e\n\u0441\u043b\u043e\u044e. \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043a\n\u0441\u0438\u043b\u044c\u043d\u043e\u043c\u0443\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044e.\n2 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u041f\u043b\u0430\u0446\u0435\u043d\u0442\u0430 \u043d\u0435 \u041d\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0447\u043d\u043e\u043c \u0441\u0440\u0435\u0437\u0435 \u0412\u043e\u0440\u0441\u0438\u043d\u044b \u0445\u043e\u0440\u0438\u043e\u043d\u0430\n(placenta \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0447\u0435\u0442\u043a\u0430\u044f \u0433\u0440\u0430\u043d\u0438\u0446\u0430 \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0442 \u0432\u043d\u0443\u0442\u0440\u044c\nincreta) \u0441\u0435\u0440\u043e\u0437\u043d\u0443\u044e \u043c\u0435\u0436\u0434\u0443 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u043e\u0439 \u0438 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0432\u043e\u043b\u043e\u043a\u043e\u043d,\n\n\u0432\u043e\u0440\u0441\u0438\u043d\u044b \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0443. \u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u043c \u0431\u0435\u0437 \u0438\u043d\u043e\u0433\u0434\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u0432\n\u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u044e\u0442 \u041c\u0430\u0442\u043a\u0430 \u043d\u0430\u0434 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0432\u0435\u0442\u0435 \u0441\u043e\u0441\u0443\u0434\u043e\u0432\n\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0439 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u043e\u0439 \u043c\u043e\u0436\u0435\u0442 \u0441\u043b\u043e\u044f \u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u044f\n\u0441\u043b\u043e\u0439, \u0438\u043c\u0435\u0442\u044c \u0441\u0438\u043d\u0435\u0432\u0430\u0442\u043e-\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u0430\u044f \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u044b\u0439\n\u0438\u043d\u0432\u0430\u0437\u0438\u044f \u043e\u043a\u0440\u0430\u0441 \u0438 \u043c\u043e\u0436\u0435\u0442\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f\n\u201c\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430\u0440\u043d\u0430\u044f\n\u0433\u0440\u044b\u0436\u0430\". \u0422\u0440\u0430\u043a\u0446\u0438\u044f\n\u0437\u0430 \u043f\u0443\u043f\u043e\u0432\u0438\u043d\u0443\n\u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043a\n\u0432\u0442\u044f\u0433\u0438\u0432\u0430\u043d\u0438\u044e\n\u043c\u0430\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0431\u0435\u0437\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b.\n3 \u0441\u0442\u0435\u043f\u0435\u043d\u044c\n\n(placenta\npercreta)\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c 3\u0430: \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u041f\u043b\u0430\u0446\u0435\u043d\u0442\u0430\u0440\u043d\u0430\u044f \u0442\u043a\u0430\u043d\u044c \u0412\u043e\u0440\u0441\u0438\u043d\u044b \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b \u0434\u043e \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0442 \u0432 \u0441\u0435\u0440\u043e\u0437\u043d\u0443\u044e\n\u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0441\u0435\u0440\u043e\u0437\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043c\u0430\u0442\u043a\u0438. \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0443 \u043c\u0430\u0442\u043a\u0438\n\u0432\u0441\u0435 \u0441\u043b\u043e\u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u0430 \u043c\u0430\u0442\u043a\u0438 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u043d\u0432\u0430\u0437\u0438\u044f \u0432\n\u043c\u0430\u0442\u043a\u0438, \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e \u0434\u0440\u0443\u0433\u043e\u0439\n\u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043e\u0440\u0433\u0430\u043d, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u0430\u0434\u043d\u044e\u044e\n\u0438\u043d\u0432\u0430\u0437\u0438\u044f \u0441\u0442\u0435\u043d\u043a\u0443 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\u043f\u0443\u0437\u044b\u0440\u044f (\u043c\u0435\u0436\u0434\u0443\n\u043c\u043e\u0447\u0435\u0432\u044b\u043c \u043f\u0443\u0437\u044b\u0440\u0435\u043c \u0438\n\u043c\u0430\u0442\u043a\u043e\u0439 \u043c\u043e\u0436\u043d\u043e\n\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0447\u0435\u0442\u043a\u0443\u044e\n\u0433\u0440\u0430\u043d\u0438\u0446\u0443)\n\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c 3b: \u0441 \u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u041d\u0435\u0447\u0435\u0442\u043a\u0430\u044f \u0433\u0440\u0430\u043d\u0438\u0446\u0430 \u043c\u0435\u0436\u0434\u0443 \u0412\u043e\u0440\u0441\u0438\u043d\u044b \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b\n\u0438\u043d\u0432\u0430\u0437\u0438\u0435\u0439 \u0432 \u0432\u043e\u0440\u0441\u0438\u043d\u044b \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u043e\u0439 \u0438 \u041f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u044e\u0442 \u0441\u0435\u0440\u043e\u0437\u043d\u0443\u044e\n\u043c\u043e\u0447\u0435\u0432\u043e\u0439 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u043c\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u0435\u043c \u0441 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0443\n\u043f\u0443\u0437\u044b\u0440