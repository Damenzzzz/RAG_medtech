u0434\u0441\u0442\u0432\u043e\n\u0434\u0440\u043e\u0442\u0430\u0432\u0435\u0440\u0438\u043d \u0412\u043d\u0443\u0442\u0440\u044c \u2014 \u043f\u043e 2\u20133 \u0440\u0430\u0437\u0430 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c, \u043f\u043e \u043c\u0435\u0440\u0435 \u0441\u043f\u0430\u0437\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0421\n0,04\u20130,08 \u0433. \u0441\u0443\u0442\u043a\u0438 \u043f/\u043a, \u0432/\u043c \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n\u0412/\u043c, \u043f/\u043a \u2014 \u0441\u043f\u0430\u0437\u043c\u0430\n2\u20134 \u043c\u043b\n\u0430\u0442\u0440\u043e\u043f\u0438\u043d\u0430 0,00025- \u043f\u0435\u0440\u0435\u0434 \u043f/\u043a, \u0434\u043b\u044f \u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0412\n\u0441\u0443\u043b\u044c\u0444\u0430\u0442 0,005-0,001 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0432/\u0432, \u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u0438\n\u043c\u0433 \u0432/\u043c\n1 % \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n\u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 4\u043c\u0433/1\u043c\u043b \u043f\u0440\u0438 \u0432/\u043c \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e \u0410\n\u0443\u0440\u0433\u0435\u043d\u0442\u043d\u044b\u0445 \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0438\u0434\u043d\u044b\u0439 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442,\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u0445 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043a\u0430\u043b\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434 40-50 \u043c\u043b 1 \u0440\u0430\u0437 \u0432/\u0432, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0412\n2,5 \u0433 \u0432 500 \u043c\u043b \u043a\u0430\u043f\u0435\u043b\u044c\u043d \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u044b\u0445\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439\n\u0432 \u043a\u0440\u043e\u0432\u0438\n\u0410\u043d\u0442\u0438\u0441\u04356\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0445\u043b\u043e\u0440\u0433\u0435\u043a\u0441\u0438\u0434\u0438\u043d 0,05% \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d \u043f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a \u0410\n\u0432\u043e\u0434\u043d\u044b\u0439 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d \u0438\n\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f,\n\u0440\u0443\u043a\n\u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\n\u044d\u0442\u0430\u043d\u043e\u043b, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 70%; \u0434\u043b\u044f \u0410\n\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\n13\n\n\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f,\n\n\u0440\u0443\u043a\n\u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d 10%-200 \u043c\u043b, \u0434\u043e\u0437\u0430 \u0438 \u0432/\u0432 \u043f\u043e \u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0412\n20%-100,0 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430 \u043a\u0430\u043f\u0435\u043b\u044c\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u043c\u043b. \u0446\u0438\u044f \u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f - \u0434\u043b\u044f\n\u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u0443\u0440\u043e\u0432\u043d\u044f \u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u0438\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\u0430\n\u0432 \u043a\u0440\u043e\u0432\u0438.\n\u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043d\u0430\u044f \u041f\u043e 1-2 \u0440\u0430\u0437\u0430 \u0432/\u0432 \u043a\u0430\u043f \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0410\n\u0432\u0437\u0432\u0435\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0435\u043b\u044c\u043d\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 \u043a\u0440\u043e\u0432\u0438\n\u043b\u0435\u0439\u043a\u043e\u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432 - \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u0430\u043d\u043d\u0430\u044f, 350 \u043c\u043b \u0430\u043d\u0435\u043c\u0438\u0438\n\n\u0441\u0432\u0435\u0436\u0435\u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435 220 \u043c\u043b 1-2 \u0440\u0430\u0437\u0430 \u0432/\u0432 \u043a\u0430\u043f \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0410\n\u043d\u043d\u0430\u044f \u043f\u043b\u0430\u0437\u043c\u0430 \u0435\u043b\u044c\u043d\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432\n\u043a\u0440\u043e\u0432\u0438- \u0434\u043b\u044f\n\u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438\n\u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0434\u043b\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043a \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u041a\u041f.\n\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0438\u0434\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u043d\u0435\u0442\n\n7) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\u2022 \u043a\u043e\u043d\u0441\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0445\u0438\u0440\u0443\u0440\u0433\u0430 \u2013 \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043f\u0435\u0440\u0438\u044d\u0437\u043e\u0444\u0430\u0433\u0430\u043b\u044c\u043d\u044b\u0445\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 \u2013 \u0432 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0442\u044f\u0436\u0451\u043b\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u043f\u043e \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0438 \u043e\u0431\u044a\u0451\u043c\u0430 \u0434\u0435\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0437\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \u2013 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\n8) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438:\n\u0412 \u043f\u0430\u043b\u0430\u0442\u044b \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\n\u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u0441 \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 (\u043e\u0441\u0442\u0440\u0430\u044f\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u043e\u043a, \u0433\u0438\u043f\u043e\u0432\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0448\u043e\u043a, \u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0435\u043d\u043d\u044b\u0439 \u0448\u043e\u043a \u0438 \u0434\u0440.), \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0434\u044b\u0445\u0430\u043d\u0438\u044f, \u0434\u0440\u0443\u0433\u0438\u043c\u0438\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c (\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0434\u0440.), \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438\n\u043e\u0431\u043c\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432, \u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432, \u043f\u043e\u0432\u043b\u0451\u043a\u0448\u0438\u0445 \u0437\u0430\n\u0441\u043e\u0431\u043e\u0439 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0436\u0438\u0437\u043d\u0435\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u043f\u0440\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0443\u0433\u0440\u043e\u0437\u0435 \u0438\u0445\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f, \u0442\u044f\u0436\u0451\u043b\u044b\u043c\u0438 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438.\n\n9). \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u0441\u0444\u0430\u0433\u0438\u0438.\n\n10) \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435:\n\n\u2022 \u0414\u0438\u0435\u0442\u0430, \u0441\u0442\u043e\u043b No1;\n\n14\n\n\u2022 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043f\u0430\u0441\u0441\u0430\u0436\u0430 \u0431\u0430\u0440\u0438\u044f- 1 \u0440\u0430\u0437 \u0432 \u043f\u043e\u043b\u0433\u043e\u0434\u0430 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0433\u043e\u0434\u0430, \u0434\u0430\u043b\u0435\u0435 1\u0440\u0430\u0437 \u0432 \u0433\u043e\u0434.\n\n13. \u041c\u0415\u0414\u0418\u0426\u0418\u041d\u0421\u041a\u0410\u042f \u0420\u0415\u0410\u0411\u0418\u041b\u0418\u0422\u0410\u0426\u0418\u042f: \u043d\u0435\u0442.\n\n14. \u041f\u0410\u041b\u041b\u0418\u0410\u0422\u0418\u0412\u041d\u0410\u042f \u041f\u041e\u041c\u041e\u0429\u042c: \u043d\u0435\u0442.\n\n15. \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\n\u0410\u0414 \u2013 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\n\u0410\u041b\u0422 \u2013 \u0430\u043b\u0430\u043d\u0438\u043d\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\u0410\u0421\u0422 \u2013 \u0430\u0441\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\u0410\u0427\u0422\u0412 \u2013 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u0442\u0440\u043e\u043c\u0431\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043e\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f\n\n\u0412\u0418\u0427 \u2013 \u0432\u0438\u0440\u0443\u0441 \u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\n\u0416\u0415\u041b \u2013 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0435\u043c\u043a\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u043a\u0438\u0445\n\u0416\u041a\u0422 \u2013 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u044b\u0439 \u0442\u0440\u0430\u043a\u0442\n\u0418\u0412\u041b \u2013 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445", "type": "Document"}}