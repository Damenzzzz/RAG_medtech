0446\u044b. \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\n\u0447\u0430\u0441\u0442\u043e \u0432\u043e\u0432\u043b\u0435\u043a\u0430\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0437\u043d\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u0430. \u0412\n25% \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u043e\u0431\u0435\n\u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b \u043f\u0440\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u043c\n\u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043a\u043b\u0430\u0441\u0441\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438.\n\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0435\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u0440\u043e\u0441\u0442\u0430 \u0441\n\u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u043d\u0430\n\u0438\u043d\u0442\u0440\u0430\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u044b\u0448\u0446\u044b \u0438\u043b\u0438\n\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0435\u0440\u0432\u044b.\n\n\u041a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u0430\u044f \u041e\u0431\u044a\u0435\u043c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0440\u0431\u0438\u0442\u044b, \u041d\u0430 \u0423\u0417\u0418 \u2013 \u0433\u0438\u043f\u0435\u0440\u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0435 \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b: \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u043f\u0442\u043e\u0437,\n\n\u0433\u0435\u043c\u0430\u043d\u0433\u0438\u043e\u043c\u0430 \u043e\u0440\u0431\u0438\u0442\u044b \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0438\u0437 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0445 \u0441\u043e\u0441\u0443\u0434\u043e\u0432, \u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0440\u0435\u0442\u0440\u043e\u0431\u0443\u043b\u044c\u0431\u0430\u0440\u043d\u043e\u0435 \u0434\u0438\u043f\u043b\u043e\u043f\u0438\u044f, \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u0435 \u0437\u0440\u0435\u043d\u0438\u044f,\n\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u041f\u0440\u0438 \u0434\u043e\u043f\u043f\u043b\u0435\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0412\u0413\u0414. \u041d\u0430 \u0433\u043b\u0430\u0437\u043d\u043e\u043c \u0434\u043d\u0435 \u2013\n\u043a\u043e\u043d\u0442\u0430\u0441\u0442\u043d\u043e\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043e. \u0412 80 % \u0432 \u0435\u0433\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u0442\u0440\u0438\u0438 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438. \u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u043e\u0442 10-\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0443\u0447\u0430\u0441\u0442\u043a\u0438 \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u043a\u0430 \u0438 60 \u043b\u0435\u0442. \u0420\u0430\u0441\u0442\u0435\u0442 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\n\u0438\u043d\u0442\u0440\u0430\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e. \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043e \u043d\u0438\u0437\u043a\u043e\u0439 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438. \u041d\u0430 \u041c\u0420\u0422 \u0441 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044f\u0441\u044c \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0430\u0445, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442\n\u043f\u0441\u0435\u0432\u0434\u043e\u043a\u0430\u043f\u0441\u0443\u043b\u043e\u0439, \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0438\u0437 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u043c \u2013 \u0440\u0430\u043d\u043d\u0435\u0435 \u043d\u0435\u0433\u043e\u043c\u043e\u0433\u0435\u043d\u043d\u043e\u0435 \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u044b\u0445 \u0433\u0435\u043c\u0430\u043d\u0433\u0438\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435\n\u043a\u043e\u043c\u043f\u0440\u0435\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0438\u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0430\u0441\u0442\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0441\u043a\u043b\u043e\u043d\u043d\u044b \u043a \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u043c\u0443 \u0440\u0435\u0433\u0440\u0435\u0441\u0441\u0443. \u0412\n\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043e\u0442\u0434\u0435\u043b\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0441\u0434\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\n\u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u043e\u0440\u0431\u0438\u0442\u044b \u0438 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a\n\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u043c. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0435\u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e \u043a\u043e\u0441\u0442\u0438. \u0412 \u043f\u0435\u0440\u0438\u043e\u0434\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0441\u0442\u0435\u0442 \u0431\u044b\u0441\u0442\u0440\u0435\u0435.\n\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u041c\u0435\u043d\u0438\u043d\u0433\u0438\u043e\u043c\u0430 \u0414\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f, \u041d\u0430 \u041a\u0422 \u2013 \u0441\u0440\u0435\u0437\u0430\u0445 \u0442\u0438\u043f\u0438\u0447\u043d\u043e \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0422\u0438\u043f\u0438\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435: \u043e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f\u044f\n\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0440\u0432\u0430 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u0442\u0443\u0449\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c, \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0438\u043b\u0438 \u0442\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0443\u0442\u0440\u0430\u0442\u0430 \u0437\u0440\u0435\u043d\u0438\u044f, \u043f\u0440\u043e\u043f\u0442\u043e\u0437. \u0427\u0430\u0449\u0435 \u0431\u043e\u043b\u0435\u044e\u0442\n\u043f\u0440\u043e\u0438\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u0438\u0437 \u043f\u0430\u0443\u0442\u0438\u043d\u043d\u044b\u0445 \u043e\u0431\u044b\u0437\u0432\u0435\u0442\u0432\u043b\u0435\u043d\u0438\u0439. \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0438 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430.\n\n\u043a\u043b\u0435\u0442\u043e\u043a \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0438\u043d\u0442\u0440\u0430\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0438\u043c\u043f\u0442\u043e\u043c\u00bb\n\u0447\u0430\u0441\u0442\u0438 \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0440\u0432\u0430. \u0418\u0437 \u0432\u0441\u0435\u0445 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0442\u0440\u0430\u043c\u0432\u0430\u0439\u043d\u044b\u0445 \u0440\u0435\u043b\u044c\u0441\u00bb \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442\n11\n\n\u043c\u0435\u043d\u0438\u043d\u0433\u0438\u043e\u043c \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b 10% \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0433\u043e \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u043e\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u043c\u0438, 90% \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c \u0433\u0438\u043f\u043e\u0434\u0435\u043d\u0441\u043d\u043e\u0433\u043e \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u043c\u0438 \u0438 \u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0442\u0441\u044f \u0438\u0437 \u043d\u0435\u0440\u0432\u0430. \u0422\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043a \u2013 \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435\n\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440, \u043f\u0440\u0438\u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u043a \u043e\u0440\u0431\u0438\u0442\u0435 \u0441\u043f\u0438\u043d\u043d\u043e\u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\n(\u043a\u0440\u0430\u043d\u0438\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0435). \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u043e\u0439 \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438\n\u0424\u043e\u0440\u043c\u0430: \u0442\u0443\u0431\u0443\u043b\u044f\u0440\u043d\u0430\u044f (65%)>\u043d\u0430 \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0440\u0432\u0430-\u043f\u0435\u0440\u0438\u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u043d\u043e\u0436\u043a\u0435 (25%)>\u0432\u0435\u0440\u0435\u0442\u0435\u043d\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u043a\u0438\u0441\u0442\u0430.\n(10%). \u0424\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0435\u0440\u0432\u0430.\n\u0420\u0435\u0436\u0435 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u043e \u0438\u043b\u0438 \u0438\u043c\u0435\u0435\u0442\n\u043d\u043e\u0436\u043a\u0443\n\u0421\u0443\u0431\u043f\u0435\u0440\u0438\u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0421\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0433\u043d\u043e\u044f \u043c\u0435\u0436\u0434\u0443 \u0431\u0443\u043c\u0430\u0436\u043d\u043e\u0439 \u0422\u0438\u043f\u0438\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435: \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441 \u043e\u0440\u0431\u0438\u0442\u044b \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u043e\u0439 \u0438 \u043d\u0430\u0434\u043a\u043e\u0441\u0442\u043d\u0438\u0446\u0435\u0439 \u043e\u0440\u0431\u0438\u0442\u044b, \u041a\u0422 \u043e\u0440\u0431\u0438\u0442\u044b. \u041e\u0410\u041a., \u044d\u043a\u0437\u043e\u0444\u0442\u0430\u043b\u044c\u043c, \u0441\u0438\u043d\u0443\u0441\u0438\u0442, \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0432\u0435\u0440\u0445\u043d\u0438\u0445\n\u043e\u0431\u044b\u0447\u043d\u043e \u0443 \u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0441\u0435\u0432 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439, \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430. \u041e\u0442\u0435\u043a\n\u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b. \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f: \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u044b \u0438\u043b\u0438 \u0441 \u043f\u0430\u0440\u0430\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0438 \u0441 \u044d\u0440\u0438\u0442\u0435\u043c\u043e\u0439,\n\u0441\u0438\u043d\u0443\u0441\u0438\u0442 \u044f\u0447\u0435\u0435\u043a \u043b\u0430\u0431\u0438\u0440\u0438\u043d\u0442\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u043d\u044b. \u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0437\u0440\u0435\u043d\u0438\u044f.\n\u0440\u0435\u0448\u0435\u0442\u0447\u0430\u0442\u043e\u0439 \u043a\u043e\u0441\u0442\u0438 \u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0430\u043c\u0438 IV \u0440\u044f\u0434\u0430 \u0438 \u041d\u0430 \u041a\u0422-\u0441\u0440\u0435\u0437\u0430\u0445 \u0441 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\n\u0432\u0435\u0440\u0445\u043d\u0435\u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e\u0439 \u043f\u0430\u0437\u0443\u0445\u0438. \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0435 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u0430 \u0438\u043c\u0435\u0435\u0442 \u0432\u0438\u0434 \u0433\u0438\u043f\u043e\u0434\u0435\u043d\u0441\u043d\u043e\u0433\u043e\n\u0420\u0435\u0436\u0435 \u2013 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0435\u043f\u0442\u0438\u0446\u0435\u043c\u0438\u044f, \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0432 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0447\u0435\u0447\u0435\u0432\u0438\u0446\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0433\u043e \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043a\u043e\u0436\u0438, \u043f\u0440\u043e\u043d\u0438\u043a\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430. \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438, \u0438\u043d\u043e\u0433\u0434\u0430 \u0441 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0433\u0430\u0437\u0430, \u0441\n\u0440\u0430\u043d\u0435\u043d\u0438\u0435. \u0421\u0438\u043d\u0443\u0441\u0438\u0442 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043a\u0440\u0430\u0435\u0432\u044b\u043c \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043d\u043e\u0433\u043e\n\u043f\u0435\u0440\u0438\u043e\u0441\u0442\u0438\u0442 \u0441\u0442\u0435\u043d\u043e\u043a \u043e\u0440\u0431\u0438\u0442\u044b, \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043e \u0432\u0434\u043e\u043b\u044c\n\u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0444\u043b\u0435\u0433\u043c\u043e\u043d\u0430 \u043e\u0440\u0431\u0438\u0442\u044b \u0438 \u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438 \u043e\u0440\u0431\u0438\u0442\u044b,\n\u0446\u0435\u043b\u043b\u044e\u043b\u0438\u0442 \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0438. \u0417\u0430\u0442\u0435\u043c \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u043c\n\u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441\u0443\u0431\u043f\u0435\u0440\u0438\u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u043c \u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u044f\u043c\u043e\u0439\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441. \u042d\u0442\u043e \u0440\u0435\u0434\u043a\u043e\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435 \u043c\u044b\u0448\u0446\u044b.\n\u0441\u0438\u043d\u0443\u0441\u0438\u0442\u0430\n\n12\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\n\u041f\u0440\u0438 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0438 \u0441\u0432\u043e\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0438\u0441\u043f\u0430\u043d\u0441\u0435\u0440\n\u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u043c\u0443 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0443 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u043e\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435.\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c III;\n\n\u2022 \u0414\u0438\u0435\u0442\u0430 \u2013 \u0441\u0442\u043e\u043b No 15.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:\n\nNo \u041c\u041d\u041d \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u043f/\u043f\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f/\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0442\u0440\u0435\u0437\u043a\u0430\n\u0433\u043b\u0430\u0437\u0430\n\n1. \u0422\u043e\u0431\u0440\u0430\u043c\u0438\u0446\u0438\u043d 0,3%, \u043f\u043e 2 \u043a\u0430\u043f\u043b\u0435 6 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c, 10 \u0421 [6]\n\u0433\u043b\u0430\u0437\u043d\u044b\u0435 \u043a\u0430\u043f\u043b\u0438 \u0434\u043d\u0435\u0439\n\n\u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435,\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435, \u0434\u0435\u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0435, \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f/\u043e\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437\u0430 \u0438 \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b\n2. \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 0,4%, \u043a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435, \u043c\u0430\u0437\u044c \u043f\u043e 2 \u043a\u0430\u043f\u043b\u0435 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, \u0421 [6]\n\u0433\u043b\u0430\u0437\u043d\u0430\u044f 0,1%, 10 \u0434\u043d\u0435\u0439. \u041c\u0430\u0437\u044c \u0437\u0430 \u043d\u0438\u0436\u043d\u0435\u0435\n\n\u0432\u0435\u043a\u043e 1-2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f\n\u0433\u043b\u0430\u0437\u0430 \u0438 \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b\n3. \u0446\u0435\u0444\u0430\u0437\u043e\u043b\u0438\u043d 500 \u043c\u0433, 1000 \u043c\u0433 \u0432/\u043c, 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c, 7 \u0434\u043d\u0435\u0439 \u0421 [6]\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f/\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437\u0430 \u0438 \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b\n4. \u043c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b 500 \u043c\u0433 \u0432/\u0432, 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c, 5 \u0434\u043d\u0435\u0439 \u0421 [6]\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f\n\n\u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u0433\u043b\u0430\u0437\u0430\n5. \u0434\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u043d\u0430\u0442\u0440\u0438\u044f 0,1% /5,0 \u043c\u043b \u043f\u043e 2 \u043a\u0430\u043f\u043b\u0438 3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, 15 \u0421 [6]\n\u0434\u043d\u0435\u0439\n\u041f\u0440\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\n\n\u043f