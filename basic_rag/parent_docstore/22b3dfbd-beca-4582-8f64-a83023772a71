f\u0435\u0447\u0430\u0442\u043e\u043a \u0438\u0437 \u043e\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u044b\u0435 \u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u044f \u0441 \u043b\u0443\u0447\u0438\u0441\u0442\u044b\u043c\u0438\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0441\u043a\u0430 \u0441 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438 \u0441/ \u0431\u0435\u0437 \u0434\u043e\u0440\u043e\u0436\u043a\u043e\u0439 \u043a \u0441\u043e\u0441\u043a\u0443 \u0441\n\n\u0446\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0441\u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0438\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0440\u0430\u0437\u0431\u0440\u043e\u0441\u0430\u043d\u043d\u044b\u0445 \u043c\u0438\u043a\u0440\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u043d\u0430\u0442\u043e\u0432. BI-\n\u2022 \u0442\u0440\u0435\u043f\u0430\u043d-\u0431\u0438\u043e\u043f\u0441\u0438\u044f \u0441 RADS-IV-VI\n\u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u041f\u043e \u0434\u0430\u043d\u043d\u044b\u043c \u0446\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f: \u043a\u043b\u0435\u0442\u043a\u0438 \u0430\u0434\u0435\u043d\u043e\u043a\u0430\u0440\u0446\u0438\u043d\u043e\u043c\u044b\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435:\n\u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0435 \u0434\u043e\u043b\u044c\u043a\u043e\u0432\u044b\u0435/\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u0432\u044b\u0435\n\u0430\u0434\u0435\u043d\u043e\u043a\u0430\u0440\u0446\