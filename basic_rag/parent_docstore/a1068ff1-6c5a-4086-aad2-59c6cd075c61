0\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0439 \u0443\u0437\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432.\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0430: \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f\n\u043f\u043e\u0433\u0438\u043f\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438-\u0438\u0448\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0442\u0438\u043f\u0443, \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0438 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0426\u041d\u0421, \u043f\u0441\u0435\u0432\u0434\u043e\u0431\u0443\u043b\u044c\u0431\u0430\u0440\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433\u0430: \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0443\u0441\u0432\u043e\u044f\u0435\u043c\u043e\u0441\u0442\u0438, \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\n\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u043c\u043e\u043b\u043e\u043a\u0430, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043c\u0430\u043b\u044c\u0430\u0431\u0441\u043e\u0440\u0431\u0446\u0438\u0438;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0434\u0438\u0435\u0442\u043e\u043b\u043e\u0433\u0430: \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0430\u043d\u0442\u0438\u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0430: \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u0446\u0438\u044f \u0441\u043e\u043b\u044c\u0442\u0435\u0440\u044f\u044e\u0449\u0435\u0439\u0444\u043e\u0440\u043c\u044b\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u0430\u044f \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f (\u043d\u0430 \u044d\u0442\u0430\u043f\u0435\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438);\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043d\u0435\u0444\u0440\u043e\u043b\u043e\u0433\u0430: \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u0446\u0438\u044f \u0441\u043e\u043b\u044c\u0442\u0435\u0440\u044f\u044e\u0449\u0438\u0445 \u0444\u043e\u0440\u043c \u0442\u0443\u0431\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0439;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0443\u043b\u044c\u043c\u043e\u043d\u043e\u043b\u043e\u0433\u0430: \u0440\u0435\u0444\u043b\u044e\u043a\u0441-\u0438\u043d\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0431\u0440\u043e\u043d\u0445\u043e-\u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0435\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f, \u0430\u0441\u043f\u0438\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u0431\u0440\u043e\u043d\u0445\u043e\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c,\n\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430, \u0430\u043f\u043d\u043e\u044d;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u041b\u041e\u0420-\u0432\u0440\u0430\u0447\u0430: \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041b\u041e\u0420-\u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u043d\u0435\u0439\u0440\u043e\u0433\u0435\u043d\u043d\u0430\u044f\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u041b\u041e\u0420-\u043e\u0440\u0433\u0430\u043d\u043e\u0432;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433\u0430: \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0435 \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043a\u0430\u0440\u0434\u0438\u0442\u044b, \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u0430\u044f\n\n\u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0430, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430: \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0435 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\n\n12.6. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 [2, 3, 4, 10].\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0413\u042d\u0420\u0411\n\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0413\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u0435\u0430\u043b\u044c\u043d\u0430 \u0410\u0445\u0430\u043b\u0430\u0437\u0438\u044f \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u041d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432\u0430\u044f\n\n\u044f \u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c;\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0430\u0434\u0440\u0435\u043d\u043e\u0433\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\n(\u0441\u043e\u043b\u044c\u0442\u0435\u0440\u044f\u044e\u0449\u0430\u044f\n\n\u0444\u043e\u0440\u043c\u0430)\n\u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0413\u0440\u0443\u0434\u043d\u043e\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442. \u0421\u0442\u0430\u0440\u0448\u0438\u0439, \u0420\u0430\u043d\u043d\u0438\u0439 \u0433\u0440\u0443\u0434\u043d\u043e\u0439\n\n7\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0432\u043e\u0437\u0440\u0430\u0441\u0442.\n(7-14 \u043b\u0435\u0442).\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u00ab\u0422\u0432\u043e\u0440\u043e\u0436\u0438\u0441\u0442\u0430\u044f\u00bb \u041d\u0435\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u0430\u044f \u043f\u0438\u0449\u0430. \u00ab\u041d\u0435\u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0435\u043d\u043d\u0430\u044f\u00bb\n\u0440\u0432\u043e\u0442\u044b \u043f\u0438\u0449\u0430. \u043f\u0438\u0449\u0430.\n\n\u0412\u0440\u0435\u043c\u044f \u0412 \u043f\u0435\u0440\u0438\u043e\u0434 \u043c\u0435\u0436\u0434\u0443 \u0412 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u044b\u0445 \u0412 \u043f\u0435\u0440\u0438\u043e\u0434 \u043c\u0435\u0436\u0434\u0443\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f\u043c\u0438. \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f\u043c\u0438.\n\u0440\u0435\u0433\u0443\u0440\u0433\u0438\u0442\u0430\u0446\u0438 \u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f.\n\u0439\n\n\u041e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d \u0421 \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0420\u0435\u0431\u0435\u043d\u043e\u043a \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0413\u0438\u043f\u0435\u0440\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f\n\u044b\u0435 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u043f\u043e\u0442\u0435\u0440\u044f \u0432\u0435\u0441\u0430 \u043c\u043e\u0448\u043e\u043d\u043a\u0438, \u0441\u043e\u0441\u043a\u043e\u0432.\n\u0444\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u044b \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0441 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u041e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0432\n\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u0439, \u0440\u0435\u0433\u0443\u0440\u0433\u0438\u0442\u0430\u0446\u0438\u0439, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c\n\n\u043e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438, \u0434\u0435\u0444\u0438\u0446\u0438\u0442\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438 \u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0438. \u0432\u0435\u0441\u0430.\n\u043c\u043e\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f,\n\u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u0432\u0435\u0441\u0430.\n\n\u0423\u0417\u0418 \u041e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c, \u0423\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435 \u0441\u0442\u0435\u043d\u043e\u043a \u0421\u0442\u0435\u043d\u043a\u0430 \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u043e\u0441\u0442\u044c \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430 \u043e\u0442\u0434\u0435\u043b\u0430 \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0430,\n\u0441\u0442\u0435\u043d\u043e\u043a \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u043e\u0434\u043d\u0430\u043a\u043e, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f\n\u043e\u0442\u0434\u0435\u043b\u0430 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u0435 \u044d\u0432\u0430\u0443\u0446\u0438\u0438\n\u043f\u0440\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0438\u0449\u0435\u0432\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438\u0437\n\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0442\u0430 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0432 \u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0438 \u0442\u043e\u043d\u043a\u043e\u0439\n\u0432\u0438\u0440\u0443\u043b\u0435\u043d\u0442\u043d\u044b\u0439 \u0437\u0430\u0431\u0440\u043e\u0441 \u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u043e\u0442\u0434\u0435\u043b\u0435. \u043a\u0438\u0448\u043a\u0438, \u0441\n\u043f\u0438\u0449\u0435\u0432\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438\u0437 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u043c\n\u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0432 \u043f\u0438\u0449\u0435\u0432\u043e\u0434. \u0437\u0430\u0431\u0440\u043e\u0441\u043e\u043c \u043c\u0430\u0441\u0441 \u0432\n\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430.\n\u0424\u042d\u0413\u0421 \u041f\u0440\u043e\u0441\u0432\u0435\u0442 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0423\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0432\u0435\u0442\u0430 \u041f\u0440\u043e\u0441\u0432\u0435\u0442 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u043d\u0435\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u043d\u0430 \u0432\u0441\u0435\u043c \u0438\u0437\u043c\u0435\u043d\u0435\u043d, \u043a\u0430\u0440\u0434\u0438\u044f\n\u043d\u0438\u0436\u043d\u0435\u0439-\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438, \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u0441\u043c\u044b\u043a\u0430\u0435\u0442\u0441\u044f.\n\n\u0442\u0440\u0435\u0442\u0438 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u0441 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0438 \u044d\u0440\u043e\u0437\u0438\u0438,\n\u0441\u0442\u0435\u043d\u043a\u0430 \u043e\u0442\u0435\u0447\u043d\u0430, \u043f\u043e\u043a\u0440\u044b\u0442\u044b\u0435 \u0444\u0438\u0431\u0440\u0438\u043d\u043e\u043c,\n\u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u0430 \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u0443\u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0438 \u044d\u0440\u043e\u0437\u0438\u0438, \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430\n\n\u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u043e \u0443\u0440\u043e\u0432\u043d\u0435 \u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0442. \u043e\u0442\u0434\u0435\u043b\u0430, \u0441\u0442\u0435\u043d\u043a\u0430\n\u041a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u043e\u0437\u0435\u0442\u043a\u0430 \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0430, \u043f\u0440\u043e\u0441\u0432\u0435\u0442\n\u0437\u0438\u044f\u0435\u0442. \u043f\u0440\u0438 \u0438\u043d\u0441\u0443\u0444\u043b\u044f\u0446\u0438\u0438 \u043d\u0435\n\n\u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f.\n\n8\n\n\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043a\u043e\u043d\u0442 \u00ab\u041f\u043d\u0435\u0432\u043c\u0430\u0442\u043e\u0437\u00bb \u041c\u0435\u0433\u0430\u044d\u0437\u043e\u0444\u0430\u0433\u0443\u043c \u043d\u0430 \u0421\u0442\u0435\u043d\u043a\u0430 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u043d\u0435\n\u0440\u0430\u0441\u0442\u043d\u043e\u0435 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u043f\u0440\u043e\u0441\u0432\u0435\u0442 \u0432\u0441\u0435\u043c \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0430 \u043d\u0430 \u0432\u0441\u0435\u043c\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438,\n\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0442\u0440\u0435\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c \u00ab\u043f\u043b\u0430\u043c\u0435\u043d\u0438 \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u044f \u043f\u043e\n\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u043e\u0439 \u0441\u0432\u0435\u0447\u0438\u00bb \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0443 \u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0443\n\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0443\u0433\u043b\u0430 \u0441 \u043f\u043e\u0440\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0430.\n\u0413\u0438\u0441\u0430 \u0441\u0432\u044b\u0448\u0435 300, \u0432 \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0435\u0439 \u043f\u0438\u0449\u0435\u0432\u044b\u0445\n\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043c\u0430\u0441\u0441 \u0432 \u0436\u0435\u043b\u0443\u0434\u043e\u043a.\n\u0422\u0440\u0435\u043d\u0434\u0435\u043b\u0435\u043d\u0431\u0443\u0440\u0433\u0430 -\n\n\u0440\u0435\u0444\u043b\u044e\u043a\u0441-\u0437\u0430\u0431\u0440\u043e\u0441.\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d \u041e\u0410\u041a (\u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437, \u041e\u0410\u041a (\u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437, \u041e\u0410\u041a (\u0431\u0435\u0437\n\u044b\u0435 \u0430\u043d\u0435\u043c\u0438\u044f, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0430\u043d\u0435\u043c\u0438\u044f, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0435\u0439\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0421\u041e\u042d, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0437). \u0421\u041e\u042d, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0437). \u0411\u0410\u041a (\u0433\u0438\u043f\u0435\u0440\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u044f,\n\n\u0411\u0410\u041a \u0411\u0410\u041a \u0433\u0438\u043f\u043e\u043d\u0430\u0442\u0440\u0438\u0435\u043c\u0438\u044f,\n(\u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u044f, (\u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u044f, \u0433\u0438\u043f\u043e\u0445\u043b\u043e\u0440\u0435\u043c\u0438\u044f).\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u043d\u0430\u043b\u0438\u0437 \u043d\u0430 17-\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u043e\u0433\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u043e\u0433\u043e \u043a\u0435\u0442\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b,\n\n\u043e\u0431\u043c\u0435\u043d\u0430). \u043e\u0431\u043c\u0435\u043d\u0430). \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b,\n\u043f\u0440\u043e\u0433\u0435\u0441\u0442\u0435\u0440\u043e\u043d.\n\u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0410\u043d\u0442\u0438\u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u0430\u044f\n\u0441\u0442\u044c \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435: \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432 \u0430\u043d\u0442\u0438\u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u043e\u0439 \u044d\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430.\n\u043d\u043e\u0433\u043e \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u041b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043b\u0438\u0448\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\n\u044d\u0444\u0444\u0435\u043a\u0442. \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u2013 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u0438.\n\u043b\u0435\u0447\u0435\u043d\u0438\u0435.\n\n13. \u0426\u0435\u043b\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u043e\u0439\n\n\u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0443 \u0434\u0435\u0442\u0435\u0439 \u043f\u0443\u0442\u0435\u043c \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0433\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u043e\u0442\u043e\u0440\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u0438\u0441\u043b\u043e\u0442\u043e\u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0435\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0438, \u0432\n\u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441