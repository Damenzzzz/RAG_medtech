0\u0437\u0430 \u0432\n\u0432\u0430\u043b\u044c\u0441\u0430\u0440\u0442\u0430\u043d \u0434\u0435\u043d\u044c;\n\n\u0442\u0435\u043b\u043c\u0438\u0441\u0430\u0440\u0442\u0430\u043d \u0412.: 80-320 \u043c\u0433 1 \u0440\u0430\u0437 \u0432\n\u044d\u043d\u043f\u0440\u043e\u0441\u0442\u0430\u0440\u0442\u0430\u043d \u0434\u0435\u043d\u044c;\n\u043a\u0430\u043d\u0434\u0435\u0441\u0430\u0440\u0442\u0430\u043d \u0422.: 20-80 \u043c\u0433 1 \u0440\u0430\u0437 \u0432\u0434\u0435\u043d\u044c;\n\u0438\u0440\u0431\u0435\u0441\u0430\u0440\u0442\u0430\u043d \u042d.: 600 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c;\n\n\u041a.: 4-32 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c;\n\u0418.: 150-300 \u043c\u0433 1 \u0440\u0430\u0437 \u0432\n\u0434\u0435\u043d\u044c\n7 \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f: \u0430\u043d\u0442\u0438\u043a\u043e\u043d\u0432\u0443\u043b\u044c\u0441\u0430\u043d\u0442\u044b\n\n7.1 \u041a\u0430\u0440\u0431\u0430\u043c\u0430\u0437\u0435\u043f\u0438\u043d \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e \u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0423\u0414 [\u0412] \u2013\n(\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436 100-200 \u043c\u0433 1-2 \u0440\u0430\u0437\u0430 \u0432 \u0430\u043d\u0442\u0438\u043a\u043e\u043d\u0432\u0443\u043b\u044c\u0441\u0430\u043d\u0442\u043e 45-47\n\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e) \u0441\u0443\u0442\u043a\u0438 \u0441 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c \u0432 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e\n\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0430, 200\u043c\u0433 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u043e \u0434\u043b\u044f\n\u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438\n\u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0445\n(\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u043d\u0430 200 \u043f\u043e\u0441\u0442\u0438\u043d\u0441\u0443\u043b\u044c\u0442\u043d\u044b\u0445\n\n\u043c\u0433/\u0441\u0443\u0442 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 1 \u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0445\n\u043d\u0435\u0434) \u0434\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u0440\u0438\u043f\u0430\u0434\u043a\u043e\u0432.\n\u0434\u043e\u0437\u044b - \u043f\u043e 400 \u043c\u0433 2-3 \u0440\u0430\u0437\u0430 \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\n\u0432 \u0441\u0443\u0442\u043a\u0438. \u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0430\u043d\u0442\u0438\u043a\u043e\u043d\u0432\u0443\u043b\u044c\u0441\u0430\u043d\u0442\u043e\n\u0432 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u043d\u0435\n\u0438\u043c\u0435\u0432\u0448\u0438\u0445\n\u044d\u043f\u0438\u043f\u0440\u0438\u043f\u0430\u0434\u043a\u043e\u0432 \u0432\u043e\n\u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\n\u0438\u043d\u0441\u0443\u043b\u044c\u0442\u0430, \u043d\u0435\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e.\n\u0423\u0414 [\u0421] \u2013 13, 15\n\u041a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f \u0432\n\n\u043f\u043b\u0430\u0437\u043c\u0435 \u0434\u043b\u044f\n\u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\n20\n\n\u043e\u0442\u0432\u0435\u0442\u0430 4-12 \u043c\u0433/\u043b\n(20-50 \u043c\u043a\u043c\u043e\u043b\u044c/\u043b)\n7.2 \u0412\u0430\u043b\u044c\u043f\u0440\u043e\u0435\u0432\u0430\u044f \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438 \u2013 \u0423\u0414 [\u0412] \u2013\n\u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0434\u043b\u044f 45-47\n\n(\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 - 5-15 \u043c\u0433/\u043a\u0433 \u0432\n\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e) \u0441\u0443\u0442\u043a\u0438 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430,\n100\u043c\u0433/\u043c\u043b, 5\u043c\u043b \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043f\u0440\u0438\u0435\u043c\u0430\n50 \u043c\u0433/\u043c\u043b, 150\u043c\u043b, \u043f\u0438\u0449\u0438 (\u043f\u043e 600 \u043c\u0433/\u0441\u0443\u0442).\n\u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0434\u043b\u044f \u0414\u043e\u0437\u0443 \u043f\u043e\u0432\u044b\u0448\u0430\u044e\u0442 \u043d\u0430 5-10\n\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c \u043c\u0433/\u043a\u0433 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e.\n300 \u043c\u0433/\u043c\u043b - \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0434\u043e\u0437\u0443 - 30\n100\u043c\u043b, \u043a\u0430\u043f\u043b\u0438 \u043c\u0433/\u043a\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u043c\u043e\u0436\u043d\u043e\n\u0432\u043d\u0443\u0442\u0440\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0434\u043e 60 \u043c\u0433/\u043a\u0433 \u0432\n\n\u0441\u0443\u0442\u043a\u0438 (\u043f\u0440\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438\n\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0437\u0430\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0435\u0439 \u0432\n\u043f\u043b\u0430\u0437\u043c\u0435). \u041c\u043e\u0436\u043d\u043e \u0432\u0432\u043e\u0434\u0438\u0442\u044c\n\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u043f\u043e\n400-800 \u043c\u0433 \u0438\u043b\u0438\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e,\n\u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 25 \u043c\u0433/\u043a\u0433 \u0432\n\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 24, 36, 48 \u0447. \u041f\u0440\u0438\n\u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0435\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u043b\u0435\n\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c \u043f\u0435\u0440\u0432\u043e\u0435\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0432 \u0434\u043e\u0437\u0435\n0,5-1 \u043c\u0433/\u043a\u0433 \u0432 \u0447\u0430\u0441 \u0447\u0435\u0440\u0435\u0437 4-\n6 \u0447 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c.\n\n7.3 \u041b\u0430\u043c\u043e\u0442\u0440\u0438\u0434\u0436\u0438\u043d \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 25 \u043c\u0433 \u0421\u043d\u0438\u0436\u0430\u0435\u0442 \u0423\u0414 [\u0412] \u2013\n\u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0435 45-47\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 2 \u043d\u0435\u0434\u0435\u043b\u044c, \u0432 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u0434\u043e\u0437\u0430\