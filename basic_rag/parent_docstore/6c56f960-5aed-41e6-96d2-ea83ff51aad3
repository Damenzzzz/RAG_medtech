043e\u0438\u0434\u043e\u0437 55.23 \u0417\u0430\u043a\u0440\u044b\u0442\u0430\u044f [\u0447\u0440\u0435\u0441\u043a\u043e\u0436\u043d\u0430\u044f]\n\n[\u043f\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f] \u0431\u0438\u043e\u043f\u0441\u0438\u044f\nE85.0 \u041d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439\n\u043f\u043e\u0447\u043a\u0438.\n\u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437 \u0431\u0435\u0437 \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438\nE85.1 \u041d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439\n39.95 \u0413\u0435\u043c\u043e\u0434\u0438\u0430\u043b\u0438\u0437.\n\u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\nE85.2 \u041d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\n99.71 \u0422\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0451\u043d\u043d\u044b\u0439\n\u043f\u043b\u0430\u0437\u043c\u043e\u0444\u0435\u0440\u0435\u0437\nE85.3 \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\nE85.4 \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\n99.76 \u042d\u043a\u0441\u0442\u0440\u0430\u043a\u043e\u0440\u043f\u043e\u0440\u0430\u043b\u044c\u043d\u0430\u044f\nE85.8 \u0414\u0440\u0443\u0433\u0438\u0435 \u0444\u043e\u0440\u043c\u044b \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\u0430\n\u0438\u043c\u043c\u0443\u043d\u043e\u0430\u0434\u0441\u043e\u0440\u0431\u0446\u0438\u044f\nE85.9 \u0410\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0451\u043d\u043d\u044b\u0439\n3. \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438/\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: 2016 \u0433\u043e\u0434.\n4. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0432\u0440\u0430\u0447\u0438 \u043e\u0431\u0449\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438,\n\u043d\u0435\u0444\u0440\u043e\u043b\u043e\u0433\u0438.\n5. \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435.\n\n6. \u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:\n\u0410 \u0412\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0442\u0430-\u0430\u043d\u0430\u043b\u0438\u0437, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u0420\u041a\u0418 \u0438\u043b\u0438\n\u043a\u0440\u0443\u043f\u043d\u043e\u0435 \u0420\u041a\u0418 \u0441 \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u043e\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\u044e (++) \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043e\u0448\u0438\u0431\u043a\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b \u043d\u0430\n\u0441\u043e\u043e\u