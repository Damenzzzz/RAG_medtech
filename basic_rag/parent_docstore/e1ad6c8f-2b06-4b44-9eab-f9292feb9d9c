e\u0432\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0430\u043c\u043c\u0430-\n\n\u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0440\u043e\u043d\u0430 (IGRA \u0442\u0435\u0441\u0442,\n\u041a\u0432\u0430\u043d\u0442\u0438\u0444\u0435\u0440\u043e\u043d\u043e\u0432\u044b\u0439 \u0442\u0435\u0441\u0442) \u0434\u043b\u044f\n\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0438\u043b\u0438 \u043b\u0430\u0442\u0435\u043d\u0442\u043d\u043e\u0439\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f\n\u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432\n\u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e\n\n\u0412\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432\u0442\u043e\u0440\u043e\u0439 \u043b\u0438\u043d\u0438\u0438\n\u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 15-25 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c \u041f\u0435\u0440\u0435\u0434 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439 \u2013 \u041e\u0410\u041a \u0441 \u0413\u0435\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441 C\n\u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u043e \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439, \u0442\u0435\u0440\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u0430\u044f \u0444\u043e\u043b\u0438\u0435\u0432\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u043e\u0439, 1\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b. \u043c\u0433 / \u0441\u0443\u0442, \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u0442\u0435\u0440\u0430\u043f\u0438\u0438; \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c\n\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u041e\u0410\u041a, \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u044b \u0432 \u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0445\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b \u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0435\u0436\u0435\u043a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u043e\n\u0422\u043e\u0446\u0438\u043b\u0438\u0437\u0443\u043c\u0430\u0431 8 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 4 \u0432/\u0432 \u041f\u0435\u0440\u0435\u0434 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439 \u2013 \u041e\u0410\u041a \u0441 \u0418\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u041d\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u044e C\n\u043d\u0435\u0434\u0435\u043b\u0438 \u043b\u0435\u0439\u043a\u043e\u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0435, \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b, \u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0435 \u0438 \u0443\u0441\u043b\u043e\u0432\u043d\u043e- \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u0430\u043c\u0438 \u043d\u0438\u0436\u0435 2 \u00d7\n\u0434\u0438\u0430\u0441\u043a\u0438\u043d \u0442\u0435\u0441\u0442 \u043d\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437. \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0435; \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u044b\u0435 10.9/ \u041b, \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\n\u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u041e\u0410\u041a \u0441 \u0440\u0435\u0430\u043a\u0446\u0438\u0438, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u043d\u0438\u0436\u0435 100\n\n\u043b\u0435\u0439\u043a\u043e\u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439, \u0433\u0435\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u00d7 109/ L, \u0438\u043b\u0438 A\u041bT \u0438\u043b\u0438\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u044f A\u0421T \u0432 1,5 \u0440\u0430\u0437\u0430 \u0432\u044b\u0448\u0435\n\u043a\u0430\u0436\u0434\u044b\u0435 4-8 \u043d\u0435\u0434\u0435\u043b\u044c \u0432 \u043d\u043e\u0440\u043c\u044b. \u041d\u0435\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 3 \u043c\u0435\u0441, \u0430 \u0437\u0430\u0442\u0435\u043c \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\n\u0435\u0436\u0435\u043a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u043e; \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0440\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431\u043e\u043c.\n\u0410\u0414\n\u041c\u0438\u0442\u043e\u043a\u0441\u0430\u