\u043d\u044b\u043c \u043b\u0438\u0446\u0430\u043c (\u0435\u0441\u043b\u0438 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433\n\n\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d).\n2 \u041f\u0440\u0438 \u0412\u041d \u0412\u0418\u0427 \u0431\u043e\u043b\u044c\u0448\u0435 100 000 \u043a\u043e\u043f/\u043c\u043b \u0410\u0412\u0421+\u0417\u0422\u0421 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u0432\n\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 DTG \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\n3 \u041f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0438.\n4 \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043e\u043a\n\n5 \u0422\u0410F \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0432 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 FTC\n\nAPT \u043f\u0440\u0438 \u043a\u043e-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0422\u0411/\u0412\u0418\u0427 [2-15]:\n\u0412\u0441\u0435 \u0434\u0435\u0442\u0438 \u0441 \u0412\u0418\u0427 \u0441 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c \u043d\u0443\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u0432 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0422\u0411 \u0438\n\n\u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0447\u0438\u0441\u043b\u0430 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 CD4. \u041f\u0435\u0440\u0432\u044b\u043c \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u0430 \u0437\u0430\u0442\u0435\u043c \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435 (\u0432 \u043f\u0435\u0440\u0432\u044b\u0435 8 \u043d\u0435\u0434\u0435\u043b\u044c\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f) \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 APT. \u0411\u043e\u043b\u044c\u043d\u044b\u043c \u0412\u0418\u0427/\u0422\u0411, \u0438\u043c\u0435\u044e\u0449\u0438\u043c \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442,\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043d\u0430\u0447\u0430\u0442\u044c APT \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e - \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u044b\u0445 2 \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u043b\u0435 \u043d\u0430\u0447\u0430\u043b\u0430\n\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0422\u0411. \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442\u0430 \u043d\u0430\u0447\u0430\u043b\u043e APT \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0442\u043b\u043e\u0436\u0438\u0442\u044c\n\u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0444\u0430\u0437\u044b \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0422\u0411.\n\u0412 \u043d\u0430\u0447\u0430\u043b\u0435 APT \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0