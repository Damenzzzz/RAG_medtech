8\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043d\u0438;\n\u2022 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f;\n\u2022 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439 (\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u043b\u0443\u0447\u0435\u0432\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f);\n\n\u2022 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0434\u0435\u043c\u043f\u0438\u043d\u0433 \u2013 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430;\n\u2022 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u0434\u0438\u0441\u043f\u0435\u043f\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u044f\u0432\u043b\u0435\u043d\u0438\u0439;\n\u2022 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043a \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430\u043c;\n\n\u2022 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u043d\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044e \u2013 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u043e\u043c;\n\u2022 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0443\u0445\u043e\u0434\u0443 \u0437\u0430 \u0433\u0430\u0441\u0442\u0440\u043e\u0441\u0