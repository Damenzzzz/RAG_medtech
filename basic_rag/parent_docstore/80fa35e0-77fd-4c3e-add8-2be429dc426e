30\u043a\u0442\u0438\u043a\u0438 \u0421\u0421\u0417.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u043b\u044e\u0431\u043e\u0439 \u0434\u043e\u0437\u044b \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d IIa, C\n\u043f\u0440\u0438\u0435\u043c \u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\u0430 \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0446\u0435\u043b\u0435\u0432\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0425\u0421-\u041b\u041f\u041d\u041f\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u043b\u044e\u0431\u043e\u0439 \u0434\u043e\u0437\u044b \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430 \u0444\u043e\u043d\u0435 IIb, C\n\u043f\u0440\u0438\u0435\u043c\u0430 \u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\u0430 \u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u0446\u0435\u043b\u0435\u0432\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0425\u0421-\u041b\u041f\u041d\u041f,\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 PCSK9 (\u043c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u0438\u043b\u0438 \u0438\u043d\u043a\u043b\u0438\u0437\u0438\u0440\u0430\u043d)\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043e\u0447\u0435\u043d\u044c \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0438\u0441\u043a\u0430 \u0441 \u0421\u0413\u0425\u0421, \u0435\u0441\u043b\u0438 \u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442 \u0446\u0435\u043b\u0435\u0432\u043e\u0439 II, A\n\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0425\u0421-\u041b\u041f\u041d\u041f \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u0445 \u0434\u043e\u0437\u0430\u0445 \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432 \u0432\n\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\u043e\u043c, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\nPCSK9 (\u043c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u0438\u043b\u0438 \u0438\u043d\u043a\u043b\u0438\u0437\u0438\u0440\u0430\u043d)\n\n\u0413\u043e\u043c\u043e\u0437\u0438\u0433\u043e\u0442\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d\u0435\u043c\u0438\u044f:\n1) \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u0435 \u0434\u043e\u0437\u044b \u043b\u0438\u043f\u0438\u0434\u0441\u043d\u0438\u0436\u0430\u044e\u0449\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432;\n2) \u041b\u0438\u043f\u0438\u0434\u043d\u044b\u0439 \u0430\u0444\u0435\u0440\u0435\u0437, \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430\u043c\u0438 1-2 \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e.\n\n\u0412 \u043c\u043e\u043c\u0435\u043d\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u043d\u0430\u0447\u0430\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u044e \u0441\n\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432 \u0438 \u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\u0430\n\n\u0427\u0435\u0440\u0435\u0437 8 \u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c PCSK9 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u0443\u044e\n\u0415\u0441\u043b\u0438 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435\n\u0442\u0435\u0440\u0430\u043f\u0438\u044e\n\u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\n\u043d\u043e\u0432\u044b\u0435 \u043e\u043f\u0446\u0438\u0438\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u041b\u041f\u041d\u041f \u043f\u043e\u0441\u043b\u0435 1-2 \u0434\u043e\u0437\n\u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u2265 15%?\n\u0414\u0430 \u041d\u0435\u0442\n\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u043c \u0442\u0435\u0440\u0430\u043f\u0438\u044e \u041f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u043c \u0442\u0435\u0440\u0430\u043f\u0438\u044e\n\n\u0426\u0435\u043b\u0435\u0432\u043e\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041b\u041f\u041d\u041f? \u0415\u0441\u043b\u0438 \u043d\u0435\u0442\n\n\u041b\u043e\u043c\u0438\u0442\u0430\u043f\u0438\u0434 \u0421 \u0438\u043b\u0438 \u0431\u0435\u0437? \u041b\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u043e\u0432\u044b\u0439\n\u044d\u0432\u0438\u043d\u0430\u043a\u0443\u043c\u0430\u0431 \u0430\u0444\u0435\u0440\u0435\u0437\n\n24\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a 2. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u043e\u043c\u043e\u0437\u0438\u0433\u043e\u0442\u043d\u043e\u0439 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d\u0435\u043c\u0438\u0438\n(\u0431\u0438\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u0430\u044f). [23]\n\n\u0426\u0435\u043b\u0435\u0432\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043b\u0438\u043f\u0438\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u043f\u0440\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0433\u043e\u0421\u0413\u0425\u0421:\n\n\u2022 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u0435 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0440\u0438\u0441\u043a\u0430 \u0438/\u0438\u043b\u0438 \u0410\u0421\u0421\u0417 \u2013 \u0425\u0421-\u041b\u041f\u041d\u041f\n\u02c2 1,8 \u043c\u043c\u043e\u043b\u044c/\u043b (\u02c2 70 \u043c\u0433/\u0434\u043b);\n\u2022 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u0435 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0440\u0438\u0441\u043a\u0430 \u0438/\u0438\u043b\u0438 \u0410\u0421\u0421\u0417 \u2013 \u0425\u0421-\u041b\u041f\u041d\u041f \u02c2\n\n1,4 \u043c\u043c\u043e\u043b\u044c/\u043b (\u02c2 55 \u043c\u0433/\u0434\u043b).\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0441\u043b\u0438\u043f\u0438\u0434\u0435\u043c\u0438\u0439.\n\u0414\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0434\u0438\u0441\u043b\u0438\u043f\u0438\u0434\u0435\u043c\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u0443\u043f\u043f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u0432\n\n\u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0413\u041c\u0413-\u041a\u043e-\u0410 \u0440\u0435\u0434\u0443\u043a\u0442\u0430\u0437\u044b (\u0441\u0442\u0430\u0442\u0438\u043d\u044b), \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e\n\u0432\u0441\u0430\u0441\u044b\u0432\u0430\u043d\u0438\u044f \u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d\u0430, \u043c\u0438\u0420\u041d\u041a \u043f\u0440\u043e\u0442\u0438\u0432 PCSK9. \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0445 \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0434\u0438\u0441\u043b\u0438\u043f\u0438\u0434\u0435\u043c\u0438\u0439 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\n\u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 17.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 17. \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100%\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f).\n\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u041d\u041d \u041b\u0421 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\u0441\u0442\u0438\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0413\u041c\u0413-\u041a\u043e-\u0410 \u0410\u0442\u043e\u0440\u0432\u0430\u0441\u0442\u0430\u0442\u0438\u043d 10 \u043c\u0433, 20 \u043c\u0433, 40 \u043c\u0433, 80 \u043c\u0433 I, A\n\u0440\u0435\u0434\u0443\u043a\u0442\u0430\u0437\u044b (\u0441\u0442\u0430\u0442\u0438\u043d\u044b) 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0421\u0438\u043c\u0432\u0430\u0441\u0442\u0430\u0442\u0438\u043d 10 \u043c\u0433, 20 \u043c\u0433, 40 \u043c\u0433 I, A\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0413\u041c\u0413-\u041a\u043e-\u0410 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0440\u0435\u0434\u0443\u043a\u0442\u0430\u0437\u044b (\u0441\u0442\u0430\u0442\u0438\u043d\u044b)\n\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0413\u041c\u0413-\u041a\u043e-\u0410 \u0420\u043e\u0437\u0443\u0432\u0430\u0441\u0442\u0430\u0442\u0438\u043d 5 \u043c\u0433, 10 \u043c\u0433, 20 \u043c\u0433, 40 \u043c\u0433 I, A\n\u0440\u0435\u0434\u0443\u043a\u0442\u0430\u0437\u044b (\u0441\u0442\u0430\u0442\u0438\u043d\u044b) 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0413\u041c\u0413-\u041a\u043e-\u0410 \u041f\u0438\u0442\u0430\u0432\u0430\u0441\u0442\u0430\u0442\u0438\u043d 1 \u043c\u0433, 2 \u043c\u0433, 4 \u043c\u0433 I, A\n\u0440\u0435\u0434\u0443\u043a\u0442\u0430\u0437\u044b (\u0441\u0442\u0430\u0442\u0438\u043d\u044b) 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0418\u043d\u0433\u0438\u0431\u0438\u0