0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u0447\u0435\u0440\u0435\u0437 4 \u043d\u0435\u0434\u0435\u043b\u0438 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u0432\u044b\u0448\u0435 100\u0445109/\u043b\n(75% \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0418\u0422\u041f);\n\u2022 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u0441\u0435\u043b\u0435\u0437\u0451\u043d\u043a\u0438 \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u0432\n\n\u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0440\u043e\u0432\u0438.\n\n7. \u041e\u0420\u0413\u0410\u041d\u0418\u0417\u0410\u0426\u0418\u041e\u041d\u041d\u042b\u0415 \u0410\u0421\u041f\u0415\u041a\u0422\u042b \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b\u0410.\n7.1 \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\n\u0434\u0430\u043d\u043d\u044b\u0445:\n1) \u041e\u043c\u0430\u0440\u043e\u0432\u0430 \u041a\u0443\u043b\u044f\u043d \u041e\u043c\u0430\u0440\u043e\u0432\u043d\u0430 \u2013 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u043e\u0442\u0434\u0435\u043b\u0430 \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e\n\u043c\u0435\u043d\u0435\u0434\u0436\u043c\u0435\u043d\u0442\u0430 \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0434\u0435\u0442\u0441\u043a\u0438\u0439\n\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n2) \u0410\u0431\u0434\u0438\u043b\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u041a\u0430\u043b\u0434\u0435\u043d\u043e\u0432\u043d\u0430 \u2013 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0431\u043b\u043e\u043a\u0430 \u0410\u041e\n\u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0434\u0435\u0442\u0441\u043a\u0438\u0439\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n\n3) \u0411\u0443\u043b\u0430\u0431\u0430\u0435\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u0415\u0440\u0436\u0430\u043d\u043e\u0432\u043d\u0430 \u2013 \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 No3 \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb\n\u0432\u0440\u0430\u0447 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n4) \u041c\u0443\u0440\u0430\u0442\u043e\u0432\u0430 \u0410\u0441\u0435\u043b\u044c \u041c\u0443\u0440\u0430\u0442\u043e\u0432\u043d\u0430 \u2013 \u0432\u0440\u0430\u0447 \u043e\u043d\u043a\u043e\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433, \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 No3, \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439\n\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n5) \u0421\u0430\u0440\u0441\u0435\u043a\u0431\u0430\u0435\u0432 \u0415\u0440\u0433\u0430\u043b\u0438 \u0421\u0435\u043c\u0433\u0430\u043b\u0438\u0435\u0432\u0438\u0447 \u2013 \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438\n\u0433\u0435\u043c\u043e\u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a, \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n\n6) \u0410\u043d\u0430\u0440\u0431\u0430\u0435\u0432\u0430 \u0410\u0439\u0436\u0430\u043d \u041c\u0443\u0442\u0430\u043b\u043e\u0432\u043d\u0430 \u2013 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433, \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439\n\u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb.\n\n7.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432: \u043d\u0435\u0442.\n\n7.3 \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u043e\u0432: \u0422\u0430\u0448\u0435\u043d\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u0422\u0430\u043b\u0438\u043f\u043e\u0432\u043d\u0430 \u2013 \u0434\u043e\u0446\u0435\u043d\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u044b\n\u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u0441 \u043a\u0443\u0440\u0441\u043e\u043c \u043d\u0435\u043e\u043d\u043e\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb, \u0434\u0435\u0442\u0441\u043a\u0438\u0439\n\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433/\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n\n7.4 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0447\u0435\u0440\u0435\u0437 5 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e\n\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441 \u0434\u0430\u0442\u044b \u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u043e\u0432\u044b\u0445\n\n\u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n7.5 \u0421\u043f\u0438\u0441\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b:", "type": "Document"}}