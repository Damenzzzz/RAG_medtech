u043a\u043e\u0439 \u043d\u043e\u0433\u0438\u00bb, \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e \u043b\u0430\u0442\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0445\n\n\u043c\u0438\u043e\u0444\u0430\u0441\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0438 \u043c\u044b\u0448\u0435\u0447\u043d\u043e-\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u043e\u0432 \u0432 \u0442\u0440\u0430\u043f\u0435\u0446\u0438\u0435\u0432\u0438\u0434\u043d\u043e\u0439,\n\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439, \u043b\u0435\u0441\u0442\u043d\u0438\u0447\u043d\u043e\u0439 \u043c\u044b\u0448\u0446\u0430\u0445, \u043c\u044b\u0448\u0446\u0435, \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0449\u0435\u0439 \u043b\u043e\u043f\u0430\u0442\u043a\u0443, \u0433\u0440\u0443\u0434\u0438\u043d\u043e-\n\u043a\u043b\u044e\u0447\u0438\u0447\u043d\u043e-\u0441\u043e\u0441\u0446\u0435\u0432\u0438\u0434\u043d\u043e\u0439 \u043c\u044b\u0448\u0446\u0435. \u0421\u0442\u043e\u0439\u043a\u043e\u0435 \u043b\u0430\u0442\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435\n\n\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 - \u043e\u0434\u0438\u043d \u0438\u0437 \u0432\u0430\u0436\u043d\u044b\u0445 \u0430\u0444\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u044b\u0445 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\n\u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0437\u0430 \u0446\u0435\u0440\u0432\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 [2].\n\u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u0423\u0414\u2013 IA).\nNB! \u041c\u044b\u0448\u0435\u0447\u043d\u0443\u044e \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 [1-3,5].\n\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u044b \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0442\u0441\u044f \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e\n\n\u0444\u0435\u043d\u043e\u0442\u0438\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f\n\u043d\u0430\u0441\u043b\u043e\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u043e\u0432. \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u043c\u043e\u0436\u0435\u0442\n\u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u043b\u0430 \u0438\u043b\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0435\u0433\u043e \u0447\u0430\u0441\u0442\u0435\u0439 \u0438\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u0442\u0435\u043b\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e\n\n\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u0441 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0432\u0438\u0434\u0435\u043e\u0437\u0430\u043f\u0438\u0441\u0438 [6].\n\u041e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f:\n\u2022 \u043e\u0441\u043e\u0431\u0430\u044f \u043d\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f (\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f) \u043f\u043e\u0437\u0430 (\u0441 \u0442\u0440\u0435\u043c\u043e\u0440\u043e\u043c \u0438\u043b\u0438 \u0431\u0435\u0437 \u043d\u0435\u0433\u043e);\n\n\u2022 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 - \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u044b\u0435 \u0438 \u0437\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f,\n\u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0436\u0435\u0441\u0442\u044b;\n\u2022 \u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0435 \u043d\u0435\u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b.\n\n\u2022 \u043e\u0441\u043e\u0431\u0430\u044f \u043d\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0437\u0430. \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u044b\u043c\u0438 \u0444\u043e\u0440\u043c\u0430\u043c\u0438\n\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0446\u0435\u0440\u0432\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f, \u0431\u043b\u0435\u0444\u0430\u0440\u043e\u0441\u043f\u0430\u0437\u043c, \u043f\u0438\u0441\u0447\u0438\u0439\n\u0441\u043f\u0430\u0437\u043c. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 2:\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2 [2,7]:\n\n\u0426\u0435\u0440\u0432\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0411\u043b\u0435\u0444\u0430\u0440\u043e\u0441\u043f\u0430\u0437\u043c \u041f\u0438\u0441\u0447\u0438\u0439 \u0441\u043f\u0430\u0437\u043c\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f \u0411\u0421\u041f \u041f\u0421\n\u0426\u0414\n\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0412\u044b\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0431\u043e\u0439\n\u0432 \u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437 \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f\u043c\u0438 m. orbicularis \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044e\n\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b oculi, \u0447\u0442\u043e \u0442\u0430\u043a\u0436\u0435 \u0447\u0430\u0441\u0442\u043e \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u043c\u044b\u0448\u0446 \u0448\u0435\u0438 \u0438 \u0437\u0430\u0442\u044b\u043b\u043a\u0430 \u0441 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432\u0438\u0434\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f\u043c\u0438 m. procerus \u0438 (\u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u043e\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 m. corrugator. \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0438\u0441\u044c\u043c\u0430, \u0432\n\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u0433\u043e\u043b\u043e\u0432\u044b, \u0448\u0435\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435, \u0441 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438 \u043f\u043b\u0435\u0447, \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u2013 \u043f\u0440\u0438\n\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0433\u043b\u0430\u0437, \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430\n\u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u043c \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435),\n\u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0441\u0438 \u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0438\u043b\u0438 \u0441\u0443\u0445\u043e\u0441\u0442\u044c\u044e \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0443 \u043b\u044e\u0434\u0435\u0439 \u0432\n(\u0442\u043e\u0440\u0442\u0438\u043a\u043e\u043b\u043b\u0438\u0441) \u0438 \u0433\u043b\u0430\u0437, \u0431\u043e\u043b\u044c\u044e \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u043b\u0430\u0437, \u0431\u043e\u043b\u0435\u0435 \u043c\u043e\u043b\u043e\u0434\u043e\u043c\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u00ab\u043f\u0435\u0441\u043a\u0430\u00bb \u0432 \u0433\u043b\u0430\u0437\u0430\u0445 \u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435, \u0447\u0435\u043c \u0426\u0414 \u0438\n\n\u0442\u0440\u0435\u043c\u043e\u0440\u043e\u043c \u0433\u043e\u043b\u043e\u0432\u044b, \u043a\u043e\u0433\u0434\u0430 \u0436\u0436\u0435\u043d\u0438\u0435, \u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430 \u0441 \u0431\u043b\u0435\u0444\u0430\u0440\u043e\u0441\u043f\u0430\u0437\u043c.\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435\n\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u043c\u044b\u0448\u0446- \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u043e\u0440\u0433\u0430\u043d\u0438\u044f, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442\u043e\u0432. \u0413\u043e\u043b\u043e\u0432\u0430 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0438 \u044f\u0440\u043a\u043e\u043c \u0441\u0432\u0435\u0442\u0435. \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0438\u0441\u0447\u0435\u0433\u043e\n\n\u043c\u043e\u0436\u0435\u0442 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0442\u044c \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435\u043d \u043f\u043e\u043b\u0438\u043c\u043e\u0440\u0444\u0438\u0437\u043c \u0441\u043f\u0430\u0437\u043c\u0430: \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439: \u043a\u0438\u0441\u0442\u0438/\u0440\u0443\u043a\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439, \u0443\u0447\u0430\u0449\u0435\u043d\u043d\u043e\u0435 \u043c\u043e\u0440\u0433\u0430\u043d\u0438\u0435, \u043f\u0438\u0441\u044c\u043c\u0430, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\n\u0444\u0440\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0438 \u044d\u043f\u0438\u0437\u043e\u0434\u044b \u0437\u0430\u0436\u043c\u0443\u0440\u0438\u0432\u0430\u043d\u0438\u044f \u0432 \u043f\u043e\u0437\u044b \u043a\u0438\u0441\u0442\u0438/\u0440\u0443\u043a\u0438 \u0432\u043e\n\u0441\u0430\u0433\u0438\u0442\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0432\u0438\u0434\u0435 \u0447\u0430\u0441\u0442\u044b\u0445, \u0432\u0440\u0435\u043c\u044f \u043f\u0438\u0441\u044c\u043c\u0430,\n\u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044f\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043a\u0440\u0430\u0442\u043a\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435,\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0431\u043e\u043a\u043e\u0432\u043e\u0435 \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u044b\u0445 \u0441\u043f\u0430\u0437\u043c\u043e\u0432 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445 \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u0440\u043a\u0430,\n\n\u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 (\u00ab\u0448\u0438\u0444\u0442\u00bb). \u043c\u044b\u0448\u0446 \u0433\u043b\u0430\u0437; \u044d\u043f\u0438\u0437\u043e\u0434\u044b \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u043c \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u0436\u043c\u0443\u0440\u0438\u0432\u0430\u043d\u0438\u044f \u0441\u043b\u0438\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0438\u0441\u044c\u043c\u0430,\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0426\u0414 \u0433\u043b\u0430\u0437, \u044d\u043f\u0438\u0437\u043e\u0434\u044b \u0447\u0430\u0441\u0442\u044b\u0445 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u0430\n\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u043e\u0442\u0430\u0446\u0438\u044f \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u044b\u0445 \u0441\u043f\u0430\u0437\u043c\u043e\u0432 \u043a\u0440\u0443\u0433\u043e\u0432\u044b\u0445 \u0431\u0443\u043a\u0432, \u0434\u0440\u043e\u0436\u0430\u043d\u0438\u0435\n\u0433\u043e\u043b\u043e\u0432\u044b (\u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043a\u0430) \u2013 \u043c\u044b\u0448\u0446 \u0433\u043b\u0430\u0437 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0440\u0443\u043a\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\n\u0442\u043e\u0440\u0442\u0438\u043a\u043e\u043b\u043b\u0438\u0441. \u041f\u043e \u043c\u0435\u0440\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u043f\u0438\u0441\u044c\u043c\u0430,\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u0435\u043a, \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043d\u0438\u0435 \u0433\u043b\u0430\u0437, \u043d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u0441\u0442\u0432\u043e\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0432 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u0447\u0435\u0440\u043a\u0430. \u0411\u043e\u043b\u044c\u043d\u044b\u0435\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u00ab\u043e\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u0435\u043c \u0432\u0435\u043a\u00bb. \u043f\u043e\u0434\u0431\u0438\u0440\u0430\u044e\u0442\n\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0432\u043e\u0432\u043b\u0435\u043a\u0430\u044e\u0442\u0441\u044f \u041d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e \u0444\u043e\u0440\u043c\u0435\n\u043d\u043e\u0432\u044b\u0435 \u043c\u044b\u0448\u0446\u044b, \u0447\u0442\u043e \u0431\u043b\u0435\u0444\u0430\u0440\u043e\u0441\u043f\u0430\u0437\u043c\u0430 \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0432\u043e \u0438 \u0434\u0438\u0430\u043c\u0435\u0442\u0440\u0443 \u0440\u0443\u0447\u043a\u0438,\n\u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u0432\u0440\u0435\u043c\u044f \u0442\u0435\u0445 \u0432\u0438\u0434\u043e\u0432 \u043c\u0435\u043d\u044f\u044e\u0442 \u043f\u043e\u0437\u0443 \u043a\u0438\u0441\u0442\u0438\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0434\u043b\u044f \u0438 \u043f\u0430\u043b\u044c\u0446\u0435\u0432 \u0432\n\n\u0433\u043e\u043b\u043e\u0432\u044b \u0432 \u0434\u0432\u0443\u0445, \u0432 \u0442\u0440\u0435\u0445 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0438\u0441\u044c\u043c\u0430,\n\u043f\u043b\u043e\u0441\u043a\u043e\u0441\u0442\u044f\u0445, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0432 \u0430\u043a\u0442\u0435\n\u043f\u043e\u0432\u043e\u0440\u043e\u0442 \u0433\u043e\u043b\u043e\u0432\u044b \u0432 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0440\u0435\u043d\u0438\u044f, \u0430 \u043f\u0438\u0441\u044c\u043c\u0430 \u0434\u0440\u0443\u0433\u043e\u0439\n\u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0438 \u043d\u0430\u043a\u043b\u043e\u043d \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u043e\u044f \u0438 \u043f\u0440\u0438 \u0445\u043e\u0434\u044c\u0431\u0435, \u043d\u0430 \u0440\u0443\u043a\u043e\u0439. \u041f\u043e \u043c\u0435\u0440\u0435\n\n\u0433\u043e\u043b\u043e\u0432\u044b \u043a \u043f\u043b\u0435\u0447\u0443. \u0443\u043b\u0438\u0446\u0435, \u043f\u0440\u0438 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0438, \u0443\u0442\u043e\u043c\u043b\u0435\u043d\u0438\u0438, \u0432 \u043f\u0438\u0441\u0447\u0435\u0433\u043e \u0441\u043f\u0430\u0437\u043c\u0430\n\u0433\u043e\u043b\u043e\u0432\u044b \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u043c\u043d\u043e\u0433\u043e\u043b\u044e\u0434\u043d\u043e\u043c \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0438, \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u0440\u0443\u0448\u0430\u0442\u044c\u0441\u044f \u0438\n\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044e \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435, \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0434\u0440\u0443\u0433\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f,\n\n\u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043a\u0430. \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0435 \u0434\u043d\u044f, \u043f\u0440\u0438 \u044f\u0440\u043a\u043e\u043c \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u044b\u0435 \u0440\u0443\u043a\u043e\u0439\n\u0411\u043e\u043b\u0438 \u0432 \u0448\u0435\u0439\u043d\u043e\u0439, \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0438. \u041f\u0440\u0438\u0435\u043c \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f - \u0431\u044b\u0442\u043e\u0432\u044b\u0435,\n\u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u043e\u0439, \u043f\u043b\u0435\u0447\u0435\u0432\u043e\u0439 \u043a\u0440\u0430\u0442\u043a\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0443\u043b\u0443\u0447\u0448\u0430\u0435\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435.\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0443 \u0447\u0430\u0441\u0442\u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u0445. \u0412 \u044d\u0442\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445\n\u0432 75% \u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u041d\u0430 \u0440\u0430\u043d\u043d\u0438\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e\n\n\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u043c\n\u043c\u0438\u043e\u0444\u0430\u0441\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u0432\u043e\u043b\u0435\u0432\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043f\u0438\u0441\u0447\u0435\u043c \u0441\u043f\u0430\u0437\u043c\u0435.\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0438\u043b\u0438 \u0441 \u043d\u0430\u0434 \u043d\u0435\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u043c\u0438\n\u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u0435\u0439 \u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438. \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435\n\n\u0441\u0442\u0432\u043e\u043b\u043e\u0432 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435\n\u0441\u043f\u0430\u0437\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0436\u0435\u0441\u0442\u044b:\n\u043c\u044b\u0448\u0446\u0430\u043c\u0438, 1.\u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0433\u043b\u0430\u0437\u0430,\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0431\u043e\u043b\u0435\u0432\u044b\u0445 \u043f\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0430\u043d\u0438\u0435, \u043d\u043e\u0448\u0435\u043d\u0438\u0435\n\n\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 \u043e\u0447\u043a\u043e\u0432 \u0441 \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u043d\u044b\u043c\u0438\n\u043e\u043a\u043e\u043b\u043e\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u044b\u0445 \u0441\u0442\u0435\u043a\u043b\u0430\u043c\u0438, \u0441\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0438\n\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440. \u041d\u0430\u0447\u0430\u043b\u043e \u043d\u0430\u0434\u0435\u0432\u0430\u043d\u0438\u0435 \u043e\u0447\u043a\u043e\u0432, \u043f\u0440\u0438 \u0432\u0437\u0433\u043b\u044f\u0434\u0435\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0447\u0430\u0449\u0435 \u0432\u043d\u0438\u0437; 2) \u043f\u0440\u0438\u043a\u043e\u0441\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u0438\u043b\u0438", "type": "Document"}}