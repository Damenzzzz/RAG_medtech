440\u043e\n\nPFAPA \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0443\u044e\u0442\u0441\u044f.\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 IgD; \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 IL-1b,\n\n\u0424\u041d\u041e\u03b1, IL-6, IL-12\u044070;\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u041e\u0410\u041a: \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u041e\u042d, \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437;\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u0420\u0411, \u0443\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u0430 \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439. ANA \u0438 \u0420\u0424 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0443 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432;\n\u2022 \u041a\u0440\u043e\u0432\u044c \u043d\u0430 \u0441\u0442\u0435\u0440\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n(\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u0435\u0439)\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c\n\u2022 \u041f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435/\u043f\u043e\u043b\u043d\u043e\u0433\u0435\u043d\u043e\u043c\u043d\u043e\u0435 \u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435:\n\u041c\u0430\u0434\u0436\u0438\u0434\u0430\n\u0434\u0432\u0443\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043c\u0443\u0442\u0430\u0446\u0438\u044f\u043c\u0438 \u0432 \u0433\u0435\u043d\u0435 \u043b\u0438\u043f\u0438\u043d\u0430 2 (LPIN2) (\u0414\u0435\u0444\u0435\u043a\u0442\u044b \u0432\nLPIN2 \u043d\u0430\u0440\u0443\u0448\u0430\u044e\u0442 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u0435\u0433\u0443\u043b\u044f\u0446\u0438\u044e \u0438\u043d\u0444\u043b\u0430\u043c\u043c\u0430\u0441\u043e\u043c\u044b\nNALP3, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0438 IL-1-\u0431\u0435\u0442\u0430\n\u043c\u0443\u0442\u0430\u043d\u0442\u043d\u044b\u043c\u0438 \u043a\u043b\u0435\u0442\u043a\u0430\u043c\u0438).\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f IgM, IgA;\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u041e\u0410\u041a: \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u041e\u042d;\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u0420\u0411;\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u2022 \u041f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435/\u043f\u043e\u043b\u043d\u043e\u0433\u0435\u043d\u043e\u043c\u043d\u043e\u0435 \u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u043c\u0443\u0442\u0430\u0446\u0438\u044f\n\n\u0411\u043b\u0430\u0443 \u0433\u0435\u043d\u0430 NOD2;\n\u2022 \u0418\u043c\u043c\u0443\u043d\u043e\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0431\u0438\u043e\u043c\u0430\u0440\u043a\u0435\u0440\u0430 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u2013 \u0431\u0435\u043b\u043a\u0430 S100A12\n(\u043a\u0430\u043b\u044c\u0433\u0440\u0430\u043d\u0443\u043b\u0438\u043d \u0421).\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u041e\u0410\u041a: \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u041e\u042d;\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0421\u0420\u0411;\n\u0420\u0410\u0420\u0410\n\u2022 \u041f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435/\u043f\u043e\u043b\u043d\u043e\u0433\u0435\u043d\u043e\u043c\u043d\u043e\u0435 \u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u0432 \u0433\u0435\u043d\u0435 PSTPIP1.\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\n\u0410\u0412\u0421 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u2022 \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0438\u043d\u043e\u0432\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438: \u0441\u0438\u043d\u043e\u0432\u0438\u0430\u043b\u044c\u043d\u0430\u044f\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u0436\u0435\u043b\u0442\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430, \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\n\u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043b\u043e\u0432, \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u043d\u0435\u0442;\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\n\u2022 \u041e\u0410\u041a: \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0421\u041e\u042d;\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0421\u0420\u0411;\nDIRA \u2022 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0438: \u043f\u043e\u0441\u0435\u0432 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439;\n\u2022 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u043e\u0447\u0438: \u043f\u043e\u0441\u0435\u0432 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439;\n\n\u2022 \u041f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435/\u043f\u043e\u043b\u043d\u043e\u0433\u0435\u043d\u043e\u043c\u043d\u043e\u0435 \u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u0434\u0435\u0444\u0438\u0446\u0438\u0442\nIL1RN 2q\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u041e\u0410\u041a: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u041e\u042d, \u0433\u0438\u043f\u043e\u0445\u0440\u043e\u043c\u043d\u0430\u044f \u0430\u043d\u0435\u043c\u0438\u044f, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\n\n\u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u044f, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0437;\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u041b\u0422, \u0410\u0421\u0422, \u0421\u0420\u0411.\nCANDLE \u2022 \u041f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435/\u043f\u043e\u043b\u043d\u043e\u0433\u0435\u043d\u043e\u043c\u043d\u043e\u0435 \u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u043c\u0443\u0442\u0430\u0446\u0438\u0439: PSMB4, PSMA3, PSMB8, PSMB9, POMP.\n\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044e\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0418\u041b-6: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0430 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f \u0418\u041b-6.\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u25cf \u041e\u0410\u041a \u0441 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u0439- \u0430\u043d\u0435\u043c\u0438\u044f, \u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u044f,\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f.\n\u25cf \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043e\u0441\u0435\u0434\u0430\u043d\u0438\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432 (\u0421\u041e\u042d) \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435.\n\u25cf C-\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a: \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435.\n\n\u25cf \u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0423\u0440\u043e\u0432\u043d\u0438\nDADA 2 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 (IgA, IgM, IgG) \u0441\u043d\u0438\u0436\u0435\u043d\u044b.\n\u25cf \u041f\u0443\u043d\u043a\u0446\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430, \u0442\u0440\u0435\u043f\u0430\u043d\u043e\u0431\u0438\u043e\u043f\u0441\u0438\u044f: \u0430\u043f\u043b\u0430\u0437\u0438\u044f\n\u043a\u0440\u0430\u0441\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u0430 \u0438\u043b\u0438 \u043f\u0430\u043d\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f, \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f\n\n\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e CD8+.\n\u25cf \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u043d\u043e\u044d\u043a\u0437\u043e\u043c\u043d\u043e\u0435\n\u0441\u0435\u043a\u0432\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u0438\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432\n\u0433\u0435\u043d\u0430 ADA2\n\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f [5,6,8,9,14, 34-36]:\n\u0410\u0412\u0421 \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e-\u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\n\u042d\u041a\u0413: \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 P\u2013Q \u0438/\u0438\u043b\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 QRS, \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0432\u0432\u0435\u0440\u0445 \u0438\u043b\u0438\n\u0432\u043d\u0438\u0437 \u043e\u0442 \u0438\u0437\u043e\u043b\u0438\u043d\u0438\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 S\u2013T \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043e\u0442\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445, \u0434\u0432\u0443\u0445\u0444\u0430\u0437\u043d\u044b\u0439 \u0438\u043b\u0438\n\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0437\u0443\u0431\u0435\u0446 \u0422. \u0412\u043d\u0435 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u042d\u041a\u0413.\nFMF \u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u0423\u0417\u0418 \u041e\u0411\u041f, \u043f\u043e\u0447\u0435\u043a: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b,\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u0442\u0438\u043a\u043e-\u043c\u0435\u0434\u0443\u043b\u043b\u044f\u0440\u043d\u043e\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u0446\u0438\u0438.\n\u2022 \u0423\u0417\u0418 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432: \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0430\u0440\u0442\u0440\u0438\u0442\u0430, \u0441\u0438\u043d\u043e\u0432\u0438\u0442\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430.\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\n\u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432: \u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u044f \u044d\u043f\u0438\u0444\u0438\u0437\u043e\u0432,\n\u0445\u0440\u044f\u0449\u0430, \u043b\u0438\u0437\u0438\u0441 \u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0438 \u0445\u0440\u044f\u0449\u0435\u0432\u043e\u0439 \u0442\u043a\u0430\u043d\u0438;\n\u2022 \u0423\u0417\u0418 \u041e\u0411\u041f, \u043f\u043e\u0447\u0435\u043a: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b,\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u0442\u0438\u043a\u043e-\u043c\u0435\u0434\u0443\u043b\u043b\u044f\u0440\u043d\u043e\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u0446\u0438\u0438.\n\u2022 \u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430: \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432 \u0438 \u0430\u0442\u0440\u043e\u0444\u0438\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e\n\nCINCA/ \u043c\u043e\u0437\u0433\u0430;\nNOMID \u2022 \u041e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u0441\u043a\u043e\u043f\u0438\u044f: \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438 \u0438 \u043e\u0442\u0435\u043a \u0434\u0438\u0441\u043a\u0430 \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0440\u0432\u0430\n(\u043f\u0430\u043f\u0438\u043b\u043b\u043e\u044d\u0434\u0435\u043c\u0430) \u0441 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0434\u0440\u0443\u0437 (\u0433\u0438\u0430\u043b\u0438\u043d\u043e\u0432\u044b\u0435, \u043a\u0430\u043b\u044c\u0446\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435\n\u0442\u0435\u043b\u044c\u0446\u0430, \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432 \u043f\u0440\u0435\u043b\u0430\u043c\u0438\u043d\u0430\u0440\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0440\u0432\u0430);\n\u2022 \u0410\u0443\u0434\u0438\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u2013 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u0439\u0440\u043e\u0441\u0435\u043d\u0441\u043e\u0440\u043d\u043e\u0439 \u0442\u0443\u0433\u043e\u0443\u0445\u043e\u0441\u0442\u0438\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u041a\u043e\u0436\u043d\u0430\u044f \u0431\u0438\u043e\u043f\u0441\u0438\u044f: \u043f\u0435\u0440\u0438\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u0430\u044f \u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u0430\u044f\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f, \u043e\u0442\u0435\u043a \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u0441\u043b\u043e\u0435\u0432 \u0434\u0435\u0440\u043c\u044b;\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u0423\u0417\u0418 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432: \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0430\u0440\u0442\u0440\u0438\u0442\u0430, \u0441\u0438\u043d\u043e\u0432\u0438\u0442\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430.\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\nHIDS/\n\u2022 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043f\u043e\u0447\u043a\u0438: \u0444\u043e\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u043b\u0438\u0444\u0435\u0440\u0430\u0446\u0438\u044f \u043c\u0435\u0437\u0430\u043d\u0433\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a \u0438\nMVKD\n\u043c\u0430\u0442\u0440\u0438\u043a\u0441\u0430, \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435 \u0441\u0442\u0435\u043d\u043e\u043a \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043e\u0432 \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u043e\u0432 \u0437\u0430 \u0441\u0447\u0435\u0442 \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043a\u043b\u0435\u0442\u043e\u043a\n\u043c\u0435\u0437\u0430\u043d\u0433\u0438\u044f \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0435\u0439, \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0432\nIgA \u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043e.\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u0423\u0417\u0418 \u041e\u0411\u041f, \u043f\u043e\u0447\u0435\u043a: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b,\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u0442\u0438\u043a\u043e-\u043c\u0435\u0434\u0443\u043b\u043b\u044f\u0440\u043d\u043e\u0439 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u0446\u0438\u0438.\nTRAPS\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435:\n\u2022 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043f\u043e\u0440\u0430\u0436\u0451\u043d\u043d\u043e\u0439 \u043a\u043e\u0436\u0438: \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u043e\u0439 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u0430\u043c\u0438 \u0438 \u043c\u043e\u043d\u043e\u0446\u0438\u0442\u0430\u043c\u0438.\n\u2022 \u041e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u0441\u043a\u043e\u043f\u0438\u044f: \u0443\u0432\u0435\u0438\u0442 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u043a\u043e\u043d\u044a\u044e\u043a\u0442\u0438\u0432\u0438\u0442\u043e\u043c, \u044d\u043f\u0438\u0441\u043a\u043b\u0435\u0440\u0438\u0442\u043e\u043c.\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435:\n\u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u0438 \u043a\u043e\u0441\u0442\u0435\u0439: \u043e\u0447\u0430\u0433\u0438 \u043e\u0441\u0442\u0435\u043e\u043b\u0438\u0437\u0430 \u0441\n\u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u043c \u0438\u0445 \u0441\u043a\u043b\u0435\u0440\u043e\u0437\u043e\u043c \u0438 \u0433\u0438\u043f\u0435\u0440\u043e\u0441\u0442\u043e\u0437\u043e\u043c \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0435\u0442\u0430\u0444\u0438\u0437\u043e\u0432.\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u2022 \u041c\u0430\u0433\u043d\u0438\u0442\u043d\u043e-\u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f: \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445\n\u041c\u0430\u0434\u0436\u0438\u0434\u0430 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u0445, \u043a\u043b\u044e\u0447\u0438\u0446\u0435, \u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043e\u0441\u0442\u0438\u0442.", "type": "Document"}}