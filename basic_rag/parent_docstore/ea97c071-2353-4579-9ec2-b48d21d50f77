442\u0430 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430)\n\n\u0444\u0438\u043b\u0433\u0440\u0430\u0441\u0442\u0438\u043c\u0430 \u0441 \u043e\u0434\u043d\u043e\u0439 \u043f/\u043a \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043d\u0435 \u0440\u0430\u043d\u0435\u0435 \u0447\u0435\u043c\n\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u043e\u0439 \u0447\u0435\u0440\u0435\u0437 24 \u0447\u0430\u0441\u0430 \u0438 \u043d\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 14-\u044b\u0445\n\n\u043f\u043e\u043b\u0438\u044d\u0442\u0438\u043b\u0435\u043d\u0433\u043b\u0438\u043a\u043e\u043b\u044f, \u0441\u0443\u0442. \u043f\u043e\u0441\u043b\u0435 \u043a\u0443\u0440\u0441\u0430 \u0425\u0422\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\n\u041b\u0435\u043d\u043e\u0433\u0440\u0430\u0441\u0442\u0438\u043c \u0420\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0439 19,2 \u043c\u043b\u043d. \u041c\u0415 (\u0438\u043b\u0438 150 \u043c\u043a\u0433) \u043d\u0430 \u043c2\n\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430 (0,64 \u043c\u043b\u043d. \u041c\u0415\n\n\u0433\u043b\u0438\u043a\u043e\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0413- \u0438\u043b\u0438 5 \u043c\u043a\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430)\n\u041a\u0421\u0424 \u0432 \u0434\u0435\u043d\u044c \u043f/\u043a \u0438\u043b\u0438 \u0432/\u0432 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\n\u0447\u0435\u0440\u0435\u0437 24\u201372 \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435\n\n\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0434\u043d\u044f \u0425\u0422 \u0434\u043e\n\u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435\