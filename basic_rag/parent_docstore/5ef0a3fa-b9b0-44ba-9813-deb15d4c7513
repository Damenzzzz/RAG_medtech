35\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c.\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f\u043c\u0438 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043c\u0435\u043b\u0444\u0430\u043b\u0430\u043d* \u0441\n\u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c/\u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 + \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c + \u0442\u0430\u043b\u0438\u0434\u043e\u043c\u0438\u0434*/\u043b\u0435\u043d\u0430\u043b\u0438\u0434\u043e\u043c\u0438\u0434 \u0441\n\n\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c/\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u0441 \u0411\u043e\u0440\u0442\u0435\u0437\u043e\u043c\u0438\u0431\u043e\u043c.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0410\u0410 \u0442\u0438\u043f\u0430 \u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\u0430.\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f:\n\n\u2022 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432 \u0441\u0435\u0431\u044f \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430;\n\u2022 \u043f\u0440\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0430\u0440\u0442\u0440\u