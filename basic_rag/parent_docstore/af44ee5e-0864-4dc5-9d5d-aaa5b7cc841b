8\u0439 \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f\n\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u043d\u0430\u0447\u0430\u0442\u044c\n\u0412\u0418\u0427 \u0410\u0420\u0422\n\u0410\u041d\u0410\u041c\u041d\u0415\u0417\n\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u041f\u043e\u043b\u043d\u044b\u0439 + + \u041f\u0435\u0440\u0432\u043e\u0435 \u043f\u043e\u0441\u0435- \u041f\u0440\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043a\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0449\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u0432\u0440\u0430\u0447\u0443, \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0432 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435:\n\n\u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u0430\u043d\u0430\u043c\u043d\u0435\u0437 (\u0432 + \u041f\u0435\u0440\u0432\u043e\u0435 \u043f\u043e\u0441\u0435- \u0420\u0430\u043d\u043d\u0438\u0435 \u0421\u0421\u0417: \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\n\u0442.\u0447. \u0440\u0430\u043d\u043d\u0438\u0435 \u0421\u0421\u0417, \u0449\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0443\n\u0434\u0438\u0430\u0431\u0435\u0442, \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u044f, \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u043e\u0434\u0441\u0442\u0432\u0430 (\u043c\u0443\u0436\u0447\u0438\u043d \u043c\u043e\u043b\u043e\u0436\u0435 55 \u043b\u0435\u0442\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0447\u0435\u043a, \u0438 \u0436\u0435\u043d\u0449\u0438\u043d \u043c\u043e\u043b\u043e\u0436\u0435 65 \u043b\u0435\u0442)\n\u043f\u0435\u0447\u0435\u043d\u0438)\n\u0421\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f + + \u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0441\u0435-\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0449\u0435\u043d\u0438\u0435\n\u0442\u0435\u0440\u0430\u043f\u0438\u044f(i)\n\u041f\u0440\u043e\u0448\u043b\u044b\u0435 \u0438 \u0442\u0435\u043a\u0443\u0449\u0438\u0435 + + \u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0441\u0435-\n\u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0449\u0435\u043d\u0438\u0435\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u041f\u0440\u0438\u0432\u0438\u0432\u043e\u0447\u043d\u044b\u0439 + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0442\u0438\u0442\u0440 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u0438\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044e,\n\u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439,\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f\n\u041f\u0441\u0438\u0445\u043e\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d \u041e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 + + \u041a\u0430\u0436\u0434\u044b\u0435 6-12 \u041f\u0440\u0438 \u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u0435\n\u044b\u0439 (\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0436\u0438\u0437\u043d\u0438 \u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0432\u0440\u0435\u0434\u043d\u044b\u0445\n\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f, \u043a\u0443\u0440\u0435\u043d\u0438\u0435, \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435\n\u043f\u0438\u0442\u0430\u043d\u0438\u0435, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438,\n\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435\n\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u043e\u0432) \u041f\u0440\u043e\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438 \u043e\u043a\u0430\u0437\u0430\u0442\u044c\n\u0422\u0440\u0443\u0434\u043e\u0432\u0430\u044f + + \u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443, \u0435\u0441\u043b\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435 \u041f\u0440\u043e\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0435\u0441\u043b\u0438\n\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0438 + + \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\n\u0431\u044b\u0442\u043e\u0432\u043e\u0435\n\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435\n\u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 + +\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u041f\u0430\u0440\u0442\u043d\u0435\u0440 \u0438 \u0434\u0435\u0442\u0438 + \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430\n\u0438 \u0434\u0435\u0442\u0435\u0439, \u0435\u0441\u043b\u0438 \u043e\u043d\u0438\n\u043f\u043e\u0434\u0432\u0435\u0440\u0436\u0435\u043d\u044b \u0440\u0438\u0441\u043a\u0443\n\u0421\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0435 \u0438 \u0410\u043d\u0430\u043c\u043d\u0435\u0437 \u043f\u043e\u043b\u043e\u0432\u043e\u0439 + \u041a\u0430\u0436\u0434\u044b\u0435 6-12 \u041f\u0440\u0438\u043d\u044f\u0442\u044c \u043c\u0435\u0440\u044b \u0434\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f\n\u0440\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0436\u0438\u0437\u043d\u0438 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0441\n\u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u0439 \u0441\u0435\u043a\u0441 + \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0415\u0441\u043b\u0438 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0440\u0438\u0441\u043a \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438\n\u043f\u043e\u043b\u043e\u0432\u044b\u043c \u043f\u0443\u0442\u0435\u043c, \u0442\u043e \u0435\u0433\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c\n\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430 \u0438 + \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441 \u043d\u0430\u0447\u0430\u043b\u0430 \u0410\u0420\u0422\n\u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0438\u0435 \u0443 \u0412\u0418\u0427-\u0434\u0438\u0441\u043a\u043e\u0440\u0434\u0430\u043d\u0442\u043d\u044b\u0445 \u043f\u0430\u0440\n\u0441\u0442\u0430\u0442\u0443\u0441\u0430\n\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0437\u0430\u0447\u0430\u0442\u0438\u044f + +\n\u0413\u0438\u043f\u043e\u0433\u043e\u043d\u0430\u0434\u0438\u0437\u043c + + \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0436\u0430\u043b\u043e\u0431\u0430\u043c\u0438 \u043d\u0430\n(\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043a\u043b\u0438\u043c\u0430\u043a\u0441) \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0412\u0418\u0427-\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u042f\n\u0412\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u044f \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 + \u041a\u0430\u0436\u0434\u044b\u0435 3-6 \u0411\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0412\u041d\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0412\u0418\u0427 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0410\u0420\u0422. \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0442\u0435\u0441\u0442 \u043d\u0430 \u0433\u0435\u043d\u043e\u0442\u0438\u043f\u0438\u0447\u0435\u0441\u043a\u0443\u044e\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0442\u0435\u0441\u0442\u0430 \u043d\u0430\n\u0432\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u044c, \u0435\u0441\u043b\u0438\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0412\u0418\u0427 \u0439 \u043d\u0435\u0443\u0434\u0430\u0447\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u0412\u041d \u0412\u0418\u0427 \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 + + \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e, \u043b\u0438\u0431\u043e \u0435\u0441\u043b\u0438\n\u043a\u0440\u043e\u0432\u0438 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0440\u0438\u0441\u043a \u0441\u0443\u043f\u0435\u0440\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438.\nR5-\u0442\u0440\u043e\u043f\u0438\u0437\u043c (\u043f\u0440\u0438 +/- \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433, \u0435\u0441\u043b\u0438 \u0432\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438) \u0441\u0445\u0435\u043c\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u043e\u0442\u0440\u0435\u043d\n\u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442 R5-\u0442\u0440\u043e\u043f\u043d\u043e\u0433\u043e \u0432\u0438\u0440\u0443\u0441\u0430\n\u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u044f CD4: \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0435 + + \u041a\u0430\u0436\u0434\u044b\u0435 6 - 12 \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u043f\u0440\u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u043c\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e, \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043d\u0430 \u0410\u0420\u0422 \u0438 \u0435\u0441\u043b\u0438\n\u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0421D4 > 350 \u043a\u043b/\u043c\u043a\u043b(ii)\nCD4/CD8 \u0438 % (\u043c\u043e\u0436\u043d\u043e \u0421\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 CD4/CD8 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u0442\u0430\u043a\u0436\u0435: CD8 \u0438 %) \u043f\u0440\u043e\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u043c\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439\nHLA B*5701 (\u043f\u0440\u0438 + \u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0410\u0420\u0422 \u0441 ABC\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438) \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433, \u0435\u0441\u043b\u0438 \u043e\u043d\n\u0440\u0430\u043d\u0435\u0435 \u043d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b\u0441\u044f\n\u041a\u041e-\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418\n\u0418\u041f\u041f\u041f \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0435\u0441\u0442 + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e/ \u0411\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\n\u043d\u0430 \u0441\u0438\u0444\u0438\u043b\u0438\u0441 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u0438\u0441\u043a\u0430\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0421\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043d\u0430 \u0418\u041f\u041f\u041f + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e/ \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043f\u0440\u0438\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u0438\u0441\u043a\u0430 \u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0412\u0438\u0440\u0443\u0441\u043d\u044b\u0439 \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0435\u0441\u0442 + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e/ \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u0438\u0441\u043a\u0430 (\u043d\u0430\u043f\u0440.,\n\u0