3e \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0430 \u2013 \u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432\n\n\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0435;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0430 \u2013 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430.\n\n2.1 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u041f\u0435\u0434\u0438\u0430\u0442\u0440, \u0412\u041e\u041f, \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433, \u043e\u0442\u043e\u0440\u0438\u043d\u043e\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u043b\u043e\u0433, \u0432\u0440\u0430\u0447 \u043b\u044e\u0431\u043e\u0439 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438,\n\u0444\u0435\u043b\u044c\u0434\u0448\u0435\u0440\n\u043f\u0440\u0438 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441 \u0436\u0430\u043b\u043e\u0431\u0430\u043c\u0438\n\n\u041f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0438\n\u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u044f\u0442 \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0443\u044e\n\u0442\u0440\u0430\u0445\u0435\u043e\u0441\u0442\u043e\u043c\u0438\u044e\n\n(\u043f\u0440\u0438 \u0434\u0438\u0441\u043f\u043d\u043e\u044d \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435\n\u0441\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u0445\u0435\u0438 \u043f\u0440\u0438 \u0432\u043a\u043b\u0438\u043d\u0435\u043d\u0438\u0438\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0445 \u0442\u0435\u043b \u0434\u043e \u0431\u0438\u0444\u0443\u0440\u043a\u0430\u0446\u0438\u0438).\n\n\u0412\u0441\u0435 \u0441\u043b\u0443\u0447\u0430\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u0418\u0422\u041f \u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f \u043d\u0430 \u0438\u0445 \u0437\u0430\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435\n\u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\n\u042d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e \u043c\u0435\u0441\u0442\u0443 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440 \u0434\u043b\u044f\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0438\u0431\u0440\u043e\u044d\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0438\u0438.\n\n\u041d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043a \u044d\u043d\u0434\u043e\u0441\u043a\u0