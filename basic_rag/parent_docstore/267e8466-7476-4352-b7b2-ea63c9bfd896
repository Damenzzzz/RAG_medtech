440\u0430\u043d\u0435\u043d\u0438\u044f\n\u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\n\n\u043e\u0442 \u00ab04\u00bb \u0430\u043f\u0440\u0435\u043b\u044f 2019 \u0433\u043e\u0434\u0430\n\u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b No61\n\n\u041a\u041b\u0418\u041d\u0418\u0427\u0415\u0421\u041a\u0418\u0419 \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0418 \u0418 \u041b\u0415\u0427\u0415\u041d\u0418\u042f\n\n\u0412\u041d\u0415\u041b\u0415\u0413\u041e\u0427\u041d\u042b\u0419 \u0422\u0423\u0411\u0415\u0420\u041a\u0423\u041b\u0415\u0417\n\u0421 \u0428\u0418\u0420\u041e\u041a\u041e\u0419 \u041b\u0415\u041a\u0410\u0420\u0421\u0422\u0412\u0415\u041d\u041d\u041e\u0419 \u0423\u0421\u0422\u041e\u0419\u0427\u0418\u0412\u041e\u0421\u0422\u042c\u042e\n\n1. \u0412\u0412\u041e\u0414\u041d\u0410\u042f \u0427\u0410\u0421\u0422\u042c\n1.1 \u041a\u043e\u0434(\u044b) \u041c\u041a\u0411-10:\n\u041c\u041a\u0411-10\n\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\n\n\u041a\u043e\u0434\nA18 \u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\n1.2 \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438/\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: 2015 \u0433\u043e\u0434 (\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 2018\n\n\u0433.)\n\n1.3 \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435: \u0411\u041e\u0418-\u0431\u043e\u043b\u044c\u0448\u0438\u0435\n\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\n\u0412\u0418\u0427 \u2013 \u0432\u0438\u0440