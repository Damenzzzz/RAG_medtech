0441\u0440\u0435\u0434 \u043f\u0440\u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c\n\u043d\u0435\u043f\u0440\u044f\u043c\u043e\u043c \u0430\u043d\u0442\u0438\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432\u043e\u043c \u0442\u0435\u0441\u0442\u0435, \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u0439, \u043e\u0441\u0442\u0440\u043e\u0439\n\u043c\u0430\u0441\u0441\u0438\u0432\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u043e\u043f\u043e\u0442\u0435\u0440\u0435;\n\n13. \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044e \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 (\u043e\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0443\u0441\u043b\u043e\u0432\u0438\u044f\n\u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430):\n\u0418\u043d\u0444\u0443\u0437\u0438\u044f (\u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u044f) \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438\u043b\u0438 \u0446\u0435\u043d\u0442\u0440\u0435, \u043e\u0441\u043d\u0430\u0449\u0435\u043d\u043d\u044b\u0445 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\n\n\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430 \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0420\u041a No750 \u043e\u0442 23.12.2013.\n\u041c\u0435\u0440\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0421\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u043c\n\u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c \u00ab\u0421\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e-\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u043c \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f\u00bb,\n\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u041f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d \u043e\u0442 17 \u044f\u043d\u0432\u0430\u0440\u044f\n\n2012 \u0433\u043e\u0434\u0430 No87.\n\n14. \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430:\n\n\u2022 \u041e\u0442\u043c\u0435\u043d\u0430 \u0431\u0430\u0437\u043e\u0432\u043e\u0439 \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0442\u0440\u0435\u0445 \u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430\n\u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u0438/\u0438\u043b\u0438\n\u044d\u043a\u0441\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0420\u0422\u041f\u0425.\n\u2022 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430: \u041e\u0410\u041a \u0441 \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u0430\u043c\u0438, \u0433\u0440\u0443\u043f\u043f\u0430 \u043a\u0440\u043e\u0432\u0438, \u0440\u0435\u0437\u0443\u0441-\u0444\u0430\u043a\u0442\u043e\u0440,\n\u0440\u0435\u0437\u0443\u0441-\u0444\u0435\u043d\u043e\u0442\u0438\u043f, \u043f\u0440\u044f\u043c\u0430\u044f \u0438 \u043d\u0435\u043f\u0440\u044f\u043c\u0430\u044f \u043f\u0440\u043e\u0431\u044b \u041a\u0443\u043c\u0431\u0441\u0430, \u041b\u0414\u0413, \u0433\u0430\u043f\u0442\u043e\u0433\u043b\u043e\u0431\u0438\u043d,\n\nHLA\u0442\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043d\u043e\u0440\u0430 \u0438 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430, \u0418\u0424\u0410 \u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u044b \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412 \u0438 \u0421,\n\u043c\u0438\u043a\u0440\u043e\u0440\u0435\u0430\u043a\u0446\u0438\u044f, \u0418\u0424\u0410 \u043d\u0430 \u0412\u0418\u0427, \u041f\u0426\u0420 \u043d\u0430 \u0446\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441.\n\u2022 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043d\u043e\u0440\u0430: \u041e\u0410\u041a, \u0433\u0440\u0443\u043f\u043f\u0430 \u043a\u0440\u043e\u0432\u0438, \u0440\u0435\u0437\u0443\u0441-\u0444\u0430\u043a\u0442\u043e\u0440, \u0440\u0435\u0437\u0443\u0441-\u0444\u0435\u043d\u043e\u0442\u0438\u043f\u0418\u0424\u0410\n\u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u044b \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412 \u0438 \u0421, \u043c\u0438\u043a\u0440\u043e\u0440\u0435\u0430\u043a\u0446\u0438\u044f, \u0418\u0424\u0410 \u043d\u0430 \u0412\u0418\u0427 (\u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441\n\n\u041f\u0440\u0430\u0432\u0438\u043b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043b\u0438\u0446 \u043f\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\n\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0445\n\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u041f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d \u043e\u0442 3 \u043d\u043e\u044f\u0431\u0440\u044f 2011 \u0433\u043e\u0434\u0430\nNo 1280), \u041f\u0426\u0420 \u043d\u0430 \u0446\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441\n\n15. \u041c\u0435\u0442\u043e\u0434\u0438\u043a\u0430 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:\n\u041f\u0435\u0440\u0435\u0434 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u044f:\n\u2022 \u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d (\u0438\u043b\u0438 \u043c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d) 1 \u043c\u0433/\u043a\u0433\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0438\u043b\u0438 \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 4\n\u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e;\n\n\u2022 \u041e\u043d\u0434\u0430\u043d\u0441\u0435\u0442\u0440\u043e\u043d 8-16 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e;\n\u2022 \u041f\u0440\u0438 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043b\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u2013 \u0434\u0438\u0430\u0437\u0435\u043f\u0430\u043c 10 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e,\n\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e.\n\u041f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u043a\u0440\u0438\u043e\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u0432\u0441\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\n\n\u0438\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u044e \u0443\u0432\u043b\u0430\u0436\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 \u043d\u043e\u0441\u043e\u0432\u044b\u0435 \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u044b \u0438\u043b\u0438 \u043b\u0438\u0446\u0435\u0432\u0443\u044e \u043c\u0430\u0441\u043a\u0443.\n\u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433, \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u0443\u044e\u0442\u0441\u044f\n\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u043e\u043c \u0410\u0414, \u0434\u0438\u0443\u0440\u0435\u0437, \u042d\u041a\u0413, \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u0438\u044f \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u0438 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u043c,\n\n6\n\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430. \u041f\u0435\u0440\u0432\u0430\u044f \u043f\u043e\u0440\u0446\u0438\u044f \u043c\u043e\u0447\u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0431\u0449\u0435\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435.\n\n\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0443\u0440\u0438\u0438, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u0445 \u0433\u0435\u043c\u043e\u043b\u0438\u0437\u0430 (\u0431\u043e\u043b\u0438 \u0432\n\u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0436\u0438\u0432\u043e\u0442\u0435, \u043e\u0437\u043d\u043e\u0431, \u043e\u043b\u0438\u0433\u0443\u0440\u0438\u044f, \u0430\u043d\u0443\u0440\u0438\u044f) \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430, \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u044b, \u041b\u0414\u0413, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432, \u0433\u0430\u043f\u0442\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430,\n\u043f\u0440\u044f\u043c\u043e\u0439 \u0438 \u043d\u0435\u043f\u0440\u044f\u043c\u043e\u0439 \u043f\u0440\u043e\u0431\u044b \u041a\u0443\u043c\u0431\u0441\u0430.\n\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 DLI \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1\u0445106CD3 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a \u043d\u0430 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u043c \u043c\u0430\u0441\u0441\u044b\n\u0442\u0435\u043b\u0430 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 (gradeI), \u0432 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438 \u043d\u0435\u043f\u043e\u043b\u043d\u043e\u0439\n\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u043d\u0438\u0436\u0435\u043d\u0430 \u0434\u043e 5\u0445105CD3 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a.\n[4]\n\u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0442 \u0441 \u0447\u0430\u0441\u0442\u043e\u0442\u043e\u0439 1 \u0440\u0430\u0437 \u0432 2-4 \u043d\u0435\u0434\u0435\u043b\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442\n\n\u043d\u0430\u043b\u0438\u0447\u0438\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u0441 \u044d\u0441\u043a\u0430\u043b\u0430\u0446\u0438\u0435\u0439 \u0434\u043e\u0437\u044b \u043f\u043e 5\u0445106 \u0421D3 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u043a\u043b\u0435\u0442\u043e\u043a/\u043a\u0433 \u0434\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u043e\u0437\u044b 1\u0445107.\n\u0418\u043d\u0442\u0435\u0440\u0444\u0435\u0440\u043e\u043d \u0430\u043b\u044c\u0444\u0430 (1\u0445106 \u041c\u0415) \u0438\u043b\u0438 \u0438\u043d\u0442\u0435\u0440\u043b\u0435\u0439\u043a\u0438\u043d 2 (1-2\u0445106 \u041c\u0415) \u0432\u0432\u043e\u0434\u044f\u0442 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e\n\u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0434\u0435\u043d\u044c \u043f\u043e\u0441\u043b\u0435 DLI \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u043e\u043c \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a \u0438\u043b\u0438 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u0420\u0422\u041f\u0425 \u043f\u043e\u0441\u043b\u0435 \u0434\u0432\u0443\u0445 DLI \u0432 \u0441\u043b\u0443\u0447\u0430\u044f\u0445, \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430\n\u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b\u0430\u0441\u044c \u043f\u043e \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c. [3, 4]\n\u041f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c\u0438 EBMT [10].\n\n\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 - \u043c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u0430 \u0432 \u0434\u043e\u0437\u0435 2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\n\u0432 \u0434\u0432\u0430 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0442\u0440\u0435\u0445 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0432\u0442\u043e\u0440\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u2013 \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u0432\n\u0434\u043e\u0437\u0435 5-10 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u0436\u0434\u044b\u0435 5-7 \u0434\u043d\u0435\u0439 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0421). [11-14]\n\n16. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b/\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:\n\n\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\n\u041d\u0435\u0442 \u043e\u0442\u0432\u0435\u0442\u0430 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438 \u0438/\u0438\u043b\u0438\n\n\u041f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0433\u043e \u0445\u0438\u043c\u0435\u0440\u0438\u0437\u043c\u0430\n\u041f\u043e\u043b\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u0420\u0435\u043c\u0438\u0441\u0441\u0438\u044f\n\u041f\u043e\u043b\u043d\u044b\u0439 \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0439 (\u0431\u043e\u043b\u0435\u0435 95% CD3+ \u043a\u043b\u0435\u0442\u043e\u043a \u0438\u043c\u0435\u044e\u0442\n\u0434\u043e\u043d\u043e\u0440\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435) \u0445\u0438\u043c\u0435\u0440\u0438\u0437\u043c\n\nIII. \u041e\u0420\u0413\u0410\u041d\u0418\u0417\u0410\u0426\u0418\u041e\u041d\u041d\u042b\u0415 \u0410\u0421\u041f\u0415\u041a\u0422\u042b \u0412\u041d\u0415\u0414\u0420\u0415\u041d\u0418\u042f \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b\u0410:\n17. \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445:\n1) \u041a\u0435\u043c\u0430\u0439\u043a\u0438\u043d \u0412\u0430\u0434\u0438\u043c \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0410\u041e \"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\n\u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438\", \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c\n\u043e\u043d\u043a\u043e\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n2) \u041a\u043b\u043e\u0434\u0437\u0438\u043d\u0441\u043a\u0438\u0439 \u0410\u043d\u0442\u043e\u043d \u0410\u043d\u0430\u0442\u043e\u043b\u044c\u0435\u0432\u0438\u0447 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0410\u041e\n\"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438\u0438\", \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\n\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043e\u043d\u043a\u043e\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n3) \u0420\u0430\u043c\u0430\u0437\u0430\u043d\u043e\u0432\u0430 \u0420\u0430\u0439\u0433\u0443\u043b\u044c \u041c\u0443\u0445\u0430\u043c\u0431\u0435\u0442\u043e\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u0410\u041e\n\"\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\", \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043a\u0443\u0440\u0441\u043e\u043c \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.\n\n7\n\n4) \u0413\u0430\u0431\u0431\u0430\u0441\u043e\u0432\u0430 \u0421\u0430\u0443\u043b\u0435 \u0422\u0435\u043b\u0435\u043c\u0431\u0430\u0435\u0432\u043d\u0430 \u2013 \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e-\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c\n\n\u0433\u0435\u043c\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u0437\u043e\u0432.\n5) \u041a\u0430\u0440\u0430\u043a\u0443\u043b\u043e\u0432 \u0420\u043e\u043c\u0430\u043d \u041a\u0430\u0440\u0430\u043a\u0443\u043b\u043e\u0432\u0438\u0447 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0410\u043a\u0430\u0434\u0435\u043c\u0438\u043a\n\u041c\u0410\u0418 \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438\n\u0