0438\n\u0441\u0438\u0441\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 \u0438\n\n\u0449\u0435\u043b\u0447\u043a\u043e\u043c, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439\n\u0440\u0430\u043d\u043d\u0438\u043c \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438;\n\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0441\u0442\u0430\u0432\u0430\u0442\u044c \u00ab\u043c\u0438\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f\u00bb\n\u043e\u0442 I \u0442\u043e\u043d\u0430, \u043b\u0443\u0447\u0448\u0435 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f\n\n\u0432\u044b\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0441\u0435\u0440\u0434\u0446\u0430 \u043d\u0430\n\u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435;\n\u0444\u043e\u043d\u0435\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0430 \u043e\u0442 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u0432\u0435\u0440\u0445\u0443\u0448\u043a\u0438 \u043a \u043b\u0435\u0432\u043e\u043c\u0443 \u0440\u0435\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u043b\u0438\n\n\u043a\u0440\u0430\u044e \u0433\u0440\u0443\u0434\u0438\u043d\u044b. \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e\n\u041d\u0430 \u042d\u0445\u043e\u041a\u0413: \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430;\n\u043f\u0440\u043e\u0432\u0438\u0441\u0430\u043d\u0438\u0435 \u0441\u0442\u0432\u043e\u0440\u043a\u0438 \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0435\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043b\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435\n\n\u043f\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044f \u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435, \u043a\u043e\u043d\u0446\u0435 \u0438\u043b\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430; \u0434\u0430\u043d\u043d\u044b\u0435\n\u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0432\u0441\u0435\u0439 \u042d\u0445\u043e\u041a\u0413\n\u0441\u0438\u0441\u0442\u043e\u043b\u044b. \u0412 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 (\u0440\u0435\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\n\u0432\u0440\u0435\u043c\u044f \u0434\u0438\u0441\u043a\u0443\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432\u0430\u043b\u044c\u0432\u0443\u043b\u0438\u0442 \u0438\u043b\u0438\n\u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0432\u0435\u0433\u0435\u0442\u0430\u0446\u0438\u0438 \u043d\u0430\n\u0433\u043b\u0443\u0431\u0438\u043d\u044b \u043f\u0440\u043e\u0432\u0438\u0441\u0430\u043d\u0438\u044f \u043a\u043b\u0430\u043f\u0430\u043d\u0430\u0445)\n\u0441\u0442\u0432\u043e\u0440\u043a\u0438 \u043a\u043b\u0430\u043f\u0430\u043d\u0430.\n\n\u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b \u0427\u0430\u0441\u0442\u043e \u0443 \u043b\u0438\u0446 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e - -\n\u044c\u043d\u044b\u0439 \u0441\u0438\u0441\u0442\u043e\u043b\u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430;\n\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u0443\u043c \u0441\u0438\u0441\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u0443\u043c\n\n\u043d\u0435\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439,\n\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430,\n\u043e\u0442\u0447\u0435\u0442\u043b\u0438\u0432\u043e \u0441\u0432\u044f\u0437\u0430\u043d \u0441\n\n\u0444\u0430\u0437\u0430\u043c\u0438 \u0434\u044b\u0445\u0430\u043d\u0438\u044f;\n\u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e\n\u0432\u044b\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u043e 2-\u043c\n\n\u043c\u0435\u0436\u0440\u0435\u0431\u0435\u0440\u044c\u0435 \u0441\u043b\u0435\u0432\u0430 \u043e\u0442\n\u0433\u0440\u0443\u0434\u0438\u043d\u044b, \u043d\u0430 \u0432\u0435\u0440\u0445\u0443\u0448\u043a\u0435\n\u0441\u0435\u0440\u0434\u0446\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432\u043e 2-\u043c\n\n\u043c/\u0440 \u0441\u043f\u0440\u0430\u0432\u0430 \u043e\u0442 \u043a\u0440\u0430\u044f\n\u0433\u0440\u0443\u0434\u0438\u043d\u044b; \u044d\u0442\u043e\u0442 \u0448\u0443\u043c \u043d\u0435\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f\n\n\u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0438\u0435\u043c II \u0442\u043e\u043d\u0430 \u0438\n\u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u043d\u0430 \u0441\u043e\u0441\u0443\u0434\u044b \u0448\u0435\u0438.\n\n\u0421\u0442\u0435\u043d\u043e\u0437 \u0423\u0441\u0438\u043b\u0435\u043d\u043d\u044b\u0439 - -\n\u0430\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0435\u0440\u0445\u0443\u0448\u0435\u0447\u043d\u044b\u0439 \u0442\u043e\u043b\u0447\u043e\u043a,\n\u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0432 V-\n\nVI \u043c\u0435\u0436\u0440\u0435\u0431\u0435\u0440\u044c\u0435\n\u043a\u043d\u0430\u0440\u0443\u0436\u0438 \u043e\u0442 \u043b\u0435\u0432\u043e\u0439\n\u0441\u0440\u0435\u0434\u0438\u043d\u043d\u043e-\u043a\u043b\u044e\u0447\u0438\u0447\u043d\u043e\u0439\n\n\u043b\u0438\u043d\u0438\u0438.\n\u041d\u0430\u0440\u0443\u0436\u043d\u0430\u044f \u0433\u0440\u0430\u043d\u0438\u0446\u0430\n\u043e\u0442\u043d\u043e\u