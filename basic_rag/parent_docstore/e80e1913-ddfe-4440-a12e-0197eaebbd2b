c\u0435\u0441\u044f\u0446\u0430\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432-\u043c\u0438\u0448\u0435\u043d\u0435\u0439;\n3. \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u0438 \u041f\u0440\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0438\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n4. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c \u0438 \u0441 1 \u0440\u0430\u0437 \u0432 3 \u043c\u0435\u0441\u044f\u0446\u0430\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u043f\u043e\u0447\u0435\u043a \u0434\u043b\u044f\n\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u043e\u0447\u043d\u043e\u0439 \u0410\u0413 \u0440\u0443\u0442\u0438\u043d\u043d\u043e;\n\n5. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0438\u0437\u043a\u043e\u0433\u043e \u0440\u0438\u0441\u043a\u0430 1 \u0440\u0430\u0437 \u0432 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n6. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043b\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0439 \u0410\u0413 \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0447\u0435\u0440\u0435\u0437 3\n\u043c\u0435\u0441\u044f\u0446\u0430, \u0434\u0430\u043b\u0435\u0435 1 \u0440\u0430\u0437 \u0432\n6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432.\n3. \u042d\u0425\u041e\u041a\u0413 1. \u0420\u0443\u0442\u0438\u043d\u043d\u043e \u0443 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432; 1 \u0440\u0430\u0437 \u0432 \u0433\u043e\u0434\n2. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0413\u041b\u0416 1 \u0440\u0430\u0437 \u0432 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n3. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442