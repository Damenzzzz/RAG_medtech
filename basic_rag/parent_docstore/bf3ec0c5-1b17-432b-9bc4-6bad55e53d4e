8\u0434\u0435\u043c\u0438\u0439,\n\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0441 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0438\n\n\u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 (\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\nNo 1). \u041f\u043e \u0434\u0430\u043d\u043d\u043e\u043c\u0443 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0443 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u044b \u0432\u0441\u0435\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b, \u043e\u0431\u0440\u0430\u0442\u0438\u0432\u0448\u0438\u0435\u0441\u044f \u043a \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u0438\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043e\u043f\u0440\u043e\u0441\u0430 \u0438 \u043f\u0440\u0438 \u043e\u0441\u043c\u043e\u0442\u0440\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u044b \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0430\u0442\u0435\u0440\u043e\u0441\u043a\u043b\u0435\u0440\u043e\u0437\u0430 \u0438/ \u0438\u043b\u0438\n\n\u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430 \u0440\u0430\u043d\u043d\u0435\u