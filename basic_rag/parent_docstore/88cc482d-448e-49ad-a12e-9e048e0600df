u043d\u043d\u043e\u0433\u043e \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f \u0438\u043b\u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043e\u0432.\n\n\u2022 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c)\n\n7\n\n\u2022 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0430 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u0438 \u043f\u0440\u0438 \u0441\u0430\u0442\u0443\u0440\u0430\u0446\u0438\u0438 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430\n\n(S\u0430O2)<92%);\n\u2022 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438;\n\u2022 \u043f\u043e\u0442\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0431\u0430;\n\u2022 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432;\n\n\u2022 \u044d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u044c\u043d\u043e-\u043a\u0430\u0442\u0438\u043e\u043d\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a (\u042d\u041a\u0411) \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430, \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f (\u0420\u0438\u0441.1).\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 3 -\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432\n\n\u0430\u043b\u043b\u0435\u0440\u0433\u043e\u043b\u043e\u0433 \u0441 \u0446\u0435\u043b\u044c\u044e \u043e\u0446\u0435\u043d\u043a\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u0438 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0411\u0410\n\n\u041b\u041e\u0420 \u0434\u043b\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0438\u043d\u0438\u0442\u0430 (\u0410\u0420) \u0438\n\u043b\u043e\u0440- \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\n\u043f\u0443\u043b\u044c\u043c\u043e\u043d\u043e\u043b\u043e\u0433 \u043f\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 (\u0434\u043b\u044f\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043c\u0443\u043a\u043e\u0432\u0438\u0441\u0446\u0438\u0434\u043e\u0437\u0430, \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u0440\u043e\u043a\u043e\u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0438 \u0434\u0440.)\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442 \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u043e\u0433\u0430 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c) \u0441 \u0446\u0435\u043b\u044c\u044e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u0438/\u0444\u0438\u0431\u0440\u043e\u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u0438 \u043f\u0440\u0438\n\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0435 \u0411\u0410 \u0441 \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u043e\u0440\u043e\u043a\u0430\u043c\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u043c \u0442\u0435\u043b\u043e\u043c, \u0437\u0430\u0442\u044f\u0436\u043d\u044b\u043c\u0438\n\n\u0431\u0440\u043e\u043d\u0445\u0438\u0442\u0430\u043c\u0438 \u043d\u0435\u044f\u0441\u043d\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438\n\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0437\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \u2013 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n8\n\n2.1 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a 1 - \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0411\u0410\n\n9\n\n2.2 \u0422\u0430\u0431\u043b\u0438\u0446\u0430 4 - \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\n\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u041a\u0430\u0448\u0435\u043b\u044c, \u0448\u0443\u043c\u043d\u043e\u0435 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041e\u0431\u0449\u0438\u0439 IgE, \u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u0448\u0435\u043b\u044c, \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u043d\u043e\u0435\n\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0444\u0430\u0434\u0438\u0430\u0442\u043e\u043f \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 <10 \u0434\u043d\u0435\u0439; \u043d\u0435\u0442\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0441\u0432\u0438\u0441\u0442\u044f\u0449\u0435\u0433\u043e \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u044d\u043f\u0438\u0437\u043e\u0434\u0430\u043c\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438.\n\n\u0431\u0440\u043e\u043d\u0445\u043e\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0435\u0439 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430.\n\u041e\u0441\u0442\u0440\u044b\u0439 \u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u0438\u0442 \u041a\u0430\u0448\u0435\u043b\u044c, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u0433\u0430\u0437\u044b \u043a\u0440\u043e\u0432\u0438 \u0414\u0435\u0442\u0438 \u0434\u043e 2-\u0445 \u043b\u0435\u0442. \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 2-5 \u0434\u0435\u043d\u044c \u043e\u0441\u0442\u0440\u043e\u0439\n\n\u0443\u0447\u0430\u0449\u0435\u043d\u043d\u043e\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439,\n\u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0438\u043c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3-4\n\u0434\u043d\u0435\u0439 \u043a\u0430\u0448\u043b\u0435\u043c, \u043e\u0434\u044b\u0448\u043a\u043e\u0439 \u044d\u043a\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430,\n\n\u0442\u0430\u0445\u0438\u043f\u043d\u043e\u044d 50-70 \u0432 \u043c\u0438\u043d\u0443\u0442\u0443, \u0442\u044f\u0436\u0451\u043b\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u042d\u0444\u0444\u0435\u043a\u0442 \u043e\u0442 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043f\u0430\u0437\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0443\n\u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0434\u0435\u0442\u0435\u0439 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\n\n\u0413\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u041a\u0430\u0448\u0435\u043b\u044c \u0424\u042d\u0413\u0414\u0421, \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0435 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u044f, \u0440\u0432\u043e\u0442\u044b, \u0438\u0437\u0436\u043e\u0433\u0438.\n\u0440\u0435\u0444\u043b\u044e\u043a\u0441 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u041d \u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u0438\u0442\u044b, \u043a\u0430\u0448\u0435\u043b\u044c,\n\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 \u043e\u0442\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0430\u0441\u0442\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u041c\u0443\u043a\u043e\u0432\u0438\u0441\u0446\u0438\u0434\u043e\u0437 \u041a\u0430\u0448\u0435\u043b\u044c, \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0445\u043b\u043e\u0440\u0438\u0434\u043e\u0432 \u0432 \u043f\u043e\u0442\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e \u043e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438,\n\n\u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0432\u044b\u0448\u0435 60 \u043c\u042d\u043a\u0432/\u043b. - \u043c\u0443\u0442\u0430\u0446\u0438\u044f \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0433\u0435\u043d\u0430 \u041c\u0412\u0422\u0420 \u0434\u0438\u0430\u0440\u0435\u044f.\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\n10\n\n\u0410\u0441\u043f\u0438\u0440\u0430\u0446\u0438\u044f \u041a\u0430\u0448\u0435\u043b\u044c, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422 \u043b\u0435\u0433\u043a\u0438\u0445, \u042d\u043f\u0438\u0437\u043e\u0434 \u043a\u0430\u0448\u043b\u044f \u0438/\u0438\u043b\u0438 \u0441\u0442\u0440\u0438\u0434\u043e\u0440\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0434\u044b \u0438\u043b\u0438\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u043d\u043e\u0435 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0438\u0433\u0440\u044b \u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435, \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u0438\u0442\u044b,\n\u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0437\u0430\u0442\u044f\u0436\u043d\u044b\u0435 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u0438 \u043a\u0430\u0448\u0435\u043b\u044c, \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435\n\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043b\u0435\u0433\u043a\u043e\u043c.\n\u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0440\u043e\u043a\u0438 \u041a\u0430\u0448\u0435\u043b\u044c, \u042d\u041a\u0413, \u042d\u0425\u041e\u041a\u0413 \u0421\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0439 \u0448\u0443\u043c; \u0446\u0438\u0430\u043d\u043e\u0437 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0434\u044b, \u043f\u043b\u043e\u0445\u0430\u044f\n\u0441\u0435\u0440\u0434\u0446\u0430 \u0443\u0447\u0430\u0449\u0435\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u0431\u0430\u0432\u043a\u0430 \u0432 \u0432\u0435\u0441\u0435; \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f; \u0442\u0430\u0445\u0438\u043f\u043d\u043e\u044d \u0438\u043b\u0438\n\n\u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0433\u0435\u043f\u0430\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f; \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0430\u0441\u0442\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u041a\u0430\u0448\u0435\u043b\u044c, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422 \u043b\u0435\u0433\u043a\u0438\u0445, -\n\n\u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u043b\u0435\u0433\u043a\u0438\u0445 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430,\n(\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0439 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u0446\u0438\u043b\u0438\u0430\u0440\u043d\u043e\u0439\n\n\u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0438,\n\u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442;\n\u043f\u043e\u0440\u043e\u043a\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\n\u0411\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e\u0447\u043d\u0430\u044f \u041a\u0430\u0448\u0435\u043b\u044c, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422 \u043b\u0435\u0433\u043a\u0438\u0445 \u041d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0442\u0438, \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0442\u044c\n\u0434\u0438\u0441\u043f\u043b\u0430\u0437\u0438\u044f \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0431\u043e\u043b\u0435\u0435 28 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435\n\n\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0441 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n\u0411\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041a\u0430\u0448\u0435\u043b\u044c \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422\u043b\u0435\u0433\u043a\u0438\u0445, \u041a\u0430\u0448\u0435\u043b\u044c \u0441 \u0433\u043d\u043e\u0439\u043d\u043e\u0439 \u0438\u043b\u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e-\u0433\u043d\u043e\u0439\u043d\u043e\u0439\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0431\u0440\u043e\u043d\u0445\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043c\u043e\u043a\u0440\u043e\u0442\u043e\u0439; \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0430\u0441\u0442\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u041a\u0430\u0448\u0435\u043b\u044c, \u0418\u043c\u043c\u0443\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0438 \u043d\u0435\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435. \u041e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0432\n\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438.\n\n11\n\n\u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041a\u0430\u0448\u0435\u043b\u044c, \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f: \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0421\u0443\u0431\u0444\u0435\u0431\u0440\u0438\u043b\u0438\u0442\u0435\u0442, \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c \u0441\n\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043e\u0431\u0449\u0435\u0433\u043e \u043c\u043e\u043a\u0440\u043e\u0442\u043e\u0439 \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430, \u0438\u043d\u043e\u0433\u0434\u0430 \u2013\n\u0430\u0441\u043f\u0435\u0440\u0433\u0438\u043b\u043b\u0435\u0437 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0430 \u0415, \u043a\u0440\u043e\u0432\u043e\u0445\u0430\u0440\u043a\u0430\u043d\u044c\u0435, \u0431\u043e\u043b\u044c \u0432 \u0433\u0440\u0443\u0434\u0438, \u0441\u0432\u0438\u0441\u0442\u044f\u0449\u0438\u0435 \u0445\u0440\u0438\u043f\u044b,\n\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 IgE \u0438 IgG \u043a \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u044b.\nAspergillus fumigatus\n\u041f\u0441\u0438\u0445\u043e\u0433\u0435\u043d\u043d\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c \u041a\u0430\u0448\u0435\u043b\u044c \u041e\u0431\u0449\u0438\u0439 IgE, \u0444\u0430\u0434\u0438\u0430\u0442\u043e\u043f, \u042d\u041a\u0411 \u0413\u0440\u043e\u043c\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c, \u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c\n\n\u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u0430, \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0438\u043b\u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439. \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u043d\u0430 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442.\n\n12\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u0441\u0442\u043c\u044b \u0434\u043e\u043b\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u043e\u0431\u043e\u0439 \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439, \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441,\n\u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439 \u043e\u0446\u0435\u043d\u043a\u0443 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0439 \u0438\n\u043d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0439) \u0438 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435.\n\n\u0417\u0430\u0434\u0430\u0447\u0435\u0439 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0411\u0410 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0441 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0435\u0439 \u0438\n\u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f. \u0423 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0435\u0439\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u0447\u0435\u0441\u0442\u044c \u0438 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u0432\u044b\u0431\u043e\u0440\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u0432\n\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f.\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\