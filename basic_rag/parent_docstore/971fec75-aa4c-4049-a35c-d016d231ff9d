435\u0448\u0430\u043d\u0430 \u0441 \u043a\u0430\u043b\u043e\u043c, \u043e \u0442\u0435\u043b\u0430, \u0437\u0443\u0434,\n\u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438 \u0421\u0438\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u043f\u0440\u044f\u043c\u043e\u0439 \u0432\u044b\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043b\u0438\u0437\u044c \u0438 \u0431\u043e\u043b\u044c \u043f\u0440\u0438\n\u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0438\u0448\u043a\u0438 \u0433\u043d\u043e\u0439 \u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438,\n\u043a\u0440\u043e\u0432\u0438 \u043f\u0440\u0438 \u043f\u0440\u044f\u043c\u043e\u0439 \u0418\u0437 \u0441\u0432\u0438\u0449\u0435\u0432\u043e\u0433\u043e \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0440\u0438\u0442\u043c\u0430 \u043c\u043e\u043a\u043d\u0443\u0442\u0438\u044f,\n\u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438 \u043a\u0438\u0448\u043a\u0438 \u0431\u0435\u0437 \u0445\u043e\u0434\u0430 \u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438, \u0444\u043e\u0440\u043c\u044b \u043c\u0430\u0446\u0435\u0440\u0430\u0446\u0438\u0438\n\u0441\u0432\u044f\u0437\u0438 \u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043a\u0430\u043b\u0430, \u043f\u043e\u043d\u043e\u0441, \u0437\u0430\u043f\u043e\u0440 \u0438 \u043f\u0435\u0440\u0438\u0430\u043d\u0430\u043b\u044c\u043d\n\u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0435\u0439. \u0432\u044b\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u043a\u0430\u043b\u0430 \u0438 \u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438,\n\n\u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0433\u0430\u0437\u043e\u0432 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u041b\u043e\u0436\u043d\u044b\u0435 \u043f\u043e\u0437\u044b\u0432\u044b \u043d\u0430 \u0438\u044f\n\u0433\u043d\u043e\u044f, \u043a\u0440\u043e\u0432\u0438, \u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u044e\n\u0441\u043b\u0438\u0437\u0438 (\u0442\u0435\u043d\u0435\u0437\u043c\u044b)\n\u041f\u043e\u0441\u043b\u0435 \u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438\n\u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u043d\u0435\n\u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u044e\u0442\n\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f,\n\u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0432\n\u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0435.\n\u041f\u0430\u043b\u044c\u0446\u0435\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0420\u0435\u0437\u043a\u0430\u044f \u0431\u043e\u043b\u044c \u0412 \u0411\u0443\u0433\u0440\u0438\u0441\u0442\u043e\u0435, \u041c\u0435\u043b\u043a\u0438\u0435\n\u0442\u0441\u044f \u0441\u044f \u0434\u0435\u0444\u0435\u043a\u0442 \u043f\u0440\u0438 \u043f\u0435\u0440\u0438\u0430\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435 \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\n\u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439, \u043f\u0430\u043b\u044c\u0446\u0435\u0432\u043e\u043c \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u043d\u043d\u044b\u0435\n\n\u0430\u043b\u044c\u043d\u044b\u0435 \u0447\u0430\u0449\u0435 \u043d\u0430 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438, \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0439 \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0442 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\n\u0443\u0437\u043b\u044b \u0447\u0430\u0449\u0435 6,12 \u0447\u0430\u0441\u0430\u0445 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442 \u0441 \u0441\u0432\u0438\u0449\u0435\u0432\u043e\u0439 \u0445\u043e\u0434 \u044f \u0434\u043e 1,0 \u0441\u043c\n\u043d\u0430 3,7,11 \u043f\u043e \u0440\u0430\u0437\u043c\u044f\u0433\u0447\u0435\u043d\u0438\u0435\u043c \u0441 \u0438 \u0431\u043e\u043b\u0435\u0435\n\u0447\u0430\u0441\u0430\u0445 \u043f\u043e \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c\u0438\n\u0443\u0441\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u0446\u0438\u0444\u0435\u0440\u0431\u043b\u0430\u0442 \u043a\u0440\u043e\u0432\u0438, \u0433\u043d\u043e\u044f,\n\u0438\u0444\u0435\u0440\u0431\u043b\u0430\u0442\u0443 \u0443 \u0441\u043b\u0438\u0437\u0438.\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f\n\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435\n\u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435\n\u0441\u0432\u0438\u0449\u0430,\n\u0432\u0442\u044f\u0436\u0435\u043d\u0438\u0435 \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e\n\u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f\n\u0410\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f\n\n\u0413\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434 \u0414\u0435\u0444\u0435\u043a\u0442 \u041e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u041d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0442\u0435\u043d\u043e\u043a \u041f\u043b\u043e\u0442\u043d\u043e\u0432\u0430\u0442\n\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439, \u0432\u044b\u0431\u0443\u0445\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u044b\u0435\n\u0443\u0437\u043b\u044b \u0447\u0430\u0449\u0435 \u0447\u0430\u0449\u0435 \u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043d\u0430 \u0441\u0432\u0438\u0449\u0435\u0432\u043e\u0433\u043e \u0431\u0443\u0433\u0440\u0438\u0441\u0442\u043e\u0435 \u0431\u043e\u0440\u043e\u0434\u0430\u0432\u0447\u0430\u0442\n\u043d\u0430 3,7,11 6,12 \u0447\u0430\u0441\u0430\u0445 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u044b\u0435\n\u0447\u0430\u0441\u0430\u0445 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u0412 \u0447\u0430\u0449\u0435 \u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u043e\u0441\u0442\u0440\u043e\u043a\u043e\u043d\u0435\u0447\n\u0440\u0435\u0434\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435 \u043d\u044b\u0435\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\n\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0440\u0438\u043f\u0442\u044b. \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435, \u044f\u0437\u0432\u0430 \u044f \u0440\u043e\u0437\u043e\u0432\u043e-\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u043e\u0433\n\u043a\u0440\u0438\u043f\u0442\u044b \u0438\u0437 \u043e \u0446\u0432\u0435\u0442\u0430,\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\n\u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f \u0449\u0438\u0435 \u043f\u043e\n\u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u0435\n\u0433\u043d\u043e\u044f. \u0446\u0432\u0435\u0442\u043d\u0443\u044e\n\u043a\u0430\u043f\u0443\u0441\u0442\u0443,\n\u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\n\u0449\u0438\u0435\u0441\u044f \u043d\u0430\n\u043a\u043e\u0436\u0435\n\u0432\u043e\u043a\u0440\u0443\u0433\n\u0437\u0430\u0434\u043d\u0435\u0433\u043e\n\u043f\u0440\u043e\u0445\u043e\u0434\u0430 \u0438 \u0432\n\u0430\u043d\u0430\u043b\u044c\u043d\u043e\u043c\n\u043a\u0430\u043d\u0430\u043b\u0435.\n\n\u041a\u043e\u043b\u043e\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f\n\u0413\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434 \u0414\u0435\u0444\u0435\u043a\u0442 \u041e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u041d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0441\u0442\u0435\u043d\u043e\u043a \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\n\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439, \u0432\u044b\u0431\u0443\u0445\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u0438\u044f \u0434\u043e 1,0\n\u0443\u0437\u043b\u044b \u043d\u0430 \u0447\u0430\u0449\u0435 \u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043d\u0430 \u0441\u0432\u0438\u0449\u0435\u0432\u043e\u0433\u043e \u0431\u0443\u0433\u0440\u0438\u0441\u0442\u043e\u0435 \u0441\u043c. \u0438 \u0431\u043e\u043b\u0435\u0435\n3,7,11 6,12 \u0447\u0430\u0441\u0430\u0445 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\u0447\u0430\u0441\u0430\u0445 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,\n\u0440\u0435\u0434\u043a\u0438\u0445 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u043f\u0440\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0432 \u043a\u0440\u0438\u043f\u0442\u044b. \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435.\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439\n\u043a\u0440\u0438\u043f\u0442\u044b \u0438\u0437\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e\n\u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f\n\u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u0433\u043d\u043e\u044f.\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c\u0423\u0420\u041e\u0412\u041d\u0415:\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [7,20-26]:\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0439.\n\n\u2022 \u0434\u0438\u0435\u0442\u0430: \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0440\u0435\u0436\u0438\u043c\u0430 \u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u043f\u0438\u0449\u0435\u0432\u044b\u0445 \u0432\u043e\u043b\u043e\u043a\u043e\u043d, \u0442\u0430\u043a\u0436\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u0438 \u0434\u0435\u0444\u0435\u043a\u0430\u0446\u0438\u0438\n(\u0423\u0414 1\u0412, \u0421\u0420 \u0410) [7,25,26].\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 (\u0423\u0414-2B.)\n\u0424\u043b\u0435\u0431\u043e\u0442\u043e\u043d\u0438\u043a\u0438, \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u0433\u0435\u0442\u0435\u0440\u043e\u0433\u0435\u043d\u043d\u043e\u043c\u0443 \u043a\u043b\u0430\u0441\u0441\u0443 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432,\n\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0445 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u044f [31].\n\n\u041f\u0440\u0438 \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u041d\u041f\u0412\u0421 \u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0445\n\u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432 \u0432\u0438\u0434\u0435 \u043a\u0440\u0435\u043c\u043e\u0432, \u0433\u0435\u043b\u0435\u0439, \u043c\u0430\u0437\u0435\u0439, \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0435\u0432.\n\n\u041f\u0440\u0438 \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439, \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u0442\u043d\u044b\u0445\n\u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432 \u0432\u0438\u0434\u0435 \u043a\u0440\u0435\u043c\u043e\u0432, \u0433\u0435\u043b\u0435\u0439, \u043c\u0430\u0437\u0435\u0439, \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0435\u0432.\n\u041f\u0440\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0437\u0435 \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0437\u043b\u043e\u0432 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u043e\u0432\n\n\u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.\n\u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u044f\u0445 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b.\nNB! \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u0438\n\n\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438.\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e [106, 115-119]:\n\u2022 \u0413\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0432\u044b\u0441\u043e\u043a\u043e\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u043d\u043e\u0433\u043e\n\n\u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f (\u0423\u0414 1\u0430, \u0421\u0420 \u0410) [14, 101 - 105].\n\n\u2022 \u041c\u0430\u043b\u043e\u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f (\u0423\u0414 1A, \u0421\u0420 \u0410):\n\uf02d \u043b\u0438\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u0430\u0442\u0435\u043a\u0441\u043d\u044b\u043c\u0438 \u043a\u043e\u043b\u044c\u0446\u0430\u043c\u0438;\n\n\uf02d \u0441\u043a\u043b\u0435\u0440\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f;\n\uf02d \u0438\u043d\u0444\u0440\u0430\u043a\u0440\u0430\u0441\u043d\u0430\u044f \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u044f.\n\n\u2022 \u0420\u0435\u0434\u0443\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\uf02d \u0442\u0440\u0430\u043d\u0441\u0430\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u043f\u043b\u0435\u0440\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f \u0434\u0435\u0437\u0430\u0440\u0442\u0435\u0440\u0438\u0437\u0430\u0446\u0438\u044f \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0445\n\u0443\u0437\u043b\u043e\u0432 \u0441 \u043c\u0443\u043a\u043e\u043f\u0435\u043a\u0441\u0438\u0435\u0439 (HAL-RAR) [82-85];\n\uf02d \u0441\u0442\u0435\u043f\u043b\u0435\u0440\u043d\u0430\u044f \u0433\u0435\u043c\u043e\u0440\u0440\u043e\u0438\u0434\u043e\u043f\u0435\u043a\u0441\u0438\u044f (\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u041b\u043e\u043d\u0433\u043e).", "type": "Document"}}