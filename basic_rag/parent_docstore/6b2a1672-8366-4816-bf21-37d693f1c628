\u0435\u0440\u0444\u0443\u0437\u0438\u0438 (\u0432 \u0446\u0435\u043b\u044f\u0445\n\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0438\u0437-\u0437\u0430 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432)\n\u0412\u0430\u0437\u043e\u043f\u0440\u0435\u0441\u0441\u043e\u0440\u044b\n\u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u0437\u043e\u043f\u0440\u0435\u0441\u0441\u043e\u0440\u043e\u0432 (\u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u043e\u0440\u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430) \u043c\u043e\u0436\u043d\u043e IIb B\n\n\u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0435\u043d\u043d\u044b\u043c \u0448\u043e\u043a\u043e\u043c, \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u0441 \u0434\u0440\u0443\u0433\u0438\u043c \u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0434\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0444\u0443\u0437\u0438\u0438 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432.\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u042d\u041