39 \u0434\u043e 15 \u043b\u0435\u0442 - 0,5-1,5\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n\u043c\u0433/\u043a\u0433. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 15 \u043b\u0435\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\n\u0432 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0435 \u043e\u0442 20 \u0434\u043e 40 \u043c\u0433\n\u0424\u0443\u0440\u043e\u0441\u0435\u043c\u0438\u0434\u0430 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043f\u044b\n42. \u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b. Per os. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0434\u043e 1 \u0433\u043e\u0434\u0430. 14\n\u0414\u0435\u0442\u044f\u043c \u043e\u0442 1 \u0433\u043e\u0434\u0430 \u0434\u043e 16 \u043b\u0435\u0442: \u043c\u0430\u0441\u0441\u0430 \u0442\u0435\u043b\u0430\n\u043e\u0442 5 \u043a\u0433 \u0434\u043e <10 \u043a\u0433: 5 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c;\n\u043c\u0430\u0441\u0441\u0430 \u0442\u0435\u043b\u0430 \u043e\u0442 10 \u043a\u0433 \u0434\u043e <20 \u043a\u0433: 10 \u043c\u0433\n\u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c; \u043c\u0430\u0441\u0441\u0430 \u0442\u0435\u043b\u0430 \u043e\u0442 \u2265 20 \u043a\u0433:\n20 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u044b\u0435 \u041b\u0421\n43. \u0414\u043e\u043c\u043f\u0435\u0440\u0438\u0434\u043e\u043d. Per os. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u0434\u043e 5 7\n\u043b\u0435\u0442 \u0438 \u0434\u0435\u0442\u0435\u0439 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u043c\u0435\u043d\u0435\u0435 20 \u043a\u0433.\n\u0414\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 5 \u043b\u0435\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\n10 \u043c\u0433 \u0437\u0430 1 \u043f\u0440\u0438\u0435\u043c, \u0432 \u0441\u0443\u0442\u043a\u0438 3-4 \u043f\u0440\u0438\u0435\u043c\u0430.\n\u041f\u0440\u0438 \u0441\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0448\u043d\u043e\u0442\u0435 \u0438 \u0440\u0432\u043e\u0442\u0435\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b.\n44. \u041c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434. Per os, \u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442 (\u0434\u0435\u0442\u044f\u043c \u0434\u043e 2 7\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447 \u043b\u0435\u0442 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u043c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434\u0430 \u0432 \u0432\u0438\u0434\u0435 \u043b\u044e\u0431\u044b\u0445\n\u043d\u043e,\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0444\u043e\u0440\u043c, \u0434\u0435\u0442\u044f\u043c \u0434\u043e 6 \u043b\u0435\u0442 -\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0435\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435). \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 6 \u043b\u0435\u0442 - \u043f\u043e 5\n\u043c\u0433 1-3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u043f\u0430\u0437\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041b\u0421\n45. \u0414\u0440\u043e\u0442\u0430\u0432\u0435\u0440\u0438\u043d. Per os. \u0414\u0435\u0442\u044f\u043c \u043e\u0442 1 \u0433\u043e\u0434\u0430 \u0434\u043e 6 \u043b\u0435\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 7\n1\u20442 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 1 - 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438; \u0434\u0435\u0442\u044f\u043c 6 -\n12 \u043b\u0435\u0442 - \u043f\u043e 1 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0435 2 - 3 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438, \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 - \u043f\u043e 1-2 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0435\n2 - 3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u043b\u0430\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u041b\u0421 (\u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435)\n46. \u041b\u0430\u043a\u0442\u0443\u043b\u043e\u0437\u0430. Per os. \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u044b 2\n\u041b\u0430\u043a\u0442\u0443\u043b\u043e\u0437\u0430 \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445, \u0434\u0435\u0442\u0435\u0439\n\u0434\u043e 7\u043b. \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b - \u043e\u0442 6\u043d\u0435\u0434. \u0434\u043e \u043e\u0434\u043d\u043e\u0433\u043e\n\u0433\u043e\u0434\u0430 \u2013 5\u043c\u043b, \u043e\u0442 \u0433\u043e\u0434\u0430 \u0434\u043e \u0448\u0435\u0441\u0442\u0438 \u2013 5-10\u043c\u043b.\n\u0414\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0437\u0430\u043f\u043e\u0440\u043e\u0432, \u043d\u0435\n\u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0445 \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438: \u0434\u043b\u044f \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\n\u2013 20 \u043c\u043b \u0432 \u0434\u0435\u043d\u044c;\n\u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0438 \u2013 30 \u043c\u043b \u0432 \u0434\u0435\u043d\u044c.\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043f\u0438\u0449\u0435\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432 (\u043f\u0440\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438)\n47. \u041f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u043d. Per os. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f 7\n\u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u043e 18 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 50 000 \u0435\u0434, \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\u0441\u0442\u0430\u0440\u0448\u0435 18 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u0430 \u0434\u043e\u0437\u0430 \u0434\u043e\n100 000 \u0435\u0434.\n\u041b\u0421, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0435 \u043f\u0440\u0438 \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u0441\u0442\u043c\u0435 \u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445\n\u043b\u0435\u0433\u043a\u0438\u0445 (\u0441\u043c. \u041a\u041f \u00ab\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u041c\u0443\u043a\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041b\u0421 (\u0441\u043c. \u041a\u041f \u00ab\u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u041f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u044b (\u0432 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435, \u043e\u0434\u0438\u043d \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u0437:)\n48. \u0414\u0435\u043a\u0441\u0442\u0440\u043e\u0437\u0430 5%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0438\u043b\u0438 \u0441\u0442\u0440\u0443\u0439\u043d\u043e: \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 2\n\u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 2 - 10 \u043a\u0433 - 100 - 165\n\u043c\u043b/\u043a\u0433/\u0441\u0443\u0442, \u0434\u0435\u0442\u044f\u043c \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 10-40\n\u043a\u0433 - 45-100 \u043c\u043b/\u043a\u0433/\u0441\u0443\u0442. \u0423 \u0434\u0435\u0442\u0435\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\n19\n\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 0,5\n\u0433/\u043a\u0433/\u0447; \u0447\u0442\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0434\u043b\u044f 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n- \u043e\u043a\u043e\u043b\u043e 10 \u043c\u043b/\u043c\u0438\u043d \u0438\u043b\u0438 200 \u043a\u0430\u043f/\u043c\u0438\u043d\n(20 \u043a\u0430\u043f = 1 \u043c\u043b).\n49. \u0414\u0435\u043a\u0441\u0442\u0440\u043e\u0437\u0430 10%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0438\u043b\u0438 \u0441\u0442\u0440\u0443\u0439\u043d\u043e: \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 2\n\u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 2 - 10 \u043a\u0433 - 100 - 165\n\u043c\u043b/\u043a\u0433/\u0441\u0443\u0442, \u0434\u0435\u0442\u044f\u043c \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 10-40\n\u043a\u0433 - 45-100 \u043c\u043b/\u043a\u0433/\u0441\u0443\u0442.\u0423 \u0434\u0435\u0442\u0435\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 0,5\n\u0433/\u043a\u0433/\u0447; \u0447\u0442\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0434\u043b\u044f 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n- \u043e\u043a\u043e\u043b\u043e 10 \u043c\u043b/\u043c\u0438\u043d \u0438\u043b\u0438 200 \u043a\u0430\u043f/\u043c\u0438\u043d\n(20 \u043a\u0430\u043f = 1 \u043c\u043b).\n50. \u041d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u0432 (\u043e\u0431\u044b\u0447\u043d\u043e 2\n\u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e). \u0414\u043e\u0437\u0430 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 0,9% \u043d\u0430\u0442\u0440\u0438\u044f\n\u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0442 20 \u043c\u043b\n\u0434\u043e 100 \u043c\u043b \u0432 \u0441\u0443\u0442\u043a\u0438 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 (\u0432\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0438 \u043e\u0431\u0449\u0435\u0439\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430). \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.\n51. \u041d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434, \u043a\u0430\u043b\u0438\u044f \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412\u0432\u043e\u0434\u044f\u0442 \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0432 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435, 2\n\u0445\u043b\u043e\u0440\u0438\u0434, \u043d\u0430\u0442\u0440\u0438\u044f \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u043c 7-10% \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430; \u0437\u0430\u0442\u0435\u043c \u0441\u0442\u0440\u0443\u0439\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\u0433\u0438\u0434\u0440\u043e\u043a\u0430\u0440\u0431\u043e\u043d\u0430\u0442.\n\u0437\u0430\u043c\u0435\u043d\u044f\u044e\u0442 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u044b\u043c, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24-48\n\u0447, \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 40-120 \u043a\u0430\u043f/\u043c\u0438\u043d.\n52. \u041a\u0430\u043b\u044c\u0446\u0438\u044f \u0433\u043b\u044e\u043a\u043e\u043d\u0430\u0442 10%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0434\u043e 6-\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u2013 0,1 \u2013 1 \u043c\u043b; 2\n\u0434\u0435\u0442\u044f\u043c 7-12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u2013 1 \u2013 1,5 \u043c\u043b;\n\u0434\u0435\u0442\u044f\u043c 1-3 \u043b\u0435\u0442 \u2013 1,5 \u2013 2 \u043c\u043b;\n\u0434\u0435\u0442\u044f\u043c 4-6 \u043b\u0435\u0442 \u2013 2 \u2013 2,5 \u043c\u043b;\n\u0434\u0435\u0442\u044f\u043c 7-14 \u043b\u0435\u0442 \u2013 3 \u2013 5 \u043c\u043b.\n53. \u041a\u0430\u043b\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041a\u0430\u043b\u0438\u0439 \u0445\u043b\u043e\u0440\u0438\u0434 7,5% \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u043f\u0440\u0438 2\n\u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u0438, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0440\u0438\u0442\u043c\u0430 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0414\u043e\u0437\u043e\u0432\u044b\u0439 \u0440\u0430\u0441\u0447\u0435\u0442 \u0434\u043b\u044f\n\u0434\u0435\u0442\u0435\u0439 \u043b\u044e\u0431\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u043d\u0435\n\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d.\n54. \u041a\u0430\u043b\u044c\u0446\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434 \u0432\u043d\u0443\u0442\u0440\u044c, 2\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e (\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e),\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e (\u043e\u0447\u0435\u043d\u044c\n\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e!). \u0412\u043d\u0443\u0442\u0440\u044c \u0434\u0435\u0442\u044f\u043c - \u043f\u043e 5-10\n\u043c\u043b. \u0412 \u0432\u0435\u043d\u0443 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0432\u0432\u043e\u0434\u044f\u0442 \u043f\u043e 6\n\u043a\u0430\u043f\u0435\u043b\u044c \u0432 \u043c\u0438\u043d\u0443\u0442\u0443, \u0440\u0430\u0437\u0431\u0430\u0432\u043b\u044f\u044f \u043f\u0435\u0440\u0435\u0434\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c 5-10 \u043c\u043b 10% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0432\n100-200 \u043c\u043b \u0438\u0437\u043e\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n\u043d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u0438\u043b\u0438 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n\u0433\u043b\u044e\u043a\u043e\u0437\u044b.\n55. \u0410\u0441\u043a\u043e\u0440\u0431\u0438\u043d\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u0412\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e 2\n5%. \u0447\u043d\u043e, \u0438 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e.\n\u0414\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u044b\u0445 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439 \u0443\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n\u0434\u0435\u0442\u0435\u0439 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 0,03\u20130,05 \u0433\n\u0430\u0441\u043a\u043e\u0440\u0431\u0438\u043d\u043e\u0432\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u044b (\u0432\u0432\u043e\u0434\u044f\u0442 0,6\u20131\n\u043c\u043b 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430). \u0414\u0435\u0442\u044f\u043c \u043c\u043b\u0430\u0434\u0448\u0435 12 \u043b\u0435\u0442\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439\n\u0434\u043e\u0437\u0435 5 \u2013 7 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u0432\u0438\u0434\u0435 5 %\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 (0,5 \u2013 2 \u043c\u043b). \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12\n\u043b\u0435\u0442 \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 50 \u2013 150 \u043c\u0433 \u0432\n\u0441\u0443\u0442\u043a\u0438.\n20", "type": "Document"}}