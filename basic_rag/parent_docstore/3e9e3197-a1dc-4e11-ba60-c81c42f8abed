AIR\n\n\u0420\u0430\u0441\u0441\u0435\u044f\u043d\u043d\u044b\u0439 \u0441\u043a\u043b\u0435\u0440\u043e\u0437 \u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0426\u0421\u0416 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439 \u043f\u043b\u0435\u043e\u0446\u0438\u0442\u043e\u0437,\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430, \u0438\u0437\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0444\u0438\u043a\u0443\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0431\u0435\u043b\u043a\u0430 \u0438\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0444\u043e\u0440\u0435\u0437\u0430 \u0441 \u0438\u043c\u043c\u0443\u043d\u043e\u0431\u043b\u043e\u0442\u0442\u0438\u043d\u0433\u043e\u043c \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432 G, \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432 \u0432 \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u043b\u0438\u0433\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u044b,\n\n\u0430\u0442\u0430\u043a\u0441\u0438\u044f \u043f\u0440\u043e\u0431\u0430\u0445 \u0421\u041c\u0416 \u0438 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438[6] \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u043a\n\u043d\u0435\u0439\u0440\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u0430\u043c\n\u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430 \u0432 \u0440\u0435\u0436\u0438\u043c\u0430\u0445 \u04221, \u0413\u0438\u043f\u0435\u0440\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435 \u043e\u0447\u0430\u0433\u0438 \u043d\u0430 \u04222-\n\u04222, FLAIR, DWI, PWI \u0432\u0437\u0432\u0435\u0448\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u0445 \u0438 \u0432\n\n\u0440\u0435\u0436\u0438\u043c\u0435 FLAIR\n\u041d\u0435\u0439\u0440\u043e\u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u0435 \u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u041d\u043e\u0440\u043c\u0430\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f (\u0433\u0438\u043f\u043e- \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0433\u043b\u044e\u043a\u043e\u0437\u044b\n\n\u0433\u0438\u043f\u0435\u0440\u0442\u0438\u0440\u0435\u043e\u0437, \u0433\u0438\u043f\u043e- \u0438 \u0432\u0435\u0433\u0435\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u041d\u0430\u0433\u0440\u0443\u0437\u043e\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u044b \u041d\u043e\u0440\u043c\u0430\n\u0433\u0438\u043f\u0435\u0440\u043f\u0430\u0440\u0430\u0442\u0438\u0440\u0435\u043e\u0437, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f (\u0433\u043b\u044e\u043a\u043e\u0437\u043e\u0442\u043e\u043b\u0435\u0440\u0430\u0442\u043d\u0442\u043d\u044b\u0439 \u0442\u0435\u0441\u0442)\n\n\u0433\u0438\u043f\u043e- \u0438 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u043e\u0440\u043c\u043e\u043d\u043e\u0432 \u041d\u043e\u0440\u043c\u0430\n\u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0435\u0439) \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0438 \u0433\u0438\u043f\u043e\u0444\u0438\u0437\u0430\n\u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0418\u0425\u041b\n\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f [4, 8, 21]:\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u044f\u0436\u0435\u0441\u0442\u044c\u044e \u0442\u0435\u0447\u0435\u043d\u0438\u044f \u0410\u042d.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 5 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 NMDAR\n\u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442\u043e\u043c [21]\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0422\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\na) \u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0418\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f -\n\n\u0414\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 -\n\u0414\u0438\u0437\u0430\u0432\u0442\u043e\u043d\u043e\u043c\u0438\u044f, \u0443\u0433\u0440\u043e\u0436\u0430\u044e\u0449\u0430\u044f -\n\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\nb) \u041c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0412 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043a\u0440\u043e\u0432\u0430\u0442\u0438 \u0412\u043d\u0435 \u043a\u0440\u043e\u0432\u0430\u0442\u0438\n\n\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, -\n\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0442\u0440\u0430\u0432\u043c\u043e\u043f\u0430\u0441\u043d\u044b\u0435\nc) \u0423\u0445\u043e\u0434 \u0437\u0430 \u0431\u043e\u043b\u044c\u043d\u044b\u043c 24/7 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0434\u043b\u044f \u041d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f 24/7\n\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\n\n1 \u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u043d\u0430 1 \u043c\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u0443 -\n\u0438\u043b\u0438 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f\n\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\nd) \u041f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u044f \u0421\u0443\u0438\u0446\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u044b\u0441\u043b\u0438 \u041f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u0441\u0438\u043c\u043f\u043c\u0442\u043e\u043c\u044b \u043d\u0435\n\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u044b\u043c\n\u0440\u0438\u0441\u043a\u043e\u043c \u0434\u043b\u044f\n\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\n\n\u041e\u043f\u0430\u0441\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f -\n\u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438 ( \u0440\u0438\u0441\u043a\n\u0442\u0440\u0430\u0432\u043c\u044b)\n\u0421\u0430\u043c\u043e\u0442\u0440\u0430\u0432\u043c\u0438\u0440\u0443\u044e\u0449\u0435\u0435 -\n\n\u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\ne) \u0421\u0430\u043c\u043e\u0443\u0445\u043e\u0434 \u041d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0412\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u0441 \u0438\u043b\u0438 \u0431\u0435\u0437\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u043e\u043c\u043e\u0449\u0438\n(\u0442\u0443\u0430\u043b\u0435\u0442, \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435 \u043e\u0434\u0435\u0436\u0434\u044b,\n\n\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435)\nf) \u041a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f \u041d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f, \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u0430\n\u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u044b\u043c \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f, \u0447\u0442\u043e\u0431\u044b\n(\u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0443, \u0431\u044b\u0442\u044c \u043f\u043e\u043d\u044f\u0442\u044b\u043c\n\n\u043c\u0443\u0442\u0438\u0437\u043c/\u0430\u0444\u0430\u0437\u0438\u044e)\ng) \u0411\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u041d\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u043d\u0430 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0412 \u043e\u0431\u0449\u0435\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d\n\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u043f\u0443\u0441\u0442\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434, \u0440\u0435\u0430\u0433\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0430\n\u0442\u044f\u0436\u0435\u043b\u0430\u044f \u043a\u0430\u0442\u043e\u0442\u043e\u043d\u0438\u044f \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u043c\n\n\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0438\nh) \u042d\u043f\u0438\u043b\u0435\u043f\u0441\u0438\u044f \u0427\u0430\u0441\u0442\u0430\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u041f\u0440\u0438\u0441\u0442\u0443\u043f\u044b, \u043d\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u0445 \u043d\u0435\u043e\u0442\u043b\u043e\u0436\u043d\u043e\u0439 \u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u0435\n\u043f\u043e\u043c\u043e\u0449\u0438 \u0434\u043b\u044f \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\n\n\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u0432 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438\n\u043d\u0435\u043e\u0442\u043b\u043e\u0436\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438\ni) \u0410\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f 4 \u2013 5 0 \u2013 3\nmRS \u0448\u043a\u0430\u043b\u0430\n(\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 2 \u043a\n\n\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443\n\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443)\n\nNB!\n\u0415\u0441\u043b\u0438 \u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0410\u042d \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0433\u0435\u0440\u043f\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f,\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0430\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440\u0430, \u0434\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u043d\u0430 \u0412\u041f\u0413!\n\n\u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f[4, 8, 21]:\n\u0420\u0435\u0436\u0438\u043c:\n\uf0fc \u043e\u0431\u0449\u0438\u0439.\n\n\u0414\u0438\u0435\u0442\u0430: \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439\n\n\u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435: \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\n\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u043e\u0439 \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u0439 \u043f\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445\n\n\u0443\u0441\u043b\u0443\u0433 \u041c\u0417 \u0420\u041a \u043e\u0442 28 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 2019 \u0433\u043e\u0434\u0430 \u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u043e\u043c No55:\n\uf0fc \u0412\u0442\u043e\u0440\u043e\u0439 \u044d\u0442\u0430\u043f \u00ab\u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f IIA\u00bb. \u041f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0438\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044f\u00bb (\u0434\u0435\u0442\u0438) [33];\n\uf0fc \u0412\u0442\u043e\u0440\u043e\u0439 \u044d\u0442\u0430\u043f \u00ab\u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f II\u0411\u00bb. \u041f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0438\n\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044f\u00bb (\u0434\u0435\u0442\u0438) [34];\n\uf0fc \u0422\u0440\u0435\u0442\u0438\u0439 \u044d\u0442\u0430\u043f \u00ab\u0410\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f II\u00bb. \u041f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u044f\n\u0438 \u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044f\u00bb (\u0434\u0435\u0442\u0438)[35];\n\uf0fc \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f. \u041f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044f\u00bb\n\n(\u0434\u0435\u0442\u0438) [36];\n\uf0fc \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f. \u041f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0438\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u044f\u00bb (\u0434\u0435\u0442\u0438) [37].\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u0445 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442\u043e\u0432 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442:\n\n\uf0fc \u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044e;\n\uf0fc \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e.\n\n\u0410\u041b\u0413\u041e\u0420\u0418\u0422\u041c \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041f\u0415\u0420\u0412\u041e\u0413\u041e \u042d\u041f\u0418\u0417\u041e\u0414\u0410 \u0410\u041d\u0422\u0418-NMDAR\n\n\u042d\u041d\u0426\u0415\u0424\u0410\u041b\u0418\u0422\u0410 \u0423 \u0414\u0415\u0422\u0415\u0419\n\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u043b\u0438\u043d\u0438\u0438:\n\n\uf0fc \u0413\u041a\u0421.\n\n\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 I \u043b\u0438\u043d\u0438\u0438: 3 \u2013 12\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0442\u0435\u0447\u0435\u043d\u0438\u044f.\n\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f [21]\n\n\u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f.\n\u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0439 \u0438 \u0441\u0442\u0435\u0440\u0435\u043e\u0442\u0438\u043f\u0438\u0439\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044f:\n\n\uf0fc \u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u044b;\n\uf0fc \u041f\u042d\u041f (\u0432\u0430\u043b\u044c\u043f\u0440\u043e\u0435\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430, \u043a\u0430\u0440\u0431\u0430\u043c\u0430\u0437\u0435\u043f\u0438\u043d);\n\u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438:\n\uf0fc \u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b;\n\n\uf0fc \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u044b.\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u0438\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0432\u044b\u0431\u043e\u0440\u0430\n\u041f\u0435\u0440\u0432\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b \u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u043b\u0438\u043d\u0438\u0438: \u0410 [1,8,21]\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 (max\n60 \u043c\u0433/\u0441\u0443\u0442), \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430\n1 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n1 \u043d\u0435\u0434\u0435\u043b\u044f, \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0410 [1,8,21]\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u043b\u0438\u043d\u0438\u0438:\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 (max\n60 \u043c\u0433/\u0441\u0443\u0442), \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u043a\u0443\u0440\u0441\n\n1 \u043d\u0435\u0434\u0435\u043b\u044f \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u043b\u0438\u043d\u0438\u0438: \u0410 [1,8,21]\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 20 \u043c\u0433/\u043c2/\u0441\u0443\u0442 \u0432\n2 \u2013 3 \u043f\u0440\u0438\u0435\u043c\u0430 (max \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 36 \u043c\u0433), \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430 3 \u0434\u043d\u044f\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u043b\u0438\u043d\u0438\u0438:\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 20 \u043c\u0433/\u043c2/\u0441\u0443\u0442 \u0432\n2-3 \u043f\u0440\u0438\u0435\u043c\u0430 (max \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0434\u043e\u0437\u0430 36 \u043c\u0433), \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430 3 \u0434\u043d\u044f, \u043f\u043e\u0432\u0442\u043e\u0440 \u043a\u0443\u0440\u0441\u043e\u0432\n\u043a\u0430\u0436\u0434\u044b\u0435 3-4 \u043d\u0435\u0434\u0435\u043b\u0438", "type": "Document"}}