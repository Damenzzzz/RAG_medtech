3e\u044d\u0437\u0430 \u043f/\u043a\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0435 \u0410\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u0410\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0432\u043d\u0443\u0442\u0440\u044c\n\n\u041f\u043e\u043b\u0438\u0435\u043d\u043e\u0432\u044b\u0439 \u0410\u043c\u0444\u043e\u0442\u0435\u0440\u0438\u0446\u0438\u043d \u0412 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0412\n\u043c\u0430\u043a\u0440\u043e\u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a \u0441\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u043e\u0439\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a \u0433\u0440\u0443\u043f\u043f\u044b \u0410\u0437\u0442\u0440\u0435\u043e\u043d\u0430\u043c* \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0410\n\u043c\u043e\u043d\u043e\u0431\u0430\u043a\u0442\u0430\u043c\n\n\u0411\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u043a\u043e- \u0410\u0431\u0430\u0442\u0430\u0446\u0435\u043f\u0442 * \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0421\n\n\u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438 T-\n\u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434 \u0411\u0443\u0434\u0435\u0441\u043e\u043d\u0438\u0434 \u0432\u043d\u0443\u0442\u0440\u044c \u0410\n\u0434\u043b\u044f \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e\n\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\n119\n\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434 \u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u0410\n\n\u0434\u043b\u044f \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0411\u0435\u043b\u0443\u043c\u043e\u0441\u0443\u0434\u0438\u043b * \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0412\n\u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442.\n\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 Rho-\n\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439\n\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u043a\u0438\u043d\u0430\u0437\u044b\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0435 \u0412\u0430\u043b\u0433\u0430\u043d\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440 \u0432\u043d\u0443\u0442\u0440\u044c \u0410\n\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e, L-\u0432\u0430\u043b\u0438\u043b\u043e\u0432\u044b\u0439\n\u044d\u0444\u0438\u0440 \u0433\u0430\u043d\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440\u0430\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0435 \u0412\u0430\u043b\u0430\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440 \u0432\u043d\u0443\u0442\u0440\u044c \u0410\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0433\u0440\u0443\u043f\u043f\u044b\n\n\u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432 \u043d\u0443\u043a\u043b\u0435\u043e\u0437\u0438\u0434\u043e\u0432.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0439 \u0412\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u0410\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u0432\u043d\u0443