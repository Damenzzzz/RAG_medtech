40\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0438 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043b\u044f \u0412\n\u043f\u0440\u043e\u043f\u0438\u043e\u043d\u043e\u0432\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u044b \u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c. \u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f\n\n100 \u043c\u0433/5 \u043c\u043b; \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 200 \u043c\u0433;\n\n12\n\n\u041c\u0430\u043a\u0440\u043e\u043b\u0438\u0434\u044b \u0410\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c \u043a\u0430\u043f\u0441\u0443\u043b\u044b \u0438 \u0410\n\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 125 \u043c\u0433, 250 \u043c\u0433, 500\n\u043c\u0433, \u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u0438 100 \u043c\u0433/5 \u043c\u043b \u0438\n200 \u043c\u0433/5 \u043c\u043b \u0432\u043e \u0444\u043b\u0430\u043a\u043e\u043d\u0430\u0445 20\n\u043c\u043b\n\n\u041c\u0430\u043a\u0440\u043e\u043b\u0438\u0434\u044b \u041a\u043b\u0430\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c \u0410\n125 \u043c\u0433/5 \u043c\u043b. 250 \u043c\u0433/5 \u043c\u043b\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.4 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435 [1-4,7,15]:\n\u2022 \u0432\u044b\u043f\u0438\u0441\u043a\u0430 \u0432 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0