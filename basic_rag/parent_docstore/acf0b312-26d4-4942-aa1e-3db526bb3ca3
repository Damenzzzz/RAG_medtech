433\u043d\u0438\u0435\u043c \u0438 \u0431\u0435\u0434\u043d\u0430\u044f \u0444\u043e\u0441\u0444\u043e\u0440\u043e\u043c. \u0420\u0435\u0437\u043a\u043e\u0435\n\n\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043c\u044f\u0441\u043d\u044b\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f\n\u0433\u0438\u043f\u043e\u043f\u0430\u0440\u0430\u0442\u0438\u0440\u0435\u043e\u0437\u0430. \u0412\u0430\u0436\u0435\u043d \u043f\u0440\u0438\u0435\u043c \u0441 \u043f\u0438\u0449\u0435\u0439 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u0430 D2.\n\n\u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435: \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0432\u0441\u0435\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441\n\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0413\u0438\u043f\u043e- \u041fT \u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c\u0438\u0438 \u0438 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043e\u0431\u0449\u0435\u0433\u043e \u043a\u0430\u043b\u044c\u0446\u0438\u044f\n\u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438 (\u0441 \u043f\u0435\u0440\u0435\u0440\u0430\u0441\u0447\u0435\u0442\u043e\u043c \u043d\u0430 \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d) < 2,0 \u043c\u043c\u043e\u043b\u044c/\u043b \u0438\u043b\u0438 \u0443\u0440\u043e\u0432\u043d\u0435\u043c\n\u0438\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 (Ca++) < 1,0 \u043c\u043c\u043e\u043b\u044c/\u043b.\n\u0426\u0435\u043b\u0435\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438: \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c\n\n\u0433\u0438\u043f\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c\u0438\u0438 \u0443\u0440\u043e\u0432\u0435\u043d\u044c 25(OH)D \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c 75\u2013125 \u043d\u043c\u043e\u043b\u044c/\u043b (30\u201350 \u043d\u0433/\u043c\u043b).\n\u0426\u0435- \u043b\u0435\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430:\n\u043e\u0431\u0449\u0435\u0433\u043e \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0441 \u043f\u0435\u0440\u0435\u0440\u0430\u0441\u0447\u0435\u0442\u043e\u043c \u043d\u0430 \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d \u2014 2,1\u20132,3 \u043c\u043c\u043e\u043b\u044c/\u043b \u0438\u043b\u0438 \u0438\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u043a\u0430\u043b\u044c\u0446\u0438\u044f (\u0421\u0430++) \u2014 1,10\u20131,25 \u043c\u043c\u043e\u043b\u044c/\u043b.\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u044