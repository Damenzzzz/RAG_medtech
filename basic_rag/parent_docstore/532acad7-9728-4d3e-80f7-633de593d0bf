 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u043f\u043b\u043e\u0441\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0440\u0430\u043a\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043a\u0440\u0443\u043f\u043d\u044b\u0445\n\u043c\u043d\u043e\u0433\u043e\u0446\u0435\u043d\u0442\u0440\u043e\u0432\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 [33,61] (\u0423\u0414 \u0410).\n\n\u0418\u0437 \u0442\u0430\u0440\u0433\u0435\u0442\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0432 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 \u0432\u043e\u0448\u0435\u043b\n\u0446\u0435\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431 [33, 61] (\u0423\u0414 \u0410).\n\n23\n\n\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u044b\u043c\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438 \u043f\u0440\u0438 \u043f\u043b\u043e\u0441\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u043c\n\n\u0440\u0430\u043a\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u043f\u0440\u0438 1 \u0438 2 \u043b\u0438\u043d\u0438\u0439 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u043f\u043b\u0430\u0442\u0438\u043d\u044b (\u0446\u0438\u0441\u043f\u043b\u0430\u0442\u0438\u043d,\n\u043a\u0430\u0440\u0431\u043e\u043f\u043b\u0430\u0442\u0438\u043d) \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u0444\u0442\u043e\u0440\u043f\u0438\u0440\u0438\u043c\u0438\u0434\u0438\u043d\u0430 (5 \u0444\u0442\u043e\u0440\u0443\u0440\u0430\u0446\u0438\u043b), \u0430\u043d\u0442\u0440\u0430\u0446\u0438\u043a\u043b\u0438\u043d\u044b,\n\u0442\u0430\u043a\u0441\u0430\u043d\u044b \u2013 \u043f\u0430\u043a\u043b\u0438\u0442\u0430\u043a\u0441\u0435\u043b, \u0434\u043e\u0446\u0435\u0442\u0430\u043a\u0441\u0435\u043b. \u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u0438\n\u0430\u0434\u0435\u043d\u043e\u043a\u0438\u0441\u0442\u043e\u0437\u043d\u043e\u0439 \u043a\u0430\u0440\u0446\u0438\u043d\u043e\u043c\u0435 \u0438 \u043f\u043b\u043e\u0441\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u043c \u0440\u0430\u043a\u0435 \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u043a\u0441\u043e\u0440\u0443\u0431\u0438\u0446\u0438\u043d,\n\n\u043a\u0430\u043f\u0435\u0446\u0438\u0442\u0430\u0431\u0438\u043d, \u0431\u043b\u0435\u043e\u043c\u0438\u0446\u0438\u043d, \u0432\u0438\u043d\u043a\u0440\u0438\u0441\u0442\u0438\u043d, \u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434.\n\u041f\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043a\u0430\u043a \u043d\u0435\u043e\u0430\u0434\u044a\u044e\u0432\u0430\u043d\u0442\u043d\u043e\u0439, \u0430\u0434\u044a\u044e\u0432\u0430\u043d\u0442\u043d\u043e\u0439 \u0442\u0430\u043a \u0438 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\u043f\u043e\u043b\u0438\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u0438 \u043f\u043b\u043e\u0441\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u043c \u0440\u0430\u043a\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445\n\u0441\u0445\u0435\u043c \u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0445\u0438\u043c\u0438\u043e\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432:\nPF:\n\n\u2022 \u04