\u0435\u043d\u0435\u043d\u0438\u044f \u0430\u0434\u0433\u0435\u0437\u0438\u0438 \u0438 \u0430\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u0438 \u0430\u0434\u0433\u0435\u0437\u0438\u0438 \u0438\u043b\u0438 \u0430\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0438\u043d\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0410\u0414\u0424, \u0440\u0438\u0441\u0442\u043e\u0446\u0435\u0442\u0438\u043d\u043e\u043c, \u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u043b\u0430\u0433\u0435\u043d\u043e\u043c \u0421\u0438\u043d\u0434\u0440\u043e\u043c \u041a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u0441\u043e \u041e\u0410\u041a, \u043c\u043e\u0440\u0444\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0412\u0438\u0441\u043a\u043e\u0442\u0442\u0430-\u041e\u043b\u0434\u0440\u0438\u0447\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445, \u043a\u043e\u0436\u043d\u044b\u0435 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0438, \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u0430\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0435\u0440\u043c\u0430\u0442\u0438\u0442\u0430 \u0438 \u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f", "type": "Document"}}