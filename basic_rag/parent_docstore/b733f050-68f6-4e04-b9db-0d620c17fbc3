d \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1%, 1-3 \u0441\u0443\u0442. \u0412(9,11,13,15\n2%. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 2 \u043b\u0435\u0442 \u2013 0,1 )\n\u2013 0,5 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c \u0434\u043e 2-\u0445\n\u043b\u0435\u0442\n\n3 \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1-3 \u0441\u0443\u0442. \u0410(9,11,13,\n15,16)\n50\u043c\u0433/\u043c\u043b. \u0412\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u0432, \u0432/\u043c,\n\u043f/\u043a \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0434\u0435\u0442\u044f\u043c \u0434\u043e 12\n\u043b\u0435\u0442 - 1-2\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b, \u0441\u0442\u0430\u0440\u0448\u0435\n12 \u043b\u0435\u0442 - 50-100\u043c\u0433.\n\u041d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438 (\u041d\u041f\u0412\u0421)\n\n7\n\n4 \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0438 200\u043c\u0433- \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1-5 \u0441\u0443\u0442 \u0410 (16,17,18)\n\n60 \u043c\u0433 \u043d\u0430 1 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, 3-4\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 1,5 \u0433 - 2,0 \u0433.\n\u0421\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438 125, 250 \u043c\u0433:\n\u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 10-15 \u043c\u0433/\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0451\u043d\u043a\u0430, 2-3 \u0440\u0430\u0437\u0430\n\u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f 120 \u043c\u0433/5 \u043c\u043b, \u0434\u043b\u044f\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c: \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 -\n10-15 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, 4 \u0440\u0430\u0437\u0430\n\u0432 \u0441\u0443\u0442\u043a\u0438\n\n5 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d\u0430 100 1-5 \u0441\u0443\u0442 \u0410 (16,17,18,\n\u043c\u0433/5\u043c\u043b - 200 \u043c\u043b, \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 19 )\n\u0432\u043d\u0443\u0442\u0440\u044c, 7-10 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b\n\u0442\u0435\u043b\u0430, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 - 30 \u043c\u0433/\u043a\u0433.\n\n6 \u041a\u0435\u0442\u043e\u0440\u043e\u043b\u0430\u043a \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1-5 \u0434\u043d\u0435\u0439 \u0410\n(9,10,11,13,\n30\u043c\u0433/\u043c\u043b. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435\n15,16)\n15 \u043b\u0435\u0442 \u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u043c 10-30\n\u043c\u0433, \u043a\u0430\u0436\u0434\u044b\u0435 6\u0447.\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438\n7 \u0426\u0435\u0444\u0430\u0437\u043e\u043b\u0438\u043d 50-100\u043c\u0433/\u043a\u0433, 1 \u0440\u0430\u0437 \u0437\u0430 30-60 \u0414\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 A (4, 5,6,7,\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043f\u0435\u0440\u0435\u0434 8,16,20)\n\u043c\u0438\u043d \u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430 \u043a\u043e\u0436\u043d\u044b\u0445\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439\n\u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432.\n8 \u0426\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c 750\u043c\u0433 1 \u0440\u0430\u0437 \u0437\u0430 30-60 \u043c\u0438\u043d \u0414\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u2013 A (4, 5,6,7,\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043f\u0435\u0440\u0435\u0434 8,16,20)\n\u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430 \u043a\u043e\u0436\u043d\u044b\u0445\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439, \u0434\u043b\u044f\n\u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432 (\u0434\u043e\u0437\u0430 \u0432\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043c\u0430\u0441\u0441\u044b\n\u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u0442\u0435\u043b\u0430). \u0421 \u0446\u0435\u043b\u044c\u044e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u2013 5-7\n\u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0441\u0443\u0442\u043e\u043a.\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0434\u0435\u0442\u044f\u043c \u0441\n\u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u0431\u043e\u043b\u0435\u0435 40 \u043a\u0433. -\n250-500 \u043c\u0433/\u0441\u0443\u0442\u043a\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 12\n\u0447\u0430\u0441\u043e\u0432; \u0434\u0435\u0442\u044f\u043c \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430\n\u043c\u0435\u043d\u0435\u0435 40 \u043a\u0433 \u2013 30-100\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438 3-4 \u0440\u0430\u0437\u0430,\n\u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u043c \u0438\u043b\u0438 \u0432/\u0432\n\n8\n\n9 \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d \u0414\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 - 1 \u0440\u0430\u0437 \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c A (4, 5,6,7,\n\n\u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043f\u0440\u0438 8,16,20)\n\u0437\u0430 30-60 \u043c\u0438\u043d \u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\u043c\n\u043a\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432.\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435\n\u0412\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 10\n60 \u043c\u0438\u043d. \u0421 \u0446\u0435\u043b\u044c\u044e\n\u043c\u0433/\u043c\u0438\u043d. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u043b\u0435\u0442 \u2013 1-2\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 24 \u0447\u0430\u0441\u0430. \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u0414\u0435\u0442\u044f\u043c \u0434\u043e 12 \u043b\u0435\u0442 \u2013 20- \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 - 5-7 \u0441\u0443\u0442.\n50\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438.\n10 \u041b\u0438\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d \u0412\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e, 10 5-7 \u0441\u0443\u0442 \u0412 (5,8,16,20)\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447.,\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0435 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\u0435\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432 \u0434\u043e\u0437\u0435 10-20\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442., \u0432 \u043e\u0434\u043d\u043e \u0438\u043b\u0438\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\n\u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u0438 \u0434\u0435\u0442\u044f\u043c\n\u043e\u0442 1 \u043c\u0435\u0441\u044f\u0446\u0430 \u0438 \u0441\u0442\u0430\u0440\u0448\u0435\n11 \u0412\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d 15 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442., \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 2 5-7 \u0441\u0443\u0442 \u0412 (5,8,16,20)\n\u0433/\u0441\u0443\u0442., \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441\u043e\u0432,\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0434\u043e\u0437\u0430\n\u0434\u043e\u043b\u0436\u043d\u0430 \u0432\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435\n60 \u043c\u0438\u043d.\n\n\u2212 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e, \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0434\u043b\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f 1 \u043a \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u041a\u041f (\u0441\u043c. \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 1).\n\n\u2212 \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0438\u0434\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u043d\u0435\u0442.\n\n7) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432: \u043d\u0435\u0442.\n\n8) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438:\n\u2022 \u0443\u0433\u043d\u0435\u0442\u0435\u043d\u0438\u0435 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f;\n\u2022 \u0440\u0435\u0437\u043a\u043e\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438, \u0434\u044b\u0445\u0430\u043d\u0438\u044f,\n\u0433\u043b\u043e\u0442\u0430\u043d\u0438\u044f, \u0432\u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\n9) \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438;\n\u2022 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u044b;\n\n\u2022 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u044f \u0438 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0433\u0440\u0443\u0434\u0438\u043d\u043e-\u043a\u043b\u044e\u0447\u0438\u0447\u043d\u043e\u0439 \u2013\u0441\u043e\u0441\u0446\u0435\u0432\u0438\u0434\u043d\u043e\u0439\n\u043c\u044b\u0448\u0446\u044b;\n\u2022 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0433\u043e\u043b\u043e\u0432\u044b.\n\n14. \u041c\u0415\u0414\u0418\u0426\u0418\u041d\u0421\u041a\u0410\u042f \u0420\u0415\u0410\u0411\u0418\u041b\u0418\u0422\u0410\u0426\u0418\u042f: \u0441\u043c. \u041a\u041f \u00ab\u0412\u0442\u043e\u0440\u043e\u0439 \u044d\u0442\u0430\u043f \u00ab\u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f\n\n\u0410\u00bb \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u0422\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u0438 \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u044f (\u0434\u0435\u0442\u0441\u043a\u0430\u044f)\u00bb\u00bb.\n\n15.\u041f\u0410\u041b\u041b\u0418\u0410\u0422\u0418\u0412\u041d\u0410\u042f \u041f\u041e\u041c\u041e\u0429\u042c: \u043d\u0435\u0442.\n\n9\n\n16. \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\u041b\u0424\u041a \u2013 \u043b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\n\u0413.\u041a.\u0421. \u2013 \u0433\u0440\u0443\u0434\u0438\u043d\u043e-\u043a\u043b\u044e\u0447\u0438\u0447\u043d\u043e-\u0441\u043e\u0441\u0446\u0435\u0432\u0438\u0434\u043d\u0430\u044f \u043c\u044b\u0448\u0446\u044b.\n\u042d\u041a\u0413 \u2013 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u043c\u043c\u0430.\n\n\u0423\u0417\u0418 \u2013 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n17. \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0447\u0435\u0440\u0435\u0437 3 \u0433\u043e\u0434\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0435\u0433\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441 \u0434\u0430\u0442\u044b \u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u043e\u0432\u044b\u0445\n\n\u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n18. \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u0434\u0430\u043d\u043d\u044b\u0445:\n\n1) \u041d\u0430\u0433\u044b\u043c\u0430\u043d\u043e\u0432 \u0411\u043e\u043b\u0430\u0442 \u0410\u0431\u044b\u043a\u0435\u043d\u043e\u0432\u0438\u0447 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438 No1 \u0444\u0438\u043b\u0438\u0430\u043b\u0430 \u041a\u0424 UMC\u041d\u041d\u0426\u041c\u0414, \u0433\u043b\u0430\u0432\u043d\u044b\u0439\n\u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439 \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433-\u043e\u0440\u0442\u043e\u043f\u0435\u0434 \u041c\u0417\u0421\u0420 \u0420\u041a.\n2) \u0425\u0430\u0440\u0430\u043c\u043e\u0432 \u0418\u0441\u0430\u043c\u0434\u0443\u043d \u041a\u0430\u0443\u0434\u0443\u043d\u043e\u0432\u0438\u0447 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\n\n\u0446\u0435\u043d\u0442\u0440\u0430 \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438 \u0423\u041a \"\u0410\u043a\u0441\u0430\u0439\" \u043f\u0440\u0438 \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \"\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430.\n3) \u0427\u0438\u043a\u0438\u043d\u0430\u0435\u0432 \u0410\u0433\u0430\u0431\u0435\u043a \u0410\u043b\u0438\u0431\u0435\u043a\u043e\u0432\u0438\u0447 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438 \u0413\u041a\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u0413\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u0434\u0435\u0442\u0441\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0430 No2\u00bb.\n\n4) \u0416\u0430\u043d\u0430\u0441\u043f\u0430\u0435\u0432\u0430 \u0413\u0430\u043b\u0438\u044f \u0410\u043c\u0430\u043d\u0433\u0430\u0437\u0438\u0435\u0432\u043d\u0430 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u00ab\u041d\u0430\u0443\u0447\u043d\u043e \u2013\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438\u00bb, \u0433\u043b\u0430\u0432\u043d\u044b\u0439\n\n\u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433 \u041c\u0417\u0421\u0420 \u0420\u041a.\n5) \u0421\u0430\u0442\u0431\u0430\u0435\u0432\u0430 \u042d\u043b\u044c\u043c\u0438\u0440\u0430 \u041c\u0430\u0440\u0430\u0442\u043e\u0432\u043d\u0430 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\n\u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u043e\u0433\u043e \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb.\n\n19. \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n\n20. \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u043e\u0432:\n\u0411\u0435\u043a\u0442\u0430\u0441\u043e\u0432 \u0416\u0430\u0440\u043b\u044b\u0433\u0430\u0441\u044b\u043d \u041a\u0443\u0430\u043d\u044b\u0448\u0431\u0435\u043a\u043e\u0432\u0438\u0447 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0413\u041a\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u0413\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u0434\u0435\u0442\u0441\u043a\u0430\u044f\n\u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0430 No2\u00bb \u0433. \u0410\u0441\u0442\u0430\u043d\u0430.\n\n21. \u0421\u043f\u0438\u0441\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b:\n1) \u0410.\u041a. \u041a\u0430\u0440\u0430\u0431\u0435\u043a\u043e\u0432 \u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u043a\u0440\u0438\u0432\u043e\u0448\u0435\u044f \u0443\u0434\u0435\u0442\u0435\u0439. 2002.", "type": "Document"}}