\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u0418\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e \u041a\u0430\u0448\u0435\u043b\u044c, \u0440\u0432\u043e\u0442\u0430, \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0424\u042d\u0413\u0414\u0421 \u041f\u0440\u0438 \u0424\u042d\u0413\u0414\u0421 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0435\u0434\u044b \u0433\u0438\u043f\u0435\u0440\u0441\u0430\u043b\u0438\u0432\u0430\u0446\u0438\u044f, \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u044f\n\n\u0418\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e \u041a\u0430\u0448\u0435\u043b\u044c, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0411\u0440\u043e\u043d\u0445\u043e \u2022 \u041f\u0440\u0438 \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u0438\u0438\n\u0431\u0440\u043e\u043d\u0445\u043e\u0432 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u0441\u043a\u043e\u043f\u0438\u044f \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430\n\u0431\u0440\u043e\u043d\u0445\u043e\u0432;\n\u2022 \u041f\u0440\u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438\n\u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0431\u0440\u043e\u043d\u0445\u043e\u0432\n\n\u042d\u0437\u043e\u0444\u0430\u0433\u0438\u0442 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0440\u0432\u043e\u0442\u0430, \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0435\u0434\u044b \u0424\u042d\u0413\u0414\u0421 \u2022 \u041f\u0440\u0438 \u044d\u0437\u043e\u0444\u0430\u0433\u043e\u0441\u043a\u043e\u043f\u0438\u0438\u0438\n\n\u0433\u0438\u043f\u0435\u0440\u0441\u0430\u043b\u0438\u0432\u0430\u0446\u0438\u044f \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u043a\u0430\u0448\u0435\u043b\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438\n\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430\n\n\u042d\u0437\u043e\u0444\u0430\u0433\u043e \u2022 \u0411\u043e\u043b\u0438 \u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u2022 \u0424\u042d\u0413\u0414\u0421 \u2022 \u041f\u0440\u0438 \u044d\u0437\u043e\u0444\u0430\u0433\u043e\u0441\u043a\u043e\u043f\u0438\u0438\u0438 \u043d\u0435\n\u0441\u043f\u0430\u0437\u043c \u0443 \u0434\u0435\u0442\u0435\u0439 \u043a\u043b\u0435\u0442\u043a\u0435 \u0438\u0432 \u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f\n\u043c\u0435\u0436\u043b\u043e\u043f\u0430\u0442\u043e\u0447\u043d\u043e\u0446 \u0421\u043a\u043e\u043f\u0438\u0447\u0435\u0441 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u0438\u0440\u0440\u0430\u0434\u0438\u0438\u0440\u0443\u044e\u0442 \u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430\n\u0432 \u0441\u043f\u0438\u043d\u0443, \u0448\u0435\u044e, \u0443\u0448\u0438 \u0432\u0430\u043d\u0438\u0435 \u2022 \u041f\u0440\u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c\n\n\u2022 \u0411\u043e\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430\n\u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\n\u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0432 \u0432\u0438\u0434\u0435 \u00ab\u0447\u0451\u0442\u043e\u043a\u00bb,\n\u00ab\u0448\u0442\u043e\u043f\u043e\u0440\u0430\u00bb\n\u2022 \u0414\u0438\u0441\u0444\u0430\u0433\u0438\u044f \u043f\u0440\u0438\n\u043f\u0440\u0438\u0435\u043c\u0435 \u0436\u0438\u0434\u043a\u043e\u0439 \u0438\n\u0442\u0432\u0435\u0440\u0434\u043e\u0439 \u043f\u0438\u0449\u0438\n\u2022 \u041e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u043a\u043e\u043c\u043a\u0430 \u0437\u0430\n\u0433\u0440\u0443\u0434\u0438\u043d\u043e\u0439\n\u041f\u0435\u043f\u0442\u0438\u0447\u0435\u0441 \u2022 \u0431\u043e\u043b\u044c \u04