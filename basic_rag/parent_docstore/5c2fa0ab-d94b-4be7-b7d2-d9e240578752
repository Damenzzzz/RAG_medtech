c \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e\n\u0440\u0438\u0441\u043a\u0430 \u0441 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u043a\u0430\u043d\u0430\u043b\u043e\u043f\u0430\u0442\u0438\u044f\u043c\u0438, \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f\u043c\u0438 \u0438\u043b\u0438\n\u0412\u041f\u0421.\n\n\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0435\u0444\u0438\u0431\u0440\u0438\u043b\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043f\u043e\u0440\u043e\u0433\u043e\u0432 I \u0421\n\u043d\u0435\u0442\u0440\u0430\u043d\u0441\u0432\u0435\u043d\u043e\u0437\u043d\u044b\u0445 \u041a\u0412\u0414 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u043e \u0443 \u0434\u0435\u0442\u0435\u0439 \u0432 Ia\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0440\u043e\u0441\u0442\u0430.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0438 \u0438\u0437 \u0432\u044b\u0445\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u041a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410 \u0416\u042d/\u0416\u0422 \u0438\u0437 \u0412\u0422\u041f\u0416 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0434\u043b\u044f I B\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0438/\u0438\u043b\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e\n\u0410\u0410\u0422 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b) \u0438\u043b\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0439\n\u0424\u0412 \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430 \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0416\u042d \u0438\u0437 \u0412\u0422\u041f\u0416.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 \u0438\u0437 \u043a\u043b\u0430\u0441\u0441\u0430 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 I \u0421\n\u043a\u0430\u043d\u0430\u043b\u043e\u0432 (\u043a\u043b\u0430\u0441\u0441 IC) \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441\n\u0416\u042d/\u0416\u0422 \u0438\u0437 \u0412\u0422\u041b\u0416, \u043a\u043e\u0440\u043d\u044f \u0430\u043e\u0440\u0442\u044b, \u0441\u0442\u0432\u043e\u0440\u043e\u043a \u0430\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0438\n\u044d\u043f\u0438\u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\n61\n\n\u0423 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0416\u042d/\u0416\u0422 \u0438\u0437 \u0412\u0422\u041b\u0416, \u043a\u043e\u0440\u043d\u044f \u0430\u043e\u0440\u0442\u044b, I B\n\u0441\u0442\u0432\u043e\u0440\u043e\u043a \u0430\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0438 \u044d\u043f\u0438\u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438, \u043f\u0440\u0438 Ia\n\u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0438\u0437 \u043a\u043b\u0430\u0441\u0441\u0430\n\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (IC \u043a\u043b\u0430\u0441\u0441) \u0438\u043b\u0438 \u043d\u0435\u0436\u0435\u043b\u0430\u043d\u0438\u0438\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0410\u0410\u0422, \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c\n\n\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u0430\u044f \u043e\u043f\u044b\u0442\u043d\u044b\u043c\u0438\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u043e\u0432 \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0416\u0422\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u041a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u0430\u044f \u043e\u043f\u044b\u0442\u043d\u044b\u043c\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438, I B\n\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0435\u0440\u0432\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0443 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u0435\u0432\u043e\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0439 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439.\n\u0412 \u0441\u043b\u0443\u0447\u0430\u044f\u0445, \u043a\u043e\u0433\u0434\u0430 \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0438\u043b\u0438 I \u0421\n\u043d\u0435\u0436\u0435\u043b\u0430\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438,\n\n\u0432\u0435\u0440\u0430\u043f\u0430\u043c\u0438\u043b\u043e\u043c \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438 \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b IC\n\u043a\u043b\u0430\u0441\u0441\u0430) \u0443 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043b\u0435\u0432\u043e\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0439 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439.\n\u0422\u0435\u0440\u0430\u043f\u0438\u044f \u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438, \u0432\u0435\u0440\u0430\u043f\u0430\u043c\u0438\u043b\u043e\u043c \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438 I \u0421\n\u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b IC \u043a\u043b\u0430\u0441\u0441\u0430) \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0443\n\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0438\u0437\n\u043f\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u044b\u0445 \u043c\u044b\u0448\u0446.\n\u0422\u0435\u0440\u0430\u043f\u0438\u044f \u0431\u0435\u0442\u0430-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438, \u0432\u0435\u0440\u0430\u043f\u0430\u043c\u0438\u043b\u043e\u043c \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u0430\u043c\u0438 I \u0421\n\u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b IC \u043a\u043b\u0430\u0441\u0441\u0430) \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u0443\n\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0438\u0437 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\n\u043c\u0438\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438 \u0442\u0440\u0438\u043a\u0443\u0441\u043f\u0438\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430.\n\u0423 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0438\u0437 I B\n\u043f\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u044b\u0445 \u043c\u044b\u0448\u0446, \u043f\u0440\u0438 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 Ia\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0438\u0437 \u043a\u043b\u0430\u0441\u0441\u0430 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (IC \u043a\u043b\u0430\u0441\u0441)\n\u0438\u043b\u0438 \u043e\u0442\u043a\u0430\u0437\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043e\u0442 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439\n\u0410\u0410\u0422, \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410 \u043f\u043e\u0434 \u042d\u0445\u043e\u041a\u0413-\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u0430\u044f \u043e\u043f\u044b\u0442\u043d\u044b\u043c\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438.\n\n\u0423 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0438\u0437 I B\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043c\u0438\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438 \u0442\u0440\u0438\u043a\u0443\u0441\u043f\u0438\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430, \u043f\u0440\u0438 Ia\n\u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0438\u0437 \u043a\u043b\u0430\u0441\u0441\u0430\n\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (IC \u043a\u043b\u0430\u0441\u0441) \u0438\u043b\u0438 \u043d\u0435\u0436\u0435\u043b\u0430\u043d\u0438\u0438\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e \u0410\u0410\u0422, \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c\n\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u043d\u0430\u044f \u0420\u0427\u0410, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u043c\u0430\u044f \u043e\u043f\u044b\u0442\u043d\u044b\u043c\u0438\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0424\u0416\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n62\n\n\u0418\u043c\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044f \u041a\u0412\u0414 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u