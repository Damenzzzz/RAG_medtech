a\u0440\u043e\u0432\u043e\u0432; \u043f\u0440\u0438\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u0445\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e 2 \u0447\u0430\u0441\u0430 \u0438 \u0431\u043e\u043b\u0435\u0435 \u2013\n\u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e 0,5-1 \u0433 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u043f\u043e 0,5-1 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 6-8 \u0447\u0430\u0441\u043e\u0432\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0443\u0442\u043e\u043a \u043f\u043e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n\u0412\u0442\u043e\u0440\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u041b\u0421\n\n\u0413\u043b\u0438\u043a\u043e\u043f\u0435\u043f\u0442\u0438\u0434\u044b \u0412\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d \u041f\u0440\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0438 \u043d\u0430 \u0431\u0435\u0442\u0430-\u043b\u0430\u043a\u0442\u0430\u043c\u043d\u044b\u0435\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0438 \u043f\u0440\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439\n\u0412\n\u043a\u043e\u043b\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438 MRSA.\n15 \u043c\u0433/\u043a\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e, \u0437\u0430\n60-120 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430 \u043a\u043e\u0436\u043d\u044b\u0445\n\u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432. \u0412\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 10\n\u043c\u0433/\u043c\u0438\u043d; \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438\u043d\u0444\u0443\u0437\u0438\u0438\n\u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 60 \u043c\u0438\u043d.\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u041a\u0435\u0442\u043e\u043f\u0440\u043e\u0444\u0435\u043d \u0432/\u043c 50- 100 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441\u043e\u0432. \u0410\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 - 200 \u043c\u0433,\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 (\u041d\u041f\u0412\u0421) \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3 \u0434\u043d\u0435\u0439.\n\u0412\u043d\u0443\u0442\u0440\u044c 100\u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441\u043e\u0432.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 200\u043c\u0433.\n\u041d\u0435 \u0431\u043e\u043b\u0435\u0435 3-5 \u0434\u043d\u0435\u0439.\n\u041a\u0435\u0442\u043e\u0440\u043e\u043b\u0430\u043a \u0432/\u043c 30\u043c\u0433, \u043a\u0430\u0436\u0434\u044b\u0435 6 \u0447\u0430\u0441\u043e\u0432, 15 \u043c\u0433 \u0432/\u0432 \u043a\u0430\u0436\u0434\u044b\u0435 6 \u0410\n\u0447\u0430\u0441\u043e\u0432 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 4 \u0434\u043e\u0437 (\u043f\u0440\u0438 \u0421\u041a\u0424 > 50\n\u043c\u043b/\u043c\u0438\u043d\u0443\u0442\u0443).\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 90\n\u043c\u0433/\u0434\u0435\u043d\u044c, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 2 \u0434\u043d\u0435\u0439. \u0412\u043d\u0443\u0442\u0440\u044c \u043f\u043e 10 \u043c\u0433\n\u043a\u0430\u0436\u0434\u044b\u0435 6 \u0447\u0430\u0441\u043e\u0432, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u043e\u043b\u0438.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 40 \u043c\u0433. \u041d\u0435 \u0431\u043e\u043b\u0435\u0435\n5 \u0434\u043d\u0435\u0439.\n\n\u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0432/\u0432 400 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 4-6 \u0447\u0430\u0441\u043e\u0432 \u0438\u043b\u0438 600-800 \u043c\u0433 \u0410\n\u043a\u0430\u0436\u0434\u044b\u0435 6-8 \u0447\u0430\u0441\u043e\u0432\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 2400 \u043c\u0433 \u0432 \u0434\u0435\u043d\u044c. \u041d\u0435\n\u042d\u0442\u043e\u0440\u0438\u043a\u043e\u043a\u0441\u0438\u0431 \u043130\u043e\u2013\u043b6\u0435\u04350 5\u043c \u0433\u0434 \u043d\u043e\u0435\u0434\u0439\u0438.\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c. \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0410\n3-5 \u0434\u043d\u0435\u0439\n\n\u041d\u0430\u043f\u0440\u043e\u043a\u0441\u0435\u043d \u0432\u043d\u0443\u0442\u0440\u044c 250 - 500\u043c\u0433 \u0432 1 -2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c. \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 3- \u0410\n5 \u0434\u043d\u0435\u0439.\n\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438 \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b \u0432/\u043c, \u0432/\u0432 50-100 \u043c\u0433. \u041a\u0430\u0436\u0434\u044b\u0435 4-6 \u0447\u0430\u0441\u043e\u0432.\n\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 400 \u043c\u0433. 1-3 \u0434\u043d\u0435\u0439. \u0410\n\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b \u0412\u043d\u0443\u0442\u0440\u044c 20 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0434\u043e 14 \u0434\u043d\u0435\u0439 \u0410\n\u043f\u043e\u043c\u043f\u044b\n\n\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\n3) \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [28,29,30]:\n\u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u0438 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0439\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438\n\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u043a\u043b\u0438\u043d\u0438\u043a\u043e-\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438.\n\u0412\u044b\u0431\u043e\u0440 \u043c\u0435\u0442\u043e\u0434\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445\n\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439, \u0441\u0442\u0430\u0434\u0438\u0435\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u043f\u043e Kellgren\u2013Lawrence), \u043e\u0441\u0435\u0432\u043e\u0439 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439 \u0438\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u0441\u0432\u044f\u0437\u043e\u0447\u043d\u043e\u0433\u043e \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430.\n\n1. \u0410\u0440\u0442\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 (\u0434\u0435\u0431\u0440\u0438\u0434\u043c\u0435\u043d\u0442, \u043b\u0430\u0432\u0430\u0436) [30]\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0431\u043b\u043e\u043a\u0430\u0434\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u0430, \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u0430\u044f \u043c\u0435\u043d\u0438\u0441\u043a\u043e\u0432\u0430\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043d\u0430 \u0444\u043e\u043d\u0435\n\u043b\u0451\u0433\u043a\u043e\u0433\u043e/\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u041e\u0410.\n\u0420\u0438\u0441\u043a\u0438 \u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f: \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u0442\u0440\u043e\u043c\u0431\u043e\u0437 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u0432\u0435\u043d/\u0422\u042d\u041b\u0410, \u0433\u0435\u043c\u0430\u0440\u0442\u0440\u043e\u0437, \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435\n\u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u0441\u0438\u043d\u043e\u0432\u0438\u0442. \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u2013 \u0421.\n\n2. \u041a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043e\u0441\u0442\u0435\u043e\u0442\u043e\u043c\u0438\u0438 (\u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0442\u0438\u0431\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u0441\u0442\u0435\u043e\u0442\u043e\u043c\u0438\u044f \u0438 \u0434\u0440.) [30]\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u0435\u043c\u0430\u044f \u0432\u0430\u0440\u0443\u0441\u043d\u0430\u044f \u0438\u043b\u0438 \u0432\u0430\u043b\u044c\u0433\u0443\u0441\u043d\u0430\u044f \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e\u0441\u0438 \u043d\u0438\u0436\u043d\u0435\u0439\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0441 \u0446\u0435\u043b\u044c\u044e \u043f\u0435\u0440\u0435\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0438 \u043e\u0442\u0441\u0440\u043e\u0447\u043a\u0438 \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f.\n\u0420\u0438\u0441\u043a\u0438 \u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f: \u0442\u0440\u043e\u043c\u0431\u043e\u0437/\u0422\u042d\u041b\u0410, \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u043d\u0435\u0441\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435\n\n\u0441\u0440\u0430\u0449\u0435\u043d\u0438\u0435, \u043f\u043e\u0442\u0435\u0440\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438, \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e-\u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440, \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f\n\u0431\u043e\u043b\u044c, \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0440\u0442\u0440\u043e\u0437\u0430, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430 \u043d\u0430\n\u0430\u0440\u0442\u0440\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0443. \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u2013 B.\n3. \u041e\u0434\u043d\u043e\u043c\u044b\u0449\u0435\u043b\u043a\u043e\u0432\u043e\u0435 \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 (\u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435, UKA)\n\n[29,30].\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 (\u0447\u0430\u0449\u0435\n\u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e) \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0441\u0432\u044f\u0437\u043e\u0447\u043d\u043e\u0433\u043e \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u0435\u043c\u043e\u0439 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438; \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a\n\n\u043e\u0440\u0433\u0430\u043d\u043e\u0441\u0431\u0435\u0440\u0435\u0433\u0430\u044e\u0449\u0430\u044f \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430 \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044e.\n\u0420\u0438\u0441\u043a\u0438 \u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f: \u043f\u0435\u0440\u0438\u043f\u0440\u043e\u0442\u0435\u0437\u043d\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u0442\u0440\u043e\u043c\u0431\u043e\u0437/\u0422\u042d\u041b\u0410, \u0430\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0440\u0430\u0441\u0448\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435, \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0440\u0442\u0440\u043e\u0437\u0430 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u0430\u0445, \u043f\u0435\u0440\u0438\u043f\u0440\u043e\u0442\u0435\u0437\u043d\u044b\u0435\n\u043f\u0435\u0440\u0435\u043b\u043e\u043c\u044b, \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0451\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u0431\u043e\u043b\u044c.\n\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u2013 B.\n4. \u0422\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 (TKA) [28,29,30]\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0439 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0442\u044f\u0436\u0451\u043b\u044b\u0439 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\n(III\u2013IV \u0441\u0442\u0430\u0434\u0438 \u043f\u043e Kellgren\u2013Lawrence) \u043f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0438\n\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0439\n\n\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 3 \u043c\u0435\u0441\u044f\u0446\u0435\u0432.\n\u0420\u0438\u0441\u043a\u0438 \u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f: \u043f\u0435\u0440\u0438\u043f\u0440\u043e\u0442\u0435\u0437\u043d\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u0442\u0440\u043e\u043c\u0431\u043e\u0437/\u0422\u042d\u041b\u0410,\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435/\u0433\u0435\u043c\u0430\u0442\u043e\u043c\u0430, \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0443\u0440\u0430, \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0430\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0430\u0441\u0448\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435,\n\u043f\u0435\u0440\u0438\u043f\u0440\u043e\u0442\u0435\u0437\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c, \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e-\u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f", "type": "Document"}}