{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_47ed7afd024f", "title": "\u0414\u0418\u0410\u0411\u0415\u0422\u0418\u0427\u0415\u0421\u041a\u0418\u0415 \u041a\u041e\u041c\u042b", "source_file": "2025_\u0414\u0418\u0410\u0411\u0415\u0422\u0418\u0427\u0415\u0421\u041a\u0418\u0415_\u041a\u041e\u041c\u042b_3d97feb6f2.pdf", "icd_codes": "E10.0, E11.0", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0414\u0418\u0410\u0411\u0415\u0422\u0418\u0427\u0415\u0421\u041a\u0418\u0415 \u041a\u041e\u041c\u042b.pdf"}, "page_content": "\u2022 \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432,\n\u043a\u0435\u0442\u043e\u043d\u0435\u043c\u0438\u0438, \u043a\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438, \u0440\u0430\u0441\u0447\u0435\u0442\n\u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438, \u041a\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430\n\n\u041a\u0440\u0430\u0439\u043d\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u044f, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u0446\u0438\u0434\u043e\u0437\u0430,\n\u043a\u0435\u0442\u043e\u043d\u0435\u043c\u0438\u0438 \u0438 \u043a\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438, \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c\n\u043f\u043b\u0430\u0437\u043c\u044b, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u041e\u041d\u041c\u041a\n\n\u0413\u0438\u043f\u0435\u0440\u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0435 \u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\n\n2.2 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\n\u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u0414\u041a\u0410 \u041e\u0441\u0442\u0440\u0430\u044f \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041f\u0440\u0438 \u0414\u041a\u0410:\n\u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u044f \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u043f\u043b\u0430\u0437\u043c\u044b, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\u0421\u0414 \u0441 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432 \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u043b\u044e\u043a\u043e\u0437\u044b\n\u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0435\u0439 \u043a\u0440\u043e\u0432\u0438, \u0440\u0430\u0441\u0447\u0435\u0442 \u043f\u043b\u0430\u0437\u043c\u044b\n\u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438, \u0440\u041d, \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 -\n\n\u0431\u0438\u043a\u0430\u0440\u0431\u043e\u043d\u0430\u0442\u043e\u0432, \u043c\u0435\u043d\u0435\u0435\n\u0430\u043d\u0438\u043e\u043d\u043d\u043e\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u044b, 30\u043c\u043c\u043e\u043b\u044c/\u043b,\n\u0430\u0446\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438/\u043a\u0435\u0442\u043e\u043d\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u0430\u0446\u0438\u0434\u043e\u0437\u0430\n\u043c\u0438\u0438 -\n\n\u0440\u041d<7,3,\n\u043a\u0435\u0442\u043e\u043d\u0435\u043c\u0438\u044f,\n\u043a\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u044f\n\u0413\u0438\u043f\u043e\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0447\u0435\u0441 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041f\u0440\u0438\n\n\u043a\u0430\u044f \u043a\u043e\u043c\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0421\u0414 \u0432 \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u043f\u043b\u0430\u0437\u043c\u044b, \u0433\u0438\u043f\u043e\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0447\u0435\u0441\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0430\u0446\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438/\u043a\u0435\u0442\u043e\u043d\u0435 \u043a\u043e\u0439 \u043a\u043e\u043c\u0435\n\u043c\u0438\u0438 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u0430\u044f\n\u043f\u043e\u0442\u0435\u0440\u044f \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f,\n\n\u0433\u043b\u044e\u043a\u043e\u0437\u0430 \u043a\u0440\u043e\u0432\u0438\n\u043c\u0435\u043d\u0435\u0435 2,8\n\u043c\u043c\u043e\u043b\u044c/\u043b.\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\n\u0430\u0446\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u0440\u0435\u0436\u0438\u043c: 1;\n\u2022 \u0434\u0438\u0435\u0442\u0430: No9, \u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0442\u044c\u0435.\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u2022 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u041e\u0426\u041a.\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f)\n\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\n\u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d \u044f \u0438\n\u043e\u0435\n\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435\n\u041b\u0421\n\u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u0432\u043e\u0434\u043d\u043e- 0,9% \u0432/\u0432 \u0438\u043d\u0444\u0443\u0437\u0438\u044f \u0410\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u043e\u0433\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0430 \u0438 \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0445\u043b\u043e\u0440\u0438\u0434\u0430\n\n\u041a\u0429\u0421 \u043d\u0430\u0442\u0440\u0438\u044f\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100%\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f): \u043d\u0435\u0442.\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n3.4 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435: \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418:\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043d\u0435\u0442.\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u0413\u0413\u0421 (\u0432\n\u041e\u0420\u0418\u0422).\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n5.1 \u041a\u0430\u0440\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 (\u0441\u0445\u0435\u043c\u044b,\n\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b): \u043d\u0435\u0442.\n\n5.2 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0440\u0435\u0436\u0438\u043c: 1;\n\u2022 \u0434\u0438\u0435\u0442\u0430: 9, \u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0442\u044c\u0435.\n\n\u041e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0442\u044c\u0435\n5.3 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u0420\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u0435\u0440\u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438 \u043f\u043b\u0430\u0437\u043c\u044b \u043f\u0443\u0442\u0435\u043c \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f\n\n\u0433\u0438\u043f\u0435\u0440\u043d\u0430\u0442\u0440\u0438\u0435\u043c\u0438\u0438 \u0438 \u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438, \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u043e\u0432\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0438 \u0433\u0438\u043f\u043e\u043a\u0441\u0438\u0438.\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f);\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421 \u044f \u0442\u0438\n\n\u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u0432\u043e\u0434\u043d\u043e- 0,45%, 0,9% \u0438\u043d\u0444\u0443\u0437\u0438\u044f \u0410\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0445\u043b\u043e\u0440\u0438\u0434\u0430\n\u0431\u0430\u043b\u0430\u043d\u0441\u0430 \u0438 \u041a\u0429\u0421 \u043d\u0430\u0442\u0440\u0438\u044f*\n\u0418\u043d\u0441\u0443\u043b\u0438\u043d\u044b \u0418\u043d\u0441\u0443\u043b\u0438\u043d \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d \u0410\n\n\u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0433\u043e \u0430\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u044f\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f** \u043f\u043e \u0434\u043e\u0437\u0430\u0442\u043e\u0440\u0443\n\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f 2 \u0438 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0438\u043d\u0444\u0443\u0437\u0438\u044f \u0410\n\u044d\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438 \u0433\u043b\u044e\u043a\u043e\u0437\u044b***\n\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u043f\u0438\u0442\u0430\u043d\u0438\u044f\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442, \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u043a\u0430\u043b\u0438\u044f \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d \u0410\n\u0432\u043e\u0441\u043f\u043e\u043b\u043d\u044f\u044e\u0449\u0438\u0439 \u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u0430\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u044f\n\n\u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u043a\u0430\u043b\u0438\u044f \u0432 \u043f\u043e \u0434\u043e\u0437\u0430\u0442\u043e\u0440\u0443\n\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0435\n*\u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0434\u0438\u0443\u0440\u0435\u0437\u0430, \u0426\u0412\u0414, \u0410\u0414, \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430\u0442\u0440\u0438\u044f,\n\u043e\u0441\u043c\u043e\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438\n\n**\u0446\u0435\u043b\u0435\u0432\u0430\u044f \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u044f 10-13 \u043c\u043c\u043e\u043b\u044c/\u043b. \u041f\u0440\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438 \u043d\u0438\u0436\u0435 10\n\u043c\u043c\u043e\u043b\u044c/\u043b \u2013 \u0434\u043e\u0437\u0443 \u0438\u043d\u0441\u0443\u043b\u0438\u043d\u0430 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0432\u0434\u0432\u043e\u0435.\n*** \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u043b\u0438\u0432\u0430\u043d\u0438\u044f 5-10% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u043f\u0440\u0438\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438 \u043d\u0438\u0436\u0435 10,0 \u043c\u043c\u043e\u043b\u044c/\u043b (\u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u0438\u043d\u0441\u0443\u043b\u0438\u043d\u0430 \u0432\u0434\u0432\u043e\u0435).\n\n\u0412\u044b\u0431\u043e\u0440 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u043c\u0438\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438:\n\u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430\u0442\u0440\u0438\u0439, \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438 \u0438 \u0410\u0414.\n\n\u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e Na = Na \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 + [1.6 \u0445\n(\u0433\u043b\u044e\u043a\u043e\u0437\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 -5.5)/ 5.5]\n\n\u2713 \u041f\u0440\u0438 \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c Na+ 145-165 \u043c\u043c\u043e\u043b\u044c/\u043b: \u0440\u0435\u