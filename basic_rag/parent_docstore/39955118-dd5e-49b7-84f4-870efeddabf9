{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_29da678caf2d", "title": "\u0410\u043d\u0442\u0435\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0445\u043e\u0434", "source_file": "2026_\u0410\u043d\u0442\u0435\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0438_\u0443\u0445\u043e\u0434_28266f0108.pdf", "icd_codes": "Z32.1, Z34.0, Z34.8, Z35.0, Z35.1, Z35.2, Z35.3, Z35.4, Z35.5, Z35.6, Z35.7, Z35.8, Z35.9, Z36.3, Z36.4, Z36.5", "source": "nrchd_official", "year": "2026", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0410\u043d\u0442\u0435\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0445\u043e\u0434.pdf"}, "page_content": "\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438;\n\u2212 \u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u0437\u0430\u043d\u044f\u0442\u0438\u044f\u043c\u0438 \u0432 \u0448\u043a\u043e\u043b\u0435 \u043f\u043e\n\u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u043a \u0440\u043e\u0434\u0430\u043c.\n\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: \u2212 \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0410\u0414, \u043f\u0443\u043b\u044c\u0441\u0430;\n\u2212 \u041e\u0441\u043c\u043e\u0442\u0440 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043d\u0430\u043b\u0438\u0447\u0438\u044f\n\u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u0432\u0435\u043d;\n\n\u2212 \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u0442\u044b \u0434\u043d\u0430 \u043c\u0430\u0442\u043a\u0438 (\u0430\u043d\u0430\u043b\u0438\u0437 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\n\u0433\u0440\u0430\u0432\u0438\u0434\u043e\u0433\u0440\u0430\u043c\u043c\u0435);\n\u2212 \u0410\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0434\u0430.\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u041e\u0410\u041c/\u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u043d\u0430 \u0431\u0435\u043b\u043e\u043a.\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\nVI \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435 - \u0432 \u0441\u0440\u043e\u043a\u0435 36 \u043d\u0435\u0434\u0435\u043b\u044c\n\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438 - \u0412\u044b\u044f\u0432\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0440\u0438\u0441\u043a\u0430 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0434\u0430\u043d\u043d\u043e\u0439 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438;\n\n- \u041f\u0440\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0442\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u044f \u043f\u043b\u043e\u0434\u0430,\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u0443\u0431\u0446\u0430 \u043d\u0430 \u043c\u0430\u0442\u043a\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e\n\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u2013 \u0441\u043c. \u041a\u041f \u00ab\u041a\u0435\u0441\u0430\u0440\u0435\u0432\u043e \u0441\u0435\u0447\u0435\u043d\u0438\u0435\u00bb, \u00ab\u0412\u0435\u0434\u0435\u043d\u0438\u0435\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0440\u043e\u0434\u043e\u0432 \u043f\u0440\u0438 \u0442\u0430\u0437\u043e\u0432\u043e\u043c \u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0438 \u043f\u043b\u043e\u0434\u0430\u00bb;\n\n\u2212 \u041f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u043b\u0430\u043d\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0440\u0430\u0447\u0430\n\u0430\u043a\u0443\u0448\u0435\u0440\u0430 \u2013 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0430, \u0435\u0441\u043b\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0434\u0435\u0442\u0441\u044f\n\u0430\u043a\u0443\u0448\u0435\u0440\u043a\u043e\u0439 \u0438\u043b\u0438 \u0432\u0440\u0430\u0447\u043e\u043c \u0412\u041e\u041f/ \u0432\u0440\u0430\u0447\u043e\u043c \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439\n\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b;\n\u2212 \u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043f\u043e \u0442\u0435\u043c\u0430\u043c \u00ab\u0433\u0440\u0443\u0434\u043d\u043e\u0435 \u0432\u0441\u043a\u0430\u0440\u043c\u043b\u0438\u0432\u0430\u043d\u0438\u0435.\n\u041f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u0430\u044f \u043a\u043e\u043d\u0442\u0440\u0430\u0446\u0435\u043f\u0446\u0438\u044f\u00bb.\n\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: - \u041d\u0430\u0440\u0443\u0436\u043d\u043e\u0435 \u0430\u043a\u0443\u0448\u0435\u0440\u0441\u043a\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c\n\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u0435 \u043f\u043b\u043e\u0434\u0430);\n\u2212 \u041e\u0441\u043c\u043e\u0442\u0440 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043d\u0430\u043b\u0438\u0447\u0438\u044f\n\n\u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u0432\u0435\u043d;\n\u2212 \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0410\u0414, \u043f\u0443\u043b\u044c\u0441\u0430;\n- \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u0442\u044b \u0434\u043d\u0430 \u043c\u0430\u0442\u043a\u0438 (\u0430\u043d\u0430\u043b\u0438\u0437 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\n\u0433\u0440\u0430\u0432\u0438\u0434\u043e\u0433\u0440\u0430\u043c\u043c\u0435);\n\n- \u0410\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0434\u0430.\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 - \u041e\u0410\u041c/\u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u043d\u0430 \u0431\u0435\u043b\u043e\u043a.\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: - \u0421\u0438\u0444\u0438\u043b\u0438\u0441 (\u0420\u041f\u0413\u0410/ \u0418\u0425\u041b\u0410/\u0418\u0424\u0410);\nVII \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435 - \u0432 \u0441\u0440\u043e\u043a\u0435 38 \u043d\u0435\u0434\u0435\u043b\u044c\n\n\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438 \u2212 \u0412\u044b\u044f\u0432\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0440\u0438\u0441\u043a\u0430 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0434\u0430\u043d\u043d\u043e\u0439 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438;\n\u2212 \u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043f\u043e \u0442\u0435\u043c\u0430\u043c \u00ab\u0413\u0440\u0443\u0434\u043d\u043e\u0435\n\n\u0432\u0441\u043a\u0430\u0440\u043c\u043b\u0438\u0432\u0430\u043d\u0438\u0435. \u041f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u0430\u044f \u043a\u043e\u043d\u0442\u0440\u0430\u0446\u0435\u043f\u0446\u0438\u044f.\n\u041f\u0435\u0440\u0435\u043d\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u00bb.\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: - \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0410\u0414, \u043f\u0443\u043b\u044c\u0441\u0430;\n- \u041e\u0441\u043c\u043e\u0442\u0440 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439 (\u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u043e\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435\n\n\u0432\u0435\u043d);\n- \u041d\u0430\u0440\u0443\u0436\u043d\u043e\u0435 \u0430\u043a\u0443\u0448\u0435\u0440\u0441\u043a\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\n\u043f\u043b\u043e\u0434\u0430);\n- \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u0442\u044b \u0434\u043d\u0430 \u043c\u0430\u0442\u043a\u0438 (\u0430\u043d\u0430\u043b\u0438\u0437 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\n\n\u0433\u0440\u0430\u0432\u0438\u0434\u043e\u0433\u0440\u0430\u043c\u043c\u0435);\n- \u0410\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0434\u0430.\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 - \u041e\u0410\u041c/\u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u043d\u0430 \u0431\u0435\u043b\u043e\u043a.\n\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\nVIII \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435 -\u0432 \u0441\u0440\u043e\u043a\u0435 \u0434\u043e 40 \u043d\u0435\u0434\u0435\u043b\u044c + 6 \u0434\u043d\u0435\u0439\n\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438 - \u0412\u044b\u044f\u0432\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0440\u0438\u0441\u043a\u0430 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0434\u0430\u043d\u043d\u043e\u0439 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435\n\u0442\u0440\u0435\u0432\u043e\u0436\u043d\u044b\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432.\n\n- \u041f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u043b\u0430\u043d\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0440\u0430\u0447\u0430\n\u0430\u043a\u0443\u0448\u0435\u0440\u0430 \u2013 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0430 \u0435\u0441\u043b\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0434\u0435\u0442\u0441\u044f\n\u0430\u043a\u0443\u0448\u0435\u0440\u043a\u043e\u0439 \u0438\u043b\u0438 \u0432\u0440\u0430\u0447\u043e\u043c \u0412\u041e\u041f/\u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u0432\u0440\u0430\u0447\u043e\u043c.\n\n- \u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\n- \u041e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u043e \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0432 41\u043d\u0435\u0434\u0435\u043b\u044e 0\n- 4 \u0434\u043d\u044f \u0434\u043b\u044f \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f. \u0421\u043c \u041a\u041f \u00ab\u041f\u0435\u0440\u0435\u043d\u043e\u0448\u0435\u043d\u043d\u0430\u044f\n\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u00bb.\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: \u2212 \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0410\u0414, \u043f\u0443\u043b\u044c\u0441\u0430;\n\u2212 \u041e\u0441\u043c\u043e\u0442\u0440 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439 (\u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u043e\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435\n\u0432\u0435\u043d);\n\n\u2212 \u041d\u0430\u0440\u0443\u0436\u043d\u043e\u0435 \u0430\u043a\u0443\u0448\u0435\u0440\u0441\u043a\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\n\u043f\u043b\u043e\u0434\u0430);\n\u2212 \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u0442\u044b \u0434\u043d\u0430 \u043c\u0430\u0442\u043a\u0438 (\u0430\u043d\u0430\u043b\u0438\u0437\n\n\u0434\u0430\u043d\u043d\u044b\u0445 \u0432 \u0433\u0440\u0430\u0432\u0438\u0434\u043e\u0433\u0440\u0430\u043c\u043c\u0435);\n\u2212 \u0410\u0443\u0441\u043a\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0434\u0430.\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u2212 \u041e\u0410\u041c/\u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u043d\u0430 \u0431\u0435\u043b\u043e\u043a.\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n2) \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u0411\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u04