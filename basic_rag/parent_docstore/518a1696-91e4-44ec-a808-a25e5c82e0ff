30 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0430\u0442\u043e\u0447\u043d\u043e-\n\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u043d\u043e\u0433\u043e \u0441\u043e\u0443\u0441\u0442\u044c\u044f\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u0430\u0442\u043e\u0447\u043d\u0430\u044f 46,\u0425\u0425 \u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u043f\u043e\u043b\u043d\u0430\u044f \u0438 \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, HS, \u0440\u0430\u0441\u0441\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0430 \u043d\u0435\u043f\u043e\u043b\u043d\u0430\u044f \u0442\u0438\u043f \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u0430\u0442\u043e\u0447\u043d\u043e\u0439\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0438\n\u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0430\n\n\u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u043a\u0438 (\u0438 46,\u0425\u0425 \u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u043a\u0438, \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, HS, \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f\n\u0443\u0434\u0432\u043e\u0435\u043d\u0438\u0435 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430) \u0448\u0435\u0439\u043a\u0438 \u043c\u0430\u0442\u043a\u0438, \u0442\u0438\u043f \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439\n\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u0434\u0432\u0443\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u043a\u0430 46,\u0425\u0425 \u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u0434\u0432\u0443\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u043a\u0430, \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, HS,\n\u0435\u0434\u0438\u043d\u0430\u044f \u0448\u0435\u0439\u043a\u0430 \u0438 \u0442\u0438\u043f \u043c\u0435\u0442\u0440\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u043f\u043e\n\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0435 \u0428\u0442\u0440\u0430\u0441\u0441\u043c\u0430\u043d\u0443(\u043f\u0440\u0438\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0430\n\u043e\u0442 \u0442\u0435\u0440\u0430\u043f\u0438\u0438)\n\u043e\u0434\u043d\u043e\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u043a\u0430, \u0441 46,\u0425\u0425 \u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u043e\u0434\u043d\u043e\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u043a\u0430, \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435\n\u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u043c \u0441 \u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u043c \u0442\u0438\u043f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e\n\n\u0440\u043e\u0433\u043e\u043c \u0440\u043e\u0433\u043e\u043c \u043c\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0440\u043e\u0433\u0430\n\n\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f 46,\u0425\u0425 \u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u043c\u0430\u0442\u043a\u0430 \u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0430\u044f \u0444\u0435\u043c\u0438\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f \u043a\u043e\u0440\u044b \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432 \u0432\u0438\u0440\u0438\u043b\u0438\u0437\u0430\u0446\u0438 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432,\n(\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0438 \u0438\u043d\u0442\u0440\u043e\u0438\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430\n\u0430\u0434\u0440\u0435\u043d\u043e\u0433\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e Prader\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c),\n\u043d\u0435\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432\u0430\u044f\n\u0432\u0438\u0440\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f\n\u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0432\u044b\u0445\n\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c 45,\u0425 \u0424\u0438\u0431\u0440\u043e\u0437\u043d\u044b \u043c\u0430\u0442\u043a\u0430 \u0438 \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, \u0431\u0438\u043e\u043f\u0441\u0438\u044f \u0433\u043e\u043d\u0430\u0434,\n\u0428\u0435\u0440\u0435\u0448\u0435\u0432\u0441\u043a\u043e\u0433\u043e\u2013 \u0439 \u0442\u044f\u0436 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0435 \u0442\u0438\u043f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043d\u0435\u043e\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\n\u0422\u0435\u0440\u043d\u0435\u0440\u0430, (sreak) \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442, \u0430\n\u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438\u044f\u0433\u043e\u043d\u0430\u0434 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c\n(45,\u0425) \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435\n\u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u044b\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c 45,\u0425/46,\u0425 \u0424\u0438\u0431\u0440\u043e\u0437\u043d\u044b \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, \u0431\u0438\u043e\u043f\u0441\u0438\u044f \u0433\u043e\u043d\u0430\u0434,\n\u0428\u0435\u0440\u0435\u0448\u0435\u0432\u0441\u043a\u043e\u0433\u043e\u2013 \u0425 \u0439 \u0442\u044f\u0436 \u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u044b (\u0432 \u0442\u0438\u043f \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0445\n\u0422\u0435\u0440\u043d\u0435\u0440\u0430, (Streak), \u0432\u0438\u0434\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u043e\u0432, \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\n\u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438\u044f\u0433\u043e\u043d\u0430\u0434 \u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0442\u0438 \u0442\u044f\u0436\u0435\u0439, \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 \u043f\u043e\n(45,\u0425/46,\u0425\u0425) \u0447\u043d\u044b\u0435 \u0441 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u044f\u0438\u0447\u043d\u0438\u043a\u0438 \u2013 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u044e\u0449\u0435 \u0434\u043e\u043d\u0430\u0446\u0438\u044f \u043e\u043e\u0446\u0438\u0442\u043e\u0432 \u0432\n\u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d \u044d\u043d\u0434\u043e\u043c\u0435\u0442\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0443\u0440\u0440\u043e\u0433\u0430\u0442\u043d\u043e\u0433\u043e\n\n\u044b\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u044c\u044e), \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u0442\u0432\u0430\n\u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u0430\u044f\n\u0433\u0435\u043d\u0435\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0438 \u0440\u043e\u0434\u044b\n\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043c\u0430\u0442\u043a\u0438 \u0438\n\u043