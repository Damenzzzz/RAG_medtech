u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0439\u0442\u0438 \u0442\u0435\u0441\u0442 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0439\u0442\u0438\n\u0447\u0435\u0440\u0435\u0437 3 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044e\n\u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0440\u0438\u0441\u043a\u0430 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\n\n\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0412\u0418\u0427-\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\n2.3 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u0421\u0445\u043e\u0434\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u041e\u0442\u043b\u0438\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0442\u0435\u0441\u0442\u044b\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\n\u0418\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u041b\u0438\u043c\u0444\u043e\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043d\u0435 \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u0441\u0442 \u041f\u0430\u0443\u043b\u044f-\n\u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u043e\u0437 \u0430\u043d\u0433\u0438\u043d\u0430, \u0431\u043e\u043b\u0435\u0435 1 \u043c\u0435\u0441., \u0411\u0443\u043d\u043d\u0435\u043b\u044f. \u0412 \u043a\u0440\u043e\u0432\u0438 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u044b \u0431\u043e\u043b\u0435\u0435 10%.\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432.\n\u041a\u0440\u0430\u0441\u043d\u0443\u0445\u0430 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u042d\u043f\u0438\u0434\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0410\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0432\u0438\u0440\u0443\u0441\u0443 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438 \u0432\n\u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u044b\u0445 \u043a\u0440\u0430\u0442\u043a\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u043c \u0442\u0438\u0442\u0440\u0435.\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432, \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432,\n\u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430 \u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e\n\u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u044b\u0435\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u044b.\n\u0422\u043e\u043a\u0441\u043e\u043f\u043b\u0430\u0437\u043c\u043e\u0437 \u042d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442, \u042d\u043f\u0438\u0434\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f (\u0418\u0424\u0410 IgM, IgG,\n\u043b\u0438\u043c\u0444\u043e\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0445\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u0438\u0442, \u0430\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u044c \u0430\u043d\u0442\u0438\u0442\u0435\u043b IgG), \u041f\u0426\u0420,\n\u0433\u0435\u043f\u0430\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u043a\u0430\u043b\u044c\u0446\u0438\u0444\u0438\u043a\u0430\u0442\u044b \u0432 \u041a\u0422/\u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430\n\u0436\u0435\u043b\u0442\u0443\u0445\u0430, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430. \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c \u043c\u043e\u0437\u0433\u0435,\n\u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f.\n\u041e\u0441\u0442\u0440\u044b\u0439 \u041c\u0435\u043d\u0438\u043d\u0433\u0435\u0430\u043b\u044c\u043d\u044b\u0439, \u042d\u043f\u0438\u0434\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0431\u043e\u043b\u0435\u0435 \u041c\u0438\u043a\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u044f, \u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f,\n\u043c\u0435\u043d\u0438\u043d\u0433\u043e\u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0447\u0435\u0442\u043a\u043e \u043e\u0447\u0435\u0440\u0447\u0435\u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u044f,\n(\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439, \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430, \u0438\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d\u0442\u043d\u044b\u0439\n\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u043e\u043f\u043e\u0434\u043e\u0431\u043d \u043f\u0440\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438). \u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043d\u0435\u043c\u0435\u043d\u0438\u043d\u0433\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u044b\u0445\n\u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442\u0430\u0445 \u2014\n\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0447\u0430\u0433\u043e\u0432\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438.\n\u0410\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u042d\u043f\u0438\u0434\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u043e\u0441\u0442\u0440\u043e\u0435 \u0412\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u044f, \u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0441\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043d\u0430\u0437\u043e\u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442, \u0442\u0435\u0447\u0435\u043d\u0438\u0435, \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\u043c \u0442\u0438\u0442\u0440\u0430 \u0410\u0422,\n\u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0438\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d\u0442\u043d\u043e\u0435\n\u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435, \u0433\u0435\u043c\u043e\u0433\u0440\u0430\u043c\u043c\u0430.\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432\n\u042d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430, \u0413\u0435\u0440\u043f\u0430\u043d\u0433\u0438\u043d\u0430, \u0434\u0438\u0430\u0440\u0435\u044f, \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f \u0432 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u043c\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u044f, \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442 \u043c\u0435\u043d\u0435\u0435 \u0442\u0438\u0442\u0440\u0435.\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u044b\u0440\u0430\u0436\u0435\u043d.\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442.\n\u0421\u0435\u043f\u0441\u0438\u0441 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0438\u0437\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u043e\u0447\u0430\u0433\u0430 (\u043a\u043e\u0436\u0430, \u043b\u0435\u0433\u043a\u0438\u0435, \u043a\u0440\u043e\u0432\u0438 \u0438 \u0434\u0440. \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430,\n\u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a \u0438 \u0434\u0440.) \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0418\u0424\u0410 \u043d\u0430 \u0412\u0418\u0427,\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439, \u0433\u0438\u043f\u043e\u0433\u0430\u043c\u043c\u0430\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0435\u043c\u0438\u044f,\n\u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430, \u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0421D4.\n\u043e\u0442\u0438\u0442, \u0441\u0438\u043d\u0443\u0441\u0438\u0442,\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438.\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430, \u0421\u0432\u044f\u0437\u044c \u0441 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u043c \u041c\u0430\u0440\u043a\u0435\u0440\u044b \u0412\u0413 (\u0410, \u0412, \u0421, \u0414) \u0432\n\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438, \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c, \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438, \u041f\u0426\u0420,\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438, \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0421D8, \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0421D4\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u044f, \u0436\u0435\u043b\u0442\u0443\u0445\u0430. \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439.\n\u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0435\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430.\n\n\u041a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u0414\u0438\u0430\u0440\u0435\u044f, \u043f\u043e\u0442\u0435\u0440\u044f \u043c\u0430\u0441\u0441\u044b, \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u041f\u043e\u0441\u0435\u0432\u044b \u043a\u0430\u043b\u0430, \u043a\u0440\u043e\u0432\u0438, \u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0444\u043e\u0440\u043c\u044b \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442\u0441\u044f (\u0420\u041f\u0413\u0410)\n\u0441\u0430\u043b\u044c\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u0434\u0435\u0442\u0435\u0439 \u043f\u0435\u0440\u0432\u044b\u0445\n(\u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0447\u0430\u0433\u043e\u0432 \u0432 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0436\u0438\u0437\u043d\u0438\n\u0444\u043e\u0440\u043c\u0430). \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0430\u0445 \u041f\u0440\u0435\u043c\u043e\u0440\u0431\u0438\u0434\u043d\u044b\u0439 \u0444\u043e\u043d\n(\u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442, \u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d, \u0447\u0430\u0449\u0435\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f) \u0432\u043d\u0443\u0442\u0440\u0438\u0431\u043e\u043b\u044c\u043d\u0438\u0447\u043d\u0430\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\n\u0413\u043b\u0438\u0441\u0442\u043d\u044b\u0435 \u0438\u043d\u0432\u0430\u0437\u0438\u0438. \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430, \u042d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u044f, \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043b\u0438\u0447\u0438\u043d\u043e\u043a\n\u0432\u044f\u043b\u043e\u0441\u0442\u044c, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0433\u0435\u043b\u044c\u043c\u0438\u043d\u0442\u043e\u0432 \u0432 \u043a\u0430\u043b\u0435,\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u0434\u0438\u0430\u0440\u0435\u044f, \u043c\u0430\u043b\u044c\u0430\u0431\u0441\u043e\u0440\u0431\u0446\u0438\u0438 \u043d\u0435 \u0434\u0443\u043e\u0434\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u043c,\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435\u043d. \u043c\u043e\u043a\u0440\u043e\u0442\u0435, \u043c\u043e\u0447\u0435.\n\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u041f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u044f, \u042d\u043f\u0438\u0434\u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u044f \u2014 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 \u041c\u0411\u0422 \u0438\u0437 \u043c\u043e\u043a\u0440\u043e\u0442\u044b, \u0434\u0440\u0443\u0433\u0438\u0445\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445, \u0432 \u043b\u0435\u0433\u043a\u0438\u0445 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0435\u0439,\n\u0426\u041d\u0421, \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0442\u043a\u0430\u043d\u0435\u0439, Xpert\n\u043f\u043e\u0442\u0435\u0440\u044f \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, MTB/RIF, \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445 (\u043e\u0447\u0430\u0433\u0438,\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u0432\u0435\u0440\u043d\u044b).\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c.\n\u042d\u043f\u0438\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u041f\u0440\u0438 \u044d\u043f\u0438\u0434\u043f\u0430\u0440\u043e\u0442\u0438\u0442\u0435: \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u043f\u0430\u0440\u043e\u0442\u0438\u0442 \u0438 \u043f\u0430\u0440\u043e\u0442\u0438\u0442\u044b \u043e\u043a\u043e\u043b\u043e\u0443\u0448\u043d\u044b\u0445 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043e\u0441\u0442\u0440\u043e, \u0441 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\u043c \u0442\u0438\u0442\u0440\u0430 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\n\u0434\u0440\u0443\u0433\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438. \u0441\u043b\u044e\u043d\u043d\u044b\u0445 \u0436\u0435\u043b\u0435\u0437 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 (\u0420\u041d\u0413\u0410). \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0434\u043d\u0435\u0439, \u043c\u043e\u0433\u0443\u0442 \u043c\u0435\u0442\u043e\u0434\u044b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\u0432\u043e\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f \u0434\u0440\u0443\u0433\u0438\u0435\n\u0441\u043b\u044e\u043d\u043d\u044b\u0435 \u0436\u0435\u043b\u0435\u0437\u044b,\n\u043e\u0440\u0445\u0438\u0442\u044b, \u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442\u044b.\n\u041f\u0440\u0438 \u043e\u043f\u0443\u0445\u043e\u043b\u0438,\n\u0441\u043b\u044e\u043d\u043e\u043a\u0430\u043c\u0435\u043d\u043d\u043e\u0439\n\u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u2014 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\n\u043e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0439.\nIII. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [3 - 10]:\n\u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0410\u0420\u0422 \u2013 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439, \u043d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u0445\u0435\u043c\u0430\n\n\u0441 \u0434\u0432\u0443\u043c\u044f \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430 \u0410\u0420\u0412 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442\n\u0444\u043e\u0440\u043c\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430. \u041f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u0435 \u043e\u0442\u0434\u0430\u0435\u0442\u0441\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c \u0432\n\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430\u0445 \u0441 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u044b\u043c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u043c \u043f\u0440\u0438\u0435\u043c\u043e\u043c.\n\u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0410\u0420\u0422 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043e\u0446\u0435\u043d\u043a\u0430 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0438 \u0412\u0418\u0427-\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043a \u043d\u0430\u0447\u0430\u043b\u0443 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044e \u0410\u0420\u0422, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044e 3 \u043a \u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443.\n\u0412\u0441\u0435 \u043b\u044e\u0434\u0438, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d \u0412\u0418\u0427, \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0439\u0442\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435\n\u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0412\u0418\u0427-\u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0410\u0420\u0422, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f\n\u0442\u0435 \u0436\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0420\u0435\u0436\u0438\u043c, \u0434\u0438\u0435\u0442\u0430: \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c \u0438 \u043e\u0440\u0433\u0430\u043d\u043e\u0432.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u0410\u0420\u0422 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u0441\u0442\u0430\u0434\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u043a\u043b\u0435\u0442\u043e\u043a CD4, \u043d\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 7 \u0434\u043d\u0435\u0439 \u043e\u0442\n\u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430.\n\u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 APT \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0430\u043d\u0430\u043b\u0438\u0437 \u043d\u0430 \u0433\u0435\u043d\u043e\u0442\u0438\u043f\u0438\u0447\u0435\u0441\u043a\u0443\u044e\n\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u044c, \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0412\u0418\u0427.", "type": "Document"}}