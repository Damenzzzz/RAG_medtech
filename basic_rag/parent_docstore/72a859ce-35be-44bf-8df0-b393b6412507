3b\u044c\u043c\u043e\u043b\u043e\u0433\u0430,\n\n\u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0430.\n\u041f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442 \u2022 \u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u2022 \u0431\u043e\u043b\u0435\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c;\n\u2022 \u0411\u0410\u041a: \u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u2022 \u0441\u0442\u0435\u0430\u0442\u043e\u0440\u0435\u044f, \u043a\u0440\u0435\u0430\u0442\u043e\u0440\u0435\u044f;\n\u0430\u043c\u0438\u043b\u0430\u0437\u0430, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u044b; \u2022 \u043d\u0430 \u0423\u0417\u0418/\u041c\u0420\u0422 \u041e\u0411\u041f: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n\n\u2022 \u0434\u0438\u0430\u0441\u0442\u0430\u0437\u0430 \u043c\u043e\u0447\u0438; \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0438\u0441\u0442,\n\u2022 \u044d\u043b\u0430\u0441\u0442\u0430\u0437\u0430 \u043a\u0430\u043b\u0430; \u043a\u0430\u043b\u044c\u0446\u0438\u043d\u0430\u0442\u043e\u0432, \u0413\u041f\u041f \u0431\u043e\u043b\u0435\u0435 2 \u0441\u043c,\n\u2022 \u043a\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430; \u0433\u0435\u0442\u0435\u0440\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b \u041f\u0416,\n\u2022 \u0423\u0417\u0418 \u041e\u0411\u041f; \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0435\u043d\u043a\u0438\n\n\u2022 \u041c\u0420\u0422 \u041e\u0411\u041f. \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u0432, \u043d\u0435\u0440\u043e\u0432\u043d\u043e\u0441\u0442\u044c\n\u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432.\n\