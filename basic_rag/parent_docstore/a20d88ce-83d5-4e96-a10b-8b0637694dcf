e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\n8. \u043b\u0438\u043f\u0438\u0434\u043d\u044b\u0439 \u0441\u043f\u0435\u043a\u0442\u0440 2 \u0440\u0430\u0437\u0430 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 5-7 \u0434\u043d\u0435\u0439,\n\u043a\u0440\u043e\u0432\u0438: \u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d, \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0425\u041b\u0412\u041f, \u0425\u041b\u041d\u041f, \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0442\u0440\u0438\u0433\u043b\u0438\u0446\u0435\u0440\u0438\u0434\u044b \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n9. \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438 \u043d\u0430\u0442\u043e\u0449\u0430\u043a, \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0433\u043b\u0438\u043a\u043e\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\n\u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\n10. \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0437\u0430: \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0410\u0427\u0422\u0412, \u041f\u0412, \u041c\u041d\u041e, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0444\u0438\u0431\u0440\u0438\u043d\u043e\u0433\u0435\u043d \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\n11. \u043a\u043b\u0438\u0440\u0435\u043d\u0441 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430, 2 \u0440\u0430\u0437\u0430 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 5-7 \u0434\u043d\u0435\u0439,\n\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u043e\u0432\u043e\u0439 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\n12. \u0433\u043e\u0440\u043c\u043e\u043d\u044b \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0436\u0435\u043b\u0435\u0437\u044b: \u0422\u0422\u0413, \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0439 \u04224, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\n\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0439 \u04223, \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\u0410\u0422\u043a\u0422\u041f\u041e\n13. \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u042d\u0431\u0448\u0442\u0435\u0439\u043d-\u0411\u0430\u0440\u0440- \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n(IgM, IgG) \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n12. \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0433\u0435\u0440\u043f\u0435\u0441-\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 (anti-HSV1 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\nIgM \u0438 anti-HSV2 IgM) \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n13. \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0432\u0430\u0440\u0438\u0446\u0435\u043b\u043b\u0430-\u0437\u043e\u0441\u0442\u0435\u0440- \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n(anti-VZV IgM \u0438 anti- \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\nVZV IgG)\n14. \u0442\u0435\u0441\u0442\u044b \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\n\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0433\u043e \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n(HBsAg, anti-HBs, anti- \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\nHBcore) \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n15. \u0442\u0435\u0441\u0442\u044b \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0433\u043e \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0421 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n(anti-HCV) \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n16. \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0442\u043e\u043a\u0441\u043e\u043f\u043b\u0430\u0437\u043c\u043e\u0437\u0430 (IgM, \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\nIgG) \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n17. \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0446\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 (IgM, IgG) \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n1. \u0430\u043d\u0442\u0440\u043e\u043f\u043e\u043c\u0435\u0442\u0440\u0438\u044f 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438, \u043f\u0440\u0438\n(\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 (\u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438)\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430) \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0432\u0435\u0441\u0430 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\n\n2. \u0442\u0435\u0441\u0442 6 \u043c\u0438\u043d\u0443\u0442\u043d\u043e\u0439 2 \u0440\u0430\u0437\u0430 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 5-7 \u0434\u043d\u0435\u0439,\n\u0445\u043e\u0434\u044c\u0431\u044b; \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n\n3. \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f; \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\n\n4. \u044d\u0445\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f 1. \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0432 \u043f\u0440\u0438 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\n(\u0442\u0440\u0430\u043d\u0441\u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u0430\u044f); \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043c\u0435\u0436\u0434\u0443 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u043c\u0438\n\u0440\u0435\u0430\u043a\u0446\u0438\u0438 3-5 \u0434\u043d\u0435\u0439.\n\u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f;\n2. 2-3 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u043b\u0443\u0447\u0430\u0435\n\n\u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n5. \u044d\u043d\u0434\u043e\u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u0430\u044f 1 \u0440\u0430\u0437 \u043f\u0440\u0438 1-2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043a\u0446\u0438\u0438\n\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u0432 1\n\u043d\u0435\u0434\u0435\u043b\u044e\n6. \u0445\u043e\u043b\u0442\u0435\u0440\u043e\u0432\u0441\u043a\u043e\u0435 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u042d\u041a\u0413; \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n7. \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0435 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f; \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439;\n7. \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\n\u043a\u043b\u0435\u0442\u043a\u0438 (\u0432 2 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u043f\u0440\u043e\u0435\u043a\u0446\u0438\u044f\u0445); \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432 \u043f\u0440\u044f\u043c\u043e\u0439\n\u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438\n8. \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044f; 1 \u0440\u0430\u0437 \u0441 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\n6 \u043b\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\n9. \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 1 \u0440\u0430\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043b\u0438\u0431\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\n\n10.5 \u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u044b\u0435 \u043d\u0430\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435:\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u2022 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0430\u043b\u0430 \u043d\u0430 \u0441\u043a\u0440\u044b\u0442\u0443\u044e \u043a\u0440\u043e\u0432\u044c;\n\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0447\u0438 \u043d\u0430 \u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u0438 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u043e-\n\u0430\u043d\u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u044b;\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u043a\u0440\u043e\u0442\u044b \u043d\u0430 \u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u0438 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u043e-\n\n\u0430\u043d\u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u044b;\n\u2022 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439;\n\n\u2022 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 (\u0438\u043c\u043c\u0443\u043d\u043e\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0438\u043b\u0438 (\u043f\u043e\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u2013 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420): \u0442\u0435\u0441\u0442 \u043d\u0430 \u043c\u0430\u0440\u043a\u0435\u0440\u044b \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 (HIVAg/anti-HIV),\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439 \u043d\u0430 \u0441\u0438\u0444\u0438\u043b\u0438\u0441;\n\u2022 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u043a\u0440\u043e\u0442\u044b \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 M. tuberculosis \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420.\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u044b\u0445\n\u043d\u0430 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435:\n\u2022 \u0441\u043f\u0438\u0440\u043e\u044d\u0440\u0433\u043e\u043c\u0435\u0442\u0440\u0438\u044f (\u0438\u043b\u0438 \u0442\u0440\u0435\u0434\u043c\u0438\u043b-\u0442\u0435\u0441\u0442);\n\n\u2022 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f (\u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e-\u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f) \u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e\n\u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430, \u0430\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430, \u0433\u043e\u043b\u043e\u0432\u044b;\n\u2022 \u0447\u0440\u0435\u0437\u043f\u0438\u0449\u0435\u0432\u043e\u0434\u043d\u0430\u044f \u044d\u0445\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f;\n\n\u2022 \u0441\u0442\u0440\u0435\u0441\u0441 \u042d\u0425\u041e\u041a\u0413 \u0441 \u0434\u043e\u0431\u0443\u0442\u0430\u043c\u0438\u043d\u043e\u043c \u2013 \u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0432\u0430\u0441\u043a\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438 \u0430\u043b\u043b\u043e\u0433\u0440\u0430\u0444\u0442\u0430\n(14);\n\u2022 \u0444\u0438\u0431\u0440\u043e\u0433\u0430\u0441\u0442\u0440\u043e\u0434\u0443\u043e\u0434\u0435\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f;\n\u2022 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b;", "type": "Document"}}