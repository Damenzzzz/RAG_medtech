0430 \u2013 \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430 \u0413\u041a\u041f \u043d\u0430 \u041f\u0425\u0412\n\u00ab\u0413\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439 \u043f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440\u00bb \u0433. \u0410\u043b\u043c\u0430\u0442\u044b, \u0432\u0440\u0430\u0447 \u0430\u043a\u0443\u0448\u0435\u0440-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439\n\u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.\n2) \u0418\u0441\u0435\u043d\u043e\u0432\u0430 \u0421\u0430\u0443\u043b\u0435 \u0428\u0430\u0439\u043a\u0435\u043d\u043e\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439\n\n\u0430\u043a\u0443\u0448\u0435\u0440\u0441\u0442\u0432\u0430 \u0438 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0438 No2 \u041d\u0410\u041e \u00ab\u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u00bb,\n\u0430\u043a\u0443\u0448\u0435\u0440-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.\n\n6.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441