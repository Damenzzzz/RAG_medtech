u0432 \u0438\u043b\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\n\u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e \u0441 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\u0438 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u0430\u043c\u0438 \u0432 \u043b\u0435\u0433\u043a\u0438\u0445 \u0438/\u0438\u043b\u0438\n\u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0425\u0413\u0427.\n\u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\u2022 \u041f\u042d\u0422 \u041a\u0422 \u0432\u0441\u0435\u0433\u043e \u0442\u0435\u043b\u0430 \u2013 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u043c\u0438\u043d\u043e\u043c\u043e\u0439 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\n\u043b\u044e\u0431\u044b\u0445 \u0440\u0435\u0437\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0447\u0435\u0440\u0435\u0437 4-6 \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f\n\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 (\u0447\u0435\u0440\u0435\u0437 3 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u043b\u0443\u0447\u0435\u0432\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438) \u0441 \u0446\u0435\u043b\u044c\u044e\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u