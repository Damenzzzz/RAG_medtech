 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0438\u043d\u043e\u0432\u044b\u0435\n\u043f\u0440\u043e\u0431\u044b \u0441 \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430. \u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0438\u043d\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u0431 (\u0440\u0435\u0430\u043a\u0446\u0438\u044f \u041c\u0430\u043d\u0442\u0443) \u0438 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0441 \u0446\u0435\u043b\u044c\u044e\n\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 1 \u0440\u0430\u0437 \u0432 6 \u043c\u0435\u0441 (\u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0435\u0441\u043b\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b \u043f\u043b\u0430\u043d\u043e\u0432\u0443\u044e \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u0432\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440.\n(\u041f\u0440\u0438\u043a\u0430\u0437 No33 \u043e\u0442 12.01.2012\u0433. \u0421\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u00ab\u0421\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e-\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u