\u0438\u043f\u0438\u0447\u043d\u044b\u0435\n\u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u044b \u0431\u043e\u043b\u0435\u0435\n10%.\n\n\u0421\u0442\u0440\u0435\u043f\u0442\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u044b\u0435/ \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041d\u0435\u0442 \u0412 \u043a\u0440\u043e\u0432\u0438 \u2013\n\u0441\u0442\u0430\u0444\u0438\u043b\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u044b\u0435 \u043b\u0438\u043c\u0444\u043e\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439\n\u0430\u043d\u0433\u0438\u043d\u044b \u0430\u043d\u0433\u0438\u043d\u0430. \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u0441\u044b\u043f\u0438 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437,\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438. \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b.\n\n\u041a\u0440\u0430\u0441\u043d\u0443\u0445\u0430 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u044b\u0445 \u041f\u043e\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e IgM \u043a \u0432\u0438\u0440\u0443\u0441\u0443 \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430 \u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u044b\u0435 \u0418\u0424\u0410.\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u044b,\n\n14\n\n\u043d\u0435\u0442\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430,\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438.\n\n\u041b\u0438\u0441\u0442\u0435\u0440\u0438\u043e\u0437 \u0410\u043d\u0433\u0438\u043d\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b,\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f,\u043f\u0438\u0435\u043b\u043e\u043d\u0435\u0444\u0440\u0438\u0442, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u041f\u0426\u0420,\n\u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u043b\u043e\u0436\u043d\u043e. IgM \u0438\u043b\u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u043a\u043e\u0436\u0438, \u041d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e \u0443\u0440\u043e\u0432\u043d\u044f IgG \u043a \u043b\u0438\u0441\u0442\u0435\u0440\u0438\u044f\u043c\n\u0433\u043b\u0430\u0437, \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432 \u0418\u0424\u0410.\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430. \u0421\u044b\u043f\u044c \u2013\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0436\u0435\u043b\u0442\u0443\u0445\u0430. \u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u043e-\n\u043f\u0443\u0441\u0442\u0443\u043b\u0435\u0437\u043d\u0430\u044f.\n\n\u041e\u0441\u0442\u0440\u044b\u0439 \u041c\u0435\u043d\u0438\u043d\u0433\u0435\u0430\u043b\u044c\u043d\u044b\u0439, \u041d\u0435\u0442 \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b,\n\u043c\u0435\u043d\u0438\u043d\u0433\u043e\u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u041f\u0426\u0420, IgM \u0438\u043b\u0438\n(\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f IgG \u043a\n\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u0438, \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f\u043c \u0432 \u0418\u0424\u0410,\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438). \u0441\u044b\u043f\u0438, \u0420\u041d\u0418\u0424.\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438\n\n\u0410\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u044f, \u041f\u0426\u0420, IgM\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043d\u0430\u0437\u043e\u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043b\u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f\n\u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f \u0441\u043b\u043e\u0436\u043d\u043e. IgG \u043a \u0430\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u0430\u043c \u0432\n\u041d\u0435\u0442 \u0418\u0424\u0410, \u0420\u041d\u0418\u0424.\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u0441\u044b\u043f\u0438,\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438\n\n\u042d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u044f, \u041f\u0426\u0420, IgM\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u043b\u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f\n\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u043b\u043e\u0436\u043d\u043e. IgG \u043a \u0430\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u0430\u043c \u0432\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442. \u0418\u0424\u0410, \u0420\u041d\u0418\u0424.\n\n\u0421\u0435\u043f\u0441\u0438\u0441 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412 \u043a\u0440\u043e\u0432\u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437, \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u043e\u0436\u043d\u043e. \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0438\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430, \u043e\u0447\u0430\u0433\u043e\u0432 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u041f\u0426\u0420,\n\u043c\u0435\u043d\u0438\u043d\u0433\u0438\u0442, \u043e\u0442\u0438\u0442, \u0441\u0438\u043d\u0443\u0441\u0438\u0442, \u0418\u0424\u0410, \u0420\u041d\u0418\u0424.\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438.\n\n\u0412\u0438\u0440\u0443\u0441\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430, \u041d\u0435\u0442 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438 \u043d\u0430 \u041c\u0430\u0440\u043a\u0435\u0440\u044b \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438, \u0444\u043e\u043d\u0435 \u0436\u0435\u043b\u0442\u0443\u0445\u0438, \u043d\u0435\u0442 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u0432 (\u0410, \u0412, \u0421, \u0414, \u0415)\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438, \u0436\u0435\u043b\u0442\u0443\u0445\u0430. \u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438, \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438.\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u0438,\n\u0441\u044b\u043f\u0438\n\n\u0421\u0430\u043b\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437. \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b,\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u0431\u043e\u043b\u0438 \u0432 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u041f\u0426\u0420, IgM \u0438\u043b\u0438\n\u0436\u0438\u0432\u043e\u0442\u0435, \u0434\u0438\u0430\u0440\u0435\u044f, \u0441\u043b\u0438\u0437\u044c \u0432 \u0441\u043b\u043e\u0436\u043d\u043e. \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f IgG \u043a\n\u0441\u0442\u0443\u043b\u0435, \u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430, \u041d\u0435\u0442 \u0441\u0430\u043b\u043c\u043e\u043d\u0435\u043b\u043b\u0430\u043c \u0432 \u0418\u0424\u0410,\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438, \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u0438, \u0420\u041f\u0413\u0410.\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438. \u0441\u044b\u043f\u0438,\n\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438.\n15\n\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041d\u0435\u0442 \u0412 \u043a\u0440\u043e\u0432\u0438 \u2013\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438. \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0433\u0435\u043f\u0430\u0442\u043e\u0434\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438. \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437, \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u0438, \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b \u0438\u0437 \u043c\u043e\u043a\u0440\u043e\u0442\u044b,\n\u0441\u044b\u043f\u0438, \u043a\u0440\u043e\u0432\u0438, \u041f\u0426\u0420, IgM \u0438\u043b\u0438\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u0438. \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f IgG \u043a\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f\u043c\u043c \u0432 \u0418\u0424\u0410,\n\u0420\u041d\u0418\u0424.\n\n\u0418\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u044b \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b,\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f, \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u041f\u0426\u0420, IgM \u0438\u043b\u0438\n\u0433\u0435\u043f\u0430\u0442\u043e\u0434\u0438\u0435\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f IgG \u043a\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u044f\u043c \u0432 \u0418\u0424\u0410,\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0441\u044b\u043f\u0438, \u0420\u041f\u0413\u0410, \u0420\u041d\u0418\u0424.\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u044c.\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [34]: \u043d\u0430\n\u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u043f\u0440\u0438 \u043b\u0435\u0433\u043a\u043e\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438\n\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u0444\u043e\u0440\u043c \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0435\u0433\u043e\n\u0442\u0435\u0447\u0435\u043d\u0438\u0438.\n\u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043d\u0430\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432 \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u043c \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u0438 \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\n\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u041f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u2013 \u0434\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b;\n\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u043e\u0431\u0449\u0438\u0439 \u0441\u0442\u043e\u043b (No 15), \u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0442\u044c\u0451. \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 (\u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u043a \u0438 \u0434\u0440.) \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u0434\u0438\u0435\u0442\u0443.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u042d\u0442\u0438\u043e\u0442\u0440\u043e\u043f\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f. \u042d\u0442\u0438\u043e\u0442\u0440\u043e\u043f\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0431\u043e\u0440\u0430 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430\n\u0434\u043b\u044f \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e-\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\u041f\u0440\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043f\u043e\u043b\u0438\u043a\u043b\u0438\u043d\u0438\u043a\u0438 \u0446\u0435\u043b\u0435\u0441\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u043e\u0434\u0438\u043d \u0438\u0437\n\n\u043d\u0438\u0436\u0435\u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432:\n\u2022 \u0446\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u0432\u043d\u0443\u0442\u0440\u044c 500 \u043c\u0433 2 \u0440\u0430\u0437\u0430, 7-10 \u0434\u043d\u0435\u0439 \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u044b;\n\u2022 \u0446\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c \u0432\u043d\u0443\u0442\u0440\u044c 0,5-1 \u0433/\u0441\u0443\u0442 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430, 7-10 \u0434\u043d\u0435\u0439 \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0435\n\u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b;\n\n\u2022 \u0430\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442 \u0432\u043d\u0443\u0442\u0440\u044c \u043f\u043e 0,375- 0,625 \u0433 \u0447\u0435\u0440\u0435\u0437 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 7-10\n\u0434\u043d\u0435\u0439 \u0438\u043b\u0438 \u0430\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d \u0432\\\u043c 1,0 \u0433. 4 \u0440\u0430\u0437\u0430 \u0432\\\u043c, 7-10 \u0434\u043d\u0435\u0439.\n\u0412 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0446\u0435\u043b\u0435\u0441\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u043c\u044b\u0435 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e.\n\n\u041f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\u2022 \u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u043f\u0438\u0442\u044c\u0435-\u0434\u043e 2,5-3,0 \u0432 \u0441\u0443\u0442\u043a\u0438;\n\n16\n\n\u041f\u0440\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0435 - \u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b,\n\n\u043e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0436\u0435\u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1-3 \u0434\u043d\u0435\u0439:\n\u2022 \u0430\u0446\u0435\u0442\u0430\u043c\u0438\u043d\u043e\u0444\u0435\u043d 500 \u043c\u0433, \u0432\u043d\u0443\u0442\u0440\u044c;\n\n\u0414\u0435\u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043e\u0434\u0438\u043d \u0438\u0437 \u043d\u0438\u0436\u0435\u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3-5\n\u0434\u043d\u0435\u0439:\n\u2022 \u0446\u0435\u0442\u0438\u0440\u0438\u0437\u0438\u043d \u0432\u043d\u0443\u0442\u0440\u044c \u043f\u043e 0,005-0,01 \u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438;\n\u2022 \u043b\u043e\u0440\u0430\u0442\u0430\u0434\u0438\u043d \u043f\u043e 0,01 \u0433 \u0432\u043d\u0443\u0442\u0440\u044c 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\u2022 \u043f\u0440\u0438 \u0430\u043d\u0433\u0438\u043d\u043e\u0437\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 - \u043f\u043e\u043b\u043e\u0441\u043a\u0430\u043d\u0438\u0435 \u0433\u043e\u0440\u043b\u0430 \u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0438\u043c\u0438 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\u043c\u0438;\n\n\u2022 \u043f\u0440\u0438 \u043a\u043e\u0436\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 \u2013 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0445 \u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0445 \u043a\u043e\u0436\u043d\u044b\u0445 \u0430\u0444\u0444\u0435\u043a\u0442\u043e\u0432\n\u0431\u0440\u0438\u043b\u043b\u0438\u0430\u043d\u0442\u043e\u0432\u044b\u043c \u0437\u0435\u043b\u0435\u043d\u044b\u043c 1% \u0441\u043f\u0438\u0440\u0442\u043e\u0432\u044b\u043c \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u043e\u043c.\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.4 \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u0441\u0442\u043e\u0439\u043a\u0430\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0442\u0435\u043b\u0430;\n\u2022 \u0440\u0435\u0433\u0440\u0435\u0441\u0441 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418:\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:", "type": "Document"}}