043e\u043b\u0435\u0435 1,2 \u043c2 - \u043f\u043e 8 \u043c\u0433 3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u0430\u043d\u0442\u0438\u043c\u0438\u043c\u0435\u0442\u0438\u043a\u0438- \u043a\u0438\u0442\u0440\u0438\u043b 1-3 \u043c\u0433/\u0441\u0443\u0442, \u043d\u0430\u0432\u043e\u0431\u0430\u043d 1-5 \u043c\u0433\\\u0441\u0443\u0442 \u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u2013 0,2 \u043c\u0433/\u043a\u0433 \u2013 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434\u0430 + \u041d3-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440., \u0438\u043b\u0438 \u043c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d) \u0434\u043b\u044f \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430. \u0410\u043f\u0440\u0435\u043f\u0438\u0442\u0430\u043d\u0442 \u0438\u043b\u0438 \u0444\u043e\u0441\u0444\u0430\u043f\u0440\u0435\u043f\u0438\u0442\u0430\u043d\u0442 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430\u0445. \u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 \u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u043e\u0432\u044b\u0445 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u0438 (\u0