48\u0443\u044e\n\u044f\u0433\u043e\u0434\u0438\u0447\u043d\u0443\u044e \u043c\u044b\u0448\u0446\u0443,\n\u0440\u0430\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f 1% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u043e\u043c\n\u043b\u0438\u0434\u043e\u043a\u0430\u0438\u043d\u0430)\n\u0414\u0435\u0442\u044f\u043c \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 50 \u0442\u044b\u0441.\n\u0415\u0414 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c \u0434\u043e 2\n\u043b\u0435\u0442.\n\u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0421\u043c\u0435\u0441\u044c \u0431\u0435\u043d\u0437\u0430\u0442\u0438\u043d 1,8 \u043c\u043b\u043d.\u0415\u0414, \u0432/\u043c \u2013 \u0412\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u0431\u0435\u043d\u0437\u0438\u043b\u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u0430, 2 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0432\u044b\u0431\u043e\u0440\u0430\n\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0431\u0435\u043d\u0437\u0438\u043b\u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u0438 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u043d\u0430\u0442\u0440\u0438\u0435\u0432\u043e\u0439 (\u0438\u043b\u0438 \u0441\u0438\u0444\u0438\u043b\u0438\u0441\u0430\n\u0411\u0435\u0442\u0430-\u043b\u0430\u043a\u0442\u0430\u043c\u043d\u044b\u0435 \u043a\u0430\u043b\u0438\u0435\u0432\u043e\u0439) \u0441\u043e\u043b\u0438 \u0438 \u0414\u0435\u0442\u044f\u043c \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 50 \u0442\u044b\u0441.\n\