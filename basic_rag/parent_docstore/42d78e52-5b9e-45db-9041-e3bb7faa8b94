u0438\u044f\n\u0422\u0435\u0441\u0442 \u043d\u0430 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c (\u0422\u041b\u0427)\n\u041c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e-\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u0412 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u2013 \u043f\u043e\n\u043c\u0435\u0442\u043e\u0434 \u0437\u0430\u043f\u0440\u043e\u0441\u0443 \u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438\n\n\u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430\n\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u0423\u0417\u0418, \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422 \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0438/\u0438\u043b\u0438 \u041c\u0420\u0422 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e\n\n\u043e\u0440\u0433\u0430\u043d\u0430\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\n\u0418\u043d\u0434\u0435\u043a\u0441\u0430 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0441\u043c\u043e\u0442\u0440 \u0412 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0435: 3 \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e, \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u2013\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e.\n\u041d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u2013 \u043a\u0430\u0436\u0434\u044b\u0435 10 \u0434\u043d\u0435\u0439.\n\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0434\u0430\u043b\u0435\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u043f\u0440\u0438\n\u043f\u0430\u0440\u0435\u0441\u0442\u0435\u0437\u0438\u0438/\u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u043b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434\u0430 (\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438\n\u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438 (\u043a\u0430\u043c\u0435\u0440\u0442\u043e\u043d\u043e\u043c, \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0430)\n\n\u043c\u043e\u043b\u043e\u0442\u043e\u0447\u043a\u043e\u043c)\n\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0447\u0435\u0440\u0435\u0437 2 \u043d\u0435\u0434\u0435\u043b\u0438, \u0434\u0430\u043b\u0435\u0435 \u2013\n(\u0434\u0430\u043b\u0435\u0435 \u2013 \u042d\u041a\u0413) \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e, \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u2013 \u0447\u0430\u0449\u0435 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433\u0430)\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u0435\u0439 \u0438 \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u044d\u0442\u0430\u043c\u0431\u0443\u0442\u043e\u043b\u043e\u043c \u0438\u043b\u0438 \u043b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434\u043e\u043c.\n\n\u043e\u0441\u0442\u0440\u043e\u0442\u044b \u0437\u0440\u0435\u043d\u0438\u044f \u0438 \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f\u0445 \u043d\u0430\n\u0446\u0432\u0435\u0442\u043e\u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043e\u0441\u0442\u0440\u043e\u0442\u044b \u0437\u0440\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0446\u0432\u0435\u0442\u043e\u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f\n\u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435, \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0434\u0430\u043b\u0435\u0435 \u2013 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430 (\u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0430-\n\u043d\u0430\u0440\u043a\u043e\u043b\u043e\u0433\u0430 \u0438/\u0438\u043b\u0438\n\u043f\u0441\u0438\u0445\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0430) \u0438\u043b\u0438\n\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u0430\n\n\u0410\u0443\u0434\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u2013 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e,\n\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u0423\u0417\u0418, \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u041a\u0422 \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u043f\u043e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 1-2 \u043c\u0435\u0441\u044f\u0446\u0430,\n\u0438/\u0438\u043b\u0438 \u041c\u0420\u0422 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0430\u043b\u0435\u0435 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043e\u0440\u0433\u0430\u043d\u0430\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\n\n\u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0439 (\u0438\u043b\u0438\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0439)\n\u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438 \u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\n\n\u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u043d\u0430\u043b\u0438\u0437\u044b \u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0434\u0430\u043b\u0435\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e, \u043f\u043e\n\u043a\u0440\u043e\u0432\u0438 (\u0410\u043b\u0410\u0422, \u0410\u0441\u0410\u0422, \u043e\u0431\u0449\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0447\u0430\u0449\u0435.\n\n\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d, \u043f\u0440\u044f\u043c\u043e\u0439 * \u043f\u0440\u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0434\u0435\u043b\u0430\u043c\u0430\u043d\u0438\u0434\u0430 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\n\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d, \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d*\n\u043b\u0438\u043f\u0430\u0437\u0430, \u0430\u043c\u0438\u043b\u0430\u0437\u0430, \u0449\u0435\u043b\u043e\u0447\u043d\u0430\u044f\n\u0444\u043e\u0441\u0444\u043e\u0442\u0430\u0437\u0430, \u0433\u043b\u044e\u043a\u043e\u0437\u0430 \u043a\u0440\u043e\u0432\u0438,\n\n\u043e\u0431\u0449\u0438\u0439 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d,\n\u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430, \u0421\u041a\u0424)\n\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u0430\u043b\u0438\u044f, \u043c\u0430\u0433\u043d\u0438\u044f \u0438 \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u0430\u043b\u0438\u044f, \u043c\u0430\u0433\u043d\u0438\u044f \u0438 \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0432\n\n\u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0434\u0430\u043b\u0435\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u043f\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0431\u0435\u0434\u0430\u043a\u0432\u0438\u043b\u0438\u043d\u0430, \u0434\u0435\u043b\u0430\u043c\u0430\u043d\u0438\u0434\u0430, \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432.\n\u041f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u044c \u043f\u0440\u0438 \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0438 \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e\n\n\u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 \u042d\u041a\u0413 (\u0443\u0434\u043b\u0438\u043d\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 QT\u0441).\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043c\u0430\u0433\u043d\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438\n\u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0438 \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u0438\n\n\u0422\u0438\u0440\u0435\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0439 \u0433\u043e\u0440\u043c\u043e\u043d \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0435 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n(\u0422\u0422\u0413)", "type": "Document"}}