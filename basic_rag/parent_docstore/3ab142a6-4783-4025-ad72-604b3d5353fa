\u043d\u044f \u043f\u043e\u0441\u043b\u0435 \u0446\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0430\u0437\u043e\u0441\u043f\u0430\u0437\u043c\u0430 \u043f\u043e\u0441\u043b\u0435\n[2,7](\u0423\u0414 \u2013 \u0421); \u0441\u0443\u0431\u0430\u0440\u0430\u0445\u043d\u043e\u0438\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u043e\u0438\u0437\u043b\u0438\u044f\u043d\u0438\u044f\n\u0447\u0430\u0441\u0430 \u0441\u0443\u0431\u0430\u0440\u0430\u0445\u043d\u043e\u0438\u0434\u0430\n\u043b\u044c\u043d\u043e\u0433\u043e\n\u043a\u0440\u043e\u0432\u043e\u0438\u0437\u043b\u0438\u044f\u043d\u0438\n\u044f\n\u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 4 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d 3-7 \u043f\u0440\u0438 \u044d\u043c\u0431\u043e\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0438\n\u0434\u043d\u0435\u0439\n[11] (\u0423\u0414 \u2013 D) \u0441\u0443\u0442\u043a\u0438 \u043e \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0445 \u0430\u043d\u0435\u0432\u0440\u0438\u0437\u043c \u0441 \u0446\u0435\u043b\u044c\u044e\n\u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0438\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0442\u0435\u043a\u0430 \u0438\n\u0430\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u043c\u0435\u0448\u043a\u0430\n\u0430\u043d\u0435\u0432\u0440\u0438\u0437\u043c\u044b \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0434\u043e 8-12\n\u043c\u0433, \u043f\u043e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0434\u043e 4-12 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438\n\u0446\u0435\u0444\u0430\u0437\u043e\u043b\u0438\u043d[3,4, 2000 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d \u043f\u0435\u0440\u0435\u0434 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n6,8,9,10] (\u0423\u0414 \u2013 \u043e \u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439 (\u043f\u0440\u0438 \u043c\u0438\u043a\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438) \u0437\u0430\n30 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\nA).\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\u0446\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c[3, 1500 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d \u043f\u0435\u0440\u0435\u0434 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n4,6,8,9,10] (\u0423\u0414 \u043e \u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439 (\u043f\u0440\u0438 \u043c\u0438\u043a\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438) \u0437\u0430\n30 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u2013 A).\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.\n\u0432\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d[3, 2000 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d \u043f\u0435\u0440\u0435\u0434 \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u043a\u0446\u0438\u0438\n4,6,8,9,10] (\u0423\u0414 \u043e \u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u043d\u0430 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u043e\u0432\u043e\u0433\u043e\n\u0440\u044f\u0434\u0430, \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f\n\u2013 A).\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 (\u043f\u0440\u0438\n\u043c\u0438\u043a\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438) \u0437\u0430 30\n\u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\u043a\u0435\u0442\u043e\u043f\u0440\u043e\u0444\u0435\u043d 100 \u043c\u0433 \u043f\u0440\u0438 \u0431\u043e\u043b\u044f\u0445 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448 \u0414\u043e \u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435\n100 \u043c\u0433 \u0435\u0447\u043d\u043e \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0441\n\u0446\u0435\u043b\u044c\u044e \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u0432\n\u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e\n[3,4,6,8,9,10] \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u043f\u043e\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n(\u0423\u0414 \u2013 \u0412).\n\u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043f\u0440\u0438 \u0431\u043e\u043b\u0438", "type": "Document"}}