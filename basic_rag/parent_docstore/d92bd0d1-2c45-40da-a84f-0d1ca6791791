u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f).\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u041e\u043b\u0430\u043d\u0437\u0430\u043f\u0438\u043d2,3, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043e\u0437.\n5-10 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c.\n\n\u0421 18 \u043b\u0435\u0442\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u041a\u0432\u0435\u0442\u0438\u0430\u043f\u0438\u043d2,3,4, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043e\u0437.\n25-50 \u043c\u0433/\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0437\u0430 1\n\u043f\u0440\u0438\u0435\u043c.\n\u0421 18 \u043b\u0435\u0442.\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u041f\u0430\u043b\u0438\u043f\u0435\u0440\u0438\u0434\u043e\u043d1,2, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043e\u0437.\n3-6 \u043c\u0433 \\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0437\u0430 1\n\u043f\u0440\u0438\u0435\u043c\n\u0414\u0435\u0442\u0438: \u0441 15 \u043b\u0435\u0442 3-6 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438\n\u0432\u043d\u0443\u0442\u0440\u044c \u0437\u0430 \u043e\u0434\u0438\u043d \u043f\u0440\u0438\u0435\u043c\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0410\u043c\u0438\u0441\u0443\u043b\u044c\u043f\u0440\u0438\u04342,3, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043e\u0437..\n\n50-600\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0432 1-3\n\u043f\u0440\u0438\u0435\u043c\u0430\n\u0414\u0435\u0442\u0438: \u0441 15 \u043b\u0435\u0442 50-300 \u043c\u0433/\u0441\u0443\u0442\n\u0432 1-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0420\u0438\u0441\u043f\u0435\u0440\u0438\u0434\u043e\u043d2,3, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0434\u043e\u0437.\n\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c 0,5-6 \u043c\u0433 \\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c\n\u0414\u0435\u0442\u0438: \u0441 5 \u043b\u0435\u0442.\n\u041c\u0430\u0441\u0441\u0430 \u0442\u0435\u043b\u0430 \u043c\u0435\u043d\u0435\u0435 50 \u043a\u0433 \u2013\n0,25-0,75 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438;\n\u0411\u043e\u043b\u0435\u0435 50 \u043a\u0433 \u2013 0,25-2 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u041a\u043b\u043e\u0437\u0430\u043f\u0438\u043d2,3, \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0434\u043e\u0437.\n25-200 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c\n2 \u2013 3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0420\u0430\u0437\u043e\u0432\u0430\u044f \u2014 50 \u2013 200\n\n\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438, \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u2014 150 \u2013\n300 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438,\n\u0414\u0435\u0442\u0438: 6 \u2013 8 \u043b\u0435\u0442 \u2014 15 \u2013 30\n\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438;\n8 \u2013 15 \u043b\u0435\u0442 \u2014 30 \u2013 60\n\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438, 2 \u2013 3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c,\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0421\u0443\u043b\u044c\u043f\u0438\u0440\u0438\u0434, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u043a\u0430\u043f\u0441\u0443\u043b\u044b \u0434\u043e\u0437.\n200-400\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438\n\u0432\u043d\u0443\u0442\u0440\u044c \u0432 2-3 \u043f\u0440\u0438\u0435\u043c\u0430.\n\u0414\u0435\u0442\u0438: \u0441\u0442\u0430\u0440\u0448\u0435 6 \u043b\u0435\u0442 5\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438.\n\u0421 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0443 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0438 \u0432\n\u043f\u0435\u0440\u0438\u043e\u0434 \u043b\u0430\u043a\u0442\u0430\u0446\u0438\u0438\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0413\u0430\u043b\u043e\u043f\u0435\u0440\u0438\u0434\u043e\u043b1,2, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u0430\u043c\u043f\u0443\u043b\u044b \u0434\u043e\u0437.\n0,5-15 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0432 1-3\n\u043f\u0440\u0438\u0435\u043c\u0430, \u0431\u043e\u043b\u0435\u0435 40 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\n\u0440\u0435\u0434\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 (\u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435\n\u0432\u0440\u0435\u043c\u044f).\n\u0414\u0435\u0442\u0438: \u0441 3-\u0445 \u043b\u0435\u0442 25-75\n\u043c\u043a\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0432 2-3 \u043f\u0440\u0438\u0435\u043c\u0430.\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0422\u0440\u0438\u0433\u0435\u043a\u0441\u0438\u0444\u0435\u043d\u0438\u0434\u0438\u043b1,2, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u043e\u0437.\n4-6 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c\n\u041a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430 - 3-6\n\u0440\u0430\u0437/\u0441\u0443\u0442\u043a\u0438.\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0413\u0430\u043b\u043e\u043f\u0435\u0440\u0438\u0434\u043e\u043b \u2013 \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 C\n\u0434\u0435\u043a\u0430\u043d\u043e\u0430\u04421,2, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043e\u0437.\n\n\u0434\u043b\u044f \u0432/\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f 25-50 \u043c\