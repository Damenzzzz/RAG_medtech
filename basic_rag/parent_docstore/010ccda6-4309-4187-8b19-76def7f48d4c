13\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041e\u0420\u0412\u0418 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u044b \u0438\u043b\u0438 \u041e\u0420\u0412\u0418 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043c\u043d\u043e\u0433\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u044b \u041b\u0435\u0433\u043a\u0438\u0435 \u0444\u043e\u0440\u043c\u044b \u0438 \u0410\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u042d\u0442\u0438\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0435, \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 5 \u043b\u0435\u0442 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 5.2 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \uf05b1-4,6\uf05d: \u0420\u0435\u0436\u0438\u043c: \u2022 \u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0434\u043b\u044f \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u043e\u0439 \u0433\u0440\u0438\u043f\u043f\u0430 \u0438 \u041e\u0420\u0412\u0418 (\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438); \u0414\u0438\u0435\u0442\u0430: \u2022 \u0441\u0442\u043e\u043b No13, \u0434\u0440\u043e\u0431\u043d\u043e\u0435 \u0442\u0435\u043f\u043b\u043e\u0435 \u043f\u0438\u0442\u044c\u0435 (\u043c\u043e\u043b\u043e\u0447\u043d\u043e-\u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0435\u0442\u0430); \u2022 \u0433\u0438\u0433\u0438\u0435\u043d\u0430 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e: \u0443\u0445\u043e\u0434 \u0437\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u043c\u0438 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u043c\u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430, \u0433\u043b\u0430\u0437, \u0442\u0443\u0430\u043b\u0435\u0442 \u043d\u043e\u0441\u0430. \u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u043d\u0438\u0435 \u0432 \u043d\u043e\u0441 0,9 % \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0445\u043b\u043e\u0440\u0438\u0434 \u043d\u0430\u0442\u0440\u0438\u044f, \u043f\u043e 1-3 \u043a\u0430\u043f\u043b\u0438; \u043e\u0447\u0438\u0449\u0430\u0442\u044c \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0435 \u0438\u0437 \u043d\u043e\u0441\u0430 \u043d\u0443\u0436\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0442\u0443\u0440\u0443\u043d\u0434\u044b \u0438\u043b\u0438 \u043e\u0442\u0441\u0430\u0441\u044b\u0432\u0430\u0442\u044c \u0433\u0440\u0443\u0448\u0435\u0439; \u2022 \u043f\u0440\u0438 \u0441\u0442\u0435\u043d\u043e\u0437\u0435 \u0433\u043e\u0440\u0442\u0430\u043d\u0438-\u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0438 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u043a\u043e\u0439, \u0434\u043e\u0441\u0442\u0443\u043f \u0441\u0432\u0435\u0436\u0435\u0433\u043e 18 \u0432\u043e\u0437\u0434\u0443\u0445\u0430, \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0440\u0435\u0431\u0435\u043d\u043a\u0430, \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b: \u0443\u0432\u043b\u0430\u0436\u043d\u0435\u043d\u043d\u044b\u0439 \u0432\u043e\u0437\u0434\u0443\u0445. 5.3 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \uf05b1-6,9,10,11-17\uf05d: \u041f\u0440\u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0433\u0440\u0438\u043f\u043f\u0430 \u0438 \u041e\u0420\u0412\u0418: \u2022 \u0434\u043b\u044f \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0432\u044b\u0448\u0435 38,5\u043e\u0421 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f: \uf02d \u043f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b 10- 15 \u043c\u0433/\u043a\u0433 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 4 \u0447\u0430\u0441\u043e\u0432, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0442\u0440\u0435\u0445 \u0434\u043d\u0435\u0439 \u0447\u0435\u0440\u0435\u0437 \u0440\u043e\u0442 \u0438\u043b\u0438 per rectum; \u0438\u043b\u0438 \uf02d \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0432 \u0434\u043e\u0437\u0435 5-10 \u043c\u0433/\u043a\u0433 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3-\u0445 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 \u0440\u043e\u0442; \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0433\u0440\u0438\u043f\u043f\u0430 \u0438 \u041e\u0420\u0412\u0418: \u2022 \u0434\u043b\u044f \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0