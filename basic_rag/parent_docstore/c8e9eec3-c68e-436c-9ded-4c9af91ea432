43d\u0434\u0438\u0435\u0432 \u0418.\u041c. - \u043a.\u043c.\u043d., \u0434\u043e\u0446\u0435\u043d\u0442 \u0437\u0430\u0432. \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439\n\u0438 \u0444\u0442\u0438\u0437\u0438\u0430\u0442\u0440\u0438\u0438 \u0413\u041c\u0423 \u0433. \u0421\u0435\u043c\u0435\u0439.\n\n4) \u041a\u0443\u0437\u0433\u0438\u0431\u0435\u043a\u043e\u0432\u0430 \u0421.\u0411 \u2013 \u0432\u0440\u0430\u0447 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043f\u0440\u0438\u0435\u043c\u043d\u044b\u043c \u043f\u043e\u043a\u043e\u0435\u043c\n\u0413\u041a\u041a\u041f \u00ab\u0413\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u0434\u0435\u0442\u0441\u043a\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0430\u00bb \u0410\u043a\u0438\u043c\u0430\u0442\u0430 \u0433. \u0410\u0441\u0442\u0430\u043d\u0430.\n5) \u0411\u0430\u043a\u044b\u0431\u0430\u0435\u0432 \u0414.\u0415. \u2013 \u0432\u0440\u0430\u0447 \u2013 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433 \u0410\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb.\n\n17. \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\n\n18. \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b: \u04