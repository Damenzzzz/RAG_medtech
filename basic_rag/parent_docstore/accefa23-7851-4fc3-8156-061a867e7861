u0437 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u0432\u0438\u043d\u043e\u0432\u043d\u044b\u043c \u0446\u0435\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0432\u044b\u0433\u043e\u0434\u044b;\n- \u043f\u0440\u0438\u043d\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u043b\u0438\u0446\u0430 \u043a \u0437\u0430\u043d\u044f\u0442\u0438\u044e \u043f\u043e\u043f\u0440\u043e\u0448\u0430\u0439\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c, \u0442\u043e \u0435\u0441\u0442\u044c\n\u043a \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044e \u0430\u043d\u0442\u0438\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u044f\u043d\u0438\u044f, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u0441\n\u0432\u044b\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u0435\u043c \u0443 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u0438\u0446 \u0434\u0435\u043d\u0435\u0433 \u0438 (\u0438\u043b\u0438) \u0438\u043d\u043e\u0433\u043e\n\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430;\n- \u0438\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0432\u0438\u043d\u043e\u0432\u043d\u044b\u043c\n\u043f\u043e\u043b\u043d\u043e\u043c\u043e\u0447\u0438\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u043b\u0438\u0446\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e \u043d\u0435\n\u0437\u0430\u0432\u0438\u0441\u044f\u0449\u0438\u043c \u043e\u0442 \u043d\u0435\u0433\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442\n\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442 \u0438 (\u0438\u043b\u0438) \u0443\u0441\u043b\u0443\u0433 \u0434\u043b\u044f \u0432\u0438\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0438 (\u0438\u043b\u0438)\n\u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043b\u0438\u0446\u0430.\n\n\u0412\u0435\u0440\u0431\u043e\u0432\u043a\u0430 - \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u043f\u043e\u0442\u0435\u0440\u043f\u0435\u0432\u0448\u0435\u0433\u043e \u043d\u0430\n\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e \u0440\u0430\u0431\u043e\u0442 \u0438\u043b\u0438 \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e\n2.3 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0439, \u0435\u0441\u043b\u0438 \u044d\u0442\u043e\n\u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u0446\u0435\u043b\u044c\u044e \u0435\u0433\u043e \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438.\n\u041f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0430 - \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u043c\u044b\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\n\u0443\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0435\u0433\u043e \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u044e \u0438\u0437 \u043e\u0434\u043d\u043e\u0433\u043e\n2.4 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u043c\u0435\u0441\u0442\u0430 \u0432 \u0434\u0440\u0443\u0433\u043e\u0435, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043e\u0434\u043d\u043e\u0433\u043e \u0438 \u0442\u043e\u0433\u043e \u0436\u0435\n\u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0443\u043d\u043a\u0442\u0430.\n\u041f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 - \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u043f\u043e\u0442\u0435\u0440\u043f\u0435\u0432\u0448\u0435\u0433\u043e \u043b\u0438\u0446\u0443\n2.5 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u0434\u043b\u044f \u0435\u0433\u043e \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438.\n\u0423\u043a\u0440\u044b\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e - \u0441\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u043e\u0442\u0435\u0440\u043f\u0435\u0432\u0448\u0435\u0433\u043e \u043e\u0442\n\u043f\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u0438\u0446\n(\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0442\u0430\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u044f\u0445,\n2.6 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u043d\u0435\u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0437\u0430 \u0442\u0443 \u0438\u043b\u0438 \u0438\u043d\u0443\u044e \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044e,\n\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043b\u0438 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438)\n\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 - \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u043b\u0438\u0446\u0430 \u0434\u043b\u044f \u0435\u0433\u043e\n2.7 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438\n2.8 \u041f\u043e\u0445\u0438\u0449\u0435\u043d\u0438\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 5 \u0431\u0430\u043b\u043b\u043e\u0432\n2.9 \u041d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0435 \u043b\u0438\u0448\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u0441 \u0446\u0435\u043b\u044c\u044e \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 5 \u0431\u0430\u043b\u043b\u043e\u0432\n3 \u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u0430\n\u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043d\u0430\u0441\u0438\u043b\u0438\u044f, \u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u0434\u043b\u044f \u0436\u0438\u0437\u043d\u0438 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0438\u043b\u0438\n3.1 5 \u0431\u0430\u043b\u043b\u043e\u0432\n\u0443\u0433\u0440\u043e\u0437\u0430 \u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043e\u0440\u0443\u0436\u0438\u044f \u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u04