3e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438):\n\n\u2022 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u041e\u0410\u041c, \u0410\u0414, \u0423\u0417\u0418 \u041c\u0412\u0421;\n\n\u2022 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0432\u044f\u0437\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0440\u0430\u043d\u044b;\n\n\u2022 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0437\u0430 \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u044b\u043c\u0438 \u0442\u0440\u0443\u0431\u043a\u0430\u043c\u0438;\n\n\u2022 \u0441\u043d\u044f\u0442\u0438\u0435 \u0448\u0432\u043e\u0432 \u043d\u0430 7-10 \u0441\u0443\u0442\u043a\u0438;", "type": "Document"}}