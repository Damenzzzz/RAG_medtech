43b\u0438\u0440\u0430\u0433\u043b\u0443\u0442\u0438\u0434) [8,9]. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0418\u041c\u0441\u043fST \u0438 \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u043c \u0434\u0438\u0430\u0431\u0435\u0442\u043e\u043c\n\u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 28.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 28. \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0438\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0414\n39\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0442\u044c \u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u0443 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 I \u0421\n\u043f\u0440\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0447\u0430\u0441\u0442\u044b\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u0443\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0421\u0414 \u0438\u043b\u0438 \u0433\u0438\u043f\u0435\u0440\u0433\u043b\u0438\u043a\u0435\u043c\u0438\u0435\u0439 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u226511 \u043c\u043c\u043e\u043b\u044c/\u043b\n\n\u0438\u043b\u0438 \u2265200\u043c\u0433/\u0434\u043b)\n\u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0449\u0438\u0445 \u043c\u0435\u0442\u0444\u043e\u0440\u043c\u0