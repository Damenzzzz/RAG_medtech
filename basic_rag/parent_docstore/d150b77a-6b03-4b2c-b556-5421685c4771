f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 75% \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432 \u043c\u0443\u043b\u044c\u0442\u0438\u0441\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432.\n\n\u041a\u043b\u0430\u0441\u0441 B - \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u043f\u043e\u0440\u043d\u044b \u0438 \u043d\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435.\n\n\u041a\u043b\u0430\u0441\u0441 C - \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0437\u043d\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441\u0440\u0435\u0434\u0438 \u0447\u043b\u0435\u043d\u043e\u0432 \u0433\u0440\u0443\u043f\u043f\u044b.\n\n7. \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435: \u0410\u0431\u0441\u0446\u0435\u0441\u0441 \u043f\u0435\u0447\u0435\u043d\u0438 - \u044d\u0442\u043e \u0441\u043e\u043b\u0438\u0442\u0430\u0440\u043d\u044b\u0435, \u043b\u0438\u0431\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0433\u043d\u043e\u0439\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0441\u0442\u0438, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0444\u0438\u0431\u0440\u043e\u0437\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u044c\u044e [1].", "type": "Document"}}