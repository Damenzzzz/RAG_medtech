3b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425\n\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430, \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044e/\u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u041f\u043e\u0431\u043e\u0447\u043d\u044b\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u043c\u0435\u0442\u043e\u0434\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u042d\u043a\u0441\u0442\u0440\u0430\u043a\u043e\u0440\u043f\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u041c\u0435\u0442\u043e\u0434 \u0432\u044b\u0431\u043e\u0440\u0430 \u043f\u0440\u0438 \u0420\u0422\u041f\u0425 \u043a\u043e\u0436\u0438 \u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445. \u0413\u0438\u043f\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c\u0438\u044f, \u0440\u0438\u0441\u043a \u043c\u0438\u043a\u0440\u043e\u0431\u043d\u043e\u0439 D\n\u0444\u043e\u0442\u043e\u0444\u0435\u0440\u0435\u0437 (ECP) [180, 1 \u0432\u0430\u0440\u0438\u0430\u043d\u0442: [ABMT] \u043a\u043e\u043d\u0442\u0430\u043c\u0438\u043d\u0430\u0446\u0438\u0438 \u0432\u0437\u0432\u0435\u0441\u0438 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432, \u0430\u043d\u0435\u043c\u0438\u044f\n181] 1\u044f \u043d\u0435\u0434\u0435\u043b\u044f - 3 \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e;\n2-12 \u043d\u0435\u0434\u0435\u043b\u0438 \u2013 2 \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e;\n\u0414\u0430\u043b\u0435\u0435 \u2013 1 \u0440\u0430\u0437 \u0432 2 \u043d\u0435\u0434\u0435\u043b\u0438\n2 \u0432\u0430\u0440\u0438\u0430\u043d\u0442:\n1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e 8 \u043d\u0435\u0434\u0435\u043b\u044c [Das Gupta et al, 2011]\n\u0410\u043d\u0442\u0438-\u0424\u041d\u041e \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u0438 \u0418\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431: \u0432/\u0432 10 \u043c\u0433/\u043a\u0433/\u043d\u0435\u0434 No4 \u0412\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 D\n\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0424\u041d\u041e\u03b1 \u042d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442: \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e 0,4 \u043c\u0433/\u043a\u0433 (\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 25 \u043c\u0433) 2 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439\n\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 [182, 183] \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 8 \u043d\u0435\u0434\u0435\u043b\u044c; \u0432/\u0432 \u0432 1, 4, 8, 15, 22 \u0434\u043d\u0438 \u043a\u0443\u0440\u0441\u0430\n\u0421\u0438\u0440\u043e\u043b\u0438\u043c\u0443\u0441 [184] \u041d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u044c 0,5 \u043c\u0433, 1 \u043c\u0433 \u0438\u043b\u0438 2 \u043c\u0433. \u0426\u0435\u043b\u0435\u0432\u043e\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0441 \u0432\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u043e\u043c (\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f D\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 3-12 \u043d\u0433/\u043c\u043b (\u043c\u0435\u043d\u0435\u0435 10 \u043d\u0433/\u043c\u043b \u043f\u0440\u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 90% \u0440\u0435\u0434\u0443\u043a\u0446\u0438\u044f \u0434\u043e\u0437\u044b), \u043f\u043e\u0437\u043e\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u043e\u043c (75%\nCNI) \u0440\u0435\u0434\u0443\u043a\u0446\u0438\u044f), \u0444\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u043e\u043c (25% \u0440\u0435\u0434\u0443\u043a\u0446\u0438\u044f).\n\u041c\u043e\u0436\u0435\u0442 \u043f\u043e\u0432\u044b\u0448\u0430\u0442\u044c \u0440\u0438\u0441\u043a \u0440\u0430\u0431\u0434\u043e\u043c\u0438\u043e\u043b\u0438\u0437\u0430 \u0432\n\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441\u043e \u0441\u0442\u0430\u0442\u0438\u043d\u0430\u043c\u0438. \u041f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0422\u041c\u0410\n\u043f\u0440\u0438\u0435\u043c \u0421NI \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f, \u0434\u043e\u0437\u0430 \u0441\u0438\u0440\u043e\u043b\u0438\u043c\u0443\u0441\u0430\n\u0441\u043d\u0438\u0436\u0430\u0435\u0442\u0441\u044f (\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f \u043c\u0435\u043d\u0435\u0435 10 \u043d\u0433/\u043c\u043b).\nMMF/MPS/MPA \u0420\u0435\u0436\u0438\u043c \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u0435\u043d \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 (\u0441\u043c. 15.3) \u0414\u0438\u0430\u0440\u0435\u044f, \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f, \u0441\u0435\u043f\u0441\u0438\u0441 \u0438 D\n[185,186] \u043e\u043f\u043f\u0440\u0442\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 (\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f\n\u0426\u041c\u041