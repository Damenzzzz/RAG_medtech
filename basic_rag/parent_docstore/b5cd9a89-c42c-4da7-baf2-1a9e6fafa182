435\u043a\u0446\u0438\u0438 (\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0435\u043c\u0438\u0438) \u0431\u0435\u0437 \u044d\u043f\u0438\u0437\u043e\u0434\u0430 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439, \u043a\u043e\u0433\u0434\u0430\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044c \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0432 \u043a\u0440\u043e\u0432\u044c (\u043f\u0440\u0438 \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u043e\u043c \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0438/\u0438\u043b\u0438\n\u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438);\n\u0412\u0442\u043e\u0440\u0438\u0447\u043d\u0430\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0438\u043b\u0438 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435\n\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439, \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u043e\u0440\u044b\u0432\u0430 \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0445 \u0431\u0430\u0440\u044c\u0435\u0440\u043e\u0432;\n\u0412\u0442\u043e\u0440\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0432\u0441\u043b\u0435\u0434 \u0437\u0430 \u0438 \u043a\u0430\u043a \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0433\u0435\u043c\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0439\n\u0434\u0438\u0441\u0441\u0435\u043c\u0438\u043d\u0430\u0446\u0438\u0438 (\u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438) \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0432\n\u043e\u0440\u0433\u0430\u043d\u044b \u0441 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0432 \u043d\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0447\u0430\u0433\u043e\u0432 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f [14, 15].\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1. \u041a\u043b\u0438\u043d\u0438\u043a\u043e-\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432 [11- 13]:\n\n\u0413\u0440\u0443\u043f\u043f\u044b \u041f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435 \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e- \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435 (\u0441\n\u0444\u043e\u0440\u043c (\u0441 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0432\u0430\u043d\u043d\u044b\u0435 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438\n\u0412\u0445\u043e\u0434\u043d\u044b\u0435\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438) \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438)\n\u0412\u043e\u0440\u043e\u0442\u0430\n\u041a\u043e\u0436\u0430 \u041a\u043e\u0436\u043d\u0430\u044f \u0413\u0435\u043f\u0430\u0442\u0438\u0442\u043d\u0430\u044f\n\u0416\u041a\u0422 \u041a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u0430- \u0410\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u041c\u0435\u043d\u0438\u043d\u0433\u043e\u044d\u043d\u0446\u0435-\n\u0446\u0438\u044f \u0414\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u041e\u0441\u0442\u0440\u0430\u044f \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u043e- \u0444\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0432\u0445\u043e\u0434\u043d\u044b\u0445 \u041f\u0443\u0442\u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e- \u041f\u0438\u0435\u043b\u043e\u043d\u0435-\n\n\u0432\u043e\u0440\u043e\u0442 \u0410\u043d\u0433\u0438\u043d\u043e\u0437\u043d\u0430\u044f \u0432\u0430\u043d\u043d\u044b\u0435 \u0444\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u041f\u043e\u043b\u043e\u0432\u044b\u0435 \u043f\u0443\u0442\u0438 \u0413\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f\n\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044b \u041d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u041f\u0435\u0440\u0432\u0438\u0447\u043d\u043e- \u0421\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n(\u0438\u043c\u043c\u0443\u043d\u043e- \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e- \u0414\u0440\u0443\u0433\u0438\u0435 \u043c\u0430\u043b\u043e\n\n\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f) \u0432\u0430\u043d\u043d\u0430\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u043d-\n\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a \u0418\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d- \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0439 \u0420\u0430\u0437\u0433\u0430\u0440\u0430 \u041e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0439 \u0438\n\u0438\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u044b \u043d\u044b\u0439 (1-3 \u0434\u043d\u044f) \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439\n\u0424\u0430\u0437\u044b 1.\u0412\u043d\u0435\u0434\u0440\u0435\u043d\u0438\u044f \u0438 2.\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u043e- 3.\u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438 4.\u0412\u0442\u043e\u0440\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445\n\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0439 \u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u0438 \u0438 \u0438 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445\n-\u043d\u043e\u0433\u043e \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 (\u0433\u0435\u043c\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u0434\u0438\u0441\u0441\u0435\u043c\u0438\u043d\u0430\u0446\u0438\u0438)\n\n\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u044e\u0442 [14, 15]:\n\u2022 \u043e\u0441\u0442\u0440\u044b\u0439 (1\u20133 \u043c\u0435\u0441);\n\u2022 \u043f\u043e\u0434\u043e\u0441\u0442\u0440\u044b\u0439 (3\u20136 \u043c\u0435\u0441);\n\n\u2022 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 (\u0434\u043e\u043b\u044c\u0448\u0435 6 \u043c\u0435\u0441) \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437.\n\n4\n\nII. \u041c\u0415\u0422\u041e\u0414\u042b, \u041f\u041e\u0414\u0425\u041e\u0414\u042b \u0418 \u041f\u0420\u041e\u0426\u0415\u0414\u0423\u0420\u042b \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0418 \u0418 \u041b\u0415\u0427\u0415\u041d\u0418\u042f\n[14-18]:\n2.1 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 [14, 15]:\n\u0416\u0430\u043b\u043e\u0431\u044b \u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437:\n\n\u2022 \u0438\u043d\u043a\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u0440\u0438 \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u0430\u0445 \u0434\u043b\u0438\u0442\u0441\u044f \u0447\u0430\u0449\u0435 1-6 \u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0434\u043b\u0438\u0442\u0441\u044f \u0434\u043e\n15 \u0434\u043d\u0435\u0439 \u0438 \u0434\u043e\u043b\u044c\u0448\u0435;\n\u0414\u043b\u044f \u0432\u0441\u0435\u0445 \u0444\u043e\u0440\u043c \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0442\u0435\u043b\u0430 \u0438\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0440\u0430\u0437\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438:\n\n\u2022 \u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f;\n\u2022 \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c;\n\u2022 \u043e\u0431\u0449\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c;\n\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430;\n\u2022 \u0431\u043e\u043b\u0438 \u0432 \u043a\u043e\u0441\u0442\u044f\u0445, \u043c\u044b\u0448\u0446\u0430\u0445, \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445 \u0438 \u0442.\u043f.\n\n\u041f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u0444\u043e\u0440\u043c (\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e-\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445)\n\n\u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0442\u0441\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c (\u043d\u0435\u0440\u0435\u0434\u043a\u043e\n\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u043d\u044b\u0435, \u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u044b\u0435 \u2013 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u043e\u0441\u044f\u0442\n\u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043b\u0443\u0447\u0430\u044f,\n\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u0445 \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u0430 [16 \u2013 18].\n\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0445 \u0444\u043e\u0440\u043c \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\u043e\u0432:\n\n\u0424\u043e\u0440\u043c\u044b \u0416\u0430\u043b\u043e\u0431\u044b \u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435\n1 2 3 4\n\u043e\u0441\u0442\u0440\u0430\u044f \u0431\u043e\u043b\u0438 \u0432 \u0433\u043e\u0440\u043b\u0435, \u043f\u0435\u0440\u0448\u0435\u043d\u0438\u0435, -\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0441\u0443\u0445\u043e\u0439 \u043a\u0430\u0448\u0435\u043b\u044c, -\u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u043e\u043d\u0437\u0438\u043b\u043b\u0438\u0442\n\u0444\u043e\u0440\u043c\u0430 -\u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442\n- \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0448\u0435\u0439\u043d\u044b\u0439\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u043f\u043e\u0434\u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e\u0439\n\u043f\u044f\u0442\u043d\u0438\u0441\u0442\u043e-\u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c \u0438 \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442,\n\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n\u0430\u043d\u0433\u0438\u043d\u043e\u0437\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 -\u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0441 - \u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e\n1. 1.\u043e\u0441\u0442\u0440\u043e\u0435 \u043e\u0437\u043d\u043e\u0431\u043e\u043c -\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 - \u0431\u043e\u043b\u0438 \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438 \u0432 -\u043c\u0435\u0441\u0442\u043d\u044b\u0439 \u0433\u043d\u043e\u0439\u043d\u043e-\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u0430\u0445 \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439, \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043d\u0430\n-\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432 \u043c\u044b\u0448\u0446\u0430\u0445, \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445,\n\u043a\u043e\u0441\u0442\u044f\u0445, \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445 - -\u0440\u0430\u0437\u043b\u0438\u0442\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0437\u0435\u0432\u0430,\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d \u043f\u044f\u0442\u043d\u0438\u0441\u0442\u043e-\u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c \u0438 - -\u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\u043e- \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u0442, \u0448\u0435\u0439\u043d\u043e-\n\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435 \u0436\u0435\u043b\u0442\u0443\u0448\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0434\u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e\u0439\n\u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442\n- -\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438\n\u0438 \u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n\n5\n\n\u0430\u043d\u0433\u0438\u043d\u043e\u0437\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0441\u0443\u0431\u0444\u0435\u0431\u0440\u0438\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 - \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f\n2.\u043f\u043e\u0434\u043e\u0441\u0442\u0440\u043e\u0435, -\u0441\u043b\u0430\u0431\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438\u043b\u0438 \u0438\u0445 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 -\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0437\u0435\u0432\u0430, \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d,\n\u0433\u043b\u043e\u0442\u043a\u0438\n- \u0433\u043d\u043e\u0439\u043d\u044b\u0435 \u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u044b \u0438\u043b\u0438\n\u043b\u0430\u043a\u0443\u043d\u044b \u0447\u0430\u0449\u0435 \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0438\u043b\u0438\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u0442, \u043e\u0431\u0435\u0438\u0445 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445\n\u0431\u0440\u043e\u043d\u0445\u0438\u0442, - -\u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\u0436\u0435\u043b\u0442\u0443\u0448\u043d\u043e\u0441\u0442\u044c, \u0448\u0435\u0439\u043d\u043e-\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u044c \u043f\u043e\u0434\u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e\u0439\n\u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442\n- -\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438\n\u0438 \u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n\u041a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0422\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430, \u0431\u043e\u043b\u044c \u0432 - \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f\n\u0436\u0438\u0432\u043e\u0442\u0435, \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f\n\n\u0436\u0438\u0434\u043a\u0438\u0439 \u0441\u0442\u0443\u043b -\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b,\n-\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0437\u0435\u0432\u0430,\n\u0433\u043b\u043e\u0442\u043a\u0438\n-\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n\u0430\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f -\u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0441 -\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f\n\u0444\u043e\u0440\u043c\u0430 \u043e\u0437\u043d\u043e\u0431\u043e\u043c - \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u044b \u043e\u0441\u0442\u0440\u043e\u0433\u043e\n1 \u043e\u0441\u0442\u0440\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 - \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432 \u043f\u0440\u0430\u0432\u043e\u0439 \u0430\u043f\u043f\u0435\u043d\u0434\u0438\u0446\u0438\u0442\u0430,\n\u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043c\u0435\u0437\u0435\u043d\u043d\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n-\u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430 \u0430\u0434\u0435\u043d\u0438\u0442\u0430, \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n-\u0436\u0438\u0434\u043a\u0438\u0439 \u0441\u0442\u0443\u043b, \u0441 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u0438\u043b\u0435\u0438\u0442\u0430,\n\u0441\u043b\u0438\u0437\u0438, -\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438\n- \u0432\u0437\u0434\u0443\u0442\u0438\u0435 \u0436\u0438\u0432\u043e\u0442\u0430 \u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n-\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c - \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435:\n\u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u044f\u0442\u043d\u0438\u0441\u0442\u043e- \u043f\u0435\u0440\u0438\u0442\u043e\u043d\u0438\u0442, \u0418\u0422\u0428\n\n\u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c \u0438\n\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\u0442,\n\u0436\u0435\u043b\u0442\u0443\u0448\u043d\u043e\u0441\u0442\u044c,\n\u043f\u043e\u043b\u0438\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0441\u0442\u044c\n\u0430\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u0438\u043b\u0438 - \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u044b\n\u0444\u043e\u0440\u043c\u0430 \u0435\u0435 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n2. \u043f\u043e\u0434\u043e\u0441\u0442\u0440\u043e\u0435 \u0438\u043b\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0430\u043f\u043f\u0435\u043d\u0434\u0438\u0446\u0438\u0442\u0430,\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u043c\u0435\u0437\u0430\u0434\u0435\u043d\u0438\u0442\u0430,\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u0438 \u0432 \u0434\u0438\u0432\u043e\u0442\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0438\u043b\u0435\u0438\u0442\u0430, \u0433\u0430\u0441\u0442\u0440\u0438\u0442\u0430,\n\u0445\u043e\u043b\u0435\u0446\u0438\u0441\u0442\u0438\u0442\u0430,\n\u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442\u0430,\n\u0434\u0443\u043e\u0434\u0435\u043d\u0438\u0442\u0430,\n\u043a\u043e\u043b\u0438\u0442\u0430\n\n\u043a\u043e\u0436\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u0420\u043e\u0436\u0435\u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0420\u043e\u0436\u0435\u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435,\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0431\u043e\u043b\u044f\u043c\u0438, -\u0437\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442,\n\u0436\u0436\u0435\u043d\u0438\u0435\u043c, \u0437\u0443\u0434\u043e\u043c -\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438\n\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438\n\n6", "type": "Document"}}