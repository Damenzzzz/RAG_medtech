35\u0434\u0438\u0430\u0442\u0440, \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433-\n\u0430\u043b\u043b\u0435\u0440\u0433\u043e\u043b\u043e\u0433, \u043f\u0443\u043b\u044c\u043c\u043e\u043d\u043e\u043b\u043e\u0433.\n3) \u041a\u0430\u0440\u0438\u043d \u0411\u0435\u043a\u0442\u0443\u0440\u0433\u0430\u043d \u0422\u044b\u043d\u044b\u043c\u0431\u0430\u0435\u0432\u0438\u0447 \u2013 \u043c\u0430\u0433\u0438\u0441\u0442\u0440 \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0430\u00bb,\n\n\u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb,\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n4) \u0427\u0443\u0432\u0430\u043a\u043e\u0432\u0430 \u0422\u0430\u043c\u0430\u0440\u0430 \u041a\u0443\u0440\u043c\u0430\u043d\u0433\u0430\u043b\u0438\u0435\u0432\u043d\u0430 - \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\n\u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb.\n\n5) \u0414\u0436\u0430\u043a\u0441\u0430\u043b\u044b\u043a\u043e\u0432\u0430 \u041a\u0443\u043b\u044f\u0448 \u041a\u0430\u043b\u0438\u043a\u0430\u043d\u043e\u0432\u043d\u0430 - \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb, \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n6) \u0415\u0440\u0430\u043b\u0438\u0435\u0432\u0430 \u0411\u0438\u0431\u0438\u0445\u0430\u043d \u0410\u0431\u0434\u0438\u043b\u0438\u0435\u0432\u043d\u0430 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0434\u043e\u0446\u0435\u043d\u0442\n\u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439\n\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u0421. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb, \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433 \u041c\u0417 \u0420\u041a.\n\n7.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n\n7.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n1) \u0422\u0430\u0448\u0435\u043d\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u0422\u0430\u043b\u0438\u043f\u043e\u0432\u043d\u0430 - \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb.\n\n2) \u041d\u0443\u0433\u043c\u0430\u043d\u043e\u0432\u0430 \u0410\u0439\u0433\u0443\u043b\u044c \u041c\u0430\u0440\u0430\u0442\u043e\u0432\u043d\u0430 - \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0441 \u043a\u0443\u0440\u0441\u043e\u043c \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0441\u043a\u043e-\n\u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u00bb.\n\n7.4 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0447\u0435\u0440\u0435\u0437 5\n\u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441 \u0434\u0430\u0442\u044b \u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u043e\u0432\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n7.5 \u0421\u043f\u0438\u0441\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b:\n1. NHSGGC Guidelines. Cytomegalovirus (CMV) - congenital infection.\nhttps://www.clinicalguidelines.scot.nhs.uk/nhsggc-guidelines/nhsggc-\n\nguidelines/neonatology/cytomegalovirus-cmv-congenital-infection/\n2. Clinical Guideline: Diagnosis and Management of Congenital Cytomegalovirus.\nEast of England cCMV guideline. F Walston, K McDevitt, S Walter, S Luck, T\nHolland Brown., 2022. https://www.eoeneonatalpccsicnetwork.nhs.uk/wp-\n\ncontent/uploads/2022/02/cCMV-EoE-guideline.pdf.\n3. Jaan A, Rajnik M. TORCH Complex. StatPearls Publishing. 2023.\nhttps://www.ncbi.nlm.nih.gov/books/NBK560528/\n\nBrenda L. Tesini. Congenital and Perinatal Cytomegalovirus Infection (CMV). 2022.\nhttps://www.msdmanuals.com/professional/pediatrics/infections-in-\nneonates/congenital-and-perinatal-cytomegalovirus-infection-cmv.\n4. F Walston, K McDevitt, S Walter, S Luck, T Holland Brown. Clinical Guideline:\nDiagnosis and Management of Congenital Cytomegalovirus. East of England cCMV\n\nguideline. 2022. htt