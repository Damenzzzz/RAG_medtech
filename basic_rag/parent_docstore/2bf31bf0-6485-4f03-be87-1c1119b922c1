22- \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f \u043b\u0438\u043c\u0444\u043e\u043c\u0430\n\u041f\u0413\u041b \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u043c\u043e\u0437\u0433\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439\n\u041f\u0440\u043e\u0433\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u044b (\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0412\u0435\u0440\u043d\u0435\u0440\u0430,\n\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u043b\u0443\u043c\u0430) \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u0441 \u0440\u0438\u0441\u043a\u043e\u043c\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439\n\n2.3 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043b\u0438\u043f\u043e\u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u0438 [1,2,3,4,5,6,7]:]\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u0418\u0446\u0435\u043d\u043a\u043e-\u041a\u0443\u0448\u0438\u043d\u0433\u043e \u0427\u0435\u0440\u043d\u044b\u0439 \u0430\u043a\u0430\u043d\u0442\u043e\u0437 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e\n\u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\u0430 \u0432 \u043c\u043e\u0447\u0435 \u0432\n\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\u0430 \u0432 \u043c\u043e\u0447\u0435 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u044b\n\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0410\u041a\u0422\u0413 \u043f\u043b\u0430\u0437\u043c\u044b \u0432\n\u0410\u041a\u0422\u0413 \u043f\u043b\u0430\u0437\u043c\u044b \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u044b\n\u0421\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0439 \u0442\u0435\u0441\u0442 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u0441\u0442\n\u0441 \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c\n\n\u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0411\u0435\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u043c\u043e\u0437\u0433\u0430\n\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0414\u043e\u043d\u043e\u0445\u044c\u044e \u041b\u0438\u0446\u043e \u00ab\u043b\u0435\u043f\u0440\u0438\u043a\u043e\u043d\u0430\u00bb, \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u0433\u0435\u043d\u0430 INSR\n(\u043b\u0435\u043f\u0440\u0435\u043a\u043e\u043d\u0438\u0437\u043c) \u0447\u0435\u0440\u043d\u044b\u0439 \u0430\u043a\u0430\u043d\u0442\u043e\u0437, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\n\u043a\u043b\u0438\u0442\u043e\u0440\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0435\u043d\u0430\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 INSR\n\u0436\u0438\u0440\u043e\u0432\u043e\u0439 \u0442\u043a\u0430\u043d\u0438,\n\u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0430\u0442\u0440\u043e\u0444\u0438\u044f,\n\u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f, \u0440\u0430\u043d\u043d\u044f\u044f\n\u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0442\u044c,\n\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u044c \u043a\n\u0438\u043d\u0441\u0443\u043b\u0438\u043d\u0443\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0420\u0430\u0431\u0441\u043e\u043d\u0430- \u041f\u0440\u043e\u0433\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0439 \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u0433\u0435\u043d\u0430 INSR\n\u041c\u0435\u043d\u0434\u0435\u043b\u0445\u043e\u043b\u043b\u0430 \u0432\u0438\u0434 \u0441 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0449\u0435\u0439 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\n\u0447\u0435\u043b\u044e\u0441\u0442\u044c\u044e; \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0433\u0435\u043d\u0430\n\u0