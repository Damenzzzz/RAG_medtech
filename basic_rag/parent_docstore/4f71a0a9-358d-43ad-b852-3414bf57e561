\n\u0438\u043c\u0435\u044e\u0442\u0441\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0433\u043b\u043e\u0442\u0430\u043d\u0438\u0435\u043c, \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u0444\u043e\u0440\u043c\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,\n\n\u0441\u0438\u0440\u043e\u043f). \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2212 4\n\u0433.\n\u0430\u043c\u043e\u043a\u0441\u043e\u0446\u0438\u043b\u043b\u0438\u043d + \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043f\u043e 30 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0423\u0414 \u0412 [1,2,5,8]\n\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u0447\u0430\u0441\u043e\u0432; \u0434\u0435\u0442\u0438 \u043e\u0442 1 \u0434\u043e 3 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e 30 \u043c\u0433/\u043a\u0433\n\n\u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441\u043e\u0432; \u0434\u0435\u0442\u0438 \u043e\u0442 3 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e 18\n\u043b\u0435\u0442 \u043f\u043e 30 \u043c\u0433/\u043a\u0433 (\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e 1,2\n\u0433) \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441\u043e\u0432\n\u043c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c \u0414\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 3 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e 11 \u043b\u0435\u0442 \u0441 \u0423\u0414 \u0412 [1,2,5,8]\n\n\u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u043c\u0435\u043d\u0435\u0435 50 \u043a\u0433 - 10-40 \u043c\u0433/\u043a\u0433 \u0423\n\u0434\u0435\u0442\u0435\u0439 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u0431\u043e\u043b\u0435\u0435 50 \u043a\u0433 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u0437\u044b, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043d\u044b\u0435\n\u0434\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0434\u043e 2 \u0433 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n\n19\n\n\u0433\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d \u0421\u0443\u0442\u043e\u0447\u043d\u044b\u0435 \u0434\u043e\u0437\u044b \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442: \u0423\u0414 \u0412 [1,2,5,8]\n\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c \u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u2013 2 \u2013 5 \u043c\u0433/\u043a\u0433, \u0434\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435\n\u043e\u0442 1 \u0433\u043e\u0434\u0430 \u0434\u043e 5 \u043b\u0435\u0442 \u2013 1,5 \u2013 3 \u043c\u0433/\u043a\u0433, 6 \u2013 14\n\u043b\u0435\u0442 \u2013 3 \u043c\u0433/\u043a\u0433. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0432\u0441\u0435\u0445 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 5 \u043c\u0433/\u043a\u0433. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0432\u0432\u043e\u0434\u044f\u0442 2 \u2013 3\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438\n\u0431\u0435\u043d\u0437\u0430\u0442\u0438\u043d 600 000 \u2013 1 200 000 \u041c\u0415 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439, \u0432 \u0423\u0