8\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0432 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 LBx \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0438\u0434\u0435\u0440\u043e\u0437\u0430 \u043f\u0435\u0447\u0435\u043d\u0438 \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u041e\u0431\u0449\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u043a\u043e- \u0410\u043d\u0430\u043c\u043d\u0435\u0437, \u0424\u041f\u041f, IgE, \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0432\u044f\u0437\u0438 \u0441 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0442\u0435\u0441\u0442 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0435\u043c\u043e\u043c \u043f\u0440\u0438\u0447\u0438\u043d\u043d\u043e\u0433\u043e \u043f\u0435\u0447\u0435\u043d\u0438 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043e\u0432, \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430, \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0432 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u0442\u0435\u0441\u0442\u043e\u0432 \u0438 LBx \u0433\u0435\