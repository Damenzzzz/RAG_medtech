{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_4c5e8a877357", "title": "\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0413\u0435\u043d\u0442\u0438\u043d\u0433\u0442\u043e\u043d\u0430", "source_file": "2025_\u0411\u043e\u043b\u0435\u0437\u043d\u044c_\u0413\u0435\u043d\u0442\u0438\u043d\u0433\u0442\u043e\u043d\u0430_dbf7d7ceec.pdf", "icd_codes": "G10, B20", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0413\u0435\u043d\u0442\u0438\u043d\u0433\u0442\u043e\u043d\u0430.pdf"}, "page_content": "\u0414\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0431\u0430\u043b\u0430\u043d\u0441\u0430, \u0445\u043e\u0434\u044c\u0431\u044b, \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u0441\u0430\u043c\u043e\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0411\u0413\n\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f \u0432 \u0432\u0438\u0434\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u0441\n\u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440\u043e\u043c \u041b\u0424\u041a [38]. \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0411\u0413 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u044b \u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f\n(\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0410), \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0438\u043b\u0438 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430\u043c\u0438 \u0441\n\u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u0438\u044f\u043c\u0438 \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u043e\u0440\u043c\u044b \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439, \u0430\n\n\u0442\u0430\u043a\u0436\u0435 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u0445\u043e\u0434\u044c\u0431\u044b \u043f\u043e\u0434 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u043c (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0410) [39].\n\u0413\u0438\u0433\u0438\u0435\u043d\u0430 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0442 \u043e\u0442 \u043f\u043b\u043e\u0445\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430 \u043f\u043e \u0440\u044f\u0434\u0443 \u043f\u0440\u0438\u0447\u0438\u043d,\n\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0435\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0441 \u0447\u0438\u0441\u0442\u043a\u043e\u0439\n\n\u0437\u0443\u0431\u043e\u0432) \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u043a \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430, \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u0432\u043b\u0438\u044f\u044e\u0449\u0438\u0445 \u043d\u0430 \u0441\u0435\u043a\u0440\u0435\u0446\u0438\u044e \u0441\u043b\u044e\u043d\u044b, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0447\u0430\u0441\u0442\u044b\u0435 \u0442\u0440\u0430\u0432\u043c\u044b \u0437\u0443\u0431\u043e\u0432 \u0438\u0437-\u0437\u0430\n\u043f\u0430\u0434\u0435\u043d\u0438\u0439 \u0438 \u0442\u0440\u0430\u0432\u043c, \u0431\u0440\u0443\u043a\u0441\u0438\u0437\u043c.\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u0430\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441 \u0432\u0440\u0430\u0447\u0430\u043c\u0438-\n\n\u0434\u0438\u0435\u0442\u043e\u043b\u043e\u0433\u0430\u043c\u0438, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043a\u0430\u0440\u0438\u0435\u0441\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e (\u0443\u0440\u043e\u0432\u0435\u043d\u044c C)\n[40,41]. \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0438 \u043b\u0438\u0446\u0430\u043c, \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u044e\u0449\u0438\u043c \u0443\u0445\u043e\u0434, \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044c \u0443\u0441\u0442\u043d\u044b\u0435 \u0438\n\u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u0433\u0438\u0433\u0438\u0435\u043d\u0443 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430 \u0432\n\u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0421) [42]. \u0421\u0442\u043e\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043d\u0430\n\n\u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0434\u0430\u0446\u0438\u0438 (\u043c\u0438\u0434\u0430\u0437\u043e\u043b\u0430\u043c, \u0434\u0438\u0430\u0437\u0435\u043f\u0430\u043c)\n\u0438\u043b\u0438 \u043e\u0431\u0449\u0435\u0439 \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438 \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0421) [43].\n\u0412\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0445\u043e\u0440\u0435\u0435\u0439 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0442\u0430\u043a\u043e\u0433\u043e \u043a\u0430\u043a \u0448\u043b\u0435\u043c\u044b, \u043c\u044f\u0433\u043a\u0438\u0435 \u043a\u0440\u0435\u0441\u043b\u0430 \u0441 \u043e\u0442\u043a\u0438\u0434\u043d\u043e\u0439\n\u0441\u043f\u0438\u043d\u043a\u043e\u0439, \u043d\u0438\u0437\u043a\u0438\u0435 \u043a\u0440\u043e\u0432\u0430\u0442\u0438, \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u043d\u043e\u0435 \u043a\u0440\u0435\u0441\u043b\u043e \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u043e\u0431\u043b\u0435\u043d\u0438\u044f [19].\n\u0412\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043c\u043e\u0447\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b \u043f\u043e\u0434\u0433\u0443\u0437\u043d\u0438\u043a\u0438 \u0438\n\u0443\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u043a\u043b\u0430\u0434\u043a\u0438. \u041f\u0440\u0438 \u043d\u0435\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0438 \u043a\u0430\u043b\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043c\u043e\u0433\u0443\u0442 \u043e\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b \u043a\u0430\u043b\u043e\u043f\u0440\u0438\u0435\u043c\u043d\u0438\u043a\u0438.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f.\n\u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0411\u0413 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0434\u043b\u044f\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u0440\u0438\u0441. 2).\n\n21\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a 2. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0411\u0413.\n\n22\n\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0445\u043e\u0440\u0435\u0438.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2 \u2013 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0445\u043e\u0440\u0435\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437\u0430\n[19,32].\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435 \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 1 \u043b\u0438\u043d\u0438\u0438\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0422\u0435\u0442\u0440\u0430\u0431\u0435\u043d\u0430\u0437\u0438\u043d* \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 12,5 \u0410\n\u0432\u0435\u0437\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043c\u0433 \u043e\u0442 1 \u0434\u043e 3 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\n\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0447\u0438\u043a\u0430 \u0414\u0430\u043b\u0435\u0435 \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c\n\u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u0432 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 1 \u0440\u0430\u0437 \u0432 3\u20134 \u0434\u043d\u044f \u043d\u0430\n(VMAT2), 12,5 \u043c\u0433 \u0434\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\n\u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043d\u0435\u0439\u0440\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u043b\u0438 \u0434\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f\n\u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432\n(\u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442,\n\n\u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f).\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 200 \u043c\u0433\n\u0432 \u0441\u0443\u0442\u043a\u0438\n\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0414\u0435\u0443\u0442\u0435\u0442\u0440\u0430\u0431\u0435\u043d\u0430\u0437\u0438\u043d \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 6 \u043c\u0433 \u0410\n\u0432\u0435\u0437\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e * \u0432\u043d\u0443\u0442\u0440\u044c.\n\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0447\u0438\u043a\u0430 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n\u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438\n\n(VMAT2), \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e, \u043a\u0430\u0436\u0434\u044b\u0435 7 \u0434\u043d\u0435\u0439\n\u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0430 6 \u043c\u0433.\n\u043d\u0435\u0439\u0440\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u0421\u0440\u0435\u0434\u043d\u044f\u044f \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u2013 12 \u043c\u0433.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 36 \u043c\u0433.\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 2 \u043b\u0438\u043d\u0438\u0438\n\u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u041e\u043b\u0430\u043d\u0437\u0430\u043f\u0438\u043d \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 5 \u043c\u0433 \u0412\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0432\u043d\u0443\u0442\u0440\u044c.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 30 \u043c\u0433.\n\u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0420\u0438\u0441\u043f\u0435\u0440\u0438\u0434\u043e\u043d \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 0,5 \u043c\u0433 \u0412\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c \u0432\u043d\u0443\u0442\u0440\u044c, \u043f\u0440\u0438\n\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430,\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0434\u043e 1\n\u043c\u0433 (\u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430 \u043f\u043e 0,5\n\n\u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c).\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 4\u20136 \u043c\u0433\n\n23\n\n\u0411\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u044b \u041a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 0,5 C\n\n\u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 2-3 \u043c\u0433\n\u0422\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0413\u0430\u043b\u043e\u043f\u0435\u0440\u0438\u0434\u043e\u043b \u041f\u043e 0,5-1 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c 1-2 \u0440\u0430\u0437\u0430 C\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0432 \u0434\u0435\u043d\u044c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 10 \u043c\u0433\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2.1 \u2013 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0445\u043e\u0440\u0435\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437\u0430\n\u0432 \u0434\u0435\u0442\u0441\u043a\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 [54-58].\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435 \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 1 \u043b\u0438\u043d\u0438\u0438\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0422\u0435\u0442\u0440\u0430\u0431\u0435\u043d\u0430\u0437\u0438\u043d* 12,5 \u043c\u0433 \u043e\u0442 1 \u0434\u043e 3 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0410\n\u0432\u0435\u0437\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0414\u0430\u043b\u0435\u0435 \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c\n\n\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0447\u0438\u043a\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 1 \u0440\u0430\u0437 \u0432 3\u20134 \u0434\u043d\u044f \u043d\u0430\n\u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u0432 12,5 \u043c\u0433 \u0434\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\n(VMAT2), \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430\n\n\u043d\u0435\u0439\u0440\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u0438\u043b\u0438 \u0434\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432\n(\u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442,\n\u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f).\n\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 200 \u043c\u0433\n\u0432 \u0441\u0443\u0442\u043a\u0438\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0414\u0435\u0443\u0442\u0435\u0442\u0440\u0430\u0431\u0435\u043d\u0430\u0437\u0438\u043d \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 6 \u043c\u0433 \u0410\n\n\u0432\u0435\u0437\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e * \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e \u0443 \u0434\u0435\u0442\u0435\u0439 \u0432\n\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0447\u0438\u043a\u0430 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 6-16 \u043b\u0435\u0442.\n\u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u0432 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n(VMAT2), \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438\n\n\u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e, \u043a\u0430\u0436\u0434\u044b\u0435 7 \u0434\u043d\u0435\u0439\n\u043d\u0435\u0439\u0440\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u043d\u0430 6 \u043c\u0433.\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0421\u0440\u0435\u0434\u043d\u044f\u044f \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u2013 12 \u043c\u0433.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 36 \u043c\u0433.\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 2 \u043b\u0438\u043d\u0438\u0438\n\u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0420\u0438\u0441\u043f\u0435\u0440\u0438\u0434\u043e\u043d \u0414\u0435\u0442\u044f\u043c \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0412\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0434\u0432\u0430\u0436\u0434\u044b \u0432 \u0434\u0435\u043d\u044c, \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0435: 2-12 \u043b\u0435\u0442 -\n0,5-2 \u043c\u0433; \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 12-18\n\u043b\u0435\u0442 1-4 \u043c\u0433.\n\n24\n\n\u0411\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u044b \u041a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c \u0414\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 1-5 \u043b\u0435\u0442 C\n\n\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 250\n\u043c\u043a\u0433/\u0441\u0443\u0442; \u0434\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 5-\n12 \u043b\u0435\u0442 - 500 \u043c\u043a\u0433/\u0441\u0443\u0442,\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e.\n\n\u041f\u043e\u