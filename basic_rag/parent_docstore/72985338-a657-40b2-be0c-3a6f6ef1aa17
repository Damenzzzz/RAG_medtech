 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0430 \u0438 \u0410\u041b\u0410\u0422\n\n(\u043f\u0440\u0438 \u0433\u0435\u043f\u0430\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u0438 \u0438 \u0436\u0435\u043b\u0442\u0443\u0445\u0435) \u0432 \u043a\u0440\u043e\u0432\u0438: \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0435\u043c\u0438\u044f,\n\u0433\u0438\u043f\u0435\u0440\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0435\u043c\u0438\u044f.\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438\n\n\u0441\u043b\u0438\u0437\u0438 \u0441 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d \u0438 \u0437\u0430\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043d\u043a\u0438 \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u0442\u043e\u043d\u0437\u0438\u043b\u043b\u0438\u0442\u0430.\n\u0433\u043b\u043e\u0442\u043a\u0438 \u043d\u0430 \u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u0438 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u043e-\n\u0430\u043d\u0430\u044d\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u044b\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 [1-5,9,12]:\n\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435 \u0412\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043e\u0432 \u0432 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0440\u043e\u0432\u0438\n\u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u044b \u0431\u043e\u043b\u0435\u043510% (\u0441\u043e 2-3 \u043d\u0435\u0434\u0435\u043b\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438)\n\u041b\u0438\u043c\u0444\u043e\u043c\u043e\u043d\u043e\u0446\u0438\u0442\u043e\u0437 \u0412\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043b\u0438\u043c\u0444\u043e\u043c\u043e\u043d\u043e\u0446\u0438\u0442\u043e\u0437\u0430 \u0432 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0440\u043e\u0432\u0438\n\nIgM VCA VCA, IgG- \u0412 \u043e\u0441\u0442\u0440\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434: IgM VCA \u0441 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445\nEBNA \u0432\u0438\u0440\u0443\u0441\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 4-6 \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0438\n\u042d\u043f\u0448\u0442\u0435\u0439\u043d\u0430- \u0411\u0430\u0440\u0440 \u0441\u043d\u0438\u0436\u0430\u044e\u0442\u0441\u044f, IgG EA \u0441 \u043f\u0435\u0440\u0432\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0442 \u0434\u043e\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0435, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u043d\u0430 \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435, IgG\nVCA \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f IgM\nVCA, \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0442, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435,\n\nIgG-EBNA-1, 2- \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0438\u043b\u0438 \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435.\n\u0412 \u043f\u0435\u0440\u0438\u043e\u0434 \u0440\u0435\u043a\u043e\u043d\u0432\u0430\u043b\u0435\u0441\u0446\u0435\u043d\u0446\u0438\u0438: IgM VCA \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0438\u043b\u0438 \u0438\u043c\u0435\u044e\u0442\u0441\u044f\n\u0432 \u043c\u0430\u043b\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435, IgG EA \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u043d\u0430\n\u043d\u0435\u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435, IgG VCA \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e IgG EBNA\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c \u043