0435\u0439 [2]:\n\n\u2022 I \u0441\u0442\u0430\u0434\u0438\u044f \u2013 \u0434\u043e\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f;\n\u2022 II \u0441\u0442\u0430\u0434\u0438\u044f \u2013 \u043f\u0435\u0440\u0435\u043c\u0435\u0436\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0445\u0440\u043e\u043c\u043e\u0442\u0430;\n\u2022 III \u0441\u0442\u0430\u0434\u0438\u044f \u2013 \u0431\u043e\u043b\u0438 \u0432 \u043f\u043e\u043a\u043e\u0435 \u0438 \u00ab\u043d\u043e\u0447\u043d\u044b\u0435 \u0431\u043e\u043b\u0438\u00bb;\n\n\u2022 IV \u0441\u0442\u0430\u0434\u0438\u044f \u2013 \u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0438 \u0433\u0430\u043d\u0433\u0440\u0435\u043d\u0430 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439.\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f TASC II (2007\u0433.) [2]\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 No1. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439.\n\n\u041a\u043b\u0430\u0441\u0441 \u0410\u043e\u0440\u0442\u043e-\u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u044b\u0439 \u0441\u0435\u0433\u043c\u0435\u043d\u0442 \u0411\u0435\u0434\u0440\u0435\u043d\u043d\u043e-\u043f\u043e\u0434\u043a\u043e\u043b\u0435\u043d\u043d\u044b\u0439 \u0441\u0435\u0433\u043c\u0435\u043d\u0442\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\u0410 \u0423\u043d\u0438\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043b\u0438 \u0431\u0438\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0415\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0439 \u0441\u0442\u0435\u043d\u043e\u0437 <10 \u0441\u