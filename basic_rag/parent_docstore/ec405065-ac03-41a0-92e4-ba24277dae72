u043b\u044c\u0446\u0430 \u0441 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0435 \u0441\u0435\u0440\u0434\u0446\u0430.\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\n\u0443\u0442\u0440\u0430\u0442\u043e\u0439 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 \u0441\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u043b\u0430\u0442\u0430\u0446\u0438\u0435\u0439\n\u043a\u043e\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u041b\u0416, \u0421\u041d \u0441\n\u0441\u0438\u0441\u0442\u043e\u043b\u0438\u0447.\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439.\n\u0421\u0442\u0430\u0434\u0438\u044f \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u041f\u043e\u0442\u043e\u043a\u043e\u0432\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u041f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0447/\u0437 \u043a\u043b\u0430\u043f\u0430\u043d\nD \u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u2022 \u041e\u0420 \u2265 30 \u043c\u043b \u043d\u043e\u0440\u043c/\u0441\u043b\u0435\u0433\u043a\u0430 \u0421\u0435\u0440\u0434\u0435\u0447\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430;\n\u0422\u044f\u0436\u0451\u043b\u043e\u0433\u043e \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u2022 \u0424\u0420 \u2265 50% \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u043e\u0434\u044b\u0448\u043a\u0430;\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u043e\u043a\u0430 \u043a\u0438\u043d\u0435\u0442\u0438\u043a\u0438 \u041b\u0416 \u0441 \u2022 ERO \u2265 0,2 \u0441\u043c2 \u041b\u0416; \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n(symptomatic severe) \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0437\u043e\u043d\u044b \u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0442\u044f\u0436\u0435\u043d\u0438\u0435\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u043d\u043e\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0441\u0442\u0432\u043e\u0440\u043e\u043a; \u043a\u0438\u043d\u0435\u0442\u0438\u043a\u0438 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435;\n\u2022 \u0434\u0438\u043b\u0430\u0442\u0430\u0446\u0438\u044f \u041b\u0416; \u0422\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f,\n\u0444.\u043a\u043e\u043b\u044c\u0446\u0430 \u0441 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0435\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\n\u0443\u0442\u0440\u0430\u0442\u043e\u0439 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 \u0441\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u043b\u0430\u0442\u0430\u0446\u0438\u0435\u0439\n\u043a\u043e\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u041b\u0416 \u0438\n\u0441\u0438\u0441\u0442\u043e\u043b\u0438\u0447.\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0440\u0438\u0441\u043a\u0430 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0412\u041e\u0417:\n\u041c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u0438\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e- \u0412\u0435\u0434\u0435\u043d\u0438\u0435 \u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u041c\u0435\u0441\u0442\u043e\n\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0439 \u0440\u0438\u0441\u043a \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432\