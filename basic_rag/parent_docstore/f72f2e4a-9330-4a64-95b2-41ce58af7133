4\u043d\u0435\u0439 \u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b \u0412\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0447\u0430\u0441\u043e\u0432 \u0432\u043d\u0443\u0442\u0440\u044c \u044c\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e,\n\u0438\u043b\u0438 500 \u043c\u0433, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432/\u0432 \u043d\u0435 \u043d\u0438\u0442\u0440\u043e\u0438\u043c\u0438\u0434\u0430\u0437\u043e\u043b\n\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0433\u043e \u0430\n(\u0441\u0442\u0440\u0443\u0439\u043d\u043e\u0433\u043e)\n\u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u2014\n5 \u043c\u043b/\u043c\u0438\u043d.\n\u0424\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u044b\n33 \u0446\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d 250-500\u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432\u043d\u0443\u0442\u0440\u044c 7-10 \u0434\u043d\u0435\u0439 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u044b \u0412\n\u0438\u043b\u0438\n34 \u043b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d 250\u2013750 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c, 7-10 \u0434\u043d\u0435\u0439 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u044b \u0410\n\u0438\u043b\u0438 \u0441\u0443\u0442\u043a\u0438 \u0432/\u0432\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n35 \u041c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434 5\u201310 \u043c\u0433 1-2 \u043c\u043b 1-3 \u0440\u0430\u0437\u0430 \u0432 \u0432/\u043c 2-6 \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\