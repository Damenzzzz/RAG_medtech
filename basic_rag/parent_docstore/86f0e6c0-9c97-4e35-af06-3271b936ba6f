{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_ef0bd77527da", "title": "\u0412\u0418\u0420\u0423\u0421\u041d\u042b\u0415 \u041a\u0418\u0428\u0415\u0427\u041d\u042b\u0415 \u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418 \u0423 \u0414\u0415\u0422\u0415\u0419", "source_file": "2025_\u0412\u0418\u0420\u0423\u0421\u041d\u042b\u0415_\u041a\u0418\u0428\u0415\u0427\u041d\u042b\u0415_\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418_\u0423_\u0414\u0415\u0422\u0415\u0418_c0b9dd392c.pdf", "icd_codes": "A08.0, A08.1, A08.2, A08.3, A08.4, A08.5, K59.1", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0412\u0418\u0420\u0423\u0421\u041d\u042b\u0415 \u041a\u0418\u0428\u0415\u0427\u041d\u042b\u0415 \u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418 \u0423 \u0414\u0415\u0422\u0415\u0419.pdf"}, "page_content": "\u0446\u0438\u0444\u0440, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438 \u2022 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0442\u0443\u043b\u0430 \u043f\u0440\u0438\n\u0440\u0435\u0434\u043a\u043e \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 2-4 \u0434\u043d\u044f. \u044d\u043d\u0442\u0435\u0440\u0438\u0442\u0435 \u2014 \u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0433\u043e, \u0431\u0435\u0437 \u0437\u0430\u043f\u0430\u0445\u0430, \u0441\n\u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f: \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u043a\u043e\u043c\u043e\u0447\u043a\u0430\u043c\u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0441\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0437\u0435\u043b\u0435\u043d\u044c\u044e;\n\n(\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c\u044e, \u0432\u044f\u043b\u043e\u0441\u0442\u044c\u044e, \u2022 \u0443\u0440\u0447\u0430\u043d\u0438\u0435 \u043f\u043e \u0445\u043e\u0434\u0443 \u0442\u043e\u043d\u043a\u043e\u0433\u043e \u0438/\u0438\u043b\u0438\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430 \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0442\u043e\u043b\u0441\u0442\u043e\u0433\u043e \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430;\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u0438 \u0438 \u0430\u0434\u0438\u043d\u0430\u043c\u0438\u0438 \u2022 \u043c\u0435\u0442\u0435\u043e\u0440\u0438\u0437\u043c;\n\n\u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0438), \u2022 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u0436\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u0430\u043d\u0443\u0441\u0430, \u043d\u0430\n\n\u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u0438\u043b\u0438 \u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u044b\u0439 \u044f\u0433\u043e\u0434\u0438\u0446\u0430\u0445, \u043f\u0440\u043e\u043c\u0435\u0436\u043d\u043e\u0441\u0442\u0438.\n\u0440\u0432\u043e\u0442\u043e\u0439 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 1-2 \u0434\u043d\u0435\u0439, \u0411\u043e\u043b\u0435\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c:\n\u0434\u0438\u0430\u0440\u0435\u0435\u0439 \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430, \u2022 \u043f\u0440\u0438 \u0433\u0430\u0441\u0442\u0440\u0438\u0442\u0435 - \u0431\u043e\u043b\u0438 \u0432 \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u0430\u0445\n\u0431\u0435\u0437 \u0432\u0438\u0434\u0438\u043c\u044b\u0445 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u0430, \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0432 \u044d\u043f\u0438\u0433\u0430\u0441\u0442\u0440\u0438\u0438;\n\n\u043f\u0440\u0438\u043c\u0435\u0441\u0435\u0439 \u2022 \u043f\u0440\u0438 \u044d\u043d\u0442\u0435\u0440\u0438\u0442\u0435 - \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432\n\u043e\u043a\u043e\u043b\u043e\u043f\u0443\u043f\u043e\u0447\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u043b\u0438 \u043f\u043e \u0432\u0441\u0435\u043c\u0443\n\u0436\u0438\u0432\u043e\u0442\u0443. \u042d\u043a\u0441\u0438\u043a\u043e\u0437:\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430 \u0432\n\n\u0432\u0438\u0434\u0435 \u0441\u0443\u0445\u043e\u0441\u0442\u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a \u0438 \u043a\u043e\u0436\u0438,\n\u0436\u0430\u0436\u0434\u044b \u0438\u043b\u0438 \u043e\u0442\u043a\u0430\u0437\u0430 \u043e\u0442 \u043f\u0438\u0442\u044c\u044f, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u044d\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0436\u0438 \u0438 \u0442\u0443\u0440\u0433\u043e\u0440\u0430 \u0442\u043a\u0430\u043d\u0435\u0439,\n\u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0445 \u0433\u043b\u0430\u0437;\n\n\u2022 \u0437\u0430\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u0440\u043e\u0434\u043d\u0438\u0447\u043a\u0430 (\u0443 \u0434\u0435\u0442\u0435\u0439\n\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430);\n\u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f;\n\u2022 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430;\n\n\u2022 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u0434\u0438\u0443\u0440\u0435\u0437\u0430.\n\u2022 \u041d\u0435\u0439\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u043a\u043e\u0437:\n\u2022 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u043f\u043b\u043e\u0445\u043e \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0430\u044f \u043d\u0430\n\u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b;\n\u2022 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0432\u043e\u0442\u044b, \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439 \u0441\n\n\u043f\u0440\u0438\u0435\u043c\u043e\u043c \u043f\u0438\u0449\u0438 \u0438 \u043d\u0435 \u043f\u0440\u0438\u043d\u043e\u0441\u044f\u0449\u0435\u0439\n\u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u0435;\n\u2022 \u0441\u0443\u0434\u043e\u0440\u043e\u0433\u0438;\n\u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438;\n\u2022 \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f.\n\u2022 \u0421\u0438\u043d\u0434\u0440\u043e\u043c \u043e\u0431\u043c\u0435\u043d\u043d\u044b\u0445 (\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445)\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439:\n\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u0438 -\u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f\n\u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0430\u0434\u0438\u043d\u0430\u043c\u0438\u044f,\n\u2022 \u0433\u0438\u043f\u043e\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, \u043f\u0430\u0440\u0435\u0437 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430;\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u0446\u0438\u0434\u043e\u0437\u0430 -\n\n\u043c\u0440\u0430\u043c\u043e\u0440\u043d\u043e\u0441\u0442\u044c \u0438 \u0446\u0438\u0430\u043d\u043e\u0437 \u043a\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432,\n\u0448\u0443\u043c\u043d\u043e\u0435 \u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435,\n\u0441\u043f\u0443\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\n\u0412\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u0438 \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u044b\n\n\u0420\u043e\u0442\u0430\u0432\u0438\u0440\u0443\u0441\u044b \u0432\u0435\u0434\u0443\u0449\u0438\u043c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u043c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0447\u0430\u0441\u0442\u044b\u0439\n\u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b.\n\n\u043d\u043e\u0440\u0444\u043e\u043b\u043a \u2013 \u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0442 \u0442\u0430\u043a\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u043a\u0430\u043a\n\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0442\u043e\u0448\u043d\u043e\u0442\u0430 \u0438 \u0440\u0432\u043e\u0442\u0430 (\u0431\u043e\u043b\u0435\u0435 90% \u0441\u043b\u0443\u0447\u0430\u0435\u0432), \u0430 \u0434\u0438\u0430\u0440\u0435\u044f \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f\n\u043b\u0438\u0448\u044c \u0443 40% \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432. \u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u0441\u0442\u0443\u043b\u0430 \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442, \u043a\u0430\u043a\n\u043f\u0440\u0430\u0432\u0438\u043b\u043e, 4-8 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\n\u0410\u0441\u0442\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443 \u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 3-4 \u043b\u0435\u0442.\n\u0412\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b \u0447\u0430\u0441\u0442\u043e \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u043c. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0434\u0438\u0430\u0440\u0435\u0438\n\n\u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 2-3 \u0434\u043d\u0435\u0439.\n\u0410\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442, \u0442\u043e\u043d\u0437\u0438\u043b\u043b\u0438\u0442, \u0440\u0438\u043d\u0438\u0442, \u043a\u043e\u043d\u044a\u044e\u043a\u0442\u0438\u0432\u0438\u0442, \u044d\u043d\u0442\u0435\u0440\u0438\u0442.\n\n\u042d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u0433\u0435\u0440\u043f\u0430\u043d\u0433\u0438\u043d\u0430, \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u0430, \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u0438\u0442.\n\n\u041a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u044b \u043b\u0430\u0440\u0438\u043d\u0433\u0438\u0442, \u0431\u0440\u043e\u043d\u0445\u0438\u0442, \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f, \u044d\u043d\u0442\u0435\u0440\u0438\u0442.\n\n\u0426\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u0436\u0435\u043b\u0442\u0443\u0445\u0430, \u0431\u0440\u043e\u043d\u0445\u0438\u0442, \u044d\u043d\u0442\u0435\u0440\u0438\u0442.\n\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0443 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 (\u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0412\u041e\u0417 \u0438 ESPGHAN/ESPID\n(2008, 2014)):\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432 % \u043f\u043e \u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432\n\n\u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e \u043a \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430 \u043c\u043b/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u041d\u0435\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 <5% <50 \u043c\u043b/\u043a\u0433\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f\n\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f 5-10% 50-100 \u043c\u043b/\u043a\u0433\n\n\u0441\u0442\u0435\u043f\u0435\u043d\u044c\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f\n\u041e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435 >10% >100 \u043c\u043b/\u043a\u0433\n\u0432 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u0435\n\n\u0422\u044f\u0436\u0435\u0441\u0442\u044c \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438 \u0432 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0430\u0445 \u043e\u0442 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0434\u043e\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f:\n\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u041b\u0435\u0433\u043a\u0430\u044f % \u0421\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 % \u0422\u044f\u0436\u0435\u043b\u0430\u044f %\n\nDell (1973) 5 5-10 10 -15\nRobson (1987) 4-5 6-9 \u2265 10\nESPGHAN \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0448\u043a\u0430\u043b\u0443 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438\n\n(Clinical Dehydration Scale \u2013 CDS), \u0433\u0434\u0435 0 \u0431\u0430\u043b\u043b\u043e\u0432 \u2013 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u043e\u0442\n1 \u0434\u043e 4 \u0431\u0430\u043b\u043b\u043e\u0432 \u2013 \u043b\u0435\u0433\u043a\u0430\u044f \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f, 5\u20138 \u0431\u0430\u043b\u043b\u043e\u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438\n\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438.\n\nClinical Dehydration Scale (CDS):\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a \u0411\u0430\u043b\u043b\u044b\n0 1 2\n\u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0416\u0430\u0436\u0434\u0430, \u0412\u044f\u043b\u043e\u0441\u0442\u044c,\n\n\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e, \u0441\u043e\u043d\u043b\u0438\u0432\u043e\u0441\u0442\u044c\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u044f\u0431\u043b\u043e\u043a\u0438 \u041d\u0435 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0421\u043b\u0435\u0433\u043a\u0430 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0417\u0430\u043f\u0430\u0432\u0448\u0438\u0435\n\n\u0421\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0435 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0412\u043b\u0430\u0436\u043d\u044b\u0435 \u0441\u0443\u0445\u043e\u0432\u0430\u0442\u044b\u0435 \u0421\u0443\u0445\u0438\u0435\n\n\u0421\u043b\u0435\u0437\u044b \u0421\u043b\u0435\u0437\u043e\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432 \u0421\u043b\u0435\u0437\u043e\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0421\u043b\u0435\u0437\u044b\n\u043d\u043e\u0440\u043c\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\n\u0422\u044f\u0436\u0435\u0441\u0442\u044c \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u043f\u043e \u0418\u0412\u0411\u0414\u0412 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0434\u043e 5 \u043b\u0435\u0442 [1,3]:\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u041d\u0435\u0442 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u0422\u044f\u0436\u0435\u043b\u043e\u0435\n\u0434\u0432\u0443\u0445 \u0438 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435\n\u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435\n\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e \u041d\u0435\u0442 \u0434\u0432\u0443\u0445 \u2022 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e \u2022 \u0437\u0430\u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c/\u043f\u043e\u043d\n\u0432 \u0438\u0436\u0435.\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0438\u043b\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u043c\u043e\u0441\u0442\u044c; \u2022 \u043f\u044c\u0435\u0442 \u043f\u043b\u043e\u0445\u043e, \u0438\u043b\u0438 \u043d\u0435\n\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u2022 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0433\u043b\u0430\u0437\u0430; \u043c\u043e\u0436\u0435\u0442 \u043f\u0438\u0442\u044c;\n\u2022 \u043a\u043e\u0436\u043d\u0430\u044f \u0441\u043a\u043b\u0430\u0434\u043a\u0430 \u2022 \u0437\u0430\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0433\u043b\u0430\u0437\u043d\u044b\u0445\n\u0440\u0430\u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u044f\u0431\u043b\u043e\u043a;\n\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e (\u0434\u043e 2 \u0441); \u2022 \u043e\u0447\u0435\u043d\u044c \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435\n\n\u0440\u0430\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u0436\u043d\u043e\u0439\n\u2022 \u0440\u0435\u0431\u0435\u043d\u043e\u043a \u043f\u044c\u0435\u0442 \u0441 \u0441\u043a\u043b\u0430\u0434\u043a\u0438 (\u0431\u043e\u043b\u0435\u0435 2 \u0441).\n\u0436\u0430\u0434\u043d\u043e\u0441\u0442\u044c\u044e.\nNB! \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u043e \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\n\u0448\u043e\u043a\u0430: \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0435 \u0440\u0443\u043a\u0438, \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0435 3 \u0441., \u0441\u043b\u0430\u0431\u044b\u0439 \u0438\n\u0447\u0430\u0441\u0442\u044b\u0439 \u043f\u0443\u043b\u044c\u0441.\n\n\u0412\u0438\u0434\u044b \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b [1,2]:\n\u0421\u0435\u043a\u0442\u043e\u0440 \u0412\u0438\u0434 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430\n\n\u0412\u043d\u0443\u0442\u0440\u0438\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f \u0436\u0430\u0436\u0434\u0430, \u0441\u0443\u0445\u043e\u0441\u0442\u044c \u044f\u0437\u044b\u043a\u0430, \u0432\u043e\u0437\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u0435\n\u0433\u0438\u043f\u0435\u0440\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f \u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043a \u0432\u043e\u0434\u0435, \u0440\u0432\u043e\u0442\u0430\n\u0438\u043d\u0442\u0435\u0440\u0441\u04