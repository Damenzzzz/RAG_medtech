u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0440\u0435\u0432\u043e\u0433\u0438, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438, \u0430\u043f\u0430\u0442\u0438\u0438 \u043f\u0440\u0438 \u0411\u0413 [32].\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0426\u0438\u0442\u0430\u043b\u043e\u043f\u0440\u0430\u043c \u041d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0441 10-20 \u043c\u0433 \u0432 \u0434\u0435\u043d\u044c C\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0432\u043d\u0443\u0442\u0440\u044c.\n\n\u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 40 \u043c\u0433 (\u0443\n\u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u2013 20 \u043c\u0433)\n\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0421\u0435\u0440\u0442\u0440\u0430\u043b\u0438\u043d \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 50 \u043c\u0433 C\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0432\u043d\u0443\u0442\u0440\u044c.\n\u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u041c\u0430\u043a\u0441\