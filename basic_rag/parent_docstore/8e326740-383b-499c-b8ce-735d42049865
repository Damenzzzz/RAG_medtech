435\u0434\u0441\u0442\u0432\n(\u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 3):\n\n\u2022 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u0443 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u0430\u043c\u0438 \u0434\u043e\u043f\u0430-\n\u0434\u0435\u043a\u0430\u0440\u0431\u043e\u043a\u0441\u0438\u043b\u0430\u0437\u044b;\n\u2022 \u0430\u0433\u043e\u043d\u0438\u0441\u0442\u044b \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0445 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432;\n\n\u2022 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u043e\u043a\u0441\u0438\u0434\u0430\u0437\u044b \u0442\u0438\u043f\u0430 \u00ab\u0412\u00bb;\n\u2022 \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442\u044b N-\u043c\u0435\u0442\u0438\u043b-D-\u0430\u0441\u043f\u0430\u0440\u0442\u0430\u0442\u0430 (\u0433\u043b\u0443\u0442\u0430\u043c\u0430\u0442\u0430);\n\u2022 \u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0438 (\u0430\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430);\n\u2022 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043a\u0430\u0442\u0435\u0445\u043e\u043b-\u041e-\u043c\u0435\u0442\u0438\u043b\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u044b (\u041a\u041e\u041c\u0422) [1; 6].\n\n16\n\n\u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 3. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u041f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0430 [1]\n\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\nNo \u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430\n\u043b\u0435\u0432\u043e\u0434\u043e\u043f\u0430 100/25 250/25\n\u041b\u0435\u0432\u043e\u0434\u043e\u043f\u0430 + \u0410\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0441\u0438\u043d\u0442\u0435\u0437\u0430 +\u043a\u0430\u0440\u0431\u0438\u0434\u043e\u043f\u0430 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c 3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n1. \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0434\u043e\u043f\u0430-\n\u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u0430 + 100/25 200/50\n\u0434\u0435\u043a\u0430\u0440\u0431\u043e\u043a\u0441\u0438\u043b\u0430\u0437\u044b \u0410\n\u0431\u0435\u043d\u0441\u0435\u0440\u0430\u0437\u0438\u0434* 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c 4 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n\u0410\u0433\u043e\u043d\u0438\u0441\u0442\u044b \u043f\u0440\u044f\u043c\u0430\u044f \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f\n0,125 \u043c\u0433 4,5 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 3\n2. \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0445 \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u041f\u0440\u0430\u043c\u0438\u043f\u0435\u043a\u0441\u043e\u043b* \u0410\n3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u043f\u0440\u0438\u0435\u043c\u0430\n\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 (\u0410\u0414\u0420) \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b\n\u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u0442\u0430\u0431\u043e\u043b\u0438\u0437\u043c\u0430\n3. \u043c\u043e\u043d\u043e\u0430\u043c\u0438\u043d\u043e\u043a\u0441\u0438\u0434\u0430\u0437\u044b \u2013 \u0420\u0430\u0437\u0430\u0433\u0438\u043b\u0438\u043d* \u0410 1 \u043c\u0433 \u0443\u0442\u0440\u043e\u043c 1 \u043c\u0433\n\u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430\nB (\u041c\u0410\u041e \u2013 \u0412)\n\u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u0435 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e\n\u0410\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442\u044b N-\n\u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430 500 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432\n4. \u043c\u0435\u0442\u0438\u043b-D-\u0430\u0441\u043f\u0430\u0440\u0442\u0430\u0442\u0430 \u0410\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d* \u0412 100 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n\u043f\u0440\u0435\u0441\u0438\u043d\u0430\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c 3\u20134 \u043f\u0440\u0438\u0435\u043c\u0430\n(\u0433\u043b\u0443\u0442\u0430\u043c\u0430\u0442\u0430)\n\u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435\u043c\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0410\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d\u044d\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0445\u043e\u043b\u0438\u043d\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432\n\u0442\u0440\u0438\u0433\u0435\u043a\u0441\u0438- 10 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 3-4\n5. \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0435\u0435 \u0412 1 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n\u0444\u0435\u043d\u0438\u0434\u0438\u043b \u043f\u0440\u0438\u0435\u043c\u0430\n(\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0438) \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430\u0434\n\u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n17\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 - 4. \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u0435 \u0434\u043e 50 \u043b\u0435\u0442 [1; 3; 7]\n\n\u043d\u0430\u0447\u0430\u043b\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u043f\u0440\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439 \u041f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f\n\u043b\u0435\u0433\u043a\u0438\u0439 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439\n\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430\u043c\u0438\n\u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0439 \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0439\n\u0434\u0435\u0444\u0435\u043a\u0442 \u0434\u0435\u0444\u0435\u043a\u0442\n(\u0441\u0442\u0430\u0434\u0438\u044f \u043f\u043e (\u0441\u0442\u0430\u0434\u0438\u044f \u043f\u043e\n\u0425\u0435\u043d-\u042f\u0440\u0443 1 \u0425\u0435\u043d-\u042f\u0440\u0443 1-2\n\u0438\u043b\u0438 \u0448\u043a\u0430\u043b\u0435 \u0438\u043b\u0438 \u0448\u043a\u0430\u043b\u0435\nUPDRS UPDRS 10-30\n\u043c\u0435\u043d\u0435\u0435 10 \u0431\u0430\u043b\u043b\u043e\u0432)\n\u0431\u0430\u043b\u043b\u043e\u0432)\n1. \u041c\u0410\u041e-\u0412 + \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d* \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043c\u0430\u043b\u044b\u0435 \u0434\u043e\u0437\u044b\n2.\u041c\u0410\u041e-\u0412 + \u0410\u0414\u0420 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b (150-300\u043c\u0433\n3.\u041c\u0410\u041e-\u0412 + \u0410\u0414\u0420 + \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d* \u0432 \u0441\u0443\u0442\u043a\u0438)\n\u041c\u0410\u041e-\u0412 \u0410\u0414\u0420\n4. \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u0410\u0414\u0420\n5.\u041c\u0410\u041e-\u0412 + \u0410\u0414\u0420 + \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d* +\n\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a (\u0442\u0440\u0435\u043c\u043e\u0440)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u20135. \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u0435 50-70 \u043b\u0435\u0442 [1; 7; 8]\n\u043d\u0430\u0447\u0430\u043b\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u043b\u0435\u0433\u043a\u0438\u0439 \u0443\u043c\u0435\u0440\u0435\u043d\u043d \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439\n\u043c\u043e\u0442\u043e\u0440\u043d \u044b\u0439 \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0439\n\n\u044b\u0439 \u043c\u043e\u0442\u043e\u0440\u043d \u0434\u0435\u0444\u0435\u043a\u0442 (\u0441\u0442\u0430\u0434\u0438\u044f\n\u0434\u0435