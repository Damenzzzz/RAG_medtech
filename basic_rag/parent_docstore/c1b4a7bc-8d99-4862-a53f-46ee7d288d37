442\u043e\u043c\u044b \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e, \u0438 \u0441\u0435\u0433\u043c\u0435\u043d\u0442 ST \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e\n\u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u2013 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e \u0438\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f\n\u043d\u0438\u0442\u0440\u043e\u0433\u043b\u0438\u0446\u0435\u0440\u0438\u043d\u0430 (\u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u0430 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\u043b\u0438 \u043d\u0435\u0442\n\u043d\u043e\u0432\u043e\u0439 \u044d\u043b\u0435\u0432\u0430\u0446\u0438\u0438 \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 ST)\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0418\u041c\u0421\u041fST >12 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f I C\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u0427\u041a\u0412 \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\u0448\u0435\u043c\u0438\u0438,\n\u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0436\u0438\u0437\u043d\u0435\u0443\u0433\u0440\u043e\u0436\u0430\u044e\u0449\u0438\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u0445\n\u0440\u0438\u0442\u043c\u0430.\n\u0420\u0443\u0442\u0438\u043d\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u0427\u041a\u0412 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u0443 IIa \u0412\n\u043f\u043e\u0437\u0434\u043d\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u0432\u0448\u0438\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u2013 12-48 \u0447\u0430\u0441\u043e\u0432 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u0418\u041c\u0421\u041fST.\n\u0423 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u0440\u0443\u0442\u0438\u043d\u043d\u0430\u044f \u0427\u041a\u0412 \u043d\u0430 \u043e\u043a\u043a\u043b\u044e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 III \u0410\n\u0418\u0421\u0410 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430, \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0448\u043b\u043e >48 \u0447\u0430\u0441\u043e\u0432 \u043e\u0442 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0418\u041c\u0421\u041fST.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 14. \u0410\u043d\u0442\u0438\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u043c \u0427\u041a\u0412\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0414\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 P2Y12 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 (\u0442\u0438\u043a\u0430\u0433\u0440\u0435\u043b\u043e\u0440), \u0435\u0441\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0438\u043b\u0438 I \u0410\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e