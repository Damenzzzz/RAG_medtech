2\n\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u0432\u043e \u2013\n\u0444\u043e\u0441\u0444\u043e\u0440\u043d\u043e\u0433\u043e\n\u043e\u0431\u043c\u0435\u043d\u0430\n\n\u041a\u043e\u0440\u0440\u0435\u043a\u0442\u043e\u0440\u044b \u0410\u043b\u044c\u0444\u0430\u043a\u0430\u043b\u044c\u0446\u0438\u0434\u043e\u043b 0,5\u20134,0 \u043c\u043a\u0433 \u0412\n\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0437\u043c\u0430\n\u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0438\n\u0445\u0440\u044f\u0449\u0435\u0432\u043e\u0439 \u0442\u043a\u0430\u043d\u0438\n\n\u2022\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u0414\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u0438 \u0413\u0438\u0434\u0440\u043e\u0445\u043b\u043e\u0440\u0442\u0438\u0430\u0437\u0438\u0434 12,5\u2013 \u0412\n\n100 \u043c\u0433\n\u0414\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u0438 \u0425\u043b\u043e\u0440\u0442\u0430\u043b\u0438\u0434\u043e\u043d 25\u2013100 \u0412\n\u043c\u0433\n\n\u0414\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u0438 \u0418\u043d\u0434\u0430\u043f\u0430\u043c\u0438\u0434 1,25\u20135 \u0412\n\u043c\u0433\n\u041c\u0430\u043a\u0440\u043e \u2013 \u0438 \u0421\u0443\u043b\u044c\u0444\u0430\u0442 \u043c\u0430\u0433\u043d\u0438\u044f 50% \u0412\n\u043c\u0438\u043a\u0440\u043e\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u0440\u0430\u0441\u0442\u0432\u043e\u0440\n\n\u0411\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435:\n\u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u043a\u0430\u043b\u044c\u0446\u0438\u0438 \u0443 \u0431\u0435\u04