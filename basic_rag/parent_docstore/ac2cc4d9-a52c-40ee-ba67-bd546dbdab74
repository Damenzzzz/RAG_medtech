43a\u0441\u0430\u0442, \u0430\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d \u0438 \u043c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0430\u043d\u0442\u0438\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0442\u043d\u044b\u043c\u0438\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u043a\u0430\u043a \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442 \u0444\u043e\u043b\u0430\u0442\u0430, \u0430\u043d\u0430\u043b\u043e\u0433 \u043f\u0443\u0440\u0438\u043d\u0430 \u0438 \u0438\u043d\u0433\u0438\u0431\u0438-\n\u0442\u043e\u0440 \u0441\u0438\u043d\u0442\u0435\u0437\u0430 \u043f\u0443\u0440\u0438\u043d\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e.\n\n\u0421\u0438- \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 (\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438)\n\u0441\u0442\u0435\u043c- \u041b\u0421\n\u043d\u044b\u0435\n\n\u0438\u043c-\n\u043c\u0443-\n\u043d\u043e-\n\u0434\u0435-\n\u043f\u0440\u0435\u0441-\n\u0441\u0430\u043d-\n\u0442\u044b\n\u0426\u0438\u043a\u043b\u043e\u0441- \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e- \u0426\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438\n\u043f\u043e\u0440\u0438\u043d \u0440\u0438\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 3 \u043c\u0433 \u043d\u0430 \u043a\u0433 \u0410\u0442\u0414 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 (\u0423\u0414 - \u0421).\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 2 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0446\u0438\u043a\u043b\u043e\u0441-\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0441 12-\u0447\u0430\u0441\u043e\u0432\u044b\u043c \u0438\u043d- \u043f\u043e\u0440\u0438\u043d\u043e\u043c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c\n\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c. \u0412 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0441\u043b\u0443- \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438.\n\u0447\u0430\u044f\u0445 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u043e\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0441\u0438-\n\u0434\u043e\u0437\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043e-\n\u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e \u043c\u0430\u043a\u0441\u0438- \u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u043e\u0447\u0435\u043a \u0438 \u043f\u0435\u0447\u0435\u043d\u0438, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e-\n\n\u043c\u0430\u043b\u044c\u043d\u043e\u0439 - 5 \u043c\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u043a\u0430\u043b\u0438\u044f \u0438 \u043c\u0430\u0433\u043d\u0438\u044f \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 (\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\n\u0442\u0435\u043b\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e- \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043f\u043e\u0447\u0435\u043a),\n\u0441\u0442\u0438 \u043e\u0442 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u044b, \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430, \u043c\u043e\u0447\u0435\u0432\u043e\u0439\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430. \u041f\u0440\u0438 \u043a\u0438\u0441\u043b\u043e\u0442\u044b, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0430, \u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0445 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432,\n\u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c- \u0430\u043c\u0438\u043b\u0430\u0437\u044b \u0438 \u043b\u0438\u043f\u0438\u0434\u043e\u0432 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438.\n\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0434\u043e\u0437\u0443 \u041f\u0440\u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044e \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430 \u0441\u044b\u0432\u043e\u0440\u043e\u0442-\n\u0441\u043d\u0438\u0436\u0430\u0442\u044c \u0434\u043e \u043f\u043e\u043b\u043d\u043e\u0439 \u043e\u0442\u043c\u0435- \u043a\u0438 \u043a\u0440\u043e\u0432\u0438 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0432 \u0434\u0432\u0443\u0445 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f\u0445 \u0434\u043e\n\u043d\u044b. \u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u041a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044e \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430 \u0441\u043b\u0435-\n\u0426\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0434\u0443\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 \u0434\u0432\u0443\u0445\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u043d\u0442\u0435\u0440-\n\u0434\u0435\u0442\u044f\u043c \u0440\u0435\u0434\u043a\u043e, \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0442\u044f- \u0432\u0430\u043b\u0430\u043c\u0438 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0432\u044b\u0445 \u0442\u0440\u0435\u0445 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0442\u0435-\n\u0436\u0435\u043b\u043e\u0433\u043e \u0442\u0435\u0447\u0435\u043d\u0438\u044f \u0410\u0442\u0414 \u0438 \u043d\u0435- \u0440\u0430\u043f\u0438\u0438. \u0412 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c, \u0435\u0441\u043b\u0438 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f \u043a\u0440\u0435\u0430-\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0442\u0438\u043d\u0438\u043d\u0430 \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0439, \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0432 \u0434\u043e\u0437\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e.\n2,5-5 \u043c\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u041f\u0440\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043f\u043e-\n\u0441\u0443\u0442\u043a\u0438 \u0432 \u0434\u0432\u0430 \u043f\u0440\u0438\u0435\u043c\u0430. \u041f\u0440\u043e- \u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 \u0438\u043b\u0438 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u043e \u043d\u0430\u0440\u0443-\n\n\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 \u043b\u0435- \u0448\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043e\u0442\u043c\u0435\u043d\u044f\u044e\u0442.\n\u0447\u0435\u043d\u0438\u044f - \u043e\u0442 8 \u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e 3-12\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432.\n\n\u041c\u0435\u0442\u043e- \u0423 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0410\u0442\u0414 \u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u0438\u0441\u0442\u0435\u043c-\n\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0433\u043e \u0410\u0442\u0414\n\u0434\u043e\u0437\u0435 7,5-25 \u043c\u0433 / \u043d\u0435\u0434.; (\u0423\u0414 - \u0421). \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0410\u0442\u0414 \u0441 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438-\n\u0443 \u0434\u0435\u0442\u0435\u0439 \u2013 0,2-0,7 \u043c\u0433/\u043a\u0433/\u043d\u0435\u0434. \u0435\u043c \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442\u0430 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u043b\u0435-\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f \u0442\u0435\u0441\u0442 \u2013 \u0434\u043e- \u0434\u0443\u044e\u0449\u0438\u0445 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432: \u041e\u0410\u041a (\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b - \u043e\u0431\u044f\u0437\u0430-\n\u0437\u0430: 0,2-0,7 \u043c\u0433/\u043a\u0433/\u043d\u0435\u0434. \u0442\u0435\u043b\u044c\u043d\u043e); \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u0437\u043e\u0442\u0430 \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u044b \u043a\u0440\u043e\u0432\u0438 \u0438\n\u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430, \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u043e-\n\u0432\u043e\u0439 \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u043a\u043b\u0438\u0440\u0435\u043d\u0441\u0430 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430 (\u043f\u0440\u0438\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438); \u0431/\u0445: \u0410\u043b\u0410\u0422, A\u0441\u0410T, \u0449\u0435\u043b\u043e\u0447\u043d\u0430\u044f\n\u0444\u043e\u0441\u0444\u0430\u0442\u0430\u0437\u0430, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d, \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d.\n\u0414\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u0445\n\u0410\u0442\u0414 \u043d\u0430 \u0433\u0435\u043f\u0430\u0442\u0438\u0442-\u0412 \u0438 \u0421, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437. \u0416\u0435\u043d\u0449\u0438\u043d\u0430\u043c\n\u0434\u0435\u0442\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\n\u0442\u0435\u0441\u0442 \u043d\u0430 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c. \u0422\u0435\u0441\u0442 \u043d\u0430 \u0412\u0418\u0427 - \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443-\n\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0438\u0437 \u0433\u0440\u0443\u043f\u043f\u044b \u0440\u0438\u0441\u043a\u0430.\n\u0412\u044b\u0438\u0433\u0440\u044b\u0448 \u043e\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0444\u043e\u043b\u0430-\n\u0442\u043e\u0432 \u0432 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u0442\u043e \u043d\u0435-\n\n\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043c\u0435\u0442\u043e-\n\u0442\u0440\u0435\u043a\u0441\u0430\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043c\u0435\u0441\u0442\u043e.\n\u0410\u0437\u0430\u0442\u0438\u043e- \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u043e- \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u043a \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e\n\u043f\u0440\u0438\u043d \u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1-3 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u0430 \u0438\u043b\u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u0435\u0433\u043e \u043d\u0435\u044d\u0444\u0444\u0435\u043a-\n\u0442\u0435\u043b\u0430 \u0432 \u0434\u0435\u043d\u044c. \u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0410\u0442\u0414 \u043c\u043e\u0436\u043d\u043e\n\u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0430\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d (\u0423\u0414 - \u0421).\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0410\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d \u0432\n\u0430\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d\u0430 \u0432 \u0434\u043e\u0437\u0435 50 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 (\u0423\u0414 - C).\n\u043c\u0433/\u0434\u0435\u043d\u044c \u0438 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435 \u0443\u0432\u0435- \u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u0430\u0437\u0430\u0442\u0438\u043e-\n\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b \u043f\u0440\u0438 \u0442\u0449\u0430- \u043f\u0440\u0438\u043d\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0439\u0442\u0438 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435 \u043e\u0431\u0449\u0435\u0433\u043e \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0438\u043e\u043f\u0443\u0440\u0438\u043d S\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043a\u0440\u043e\u0432\u0438 \u0438 \u0444\u0443\u043d\u043a- \u2013 \u043c\u0435\u0442\u0438\u043b\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u044b, \u0447\u0442\u043e\u0431\u044b \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438-\n\u0446\u0438\u0438 \u043f\u0435\u0447\u0435\u043d\u0438. \u0442\u0438\u044f \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439.\n\u0410\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d \u043d\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043e\u0447\u0435\u0442\u0430\u0442\u044c \u0441 \u0423\u0424-\u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439,\n\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u0423\u0424-\u0437\u0430\u0449\u0438\u0442\u0443.\n\n\u0411\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b [1-3, 23,24]:\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043a \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u044f\u0432-\n\n\u043b\u044f\u044e\u0442\u0441\u044f \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u0410\u0442\u0414, \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0435 \u043a \u043c\u0435\u0441\u0442\u043d\u043e\u043c\u0443 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u043c\u0443 \u043b\u0435\u0447\u0435\u043d\u0438\u044e\n(\u0423\u0414 - \u0421).\n\u0412 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0410\u0442\u0414 \u0431\u044b\u043b\u0438 \u0430\u043f\u0440\u043e\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043e\u043c\u0430\u043b\u0438\u0437\u0443\u043c\u0430\u0431, \u0440\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431, \u0443\u0441\u0442\u0435\u043a\u0438\u043d\u0443\u043c\u0430\u0431, \u044d\u0444\u0430-\n\u043b\u0438\u0437\u0443\u043c\u0430\u0431 \u0438 \u0434\u0440. \u041e\u0434\u043d\u0430\u043a\u043e \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0432 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0410\u0442\u0414 \u0441\u0440\u0435\u0434\u0438 \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435-\n\n\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043d\u0435\u0441\u0442\u0438 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0441\u0443\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0446\u044b \u012e-\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u0430 \u0418\u041b-4\u0430\u043b\u044c\u0444\u0430 \u2013\n\u0434\u0443\u043f\u0438\u043b\u0443\u043c\u0430\u0431.\n\n\u0411\u0438\u043e\u043b\u043e\u0433\u0438\u0447 \u041c\u041d\u041d \u041b\u0421 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 (\u0423\u0414)\n\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430- \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0440\u0430\u0442\u044b\n\u0414\u0443\u043f\u0438\u043b\u0443\u043c\u0430\u0431 150, 175 \u043c\u0433 \u0432 1 \u043c\u043b; \u043f\u043e 300 \u0410\u043d\u0442\u0438\u0446\u0438\u0442\u043e\u043a\u0438\u043d\u043e\u0432\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f. \u0411\u043b\u043e-\n\n\u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0434\u0432\u0435 \u043d\u0435\u0434\u0435\u043b\u0438. \u041a\u0443\u0440- \u043a\u0430\u0442\u043e\u0440 \u0441\u0443\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0446\u044b \u012e-\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u0430\n\u0441\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0418\u041b-4R\u012e \u2013 \u0434\u0443\u043f\u0438\u043b\u0443\u043c\u0430\u0431 (\u0423\u0414 - \u0421)\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0414\u0443\u043f\u0438\u043b\u0443\u043c\u0430\u0431 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0432 \u043a\u0430-\n\n\u0432\u0440\u0430\u0447\u043e\u043c \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e. \u0447\u0435\u0441\u0442\u0432\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0430\u0442\u043e\u043f\u0438-\n\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0435\u0440\u043c\u0430\u0442\u0438\u0442\u0430 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0438 \u0442\u044f-\n\u0436\u0435\u043b\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0442\u043e\u043b\u044c-\n\u043a\u043e \u0435\u0441\u043b\u0438: \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043d\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442\n\u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u043d\u0430 1 \u0434\u0440\u0443\u0433\u0443\u044e \u0441\u0438-\n\u0441\u0442\u0435\u043c\u043d\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e, \u0442\u0430\u043a\u0443\u044e \u043a\u0430\u043a\n\u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d, \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442, \u0430\u0437\u0430-\n\u0442\u0438\u043e\u043f\u0440\u0438\u043d \u0438 \u043c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u0430\u0442 \u043c\u043e\u0444\u0435-\n\u0442\u0438\u043b, \u0438\u043b\u0438 \u043e\u043d\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b\n\u0438\u043b\u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u044f\u0442\u0441\u044f", "type": "Document"}}