5\u043d\u0438\u044f \u0437\u0430\u0441\u0442\u044b\u0432\u0430\u043d\u0438\u0439, \u0442\u0440\u0435\u043d\u0438\u043d\u0433 \u0445\u043e\u0434\u044c\u0431\u044b \u0438\n\u043f\u043e\u0441\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438\n\u2022 \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u043d\u0430 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u0430 \u041c\u0410\u041e-\u0412\n\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043c\u0435\u043d\u0430 \u0410\u0414\u0420 (\u0438\u043d\u043e\u0433\u0434\u0430 \u0441\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b)\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d\u0430*\n\u2022 \u041d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 8. \u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0439 [9].\n\u0422\u0438\u043f \u041c\u0435\u0440\u044b \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0438\n\n\u0414\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u044f \u2022 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043e\u0432\u043e\u0439 \u0434\u043e\u0437\u044b \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u0441 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u0447\u0438\u0441\u043b\u0430 \u0435\u0435\n\u00ab\u043f\u0438\u043a\u0430 \u0434\u043e\u0437\u044b\u00bb \u043f\u0440\u0438\u0435\u043c\u043e\u0432 \u0438\u043b\u0438 \u043f\u0440\u0438\u0435\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u0438\u0449\u0435\u0439\n\u2022 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b \u0438\u043b\u0438 \u043e\u0442\u043c\u0435\u043d\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0445 \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u0442\u044c\n\u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0438 (\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0438, \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u041c\u0410\u041e-\u0412)\n\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d\u0430*\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0410\u0414\u0420 (\u0441\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b)\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043f\u0440\u0438 \u0445\u043e\u0440\u0435\u0438\u0444\u043e\u0440\u043c\u043d\u043e\u043c\n\n21\n\n\u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437\u0435 \u2013 \u043a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c\u0430, \u043a\u043b\u043e\u0437\u0430\u043f\u0438\u043d\u0430, \u0444\u043b\u0443\u043e\u043a\u0441\u0435\u0442\u0438\u043d\u0430, \u043c\u0438\u0440\u0442\u0430\u0437\u0430\u043f\u0438\u043d\u0430,\n\u043b\u0435\u0432\u0435\u0442\u0438\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u0430; \u043f\u0440\u0438 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u2013 \u043a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c\u0430, \u0431\u0430\u043a\u043b\u043e\u0444\u0435\u043d\u0430*,\n\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0430; \u043f\u0440\u0438 \u0430\u043a\u0430\u0442\u0438\u0437\u0438\u0438 \u2013 \u03b2-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u0432 (\u043f\u0440\u043e\u043f\u0440\u043e\u043d\u0430\u043b\u043e\u043b),\n\u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u043e\u0432, \u043d\u0430\u043b\u0442\u0440\u0435\u043a\u0441\u043e\u043d\u0430)\n\u2022 \u041d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\n\n\u2022 \u0418\u043d\u0442\u0440\u0430\u0434\u0443\u043e\u0434\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b\n\u0414\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u044f \u2022 \u041c\u0435\u0440\u044b, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044e \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u0430 \u00ab\u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0446\u0430\n\u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0434\u043e\u0437\u044b\u00bb \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b\n\u00ab\u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u2022 \u041f\u0440\u0438\u0435\u043c \u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0444\u043e\u0440\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b\n\n\u00bb \u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u0430 \u041a\u041e\u041c\u0422\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0410\u0414\u0420\n\u2022 \u041f\u0440\u0438\u0435\u043c \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u0432 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0432, \u043a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c\u0430, \u0431\u0430\u043a\u043b\u043e\u0444\u0435\u043d\u0430* \u0438\u043b\u0438\n\n\u0442\u0438\u0437\u0430\u043d\u0438\u0434\u0438\u043d\u0430\n\u2022 \u041b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0431\u043e\u0442\u0443\u043b\u043e\u0442\u043e\u043a\u0441\u0438\u043d\u0430 \u0410\n\u0414\u0432\u0443\u0445\u0444\u0430\u0437\u043d\u044b\u0435 \u2022 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043e\u0432\u043e\u0439 \u0434\u043e\u0437\u044b \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u043f\u0440\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0438\n\u0414\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0438 \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0447\u0438\u0441\u043b\u0430 \u043f\u0440\u0438\u0435\u043c\u043e\u0432\n\n\u2022 \u041e\u0442\u043c\u0435\u043d\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u0441 \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c \u0432\u044b\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u0430 \u041a\u041e\u041c\u0422, \u0410\u0414\u0420, \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u0430 \u041c\u0410\u041e-\u0412 (\u0441\n\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b)\n\u2022 \u041f\u0440\u0438\u0435\u043c \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b \u0432 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435\n\n\u2022 \u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u0432\u0441\u0430\u0441\u044b\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0432\u043e\u0434\u043e\u043f\u044b\n\u2022 \u041d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u2022\nNB! \u043f\u043e\u0441\u043b\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432 \u0420\u041a*\n\n22\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 9. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0435 \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0439\n\n\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0413\u0440\u0443\u043f\u043f\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430\n\u043a\u043b\u043e\u0437\u0430\u043f\u0438\u043d \u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u044b \u0432\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u0438, \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0433\u0430\u043d\u0433\u043b\u0438\u044f\u0445 \u0438 \u043b\u0438\u043c\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u0430\u043d\u0442\u0438\u043f\u0441\u0438\u0445\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435,\n6,25 \u043c\u0433 \u043d\u0430 \u043d\u043e\u0447\u044c 50 \u043c\u0433 \u0441\u0443\u0442\u043a\u0438\n\u0434\u0438\u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u0430, \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u043e\u0435, \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0435,\n\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0438 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u03b2-\n\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n\u043a\u043b\u043e\u043d\u0430\u0437\u0435\u043f\u0430\u043c \u0412\u044b\u0441\u043e\u043a\u043e\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d \u0410\u043d\u0442\u0438\u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435, \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0435,\n0,5 \u043c\u0433 \u043d\u0430 \u043d\u043e\u0447\u044c 20 \u043c\u0433 \u0441\u0443\u0442\n\u044b\u0439 \u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n\u0444\u043b\u0443\u043e\u043a\u0441\u0435\u0442\u0438\u043d \u0410\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u044b \u0411\u043b\u043e\u043a\u0430\u0434\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430\n20 \u043c\u0433 60 \u043c\u0433\n\u0433\u0440\u0443\u043f\u043f\u044b \u0421\u0418\u041e\u0417\u0421\n\u0411\u0430\u043a\u043b\u043e\u0444\u0435\u043d* \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442 \u0410\u043d\u0442\u0438\u0441\u043f\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0443\u0433\u043d\u0435\u0442\u0435\u043d\u0438\u0435\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u043e\u043d\u043e- \u0438 \u043f\u043e\u043b\u0438\u0441\u0438\u043d\u0430\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u043e\u0432; \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n5 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u0433\u0430\u043c\u043c\u0430- \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u0438 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0441\u043f\u0430\u0437\u043c\u0430\u0445. 25 \u043c\u0433 4 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438\n\u0441\u0443\u0442\u043a\u0438\n\u0430\u043c\u0438\u043d\u043e\u043c\u0430\u0441\u043b\u044f\u043d\u043e\u0439\n\u043a\u0438\u0441\u043b\u043e\u0442\u044b (\u0413\u0410\u041c\u041ab-\n\u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440)\n\u0434\u0438\u0430\u0437\u0435\u043f\u0430\u043c \u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u044b \u0410\u043d\u043a\u0441\u0438\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0435, 0,5 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 60 \u043c\u0433\n\u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0435, \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0438 10 \u043c\u0433 (\u043f\u0440\u0438 \u0432/\u0432\n\u0441\u043d\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 70 \u043c\u0433 (\u043f\u0440\u0438 \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438)\n\n23\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u041f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432\n\u0442\u0430\u0431\u043b\u0438\u0446\u0430\u0445 \u2013 10-12.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 10. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044e \u0432\u0435\u0433\u0435\u0442\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u0441\u043d\u0430 \u043f\u0440\u0438 \u0411\u041f\n\u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0430\u044f \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044f \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u0449\u0435\u0441\u0442\u0432 \u0438 \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0430\u044f \u0441\u0435\u043a\u0446\u0438\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\n\n\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432 (EFNS/MDS-ES) [10]\n\u0417\u0430\u043f\u043e\u0440\n\u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0435\u043c\u0430 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0438 (GPP)\n\n\u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c (GPP)\n\u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u043f\u043e\u043b\u0438\u044d\u0442\u0438\u043b\u0435\u043d\u0433\u043b\u0438\u043a\u043e\u043b\u044f* (\u043c\u0430\u043a\u0440\u043e\u0433\u043e\u043b) (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 A)\n\u041f\u0438\u0449\u0435\u0432\u044b\u0435 \u0434\u043e\u0431\u0430\u0432\u043a\u0438 \u0441 \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u043e\u0439 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 B) \u0438\u043b\u0438 \u043c\u0435\u0442\u0438\u043b\u0446\u0435\u043b\u044e\u043b\u043e\u0437\u0430*\n\u0438 \u043e\u0441\u043c\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043b\u0430\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043b\u0430\u043a\u0442\u0443\u043b\u043e\u0437\u0430 (GPP)\n\n\u0420\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044e\u0449\u0438\u0435 \u0441\u043b\u0430\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u043b\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u0414\u0438\u0441\u0444\u0430\u0433\u0438\u044f\n\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439", "type": "Document"}}