d\u0438 B\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0430\u043a\u0442\u0438\u043d\u043e\u043c\u0438\u0446\u0438\u043d\u044b\n\u041a\u0421\u0424 \u042d\u043f\u043e\u044d\u0442\u0438\u043d\u0430\u043b\u044c\u0444\u0430 40 \u0442\u044b\u0441\u044f\u0447 \u041c\u0415, 3 \u0440\u0430\u0437\u0430 \u0432 C\n\u043d\u0435\u0434\u0435\u043b\u044e, \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u043c\u0435\u0441\u044f\u0446\u0430,\n\u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\n\u041a\u0421\u0424 \u0414\u0430\u0440\u0431\u043e\u043f\u043e\u044d\u0442\u0438\u043d 2,25\u043c\u043a\u0433/\u043c21\u0440\u0430\u0437 \u0432 7 \u0434\u043d\u0435\u0439 \u0432 C\n\u0430\u043b\u044c\u0444\u0430 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 9 \u043d\u0435\u0434\u0435\u043b\u044c,\n\u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e\n\u041a\u0421\u0424 \u0424\u0438\u043b\u0433\u0440\u0430\u0441\u0442\u0438\u043c 30 \u043c\u043b\u043d \u0415\u0414, C\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c,\n\u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e\n\n5.4 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0432\u043d\u0435\u043e\u0440\u0433\u0430\u043d\u043d\u044b\u0445 \u0437\u0430\u0431\u0440\u044e\u0448\u0438\u043d\u043d\u044b\u0445 \u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0439 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439.\n\u0426\u0435\u043b\u044c: \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e\