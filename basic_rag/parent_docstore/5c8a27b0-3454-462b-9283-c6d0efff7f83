\n\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0412\u0421\u0421, \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0441 \u041e\u041a\u0421: \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u0430\u044f\n\u0444\u0430\u0437\u0430. \u0418\u043c\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044f \u041a\u0412\u0414\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u041a\u043b\u0430\u0441\u0441 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u041f\u0435\u0440\u0435\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e I C\n\u0438\u043c\u043f\u043b\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u041a\u0412\u0414 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043d\u0435\u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0432 \u0434\u0430\u043d\u043d\u044b\u043c \u043c\u043e\u043c\u0435\u043d\u0442\n\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u041a\u0412\u0414-\u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\n\u041f\u0435\u0440\u0435\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e IIa C\n\u0438\u043c\u043f\u043b\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u041a\u0412\u0414 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u043e\n\u0432\u043e \u0438\u0437\u0431\u0435\u0436\u0430\u043d\u0438\u0435 \u043d\u0435\u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0440\u0430\u0437\u0440\u044f\u0434\u043e\u0432 \u041a\u0412\u0