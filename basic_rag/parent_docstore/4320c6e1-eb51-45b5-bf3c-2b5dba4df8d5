5\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u042d\u041a\u0413 \u2013 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f 1.4 \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u0432\u0440\u0430\u0447\u0438 \u043e\u0431\u0449\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0432\u0440\u0430\u0447\u0438/\u0444\u0435\u043b\u044c\u0434\u0448\u0435\u0440\u044b \u0441\u043a\u043e\u0440\u043e\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438, \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u044b, \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438, \u043f\u0443\u043b\u044c\u043c\u043e\u043d\u043e\u043b\u043e\u0433\u0438, \u0430\u043a\u0443\u0448\u0435\u0440-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438, \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0438-\u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u044b \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f. 1.5 \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435. 1.6 \u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438: \u0422\u0430\u0431\u043b\u0438\u0446\u0430 1- \u0421\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043c\u0435\u0436\u0434\u04