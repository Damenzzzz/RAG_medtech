0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f (\u0434\u0443\u0448 \u0438 \u0432\u0430\u043d\u043d\u0430, \u043c\u0443\u0437\u044b\u043a\u0430,\n\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u0430\u0436\u0430, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0440\u0435\u043b\u0430\u043a\u0441\u0430\u0446\u0438\u0435\u0439),\n\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0438 \u0441\u0435\u043c\u044c\u0438, \u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435\n\u0440\u043e\u0434\u043e\u0432.\n\u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u0435:\n\n\u0412\u043e \u0432\u0441\u0435\u0445 \u0440\u043e\u0434\u0438\u043b\u044c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u0445 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0441\u043c\u0435\u0441\u044c \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430 \u0438 \u0437\u0430\u043a\u0438\u0441\u0438 \u0430\u0437\u043e\u0442\u0430\n50:50, \u0442.\u043a. \u043e\u043d \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0431\u043e\u043b\u044c \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445, \u043d\u043e \u0436\u0435\u043d\u0449\u0438\u043d \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043f\u0440\u043e\u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0447\u0442\u043e \u043e\u043d \