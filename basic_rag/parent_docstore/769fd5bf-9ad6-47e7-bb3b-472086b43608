u043e \u0410\u0412\u041e-\u0441\u0438\u0441\u0442\u0435\u043c\u0435:\n\u2022 \u0411\u043e\u043b\u044c\u0448\u0430\u044f (\u0411) \u2013 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u043b\u043b\u043e \u0430\u0433\u0433\u043b\u044e\u0442\u0438\u043d\u0438\u043d\u043e\u0432 \u0430\u043d\u0442\u0438-\u0410, -B \u0438\u043b\u0438 \u2013AB \u0432 \u043f\u043b\u0430\u0437\u043c\u0435\n\u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430, \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043a \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u043c \u0434\u043e\u043d\u043e\u0440\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442 \u041e + \u0434\u043e\u043d\u043e\u0440 \u0410).\n\n\u2022 \u041c\u0430\u043b\u0430\u044f (\u041c)\u2013 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u043b\u043b\u043e \u0430\u0433\u0433\u043b\u044e\u0442\u0438\u043d\u0438\u043d\u043e\u0432 \u0430\u043d\u0442\u0438-\u0410, -B \u0438\u043b\u0438 -AB \u0432 \u043f\u043b\u0430\u0437\u043c\u0435\n\u0434\u043e\u043d\u043e\u0440\u0430, \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u043a \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u043c \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442 \u0410 + \u0434\u043e\u043d\u043e\u0440 \u041e).\n\u2022 \u0414\u0432\u0443\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f (\u0414) \u2013 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0430\u0433\u0433\u043b\u0438\u0442\u0438\u043d\u0438\u043d\u043e\u0432 \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 \u0438\n\u0434\u043e\u043d\u043e\u0440\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442 B + \u0434\u043e\u043d\u043e\u0440 A).\n\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0438\u0434\u0430 \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u0434\u043e\u043d\u043e\u0440\u0430 \u0438 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 \u043f\u043e \u0410\u0412\u041e-\u0441\u0438\u0441\u0442\u0435\u043c\u0435\n\u0413\u0440\u0443\u043f\u043f\u0430 \u043a\u0440\u043e\u0432\u0438\n\u0434\u043e\u043d\u043e\u0440\u0430 0 (I)\u03b1\u03b2 \u0410 (II)\u03b2 \u0412 (III)\u03b1 \u0410\u0412 (IV)\n\u0413\u0440\u0443\u043f\u043f\u0430 \u043a\u0440\u043e\u0432\u0438\n\n33\n\n\u0420\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430\n0 (I)\u03b1\u03b2 \u0441\u043e\u0432\u043c \u0411 \u0411 \u0411\n\n\u0410 (II)\u03b2 \u041c \u0441\u043e\u0432\u043c \u0414 \u0414\n\u0412 (III)\u03b1 \u041c \u0414 \u0441\u043e\u0432\u043c \u0414\n\u0410\u0412 (IV) \u041c \u041c \u041c \u0441\u043e\u0432\u043c\n\n\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0432\u044b\u0431\u043e\u0440\u0430 \u0433\u0440\u0443\u043f\u043f\u044b \u043a\u0440\u043e\u0432\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430 \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u043e \u0410\u0412\u041e-\n\u0441\u0438\u0441\u0442\u0435\u043c\u0435\n\n\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\n\u042d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u0421\u0432\u0435\u0436\u0435\u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u041a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0442\n\u043a\u0440\u043e\u0432\u0438\n\u0432\u0437\u0432\u0435\u0441\u044c/\u043c\u0430\u0441\u0441\u0430 \u043f\u043b\u0430\u0437\u043c\u0430 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432\n\u041d\u0435\u0441\u043e\u