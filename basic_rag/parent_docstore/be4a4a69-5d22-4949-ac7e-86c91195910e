3e\u0433\u0440\u0430\u043c\u043c\u0430, \u0423\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0421\u041e\u042d. \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0423\u0441\u043a\u043e\u0440\u0435\u043d\n\u0421\u041e\u042d \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441\u043e \u0438\u0435 \u0421\u041e\u042d.\n\u0441\u0434\u0432\u0438\u0433\u043e\u043c \u0444\u043e\u0440\u043c\u0443\u043b\u044b\n\n\u0432\u043b\u0435\u0432\u043e, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\n\u0421\u041e\u042d.\n\u0423\u0417\u0418 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u041f\u043e\u043b\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438 \u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439. \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\n\n\u0444\u043e\u0440\u043c\u0430\u0445. \u0442,\n\u043e\u0442\u043c\u0435\u0447\u0430\u044e\n\u0442\u0441\u044f\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\n-\u043f\u043b\u044e\u0441\n\u0442\u043a\u0430\u043d\u044c.\n\u041a\u0422 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u041f\u043e\u043b\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438 \u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439. \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\n\n\u0444\u043e\u0440\u043c\u0430\u0445. \u0442,\n\u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442\u0441\u044f\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\n\u043f\u043b\u044e\u0441 \u0442\u043a\u0430\u043d\u044c.\n\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b \u041e\u0442\u0440\u0438\u0446\u0430\u0442\n\u043f\u0438\u044f \u043d\u0430 \u0411\u041a \u0439. \u0435\u043b\u044c\u043d\u044b\u0439.\n\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d \u041e\u0442\u0440\u0438\u0446\u0430\u0442\n\u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e \u044b\u0439. \u0435\u043b\u044c\u043d\u044b\u0439.\n\n\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 -7. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\u043f\u0443\u0437\u044b\u0440\u044f\n\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u041d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441 \u041e\u043f\u0443\u0445\u043e\u043b\u0438\n\u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043a\u0438\u0439 \u0446\u0438\u0441\u0442\u0438\u0442 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\u043f\u0443\u0437\u044b\u0440\u044f \u043f\u0443\u0437\u044b\u0440\u044f\n\u041d\u0430\u0447\u0430\u043b\u043e \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u041e\u0441\u0442\u0440\u044b\u0435 \u041c\u0430\u043b\u043e\u0441\u0438\u043c\u043f\u0442\n\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0434\u0438\u0437\u0443\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0438\u0437\u0443\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u043c\u043d\u043e\u0435.\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438.\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0435 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0439 \u041a\u0430\u043c\u043d\u0435\u0432\u044b\u0434\u0435\u043b\u0438\u0442\u0435 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442\n\u0434\u0430\u043d\u043d\u044b\u0435 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u043b\u044c, \u0447\u0430\u0441\u0442\u044b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441\n\n\u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u043d\u044b\u0435 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u043c\n\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0432\u044b- \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f. \u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438.\n\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044f\u043c\u0438.\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0411\u043e\u043b\u0438 \u0432 \u041e\u0441\u0442\u0440\u044b\u0435 \u0438\u043b\u0438 \u0411\u043e\u043b\u0438 \u0432\n\n\u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 \u0442\u0443\u043f\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438\n\u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u0447\u0435\u043a,\n\u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u044f, \u043f\u0443\u0437\u044b\u0440\u044f \u0438 \u043f\u043e\u0447\u0435\u043a, \u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u044f,\n\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\n\u043c\u043e\u0447\u0435\u0438\u0441\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u0435. \u043d\u0435\u0434\u043e\u043c\u043e\u0433\u0430\u043d\u0438\u0435. \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u044f,\n\u043f\u043e\u0442\u0435\u0440\u044f \u0432\u0435\u0441\u0430.\n\u0413\u0435\u043c\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u0423\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0423\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\n\u0421\u041e\u042d \u0421\u041e\u042d. \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441\u043e \u0421\u041e\u042d.\n\u0441\u0434\u0432\u0438\u0433\u043e\u043c \u0444\u043e\u0440\u043c\u0443\u043b\u044b\n\n\u0432\u043b\u0435\u0432\u043e, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\n\u0421\u041e\u042d.\n\u0423\u0417\u0418 \u0423\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u041e\u0431\u044c\u0435\u043c \u0414\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\n\u043e\u0431\u044c\u0435\u043c\u0430 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f \u044f \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\n\u043f\u0443\u0437\u044b\u0440\u044f, \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f. \u043f\u0443\u0437\u044b\u0440\u044f,\n\u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u0441\u0442\u0435\u043d\u043a\u0438 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f-\n\u043f\u0443\u0437\u044b\u0440\u044f. \u043f\u043b\u044e\u0441 \u0442\u043a\u0430\u043d\u044c.\n\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438 \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\n\u044f \u043c\u043e\u0447\u0438 \u043d\u0430 \u0411\u041a \u044b\u0439.. \u043d\u044b\u0439.\n\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\n\u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044b\u0439. \u0439. \u043d\u044b\u0439.\n\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 - 8. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0445 \u0438\n\n\u0433\u0435\u0440\u043f\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0432\u0435\u0438\u0442\u043e\u0432\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0435 \u0413\u0435\u0440\u043f\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0432\u0435\u0438\u0442\u044b\n\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0443\u0432\u0435\u0438\u0442\u044b\n\n\u0412 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0420\u0435\u0434\u043a\u043e. \u0427\u0430\u0441\u0442\u043e.\n\u0441\u0432\u044f\u0437\u044c \u0441\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c\n\n\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441 \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430. \u0421\u043d\u0438\u0436\u0435\u043d\u0430.\n\u0442\u044c \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u041a\u0440\u0443\u043f\u043d\u044b\u0435 \u041a\u0440\u0443\u043f\u043d\u044b\u0435 \u00ab\u0441\u0430\u043b\u044c\u043d\u044b\u0435\u00bb\n\u043f\u0440\u0435\u0446\u0438\u043f\u0438\u0442\u0430\u0442\u043e\u0432 \u00ab\u0441\u0430\u043b\u044c\u043d\u044b\u0435\u00bb, \u0442\u0440\u0435\u0443\u0433\u043e\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u0435\u0446\u0438\u043f\u0438\u0442\u0430\u0442\u044b \u043f\u043e\u043b\u0438\u043c\u043e\u0440\u0444\u043d\u044b\u0435 \u0432\n\n\u0444\u043e\u0440\u043c\u044b \u0432 \u043d\u0438\u0436\u043d\u0435\u043c \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438.\n\u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0435.\n\u0425\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u0430\u043b\u044c \u0418\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435, \u0420\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b,\n\u043d\u044b\u0435 \u043e\u0447\u0430\u0433\u0438 \u043e\u043a\u0440\u0443\u0433\u043b\u044b\u0435 \u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0441\u043b\u0438\u0432\u043d\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0438 \u0441\u043b\u0430\u0431\u043e\u0439\n\n\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0435\u0439. \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0435\u0439.\n\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0438\u043d\u043e\u0432\u044b\u0445\n\u043f\u0440\u043e\u0431\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 9. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0445\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u0438 \u0438\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0445 \u0445\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u0438\u0442\u043e\u0432\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0425\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u044f \u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0435\n\n\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0445\u043e\u0440\u0438\u043e\u0440\u0435\u0442\u0438\u043d\u0438\u0442\u044b\n\u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0414\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0435. \u041e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0435.\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043e\u0447\u0430\u0433\u043e\u0432 \u0421\u043b\u0438\u0432\u043d\u044b\u0435, \u0418\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435,\n\n\u043b\u0430\u043d\u0434\u043a\u0430\u0440\u0442\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435, \u043e\u043a\u0440\u0443\u0433\u043b\u044b\u0435, \u043c\u0430\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u0438\n\u043f\u0435\u0440\u0438\u043f\u0430\u043f\u0438\u043b\u044f\u0440\u043d\u044b\u0435. \u043f\u0430\u0440\u0430\u043c\u0430\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435.\n\u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0422\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043f\u0440\u043e\u0431\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442.\n\n\u044d\u0444\u0444\u0435\u043a\u0442\u0430.\n\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u041e\u0442\u0440\u0438\u0446\u0