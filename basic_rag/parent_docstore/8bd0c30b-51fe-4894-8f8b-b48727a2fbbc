0431\u043a\u043e\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438;\n\u2022 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u044f \u0441\u0442\u043e\u043f, \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 (\u043e\u0441\u0442\u0440\u0430\u044f \u0438 \u0434\u0438\u0441\u0433\u0438\u0434\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\n\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u044d\u043a\u0437\u0435\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438);\n\u2022 \u043f\u043e \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c: \u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u0438\u0437 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u043e\u0432\n\n\u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0438\u0445 \u043e\u0442 \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0445 \u043b\u0438\u0446 (\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n- \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u043e\u0432, \u043e\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0439, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u043d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u043d\u044b\u0445 \u0441\u0435\u043c\u0435\u0439, \u043f\u0440\u0438\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432 \u0441\u0435\u043c\u044c\u0435 \u043b\u0438\u0446 \u0434\u043b\u044f \u0443\u0445\u043e\u0434\u0430 \u0437\u0430 \u0431\u043e\u043b\u044c\u043d\u044b\u043c \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c, \u043f\u0440\u0438 \u043d\u0435\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438\n\u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 \u0438\u043b\u0438 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0430 \u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u043c \u0434\u0435\u0437\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u043c\n\n\u0440\u0435\u0436\u0438\u043c\u0435).\n\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043d\u0435\u0442.\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1-3, 8-25]:\n\n5.1 \u043a\u0430\u0440\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 (\u0441\u0445\u0435\u043c\u044b,\n\u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b):\n\n\u041c\u0430\u0440\u0448\u0440\u0443\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u0435\u0439\n\u041e\u0431\u043b\u0430\u0441\u0442\u043d\u043e\u0439 (\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0439) \u0424\u043e\u0440\u043c\u044b \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u0438 (\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\n\u043a\u043e\u0436\u043d\u043e-\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0432/\u0447 \u0433\u043e\u043b\u043e\u0432\u044b \u0438 \u043f\u0443\u0448\u043a\u043e\u0432\u044b\u0445 \u0432\u043e\u043b\u043e\u0441,\n\u0434\u0438\u0441\u043f\u0430\u043d\u0441\u0435\u0440 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0447\u0430\u0433\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f,\n\u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0432 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u044b\u0445\n\u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445) \u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u0435 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0433\u043e\n\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f;\n\u043f\u0440\u0435\u0435\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438. \u0414\u0438\u0441\u043f\u0430\u043d\u0441\u0435\u0440\u043d\u043e\u0435\n\u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435.\n\u0420\u0430\u0439\u043e\u043d\u043d\u044b\u0435 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u0438, \u0424\u043e\u0440\u043c\u044b \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u0438 (\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n\u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u0438 \u0431\u0435\u0437 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432/\u0447 \u0433\u043e\u043b\u043e\u0432\u044b \u0438 \u043f\u0443\u0448\u043a\u043e\u0432\u044b\u0445\n\u043f\u043e\u043b\u0438\u043a\u043b\u0438\u043d\u0438\u043a \u0432\u043e\u043b\u043e\u0441, \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0435 \u043e\u0447\u0430\u0433\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f), \u043d\u0435\n\u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u0435 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f;\n\u043f\u0440\u0435\u0435\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0426\u0435\u043d\u0442\u0440\u044b \u041f\u041c\u0421\u041f, \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 \u043a\u043e\u0436\u0435 \u0438 /\u0438\u043b\u0438\n\u0432\u0440\u0430\u0447\u0435\u0431\u043d\u044b\u0435 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u0438\u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u0445 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0439, \u043a\u043e\u0436\u043d\u043e\u0433\u043e\n\u0432\u0440\u0430\u0447\u0438 \u00ab\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u00bb \u0437\u0443\u0434\u0430.\n(\u0412\u041e\u041f, \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0432\u0440\u0430\u0447\u0438,\n\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u044b \u0438 \u0434\u0440.)\n\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\n\n5.2 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c No1 (\u043e\u0431\u0449\u0438\u0439);\n\u2022 \u0421\u0442\u043e\u043b No15 (\u043e\u0431\u0449\u0438\u0439).\n\n5.3 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u2022 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0437\u043b\u0435\u0447\u0435\u043d\u0438\u0435;\n\u2022 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430 \u0433\u0440\u0438\u0431\u044b.\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435 \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u0423\u0440\u043e\u0432\u0435\u043d\n\u043d\u043d\u0430\u044f \u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\n\u0435\u043b\u044c\u043d\u043e\u0441\u0442\n\u0438\n\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u0414\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u044f \u0432/\u0447 \u0433\u043e\u043b\u043e\u0