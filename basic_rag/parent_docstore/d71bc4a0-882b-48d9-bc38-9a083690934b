5 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043e \u0441\u0442\u043e\u0439\u043a\u043e\u0439\n\u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 1 \u0433\u043e\u0434\u0430\n\n\u041d\u041f\u0412\u0421 \u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u0412\u043d\u0443\u0442\u0440\u044c, \u0441 6 \u043b\u0435\u0442, 2\u20133 \u0412[21]\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438;\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u043a\u0443\u0440\u0441\u044b, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435\n\n1 \u043c\u0435\u0441\u044f\u0446\u0430.\n\u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0412\u043d\u0443\u0442\u0440\u044c, \u0441 6 \u043c\u0435\u0441, 10 \u2013 15\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442.\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u043a\u0443\u0440\u0441\u044b, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435\n\n1 \u043c\u0435\u0441\u044f\u0446\u0430.\n\u041d\u0430\u043f\u0440\u043e\u043a\u0441\u0435\u043d \u0412\u043d\u0443\u0442\u0440\u044c, \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 1\n\u0433\u043e\u0434\u0430 \u0434\u043e 5 \u043b\u0435\u0442 \u2013 \u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439\n\n\u0434\u043e\u0437\u0435 2,5-5 \u043c\u0433/\u043a\u0433, \u0441\u0442\u0430\u0440\u0448\u0435 5\n\u043b\u0435\u0442 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 10\n\u043c\u0433/\u043a\u0433.\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u043a\u0443\u0440\u0441\u044b, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435\n1 \u043c\