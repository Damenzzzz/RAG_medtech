434\u0435\u043d\u044c\n24-40 \u043a\u0433 60 \u043c\u0433 \u0440\u043e 2 \u0440/\u0434\u0435\u043d\u044c\n> 40 \u043a\u0433 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435 75\u043c\u0433 \u0440\u043e 2 \u0440/\u0434\u0435\u043d\u044c\n\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u043f\u0440\u043e\u0442\u043e\u0437\u043e\u0439\u043d\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439:\n\u041f\u043d\u0435\u0432\u043c\u043e\u0446\u0438\u0441\u0442\u043d\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f:\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u043f\u043d\u0435\u0432\u043c\u043e\u0446\u0438\u0441\u0442\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0434\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438, \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043f\u0440\u0438\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442\u0430 \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438\n\n\u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u044b >1.0x109/\u043b (\u0431\u043e\u043b\u0435\u0435 3 \u0434\u043d\u0435\u0439), \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b >75.0x109/\u043b \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u0442\u0435\u0447\u0435\u043d\u0438\u0435 12 \u043c\u0435\u0441, (3\n\u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0438\u043c\u043c\u0443\u04