5\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439\n\u0434\u0438\u0430\u0431\u0435\u0442, \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435 \u044f\u0437\u0432\u0435\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0438 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043f\u0435\u0440\u0441\u0442\u043d\u043e\u0439 \u043a\u0438\u0448\u043a\u0438,\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u0430\u044f/\u043f\u043e\u0447\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0438 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0440\u043e\u043a\u0438\n\n\u0441\u0435\u0440\u0434\u0446\u0430 \u0441 \u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u0435\u0439 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c.\n\n\u2022 \u043e\u0441\u0442\u0440\u044b\u0435 \u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438 \u0438 \u043f\u043e\u0447\u0435\u043a \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u043c \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442\u0435\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u2212 \u0441\u0432\u0438\u0449\u0438;\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442\u0430 \u0431\u0435\u0437\n\u2212 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439;\n\u0448\u0432\u043e\u0432;\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b\n\u2212 \u0430\u0431\u0441\u0446\u0435\u0441\u0441.\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442\u0430 \u0441\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430, \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u043e\u0434\u0435\u0437 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0431\u043e\u043b\u0435\u0435 2-\u0445\n\u0441\u0435\u0433\u043c\u0435\u043d\u0442\u043e\u0432, \u0434\u0438\u0430\u0441\u0442\u0430\u0437\u043e\u043c \u043c\u0435\u0436\u0434\u0443\n\u0442\u0435\u043b\u0430\u043c\u0438 \u043f\u043e\u0437\u0432\u043e\u043d\u043a\u043e\u0432 \u0431\u043e\u043b\u0435\u0435 1,5 \u0441\u043c.;\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442 \u0441\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u0434\u0435\u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0441\u043f\u0438\u043d\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438;\n\u0444\u0438\u0441\u0442\u0443\u043b\u043b\u043e\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u0439 \u0441\u0432\u0438\u0449\u0435\u043c\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f,\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430\n\u0441\u043f\u043e\u043d\u0434\u0438\u043b\u043e\u0434\u0435\u0437 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442 \u0438\u043b\u0438\n\u043b\u044e\u0431\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430 \u0438 \u043b\u044e\u0431\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u043e\u0433\u043e\n\u0441 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0435\u0439 \u043a\u0435\u0439\u0434\u0436\u0430\u043c\u0438 \u0438\u043b\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0441 \u0434\u0438\u0430\u0441\u0442\u0430\u0437\u043e\u043c \u043c\u0435\u0436\u0434\u0443\n\u041c\u0415\u0428. \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0442\u0435\u043b\u0430\u043c\u0438 \u0431\u043e\u043b\u0435\u0435 1,5\n\u0441\u043c.\n\u0441\u043f\u043e\u043d\u0434\u0438\u043b\u043b\u043e\u0434\u0435\u0437 \u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0439\n\u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u043e\u0437\u0432\u043e\u043d\u043a\u043e\u0432, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442 \u0438\u043b\u0438\n\u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f, \u0441 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u043e\u0433\u043e\n\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u043c\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0441 \u0434\u0438\u0430\u0441\u0442\u0430\u0437\u043e\u043c \u043c\u0435\u0436\u0434\u0443\n\u0442\u0440\u0430\u043d\u0441\u043f\u0435\u0434\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0442\u0435\u043b\u0430\u043c\u0438 \u0431\u043e\u043b\u0435\u0435 1,5\n\u0438 \u043a\u0435\u0439\u0434\u0436\u0430\u043c\u0438 \u0441\u043c.\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u0430\u0440\u0442\u0440\u043e\u0442\u043e\u043c\u0438\u044f, \u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u2212 \u0441\u0432\u0438\u0449\u0438;\n\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0432\n\u2212 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\n\u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u0430;\n\u0448\u0432\u043e\u0432;\n\u0430\u0440\u0442\u0440\u043e\u0442\u043e\u043c\u0438\u044f, \u044d\u043a\u043e\u043d\u043e\u043c\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u043a\u0446\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432\n\u2212 \u0430\u0431\u0441\u0446\u0435\u0441\u0441.\n\u0438 \u0430\u0440\u0442\u0440\u043e\u0434\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0432\n\u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u0430;\n\u0444\u0438\u0441\u0442\u0443\u043b\u043b\u043e\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432\n\u0442\u0430\u0437\u043e\u0431\u0435\u0434\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u0439 \u0441\u0432\u0438\u0449\u0435\u043c\n\u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u0441\n\u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c\n\u043f\u043e\u0441\u043b\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u043d\u043e\u0439 \u0440\u0435\u0437\u0435\u043a\u0446\u0438\u0438\n\u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432;\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435 \u043f\u0440\u043e\u0447\u0438\u0445 \u043a\u043e\u0441\u0442\u0435\u0439\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u2212 \u0441\u0432\u0438\u0449\u0438;\n\u043f\u0440\u043e\u0447\u0438\u0445 \u043a\u043e\u0441\u0442\u0435\u0439 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u043e\u0441\u0442\u0438\u0442\u0430 \u043f\u0440\u043e\u0447\u0438\u0445\n\u2212 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\n\u043a\u043e\u0441\u0442\u0435\u0439 \u0441 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u0430\n\u0448\u0432\u043e\u0432;\n\u0444\u0438\u0441\u0442\u0443\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u044b\n\u2212 \u0430\u0431\u0441\u0446\u0435\u0441\u0441.\n\u043f\u0440\u043e\u0447\u0438\u0445 \u043a\u043e\u0441\u0442\u0435\u0439 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u043e\u0441\u0442\u0438\u0442\u0430 \u043f\u0440\u043e\u0447\u0438\u0445\n\u043a\u043e\u0441\u0442\u0435\u0439, \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u0439 \u0441\u0432\u0438\u0449\u0435\u043c;\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0441\u0435\u0447\u0435\u043d\u0438\u0435 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432 \u043d\u0435\u0442\n\u0438\u043b\u0438\n\u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u043c \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435\n\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u0430;\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435 \u043f\u043e\u0447\u0435\u043a\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u043d\u0435\u0444\u0440\u043e\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u0430\u044f \u0438\u043b\u0438 \u2212 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f,\n\u043f\u043e\u043b\u0438\u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430\n\u2212 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u043f\u043e\u0447\u0435\u043a;\n\u0441\u0432\u0438\u0449\u0438;\n\u2212 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0448\u0432\u043e\u0432.\n\u043d\u0435\u0444\u0440\u0443\u0440\u0435\u0442\u0435\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u0430\u044f \u0438\u043b\u0438\n\u043f\u043e\u043b\u0438\u043a\u0430\u0432\u0435\u0440\u043d\u043e\u0437\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u043f\u043e\u0447\u0435\u043a \u0441\u043e\n\u0441\u0442\u0440\u0438\u043a\u0442\u0443\u0440\u043e\u0439 \u043c\u043e\u0447\u0435\u0442\u043e\u0447\u043d\u0438\u043a\u0430\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u043c \u043e\u0440\u0445\u043e\u044d\u043f\u0438\u0434\u0438\u0434\u0438\u043c\u0438\u0442\u0435:\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\n\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u044d\u043f\u0438\u0434\u0438\u0434\u0438\u043c\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u043e\u0435 \u2212 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f,\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0448\u043e\u043d\u043a\u0438\n\u2212 \u0441\u0432\u0438\u0449\u0438;\n\u043e\u0440\u0445\u043e\u044d\u043f\u0438\u0434\u0438\u043c\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c\n\u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0448\u0432\u043e\u0432\n\u043c\u043e\u0448\u043e\u043d\u043a\u0438 \u0438\n\u0441\u0435\u043c\u044f\u0432\u044b\u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f \u0438\n\u043c\u043e\u0447\u0435\u0442\u043e\u0447\u043d\u0438\u043a\u0430:\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\n\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u0443\u0440\u0435\u0442\u0435\u0440\u043e\u0446\u0438\u0441\u0442\u043e\u043d\u0435\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u2212 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f,\n\u0441\u0442\u0440\u0438\u043a\u0442\u0443\u0440\u0430 \u043c\u043e\u0447\u0435\u0442\u043e\u0447\u043d\u0438\u043a\u0430\n\u2212 \u0441\u0432\u0438\u0449\u0438;\n\u043f\u0440\u0438 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0435\n\u2212 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\n\u043c\u043e\u0447\u0435\u0432\u044b\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\u0448\u0432\u043e\u0432\n\u0441\u0438\u0441\u0442\u0435\u043c\u044b;\n\u0443\u0440\u0435\u0442\u0435\u0440\u043e\u043a\u0443\u0442\u0430\u043d\u0435\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\n\u043f\u0443\u0437\u044b\u0440\u044f, \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u0439\n\u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0441\u0442\u0438\u0441\u043e\u043c \u0438\n\u0441\u0442\u0440\u0438\u043a\u0442\u0443\u0440\u043e\u0439 \u0443\u0440\u0435\u0442\u0440\u044b\n\n\u043d\u0435\u0444\u0440\u043e\u0441\u0442\u043e\u043c\u0430 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u0442\u043e\u043a\u0430 \u043c\u043e\u0447\u0438\n\u0438\u0437-\u0437\u0430 \u0441\u0442\u0440\u0438\u043a\u0442\u0443\u0440\u044b \u0443\u0440\u0435\u0442\u0440\u044b\n\u044d\u043d\u0442\u0435\u0440\u043e\u0446\u0438\u0441\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e\n\u043f\u0443\u0437\u044b\u0440\u044f \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u044b\u0439\n\u0441\u0432\u0438\u0449\u0435\u043c \u0438\n\u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0441\u0442\u0438\u0441\u043e\u043c;\n\n\u0410\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u043e\u0441\u043e\u0431\u0438\u0435:\n\n\u0412\u0438\u0434\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0439 \u0432\u0438\u0434 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438: \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n(\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441\n\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0435\u0439 \u0438 \u043e\u0431\u0449\u0438\u0435)\n\n1.\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442 (\u0432\u0441\u0435 \u041e\u0431\u0449\u0430\u044f \u2022 \u0414\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u0432\u0438\u0434\u044b \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439: \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u043e\u0442\u043e\u043c\u0438\u044f, \u044d\u043d\u0434\u043e\u0442\u0440\u0430\u0445\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c (\u043f\u0440\u0438\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u043e\u0434\u0435\u0437, \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u044f (\u041e\u042d\u0410) \u0441 \u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u0435\n\u0434\u0435\u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0441\u043f\u0438\u043d\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430, \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u0446\u0438\u0435\u0439. \u0438\u043b\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u043c\n\u0444\u0438\u0441\u0442\u0443\u043b\u043b\u043e\u044d\u043a\u0442\u043e\u043c\u0438\u044f) \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435).\n2.\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 (\u0430\u0440\u0442\u0440\u043e\u0442\u043e\u043c\u0438\u044f, \u2022 \u0421\u043f\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u043b\u0438 \u2022 \u0422\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043d\u0435\u043a\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u044d\u043a\u043e\u043d\u043e\u043c\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u043a\u0446\u0438\u044f + \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\n\u0430\u0440\u0442\u0440\u043e\u0434\u0435\u0437, \u0444\u0438\u0441\u0442\u0443\u043b\u043b\u043e\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u0441\u043f\u0438\u043d\u0430\u043b\u044c\u043d\u043e- (\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435) \u044d\u043f\u0438\u0434\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0435\u043f\u0430\u0440\u0438\u043d\u0430\u043c\u0438).", "type": "Document"}}