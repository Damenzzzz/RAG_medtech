f\u0441\u043e, \u043f\u0442\u0438\u0446\u0430, \u041f\u043b\u043e\u0445\u043e \u043f\u0440\u043e\u0432\u0430\u0440\u0435\u043d\u043d\u043e\u0435 \u043c\u044f\u0441\u043e\n\u043c\u044f\u0441\u043e\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0424\u0430\u0440\u0448 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430\n\u041c\u044f\u0441\u043d\u044b\u0435 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u0435\u0441\u044b \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u0438 \u0433\u043e\u0440\u044f\u0447\u0435\u0433\u043e \u043a\u043e\u043f\u0447\u0435\u043d\u0438\u044f\n\n\u041f\u0435\u043b\u044c\u043c\u0435\u043d\u0438, \u043c\u0430\u043d\u0442\u044b \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430\n\u041c\u044f\u0441\u043d\u044b\u0435 \u0441\u0430\u043b\u0430\u0442\u044b\n\u0413\u0443\u0441\u044c, \u0443\u0442\u043a\u0430\n\u041a\u043e\u043b\u0431\u0430\u0441\u043d\u044b\u0435 \u041a\u043e\u043f\u0447\u0435\u043d\u044b\u0435 \u043a\u043e\u043b\u0431\u0430\u0441\u044b\n\u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0421\u0430\u0440\u0434\u0435\u043b\u044c\u043a\u0438\n\u0421\u043e\u0441\u0438\u0441\u043a\u0438\n\u0420\u044b\u0431\u0430, \u0420\u044b\u0431\u0430 \u0441\u0443\u0448\u0435\u043d\u0430\u044f, \u0432\u044f\u043b\u0435\u043d\u0430\u044f\n\u0440\u044b\u0431\u043e\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438 \u0420\u044b\u0431\u0430 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u0438 \u0433\u043e\u0440\u044f\u0447\u0435\u0433\u043e \u043a\u043e\u043f\u0447\u0435\u043d\u0438\u044f\n\u043c\u043e\u0440\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0420\u044b\u0431\u0430 \u0432 \u043c\u0430\u0440\u0438\u043d\u0430\u0434\u043d\u043e\u0439 \u0437\u0430\u043b\u0438\u0432\u043a\u0435\n\u0421\u0443\u0448\u0438\n\u0420\u044b\u0431\u043d