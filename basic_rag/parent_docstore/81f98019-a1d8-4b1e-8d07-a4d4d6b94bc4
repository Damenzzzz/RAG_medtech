d\u0435\u0439 \u0434\u043e\u043b\u0438 \u0433\u0438\u043f\u043e\u0444\u0438\u0437\u0430. \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0440\u0435\u0431\u0435\u043d\u043a\u0430, 20\n\u041e\u043a\u0441\u0438\u0442\u043e\u0446\u0438\u043d \u0438 \u0435\u0433\u043e \u0430\u043d\u0430\u043b\u043e\u0433\u0438. \u0415\u0414 \u0432 \u043f\u0443\u043f\u043e\u0447\u043d\u0443\u044e \u0432\u0435\u043d\u0443\n\u043d\u0430 20 \u043c\u043b 0,9% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\n\u043d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434\u0430 (\u043f\u0440\u0438\n\u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0435 \u043e\u0442\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430)\n\n\u041a\u0440\u043e\u0432\u044c \u0438 \u043e\u0440\u0433\u0430\u043d\u044b \u0444\u0438\u0442\u043e\u043c\u0435\u043d\u0430\u0434\u0438\u043e\u043d NB! \u0424\u0438\u0442\u043e\u043c\u0435\u043d\u0430\u0434\u0438\u043e\u043d \u0421\n\u043a\u0440\u043e\u0432\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f. \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c\n\u0410\u043d\u0442\u0438\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u0441\u044f\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b. \u0412\u0438\u0442\u0430\u043c\u0438\u043d \u041a \u0438 \u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u043c 10 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0434\u0440\u0443\u0433\u0438\u0435 \u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438. \u043c\u0433/\u043c\u043b, 1\u043c\u043b \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 2 \u043c\u0433 / 0,2\n\u0412\u0438\u0442\u0430\u043c\u0438\u043d \u041a. \u043c\u043b.\n\u041d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c: \u0434\u043b\u044f\n\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 \u2013 \u0432/\u043c, 0,5\n\u2013 1 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0447\u0430\u0441\u0430\n\u043f\u043e\u0441\u043b\u0435 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f;\n\u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f 1 \u043c\u0433 \u0432/\u043c\n\u0432 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3-4\n\u0434\u043d\u0435\u0439 (\u0432 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0445\n\u0434\u043e\u0437\u0430\u0445 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043d\u0435\u043f\u0440\u044f\u043c\u044b\u0445\n\u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u043e\u0432 \u0443\n\u043c\u0430\u0442\u0435\u0440\u0438).\n\u041d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0435\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0441\u043e\n\u0441\u0440\u043e\u043a\u043e\u043c \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u0438\n\u043c\u0435\u043d\u0435\u0435 36 \u043d\u0435\u0434\u0435\u043b\u044c \u0438\n\n\u0432\u0435\u0441\u043e\u043c 2,5 \u043a\u0433 \u0438\u043b\u0438\n\u0431\u043e\u043b\u0435\u0435: 1 \u043c\u0433 \u0432/\u043c\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n\u041d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0435\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0441\u043e\n\u0441\u0440\u043e\u043a\u043e\u043c \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u0438\n\u043c\u0435\u043d\u0435\u0435 36 \u043d\u0435\u0434\u0435\u043b\u044c\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u0435\u0441\u043e\u043c\n\u043c\u0435\u043d\u0435\u0435 2,5 \u043a\u0433: \u0438\u0437\n\u0440\u0430\u0441\u0447\u0435\u0442\u0430 0,4 \u043c\u0433/\u043a\u0433 \u0432/\u043c\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438 \u0447\u0430\u0441\u0442\u043e\u0442\u0430\n\n\u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0434\u043e\u0437\n\u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c\n\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u044b \u043d\u0430\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u044b.\n\u041d\u0435\u0440\u0432\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430. \u043b\u0438\u0434\u043e\u043a\u0430\u0438\u043d \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u041f\u0430\u0440\u0430\u0446\u0435\u0440\u0432\u0438\u043a\u0430\u043b\u044c\u043d\u043e \u0410\n\u0410\u043d\u0435\u0441\u0442\u0435\u0442\u0438\u043a\u0438. \u0410\u043d\u0435\u0441\u0442\u0435\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1%, \u041a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f - 1%, 5\n\u043c\u0435\u0441\u0442\u043d\u044b\u0435. \u0410\u043c\u0438\u0434\u044b. 5\u043c\u043b \u043c\u043b, \u043e\u0431\u044a\u0435\u043c - 10 \u043c\u043b,\n\u041b\u0438\u0434\u043e\u043a\u0430\u0438\u043d. \u043e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\n\u0434\u043e\u0437\u044b - 100 \u043c\u0433\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0435\u0442\u0440\u0430\u0446\u0438\u043a\u043b\u0438\u043d \u043c\u0430\u0437\u044c \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0421\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u043b\u0430\u0437\u043d\u0430\u044f 1% \u0437\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0437\u0438 \u0432\n\u0447\u0443\u0432\u0441\u0442\u0432. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u0433\u043b\u0430\u0437\u0430\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 \u0433\u043b\u0430\u0437. \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e (1%\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u044b\u0435 \u0442\u0435\u0442\u0440\u0430\u0446\u0438\u043a\u043b\u0438\u043d\u043e\u0432\u043e\u0439)\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b. \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438. \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043a\u043e\u043d\u0446\u0435\n1-\u0433\u043e \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f.\n\u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0430\u043d\u0442\u0438-D- \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0440\u0435\u0437\u0443\u0441- \u0421\n\n\u0430\u043d\u0442\u0438\u0440\u0435\u0437\u0443\u0441 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0438\u043c\u043c\u0443\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0443\n300 \u043c\u043a\u0433 \u0438\u043b\u0438 625 \u0440\u0435\u0437\u0443\u0441-\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u043c\u0435/\u043c\u043b \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0436\u0435\u043d\u0449\u0438\u043d,\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e \u0432 \u043d\u0435\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 72 \u0447\u0430\u0441\u043e\u0432 \u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\n\u043f\u043e\u0441\u043b\u0435 \u0445 \u043a Rho(D)-\u0430\u043d\u0442\u0438\u0433\u0435\u043dy\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f): \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0438\n\n\u0433\u0440\u0443\u043f\u043f\u044b \u0440\u0438\u0441\u043a\u0430.\n\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0438\u0434\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f: \u043d\u0435\u0442.\n\n5.4 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:\n\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u043c\u044f\u0433\u043a\u0438\u0445 \u0440\u043e\u0434\u043e\u0432\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 \u043f\u0440\u0438 \u0442\u0440\u0430\u0432\u043c\u0435, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u0439\n\u043b\u0438\u0431\u043e \u0440\u0430\u0437\u0440\u044b\u0432\u043e\u043c.\n\n5.5 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435 [1-9, 20]:\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f: \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u043f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u043e\u0433\u043e\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u2013 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435 3 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0440\u043e\u0434\u043e\u0432, \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0438\u0442\u0430 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445, \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438", "type": "Document"}}