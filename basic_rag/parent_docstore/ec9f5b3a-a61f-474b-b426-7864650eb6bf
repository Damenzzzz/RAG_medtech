35\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0438\u0437\u0431\u0435\u0433\u0430\u0442 B \u0434\u043e\u0437\u044b \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u2013 1-2 \u044c\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043c\u043b, \u0432 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441 \u0432\u0438\u0434\u0435\u0432\u043d\u0443\u0442\u0440\u0438\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u044b \u0442\u0432\u0435\u043d\u043d\u043e \u0432 \u0441\u0443\u0445\u043e\u0436\u0438\u043b\u0438\u044f. \u0445\u0438 \u0412\u043d\u0443\u0442\u0440\u0438\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0435\u0432\u0432\u0435 \u043f\u0435\u0440\u0438\u0430\u0440\u0442\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0434\u0435\u043d\u0438\u0435\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0432 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u0434\u043e\u0437\u0435 0,5-2 \u043c\u043b \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442 \u0431\u043e\u043b\u044c, \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u0438 \u0442\u0443\u0433\u043e\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2-4 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0441\u043b\u0435\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u0442\u0435\u0440\u0430\u043f\u0435 \u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u0430\u0440\u044c\u0438\u0440\u0443\u0435