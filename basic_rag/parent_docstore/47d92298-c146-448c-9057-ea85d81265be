0438 \u0441\u0442\u0430\u0442\u0438\u043d\u0430\u043c\u0438 \u0438 \u043f\u0440\u0438\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u0437\u044b \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0415\u0441\u043b\u0438 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u043c\u0438 \u0434\u043e\u0437\u0430\u043c\u0438 \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432 I, B\n\n\u0447\u0435\u0440\u0435\u0437 4\u20136 \u043d\u0435\u0434\u0435\u043b\u044c \u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u044b \u0446\u0435\u043b\u0435\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0425\u0421-\u041b\u041f\u041d\u041f,\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\n\u0415\u0441\u043b\u0438 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u043c\u0438 \u0434\u043e\u0437\u0430\u043c\u0438 \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432 \u0438 I, B\n\u044d\u0437\u0435\u0442\u0438\u043c\u0438\u0431\u043e\u043c \u0447\u0435\u0440\u0435\u0437 4\u20136 \u043d\u0435\u0434\u0435\u043b\u044c \u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u044b \u0446\u0435\u043b\u0435\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0425\u0421-\u041b\u041f\u041d\u041f,\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f \u0441 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\