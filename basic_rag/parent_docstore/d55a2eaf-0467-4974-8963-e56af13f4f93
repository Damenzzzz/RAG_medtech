u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e 1 \u0433\u043e\u0434\u0430 - 60-120 \u043c\u0433, \u0434\u043e 3\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 - 10 \u043c\u0433/\u043a\u0433 4 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0441\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 6 \u0447.\n6. \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b. Per rectum. \u0414\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 6-12 \u043b\u0435\u0442 - 250- 7\n500 \u043c\u0433, 1-5 \u043b\u0435\u0442 - 125-250 \u043c\u0433.\n\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438\n7. \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b Per os, \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0434\u043e 1 \u0433\u043e\u0434\u0430. 2\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 \u0433\u043e\u0434\u0430, \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e\n\u0432 \u0432\u0438\u0434\u0435 \u043a\u0430\u043f\u0435\u043b\u044c \u0438\u043b\u0438 \u043f\u0430\u0440\u0430\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e, \u0441\n\u043e.\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u043e\u0439 1-2 \u043c\u0433/\u043a\u0433. \u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043e 8 \u043c\u0433/\u043a\u0433.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041b\u0421, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0435 \u043f\u0440\u0438 \u0430\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0441\u0438\u0438 (\u0441\u043c. \u041a\u041f \u00ab\u0410\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0448\u043e\u043a \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0435 \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u044d\u043f\u0438\u043b\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041b\u0421 (\u0441\u043c. \u041a\u041f \u00ab\u0421\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430: b-\u043b\u0430\u043a\u0442\u0430\u043c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 (\u043e\u0434\u0438\u043d \u0438\u043b\u0438 \u0434\u0432\u0430 \u2013 \u043f\u043e \u043c\u0438\u043a\u0440\u043e\u0431\u043d\u043e\u0439 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438)\n8. \u0410\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d. \u0412\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435 \u0414\u0435\u0442\u044f\u043c \u0434\u043e 1 \u043c\u0435\u0441. \u043d\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f. 10\n\u0447\u043d\u043e. \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u0441\u0443\u0442\u043e\u0447\u043d\u0443\u044e\n\u0434\u043e\u0437\u0443 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0434\u043e 10 \u0433 \u0438 \u0431\u043e\u043b\u0435\u0435;\n- \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\n\u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0435 100 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430;\n- \u0434\u0435\u0442\u044f\u043c \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f \u2014\n50 \u043c\u0433/\u043a\u0433.\n\u0421\u0443\u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043e\u0437\u0443 \u0432\u0432\u043e\u0434\u044f\u0442 \u0432 4\u20136 \u043f\u0440\u0438\u0435\u043c\u043e\u0432\n\u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 4\u20136 \u0447.\n9. \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d+\u043a\u043b\u0430\u0432\u0443\u043b Per os. \u0414\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 7-12 \u043b\u0435\u0442 - 250 \u043c\u0433, 10\n\u0430\u043d\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430. 2-7 \u043b\u0435\u0442 - 125 \u043c\u0433, 9 \u043c\u0435\u0441-2 \u043b\u0435\u0442 - 62.5 \u043c\u0433,\n\u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f - 3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 2-12 \u043b\u0435\u0442 - 20-50 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0432 3\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u0414\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435\n14\n\u043c\u043b\u0430\u0434\u0448\u0435 9 \u0