u0442\u044c \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0442\u043e\u0433\u043e, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u043b\u0438 \u0442\u0430\u043a\u0436\u0435\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0432\u0430\u0440\u0438\u0446\u0435\u043b\u0430-\u0437\u043e\u0441\u0442\u0435\u0440, \u043d\u043e \u0435\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043a\u0430\u043a\n\n69\n\n\u043c\u0438\u043d\u0438\u043c\u0443\u043c 30 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a \u0443 \u0441\u0435\u0440\u043e\u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e \u0432\u0430\u0440\u0438\u0446\u0435\u043b\u0430 \u0437\u043e\u0441\u0442\u0435\u0440 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435. \u0410\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e 250 \u043c\u0433/\u043c2 \u0438\u043b\u0438 5 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441\u043e\u0432 \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 7\u201310 \u0434\u043d\u0435\u0439 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439 \u0432\u044b\u0431\u043e\u0440\u0430 \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a \u0438\u043b\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u043c \u0432\u0438\u0440\u0443\u0441\u0