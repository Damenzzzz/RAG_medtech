1,0 \u043c\u0433/\u043a\u0433 1-2 \u0421\n\n1%-1,0 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432/\u0432\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100 %\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442 \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043d\u043e\u0441\u0442\u0438\n\u0418\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u044b \u041f\u0430\u043b\u0438\u0432\u0438\u0437\u0443\u043c\u0430\u0431 \u0420\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 2 \u0410\n\n\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\n15\n\n15 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430,\n\u0432/\u043c, \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e,\n\u043f\u0435\u0440\u0435\u0434 \u0432\u044b\u043f\u0438\u0441\u043a\u043e\u0439 \u0438\u0437\n\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430 (\u043f\u0435\u0440\u0432\u0430\u044f\n\u0434\u043e\u0437\u0430).\n\n\u041f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u