8\u0430\u0442\u0443\u0440\u0430 \u0442\u0435\u0440\u043c\u0438\u043d\u0430 \u201cmultiple of median\u201d,\n\u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u043e\u0442 \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e\n\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f (\u043c\u0435\u0434\u0438\u0430\u043d\u044b)\nRh (D) \u0440\u0435\u0437\u0443\u0441 D\n\n1.4 \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0430\u043a\u0443\u0448\u0435\u0440\u044b-\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438.\n\n1.5 \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435, \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u044b \u0438 \u0440\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u0446\u044b.\n\n1.6 \u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:\n\u0421\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439,\n\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435 \u041e\u043a\u0441\u0444\u043e\u0440\u0434\u0441\u043a\u0438\u043c \u0426\u0435\u043d\u0442\u0440\u043e\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b [1]\n\n\u0423\u0440\u043e\u0432\u043d\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u