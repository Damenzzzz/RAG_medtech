u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438, \u0447\u0430\u0449\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438,\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0438\u043f \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 (\u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u0438 \u043d\u0435 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0445\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\u0445) [1-3, 32, 35, 46],[\u0423\u0414 \u2013 \u0410,\u0423\u0420 \u2013 I].\n\u2022 \u041f\u0443\u043b\u044c\u0441\u043e\u043a\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u0441\u0435\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0412\u041f \u0434\u043b\u044f \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0414\u041d [\u0423\u0414 \u2013 B,\n\n\u0423\u0420 \u2013 I][1-4, 9, 46].\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f [1-4, 18, 22, 25, 28, 31-34, 40, 46]:\n\n\u2022 \u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432, \u0433\u0435\u043c\u0430\u0442\u043e\u043a\u0440\u0438\u0442\u0430,\n\u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0432, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u044b [\u0423\u0414 \u2013 \u0421, I] [1-4, 25, 46];\n\u2022 \u041a\