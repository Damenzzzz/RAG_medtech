5\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u0441\u043e\u0431\u0438\u044f;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043e\u0442\u043e\u0440\u0438\u043d\u043e\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0438 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043d\u043e\u0441\u0430;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0438 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0430 \u2013 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0437\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \u2013 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\n8\n\n2.1 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u0421\u0431\u043e\u0440 \u0436\u0430\u043b\u043e\u0431 \u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430\n\n\u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435\n\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0447\u0435\u043b\u044e\u0441\u0442\u0435\u0439\n\u041e\u0410\u041a, \u041e\u0410\u041c\n\n\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430\n\u0414\u043b\u044f \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u043d\u0430\u043b\u0438\u0447\u0438\u044f\n\u2022 \u0414\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432 \u043a\u043e\u0441\u0442\u0438\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u044f\u0432\u043b\u0435\u043d\u0438\u0439\n\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043b \u0435\u0447\u0435\u043d\u0438\u0435\n\n9\n\n2.2 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439[3,8]:\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u041f\u0430\u0442\u043e\u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u044f\n\n\u042d\u043a\u0437\u043e\u0441\u0442\u043e\u0437 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0435, \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435 \u0438 \u041d\u0430 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u041a\u0430\u0440\u0442\u0438\u043d\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435, \u044d\u043a\u0437\u043e\u0441\u0442\u043e\u0437 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u0441\u0442\u0438\n\u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u0432 \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0432\u0438\u0434\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0447\u0435\u043b\u044e\u0441\u0442\u0438. \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0433\u043e\n\u0441\u043b\u043e\u044f \u043a\u043e\u0441\u0442\u0438.\n\n\u0413\u0438\u043f\u0435\u0440\u043e\u0441\u0442\u043e\u0437 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0413\u0438\u043f\u0435\u0440\u043e\u0441\u0442\u043e\u0437 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u041d\u0430 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u041a\u0430\u0440\u0442\u0438\u043d\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0441\u0442\u0438\u0442\u0430 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u043a\u043e\u0441\u0442\u0438\n\u0438\u043b\u0438 \u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u0438\u043b\u0438 \u0442\u0440\u0430\u0432\u043c\u043e\u0439, \u0447\u0442\u043e \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u044f\n\u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u043e\u0433\u043e \u0441\u043b\u043e\u044f \u043a\u043e\u0441\u0442\u0438.\n\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430. \u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438, \u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0449\u0438\u043c\u0438\u0441\u044f \u0432\n\u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0438 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0447\u0435\u043b\u044e\u0441\u0442\u0438.\n\u0410\u043c\u0435\u043b\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043c\u0430 \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e, \u041f\u0440\u0438 \u0430\u043c\u0435\u043b\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043c\u0435 \u041f\u0440\u0438 \u0430\u043c\u0435\u043b\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043c\u0435\n\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0442\u0441\u044f \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435\u043c \u0438\u043b\u0438 \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u043a\u043e\u0441\u0442\u0438 \u0432 \u0432\u0438\u0434\u0435 \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0430\u043b\u044c\u043d\u044b\u0435\n\u0432\u0435\u0440\u0435\u0442\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c \u0432\u0437\u0434\u0443\u0442\u0438\u0435\u043c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043e\u0447\u0430\u0433\u043e\u0432 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0443\u0447\u0430\u0441\u0442\u043a\u0430 \u0447\u0435\u043b\u044e\u0441\u0442\u0438, \u0438\u043d\u043e\u0433\u0434\u0430 \u0440\u0430\u0437\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0441 \u0447\u0435\u0442\u043a\u0438\u043c\u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b,\n\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u0437\u0443\u0431\u043e\u0432. \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0439\n\u0412 \u0440\u044f\u0434\u0435 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u043d\u0430\u0433\u043d\u0430\u0438\u0432\u0430\u044e\u0442\u0441\u044f. \u0420\u0435\u0436\u0435 (\u043f\u043e\u043b\u0438\u043a\u0438\u0441\u0442\u043e\u0437\u043d\u044b\u0439 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0439\u0441\u044f\n\n\u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0440\u0430\u0437\u0440\u044f\u0436\u0435\u043d\u0438\u044f). \u044d\u043c\u0430\u043b\u0435\u0432\u044b\u0439 \u043e\u0440\u0433\u0430\u043d \u0437\u0443\u0431\u043d\u043e\u0433\u043e\n\u0441\u0430\u043c\u043e\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u0431\u043e\u043b\u0435\u0439 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u041f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0437\u0430\u0447\u0430\u0442\u043a\u0430.\n\u0437\u0443\u0431\u043e\u0432, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0432 \u0437\u043e\u043d\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438. \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u044b\n\u043c\u0435\u0436\u0434\u0443 \u0441\u043e\u0431\u043e\u0439 \u043a\u043e\u0441\u0442\u043d\u044b\u043c\u0438\n\n\u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0430\u043c\u0438.\n\n10\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0412\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u043e\u0441\u0442\u043d\u044b\u0445 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u043e\u0434\u043e\u043d\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u043d\u0430 \u043a\u043e\u0436\u0435 \u0438\u043b\u0438 \u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043e\u0432 \u043d\u0430 \u0441\u043d\u0438\u043c\u043a\u0430\u0445 \u043a\u0430\u0440\u0442\u0438\u043d\u0430\n\u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0435 \u0441\u0432\u0438\u0449\u0435\u0439 \u0441 \u0433\u043d\u043e\u0439\u043d\u044b\u043c \u0447\u0435\u043b\u044e\u0441\u0442\u0435\u0439. \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u044b\u043c. \u041d\u043e\u044e\u0449\u0438\u0435 \u0431\u043e\u043b\u0438 \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430.\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0443\u0447\u0430\u0441\u0442\u043a\u0435 \u0447\u0435\u043b\u044e\u0441\u0442\u0438,\n\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u044c \u0438 \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u0437\u0443\u0431\u043e\u0432. \u041d\u0430\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u0445 \u043e\u0447\u0430\u0433\u0438 \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438\n\n\u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438.\n\u041e\u0441\u0442\u0435\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0417\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435. \u0420\u0430\u0441\u0442\u0450\u0442 \u0414\u0435\u0444\u0435\u043a\u0442 \u043a\u043e\u0441\u0442\u0438 \u0441 \u0427\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f\n\u0441\u0430\u0440\u043a\u043e\u043c\u0430 \u0431\u044b\u0441\u0442\u0440\u043e, \u0440\u0430\u043d\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u043b\u0438, \u043d\u0435\u0440\u043e\u0432\u043d\u044b\u043c\u0438 \u0432\u0435\u0440\u0435\u0442\u0435\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430 \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0443\u0431\u043e\u0432. \u0438\u0437\u044a\u0435\u0434\u0435\u043d\u043d\u044b\u043c\u0438 \u043a\u0440\u0430\u044f\u043c\u0438, \u0430\u044f \u0438 \u043a\u0440\u0443\u0433\u043b\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u043f\u0435\u0440\u0438\u043e\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f \u0444\u043e\u0440\u043c\u0430 \u0441\u0430\u0440\u043a\u043e\u043c\u044b\n\u0432 \u0432\u0438\u0434\u0435 \u0448\u0438\u043f\u043e\u0432-\u0441\u043f\u0438\u043a\u0443\u043b\n\n11\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f\u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\u043d\u0435\u0442.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418:\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u043e\u0441\u0442\u0435\u043e\u0433\u0435\u043d\u043d\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c\u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c\n\u0444\u0443\u043d\u043a\u0446\u0438\u0438.\n\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u0437 \u043e\u043f\u0443\u0445\u043e\u043b\u0438, \u043d\u0430\u0433\u043d\u043e\u0435\u043d\u0438\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438.\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\u041d\u0430 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0434 \u043c\u0435\u0441\u0442\u043d\u044b\u043c/\u043e\u0431\u0449\u0438\u043c\n\u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u0435\u043c. \u041f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435,\n\u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b.\n\n5.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c II;\n\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0421\u0442\u043e\u043b No15 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u0438\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438).\n\n5.2\u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e [4-6,8-12,14-16]:\n\u0427\u0430\u0441\u0442\u0438\u0447\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u043a\u0446\u0438\u044f \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0441 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0435\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438.\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430:\n\u2022 \u043e\u0441\u0442\u0435\u043e\u043c\u0430, \u043e\u0441\u0442\u0435\u043e\u0438\u0434-\u043e\u0441\u0442\u0435\u043e\u043c\u0430, \u043e\u0441\u0442\u0435\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043a\u043b\u0430\u0441\u0442\u043e\u043c\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432,\n\u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0432 \u043a\u043e\u0441\u0442\u043d\u043e\u043c \u043c\u0430\u0441\u0441\u0438\u0432\u0435.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\n\u2022 \u043b\u0435\u0433\u043e\u0447\u043d\u043e-\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c III-IV \u0441\u0442\u0435\u043f\u0435\u043d\u0438;\n\u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0441\u0432\u0435\u0440\u0442\u044b\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u0438, \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0435\u043d\u043e\u0441\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b;\n\u2022 \u0438\u043d\u0444\u0430\u0440\u043a\u0442 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 (\u043f\u043e\u0441\u0442\u0438\u043d\u0444\u0430\u0440\u043a\u0442\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434);\n\n\u2022 \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0444\u043e\u0440\u043c\u044b \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 (\u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439\n\u0434\u0438\u0430\u0431\u0435\u0442, \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435 \u044f\u0437\u0432\u0435\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0430 \u0438 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043f\u0435\u0440\u0441\u0442\u043d\u043e\u0439 \u043a\u0438\u0448\u043a\u0438,\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u0430\u044f/\u043f\u043e\u0447\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0438 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0440\u043e\u043a\u0438 \u0441\u0435\u0440\u0434\u0446\u0430\n\u0441 \u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u0438, \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c \u0438 \u0434\u0440\u0443\u0433\u0438\u0435);\n\n\u2022 \u043e\u0441\u0442\u0440\u044b\u0435 \u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438 \u0438 \u043f\u043e\u0447\u0435\u043a \u0441 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e;\n\u2022 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0432 \u0441\u0442\u0430\u0434\u0438\u0438 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f.\n\n\u042d\u043a\u0441\u043a\u043e\u0445\u043b\u0435\u0430\u0446\u0438\u044f (\u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0441 \u043a\u0430\u043f\u0441\u0443\u043b\u043e\u0439):\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\u2022 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u043f\u0440\u0438 \u043e\u0441\u0442\u0435\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043a\u043b\u0430\u0441\u0442\u043e\u043c\u0435, \u043e\u0434\u043e\u043d\u0442\u043e\u043c\u0435, \u0446\u0435\u043c\u0435\u043d\u0442\u043e\u043c\u0435;\n\n\u2022 \u043a\u043e\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\u2022 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u043f\u0440\u0435\u0434\u0438\u043d\u0444\u0430\u0440\u043a\u0442\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432\n\n12\n\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 3-6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0450\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0444\u0430\u0440\u043a\u0442\u0430 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430, \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c II \u0438 III \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0438\u0448\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0441\u0435\u0440\u0434\u0446\u0430 \u0441 \u0447\u0430\u0441\u0442\u044b\u043c\u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u043c\u0438\n\u0441\u0442\u0435\u043d\u043e\u043a\u0430\u0440\u0434\u0438\u0438, \u043f\u0430\u0440\u043e\u043a\u0441\u0438\u0437\u043c \u043c\u0435\u0440\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0430\u0440\u0438\u0442\u043c\u0438\u0438, \u043f\u0430\u0440\u043e\u043a\u0441\u0438\u0437\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f,\n\n\u043e\u0441\u0442\u0440\u044b\u0439 \u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u043d\u0434\u043e\u043a\u0430\u0440\u0434\u0438\u0442 \u0438 \u0434\u0440.);\n\u2022 \u043e\u0441\u0442\u0440\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 (\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442,\n\u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442 \u0438 \u0434\u0440.);", "type": "Document"}}