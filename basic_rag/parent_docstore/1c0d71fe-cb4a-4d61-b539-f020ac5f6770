0440\u0430\u043f\u0438\u044f.\n\n\u0421\u0442\u0430\u0434\u0438\u044f I \u0421 \u0420\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u0440\u0445\u043e\u0444\u0443\u043d\u0438\u043a\u0443\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f. \u0425\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n(pT1\u20134, N0, M0, S1\u20133) \u043a\u0430\u0440\u0431\u043e\u043f\u043b\u0430\u0442\u0438\u043d\u043e\u043c (1 \u043a\u0443\u0440\u0441 \u0432 \u0434\u043e\u0437\u0435 AUC7) \u0438\u043b\u0438 \u043b\u0443\u0447\u0435\u0432\u0430\u044f\n\u0442\u0435\u0440\u0430\u043f\u0438\u044f.\n\u0421\u0442\u0430\u0434\u0438\u044f II\u0410 \u0420\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u0440\u0445\u043e\u0444\u0443\u043d\u0438\u043a\u0443\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f. \u041b\u0443\u0447\u0435\u0432\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n(pT1\u20134, N1, M0, S0\u20131) \u0438/\u0438\u043b\u0438 \u041f\u0425\u0422. \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0437\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0439\n\u0421\u0442\u0430\u0434\u0438\u044f II\u0412 \u0420\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u0440\u0445\u043e\u0444\u0443\u043d\u0438\u043a\u0443\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f. \u041b\u0443\u0447\u0435\u0432\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n(pT1\u20134, N2, M0, S0\u20131) \u0438/\u0438\u043b\u0438 \u041f\u0425\u0422. \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0437\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0439\n\u0421\u0442\u0430\u0434\u0438\u044f II\u0421 \u0420\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u0440\u0445\u0438\u0444\u0443\u043d\u0438\u043a\u0443\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f. \u041f\u0425\u0422. \u0423\u0434\u0430\u