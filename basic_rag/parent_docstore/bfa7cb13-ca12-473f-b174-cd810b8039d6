4b\u0449\u0435\u043b\u043a\u0430\n\u0438 \u0412\u041d\u0427\u0421\n\nIIb \u2014 \u0432\u0435\u0442\u0432\u0438 \u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438 \u0433\u0438\u043f\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u044b, \u0438\u043c\u0435\u044e\u0442\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0443\u044e \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u044b\n\u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e \u0438 \u0441\u043f\u0435\u0440\u0435\u0434\u0438\n\n\u0422\u0438\u043f III \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u0435\u0442\u0432\u0438 \u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438\n\n\u0422\u0438\u043f IV \u0413\u0438\u043f\u043e\u043f\u043b\u0430\u0437\u0438\u044f \u0442\u0435\u043b\u0430 \u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438\n\n\uf0fc \u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043b\u043e\u0440\u0438\u0437\u043c I \u2013 III \u0441\u0442\u0435\u043f\u0435\u043d\u0438 (\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2).\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043b\u043e\u0440\u0438\u0437\u043c\u0430 [23,62]\n\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u0422\u0438\u043f \u041e\u0413 \u0418\u0437\u043c\u0435\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438\n\n\u041e\u0413\nI \u0441\u0442\u0435\u043f\u0435\u043d\u044c 1 \u0442\u0438\u043f \uf0fc \u041c\u041e\u0420 \u2013 \u043c\u0435\