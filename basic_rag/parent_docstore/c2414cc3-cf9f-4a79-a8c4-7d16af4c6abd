5\u0441\u043a\u0438\u0439\n\n\u0440\u0435\u0444\u043b\u0435\u043a\u0441\n\u0412\u0435\u0433\u0435\u0442\u0430\u0442\u0438\u0432\u043d\u044b \u041f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u041f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0423\u0433\u043d\u0435\u0442\u0435\u043d\u0438\u0435 \u043e\u0431\u0435\u0438\u0445\n\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0430\u0440\u0430\u0441\u0438\u043c\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\n\n\u0417\u0440\u0430\u0447\u043a\u0438 \u041c\u0438\u0434\u0440\u0438\u0430\u0437 \u041c\u0438\u043e\u0437 \u041d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439\n\u0440\u0430\u0437\u043c\u0435\u0440, \u0447\u0430\u0441\u0442\u043e\n\u0430\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f,\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0440\u0435\u0430\u043a\u0446\u0438\u044f \u043d\u0430 \u0441\u0432\u0435\u0442\n\u0414\u044b\u0445\u0430\u043d\u0438\u0435 \u0421\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0435 \u0421\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0435, \u0438\u043d\u043e\u0433\u0434\u0430 \u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0435,\n\u0430\u043f\u043d\u043e\u044d \u0430\u043f\u043d\u043e\u044d\n\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u0422\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0411\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0412\u0430\u0440\u044c\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0445\n\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0439\n\u0421\u0435\u043a\u0440\u0435\u0446\u0438\u044f \u0421\u043a\u0443\u0434\u043d\u0430\u044f \u041e\u0431\u0438\u043b\u044c\u043d\u0430\u044f \u0412\u0430\u0440\u044c\u0438\u0440\u0443\u