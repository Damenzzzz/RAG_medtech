\u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441 \u0434\u0430\u0442\u044b \u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\u043d\u043e\u0432\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\n12. \u0421\u043f\u0438\u0441\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b:\n1) \u041c\u0438\u0442\u0440\u043e\u0444\u0430\u043d\u043e\u0432 \u0410.\u0418., \u0427\u0435\u0432\u0430\u0440\u0434\u0438\u043d \u0410.\u042e. \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u043e\u0441\u0442\u0435\u043e\u0441\u0438\u043d\u0442\u0435\u0437\u0430 \u043f\u0440\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u0442\u0440\u0430\u0432\u043c \u0434\u043b\u0438\u043d\u043d\u044b\u0445 \u0442\u0440\u0443\u0431\u0447\u0430\u0442\u044b\u0445\n\n\u043a\u043e\u0441\u0442\u0435\u0439 (\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u043e\u0441\u0442\u0435\u043e\u0441\u0438\u043d\u0442\u0435\u0437\u0430) // \u0413\u0435\u043d\u0438\u0439 \u041e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438. - 2014. - No 3. \u2013 \u0421.13-15.\n2) \u041c\u0438\u0442\u0440\u043e\u0448\u0438\u043d \u0410.\u041d., \u041a\u0438\u0441\u043b\u043e\u0432 \u0410.\u0418., \u041b\u0438\u0442\u0432\u0438\u043d\u043e\u0432 \u0421.\u0414., \u041a\u0438\u0431\u