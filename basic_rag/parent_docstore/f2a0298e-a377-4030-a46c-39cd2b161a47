0442\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\u041d\u0430 \u0441\u0442\u0430\u0434\u0438\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438:\n\n- \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433;\n- \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442;\n\n7\n\n- \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433;\n\n- \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440.\n\u041f\u0440\u0438 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0435 \u0411\u0413:\n- \u0432\u0440\u0430\u0447-\u0433\u0435\u043d\u0435\u0442\u0438\u043a;\n- \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433;\n\n- \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440;\n- \u043b\u043e\u0433\u043e\u043f\u0435\u0434;\n- \u0445\u0438\u0440\u0443\u0440\u0433;\n- \u0441\u0442\u043e\u043c\u0430\u0442\u043e\u043b\u043e\u0433 [24];\n\n- \u0434\u0438\u0435\u0442\u043e\u043b\u043e\u0433;\n- \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433;\n- \u0443\u0440\u043e\u043b\u043e\u0433 [25];\n- \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433;\n\n- \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u0438.\n\n2.2. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c [26].\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a 1. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0411\u0413.\n\n8\n\n2.3. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1 \u2013 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0411\u0413.\n\u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0441\u0445\u043e\u0436\u0438\u0435 \u0441 \u0411\u0413\n\u042d\u043a\u0441\u043f\u0430\u043d\u0441\u0438\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043e\u0432 \u0424\u0435\u043d\u043e\u0442\u0438\u043f\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041c\u0443\u0442\u0430\u0446\u0438\u0438 \u0432 \u0433\u0435\u043d\u0435 C9ORF\nC9ORF72 \u043a\u0430\u043a \u0411\u0413. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043c\u043e\u0433\u0443\u0442 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c\u0441\u044f \u0445\u043e\u0440\u0435\u044f, \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f,\n\n\u0430\u0442\u0430\u043a\u0441\u0438\u044f, \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c, \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441\n\u0438 \u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438.\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c\u044b, \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0435 HDL \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u0411\u0413, \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0412\u0441\u0442\u0430\u0432\u043a\u0438 \u043e\u043a\u0442\u0430\u043f\u0435\u043f\u0442\u0438\u0434\u043d\u044b\u0445 \u043f\u043e\u0432\u0442\u043e\u0440\u043e\u0432 \u0432\n\u0411\u0413 (Huntington disease- \u0442\u0430\u043a\u0436\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b \u044d\u043f\u0438\u043b\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0435\u043d PRNP \u043d\u0430 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u0435 20\n\nlike syndromes - HDL \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b. \u042d\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043d\u043e \u0432\u0441\u0442\u0430\u0432\u043a\u0430\u043c\u0438\nsyndromes) \u043e\u043a\u0442\u0430\u043f\u0435\u043f\u0442\u0438\u0434\u043d\u044b\u0445 \u043f\u043e\u0432\u0442\u043e\u0440\u043e\u0432 \u0432 \u0433\u0435\u043d\nPRNP \u043d\u0430 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u0435 20,\n\u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u043f\u0440\u0438\u043e\u043d\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a.\n\n\u0414\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0445\u043e\u0440\u0435\u0435\u0439 \u0432 \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0410\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0435 \u043c\u0443\u0442\u0430\u0446\u0438\u0438\n\u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0445\u043e\u0440\u0435\u044f \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0436\u0435\u0442 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0435\u043d\u0430 NKX2-1 (\u0442\u0430\u043a\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u0430\u043a\n\u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c\u0441\u044f \u0441 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u043c. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u0433\u0435\u043d TITF1) \u043d\u0430 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u0435 14q.\n\u043d\u0430 \u0441\u0432\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435, \u044d\u0442\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u0424\u0435\u043d\u043e\u0442\u0438\u043f\u044b, \u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u0441\n\n\u043d\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435. \u0423 \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439\n\u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0445\u043e\u0440\u0435\u0435\u0439, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0432 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0438 \u0441 \u0433\u0435\u043d\u043e\u043c NKX2-1, \u0431\u044b\u043b\u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0441\n\u0438\u043b\u0438 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438, \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u043c\u0443\u0442\u0430\u0446\u0438\u044f\u043c\u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u0435\u043d\u0430\u0445,\n\n\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f ADCY5, PDE10A, GNAO1\n\u0434\u0438\u0437\u0430\u0440\u0442\u0440\u0438\u044f, \u0430\u043a\u0441\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f, \u0438 SLC16A2. \u041f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u0433\u0435\u043d NKX2-\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u043e\u0445\u043e\u0434\u043a\u0438, \u0442\u0438\u043a\u0438, \u0442\u0440\u0435\u043c\u043e\u0440 1 \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\n\u0438\u043b\u0438 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u043d\u0438\u044f. \u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b,\n\n\u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u044d\u0442\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0447\u0430\u0441\u0442\u043e\n9\n\n\u0441\u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043a\u043b\u044e\u0447\u043e\u043c, \u043e\u0442\u0441\u044e\u0434\u0430\n\u0438 \u0442\u0435\u0440\u043c\u0438\u043d \u00ab\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043c\u043e\u0437\u0433-\u043b\u0435\u0433\u043a\u0438\u0435-\n\u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u0430\u00bb.\n\u0414\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u0443\u0431\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0423 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 DRPLA \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0414\u0435\u043d\u0442\u0430\u0442\u043e\u0440\u0443\u0431\u0440\u0430\u043b\u044c\u043d\u0430\u044f\n\n\u043f\u0430\u043b\u043b\u0438\u0434\u043e\u043b\u0443\u0438\u0437\u043e\u0432\u0430\u044f \u0430\u0442\u0430\u043a\u0441\u0438\u044e, \u0445\u043e\u0440\u0435\u043e\u0430\u0442\u0435\u0442\u043e\u0437 \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u043b\u043b\u0438\u0434\u043e\u043b\u0443\u0438\u0437\u043e\u0432\u0430\u044f \u0430\u0442\u0440\u043e\u0444\u0438\u044f \u2014\n\u0430\u0442\u0440\u043e\u0444\u0438\u044f (DRPLA) \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u043c\u043e\u0436\u0435\u0442 DRPLA \u2014 \u0440\u0435\u0434\u043a\u043e\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435,\n\u0438\u043c\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0411\u0413. \u0412 \u044e\u043d\u043e\u0448\u0435\u0441\u043a\u0438\u0445 \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u043e\u0435 \u044d\u043a\u0441\u043f\u0430\u043d\u0441\u0438\u0435\u0439 \u0442\u0440\u0438\u043f\u043b\u0435\u0442\u0430\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f CAG \u0432 \u0433\u0435\u043d\u0435 ATN1, \u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0449\u0435\u043c\n\n\u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u044d\u043f\u0438\u043b\u0435\u043f\u0441\u0438\u044f, \u0430\u0442\u0440\u043e\u0444\u0438\u043d-1. \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442\n\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0447\u0430\u0441\u0442\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u043f\u043e\n\u044e\u043d\u043e\u0448\u0435\u0441\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445. \u043e\u0442\u0446\u043e\u0432\u0441\u043a\u043e\u0439 \u043b\u0438\u043d\u0438\u0438. \u0414\u0420\u041f\u041b\u0410\n\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0430 \u0432\n\n\u042f\u043f\u043e\u043d\u0438\u0438, \u043d\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445\n\u044d\u0442\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0440\u0443\u043f\u043f\u0430\u0445. \u0412\u043e\u0437\u0440\u0430\u0441\u0442\n\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u0430\u0440\u044c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432 \u0448\u0438\u0440\u043e\u043a\u0438\u0445\n\u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445.\n\n\u0421\u043f\u0438\u043d\u043e\u0446\u0435\u0440\u0435\u0431\u0435\u043b\u043b\u044f\u0440\u043d\u0430\u044f \u0413\u0440\u0443\u043f\u043f\u0430 \u0433\u0435\u0442\u0435\u0440\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432, \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0435\n\u0430\u0442\u0430\u043a\u0441\u0438\u044f (SCA) 1,2,3,17 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0438\u0445\u0441\u044f \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b SCA\n\u0442\u0438\u043f\u043e\u0432 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0439 \u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u043e\u0439\n\u0430\u0442\u0430\u043a\u0441\u0438\u0435\u0439, \u0447\u0430\u0441\u0442\u043e \u0441\u043e\u0447\u0435\u0442\u0430\u044e\u0449\u0435\u0439\u0441\u044f \u0441\n\n\u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a\n\u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043f\u043b\u0435\u0433\u0438\u044f, \u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043d\u044b\u0435 \u0438\u043b\u0438\n\u044d\u043a\u0441\u0442\u0440\u0430\u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b,\n\u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043f\u043e\u0442\u0435\u0440\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\n\u0438 \u0434\u0435\u043c\u0435\u043d\u0446\u0438\u044f. \u041d\u0430\u0447\u0430\u043b\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\n\u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0438\u043b\u0438 \u043f\u043e\u0436\u0438\u043b\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435, \u043d\u043e\n\u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 20\n\u0434\u043e 40 \u043b\u0435\u0442. \u0422\u0438\u043f\u044b SCA 1, 2, 3 \u0438 17\n\n10\n\n\u0447\u0430\u0449\u0435, \u0447\u0435\u043c \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0438\u043f\u044b SCA,\n\n\u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u0445\u043e\u0440\u0435\u044e.\n\u041c\u0443\u0442\u0430\u0446\u0438\u0438 ADCY5 \u0438 \u0414\u0430\u043d\u043d\u044b\u0435 \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041c\u0443\u0442\u0430\u0446\u0438\u044f \u0433\u0435\u043d\u043e\u0432 ADCY5 \u0438\u043b\u0438\nPDE10A \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0441\u043f\u0435\u043a\u0442\u0440 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435. PDE10A.\n\u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u041f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0432 \u043f\u0435\u0440\u0432\u044b\u0435\n\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432, \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u0445 \u0432 \u043c\u043e\u0437\u0433\u0430. \u0433\u043e\u0434\u044b \u0436\u0438\u0437\u043d\u0438; \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435\n\u0434\u0435\u0442\u0441\u0442\u0432\u0435, \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u043f\u043e\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u043d\u0438\u044f \u043b\u0438\u0446\u0430;\n\u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0435\u0439 \u0441 \u043f\u0430\u0440\u043e\u043a\u0441\u0438\u0437\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\n\u043c\u0438\u043e\u043a\u0438\u043c\u0438\u0435\u0439 \u043b\u0438\u0446\u0430. \u0425\u043e\u0440\u0435\u044f \u0447\u0430\u0441\u0442\u043e \u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437\u043e\u0432 \u0441 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u043e\u0447\u044c\u044e\n\n\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u043c, \u0438\u043b\u0438 \u043f\u0440\u0438 \u043f\u0440\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u0438.\n\u0442\u0430\u043a\u0436\u0435 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043c\u043e\u0433\u0443\u0442 \u041d\u0430 \u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c\u0441\u044f \u043c\u0438\u043e\u043a\u0438\u043c\u0438\u0438 \u043b\u0438\u0446\u0430, \u0433\u0438\u043f\u0435\u0440\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435 \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0435\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f \u0438 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441. \u0423 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0441\u0430\u0442\u043e\u0433\u043e \u0442\u0435\u043b\u0430.\n\n\u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043c\u043e\u0433\u0443\u0442\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0442\u044c \u044d\u043f\u0438\u0437\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c\n\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0441\u0442\u0430\u043d\u0435\u0442\n\n\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c.\n\u041d\u0435\u0439\u0440\u043e\u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u044f \u0420\u0435\u0434\u043a\u0438\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041c\u0443\u0442\u0430\u0446\u0438\u0438 \u0433\u0435\u043d\u0430 FTL, \u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e\n(NBIA) \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c, \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435. \u043b\u0435\u0433\u043a\u0443\u044e \u0446\u0435\u043f\u044c \u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u0430.\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044e, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0445 \u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u041d\u0430 \u041c\u0420\u0422 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u0435\n\n\u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u043e\u0437\u0433\u0430. \u0436\u0435\u043b\u0435\u0437\u0430, \u043a\u0438\u0441\u0442\u043e\u0437\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0438\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0410\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u043d\u0435\u043a\u0440\u043e\u0437 \u0432 \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0433\u0430\u043d\u0433\u043b\u0438\u044f\u0445.\n\u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0432\u043e \u0432\u0437\u0440\u043e\u0441\u043b\u043e\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d.\n\u044d\u043a\u0441\u0442\u0440\u0430\u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043d\u044b\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439,\n\u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0445\u043e\u0440\u0435\u044f, \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f \u0438\u043b\u0438\n\n\u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u044b\u0447\u043d\u043e\n\u043d\u043e\u0441\u044f\u0442 \u0430\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440, \u0430\n\u0442\u0430\u043a\u0436\u0435 \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0445\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439.\n\u0422\u0430\u043a\u0436\u0435 \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c\u0441\u044f\n\n11\n\n\u0434\u0438\u0437\u0430\u0440\u0442\u0440\u0438\u044f, \u0441\u043f\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438", "type": "Document"}}