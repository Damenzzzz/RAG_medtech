4\u044b;\n\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a \u0412\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430: \u043e\u0441\u043c\u043e\u0442\u0440, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u043e\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435, \u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f \u0441\u0435\u0441\u0442\u0440\u0430\n\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f) \u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044e \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432.\n\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c; \u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0441\u0435\u0441\u0442\u0440\u0438\u043d\u0441\u043a\u0438\u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u044f\u0446\u0438\u0438;\n\u0420\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u043e\u0446\u0435\u043d\u043a\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0435\u0440\u0435\u0434 \u0438\u043d\u0444\u0443\u0437\u0438\u0435\u0439 \u0424\u0417\u0422 \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\n\u0412\u043e\u043f\u0440\u043e\u0441\u044b \u041c\u0421\u042d\u041a; \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439;\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430;\n\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0438 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u0438\n\u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430; \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043b\u0435\u0447\u0435\u0431\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440;\n\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (\u0424\u0417\u0422) \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f;\n\u041e\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043f\u0430\u043b\u043b\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u041e\u0431\u0443\u0447\u0430\u0435\u0442 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043c\n\u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u044b\u043f\u0438\u0441\u043a\u0438 \u043d\u0430 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e\\\u0442\u0435\u043b\u0435\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0443 \u0432 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440;\n\u043f\u043e\u043c\u043e\u0449\u0438. \u0443\u0445\u043e\u0434\u0430 \u0437\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u043c \u0441 \u0411\u0424;\n\u0410\u043d\u0430\u043b\u0438\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0435\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u0442 \u043a\u043e\u043c\u043f\u043b\u0430\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u044c\n\u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0443 \u0438 \u0435\u0433\u043e \u0441\u0435\u043c\u044c\u0435.\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.\n\u041e\u0441\u043c\u043e\u0442\u0440 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 (\u0441\u043c. \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 3) \u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439\n\u0413\u0435\u043d\u0435\u0442\u0438\u043a \u041d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f \u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e-\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430; \u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u043a\u043e-\u0433\u0435\u043d\u0435\u0430\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043b\u0438\u0446 \u0433\u0440\u0443\u043f\u043f\u044b \u0440\u0438\u0441\u043a\u0430 \u0432 \u0434\u0430\u043d\u043d\u043e\u0439 \u0441\u0435\u043c\u044c\u0435; \u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043b\u044f \u043f\u043e\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0435\u043c\u044c\u0438.\n\u041d\u0435\u0444\u0440\u043e\u043b\u043e\u0433 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u043f\u043e\u0447\u0435\u043a, \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433, \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439; \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0430\u0434\u0438\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438.\n\u041a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433 \u0412\u0441\u0435\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0411\u0424 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0430 (\u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u044f \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430 \u043d\u0435\u044f\u0441\u043d\u043e\u0433\u043e\n\u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0440\u0438\u0442\u043c\u0430 \u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u0435\u0440\u0434\u0446\u0430, \u0440\u0435\u0433\u0443\u0440\u0433\u0438\u0442\u0430\u0446\u0438\u044f \u0430\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438 \u043c\u0438\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430 ) \u0441 \u0446\u0435\u043b\u044c\u044e\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0442\u0430\u043a\u0442\u0438\u043a\u0438 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 (\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435/ \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438 \u043e\u0446\u0435\u043d\u043a\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f).\n\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433 \u041e\u0441\u043c\u043e\u0442\u0440 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0426\u041d\u0421, \u041f\u041d\u0421 \u0438 \u0412\u041d\u0421 \u0441 \u043e\u0446\u0435\u043d\u043a\u043e\u0439 \u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438; \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433, \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0438\u043d\u0441\u0443\u043b\u044c\u0442\u0430.\n\u0413\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433 \u041e\u0441\u043c\u043e\u0442\u0440 \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0416\u041a\u0422, \u0441\u0432\u043e\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f.\n\u0414\u0435\u0440\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0430\u043d\u0433\u0438\u043e\u043a\u0435\u0440\u0430\u0442\u043e\u043c\n\u041f\u0441\u0438\u0445\u0438\u0430\u0442\u0440/\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433 \