0434\u043e\u0432\u0430\u043d\u0438\u044f [1,2,4,9,12,13,17]:\n\u2022 \u041e\u0410\u041a \u2013 \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f, \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u0435\u0437/\u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0437;\uf020\n\n\u2022 \u043a\u0430\u043b \u043d\u0430 \u044f\u0439\u0446\u0430 \u0433\u043b\u0438\u0441\u0442 \u0438 \u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u0435;\uf020\n\u2022 \u043a\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430: \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0435\u043d\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0438, \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0436\u0438\u0440\u0430,\n\u0437\u0435\u0440\u0435\u043d \u043a\u0440\u0430\u0445\u043c\u0430\u043b\u0430, \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0432\u043e\u043b\u043e\u043a\u043e\u043d;\uf020\n\n\u2022 \u0418\u0424\u0410 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430 \u043d\u043e\u0440\u0444\u043e\u043b\u043a \u0438 \u0440\u043e\u0442\u0430\u0432\u0438\u0440\u0443\u0441\u043e\u0432 \u0432 \u0444\u0435\u043a\u0430\u043b\u0438\u044f\u0445;\uf020\n\u2022 \u041f\u0426\u0420 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0420\u041d\u041a \u044d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043e\u0432, \u043d\u043e\u0440\u0444\u043e\u043b\u043a (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c) \u0438\n\u0440\u043e\u0442\u0430\u0432\u0438\u0440\u0443\u0441\u043e\u0432 \u0432 \u0444\u0435\u043a\u0430\u043b\u0438\u044f\u0445.\uf020\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n\u2022 \u0431/\u0445 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438,\n\u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430, \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d, \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439 \u0430\u0437\u043e\u0442, \u043e\u0431\u0449\u0438\u0439 \u0431\u0435\u043b\u043e\u043a (\u043f\u0440\u0438 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0438);\uf020\n\u2022 \u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430 (\u043f\u0440\u0438 \u0414\u0412\u0421-\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435).\uf020\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0430 \u2013 \u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u0430\u043f\u043f\u0435\u043d\u0434\u0438\u0446\u0438\u0442, \u043a\u0438\u0448\u0435\u0447\u043d\u0443\u044e\n\u043d\u0435\u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c, \u0438\u043d\u0432\u0430\u0433\u0438\u043d\u0430\u0446\u0438\u044e \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430.\uf020\n\n2.1 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c [1,2,3]:\n\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430; \u0440\u0432\u043e\u0442\u0430; \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b\n\n\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437:\n\n\u0444\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435:\n\u2013 \u0421\u0430\u043b\u044c\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437\n\u2013 \u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430, \u043f\u0440\u0438\u043d\u043e\u0441\u044f\u0449\u0430\u044f\n\u2013 \u042d\u0448\u0435\u0440\u0438\u0445\u0438\u043e\u0437\n\u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u0435, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u0441 \u043f\u0440\u0438\u0435\u043c\u043e\u043c\n\u043f\u0438\u0449\u0438, \u0443 \u0434\u0435\u0442\u0435\u0439 \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u2013 \u0425\u043e\u043b\u0435\u0440\u0430\n\u0443\u043f\u043e\u0440\u043d\u044b\u0435 \u0441\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u044f; \u2013 \u041a\u0438\u0448\u0435\u0447\u043d\u044b\u0439 \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437\n\u2013 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u043e\u0433\u043e \u0441\u0442\u0443\u043b\u0430 \u0431\u0435\u0437 \u2013 \u041a\u0438\u0448\u0435\u0447\u043d\u044b\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438,\n\u0437\u0430\u043f\u0430\u0445\u0430, \u0441 \u043d\u0435\u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0435\u043d\u043d\u044b\u043c\u0438\n\u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u043d\u043e-\n\u043a\u043e\u043c\u043e\u0447\u043a\u0430\u043c\u0438;\n\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0439 \u0444\u043b\u043e\u0440\u043e\u0439\n\u2013 \u0443\u0440\u0447\u0430\u043d\u0438\u0435 \u043f\u043e \u0445\u043e\u0434\u0443 \u0442\u043e\u043d\u043a\u043e\u0433\u043e\n\u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430;\n\u2013 \u043c\u0435\u0442\u0435\u043e\u0440\u0438\u0437\u043c;\n\u2013 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f: \u0441\u0443\u0445\u043e\u0441\u0442\u044c\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a \u0438 \u043a\u043e\u0436\u0438,\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0432\u0435\u0440\u043e\u044f\u0442\u0435\u043d\n\u0436\u0430\u0436\u0434\u0430 \u0438\u043b\u0438 \u043e\u0442\u043a\u0430\u0437\u0430 \u043e\u0442 \u043f\u0438\u0442\u044c\u044f,\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u044d\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0436\u0438 \u0438\n\u0442\u0443\u0440\u0433\u043e\u0440\u0430 \u0442\u043a\u0430\u043d\u0435\u0439, \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0445\n\u0433\u043b\u0430\u0437, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430.\n\u0412\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u0434\u0438\u0430\u0440\u0435\u044f\n\u041e\u0410\u041a-\u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f,\n\n\u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u0435\u0437/\u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0437\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\n\n8\n\n\u042d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043c\u043d\u0435\u0437:\n\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u2022 \u0418\u0424\u0410\u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430\n\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432; \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u043e\u0440\u0444\u043e\u043b\u043a \u0438 \u0440\u043e\u0442\u0430\u0432\u0438\u0440\u0443\u0441\u043e\u0432 \u0432\n\u0432\u0441\u043f\u044b\u0448\u043a\u0430\u0445 \u043a\u0438\u0448\u0435\u0447\u043d\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439, \u0432 \u0444\u0435\u043a\u0430\u043b\u0438\u044f\u0445.\n\n\u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043e \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u2022 \u041f\u0426\u0420 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0420\u041d\u041a\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430\u0445; \u0447\u043b\u0435\u043d\u044b \u0441\u0435\u043c\u044c\u0438 \u0438\u043b\u0438 \u044d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043e\u0432 \u0432 \u0444\u0435\u043a\u0430\u043b\u0438\u044f\u0445.\n\u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u0430 \u0438\u043c\u0435\u044e\u0442\n\u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b.\n\n2.2 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 [1-5]:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0421\u0430\u043b\u044c\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0440\u0432\u043e\u0442\u0430, \u0436\u0438\u0434\u043a\u0438\u0439 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0412\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b \u0441 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c \u0437\u0430\u043f\u0430\u0445\u043e\u043c, \u0447\u0430\u0441\u0442\u043e \u0441\n\u0441\u0442\u0443\u043b. \u043f\u043e\u0441\u0435\u0432 \u0440\u0432\u043e\u0442\u043d\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u0437\u0435\u043b\u0435\u043d\u0438 \u0438 \u0446\u0432\u0435\u0442\u0430 \u0431\u043e\u043b\u043e\u0442\u043d\u043e\u0439 \u0442\u0438\u043d\u044b. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u043a\u0430\u043b\u0430 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f.\n\u042d\u043d\u0442\u0435\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u0433\u0435 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0440\u0432\u043e\u0442\u0430, \u0436\u0438\u0434\u043a\u0438\u0439 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0412 \u043e\u0431\u0449\u0435\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435 \u043a\u0440\u043e\u0432\u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441\n\n\u043d\u043d\u044b\u0439 \u0441\u0442\u0443\u043b. \u043f\u043e\u0441\u0435\u0432 \u0440\u0432\u043e\u0442\u043d\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u0435\u0437\u043e\u043c. \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u044d\u0448\u0435\u0440\u0438\u0445\u0438\u043e\u0437 \u043a\u0430\u043b\u0430 \u044d\u043d\u0442\u0435\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u0433\u0435\u043d\u043d\u043e\u0433\u043e \u044d\u0448\u0435\u0440\u0438\u0445\u0438\u043e\u0437\u0430.\n\u0425\u043e\u043b\u0435\u0440\u0430 \u0412\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b. \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0411\u043e\u043b\u044c \u0432 \u0436\u0438\u0432\u043e\u0442\u0435 \u043d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430. \u0421\u0442\u0443\u043b \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439, \u0446\u0432\u0435\u0442\n\u043f\u043e\u0441\u0435\u0432 \u0440\u0432\u043e\u0442\u043d\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438 \u0440\u0438\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0442\u0432\u0430\u0440\u0430 \u0431\u0435\u0437 \u0437\u0430\u043f\u0430\u0445\u0430, \u0438\u043d\u043e\u0433\u0434\u0430 \u0441 \u0437\u0430\u043f\u0430\u0445\u043e\u043c \u0441\u044b\u0440\u043e\u0439\n\u043a\u0430\u043b\u0430 \u0440\u044b\u0431\u044b. \u0420\u0432\u043e\u0442\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0434\u0438\u0430\u0440\u0435\u0438. \u0411\u044b\u0441\u0442\u0440\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\n\u044d\u043a\u0441\u0438\u043a\u043e\u0437\u0430.\n\n\u0418\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442,\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0442\u0435\u043b\u0430.\n\u041a\u0438\u0448\u0435\u0447\u043d\u044b\u0439 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0440\u0432\u043e\u0442\u0430, \u0436\u0438\u0434\u043a\u0438\u0439 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430. \u0418\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u043f\u0443\u043f\u043a\u0430\n\u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437 \u0441\u0442\u0443\u043b. \u043f\u043e\u0441\u0435\u0432 \u0440\u0432\u043e\u0442\u043d\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438 \u0438\u043b\u0438 \u043f\u0440\u0430\u0432\u043e\u0439 \u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041e\u0431\u0438\u043b\u044c\u043d\u044b\u0439,\n\u043a\u0430\u043b\u0430 \u0437\u043b\u043e\u0432\u043e\u043d\u043d\u044b\u0439, \u043d\u0435\u0440\u0435\u0434\u043a\u043e\n\u0441 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u0441\u043b\u0438\u0437\u0438 \u0438 \u043a\u0440\u043e\u0432\u0438 \u0441\u0442\u0443\u043b. \u0412 \u043e\u0431\u0449\u0435\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435\n\u043a\u0440\u043e\u0432\u0438 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u0435\u0437\u043e\u043c.\n\n\u041a\u0438\u0448\u0435\u0447\u043d\u044b\u0435 \u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0440\u0432\u043e\u0442\u0430, \u0436\u0438\u0434\u043a\u0438\u0439 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\u0438 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u0441\u0442\u0443\u043b. \u043f\u043e\u0441\u0435\u0432 \u0440\u0432\u043e\u0442\u043d\u044b\u0445 \u043c\u0430\u0441\u0441 \u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435 \u0433\u043e\u0434\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f\n\u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u043a\u0430\u043b\u0430. \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u0438\u0442 \u0438 \u044d\u043d\u0442\u0435\u0440\u0438\u0442, \u0440\u0435\u0436\u0435 \u2014 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043a\u043e\u043b\u0438\u0442,\n\u0443\u0441\u043b\u043e\u0432\u043d\u043e- \u044d\u043d\u0442\u0435\u0440\u043e\u043a\u043e\u043b\u0438\u0442. \u0423 \u0434\u0435\u0442\u0435\u0439 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u0436\u0438\u0437\u043d\u0438 \u043a\u043b\u0438\u043d\u0438\u043a\u0430\n\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0441\u0440\u043e\u043a\u043e\u0432 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u0423\n\u0444\u043b\u043e\u0440\u043e\u0439 (\u0423\u041f\u0424) \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u0436\u0438\u0437\u043d\u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u043d\u0435\u0440\u0435\u0434\u043a\u043e\n\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0442\u043e\u043a\u0441\u0438\u043a\u043e\u0437\u0430 \u0438 \u044d\u043a\u0441\u0438\u043a\u043e\u0437\u0430 I-II\n\u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0414\u0438\u0430\u0440\u0435\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u043e-\n\u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430.\n\n9", "type": "Document"}}