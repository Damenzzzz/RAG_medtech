438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0432 \u0440\u043e\u0433\u043e\u0432\u0438\u0447\u043d\u043e\u0433\u043e\n\u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u044f.\n\u041f\u0430\u0445\u0438\u043c\u0435\u0442\u0440\u0438\u044f (\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u043b\u0449\u0438\u043d\u044b \u0440\u043e\u0433\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438\n\n\u0433\u043b\u0430\u0437\u0430) \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u0432\u0430\u0436\u043d\u044b\u0435 \u0434\u043b\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f.\n\n5) \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f **:\n\n\u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0420\u0435\u0436\u0438\u043c \u2013 III \u0411;\n\u0414\u0438\u0435\u0442\u0430 \u2013 \u0441\u0442\u043e\u043b No15 (\u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439).\n\n\u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c 