a\u0430\u043b\u044c\u043d\u044b\u0435 \u0438 \u043f\u0435\u0440\u0438\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u0447\u043a\u0438 (\u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u043a\u043e\u043b\u044c\u0446\u0430\n\u0432\u044b\u0441\u043e\u043a\u043e\u0430\u0441\u0444\u0435\u0440\u0438\u0447\u043d\u044b\u0445 \u043c\u0438\u043a\u0440\u043e\u043b\u0438\u043d\u0437, \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0430 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0444\u043e\u043a\u0443\u0441\u043d\u044b\u0445 \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u043e\u0432 \u0438\n\u0434\u0440\u0443\u0433\u0438\u0435) [38, 45,46]\n\n5. \u0410\u043a\u043a\u043e\u043c\u043e\u0434\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u043a\u043a\u043e\u043c\u043e\u0434\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u044f\u0445 \u0440\u0435\u0444\u0440\u0430\u043a\u0446\u0438\u0438 [45,46]\n\u0423 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432 \u0441 \u043c\u0438\u043e\u043f\u0438\u0435\u0439 \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u044f\n\u0430\u043a\u043a\u043e\u043c\u043e\u0434\u0430\u0446\u0438\u0438 \u0432\u0431\u043b\u0438\u0437\u0438, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0439 \u0430\u043a\u043a\u043e\u043c\u043e\u0434\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043a\u043e\u043d\u0432\u0435\u0440\u0433\u0435\u043d\u0446\u0438\u0438 \u0438 \u044d\u0437\u043e\u0444\u043e\u0440\u0438\u0438.\n\n\u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043c\u0438\u043e\u043f\u0438\u0438 \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0442 \u0441 \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u043c\u0438\n\u0430\u043a\u043a\u043e\u043c\u043e\u0434\u0430\u0446\u0438\u0438, \u0432\u0435\u0440\u0433\u0435\u043d\u0446\u0438\u0438 \u0438 \u0432 \u0446\u0435\u043b\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0431\u0438\u043d\u043e\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0437\u0440\u0435\u043d\u0438\u044f.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [47-53]\n1. \u0410\u0442\u0440\u043e\u043f\u0438\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0439 \u043e\u0441\u0435\u0432\u043e\u0439 \u043c\u0438\u043e\u043f\u0438\u0438 \u0443 \u0434\u0435\u0442\u0435\u0439 [47-53]\n\n\u041d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u0430\u0442\u0440\u043e\u043f\u0438\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u043c,\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432 \u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0438\u043e\u043f\u0438\u0438 \u0431\u044b\u043b\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u0430.\n\u0410\u0442\u0440\u043e\u043f\u0438\u043d \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0441\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u0414\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043c\u0438\u043e\u043f\u0438\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043d\u0438\u0437\u043a\u043e\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\n\n\u0430\u0442\u0440\u043e\u043f\u0438\u043d\u0430 \u0441\u0443\u043b\u044c\u0444\u0430\u0442\u0430, \u0432 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f\u0445 0,01%, 0,025% \u0438\u043b\u0438 0,05% (\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0432 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043e \u0432 \u043e\u0442\u0434\u0435\u043b\u0430\u0445 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432 \u0432 \u0430\u043f\u0442\u0435\u043a\u0430\u0445 \u043f\u043e \u0440\u0435\u0446\u0435\u043f\u0442\u0443). \u0422\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u0443\u0442\u0435\u043c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e\n\u0437\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u043d\u0438\u044f \u0432 \u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u0430\u0442\u0440\u043e\u043f\u0438\u043d\u0430 \u0441\u0443\u043b\u044c\u0444\u0430\u0442\u0430 \u0432 \u043d\u0438\u0437\u043a\u043e\u0439\n\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0430 \u043d\u043e\u0447\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0410\u0442\u0440\u043e\u043f\u0438\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0438\u0437\u043a\u0438\u043c\u0438\n\u0434\u043e\u0437\u0430\u043c\u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0432\u044b\u0431\u043e\u0440\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439 2\u201315 \u043b\u0435\u0442 \u043f\u0440\u0438 \u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0439\n\u043c\u0438\u043e\u043f\u0438\u0438. \u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u043d\u0438\u044f \u0430\u0442\u0440\u043e\u043f\u0438\u043d\u0430 \u0432 \u043d\u0438\u0437\u043a\u0438\u0445 \u0434\u043e\u0437\u0430\u0445 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u044b \u0434\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0440\u0435\u0431\u0435\u043d\u043a\u043e\u043c 18-\u043b\u0435\u0442\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430.\n\n\u041f\u0440\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0430\u0442\u0440\u043e\u043f\u0438\u043d\u043e\u043c \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442\u044c\n\u0440\u0435\u0433\u0440\u0435\u0441\u0441 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043c\u0438\u043e\u043f\u0438\u0438, \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439, \u00ab\u044d\u0444\u0444\u0435\u043a\u0442 \u0440\u0438\u043a\u043e\u0448\u0435\u0442\u0430\u00bb\n(\u0431\u043e\u043b\u0435\u0435 \u0431\u044b\u0441\u0442\u0440\u043e\u0435 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0438\u043e\u043f\u0438\u0438).\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 [1,28,50]:\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u041d\u041d \u041b\u0421 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u0433\u0440\u0443\u043f\u043f\u0430\n\n14\n\n\u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0422\u0440\u043e\u043f\u0438\u043a\u0430\u043c\u0438\u0434 \u041a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435 1% - \u0421\n\n\u043a\u0440\u0430\u0442\u043a\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0444\u043b\u0430\u043a\u043e\u043d 5 \u043c\u043b.\n\u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u044e\u0442 \u0432\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u043e 1-2 \u043a\u0430\u043f\u043b\u0438.\n\n\u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0426\u0438\u043a\u043b\u043e\u043f\u0435\u043d\u0442\u043e\u043b\u0430\u0442 \u041a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435 1% - \u0421\n\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0444\u043b\u0430\u043a\u043e\u043d 5 \u043c\u043b.\n\u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u044e\u0442 \u0432\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u043e 1-2 \u043a\u0430\u043f\u043b\u0438.\n\n\u041d\u0435\u0441\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0430\u043b\u044c\u0444\u0430- \u0424\u0435\u043d\u0438\u043b\u044d\u0444\u0440\u0438\u043d \u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u043a\u0430\u043f\u043b\u0438 2,5% - \u0421\n\n\u0430\u0434\u0440\u0435\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a. \u0444\u043b\u0430\u043a\u043e\u043d 5 \u043c\u043b.\n\u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u044e\u0442 \u0432\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u043e 1-2 \u043a\u0430\u043f\u043b\u0438.\n\n\u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 + \u0430\u043b\u044c\u0444\u0430- \u0424\u0435\u043d\u0438\u043b\u044d\u0444\u0440\u0438\u043d + \u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u043a\u0430\u043f\u043b\u0438 50\u043c\u0433 + \u0421\n\n\u0430\u0434\u0440\u0435\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a \u0422\u0440\u043e\u043f\u0438\u043a\u0430\u043c\u0438\u0434 8\u043c\u0433/1\u043c\u043b.\n\u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u044e\u0442 \u0432\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u043e 1-2 \u043a\u0430\u043f\u043b\u0435 \u0437\u0430 15-\n\n30 \u043c\u0438\u043d \u0434\u043e \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u0438\u043b\u0438\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 [1,12,14,15,18-26,28,47\u201353,98,99]:\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u041d\u041d \u041b\u0421 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u0433\u0440\u0443\u043f\u043f\u0430\n\n\u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0410\u0442\u0440\u043e\u043f\u0438\u043d\u0430 \u0441\u0443\u043b\u044c\u0444\u0430\u0442 \u041a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435 1\u043c\u0433/1\u043c\u043b, \u0410\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e 1% \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u2013 \u0444\u043b\u0430\u043a\u043e\u043d 5\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043c\u043b\n\u0417\u0430\u043a\u0430\u043f\u044b\u0432\u0430\u044e\u0442 \u0432\n\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043f\u043e 1-2 \u043a\u0430\u043f\u043b\u0435\n\u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u041a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435 5\u043c\u0433/1 \u04