\u043b\u0435\u0435 100\n\u043c\u0433/\u0441\u0443\u0442\u043a\u0438 \u0432 2-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0430\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442 \u041c\u0438\u0440\u0442\u0430\u0437\u0430\u043f\u0438\u043d1,2, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 15-45 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c,\n\n\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e 1 \u0440\u0430\u0437 \u043d\u0430 \u043d\u043e\u0447\u044c.\n\u0421 18 \u043b\u0435\u0442\n\u0430\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442 \u0424\u043b\u0443\u043e\u043a\u0441\u0435\u0442\u0438\u043d1,2,4, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 20-60 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c\n\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u043f\u0440\u0438\u0435\u043c\u0430 - 1-3 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442\u043a\u0438.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 80\n\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438\n\u0430\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442 \u0422\u0440\u0430\u0437\u0430\u0434\u043e\u043d1,2, \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\n150-300 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f 600\n\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0432 3 \u043f\u0440\u0438\u0435\u043c\u0430, \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e\n\u0447\u0430\u0441\u0442\u044c \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u044b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u0435\u0440\u0435\u0434 \u0441\u043d\u043e\u043c.\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a \u0421\u0443\u043b\u044c\u043f\u0438\u0440\u0438\u04342,3, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u043a\u0430\u043f\u0441\u0443\u043b\u044b 50-400 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0434\u043e 16:00 \u0447\u0430\u0441\u043e\u0432 \u0432\n1-3 \u043f\u0440\u0438\u0435\u043c\u0430.\n\u041f\u0440\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u043b\u0430\u043a\u0442\u0430\u0446\u0438\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0441 \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e.\n\u0414\u0435\u0442\u0438: \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u0432 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0435 5\n\u043c\u0433/\u043a\u0433.\n\u043d\u043e\u0440\u043c\u043e\u0442\u0438\u043c\u0438\u043a \u0422\u043e\u043f\u0438\u0440\u0430\u043c\u0430\u04421,2, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u043a\u0430\u043f\u0441\u0443\u043b\u044b 50-150 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0437\u0430 1-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0414\u0435\u0442\u0438: \u0441\u0442\u0430\u0440\u0448\u0435 6 \u043b\u0435\u0442\n25-100 \u043c\u0433\\\u0441\u0443\u0442 \u0437\u0430 1-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\n\u043d\u043e\u0440\u043c\u043e\u0442\u0438\u043c\u0438\u043a \u041a\u0430\u0440\u0431\u0430\u043c\u0430\u0437\u0435\u043f\u0438\u043d3, \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 200-600 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u2013 \u0437\u0430 1-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0414\u0435\u0442\u0438: \u043c\u043b\u0430\u0434\u0448\u0435 6 \u043b\u0435\u0442 - 10-20\u043c\u0433 \u043d\u0430 1\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 400\u043c\u0433\\\u0441\u0443\u0442\u043a\u0438.\n6-12 \u043b\u0435\u0442 \u2013 100 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0421\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 - 100-400 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 - 2-3\n\u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u043d\u043e\u0440\u043c\u043e\u0442\u0438\u043c\u0438\u043a \u0412\u0430\u043b\u044c\u043f\u0440\u043e\u0435\u0432\u0430\u044f \u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440 \u0434\u043e\u0437. \u0421\n\u043a\u0438\u0441\u043b\u043e\u0442\u04301,2 300-600 \u043c\u0433\\\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0437\u0430 1-3 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0414\u0435\u0442\u0438: \u0431\u043e\u043b\u0435\u0435 17 \u043a\u0433 - 30 