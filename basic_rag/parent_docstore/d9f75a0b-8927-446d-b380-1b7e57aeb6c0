43e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d \u043e\u0442 \u00ab30\u00bb\n\u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 2015 \u0433\u043e\u0434\u0430 \u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b No 10;\n19. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b \u00ab\u041e\u0441\u0442\u0440\u044b\u0435 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u044b B, C \u0438 D,\n\u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0443\u0442\u0435\u043c \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb, \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0439 \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u043e\u0439\n\n\u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u0439 \u043f\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u0443\u0441\u043b\u0443\u0433 \u041c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430\n\u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d \u043e\u0442 29 \u0438\u044e\u043d\u044f 2017 \u0433\u043e\u0434\u0430 \u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\nNo24;\n20. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b \u00ab\u0421\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u00bb, \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0439 \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0435\u043d\u043d\u043e\u0439\n\n\u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0435\u0439 \u043f\u