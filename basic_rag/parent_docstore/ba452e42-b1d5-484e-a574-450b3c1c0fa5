\u201375 \u0441\u0435\u043a.) \u0438\u043b\u0438\n\n\u043d\u0438\u0437\u043a\u043e\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0433\u0435\u043f\u0430\u0440\u0438\u043d\u043e\u0432 \u0432 \u043b\u0435\u0447\u0435\u0431\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445) \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435\u043c\n\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u043e\u0432.\nc. \u041a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b, \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0449\u0438\u0435 \u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0439 \u043e\u0431\u043c\u0435\u043d.\nd. \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u0438 \u0442\u0440\u0430\u0445\u0435\u0438\n\n\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0443 \u0418\u0412\u041b. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043f\u0443\u043b\u044c\u0441\u0430, \u0410\u0414,\n\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435.\ne. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446