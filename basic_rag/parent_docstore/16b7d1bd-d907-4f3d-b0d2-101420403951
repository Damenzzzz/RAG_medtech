3e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043f\u0440\u0438\n\u0441\u0438\u0440\u043e\u043f \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0435\u043c\u0430 \u043b\u0435\u0433\u043a\u0438\u0445\n\n53 \u0413\u0440\u0430\u043c\u0438\u0446\u0438\u0434\u0438\u043d, \u043a\u0430\u043f\u043b\u0438 \u0433\u043b\u0430\u0437\u043d\u044b\u0435/\u0443\u0448\u043d\u044b\u0435 \u041f\u0440\u0438 \u043e\u0442\u0438\u0442\u0430\u0445\n\u0444\u0440\u0430\u043c\u0438\u0446\u0435\u0442\u0438\u043d\u0430 \u0432\u043e \u0444\u043b\u0430\u043a\u043e\u043d\u0435 5 \u043c\u043b\n\u0441\u0443\u043b\u044c\u0444\u0430\u0442,\n\u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u0430\n\n\u043c\u0435\u0442\u0430\u0441\u0443\u043b\u044c\u0444\u043e\u0431\u0435\u043d\u0437\u043e\u0430\u0442\n54 \u041a\u0430\u043b\u044c\u0446\u0438\u0439 \u04143 \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0438, \u0441\u0438\u0440\u043e\u043f \u041f\u0440\u0438 \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0435 \u043d\u0430 \u0444\u043e\u043d\u0435\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u0430\u043c\u0438\n\n55 \u0426\u0438\u0442\u0438\u043a\u043e\u043b\u0438\u043d \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u041f\u0440\u0438 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n500\u043c\u0433/4\u043c\u043b, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u0445\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c\n10\u0433/100\u043c\u043b\n\n56 \u041c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u043e\u043c\u0438\u0434 \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0438 10\u043c\u0433, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0410\u043d\u0442\u0438\u044d\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 10\u043c\u0433/2\u043c\u043b \u043f\u0430\u043b\u043b\u0438\u0430\u0442\u0438\u0432\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u0440\u0438\n\u043a\u0430\u0445\u0435\u043a\u0441\u0438\u0438/\u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u0438\n57 \u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e \u041f\u043e\u0440\u043e\u0448\u043e\u043a \u0434\u043b\u044f \u041f\u0430\u043b\u043b\u0438\u0430\u0442\u0438\u0432\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u0440\u0438\n\n\u043d \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u0438 \u0441 \u043f\u0440\u0435\u043a\u0430\u0445\u0435\u043a\u0441\u0438\u0438 \u0438\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 125\u043c\u0433, \u043a\u0430\u0445\u0435\u043a\u0441\u0438\u0438\n\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 4\u043c\u0433\n58 \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0438 200\u043c\u0433, \u0441\u0438\u0440\u043e\u043f \u0414\u043b\u044f \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\n200\u043c\u0433/\u043c\u043b \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u0440\u043c\u0438\u0438, \u0434\u043b\u044f\n\u0430\u0434\u044a\u044e\u0432\u0430\u043d\u0442\u043d\u043e\u0439 \u0430\u043d\u043b\u0433\u0435\u0437\u0438\u0438\n59 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0421\u0438\u0440\u043e\u043f \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u0414\u043b\u044f \u043a\u04