43d\u0430\u044f \u041a\u0422 \u0438\u043b\u0438 \u041c\u0420\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0441 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u044b\u043c \u041a\u0430\u0436\u0434\u044b\u0435 3\u20136 \u043c\u0435\u0441.\n\u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\u043b\u0438 \u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u041a\u0430\u0436\u0434\u044b\u0435 12 \u043c\u0435\u0441.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b, \u2022 \u0410\u0424\u041f \u041a\u0430\u0436\u0434\u044b\u0435 3\u20134 \u043c\u0435\u0441.\n\u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0449\u0438\u0435\n\u2022 \u0423\u0417\u0418 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u041a\u0430\u0436\u0434\u044b\u0435 2\u20133 \u043c\u0435\u0441.\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u043e\u0435\n\u043b\u0435\u0447\u0435\u043d\u0438\u0435 (\u0434\u043b\u044f \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u2022 \u041c\u0443\u043b\u044c\u0442\u0438\u0444\u0430\u0437\u043d\u0430\u044f \u041a\u0422 \u0438\u043b\u0438 \u041c\u0420\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0441 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u044b\u043c \u041a\u0430\u0436\u0434\u044b\u0435 3\u20134 \u043c\u0435\u0441.\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u2022 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\u043b\u0438 \u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u041a\u0430\u0436\u0434\u044b\u0435 6 \u043c\u0435\u0441.\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f)\n\u2022 \u0421\u0446\u0438\u043d\u0442\u0438\u0433\u0440\u0430\u0444\u0438\u044f \u043a\u043e\u0441\u0442\u0435\u0439 \u0432\u0441\u0435\u0433\u043e \u0442\u0435\u043b\u0430 \u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u2022 \u042d\u0413\u0414\u0421 \u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0412\u0441\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0413\u0426\u041a \u2022 \u041e\u0410\u041a \u0441 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u041a\u0430\u0436\u0434\u044b\u0435 3 \u043c\u0435\u0441.; \u043f\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0438\n\u2022 \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 (\u0410\u041b\u0422, \u0410\u0421\u0422, \u0413\u0413\u0422\u041f, \u0429\u0424, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d, \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d, \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438 \u0413\u0426\u041a \u043f\u0440\u0438\n\u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d, \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430, \u0433\u043b\u044e\u043a\u043e\u0437\u0430, \u043a\u0430\u043b\u0438\u0439, \u043d\u0430\u0442\u0440\u0438\u0439), \u041c\u041d\u041e \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u043f\u0435\u0447\u0435\u043d\u0438 (\u0421\u0422\u0420 \u0410) - \u043d\u0435 \u0440\u0435\u0436\u0435, \u0447\u0435\u043c\n\u043a\u0430\u0436\u0434\u044b\u0435 6 \u043c\u0435\u0441.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0421 \u0413\u0426\u041a \u0432 \u2022 \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u0432\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 (HBsAg, anti-HDV, anti-HCV, HBV \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0414\u041d\u041a, HDV \u0420\u041d\u041a, HCV \u0420\u041d\u041a) \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c /\u0426\u041f \u0412\u00b1D, \u0421 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0444\u043e\u043d\u043e\u0432\u043e\u0433\u043e \u2022 \u0413\u043b\u044e\u043a\u043e\u0437\u0430, \u0438\u043d\u0441\u0443\u043b\u0438\u043d, Hb A1c, \u043b\u0438\u043f\u0438\u0434\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u043f\u0440\u0438 \u041d\u0410\u0421\u0413 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438 \u043d\u0435\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u0441\u0442\u0435\u0430\u0442\u043e\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c / \u0426\u041f\n\u2022 \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0446\u0435\u0440\u0443\u043b\u043e\u043f\u043b\u0430\u0437\u043c\u0438\u043d\u0430, \u043c\u0435\u0434\u0438 \u0432 \u043a\u0440\u043e\u0432\u0438 \u0438 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u043e\u0447\u0435, \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u043b\u044c\u0446\u0430\n\u041a\u0430\u0439\u0437\u0435\u0440\u0430-\u0424\u043b\u0435\u0439\u0448\u0435\u0440\u0430 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e \u0412\u0438\u043b\u044c\u0441\u043e\u043d\u0430-\u041a\u043e\u043d\u043e\u0432\u0430\u043b\u043e\u0432\u0430\n\u2022 \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u0430, \u041e\u0416\u0421\u0421, \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u0438\u0435 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0440\u0438\u043d\u0430 \u0443\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0433\u0435\u043c\u043e\u0445\u0440\u043e\u043c\u0430\u0442\u043e\u0437\u043e\u043c\n\u2022 \u0411\u0435\u043b\u043a\u043e\u0432\u044b\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 (\u0433\u0430\u043c\u043c\u0430-\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u044b), IgG \u043f\u0440\u0438 \u0410\u0418\u0413 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c / \u0426\u041f \u0445\u043e\u043b\u0430\u043d\u0433\u0438\u0442\u043e\u043c\n\u2022 \u0429\u0435\u043b\u043e\u0447\u043d\u0430\u044f \u0444\u043e\u0441\u0444\u0430\u0442\u0430\u0437\u0430, \u0413\u0413\u0422\u041f, IgM \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u043c \u0431\u0438\u043b\u0438\u0430\u0440\u043d\u044b\u043c\n\n\u0445\u043e\u043b\u0430\u043d\u0433\u0438\u0442\u043e\u043c\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0413\u0426\u041a \u2022 \u0423\u0417\u0414\u0413 \u0441\u043e\u0441\u0443\u0434\u043e\u0432 \u043f\u0435\u0447\u0435\u043d\u0438 \u0438 \u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0438 (\u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0442\u0440\u043e\u043c\u0431\u043e\u0437\u0430 \u0432\u043e\u0440\u043e\u0442\u043d\u043e\u0439 \u0438 \u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0445 \u041d\u0435 \u0440\u0435\u0436\u0435, \u0447\u0435\u043c \u043a\u0430\u0436\u0434\u044b\u0435 6 \u043c\u0435\u0441. \u043f\u0440\u0438 \u0426\u041f\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0432\u0435\u043d) \u0421\u0422\u0420 \u0410 \u0438 \u043a\u0430\u0436\u0434\u044b\u0435 3 \u043c\u0435\u0441. \u2013 \u043f\u0440\u0438 \u0426\u041f\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\u043c\u0438 \u0426\u041f \u2022 \u0423\u0417\u0418 \u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439 (\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438) \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u0421\u0422\u0420 \u0412, \u0421\n/ \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0433\u0438\u0434\u0440\u043e\u0442\u043e\u0440\u0430\u043a\u0441\u0430\n\u2022 \u041f\u0441\u0438\u0445\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435, \u043d\u0435\u0439\u0440\u043e\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u0441\u0442\u044b \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430\n\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u043e\u0439 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043f\u0430\u0442\u0438\u0438\n\u2022 \u042d\u041a\u0413, \u042d\u0445\u043e\u041a\u0413 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u043f\u043e\u0440\u0442\u043e\u043f\u0443\u043b\u044c\u043c\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438,\n\u0446\u0438\u0440\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438\n\u2022 \u041e\u0446\u0435\u043d\u043a\u0430 \u043f\u043e \u0448\u043a\u0430\u043b\u0430\u043c SARC-F \u0438 EWGSOP2 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u0441\u0430\u0440\u043a\u043e\u043f\u0435\u043d\u0438\u0438\n\u2022 25-\u0433\u0438\u0434\u0440\u043e\u043a\u0441\u0438\u0432\u0438\u0442\u0430\u043c\u0438\u043d D, \u0438\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043a\u0430\u043b\u044c\u0446\u0438\u0439 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430\n\u043c\u0438\u043d\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d\u0430\n\u2022 \u042d\u0413\u0414\u0421 (\u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u0432\u0435\u043d \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430, \u0436\u0435\u043b\u0443\u0434\u043a\u0430) \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u043f\u0440\u0438 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c\n\u0426\u041f (\u0421\u0422\u0420 \u0410) \u0441 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438\n\u043d\u0435\u043f\u0440\u044f\u043c\u043e\u0439 \u044d\u043b\u0430\u0441\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 >20 \u043a\u041f\u0430 \u0438\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432\n<150/\u043c\u043a\u043b, \u043f\u0440\u0438 \u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c\n\u0426\u041f, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0440\u0430\u043d\u0435\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u043c \u0432\u0430\u0440\u0438\u043a\u043e\u0437\u043d\u044b\u043c\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435\u043c\n\u2022 \u0414\u0432\u0443\u0445\u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0432\u0441\u043a\u0430\u044f \u0430\u0431\u0441\u043e\u0440\u0431\u0446\u0438\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 / \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u041a\u0430\u0436\u0434\u044b\u0435 12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430\n\u2022 \u0418\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c\n\n3.5. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u