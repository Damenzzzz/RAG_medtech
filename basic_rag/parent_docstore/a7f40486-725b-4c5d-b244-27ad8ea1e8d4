438\u0438 \u0438\u043b\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438\n\u0420\u0422\u041f\u0425 \u0432\u0442\u043e\u0440\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e\u0439 \u0432 \u0446\u0435\u043d\u0442\u0440\u0435;\n\u2022 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0445\u0438\u043c\u0435\u0440\u0438\u0437\u043c\u0430 +30,+60,+100,+180 \u0434\u043d\u0438, \u043f\u0440\u0438 \u0441\u043c\u0435\u0449\u0430\u043d\u043e\u043c \u0445\u0438\u043c\u0435\u0440\u0438\u0437\u043c\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u0447\u0430\u0449\u0435. \u0418\u043d\u0444\u0443\u0437\u0438\u044f \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 (DLI) \u043d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0432 \u0441\u0432\u044f\u0437\u0438 \u0441\n\u043d\u0435\u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0420\u0422\u041f\u0425;\n\u2022 \u043f\u0440\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u0422\u0413\u0421\u041a \u0441 \u0422 \u0434\u0435\u043f\u043b\u0435\u0446\u0438\u0435\u0439 \u0440\u0435\u0436\u0438\u043c \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438: \u0426\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 (300 \u043c\u0433/\u043c2/\u0434\n\u0441 -6 \u043f\u043e -3 \u0434\u043d\u0438), \u0444\u043b\u0443\u0434\u0430\u0440\u0430\u0431\u0438\u043d (30 \u043c\u0433\u043c\u0433/\u043c2/\u0434 \u0441 -6 \u043f\u043e -3 \u0434\u043d\u0438), \u043e\u0434\u043d\u0430 \u0434\u043e\u0437\u0430 \u0442\u043e\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u043b\u0443\u0447\u0435\u043d\