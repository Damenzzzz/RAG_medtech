0,\n\u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435\u043c \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c\n\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n(\u043f\u0435\u0447\u0435\u043d\u0438, \u043f\u043e\u0447\u0435\u043a, \u0441\u0435\u0440\u0434\u0446\u0430).\nIgA-\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0439 1.\u0412\u0435\u0437\u0438\u043a\u0443\u043b\u044b \u0438 \u043f\u0443\u0437\u044b\u0440\u0438 \u0441 \u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438: 1.\u0412 \u043e\u0441\u043d\u043e\u0432\u0435 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0437\u0430 \u043b\u0435\u0436\u0438\u0442\n\u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0437 \u0442\u0432\u0435\u0440\u0434\u043e\u0439 \u043f\u043e\u043a\u0440\u044b\u0448\u043a\u043e\u0439, \u043f\u043e\u0434\u044d\u043f\u0438\u0434\u0435\u0440\u043c\u0430\u043b\u044c\u043d\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0443\u0442\u043e\u0430\u043d\u0442\u0438\u0442\u0435\u043b\n\u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u043c \u0438\u043b\u0438 \u0435 \u043f\u0443\u0437\u044b\u0440\u0438 \u0441 (IgA) \u043a \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u043e\u0439 \u043c\u0435\u043c\u0431\u0440\u0430\u043d\u044b\n\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u043c, \u0441\u043a\u043b\u043e\u043d\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0438\u0437 \u044d\u043f\u0438\u0434\u0435\u0440\u043c\u0438\u0441\u0430 (\u043a\u043e\u043b\u043b\u0430\u0433\u0435\u043d\u0430 VII\n\u043a \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u0435, \u043d\u0430 \u0444\u043e\u043d\u0435 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0432 \u0438 \u0438 XVII \u0442\u0438\u043f\u043e\u0432).\n\u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0439 \u0438\u043b\u0438 \u044d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u043e\u0432. 2.\u0412\u044b\u0441\u044b\u043f\u043d\u044b\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b\n\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f \u0432 \u0444\u043e\u0440\u043c\u0435\n\n\u043a\u043e\u0436\u0438. \u00ab\u0433\u0438\u0440\u043b\u044f\u043d\u0434\u044b\u00bb \u0438\u043b\u0438\n2.\u0421\u044b\u043f\u044c \u043f\u043e\u043b\u0438\u043c\u043e\u0440\u0444\u043d\u0430 \u0438 \u043a\u043e\u043b\u044c\u0446\u0435\u0432\u0438\u0434\u043d\u044b\u0445 \u043e\u0447\u0435\u0440\u0442\u0430\u043d\u0438\u0439.\n\u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442 \u043a\u0430\u043a \u043a\u043e\u0436\u0443, \u0442\u0430\u043a 3.\u041d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0435\n\u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0435 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438. \u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u0430.\n4.\u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0443\u0437\u044b\u0440\u0435\u0439\n\u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043d\u043e \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0435\u0439\n\u043a\u043e\u0436\u0438.\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1, 3, 5, 6, 9-15, 18 20]:\n\n\u0410\u043b\u0433\u043e\u0