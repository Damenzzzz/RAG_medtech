35\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438, \u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\nII \u043b\u0438\u043d\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c \u0440\u0435\u0436\u0438\u043c\u043e\u043c \u0415\u041c\u0410-\u0421\u0415 (\u0415\u041c\u0410-\u0420\u0415)\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0434\u043e\u043b\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0432\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043a\u043b\u0438\u043d\u0438\u043a\u0435, \u0438\u043c\u0435\u044e\u0449\u0435\u0439 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043e\u043f\u044b\u0442 \u0432 \u0434\u0430\u043d\u043d\u043e\u0439\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438!\n\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b \u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 II \u043b\u0438\u043d\u0438\u0438 (\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u0430\u044f \u0422\u041e):\n\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0438 \u0441 \u043d\u0438\u0437\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c - \u043f\u0440\u0438 \u0441\u0443\u043c\u043c\u0435 \u0431\u0430\u043b\u043b\u043e\u0432 6 \u0438 \u043c\u0435\u043d\u0435\u0435:\n(\u0421\u0445\u0435\u043c\u0430 \u0415\u041c\u0410-\u0421\u041e) - \u0414\u0430\u043a\u0442\u0438\u043d\u043e\u043c\u0438\u0446\u0438\u043d \u043f\u043e 500\u043c\u043a\u0433, \u0432/\u0432, \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u0432 1-5 \u0434\u043d\u0438 (\u0441\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439). \u041f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0435 \u043a\u0443\u0440\u0441\u043e\u0432 \u0441 15 \u0434\u043d\u044f.\n\u0425\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f 2 \u043b\u0438\u043d\u0438\u0438 \u043f\u0440\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0440\u0438\u0441\u043a\u0430 \u0422\u0424\u0411 - \u043f\u0440\u0438 \u0441\u0443\u043c\u043c\u0435 \u0431\u0430\u043b\u043b\u043e\u0432 7 \u0438\n\n\u0431\u043e\u043b\u0435\u0435:\n(\u0421\u0445\u0435\u043c\u0430 \u0415\u041c\u0410-\u0421\u0415):\n1 \u0434\u0435\u043d\u044c:\n\u2022 \u042d\u0442\u043e\u043f\u043e\u0437\u0438\u0434 100\u043c\u0433/\u043c2 \u0432/\u0432, \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e -400.0 \u0444\u0438\u0437.\u0440-\u0440\u0430\n\n\u2022 \u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 8\u043c\u0433, \u0432/\u0432, \u0441\u0442\u0440.+20.0 \u0444\u0438\u0437.\u0440-\u0440\u0430\n\u2022 \u041e\u043d\u0434\u0430\u043d\u0441\u0435\u0442\u0440\u043e\u043d 8 \u043c\u0433, \u0432/\u0432, \u0441\u0442\u0440.+20.0 \u0444\u0438\u0437.\u0440-\u0440\u0430\n\u2022 \u0414\u0430\u043a\u0442\u0438\u043d\u043e\u043c\u0438\u0446\u0438\u043d 500\u043c\u043a\u0433, \u0432/\u0432, c\u0442\u0440.+20,0 \u0444\u0438\u0437.\u0440-\u0440\u0430\n\n\u2022 \u041d\u0430\u0442\u0440\u0438\u044f \u0431\u0438\u043a\u0430\u0440\u0431\u043e\u043d\u0430\u0442 200,0 \u0432/\u0432, \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e.\n\n\u2022 \u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 100\u043c\u0433/\u043c2 \u0432/\u0432, \u0441\u0442\u0440.+20,0 \u0444\u0438\u0437.\u0440-\u0440\u0430\n\u2022 \u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 1\u0433/\u043c2 \u0432/\u0432, \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e, 12 \u0447. \u0438\u043d\u0444\u0443\u0437\u0438\u044f + \u0433\u043b\u044e\u043a\u043e\u0437\u0430 5% - 400,0