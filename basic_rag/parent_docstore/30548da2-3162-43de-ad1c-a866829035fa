0438\u0435 \u043d\u0435\n\u043c\u0435\u043d\u0435\u0435 4 \u0434\u043d\u0435\u0439. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0438 \u043c\u0435\u0442\u0430\u0430\u043d\u0430\u043b\u0438\u0437\u043e\u0432 \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0438\n\u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0432 \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u043f\u043e\u043b\u0443\u0447\u0430\u0432\u0448\u0438\u0445\n\u043a\u0440\u0430\u0442\u043a\u043e\u0441\u0440\u043e\u0447\u043d\u0443\u044e (7\u201310 \u0434\u043d\u0435\u0439) \u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e.\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u0445\u043e\u0437\u044f\u0438\u043d\u0430 (\u0420\u0422\u041f\u0425)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430-23. \u0421\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043e\u0441\u0442\u0440\u043e\u0439 \u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0420\u0422\u041f\u0425.\nEBMT 2024.\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0414\u043d\u0438 \u043f\u043e\u0441\u043b\u0435 \u0427\u0435\u0440\u0442\u044b \u0427\u0435\u0440\u0442\u044b\n\u0422\u0413\u0421\u041a \u043e\u0420\u0422\u041f\u0425 \u0445\u0440\u0420\u0422\u041f\u0425\n\n\u041e\u0441\u0442\u0440\u0430\u044f \u0420\u0422\u041f\u0425\n\n\u2013 \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f <100 \u0434\u043d\u0435\u0439 \u0414\u0430 \u041d\u0435\u0442\n\n\u2013 \u041f\u0435\u0440\u0441\u0438\u0441\u0438\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f, >100 \u0434\u043d\u0435\u0439 \u0414\u0430 \u041d\u0435\u0442\n\n\u0440\u0435\u043a\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u0430\u044f \u0438\u043b\u0438 \u043f\u043e\u0437\u0434\u043d\u0435\u0435\n\u043d\u0430\u0447\u0430\u043b\u043e\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0420\u0422\u041f\u0425\n\n\u2013 \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041d\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u041d\u0435\u0442 \u0414\u0430\n\u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438\n\n\u2013 Overlap \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u041d\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u0414\u0430 \u0414\u0430\n\u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438\n\n\u0420\u0438\u0441\u0443\u043d\u043e\u043a-1. \u041e\u0440\u0433\u0430\u043d\u044b \u043c\u0438\u0448\u0435\u043d\u0438 \u043f\u0440\u0438 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425.\n\n81\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430-24. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0441\u0442\u0430\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u043f\u0440\u0438\n\u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425\n*\u0421\u0442\u0430\u0434\u0438\u0438 (Stage) \u2014 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430 (\u043a\u043e\u0436\u0430, \u043f\u0435\u0447\u0435\u043d\u044c,\n\u0416\u041a\u0422). Grade \u2014 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0420\u0422\u041f\u0425\n\n\u0421\u0442\u0430\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 (according to Harris et al. 2016) [113]\n\u0421\u0442\u0430\u0434\u0438\u044f \u041a\u043e\u0436\u0430 (\u0442\u043e\u043b\u044c\u043a\u043e \u041f\u0435\u0447\u0435\u043d\u044c \u0412\u0435\u0440\u0445\u043d\u0438\u0435 \u041d\u0438\u0436\u043d\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044b\n(stage)* \u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f (\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d) \u043e\u0442\u0434\u0435\u043b\u044b \u0416\u041a\u0422 \u0416\u041a\u0422\n\u044d\u0440\u0438\u0442\u0435\u043c\u0430) (\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\n\n\u0441\u0442\u0443\u043b\u0430/\u0434\u0435\u043d\u044c)\n0 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 <35 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 <500 \u043c\u043b/\u0434\u0435\u043d\u044c \u0438\u043b\u0438\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u043c\u043a\u043c\u043e\u043b\u044c/\u043b \u0438\u043b\u0438 <3 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432/\u0434\u0435\u043d\u044c\n(\u044d\u0440\u0438\u0442\u0435\u043c\u0430\u0442\u043e\u0437\u043d\u043e\u0439) \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\n\u0441\u044b\u043f\u0438 \u0420\u0422\u041f\u0425 \u0442\u043e\u0448\u043d\u043e\u0442\u0430,\n\u0440\u0432\u043e\u0442\u0430 \u0438\u043b\u0438\n\u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u044f\n1 \u041c\u0430\u043a\u0443\u043b\u043e\u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u0430\u044f 35-52,9 \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f 500\u2013999 \u043c\u043b/\u0434\u0435\u043d\u044c\n\n\u0441\u044b\u043f\u044c \u043c\u043a\u043c\u0