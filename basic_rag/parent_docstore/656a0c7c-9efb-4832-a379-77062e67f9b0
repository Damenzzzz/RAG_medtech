\u0418\n(\u0421\u0410\u041d\u0410\u0422\u041e\u0420\u041d\u0410\u042f \u0420\u0415\u0410\u0411\u0418\u041b\u0418\u0422\u0410\u0426\u0418\u042f)\n\n\u0411\u041e\u041b\u0415\u0417\u041d\u0418 \u041e\u0420\u0413\u0410\u041d\u041e\u0412 \u0414\u042b\u0425\u0410\u041d\u0418\u042f\n\n1. \u0412\u0412\u041e\u0414\u041d\u0410\u042f \u0427\u0410\u0421\u0422\u042c\n1.1 \u041a\u043e\u0434 (\u044b) \u041c\u041a\u0411 -10:\n\u041c\u041a\u0411 -10\n\n\u041a\u043e\u0434 \u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\nJ 45.0 \u0410\u0441\u0442\u043c\u0430 \u0441 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\u043c \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439\nJ 45.8 \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439\nJ 45.9 \u0410\u0441\u0442\u043c\u0430 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u0430\u044f \u0443 \u0434\u0435\u0442\u0435\u0439\n\nJ 40 \u0411\u0440\u043e\u043d\u0445\u0438\u0442, \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439 \u043a\u0430\u043a \u043e\u0441\u0442\u0440\u044b\u0439 \u0438\u043b\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443 \u0434\u0435\u0442\u0435\u0439\nJ 41.0 \u041f\u0440\u043e\u0441\u0442\u043e\u0439 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0431\u0440\u043e\u043d\u0445\u0438\u0442 \u0443 \u0434\u0435\u0442\u0435\u0439\nJ 42 \u0411\u0440\u043e\u043d\u0445\u0438\u0442 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439 \u0443 \u0434\u0435\u0442\u0435\u0439\n\nJ18.0 \u0411\u0440\u043e\u043d\u0445\u043e\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u0430\u044f \u0443 \u0434\u0435\u0442\u0435\u0439. ( \u0440\u0435\u043a\u043e\u043d\u0432\u0430\u043b\u0435\u0441\u0446\u0435\u043d\u0442\n\u0431\u0440\u043e\u043d\u0445\u043e\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438)\n\n1.2 \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: 2018 \u0433\u043e\u0434.\n\n1.3 \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\u0411\u0421\u0424 \u2013 \u0431\u0438\u043e\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0423\u0424\u041e \u2013 \u0443\u043b\u044c\u0442\u0440\u0430\u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u043e\u0435 \u043e\u0431\u043b\u0443\u0447\u0435\u043d\u0438\u0435\n\u0416\u0415\u041b \u2013 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0435\u043c\u043a\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u043a\u0438\u0445\n\n\u0424\u0416\u0415\u041b \u2013 \u0444\u043e\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0435\u043c\u043a\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u043a\u0438\u0445\n\u041f\u0421\u0412 \u2013 \u043f\u0438\u043a\u043e\u0432\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u044b\u0434\u043e\u0445\u0430\n\u041e\u0410\u041a \u2013 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438\n\u041e\u0410\u041c \u2013 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438\n\n\u041b\u0424\u041a \u2013 \u043b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\n\u041b\u041e\u0420 \u2013 \u041e\u0442\u043e\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u043b\u043e\u0433\n\u0427\u0421\u0421 \u2013 \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0445 \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0439\n\n\u0410\u0414 \u2013 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\nSatO \u2013 \u0441\u0430\u0442\u0443\u0440\u0430\u0446\u0438\u044f \u043a\u0440\u043e\u0432\u0438 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u043c\n2\n\u0411\u041e\u0421 - \u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u0430\u044f \u0441\u0432\u044f\u0437\u044c\n\n1\n\n1.4 \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u044b, \u0432\u0440\u0430\u0447\u0438 \u043e\u0431\u0449\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u043f\u0443\u043b\u044c\u043c\u043e\u043d\u043e\u043b\u043e\u0433\u0438,\n\n\u0430\u043b\u043b\u0435\u0440\u0433\u043e\u043b\u043e\u0433\u0438, \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0438.\n1.5 \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0434\u0435\u0442\u0438 \u0441 3 \u0434\u043e 14 \u043b\u0435\u0442.\n\n2. \u041c\u0435\u0442\u043e\u0434\u044b \u0438 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\n\n2.1 \u0426\u0435\u043b\u044c \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438:\n\n\u2022 \u043e\u0431\u0449\u0435\u0435 \u043e\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u0438\n\u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u0438;\n\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043d\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.\n\n3. \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438:\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 1.\nNo \u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u0430\n\u043f/\u043f (\u043a\u043e\u0434 \u043f\u043e \u041c\u041a\u0411-\u0425)\n1. \u0411\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u0438\u043d\u0442\u0435\u0440\u043c\u0435\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043b\u0435\u0433\u043a\u043e\u0439 \u0438\n\n\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f\nJ 45.0 \u2013 \u0410\u0441\u0442\u043c\u0430 \u0441 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\u043c \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\n2. \u0411\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u0438\u043d\u0442\u0435\u0440\u043c\u0435\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043b\u0435\u0433\u043a\u043e\u0439 \u0438\n\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f\n\nJ45.8- \u0410\u0441\u0442\u043c\u0430 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f\n3. \u0411\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u0438\u043d\u0442\u0435\u0440\u043c\u0435\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f, \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043b\u0435\u0433\u043a\u043e\u0439 \u0438\n\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f\nJ 45.9 \u2013 \u0410\u0441\u0442\u043c\u0430 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u0430\u044f\n\n4. J 18.0 \u0411\u0440\u043e\u043d\u0445\u043e\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u0430\u044f (\u0420\u0435\u043a\u043e\u043d\u0432\u0430\u043b\u0435\u0441\u0446\u0435\u043d\u0442 4\n\u0431\u0440\u043e\u043d\u0445\u043e\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 )\n5. J 40. \u0411\u0440\u043e\u043d\u0445\u0438\u0442, \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439 \u043a\u0430\u043a \u043e\u0441\u0442\u0440\u044b\u0439 \u0438\u043b\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 5\n6. J 41.0. \u041f\u0440\u043e\u0441\u0442\u043e\u0439 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0431\u0440\u043e\u043d\u0445\u0438\u0442 6\n\n7. J 42. \u0411\u0440\u043e\u043d\u0445\u0438\u0442 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439 7\n\n4. \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u044d\u0442\u0430\u043f\u0430 \u0438 \u043e\u0431\u044a\u0435\u043c\u0430 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\n(\u041c\u0435\u0436\u0434\u0443\u0440\u043e\u0434\u043d\u044b\u0439 \u0448\u043a\u0430\u043b\u044b \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438\n\n\u0444\u0443\u043d\u0443\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u0436\u0438\u0437\u043d\u0435\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f)\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 1.\nNo \u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u043f/\u043f (\u043a\u043e\u0434 \u043f\u043e \u041c\u041a\u0411-\u0425) (\u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0411\u0421\u0424(\n\n\u0431\u0438\u043e\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 (\u0438\u043b\u0438)\n\u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n1 \u0411\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u041f\u0421\u0412 > 80% \u043e\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0433\u043e \u0438\u043b\u0438\n\u0438\u043d\u0442\u0435\u0440\u043c\u0435\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f, \u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0435\u0433\u043e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043b\u0435\u0433\u043a\u043e\u0439 \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f,\n\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 SatO 95% (>90% \u0443 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432)\n2 > _.\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f, \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0421\u043f\u0438\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u044f:\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b PEF, FEV 1 \u2013\n2\n\nJ 45.0 \u2013 \u0410\u0441\u0442\u043c\u0430 \u0441 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u043e\u0440\u043c\u0430 \u0438\u043b\u0438 > 80% \u043e\u0442\n\u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\u043c \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u043e\u0440\u043c\u044b;\n\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\n2 \u0411\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u0442\u043c\u0430 \u041f\u0421\u0412 > 80% \u043e\u0442 \u0434\u043e\u043b\u0436\u043d\u043e\u0433\u043e \u0438\u043b\u0438\n\n\u0438\u043d\u0442\u0435\u0440\u04