0435:\n\u0418\u043d\u0444\u0443\u0437\u0438\u044f (\u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u044f) \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u2013 \u0444\u043e\u0440\u043c\u0430 \u0438\u043c\u043c\u0443\u043d\u043e\u0430\u0434\u043e\u043f\u0442\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438,\n\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0430 \u0438\u043d\u0434\u0443\u043a\u0446\u0438\u0438 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u043b\u0435\u0439\u043a\u043e\u0437\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0432\u043e\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0442\u0430 \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u0445 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430\u043c \u0430\u043b\u043b\u043e\u0433\u0435\u043d\u043d\u044b\u0445\n(\u0433\u0430\u043f\u043b\u043e\u0438\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u044b\u0445) \u0433\u0435\u043c\u043e\u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a. [2-4]\n\n9. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f:\n\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0446\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n1. \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f DLI;\n\n2. \u041b\u0435\u0447\u0435\u0431\u043d\u0430\u044f DLI.\n\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u