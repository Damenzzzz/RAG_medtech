3e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438.\n\u041d\u0430\u043a\u043b\u043e\u043d \u043a\u0440\u0438\u0432\u043e\u0439 VE/V % \u043e\u0442 \u0412\u0435\u0440\u0448\u0438\u043d\u0430 \u043a\u0440\u0438\u0432\u043e\u0439 P CO\nco2 et 2\n\u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e\u0433\u043e\nV\nO2\n\u041d\u0438\u0437\u043a\u0438\u0439 <30,0 \u2265100% >37 \u043c\u043c.\u0440\u0442.\u0441\u0442.\n\u0421\u0440\u0435\u0434\u043d\u0438\u0439 30,0-44,9 75-99% 36-30\u043c\u043c.\u0440\u0442.\u0441\u0442.\n\u0412\u044b\u0441\u043e\u043a\u0438\u0439 \u2265 45,0 <50% <20\u043c\u043c.\u0440\u0442.\u0441\u0442.\n\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0442\u0435\u0441\u0442\u0430 \u0441 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439.\n\u0413\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u042d\u041a\u0413\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438.\n\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u0414 \u043f\u0440\u0438 \u041d\u0435\u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u0430\u044f \u0430\u0440\u0438\u0442\u043c\u0438\u044f,\u044d\u043a\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u043e\u043a\u0443\u0441\u044b\n\u041d\u0438\u0437\u043a\u0438\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\u226520 \u0438 /\u0438\u043b\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 ST \u043f\u0440\u0438 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\n\u043c\u043c.\u0440\u0442.\u0441\u0442. \u0438\u043b\u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438.\n\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u0414 \u043