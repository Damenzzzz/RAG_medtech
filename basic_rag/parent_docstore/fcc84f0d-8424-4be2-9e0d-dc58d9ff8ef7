d\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b, \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f, \u043e\u0442\u0435\u043a \u0442\u043a\u0430\u043d\u0435\u0439, \u043f\u0440\u0438\n\u0430\u0431\u0441\u0446\u0435\u0441\u0441\u0435 - \u0444\u043b\u044e\u043a\u0442\u0443\u0430\u0446\u0438\u044f, \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u0440\u043c\u0438\u044f.\n\u0412\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442:\n\u2022 \u043e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0432\u0443\u043b\u044c\u0432\u044b \u0438 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430;\n\n\u2022 \u0441\u0435\u0440\u043e\u0437\u043d\u043e-\u0433\u043d\u043e\u0439\u043d\u044b\u0435/\u0433\u043d\u043e\u0439\u043d\u044b\u0435 \u043d\u0430\u043b\u0435\u0442\u044b, \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0438\u0437\u044a\u044f\u0437\u0432\u043b\u0435\u043d\u0438\u044f,\n\u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0430\u0449\u0438\u0435 \u043f\u0440\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435.\n\u2022 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c\u0441\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0430\u0445\u043e\u0432\u044b\u0445 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432.\n\u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0437 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430:\n\n\u2022 \u043f\u0440\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0430\u0433\u0438\u043d\u043e\u0437\u0435 \u2013 \u0431\u0435\u043b\u0438 \u0441 \u0437\u0430\u043f\u0430\u0445\u043e\u043c \u0440\u044b\u0431\u044b, \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043f\u043e\u0441\u043b\u0435\n\u043f\u043e\u043b\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430;\n\u2022 \u043f\u0440\u0438 \u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043d\u043e\u043c \u0432\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442\u0435 \u2013 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0433\u0443\u0441\u0442\u043e\u0439 \u043a\u043e\u043d\u0441\u0438\u0441\u0442\u0435\u043d\u0446\u0438\u0438 \u0431\u0435\u043b\u043e\u0433\u043e\n\n\u0446\u0432\u0435\u0442\u0430 (\u00ab\u0442\u0432\u043e\u0440\u043e\u0436\u0438\u0441\u0442\u044b\u0435\u00bb);\n\u2022 \u043f\u0440\u0438 \u0442\u0440\u0438\u0445\u043e\u043c\u043e\u043d\u0438\u0430\u0437\u0435 \u2013 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0442\u043e-\u0437\u0435\u043b\u0435\u043d\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430 \u0441 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c \u0437\u0430\u043f\u0430\u0445\u043e\u043c,\n\u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043f\u0435\u043d\u0438\u0441\u0442\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430.\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n\u0411\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442: \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u043d\u0435\u0442.\n\u2022 \u041e\u0410\u041a \u2013 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441\u043e \u0441\u0434\u0432\u0438\u0433\u043e\u043c \u0432\u043b\u0435\u0432\u043e, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0421\u041e\u042d;\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0438\u0437 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 \u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438\n\u0432\u0443\u043b\u044c\u0432\u044b: \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f.\n\n\u0412\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442:\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0438\u0437 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 \u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438\n\u0432\u0443\u043b\u044c\u0432\u044b: 3-4 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0447\u0438\u0441\u0442\u043e\u0442\u044b, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430.\n\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 (\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435) \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0438\u0437 \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 \u0438\n\u0432\u0443\u043b\u044c\u0432\u044b \u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0430\u043c: \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0438\n\u0435\u0433\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c (\u0434\u043b\u044f \u043f\u043e\u0434\u0431\u043e\u0440\u0430\n\n\u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438);\n\u2022 \u041f\u0426\u0420 \u2013 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043d\u0430 \u0418\u041f\u041f\u041f (\u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0430\u0433\u0435\u043d\u0442).\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 1. \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0432\u0430\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0439 (\u0423\u0414 \u2013 \u0412).\n\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043d\u044b\u0439 \u0422\u0440\u0438\u0445\u043e\u043c\u043e\u043d\u0430\u0434\u043d\u044b\u0439\n\u0432\u0430\u0433\u0438\u043d\u043e\u0437 \u0432\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442 \u0432\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442\n\u2022 \u0441\u0435\u0440\u043e-\u0431\u0435\u043b\u044b\u0435 \u2022 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u2022 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\n\u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0437 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u0438 T.vaginalis\n\n\u043f\u0443\u0442\u0435\u0439. \u0434\u0440\u043e\u0436\u0436\u0435\u0439 \u0438\u043b\u0438 \u0438\u0445 (\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 40-70%).\n\u2022 \u00ab\u0440\u044b\u0431\u0438\u0439\u00bb \u0437\u0430\u043f\u0430\u0445 (\u0435\u0441\u043b\u0438 \u043c\u0438\u0446\u0435\u043b\u0438\u0438 (\u0447\u0430\u0449\u0435 \u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043d\u0435\u0442, \u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u043d\u0435\u0441\u0442\u0438 \u0421.albicans) \u2013 \u0430\u043d\u0430\u043b\u0438\u0437 (\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n2-3 \u043a\u0430\u043f\u043b\u0438 10% \u0440-\u0440 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 40- 95%).\n\n\u041a\u041e\u041d). 60%. \u2022 \u041f\u0426\u0420 \u043d\u0430 \u0442\u0440\u0438\u0445\u043e\u043c\u043e\u043d\u0438\u0430\u0437\n\u2022 \u0440\u041d \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430 >4,5. \u2022 \u0440\u043e\u0441\u0442 \u0434\u0440\u043e\u0436\u0436\u0435\u0432\u044b\u0445 (\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 100%).\n\u2022 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043a\u043b\u0435\u0442\u043a\u0438 \u043a\u043b\u0435\u0442\u043e\u043a \u043f\u0440\u0438\n\u043f\u0440\u0438 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u0438. \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438.\n\u2022 \u043f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0435 \u0440\u043e\u0441\u0442\u0430\n\u0434\u0440\u043e\u0436\u0436\u0435\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a \u043d\u0435\nC.albicans, \u0447\u0430\u0449\u0435\n\n\u0421.glabrata\n\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u043c\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c.\n\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n\u0411\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442: \u043d\u0435\u0442\n\n\u0412\u0443\u043b\u044c\u0432\u043e\u0432\u0430\u0433\u0438\u043d\u0438\u0442:\n\u2022 \u0432\u0430\u0433\u0438\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0443 \u0434\u0435\u0432\u043e\u0447\u0435\u043a \u2013 \u043f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u0438\n\n\u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u043f\u043e\u043b\u0438\u043f\u043e\u0437, \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e.\n\n2) \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u0416\u0430\u043b\u043e\u0431\u044b(cid:9)\u0438(cid:9)\n\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437(cid:9)\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439(cid:9)\n\u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439(cid:9)\n\u043e\u0441\u043c\u043e\u0442\u0440(cid:9)(cid:9)\n\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435(cid:9)\n\u043c\u0435\u0442\u043e\u0434\u044b(cid:9)\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f(cid:9)(cid:9)\n\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435(cid:9)\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f(cid:9)\u043f\u043e(cid:9)\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.(cid:9)\n\n3) \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u043e\u0432\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b\n\n(\u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442).\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u041a\u0438\u0441\u0442\u0430 \u0416\u0430\u043b\u043e\u0431\u044b \u043d\u0430 \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u0438, \u043e\u0442\u0435\u043a\u0430,\n\n\u0436\u0435\u043b\u0435\u0437\u044b \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0443\u043b\u044c\u0432\u044b, \u043e\u0441\u043c\u043e\u0442\u0440. \u0444\u043b\u044e\u043a\u0442\u0443\u0430\u0446\u0438\u0438\n\u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u0445,\n\u0431\u043e\u043b\u044c.\n\n\u0413\u0435\u043c\u0430\u0442\u043e\u043c\u0430 \u0432 \u0416\u0430\u043b\u043e\u0431\u044b \u043d\u0430 - \u0421\u0431\u043e\u0440 - \u0421\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0443\u043b\u044c\u0432\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430; \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0443\u043b\u044c\u0432\u044b, - \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0440\u0430\u0432\u043c\u043e\u0439, \u0440\u043e\u0434\u0430\u043c\u0438;\n\u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 - \u0420\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0430 \u043d\u0435\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u0445, \u0439 \u043e\u0441\u043c\u043e\u0442\u0440. \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u0438\n\n\u0431\u043e\u043b\u044c. \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b\n\u043f\u0440\u0435\u0434\u0432\u0435\u0440\u0438\u044f.\n\u0424\u0443\u0440\u0443\u043d\u043a\u0443\u043b\u0435\u0437 \u0416\u0430\u043b\u043e\u0431\u044b \u043d\u0430 \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0432\n\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u0433\u0443\u0431 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043e\u0441\u043c\u043e\u0442\u0440. \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u043e\u043b\u043e\u0441\u044f\u043d\u043e\u0433\u043e\n\u043f\u0440\u043e\u043c\u0435\u0436\u043d\u043e\u0441\u0442\u0438, \u043e\u0431\u0449\u0435\u0435 \u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u0430, \u0441\u0430\u043b\u044c\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u043c\u043e\u0433\u0430\u043d\u0438\u0435, \u0436\u0435\u043b\u0435\u0437\u044b.\n\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f, \u043e\u0442\u0435\u043a,\n\n\u0433\u0438\u043f\u0435\u0440\u0442\u0435\u0440\u043c\u0438\u044f\n\u041f\u0430\u0440\u0430\u0443\u0440\u0435\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0416\u0430\u043b\u043e\u0431\u044b \u043d\u0430 \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\n\u043a\u0438\u0441\u0442\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0443\u043b\u044c\u0432\u044b, \u043e\u0441\u043c\u043e\u0442\u0440. \u043f\u0430\u0440\u0430\u0443\u0440\u0435\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u0445,\n\u0431\u043e\u043b\u044c.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u2013 2. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0432\u0443\u043b\u044c\u0432\u0438\u0442\u0430 \u0438 \u0432\u0430\u0433\u0438\u043d\u0438\u0442\u0430.\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0410\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0416\u0430\u043b\u043e\u0431\u044b \u043d\u0430 \u0437\u0443\u0434, - \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 - \u0421\u0433\u043b\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c\n\u0432\u0443\u043b\u044c\u0432\u0438\u0442/\u0432\u0430\u0433\u0438\u043d\u0438\u0442 \u0436\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0432\u0443\u043b\u044c\u0432\u044b \u0438\n\u0438\u0437 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043f\u0443\u0442\u0435\u0439. \u043e\u0441\u043c\u043e\u0442\u0440; \u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430,\n\n- \u041a\u043e\u043b\u044c\u043f\u043e\u0441\u043a\u043e\u043f\u0438\u044f; \u0438\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c,\n- \u041c\u0430\u0437\u043e\u043a \u043d\u0430 \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0432\u043e\u0441\u0442\u044c \u043f\u0440\u0438\n\u0446\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0435;\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435. - \u0418\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435\n\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f \u0432\u0443\u043b\u044c\u0432\u044b \u0438\n\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u0430,\n\u043d\u0435\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0435\n\u043e\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\n\n\u0428\u0438\u043b\u043b\u0435\u0440\u0443;\n- \u041a\u043b\u0435\u0442\u043a\u0438\n\u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\n\u043f\u0430\u0440\u0430\u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445\n\u0441\u043b\u043e\u0435\u0432.\n\n4) \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u0411\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442:\n\n\u2022 \u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0433\u043e \u0442\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u0438\u0441\u0442\u044b \u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0435\u0432\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0438\u043b\u0438\n\u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f. \u041d\u0443\u0436\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u0433\u0438\u0433\u0438\u0435\u043d\u0430\n\u0438 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435;\n\u2022 \u041f\u0440\u0438 \u043e\u0441\u0442\u0440\u043e\u043c \u0431\u0430\u0440\u0442\u043e\u043b\u0438\u043d\u0438\u0442\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u043c \u0440\u0430\u0437\u0440\u044b\u0432\u0435 \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e\u0442\u0441\u044f", "type": "Document"}}