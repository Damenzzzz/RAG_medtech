0\u043a\u0436\u0435 \u0432 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439\n\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0413\u041a \u0438 \u0446\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438. (D).\n\u2022 \u0423 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u0411\u0428 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0439 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0439\n\u0441\u0435\u043a\u0440\u0435\u0446\u0438\u0435\u0439 \u0441\u043b\u044e\u043d\u043d\u044b\u0445 \u0438 \u0441\u043b\u0435\u0437\u043d\u044b\u0445 \u0436\u0435\u043b\u0435\u0437 \u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0420\u0422\u041c \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044e\n\u0441\u0430\u043b\u0438\u0432\u0430\u0446\u0438\u0438 \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044e \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439 (\u0410).\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421 \u0438\n\u0421\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u0430\u043b\u043e\u043d 250-1000 \u043c\u0433 \u0421\n\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0432\n\u0439 \u0433\u043e\u0440\u043c\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0443\u0442\u043a\u0438,\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043a\u0443\u0440\u0441\u0430\u043c\u0438 \u043f\u043e 3\n\u0434\u043d\u044f\n\u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u0430\u043b\u043e\u043d 4-32 \u043c\u0433 \u0421\n\u0432\u043d\u0443\u0442\u0440\u044c,\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u041f\u0440\u0435\u0434\u043d\u0438\u0437\u0430\u043b\u043e\u043d 5-40 \u043c\u0433 \u0421\n\u0432\u043d\u0443\u0442\u0440\u044c,\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0426\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0426\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 1000\u043c\u0433/\u043c\u0435\u0441\u044f\u0446 \u0421\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e,\n\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 6-12\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u0425\u043b\u043e\u0440\u0430\u043c\u0431\u0443\u0446\u0438\u043b 2-4 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c, \u0421\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u043e\u0434\u0430,\n\u0437\u0430\u0442\u0435\u043c 6-14\n\u043c\u0433/\u043d\u0435\u0434\u0435\u043b\u044e \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445\n\u043b\u0435\u0442.\n\u0418\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u044b \u0413\u0438\u0434\u0440\u043e\u043a\u0441\u0438\u0445\u043b\u043e\u0440\u043e\u0445\u0438\u043d 200 \u043c\u0433 \u0412\n\u0432\u043d\u0443\u0442\u0440\u044c,\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0426\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u0412\n\u043a\u0430\u043f\u043b\u0438, 0,05-\n0,1%, \u043f\u043e 1\n\u043a\u0430\u043f\u043b\u0435 2 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u041c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0420\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431 \u041a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0442 \u0410\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u0434\u043b\u044f\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\n\n\u044f \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f\n\u0438\u043d\u0444\u0443\u0437\u0438\u0439\n500\u043c\u0433/50\u043c\u043b\n\u043a\u0443\u0440\u0441\u0430\u043c\u0438: \u043f\u043e\n500\u043c\u0433/\u043d\u0435\u0434\u0435\u043b\u044e\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 4\u0445\n\u043d\u0435\u0434\u0435\u043b\u044c\n\u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0441\u043b\u0435\u0437\u0430 \u0418\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0441\u043b\u0435\u0437\u0430 (0,1-0,4% \u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u0412\n\u0433\u0438\u0430\u043b\u0443\u0440\u043e\u043d\u0430\u0442 \u043d\u0430\u0442\u0440\u0438\u044f, 0,5-1% \u043a\u0430\u043f\u043b\u0438, 3-4 \u0438\n\u0433\u0438\u0434\u0440\u043e\u043a\u0441\u0438\u043f\u0440\u043e\u043f\u0438\u043b\u043c\u0435\u0442\u0438\u043b\u0446\u0435\u043b\u043b\u044e\u043b\u043e\u0437 \u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0437\u0430 \u0432\n\u0443, 0,5-1% \u0434\u0435\u043d\u044c,\n\u043a\u0430\u0440\u0431\u043e\u043a\u0441\u0438\u043c\u0435\u0442\u0438\u043b\u0446\u0435\u043b\u043b\u044e\u043b\u043e\u0437\u0443, 0,1- \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n3% \u0434\u0435\u043a\u0441\u0442\u0440\u0430\u043d 70)\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u043d\u0430\u0442\u0440\u0438\u044f \u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u0421\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u043f\u043b\u0438 0,1%, 3-\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 5 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c,\n7-10 \u0434\u043d\u0435\u0439\n\u043c-\u0425\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a \u041f\u0438\u043b\u043e\u043a\u0430\u0440\u043f\u0438\u043d 5 \u043c\u0433 4 \u0440\u0430\u0437\u0430 \u0432 \u0410\n\u0434\u0435\u043d\u044c,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u041e\u0442\u0445\u0430\u0440\u043a\u0438\u0432\u0430\u044e\u0449\u0435\u0435 \u0410\u0446\u0435\u0442\u0438\u043b\u0446\u0438\u0441\u0442\u0435\u0438\u043d 200 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c, \u0421\n\u043c\u0443\u043a\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e 3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438,\n\u0434\u043e 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u043d\u0430\u0442\u0440\u0438\u044f 75-100 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c \u0421\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u043e\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 1 \u0440\u04