u0439 (7-12\n\u0431\u0440\u0438\u0442\u044c\u0435, \u0447\u0438\u0441\u0442\u043a\u0430 \u0437\u0443\u0431\u043e\u0432, \u043c\u0438\u043d).\n\u0443\u043c\u044b\u0432\u0430\u043d\u0438\u0435 \u0441\u0438\u0434\u044f.\n\nII \u0430) \u0422\u043e \u0436\u0435 + \u043f\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u0435 (\u0434\u043e \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f 4-7\n20 \u043c\u0438\u043d) \u043d\u0430 \u043a\u0440\u0430\u044e \u043a\u0440\u043e\u0432\u0430\u0442\u0438, \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 No 1 \u043e\n\u0441\u0432\u0435\u0441\u0438\u0432 \u043d\u043e\u0433\u0438 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, \u043b\u0435\u0436\u0430 \u043d\u0430 \u0441\u043f\u0438\u043d\u0435. \u0424\u0422 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\n\u043f\u0440\u0438\u0435\u043c \u043f\u0438\u0449\u0438 \u0441\u0438\u0434\u044f, \u043c\u0430\u043b\u044b\u0445 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0442\u0438 \u0438\n\n\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u0443\u0430\u043b\u0435\u0442\u043e\u043c. \u0433\u0440\u0443\u043f\u043f \u0431\u0435\u0437 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\n\u041f\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0442\u0443\u043b \u0438 \u044d\u0441\u043f\u0430\u043d\u0434\u0435\u0440\u043e\u0432. \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\n\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0442\u043e\u0433\u043e \u0436\u0435 \u043e\u0431\u044a\u0435\u043c\u0430 \u041c\u0430\u0441\u0441\u0430\u0436 \u0441\u043f\u0438\u043d\u044b. \u043c\u044b\u0445\n\u0431\u044b\u0442\u043e\u0432\u044b\u0445 \u043d\u0430\u0433\u0440\u0443\u0437\u043e\u043a, \u0441\u0438\u0434\u044f \u043d\u0430 \u0422\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u0432\u0434\u043e\u0445\u0430 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0445\n\n\u0441\u0442\u0443\u043b\u0435. \u0438 \u0432\u044b\u0434\u043e\u0445\u0430. \u0424\u0422\n\u0431) \u0422\u043e \u0436\u0435 + \u0445\u043e\u0434\u044c\u0431\u0430 \u043f\u043e \u043f\u0430\u043b\u0430\u0442\u0435, \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u041d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u044b\u0435 8-11\n\u043f\u0440\u0438\u0435\u043c \u043f\u0438\u0449\u0438, \u0441\u0438\u0434\u044f \u0437\u0430 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 No 2 \u0438\u0433\u0440\u044b,\n\u0441\u0442\u043e\u043b\u043e\u043c, \u043c\u044b\u0442\u044c\u0435 \u043d\u043e\u0433 \u0441 \u0441\u0438\u0434\u044f, \u0432\u044b\u0448\u0438\u0432\u0430\u043d\u0438\u0435,\n\n\u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430, \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e. \u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\n\u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435. \u0412 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0424\u0422 \u0442.\u0434. \u041a\u0440\u0430\u0442\u043a\u0430\u044f\n\u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f - \u043c\u0430\u043b\u044b\u0445 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\n\u0441\u0438\u0434\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0442\u0443\u043b\u0435, \u0447\u0430\u0441\u0442\u043e\u0435 (4- \u0433\u0440\u0443\u043f\u043f \u0431\u0435\u0437 \u043e \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438\n\n8 \u0440\u0430\u0437) \u0432\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0441 \u043a\u0440\u043e\u0432\u0430\u0442\u0438. \u044d\u0441\u043f\u0430\u043d\u0434\u0435\u0440\u043e\u0432. \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439\n\u0422\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u0432\u0434\u043e\u0445\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\n\u0438 \u0432\u044b\u0434\u043e\u0445\u0430. \u0438\n\u0418\u0411\u0421,\n\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\n\u0441\u0442\u0438,\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439\n\u0440\u0438\u0442\u043c\u0430,\n\n\u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\n\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439.\nIII \u0430) \u0422\u043e \u0436\u0435 + \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0422\u043e \u0436\u0435 + \u0447\u0435\u0440\u0435\u0437 9-12. \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438, \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \"\u0441\u0438\u0434\u044f\" \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 No 2, \u043a\u0430\u0436\u0434\u044b\u0435 15\n\u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439, \u0445\u043e\u0434\u044c\u0431\u0430 \u043f\u043e 3 \u0441\u0438\u0434\u044f, \u043c\u0438\u043d\u0443\u0442 \u0440\u0430\u0431\u043e\u0442\u044b\n\u043f\u0430\u043b\u0430\u0442\u0435 \u0434\u043e 150 \u043c \u0432 2-3 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e. - 10 \u043c\u0438\u043d\u0443\u0442\n\u043f\u0440\u0438\u0435\u043c\u0430. \u0424\u0422 \u043c\u0430\u043b\u044b\u0445 \u043e\u0442\u0434\u044b\u0445\u0430.\n\n\u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f \u0441 \u0422\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440.\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0411\u0435\u0441\u0435\u0434\u0430 \u043e\n\n37", "type": "Document"}}