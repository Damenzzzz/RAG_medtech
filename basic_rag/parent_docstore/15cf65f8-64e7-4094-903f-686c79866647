3d\u0438\u043d\u0430 (\u0431\u0435\u0437 \u043a\u043e\u0436\u0438 \u0438 \u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e \u0436\u0438\u0440\u0430, \u0441\u0443\u0445\u043e\u0436\u0438\u043b\u0438\u0439) \u0420\u044b\u0431\u0430 \u0424\u0438\u043b\u0435 \u042f\u0439\u0446\u043e \u0421\u0432\u0430\u0440\u0435\u043d\u043d\u043e\u0435 \u0432\u043a\u0440\u0443\u0442\u0443\u044e (\u043d\u0435 \u043c\u0435\u043d\u0435\u0435 15-20 \u043c\u0438\u043d) \u041e\u043c\u043b\u0435\u0442 \u0411\u0443\u0442\u0438\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0435\u0433\u0430\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0432\u043e\u0434\u0430 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f (\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u0430\u044f \u041d\u0430\u043f\u0438\u0442\u043a\u0438 \u0434\u0435\u0442\u0441\u043a\u0430\u044f \u0432\u043e\u0434\u0430 \u0438\u043b\u0438 \u043f\u0440\u043e\u043a\u0438\u043f\u044f\u0447\u0435\u043d\u043d\u0430\u044f) \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 0,5\u043b) \u0431\u0443\u0442\u044b\u043b\u043a\u0430\u0445 \u0441\u043e\u043a\u0438 \u043e\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u043d\u044b\u0435, \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430, \u043f\u0430\u0441\u0442\u0435\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 0,25\u043b) \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0430\u0445 \u0421\u043b\u0430\u0434\u043e\u0441\u0442\u0438 \u0438 \u0434\u0436\u0435\u043c \u0441\u0442\u0435\u0440\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0430\u0445 \u043a\u043e\u043d\u0434\u0438\u0442\u0435\u0440\u0441\u043a\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u044c\u0435 \u0432 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0430\u0445, \u0434\u0435\u0442\u0441\u043a\u043e\u0435, \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u043c\u043e\u0435 (\u0442\u0438\u043f\u0430\u00ab\u0425\u0430\u0439\u043d\u0446\u00bb \u0438 \u0434\u0440) \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0432\u044b\u043f\u0435\u0447\u043a\u0430 (\u0448\u0430\u0440\u043b\u043e\u0442\u043a\u0430, \u0441\u043b\u043e\u0439\u043a\u0438) \u043b\u0435\u0434\u0435\u043d\u0446\u044b \u0432 \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0435\u2013 \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430, (\u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u044b\u0435 \u0432 \u0430\u043f\u0442\u0435\u043a\u0435 \u043f\u043e \u0442\u0438\u043f\u0443 \u00ab\u0411\u043e\u043d \u043f\u0430\u0440\u0438\u00bb \u0438 \u00ab\u0417\u0443\u043b\u0430\u00bb \u0438 \u0434\u0440) \u041c\u043e\u043b\u043e\u0447\u043d\u044b\u0435 \u0412\u0441\u0435 \u043c\u043e\u043b\u043e\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b - \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u0438\u044e \u0441 \u043b\u0435\u0447\u0430\u0449\u0438\u043c \u0432\u0440\u0430\u0447\u043e\u043c!!! \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0422\u0432\u043e\u0440\u043e\u0433 (\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0439, \u0432 \u0431\u043b\u044e\u0434\u0430\u0445: \u0441\u044b\u0440\u043d\u0438\u043a\u0438, \u0437\u0430\u043f\u0435\u043a\u0430\u043d\u043a\u0430) (\u0435\u0441\u043b\u0438 \u043d\u0435 \u0421\u043c\u0435\u0442\u0430\u043d\u0430 (\u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u0430\u044f, \u0432 \u0431\u043b\u044e\u0434\u0430\u0445) \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u0419\u043e\u0433\u0443\u0440\u0442, \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0439 \u0432 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0431\u0435\u0437\u043b\u0430\u043a\u0442\u043e\u0437\u043d\u0430\u044f (\u0442\u0435\u0440\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439), \u0441\u043e \u0441\u0440\u043e\u043a\u043e\u043c \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0435 45 \u0434\u043d\u0435\u0439. \u041c\u0430\u0440\u043a\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0434\u0438\u0435\u0442\u0430) \u0439\u043e\u0433\u0443\u0440\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442, \u0439\u043e\u0433\u0443\u0440\u0442\u043d\u044b\u0439 \u043d\u0430\u043f\u0438\u0442\u043e\u043a (\u0442\u0430\u043a\u0438\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u0438\u043c\u0435\u044e\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435: \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u0419\u043e\u0433\u0443\u0440\u0442\u0435\u0440\u00bb, \u00ab\u0424\u0440\u0443\u0433\u0443\u0440\u0442\u00bb, \u00ab\u042d\u0440\u043c\u0438\u0433\u0443\u0440\u0442\u00bb \u0438 \u0434\u0440.) \u0414\u0435\u0442\u044f\u043c \u0441 8 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u2013 \u0439\u043e\u0433\u0443\u0440\u0442\u043d\u044b\u0435 \u0438 \u0442\u0432\u043e\u0440\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u00abBaby Cap\u00bb, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u00abNestle\u00bb \u0438 \u0434\u0440 \u0441\u0442\u0435\u0440\u0438\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u044f \u0421\u044b\u0440 \u043f\u043b\u0430\u0432\u043b\u0435\u043d\u044b\u0439 \u0431\u0435\u0437 \u0441\u043f\u0435\u0446\u0438\u0439 \u0438 \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u0435\u0439, \u043f\u043e\u0440\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0432 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u043b\u0438\u0432\u043e\u0447\u043d\u044b\u0439 \u00ab\u0425\u043e\u0445\u043b\u0430\u043d\u0434\u00bb \u0432 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0430\u0445) \u041c\u043e\u043b\u043e\u043a\u043e \u043a\u043e\u0440\u043e\u0432\u044c\u0435, \u043a\u043e\u0437\u044c\u0435 \u0441\u0442\u0435\u0440\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435 (\u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430) \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 0,25\u043b) \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0430\u0445 \u0421\u043b\u0438\u0432\u043a\u0438 \u0441\u0442\u0435\u0440\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 (10% - 20% \u0436\u0438\u0440\u043d\u043e\u0441\u0442\u0438) \u041f\u0440\u0435\u0441\u043d\u044b\u0435 \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043c\u043e\u043b\u043e\u0447\u043d\u044b\u0435 \u0441\u043c\u0435\u0441\u0438 \u0434\u043b\u044f \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f, \u043d\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435 \u0431\u0438\u0444\u0438\u0434\u043e- \u0438 \u043b\u0430\u043a\u0442\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438 \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043b\u0435\u0447\u0435\u0431\u043d\u044b\u0435 \u043c\u043e\u043b\u043e\u0447\u043d\u044b\u0435 \u0441\u043c\u0435\u0441\u0438 (\u043f\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e \u0432\u0440\u0430\u0447\u0430 \u0434\u0438\u0435\u0442\u043e\u043b\u043e\u0433\u0430) 2) \u0421\u043f\u0438\u0441\u043e\u043a \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a \u041e\u0432\u043e\u0449\u0438 \u0412\u0441\u0435 \u043e\u0432\u043e\u0449\u0438 \u0432 \u0441\u044b\u0440\u043e\u043c \u0432\u0438\u0434\u0435 \u043c\u0430\u0440\u0438\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043e\u0432\u043e\u0449\u0438 \u043b\u0443\u043a \u0437\u0435\u043b\u0435\u043d\u044b\u0439-\u043f\u0435\u0440\u043e \u043f\u0440\u044f\u043d\u0430\u044f \u0437\u0435\u043b\u0435\u043d\u044c (\u0443\u043a\u0440\u043e\u043f, \u043f\u0435\u0442\u0440\u0443\u0448\u043a\u0430, \u0431\u0430\u0437\u0438\u043b\u0438\u043a \u0438 \u0442.\u043f.) \u043e\u0432\u043e\u0449\u043d\u0430\u044f \u0437\u0435\u043b\u0435\u043d\u044c (\u0441\u0430\u043b\u0430\u0442, \u0449\u0430\u0432\u0435\u043b\u044c, \u0448\u043f\u0438\u043d\u0430\u0442) \u043a\u0430\u043f\u0443\u0441\u0442\u0430 \u043a\u0432\u0430\u0448\u0435\u043d\u0430\u044f \u0424\u0440\u0443\u043a\u0442\u044b \u0438 \u044f\u0433\u043e\u0434\u044b \u0441\u044b\u0440\u044b\u0435 \u0444\u0440\u0443\u043a\u0442\u044b \u0438 \u044f\u0433\u043e\u0434\u044b - \u0432\u0441\u0435 \u0441\u0443\u0445\u043e\u0444\u0440\u0443\u043a\u0442\u044b \u0446\u0438\u0442\u0440\u0443\u0441\u043e\u0432\u044b\u0435, \u0433\u0440\u0430\u043d\u0430\u0442, \u0430\u043d\u0430\u043d\u0430\u0441, \u0430\u0440\u0431\u0443\u0437, \u0434\u044b\u043d\u044f, \u0437\u0435\u043c\u043b\u044f\u043d\u0438\u043a\u0430, \u043c\u0430\u043b\u0438\u043d\u0430, \u0435\u0436\u0435\u0432\u0438\u043a\u0430, \u043c\u043e\u0440\u043e\u0448\u043a\u0430, \u043a\u043b\u0443\u0431\u043d\u0438\u043a\u0430, \u0441\u043c\u043e\u0440\u043e\u0434\u0438\u043d\u0430, \u0447\u0435\u0440\u043d\u043e\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0440\u044f\u0431\u0438\u043d\u0430, \u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434 \u2013\u0434\u0430\u0436\u0435 \u043f\u0440\u043e\u0448\u0435\u0434\u0448\u0438\u0435 \u0442\u0435\u0440\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0417\u0435\u0440\u043d\u043e\u0432\u044b\u0435 \u043a\u0430\u0448\u0438 \u0438\u0437 \u043f\u0435\u0440\u043b\u043e\u0432\u043e\u0439 \u0438 \u043f\u0448\u0435\u043d\u043d\u043e\u0439 \u043a\u0440\u0443\u043f (\u0442\u0440\u0443\u0434\u043d\u043e \u0443\u0441\u0432\u0430\u0438\u0432\u0430\u044e\u0442\u0441\u044f) \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b, \u043a\u0430\u0448\u0438 \u043a\u0430\u0448\u0438 \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f (\u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u0448 \u0434\u043b\u044f \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f) \u0432\u0441\u0435, \u0440\u0430\u0437\u043e\u0433\u0440\u0435\u0442\u044b\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u041c\u0430\u043a\u0430\u0440\u043e\u043d\u043d\u044b\u0435 \u043c\u0430\u043a\u0430\u0440\u043e\u043d\u043d\u044b\u0435 \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f (\u00ab\u0414\u043e\u0448\u0438\u0440\u0430\u043a\u00bb, \u00ab\u0420\u043e\u043b\u0442\u043e\u043d\u00bb \u0438 \u0442.\u043f.) \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0438\u0437 \u043c\u044f\u0433\u043a\u0438\u0445 \u0441\u043e\u0440\u0442\u043e\u0432 \u043f\u0448\u0435\u043d\u0438\u0446\u044b \u0440\u0430\u0437\u043e\u0433\u0440\u0435\u0442\u044b\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0425\u043b\u0435\u0431 \u0438 \u0438\u0437\u0434\u0435\u043b\u0438\u044f, \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u0433\u0435\u0440\u043c\u0435\u0442\u0438\u0447\u043d\u0443\u044e \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0443 \u0445\u043b\u0435\u0431\u043e\u0431\u0443\u043b\u043e\u0447\u043d\u044b\u0435 \u0438\u0437\u0434\u0435\u043b\u0438\u044f, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435 \u0441\u0443\u0445\u043e\u0444\u0440\u0443\u043a\u0442\u044b \u0438\u043b\u0438 \u043e\u0440\u0435\u0445\u0438 \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0441\u0443\u0445\u0430\u0440\u0438\u043a\u0438 \u00ab\u0441\u043e\u043b\u043e\u043c\u043a\u0430\u00bb \u0441\u043e\u043b\u0435\u043d\u044b\u0435 \u043f\u0430\u043b\u043e\u0447\u043a\u0438 \u0441\u0443\u0448\u043a\u0438 \u0438\u0437 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u043d\u0430 \u0440\u0430\u0437\u0432\u0435\u0441 \u0414\u0435\u0441\u0435\u0440\u0442\u044b, \u041c\u043e\u0440\u043e\u0436\u0435\u043d\u043e\u0435 \u043a\u043e\u043d\u0434\u0438\u0442\u0435\u0440\u0441\u043a\u0438\u0435 \u0425\u0430\u043b\u0432\u0430 \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u041a\u0430\u0440\u0430\u043c\u0435\u043b\u044c \u0441\u043b\u0430\u0434\u043e\u0441\u0442\u0438 \u041b\u0435\u0434\u0435\u043d\u0446\u044b \u0414\u0440\u0430\u0436\u0435 \u0428\u043e\u043a\u043e\u043b\u0430\u0434 \u0412\u043e\u0441\u0442\u043e\u0447\u043d\u044b\u0435 \u0441\u043b\u0430\u0434\u043e\u0441\u0442\u0438 \u041f\u0438\u0440\u043e\u0436\u043d\u044b\u0435 \u041c\u0435\u0434 \u0412\u043e\u0434\u0430 \u0438\u0437 \u043d\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u044