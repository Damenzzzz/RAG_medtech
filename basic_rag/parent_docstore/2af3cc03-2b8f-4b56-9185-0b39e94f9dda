u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\u0445 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 [A1]\n\n\u0430) \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u043b\u0438\u0437\u0438\u0441\u0430 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 [A1]:\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041f\u0440\u0438\u043a\u0430\u0437\u0430 No 666 \u00ab\u041e\u0431 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0438\n\u041d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u044b, \u041f\u0440\u0430\u0432\u0438\u043b \u0437\u0430\u0433\u043e\u0442\u043e\u0432\u043a\u0438, \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u043a\u0438, \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f, \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043a\u0440\u043e\u0432\u0438, \u0430\n\u0442\u0430\u043a\u0436\u0435 \u041f\u0440\u0430\u0432\u0438\u043b \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f, \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0438, \u0435\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 \u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043a\u0440\u043e\u0432\u0438 \u043e\u0442\n\n\u00ab6\u00bb \u043c\u0430\u0440\u0442\u0430 2011 \u0433\u043e\u0434\u0430, \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043a \u043f\u0440\u0438\u043a\u0430\u0437\u0443 No417 \u041f\u0440\u0438\u043a\u0430\u0437 \u043e\u0442 29.05.2015 \u0433\u043e\u0434\u0430.\n\u2022 \u0410\u0434\u