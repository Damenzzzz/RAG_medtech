\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0442\u0440\u0430\u043a\u0446\u0438\u044f\u043c\u0438 \u0432 - \u0433\u0435\u043c\u043e\u0444\u0442\u0430\u043b\u044c\u043c, \u043d\u0435\n\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0433\u0435\u043c\u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043c; \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0438\u043c \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c\n- \u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u043e\u0442\u0441\u043b\u043e\u0439\u043a\u0430 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438, \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e \u041b\u041a\u0421; \u0414\u041c\u041e \u0431\u0435\u0437 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u043c\u0430\u043a\u0443\u043b\u044f\u0440\u043d\u0443\u044e \u0437\u043e\u043d\u0443, \u0438\u043b\u0438 \u043f\u0440\u0438 -\u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0446\u0435\u043d\u0442\u0440\u0430\n\u0414\u041c\u041e \u0441 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0446\u0435\u043d\u0442\u0440\u0430\n\u0443\u0433\u0440\u043e\u0437\u0435 \u0435\u0451 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f; \u043d\u0435\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f\n- \u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u043e-\u0440\u0435\u0433\u043c\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u0430\u044f \u043e\u0442\u0441\u043b\u043e\u0439\u043a\u0430 \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438 (\u0438/\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e\n\u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438. \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430) \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 -\n\u0433\u0435\u043c\u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043c;\n-\u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0439\n\u041b\u041a \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438\n\u0433\u0435\u043c\u043e\u0444\u0442\u0430\u043b\u044c\u043c. \u041e\u0417 \u043c\u0435\u043d\u0435\u0435 0,7 \u041e\u0417 \u0431\u043e\u043b\u0435\u0435 0,7\n\u0412\u0438\u0442\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0431\u0435\u0437/\u0441 \u043e\u0434\u043d\u043e\u043c\u043e\u043c\u0435\u043d\u0442\u043d\u043e\u0439\n\u044d\u043d\u0434\u043e\u043b\u0430\u0437\u0435\u0440\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u0435\u0439, \u0448\u0432\u0430\u0440\u0442\u044d\u043a\u0442\u043e\u043c\u0438\u0435\u0439,\n\u043c\u0435\u043c\u0431\u0440\u0430\u043d\u043e\u043f\u0438\u043b\u0438\u043d\u0433\u043e\u043c, \u044d\u043d\u0434\u043e\u0442\u0430\u043c\u043f\u043e\u043d\u0430\u0434\u043e\u0439 \u0422\u0440\u0430\u043a\u0446\u0438\u0438 \u0422\u0440\u0430\u043a\u0446\u0438\u044f \u0435\u0441\u0442\u044c\n\u0432\u0438\u0442\u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0444\u0442\u043e\u0440\u043a\u0430\u0440\u0431\u043e\u043d\u0430\u043c\u0438, \u043d\u0435\u0442\n\u0418\u0412\u0412\u0418\u0410 \u0438\u043b\u0438 \u0418\u0412\u0412\u0413\u041a\n\u0440\u0430\u0441\u0448\u0438\u0440\u044f\u044e\u0449\u0438\u043c\u0438\u0441\u044f\n\u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0433\u0430\u0437\u0430\u043c\u0438 \u0438\u043b\u0438\n\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0413\u0413, \u0410\u0414,\n\u0441\u0438\u043b\u0438\u043a\u043e\u043d\u043e\u0432\u044b\u043c\u0438 \u043c\u0430\u0441\u043b\u0430\u043c\u0438, \u0431\u0435\u0437/\u0441\n\u0426\u0422\u0421 \u043c\u0435\u043d\u0435\u0435 350\n\u043b\u0438\u043f\u0438\u0434\u043e\u0432 \u043a\u0440\u043e\u0432\u0438.\n\u043e\u0434\u043d\u043e\u043c\u043e\u043c\u0435\u043d\u0442\u043d\u043e\u0439 \u0426\u0422\u0421 \u0431\u043e\u043b\u0435\u0435 350\n\u043c\u0438\u043a\u0440\u043e\u043d\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0418\u0412\u0412\u0418\u0410,\n\u0444\u0430\u043a\u043e\u044d\u043c\u0443\u043b\u044c\u0441\u0442\u0444\u0438\u043a\u0430\u0446\u0438\u0435\u0439 \u043a\u0430\u0442\u0430\u0440\u0430\u043a\u0442\u044b \u0441 \u043c\u0438\u043a\u0440\u043e\u043d\n\u0412\u0438\u0442\u0440\u044d\u043a\u0442\u043e\u043c\u0438\u044f \u0418\u0412\u0412\u0413\u041a (\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0438\u043c\u043f\u043b\u0430\u043d\u0442\u0435\u0446\u0438\u0435\u0439 \u0418\u041e\u041b (\u043e\u0431\u044a\u0435\u043c\n\u0438\u043b\u0438 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u041b\u041a\u0421)\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e).\n\u041b\u041a \u0441\u0435\u0442\u0447\u0430\u0442\u043a\u0438 (\u043c\u043e\u043d\u043e- \u0438\u043b\u0438 \u0418\u0412\u0412\u0418\u0410 \u0438\u043b\u0438 \u0418\u0412\u0412\u0413\u041a;\n\u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0418\u0412\u0412\u0418\u0410 (\u043c\u043e\u043d\u043e - \u0438\u043b\u0438 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u041b\u041a\u0421)\n\u0438\u043b\u0438 \u0418\u0412\u0412\u0413\u041a)", "type": "Document"}}