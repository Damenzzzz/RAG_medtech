\u0432\u0430\u044e\u0449\u0430\u044f\u0441\u044f\n\u0438\u0437 \u043a\u043b\u0435\u0442\u043e\u043a \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u044e\u0449\u0430\u044f\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 15 \u0441\u043c \u043e\u0442 \u0430\u043d\u0443\u0441\u0430\n\u043f\u0440\u0438 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u0440\u0438\u0433\u0438\u0434\u043d\u044b\u043c \u0440\u0435\u043a\u0442\u043e\u0441\u043a\u043e\u043f\u043e\u043c [1].\n\n1.8 \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \uf05b3,7\uf05d\n\u0410. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f:\n\u0421\u0442\u0430\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u043a\u0430 \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u043f\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0435 TNM8 (2017) \u0414\u043b\u044f \u0440\u0430\u043a\u0430\n\n\u043e\u0431\u043e\u0434\u043e\u0447\u043d\u043e\u0439 \u0438 \u0440\u0435\u043a\u0442\u043e\u0441\u0438\u0433\u043c\u043e\u0438\u0434\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430 \u0442\u043e\u043b\u0441\u0442\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0435\u0434\u0438\u043d\u0430\u044f\n\u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f.\n\u0422 \u2013 \u0440\u0430\u0437\u043c\u0435\u0440\u044b \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0439 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0438 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0435\u0435 \u0438\u043d\u0432\u0430\u0437\u0438\u0438 \u0432 \u0441\u0442\u0435\u043d\u043a\u0443 \u043a\u0438\u0448\u043a\u0438.\n\u0422x \u2013 \u043d\u0435\u0434\u043e