43d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0424\u0438\u0437\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0411\u0430\u043b\u044c\u043d\u0435\u043e\u043b\u043e\u0433\u0438\u044f \u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f, 2011.-N 2.-\u0421.11-17\n\n45) Rei\u00dfhauer A., Schoppe B., Jahr S. Effect of treatment with low-intensity and\nextremely low-frequency electrostatic fields (DEEP OSCILLATION\u00ae) on breast tissue\n\n14\n\nand pain in patients with secondary breast lymphoedema. JRehabilMed 40:645-650\n\n(2008).\n46) \u0428\u043a\u0430\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u043b\u0438\u043c\u0444\u043e\u0441\u0442\u0430\u0437\u0430., 1976 \u0433. \u0411.\u041d. \u0416\u0443\u043a\u043e\u0432 \u0438 \u0412.\u041a. \u0411\u043e\u0440\u0438\u0441\u043e\u0432\n\n15\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 1\n\n\u041e\u0431\u0449\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0442\u044c \u043f\u043e \u0438\u043d\u0434\u0435\u043a\u0441\u0443\n\n\u041a\u0430\u0440\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e (0-100%) \u0438\u043b\u0438 \u0428\u043a\u0430\u043b\u0435 ECOG-\u0412\u041e\u0417 (0-4 \u0431\u0430\u043b\u043b\u0430).\n\u0418\u043d\u0434\u0435\u043a\u0441 \u041a\u0430\u0440\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0410\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c, \u0428\u043a\u0430\u043b\u0430 ECOG - \u0412\u041e\u0417 \u0411\u0430\u043b\u043b\n\n%\n\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435, \u0436\u0430\u043b\u043e\u0431 \u043d\u0435\u0442 100 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c 0\n\n\u0421\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043a \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 90 \u0415\u0441\u0442\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b 1\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043d\u043e \u0431\u043b\u0438\u0436\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043a \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443\n\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e\n\n\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0441 \u0443\u0441\u0438\u043b\u0438\u0435\u043c 80\n\n\u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044f 70 \u0411\u043e\u043b\u044c\u0448\u0435 50% \u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e 2\n\n\u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u043d\u0435 \u0432\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u043f\u043e\u0441\u0442\u0435\u043b\u0438, \u043d\u043e \u0438\u043d\u043e\u0433\u0434\u0430\n\u0430\u043a\u0442\u0438\u0432\