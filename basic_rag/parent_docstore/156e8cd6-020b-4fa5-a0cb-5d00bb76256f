435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432: \u043d\u0435\u0442.\n\n11.6 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 [5]:\nNo \u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u044f \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\n1. \u0410\u043c\u0435\u043b\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043c\u0430 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0432\u044f\u0437\u0438 \u0432 \u0435\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0441 \u0434\u0435\u043f\u0443\u043b\u044c\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\n\u0438\u043b\u0438 \u0438\u043c\u0435\u044e\u0449\u0438\u043c \u0433\u0430\u043d\u0433\u0440\u0435\u043d\u0443 \u043f\u0443\u043b\u044c\u043f\u044b \u0437\u0443\u0431\u043e\u043c, \u0447\u0442\u043e \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\n2. \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u0433\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u044b \u043c\u0435\u043d\u0435\u0435 1 \u0441\u043c\n\u0433\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0439\n\u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043d\u0442\u0438\u0442\n3. \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0432\u0438\u0449\u0430 \u0441 \u0433\u043d\u043e\u0439\u043d\u044b\u043c \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u044b\u043c \u0438\n\n\u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442 \u0432\u044b\u0431\u0443\u0445\u0430\u044e\u0449\u0438\u043c\u0438 \u0433\u0440\u0430\u043d\u0443\u043b\u044f\u0446\u0438\u044f\u043c\u0438, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u043e\u0432 \u043d\u0430\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d-\u043a\u0430\u0440\u0442\u0438\u043d\u0435.\n\n12.\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438;\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043d\u0435\u0442;\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0438\u0441\u0442\u043e\u0437\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0447\u0435\u043b\u044e\u0441\u0442\u0438;\n\u2022 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430 \u043a\u0438\u0441\u0442\u044b;\n\n\u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0436\u0435\u0432\u0430\u043d\u0438\u044f.\n\n13. \u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u2022 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043a\u0438\u0441\u0442\u044b;\n\u2022 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0435\u0444\u0435\u043a\u0442\u0430 \u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438;\n\u2022 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0436\u0435\u0432\u0430\u043d\u0438\u044f.\n\n14. \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f [1,2,6,9,10]:\n1. \u041a\u043b\u0438\u043d\u0438\u043a\u043e-\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435;\n2. \u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435;\n3. \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435;\n\n4. \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f;\n\n14.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u2013 \u0432 \u0440\u0430\u043d\u043d\u0438\u0439 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u2013 \u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0438\u043b\u0438\n\n\u043f\u043e\u043b\u0443\u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 (\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043e\u0431\u044a\u0435\u043c\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438).\n\u0412 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u2013 \u043f\u0430\u043b\u0430\u0442\u043d\u044b\u0439.\n\u2022 \u0414\u0438\u0435\u0442\u0430 \u0441\u0442\u043e\u043b - \u043f\u043e\u0441\u043b\u0435 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 No1\u0430,1\u0431, \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0441\u0442\u043e\u043b\nNo15.\n\n14.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\nNo \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442, \u0444\u043e\u0440\u043c\u044b \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0446\u0435\u043b\u044c\n\u0432\u044b\u043f\u0443\u0441\u043a\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n1 \u0426\u0435\u0444\u0430\u0437\u043e\u043b\u0438\u043d 1 \u0433 \u0432/\u0432 (\u0434\u0435\u0442\u044f\u043c \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1 \u0440\u0430\u0437 \u0437\u0430 30-60 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e\n\n\u043f\u043e\u0440\u043e\u0448\u043e\u043a \u0434\u043b\u044f 50 \u043c\u0433/\u043a\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e) \u0440\u0430\u0437\u0440\u0435\u0437\u0430 \u043a\u043e\u0436\u043d\u044b\u0445\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432; \u043f\u0440\u0438\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u0445\n500 \u043c\u0433 \u0438 1000 \u043c\u0433 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e 2\n\n\u0447\u0430\u0441\u0430 \u0438 \u0431\u043e\u043b\u0435\u0435 \u2013\n\u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e 0,5-1 \u0433 \u0432\u043e\n\u0432\u0440\u0435\u043c\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u043f\u043e 0,5-\n1 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 6-8 \u0447\u0430\u0441\u043e\u0432 \u0432\n\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0443\u0442\u043e\u043a \u043f\u043e\u0441\u043b\u0435\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441 \u0446\u0435\u043b\u044c\u044e\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439\n\n2 \u0426\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c + \u0426\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c 1,5-2,5 \u0433, \u0437\u0430 1 \u0447\u0430\u0441\n\u041c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0432/\u0432 (\u0434\u0435\u0442\u044f\u043c \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430. \u0415\u0441\u043b\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\n\u0426\u0435\u0444\u0443\u0440\u043e\u043a\u0441\u0438\u043c \u043f\u043e\u0440\u043e\u0448\u043e\u043a 30 \u043c\u0433/\u043a\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e) + \u0434\u043b\u0438\u0442\u0441\u044f\n\u0434\u043b\u044f \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u041c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b (\u0434\u0435\u0442\u044f\u043c \u0431\u043e\u043b\u0435\u0435 3 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 20-30 \u043c\u0433/\u043a\u0433 \u0447\u0435\u0440\u0435\u0437 6 \u0438\n\n750 \u043c\u0433 \u0438 1500 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e) 500 \u043c\u0433 \u0432/\u0432 12 \u0447\u0430\u0441\u043e\u0432 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0435\n\u041c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0434\u043e\u0437\u044b, \u0441 \u0446\u0435\u043b\u044c\u044e\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438\n0,5% - 100 \u043c\u043b \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439\n\n\u041f\u0440\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0438 \u043d\u0430 \u03b2-\u043b\u0430\u043a\u0442\u0430\u043c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438\n3 \u0412\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d 1 \u0433. \u0432/\u0432 (\u0434\u0435\u0442\u044f\u043c \u0438\u0437 1 \u0440\u0430\u0437 \u0437\u0430 2 \u0447\u0430\u0441\u0430 \u0434\u043e \u0440\u0430\u0437\u0440\u0435\u0437\u0430\n\u043f\u043e\u0440\u043e\u0448\u043e\u043a \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0435\u0442\u0430 10-15 \u043c\u0433/\u043a\u0433 \u043a\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432.\n\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e) \u0412\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 10\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u0439 \u043c\u0433/\u043c\u0438\u043d;\n500\u043c\u0433 \u0438 1000 \u043c\u0433 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043d\u0435\n\u043c\u0435\u043d\u0435\u0435 60 \u043c\u0438\u043d, \u0441 \u0446\u0435\u043b\u044c\u044e\n\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439\n\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438\n\n4 \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c \u0432 \u0441 \u0446\u0435\u043b\u044c\u044e \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u0432\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c\n100\u043c\u0433/2\u043c\u043b \u043f\u043e 2 \u043c\u043b \u0432 \u0432\u0432\u043e\u0434\u044f\u0442 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0435, 1-3 \u0441\u0443\u0442\u043e\u043a\n\u0430\u043c\u043f\u0443\u043b\u0430\u0445 \u0438\u043b\u0438 (\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e),\n\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 50 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e \u043f\u043e 50-\n100 \u043c\u0433 (1-2 \u043c\u043b\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430). \u041f\u0440\u0438\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\n\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 30-60\n\u043c\u0438\u043d\u0443\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 50 \u043c\u0433 (1 \u043c\u043b)\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430. \u041a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1-4\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442\n\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0438\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 600 \u043c\u0433.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c\n\u0434\u043e 12 \u043b\u0435\u0442.\n5 \u0422\u0440\u0438\u043c\u0435\u043f\u0435\u0440\u0438\u0434\u0438\u043d \u0412\u0432\u043e\u0434\u044f\u0442 \u0432/\u0432, \u0432/\u043c, \u043f/\u043a 1 \u043c\u043b \u0441 \u0446\u0435\u043b\u044c\u044e \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u0432\n\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430, \u043f\u0440\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c\n1% \u043f\u043e 1 \u043c\u043b \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0435, 1-3 \u0441\u0443\u0442\u043e\u043a\n\u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 12-24\u0447.\n\u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\n\u0441\u0442\u0430\u0440\u0448\u0435 2\u0445 \u043b\u0435\u0442\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 0.1 - 0.5\n\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u043f\u0440\u0438\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438\n\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n6 \u041a\u0435\u0442\u043e\u043f\u0440\u043e\u0444\u0435\u043d \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438 \u0432/\u0432 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 200-300 \u043c\u0433 \u043f\u0440\u0438 \u0432/\u0432 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n100 \u043c\u0433/2\u043c\u043b \u043f\u043e 2 \u043c\u043b (\u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 48 \u0447\u0430\u0441\u043e\u0432.\n150\u043c\u0433 300 \u043c\u0433), \u0434\u0430\u043b\u0435\u0435 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u0449\u0435\u0433\u043e\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e \u0438\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 5-7 \u0434\u043d\u0435\u0439, \u0441\n100\u043c\u0433. \u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,\n150\u043c\u0433 1 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0438\u043b\u0438 \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0439 \u0438\n100 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c. \u0431\u043e\u043b\u0435\u0443\u0442\u043e\u043b\u044f\u044e\u0449\u0435\u0439 \u0446\u0435\u043b\u044c\u044e.\n\n7 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0414\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0438 \u0434\u0435\u0442\u0435\u0439 \u0441 \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 3-\u0445 \u0434\u043d\u0435\u0439 \u0432\n\u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 12 \u043b\u0435\u0442 \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\n\u0432\u043d\u0443\u0442\u0440\u044c 100 \u043c\u0433/5 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 200 \u043c\u0433 3\u2013 \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0433\u043e\n\u043c\u043b100\u043c\u043b; \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 4 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0414\u043b\u044f \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\n200 \u043c\u0433; \u0433\u0440\u0430\u043d\u0443\u043b\u044b \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 5-\u0442\u0438 \u0434\u043d\u0435\u0439 \u0432\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e\n\u0432\u043d\u0443\u0442\u0440\u044c 600 \u043c\u0433 \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e 400 \u043c\u0433 3 \u0441\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,\n\u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f - \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0439 \u0438\n\u0434\u043e\u0437\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 5-10 \u0431\u043e\u043b\u0435\u0443\u0442\u043e\u043b\u044f\u044e\u0449\u0435\u0439 \u0446\u0435\u043b\u044c\u044e.\n\n\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430 3-4 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043d\u0435\n\u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 30\n\n\u043c\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n8 \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b 200 \u043c\u0433 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0438\u043b\u0438 500\u043c\u0433; \u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438", "type": "Document"}}