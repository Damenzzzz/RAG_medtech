u0438\u0438 \u0438 \u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430;\n\u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438, \u0447\u0430\u0441\u0442\u043e \u0441 \u0440\u0430\u0437\u0440\u044b\u0432\u044b \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a, 2. \u0417\u0430\u043c\u0435\u0442\u043d\u0430 \u043f\u043e\u0442\u0435\u0440\u044f \u0432\u043e\u043b\u043e\u0441\n\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0432\u043e\u043b\u043e\u0441 \u0432 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u043e\u043b\u043e\u0441 \u0432 \u0444\u0430\u0437\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0445\n\u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043e\u0447\u0430\u0433\u043e\u0432 \u0442\u0435\u043b\u043e\u0433\u0435\u043d\u0430. \u0431\u0435\u0437\u0443\u0441\u043f\u0435\u0448\u043d\u044b\u0445 \u043f\u043e\u043f\u044b\u0442\u043e\u043a\n\u043e\u0431\u043b\u044b\u0441\u0435\u043d\u0438\u044f, \u0441 \u043f\u043e\u0434\u0430\u0432\u0438\u0442\u044c \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0438\u0445\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u0432\u0435\u043b\u043b\u044e\u0441\u0430 \u0438 \u0432\u044b\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u0442\u044c;\n\u0437\u043e\u043d\u044b \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043d\u043d\u044b\u0445 2.\u0421\u0440\u0435\u0434\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u0432\u043e\u043b\u043e\u0441. \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u043b\u0438\u0446\u0430 \u0436\u0435\u043d\u0441\u043a\u043e\u0433\u043e\n\u043f\u043e\u043b\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 11-16 \u043b\u0435\u0442;\n3.\u0423\u0447\u0430\u0441\u0442\u043a\u0438 \u043e\u0431\u043b\u044b\u0441\u0435\u043d\u0438\u044f, \u043a\u0430\u043a\n\u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f\n\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u043e\n\n\u041c\u0438\u043a\u043e\u0437 \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0414\u043b\u044f \u043f\u043e\u0434\u0442\u0432\u0435\u0436\u0434\u0435\u043d\u0438\u044f 1.\u0427\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0443\n\u0432\u043e\u043b\u043e\u0441\u0438\u0441\u0442\u043e\u0439 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u0430\u043b\u0438\u043a \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432\n\u0447\u0430\u0441\u0442\u0438 \u0433\u043e\u043b\u043e\u0432\u044b \u043f\u043e \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0438 \u043e\u0447\u0430\u0433\u0430 \u0438 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 2.\u041d\u0430 \u0432\u043e\u043b\u043e\u0441\u0438\u0441\u0442\u043e\u0439 \u0447\u0430\u0441\u0442\u0438\n\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0435\u043d\u044c\u043a\u043e\u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u043c\u0438\u043a\u043e\u0437- \u0433\u043e\u043b\u043e\u0432\u044b \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f\n\u0432\u043e\u043b\u043e\u0441, \u043e\u0431\u043b\u043e\u043c\u0430\u043d\u043d\u044b\u0445 \u043d\u0430 \u0432\u044b\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0434\u0440\u0443\u0437\u044b \u0433\u0440\u0438\u0431\u043e\u0432 \u043e\u0447\u0430\u0433\u0438 \u043e\u043a\u0440\u0443\u0433\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u044b \u0441\n\u0443\u0440\u043e\u0432\u043d\u0435 2-3 \u043c\u043c \u043e\u0442 \u0432\u043d\u0443\u0442\u0440\u0438 \u0438 \u0441\u043d\u0430\u0440\u0443\u0436\u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u0435\u0439,\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0436\u0438. \u0432\u043e\u043b\u043e\u0441\u044f\u043d\u043e\u0433\u043e \u0441\u0442\u0435\u0440\u0436\u043d\u044f. \u0448\u0435\u043b\u0443\u0448\u0435\u043d\u0438\u044f \u043a\u043e\u0436\u0438 \u0438\n\u043e\u0431\u043b\u0430\u043c\u044b\u0432\u0430\u043d\u0438\u044f \u0432\u043e\u043b\u043e\u0441 \u043d\u0430\n\u0443\u0440\u043e\u0432\u043d\u0435 1-2 \u0438\u043b\u0438 5-6 \u043c\u043c \u043e\u0442\n\u0443\u0440\u043e\u0432\u043d\u044f \u043a\u043e\u0436\u0438.\n3. \u0421\u0432\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\n\u043b\u044e\u043c\u0438\u043d\u0438\u0441\u0446\u0435\u043d\u0442\u043d\u043e\u0439 \u043b\u0430\u043c\u043f\u043e\u0439\n\u0412\u0443\u0434\u0430\n\u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0442\u043a\u0430\u044f\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0441\n\u043f\u0440\u0438\u0435\u043c\u043e\u043c\n\n\u0446\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u043e\u0432,\n\u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u043e\u0432, \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f 1.\u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\n\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445\n\u043f\u0441\u0438\u0445\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438\n\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0439 2.\u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043c\u043e\u0436\u0435\u0442\n\u0422\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0438\u043b\u0438 \u043f\u043e\u043b\u043d\u043e\u0439 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438 \u043d\u0430 \u043e\u0442\u043c\u0435\u0447\u0430\u0442\u044c\u0441\u044f \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\n\u0430\u043b\u043e\u043f\u0435\u0446\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0441\u043a\u0430\u043b\u044c\u043f\u0435 \u0438/\u0438\u043b\u0438 \u043d\u0430 \u0442\u0443\u043b\u043e\u0432\u0438\u0449\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [18-21, 38-41]:\n\n\u0432\u0441\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0434\u0430\u043d\u043d\u044b\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u043e\u043c \u043b\u0435\u0447\u0430\u0442\u0441\u044f \u043d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0441\u0442\u043e\u043b No15, \u0432 \u043f\u0438\u0442\u0430\u043d\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\n\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0435\u043c\u043e\u0439 \u0432\u043e\u0434\u044b \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043d\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0432\u044f\u0437\u043a\u043e\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u0438, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432\n\u0441\u0433\u0443\u0449\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0440\u043e\u0432\u0438).\n\n\u0424\u0438\u0437\u0438\u043e\u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n- \u0443\u0437\u043a\u043e\u043f\u043e\u043b\u043e\u0441\u043d\u0430\u044f \u0444\u043e\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u044d\u043a\u0441\u0438\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u043b\u0430\u0437\u0435\u0440\u0430 c \u0434\u043b\u0438\u043d\u043d\u043e\u0439\n\u0432\u043e\u043b\u043d\u044b 308-\u043d\u043c (\u0421). \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043b\u0430\u0437\u0435\u0440\u043d\u043e\u0433\u043e \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u2013 \u043d\u0430 50 \u043c\u0414\u0436/\u0441\u043c \u043c\u0435\u043d\u044c\u0448\u0435\n2\n\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u044d\u0440\u0438\u0442\u0435\u043c\u043d\u043e\u0439 \u0434\u043e\u0437\u044b; \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0434\u043e\u0437\u0430 \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430\n50 \u043c\u0414\u0436/\u0441\u043c \u043a\u0430\u0436\u0434\u044b\u0435 \u0434\u0432\u0430 \u0441\u0435\u0430\u043d\u0441\u0430. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u0443\u0447\u0430\u0441\u0442\u043e\u043a \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f 2 \u0440\u0430\u0437\u0430 \u0432\n2\n\u043d\u0435\u0434\u0435\u043b\u044e, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 24 \u0441\u0435\u0430\u043d\u0441\u043e\u0432 [20-24].\n- \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u0413\u0410 \u2013 \u041f\u0423\u0412\u0410-\u0442\u0435\u0440\u0430\u043f\u0438\u044f (\u0421). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0441\u043e\u0440\u0430\u043b\u0435\u043d \u0438 \u0435\u0433\u043e\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u0432 \u0434\u043e\u0437\u0435 0,5 \u043c\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0437\u0430 2 \u0447\u0430\u0441\u0430 \u0434\u043e \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b. \u0414\u043e\u0437\u0430\n\u043e\u0431\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u2013 \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u043e\u0442 1 \u0414\u0436 \u043d\u0430 1\u0441\u043c \u0434\u043e 15 \u0414\u0436 \u043d\u0430 1\u0441\u043c [25-\n2 2\n35].\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043c\u043e\u0436\u043d\u043e\n\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0432 \u0432\u0438\u0434\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0444\u043e\u0440\u043c\u044b (\u0432\n\u043f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0432\u044b\u0431\u043e\u0440\u0430 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f). \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,\n\n\u0432\u044b\u0431\u043e\u0440 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0445 \u0413\u041a\u0421 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438 \u2013 \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043b\u0438\n\u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0439 \u0441\u0443\u0431\u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0438 \u0434\u0435\u0442\u0435\u0439. \u0422\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0413\u041a\u0421\n(\u043a\u0440\u0435\u043c\u044b, \u043c\u0430\u0437\u0438, \u043b\u043e\u0441\u044c\u043e\u043d\u044b) \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0439 \u0444\u043e\u0440\u043c\u044b \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438 \u0432\n\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u0430\u043c\u0438, \u043c\u0438\u043a\u0440\u043e\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u043c\u043e\u0434\u0443\u043b\u044f\u0442\u043e\u0440\u0430\u043c\u0438,\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043e\u0442 4 \u0434\u043e 8 \u043d\u0435\u0434\u0435\u043b\u044c. \u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\n\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0413\u041a\u0421 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u0430\u0437\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440\u044b, \u0434\u0438\u0442\u0440\u0430\u043d\u043e\u043b,\n\u0444\u0438\u0437\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f (\u041f\u0423\u0412\u0410) \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0413\u041a\u0421 (\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0438\u043b\u0438 \u043f\u0443\u043b\u044c\u0441-\n\u0442\u0435\u0440\u0430\u043f\u0438\u044f).\n\n\u041f\u0440\u0438 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0438 \u0440\u043e\u043b\u0438 \u0438\u043c\u043c\u0443\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0433\u043d\u0435\u0437\u0434\u043d\u043e\u0439 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u2013 \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d, \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442.\n\u041d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443 \u043b\u0438\u0446 \u0441 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439\n\u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0435\u0439, \u0441\u043e \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u043a \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u043c\u0443 \u0442\u0435\u0447\u0435\u043d\u0438\u044e \u0438\n\n\u043d\u0435\u043f\u043e\u0434\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 [32-41].\n\u041f\u0440\u0438 \u0441\u043a\u043b\u043e\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043a \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u0438 \u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043b\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438,\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430 \u0438\u043b\u0438 \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0430.\n\u0421\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c, \u0447\u0442\u043e \u0441\u0430\u043c\u044b\u043c \u043b\u0443\u0447\u0448\u0438\u043c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043e\u0434\u0438\u043d\u043e\u0447\u043d\u044b\u043c\n\n\u043e\u0447\u0430\u0433\u043e\u043c \u043e\u0431\u043b\u044b\u0441\u0435\u043d\u0438\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u0430\u043a\u0442\u0438\u043a\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f, \u0442.\u043a. 80% \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u043e\u0434\u0438\u043d\u043e\u0447\u043d\u044b\u043c\u0438 \u043f\u044f\u0442\u043d\u0430\u043c\u0438, \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\u0438 \u043c\u0435\u043d\u0435\u0435 \u0433\u043e\u0434\u0430, \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u044f \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\n\u0440\u0435\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u0435\u0442.\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430, \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0441\u043f\u043e\u0441\u043e\u0431 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0422\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0412\u0441\u0435 \u0444\u043e\u0440\u043c\u044b \u0433\u043d\u0435\u0437\u0434\u043d\u043e\u0439 \u043a\u0440\u0435\u043c, \u043c\u0430\u0437\u044c 0,5% \u0421 \u0421 \u0446\u0435\u043b\u044c\u044e\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438, \u0437\u0430 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e\n\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430,\n\u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u0430 \u0432\u0430\u043b\u0435\u0440\u0430\u0442 \u0412\u0441\u0435 \u0444\u043e\u0440\u043c\u044b \u0433\u043d\u0435\u0437\u0434\u043d\u043e\u0439 \u043a\u0440\u0435\u043c 0,1% \u0421 \u0441\u043d\u044f\u0442\u0438\u044f\n\u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438, \u0437\u0430 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439\n\u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u0430 \u0412\u0441\u0435 \u0444\u043e\u0440\u043c\u044b \u0433\u043d\u0435\u0437\u0434\u043d\u043e\u0439 0,05% \u043c\u0430\u0437\u044c 2 \u0440\u0430\u0437\u0430 \u0421\n\u0434\u0438\u043f\u0440\u043e\u043f\u0438\u043e\u043d\u0430\u0442 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438, \u0437\u0430 \u0432 \u0434\u0435\u043d\u044c\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439\n\u0413\u0438\u0434\u0440\u043e\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043d\u0430 \u0412\u0441\u0435 \u0444\u043e\u0440\u043c\u044b \u0433\u043d\u0435\u0437\u0434\u043d\u043e\u0439 \u043a\u0440\u0435\u043c 0,1%2 \u0440\u0430\u0437\u0430 \u0432 \u0412\n\u0431\u0443\u0442\u0438\u0440\u0430\u0442 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u0438, \u0437\u0430 \u0434\u0435\u043d\u044c\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439", "type": "Document"}}