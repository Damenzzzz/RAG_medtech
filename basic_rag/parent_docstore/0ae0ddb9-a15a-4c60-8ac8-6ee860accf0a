\u0430 \u0438 \u043f\u0440\u0430\u0432\u0443\u044e \u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u0443\u044e \u0436\u0438\u0432\u043e\u0442\u0435 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u043d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0432\u0430\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u0421\u0442\u0443\u043b \u0416\u0438\u0434\u043a\u0438\u0439 \u0431\u043e\u043b\u0435\u0435 3 \u0420\u0435\u0434\u043a\u043e \u041a\u0430\u0448\u0438\u0446\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439, \u041a\u0430\u0448\u0438\u0446\u0435\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439, \u041e\u0431\u0438\u043b\u044c\u043d\u044b\u0439, \u0416\u0438\u0434\u043a\u0438\u0439, \u0441\u043e \u0441\u043b\u0438\u0437\u044c\u044e,\n\u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438, \u0441\u043e \u0440\u0430\u0437\u0436\u0438\u0436\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u0436\u0438\u0434\u043a\u0438\u0439 \u043a\u0430\u043b\u043e\u0432\u044b\u0439, \u0431\u0435\u0437 \u0436\u0438\u0434\u043a\u0438\u0439, \u0447\u0430\u0441\u0442\u043e \u0441 \u0447\u0430\u0441\u0442\u044b\u0439, \u0436\u0438\u0434\u043a\u0438\u0439, \u0441 \u043a\u0440\u043e\u0432\u044c\u044e, \u0433\u043d\u043e\u0435\u043c,\n\u0441\u043b\u0438\u0437\u044c\u044e \u0438 \u043a\u0440\u043e\u0432\u044c\u044e \u0443\u0447\u0430\u0449\u0435\u043d\u043d\u044b\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u043a\u0440\u043e\u0432\u0438 \u043a\u0440\u043e\u0432\u044c\u044e (\u00ab\u043c\u044f\u0441\u043d\u044b\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f\n\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0441\u0435\u0439, \u0434\u043e 3-4 \u0440\u0430\u0437, \u043f\u043e\u043c\u043e\u0438\u00bb) \u043f\u043e\u0441\u043b\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f\n\u0447\u0430\u0449\u0435 \u0437\u0430\u043f\u043e\u0440 \u0441\u0442\u0443\u043b\u0430\n\u0411\u043e\u043b\u044c \u0432 \u0421\u0445\u0432\u0430\u0442\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f \u0411\u043e\u043b\u0438 \u0432\u043d\u0438\u0437\u0443 \u0436\u0438\u0432\u043e\u0442\u0430, \u0421\u0438\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f, \u0420\u0435\u0437\u043a\u0430\u044f, \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u0438\u043c\u0430\u044f, \u0421\u043b\u0430\u0431\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430, \u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u0435\u0432\u0430\n\u0436\u0438\u0432\u043e\u0442\u0435 \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0438\u043b\u0438 \u0440\u0430\u0437\u043b\u0438\u0442\u0430\u044f\n\u0438\u0440\u0440\u0430\u0434\u0438\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0432 \u043a\u0430\u0448\u043b\u0435. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f, \u0431\u0435\u0437\n\u043f\u043e\u044f\u0441\u043d\u0438\u0446\u0443 \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439\n\u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0434\u0438\u0430\u0440\u0435\u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\u041e\u0441\u043c\u043e\u0442\u0440 \u041c\u044f\u0433\u043a\u0438\u0439, \u0432\u0437\u0434\u0443\u0442 \u0411\u0440\u044e\u0448\u043d\u0430\u044f \u0441\u0442\u0435\u043d\u043a\u0430 \u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u0440\u0430\u0432\u043e\u0439 \u0412\u0437\u0434\u0443\u0442, \u0440\u0430\u0437\u043b\u0438\u0442\u0430\u044f \u0412\u0437\u0434\u0443\u0442, \u041c\u044f\u0433\u043a\u0438\u0439\n\u0436\u0438\u0432\u043e\u0442\u0430 \u0447\u0430\u0441\u0442\u043e \u0441\u043b\u0435\u0433\u043a\u0430 \u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c. \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439\n\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0430 \u0431\u0435\u0437 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435\u043c \u043c\u044b\u0448\u0446.\n\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0421\u0438\u043c\u043f\u0442\u043e\u043c \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430 \u0431\u0440\u044e\u0448\u0438\u043d\u044b (\u0429\u0435\u0442\u043a\u0438\u043d\u0430-\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0411\u043b\u044e\u043c\u0431\u0435\u0440\u0433\u0430)\n\u0431\u0440\u044e\u0448\u0438\u043d\u044b \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439\n\u0420\u0432\u043e\u0442\u0430 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u041d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430 \u0418\u043d\u043e\u0433\u0434\u0430, \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0427\u0430\u0441\u0442\u043e, \u0438\u043d\u043e\u0433\u0434\u0430 \u0441 \u041d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430 \u041d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430\n\u043c\u043d\u043e\u0433\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438, 1-2 \u0440\u0430\u0437\u0430 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u043a\u0440\u043e\u0432\u0438.\n\u0421\u043f\u0430\u0437\u043c \u0438 \u0421\u043f\u0430\u0437\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0430, \u041d\u0435 \u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b \u043f\u0440\u0438 \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u041d\u0435 \u043e\u0442\u043c\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u041f\u043b\u043e\u0442\u043d\u0430\u044f, \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u043d\u0430\u044f,\n\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430 \u043a\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0435 \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u0430\u044f\n\u044c\n\u0441\u0438\u0433\u043c\u043e\u0432\u0438\u0434\u043d\u043e\u0439\n\u043a\u0438\u0448\u043a\u0438\n\u042d\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u041a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439, \u041d\u043e\u0440\u043c\u0430 \u041d\u043e\u0440\u043c\u0430 \u041a\u043e\u043b\u044c\u0446\u0435\u0432\u0438\u0434\u043d\u044b\u0435 \u0420\u0435\u0437\u043a\u0438\u0439 \u043e\u0442\u0435\u043a, \u041e\u043f\u0443\u0445\u043e\u043b\u044c \u0441 \u043d\u0435\u043a\u0440\u043e\u0437\u043e\u043c,\n\u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u043e- \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0438, \u043d\u0435\u043a\u0440\u043e\u0437 \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0432\u043e\u0441\u0442\u044c, \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c,\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u043b\u0435\u0442 \u0444\u0438\u0431\u0440\u0438\u043d\u0430, \u043f\u0435\u0440\u0438\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u043c\n\u043a\u043e\u043b\u0438\u0442 \u044d\u0440\u043e\u0437\u0438\u0438, \u044f\u0437\u0432\u044b \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435\u043c\n\n\u041f\u0440\u0438\u043c\u0435\u0440\u044b \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430:\n\n\u041002.0. \u0421\u0430\u043b\u044c\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437, \u0433\u0430\u0441\u0442\u0440\u043e\u0438\u043d\u0442\u0435\u0441\u0442\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430, \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442,\n\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 (Salmonellae enteritidis \u0438\u0437 \u043a\u0430\u043b\u0430 \u043e\u0442 22.08.2013 \u0433.).\n\u041e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435: \u0418\u0422\u0428 II \u0441\u0442\u0435\u043f\u0435\u043d\u0438.\n\u041003.1 \u041e\u0441\u0442\u0440\u044b\u0439 \u0448\u0438\u0433\u0435\u043b\u043b\u0435\u0437, \u043a\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 (Shigella\n\nflexneri \u0438\u0437 \u043a\u0430\u043b\u0430 \u043e\u0442 22.08.2013 \u0433.).\n\n12. \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u042d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u2013 \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439,", "type": "Document"}}