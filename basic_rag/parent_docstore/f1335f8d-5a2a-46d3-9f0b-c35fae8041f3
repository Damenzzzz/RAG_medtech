42 \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u0432\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0435 10 \u043c\u0433/\u043a\u0433, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e\n\u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442 \u043d\u0430 \u0434\u043e\u0437\u0443 7,5 \u043c\u0433/\u043a\u0433,\n\u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u0432\u043e\u0434\u044f\u0442 \u043a\u0430\u0436\u0434\u044b\u0435 18-24\n\n\u0447\u0430\u0441\u0430.\u041f\u0440\u0438 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u043c\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0434\u043b\u0438\u0442\u0441\u044f 7-10 \u0434\u043d\u0435\u0439,\n\u043f\u0440\u0438 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u043c \u2013 3-7 \u0434\u043d\u0435\u0439.\n5. \u0413\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d \u0432/\u043c, \u0432/\u0432 \u0412/\u043c, \u0432/\u0432, 7 \u0434\u043d\u0435\u0439 \u0412 [6]\n\u0438\u043b\u0438 \u043c\u0435\u0441\u0442\u043d\u043e, \u0441\u0443\u0431\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u043e. \u0414\u043e\u0437\u0430\n\u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e.\n\u041f\u0440\u0438 \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438\n\u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0434\u043b\u044f\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0441 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439\n\u043f\u043e\u0447\u0435\u043a \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u0430\n\u043f\u0440\u0438 \u0432/\u0432 \u0438 \u0432/\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u2014 3\n\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u2014 2\u2013\n3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438; \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2014 \u0434\u043e 5 \u043c\u0433/\u043a\u0433\n(\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430) \u0432 3\u20134\n\u043f\u0440\u0438\u0435\u043c\u0430. \u0421\u0440\u0435\u0434\u043d\u044f\u044f\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2014 7\u2013\n10 \u0434\u043d\u0435\u0439. \u0412/\u0432 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 2\u20133 \u0434\u043d\u0435\u0439, \u0437\u0430\u0442\u0435\u043c \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442\n\u043d\u0430 \u0432/\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435. \u041f\u0440\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445\n\u043c\u043e\u0447\u0435\u0432\u044b\u0432\u043e\u0434\u044f\u0449\u0438\u0445 \u043f\u0443\u0442\u0435\u0439 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0438 \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435\n14 \u043b\u0435\u0442 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 0,8\u20131,2 \u043c\u0433/\u043a\u0433.\n\n\u0414\u0435\u0442\u044f\u043c \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\n\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f\n\u0434\u0435\u0442\u0435\u0439 \u0432\u0441\u0435\u0445 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u0432 \u2014 5 \u043c\u0433/\u043a\u0433.\n6. \u041c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0432/\u0432, per \u041d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 5\u201310 mg/kg 7-10 \u0434\u043d\u0435\u0439 \u0412 [6]\nos \u0432 2\u043f\u0440\u0438\u0451\u043c\u0430.\n\u0414\u0435\u0442\u0438 \u043e\u0442 1\u043c\u0435\u0441 \u0434\u043e 1\u0433\u043e\u0434\u0430 5\u201310 mg/kg \u0432\n2 \u043f\u0440\u0438\u0451\u043c\u0430.\n\u0414\u0435\u0442\u0438 \u043e\u0442 1 \u0433\u043e\u0434\u0430 \u0434\u043e 18\u043b\u0435\u0442 10 mg/kg\n(max. 600 mg) \u0432 2 \u043f\u0440\u0438\u0451\u043c\u0430.\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0435 \u041b\u0421 (\u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0438\u0441\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0437\u0430)\n1. \u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b \u0432/\u0432 \u041f\u0440\u0438 \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0444\u043b\u044e\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u0430 7-10 \u0434\u043d\u0435\u0439 \u0412 [6]\n\n\u0434\u0435\u0442\u044f\u043c \u043f\u0440\u0438 \u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043d\u043e\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438\n\u043a\u043e\u0436\u0438 \u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1 \u2013 3\n\u043c\u0433/\u043a\u0433\n11\n\n\u041f\u0440\u0438 \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0445 \u043c\u0438\u043a\u043e\u0437\u0430\u0445 \u0434\u043e\u0437\u0430\n\u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f \u0434\u043e 6 \u2013 12 \u043c\u0433/\u043a\u0433.\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n1. \u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d \u0432/\u0432 \u0412/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u043e \u0421 [6]\n10%. \u0448\u043e\u043a\u0435, \u0433\u0438\u043f\u043e\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\u0435\u043c\u0438\u0438, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u0438. \u0423 \u0434\u0435\u0442\u0435\u0439\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043d\u0435\n\n\u0431\u043e\u043b\u0435\u0435 3 \u043c\u043b/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n(\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c)\n2. \u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d \u0432/\u0432 \u0420\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e \u0421 [6]\n20%. 0.5-1 \u0433/\u043a\u0433. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0443 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445\n\u0433\u0440\u0443\u0434\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c)\n3. \u0424\u0443\u0440\u043e\u0441\u0435\u043c\u0438\u0434 \u0432/\u043c, \u0432/\u0432 \u0421\u0440\u0435\u0434\u043d\u044f\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u043f\u043e \u0412 [6]\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439\n\u0434\u043e 15 \u043b\u0435\u0442 - 0,5-1,5 \u043c\u0433/\u043a\u0433.\n\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043f\u0430\u0440\u044d\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f\n\n1. \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0432/\u0432 1,5-2,5 \u0433 \u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 \u043d\u0430 1 \u043a\u0433 \u0432\u0435\u0441\u0430 \u041f\u043e \u0421 [6]\n\u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 \u043c\u0430\u0441\u0441\u044b \u0432 \u0441\u0443\u0442\u043a\u0438, \u0438\u043b\u0438 15-25 \u043c\u043b \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u0434\u043b\u044f \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0410\u043c\u0438\u043d\u043e\u0432\u0435\u043d \u0438\u043d\u0444\u0430\u043d\u0442\u0430 10% \u043d\u0430\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d 1 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f\n\n2. \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0432/\u0432 \u0410\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442\u044b \u041f\u043e \u0421 [6]\n\u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n3. \u0416\u0438\u0440\u043e\u0432\u044b\u0435 \u0432/\u0432 \u041d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 (\u0434\u043e 28 \u0434\u043d\u0435\u0439): 2-3 \u0433 \u041f\u043e \u0421 [6]\n\u044d\u043c\u0443\u043b\u044c\u0441\u0438\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n(\u0434\u043e 4 \u0433) \u043b\u0438\u043f\u0438\u0434\u043e\u0432/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430/\u0441\u0443\u0442,\n\u0447\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 20-30 \u043c\u043b (\u0434\u043e 40\n\u043c\u043b)/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430/\u0441\u0443\u0442.\n\u0414\u0435\u0442\u0438 \u0441 29 \u0434\u043d\u0435\u0439 \u0434\u043e 5 \u043b\u0435\u0442\n\u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e: 1-3 \u0433 \u043b\u0438\u043f\u0438\u0434\u043e\u0432/\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430/\u0441\u0443\u0442, \u0447\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442\n10-30 \u043c\u043b/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430/\u0441\u0443\u0442.\n\u0413\u0435\u043c\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438\n1. \u042d\u0442\u0430\u043c\u0437\u0438\u043b\u0430\u0442 \u0432/\u0432 \u041e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u0430\u044f \u0434\u043e\u0437\u0430 12,5 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u041f\u043e \u0421 [6]\n\u0442\u0435\u043b\u0430 (0,1 \u043c\u043b = 12,5 \u043c\u0433). \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u043a\u0430\u0436\u0434\u044b\u0435 \u0431 \u0447\u0430\u0441\u043e\u0432\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 4 \u0441\u0443\u0442\u043e\u043a \u0434\u043e \u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0439\n\u0434\u043e\u0437\u044b 200 \u043c\u0433/\u043a\u0433.\n\n2. \u0410\u043f\u0440\u043e\u0442\u0438\u043d\u0438\u043d \u0432/\u0432 \u0421 [6]\n\n\u0424\u0435\u0440\u043c\u0435\u043d\u0442\u044b\n\n12\n\n1. \u041c\u0438\u043a\u0440\u043e\u043a\u0430\u043f\u0441\u0443\u043b \u044d\u043d\u0442\u0435\u0440\u0430\u043b\u044c (\u0441 \u0446\u0435\u043b\u044c\u044e \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u041f\u043e\n\u044f\u0440\u043d\u044b\u0435 \u043d\u043e \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0447\u0435\u0441 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0435\u043c\u0438\u0438\n\u043a\u0438\u0435 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b \u0438/\u0438\u043b\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0443\u0440\u0438\u0438) \u043f\u0440\u0438 \u043f\u043e\u043b\u043d\u043e\u0439\n\u0432\u043d\u0435\u0448\u043d\u0435\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u2013 400 000 \u0415\u0414 \u0432\n\u0441\u0443\u0442\u043a\u0438: \u0443 \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 3 \u0434\u043e 12 \u043b\u0435\u0442\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 15000 \u0415\u0414\n\u043b\u0438\u043f\u0430\u0437\u044b \u043d\u0430 1 \u043a\u0433 \u0432\u0435\u0441\u0430; \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\n\u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 15000-20000 \u0415\u0414\n\u043b\u0438\u043f\u0430\u0437\u044b \u043d\u0430 1 \u043a\u0433 \u0432\u0435\u0441\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430: \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0434\u043e 1,5 \u043b\u0435\u0442\n\u2013 50 \u0442\u044b\u0441. \u0415\u0414; \u0441\u0442\u0430\u0440\u0448\u0435 1,5 \u043b\u0435\u0442 \u2013 100\n\u0442\u044b\u0441.\u0415\u0414\n2. \u0410\u043f\u0440\u043e\u0442\u0438\u043d\u0438\u043d \u0432/\u0432 \u041f\u043e\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:\n\u2022 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438;\n\u2022 \u043c\u0443\u043a\u043e\u043b\u0438\u0442\u0438\u043a\u0438, \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u043f\u0440\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438;\n\n\u2022 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043f\u0440\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438;\n\u2022 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430 \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0430\u043d\u0435\u043c\u0438\u0438\n\n5.4 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e:\n\n\u041c\u0435\u0442\u043e\u0434 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043b\u0438\u0447\u0430\u0442\u044c\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u043e\u0433\u043e,\n\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u043a\u0438\u0441\u0442\u0430 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0439 \u0438\u043b\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u043d\u0430\n\u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u0435; \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0442\u043b\u0438\u0447\u0438\u044f \u0432 \u0442\u0430\u043a\u0442\u0438\u043a\u0435 \u0438\n\u0442\u0435\u0445\u043d\u0438\u043a\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u043f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u043d\u044b\u0445 \u043a\u0438\u0441\u0442\u0430\u0445, \u0441\u043e\u0447\u0435\u0442\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\n\n\u043d\u0430\u0440\u0443\u0436\u043d\u044b\u043c\u0438 \u0441\u0432\u0438\u0449\u0430\u043c\u0438 \u0438 \u0431\u0435\u0437 \u043d\u0438\u0445.\n\u0412 \u043e\u0441\u043d\u043e\u0432\u0443 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0442\u043d\u0435\u0441\u0442\u0438 \u0447\u0435\u0442\u044b\u0440\u0435\n\u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0438:\n1) \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0435 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 (\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0438\u043b\u0438 \u043f\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0435) \u2013\n\n\u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0438\u0437 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u043e\u0431\u043d\u043e\u0433\u043e \u0438 \u043d\u0430\u0438\u043c\u0435\u043d\u0435\u0435\n\u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0432\u0435\u0440\u0445\u043d\u0435\u0441\u0440\u0435\u0434\u0438\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0430, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0435\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c\n\u0440\u0435\u0432\u0438\u0437\u0438\u044e \u0432\u0441\u0435\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u0436\u0435\u043b\u0435\u0437\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445 \u0442\u043a\u0430\u043d\u0435\u0439;\n2) \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 (\u043c\u0430\u0440\u0441\u0443\u043f\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f) \u2013 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432\n\u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0441\u043e\u0443\u0441\u0442\u044c\u044f \u043c\u0435\u0436\u0434\u0443 \u043a\u0438\u0441\u0442\u043e\u0439 \u0438 \u043f\u0438\u0449\u0435\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0442\u0440\u0430\u043a\u0442\u043e\u043c \u2013 \u0436\u0435\u043b\u0443\u0434\u043a\u043e\u043c,\n\n\u0442\u043e\u0449\u0435\u0439 \u043a\u0438\u0448\u043a\u043e\u0439 \u0438\u043b\u0438 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043f\u0435\u0440\u0441\u0442\u043d\u043e\u0439 \u043a\u0438\u0448\u043a\u043e\u0439 (\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f\n\u043a\u0438\u0441\u0442\u044b \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b). \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f -\n\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0423-\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0439 \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043f\u0435\u0442\u043b\u0435 \u043f\u043e \u0420\u0443; \u0442\u0430\u043a \u0436\u0435\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u044d\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u0435\u0442\u043e\u0434 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f;\n\n3) \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043a\u0438\u0441\u0442\u044b;\n4) \u043f\u043e\u043b\u043d\u043e\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u043a\u0438\u0441\u0442\u044b (\u044d\u043a\u0441\u0442\u0438\u0440\u043f\u0430\u0446\u0438\u044f)\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\n13\n\n\u2022 \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e \u2013 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u0438\u0441\u0442\u044b\n\u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b;", "type": "Document"}}