u043c\u043c\u044b\n\n\u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044c\n\u041e\u0446\u0435\u043d\u043a\u0430. \u0423\u0423\u043a\u0430\u0437\u0430\u0442\u044c \u043e\u0431\u0449\u0443\u044e \u043e\u0446\u0435\u043d\u043a\u0443, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b, \u043d\u0435 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0440\u0430\u043d\u0435\u0435 \u0438\n\u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u0432\u0430\u0436\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0437\u0430 \u0440\u043e\u0434\u043e\u0432\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u041f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u043c\u044b\u0435 \u043c\u0435\u0440\u044b. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440:\n\u0421\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435;\n\u043f\u043b\u0430\u043d \u2b1b \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u0441\u0442\u044b;\n\u2b1b \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u043e\u0434\u043e\u0432\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u043a\u0441\u0438\u0442\u043e\u0446\u0438\u043d\u043e\u043c;\n\u2b1b \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0437\u0440\u044b\u0432 \u043f\u043b\u043e\u0434\u043d\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a;\n\u2b1b \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u043a\u0443\u0443\u043c \u044d\u043a\u0441\u0442\u0440\u0430\u043a\u0442\u043e\u0440\u0430 \u0438\u043b\u0438 \u0430\u043a\u0443\u0448\u0435\u0440\u0441\u043a\u0438\u0445 \u0449\u0438\u043f\u0446\u043e\u0432;\n\u2b1b \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a\u0435\u0441\u0430\u0440\u0435\u0432\u0430 \u0441\u0435\u0447\u0435\u043d\u0438\u044f.\n\u041a\u0440\u0430\u0439\u043d\u0435 \u0432\u0430\u0436\u043d\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u0439, \u0430 \u0442\u0430\u043a\u0436\u0435\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f.\n\u041f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u044d\u0442\u0430\u043f\u0430 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0446\u0435\u043d\u043a\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0438 \u043f\u043b\u043e\u0434\u0430 \u0443\u043a\u0430\u0437\u0430\u0442\u044c\n\u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u043c\u044b\u0435 \u043c\u0435\u0440\u044b \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439.\n\n\u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u043d\u0435\u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0445 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\n\n\u0420\u0430\u0437\u0434\u0435\u043b 1. \u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0440\u043e\u0434\u043e\u0432\u043e\u0439\n\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0438\n\u0420\u0430\u0437\u0440\u044b\u0432 \u043f\u043b\u043e\u0434\u043d\u044b\u0445\n\u041d = \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\n\u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a (\u0434\u0430\u0442\u0430; \u0432\u0440\u0435\u043c\u044f)\n\u0420\u0430\u0437\u0434\u0435\u043b 2. \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u0443\u0445\u043e\u0434\n\u0414\u0430\n\u0421\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0435 \u043b\u0438\u0446\u043e\n\u041d\u0435\u0442\n\u041e = \u043e\u0442\u043a\u0430\u0437 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u044b\n\u0414\u0430\n\n\u041d\u0435\u0442\n\u041e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u0435\n\u041e = \u043e\u0442\u043a\u0430\u0437 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u044b \u043e\u0442 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043b\u0438\n\u043d\u0435\u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f\n\u0414\u0430\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\u041d\u0435\u0442\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438\n\u041e = \u043e\u0442\u043a\u0430\u0437 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u044b\n\u0421\u043f\u0438\u043d\u0430 = \u043d\u0430 \u0441\u043f\u0438\u043d\u0435\n\u041f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\nM = \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u0430 (\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f)\n\u0420\u0430\u0437\u0434\u0435\u043b 3. \u041f\u043b\u043e\u0434\n\u041d\u0435\u0442\n\u0420\u0430\u043d = \u0440\u0430\u043d\u043d\u0438\u0435\n\u0414\u0435\u0446\u0435\u043b\u0435\u0440\u0430\u0446\u0438\u0438 \u0427\u0421\u0421\n\u041f\u043e\u0437 = \u043f\u043e\u0437\u0434\u043d\u0438\u0435\n\u0412\u0430\u0440 = \u0432\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u044b\u0435\n\u0426 = \u0446\u0435\u043b\u044b\u0435 \u043f\u043b\u043e\u0434\u043d\u044b\u0435 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438\n\nC = \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0440\u044b\u0432 \u043f\u043b\u043e\u0434\u043d\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a, \u0430\u043c\u043d\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u0441\u0432\u0435\u0442\u043b\u0430\u044f\n\u0410\u043c\u043d\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\nM = \u0430\u043c\u043d\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u043e\u043a\u0440\u0430\u0448\u0435\u043d\u0430 \u043c\u0435\u043a\u043e\u043d\u0438\u0435\u043c: \u0443\u043a\u0430\u0437\u0430\u0442\u044c\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e +, ++ \u0438\u043b\u0438 +++ \u0434\u043b\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439, \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0438\n\u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u044f\n\u041a = \u043f\u0440\u0438\u043c\u0435\u0441\u044c \u043a\u0440\u043e\u0432\u0438 \u0432 \u0430\u043c\u043d\u0438\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438\nA = \u043b\u044e\u0431\u0430\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u043c \u0432\u0438\u0434\u0435 \u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u043e\u0433\u043e\n\u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u044f\n\u0412\u043d\u0443\u0442\u0440\u0438\u0443\u0442\u0440\u043e\u0431\u043d\u043e\u0435\nP = \u043b\u044e\u0431\u0430\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u0440\u0438 \u0437\u0430\u0434\u043d\u0435\u043c \u0432\u0438\u0434\u0435 \u0437\u0430\u0442\u044b\u043b\u043e\u0447\u043d\u043e\u0433\u043e\n\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043b\u043e\u0434\u0430\n\u043f\u0440\u0435\u0434\u043b\u0435\u0436\u0430\u043d\u0438\u044f\nT = \u043b\u044e\u0431\u0430\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0447\u043d\u043e\u043c \u0441\u0442\u043e\u044f\u043d\u0438\u0438\n\u0441\u0442\u0440\u0435\u043b\u043e\u0432\u0438\u0434\u043d\u043e\u0433\u043e \u0448\u0432\u0430\n0 (\u0431\u0435\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438)\n\n+\n\u0420\u043e\u0434\u043e\u0432\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c\n++\n+++ (\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439)\n0 (\u0431\u0435\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438)\n+ (\u043a\u043e\u0441\u0442\u0438 \u0441\u0431\u043b\u0438\u0436\u0435\u043d\u044b \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0448\u0432\u043e\u0432)\n\n++ (\u0437\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u043e\u0441\u0442\u0435\u0439 \u043f\u043e \u0448\u0432\u0430\u043c \u0441 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f \u0433\u043e\u043b\u043e\u0432\u043a\u0438\n\u0440\u0435\u043f\u043e\u0437\u0438\u0446\u0438\u0438)\n+++ (\u0437\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u043e\u0441\u0442\u0435\u0439 \u043f\u043e \u0448\u0432\u0430\u043c \u0431\u0435\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438\n\u0440\u0435\u043f\u043e\u0437\u0438\u0446\u0438\u0438)\n\u0420\u0430\u0437\u0434\u0435\u043b 4. \u0420\u043e\u0436\u0435\u043d\u0438\u0446\u0430\n\n\u0411 \u2013 (\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u0438)\n\u0411 \u0441\u043b\u0435\u0434 (\u0441\u043b\u0435\u0434\u043e\u0432\u044b\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0431\u0435\u043b\u043a\u0430)\n\u041c\u043e\u0447\u0430\n\u0411 1+\n\u0411 2+\n\u0411 3+\n\nA \u2013 (\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u0446\u0435\u0442\u043e\u043d\u0443\u0440\u0438\u0438)\nA 1+\n\u0410\u0446\u0435\u0442\u043e\u043d\nA 2+\nA 3+\nA 4+\n\n\u0420\u0430\u0437\u0434\u0435\u043b 5. \u0425\u043e\u0434 \u0440\u043e\u0434\u043e\u0432\n\u041d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u043e\n\n\u0420\u0430\u0437\u0434\u0435\u043b 6. \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0