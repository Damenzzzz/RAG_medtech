f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0432\u0435\u043d;\n4\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0430 \u0441 \u0446\u0435\u043b\u044c\u044e \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439.\n\n12.6 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u041f\u041c\u0420:\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u041f\u041c\u0420\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a \u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u041f\u041c\u0420 \u041e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439\n\u043c\u0435\u0433\u0430\u0443\u0440\u0435\u0442\u0435\u0440\n\n\u041d\u0430\u0447\u0430\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0421 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0421 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u043d\u0430\u0447\u0430\u043b\u043e\n\u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435\n\u041e\u0442\u0435\u043a\u0438 \u041d\u0435\u0442 \u0418\u043d\u043e\u0433\u0434\u0430, \u043f\u0440\u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0438\n\n\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438\n\u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0421 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0421 \u0440\u043e\u0436