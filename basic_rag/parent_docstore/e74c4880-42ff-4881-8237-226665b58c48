d\u043e\u0441\u0442\u0438\u043a\u0443 \u043c\u0435\u0436\u0434\u0443 \u0411\u0428 \u0438 \u0421\u0428 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0420\u0410, \u0421\u0421\u0414, \u0421\u041a\u0412,\n\u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c, \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u043c \u0431\u0438\u043b\u0438\u0430\u0440\u043d\u044b\u043c \u0446\u0438\u0440\u0440\u043e\u0437\u043e\u043c \u043f\u0435\u0447\u0435\u043d\u0438,\n\u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u043c \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u043c. \u041f\u043e\u043c\u0438\u043c\u043e \u0411\u0428 \u0441\u0443\u0445\u043e\u0441\u0442\u044c \u0433\u043b\u0430\u0437 \u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c\n\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043c \u043c\u043d\u043e\u0433\u0438\u0445 \u043f\u0440\u0438\u0447\u0438\u043d.\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0420\u0435\u0432\u043c\u0430\u0442\u043e\u0438\u0434\u043d\u044b\u0439 \u0430\u0440\u0442\u0440\u0438\u0442 \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0420\u0424, \u0410\u0426\u0426\u041f, \u0421\u0420\u0411, \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c,\n\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043d\u0435\u0441\u0442\u043e\u0439\u043a\u0438\u0439. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u043a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u043a\u0438\u0441\u0442\u0435\u0439 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u043d\u043e\u0441\u0438\u0442\n\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0441\u0442\u043e\u0439\u043a\u0438\u0439,\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440, \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\n\n\u044d\u0440\u043e\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u0430\u0440\u0442\u0440\u0438\u0442\u0430.\n\u0410\u0426\u0426\u041f \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u044b\u0439.\n\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u043d\u0430\u044f \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f\n\u0432\u043e\u043b\u0447\u0430\u043d\u043a\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u0436\u0438, \u0434\u0432\u0443\u0441\u043f\u0438\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0414\u041d\u041a, \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0441\u0442\u044c\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0420\u0435\u0439\u043d\u043e, \u0410\u043d\u0442\u0438-Sm, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u041d\u0430\u043b\u0438\u0447\u0438\u0435\n\u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u0430\u044f \u0430\u043d\u0442\u0438\u0444\u043e\u0441\u0444\u043e\u043b\u0438\u043f\u0438\u0434\u043d\u044b\u0435 \u0410\u0424\u0421, \u0431\u044b\u0441\u0442\u0440\u044b\u0439\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f, \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430, \u0410\u041d\u0424, \u0420\u0424 \u0440\u0435\u0433\u0440\u0435\u0441\u0441 \u0441\u0443\u0445\u043e\u0433\u043e\n\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u043d\u0430 \u0444\u043e\u043d\u0435\n\u043a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0413\u041a\u0421\n\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0414\u0438\u0441\u043a\u043e\u0438\u0434\u043d\u0430\u044f \u044d\u0440\u0438\u0442\u0435\u043c\u044b\n\u043d\u0430 \u043b\u0438\u0446\u0435, \u0433\u0440\u0443\u0434\u0438 \u0438\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u0445, \u044d\u043d\u0430\u043d\u0442\u0435\u043c\u0430\n\u043d\u0430 \u0442\u0432\u0435\u0440\u0434\u043e\u043c \u043d\u0435\u0431\u0435\n\u041d\u0435\u044d\u0440\u043e\u0437\u0438\u0432\u043d\u044b\u0439 \u0430\u0440\u0442\u0440\u0438\u0442.\n\u041f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u043e\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\u043c \u043a\n\n\u0434\u0432\u0443\u0441\u043f\u0438\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0414\u041d\u041a,\n\u0410\u043d\u0442\u0438-Sm,\n\u0430\u043d\u0442\u0438\u0444\u043e\u0441\u0444\u043e\u043b\u0438\u043f\u0438\u0434\u043d\u044b\u043c\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\u043c\n\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0410\u043d\u0442\u0438\u0446\u0435\u043d\u0442\u0440\u043e\u043c\u0435\u0440\u043d\u044b\u0435 \u0422\u0438\u043f\u0438\u0447\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0441\u043a\u043b\u0435\u0440\u043e\u0434\u0435\u0440\u043c\u0438\u044f \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0420\u0435\u0439\u043d\u043e, \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 (\u0410\u0426\u0410), \u043a\u043e\u0436\u0438 \u0438 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e\u0439\n\u043f\u043e\u043b\u0438\u0441\u0435\u0440\u043e\u0437\u0438\u0442, \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a Scl-70, \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0438\n\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0410\u041d\u0424, \u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043a\u043e\u0436\u043d\u043e- (\u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u0435, \u0430\u0442\u0440\u043e\u0444\u0438\u044f,\n\u043a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u043b\u043e\u0441\u043a\u0443\u0442\u0430 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438),\n\u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432\n(\u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\n\u0444\u0438\u0431\u0440\u043e\u0437\u043d\u044b\u0445\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439), \u0416\u041a\u0422.\n\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 (\u043e\u0441\u0442\u0435\u043e\u043b\u0438\u0437,\n\n\u0440\u0435\u0437\u043e\u0440\u0431\u0446\u0438\u044f \u043a\u043e\u043d\u0446\u0435\u0432\u044b\u0445\n\u0444\u0430\u043b\u0430\u043d\u0433), \u043a\u0430\u043b\u044c\u0446\u0438\u043d\u043e\u0437\n\u043c\u044f\u0433\u043a\u0438\u0445 \u0442\u043a\u0430\u043d\u0435\u0439,\n\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0410\u0426\u0410,\n\u0430\u043d\u0442\u0438- Scl-70, \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n\u0431\u0438\u043e\u043f\u0441\u0438\u0438 \u043a\u043e\u0436\u043d\u043e-\n\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u043b\u043e\u0441\u043a\u0443\u0442\u0430\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0435\u043d \u0434\u043b\u044f \u0421\u0421\u0414\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0431\u0438\u043b\u0438\u0430\u0440\u043d\u044b\u0439 \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0410\u043d\u0442\u0438\u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0430\u043b\u044c\u043d \u041a\u043b\u0438\u043d\u0438\u043a\u0430 \u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u043e\u0439\n\u0446\u0438\u0440\u0440\u043e\u0437 \u043f\u0435\u0447\u0435\u043d\u0438, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438, \u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430, \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438.\n\u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442 \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0421\u0443\u0445\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\n\u043a\u043e\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b \u043c\u0430\u0440\u043a\u0435\u0440\u044b \u043d\u0435\u0441\u0442\u043e\u0439\u043a\u0438\u0439.", "type": "Document"}}