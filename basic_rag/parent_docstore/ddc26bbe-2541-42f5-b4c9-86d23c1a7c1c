{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_69cc03736030", "title": "\u0417\u041b\u041e\u041a\u0410\u0427\u0415\u0421\u0422\u0412\u0415\u041d\u041d\u042b\u0415 \u041d\u041e\u0412\u041e\u041e\u0411\u0420\u0410\u0417\u041e\u0412\u0410\u041d\u0418\u042f \u0413\u041b\u0410\u0417\u041d\u0418\u0426\u042b", "source_file": "2025_\u0417\u041b\u041e\u041a\u0410\u0427\u0415\u0421\u0422\u0412\u0415\u041d\u041d\u042b\u0415_\u041d\u041e\u0412\u041e\u041e\u0411\u0420\u0410\u0417\u041e\u0412\u0410\u041d\u0418\u042f_\u0413\u041b\u0410\u0417\u041d\u0418\u0426\u042b_696c886d84.pdf", "icd_codes": "C69.5, C69.6, C69.8", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0417\u041b\u041e\u041a\u0410\u0427\u0415\u0421\u0422\u0412\u0415\u041d\u041d\u042b\u0415 \u041d\u041e\u0412\u041e\u041e\u0411\u0420\u0410\u0417\u041e\u0412\u0410\u041d\u0418\u042f \u0413\u041b\u0410\u0417\u041d\u0418\u0426\u042b.pdf"}, "page_content": "\u0420\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u043e\u0441\u0442\u043d\u044b\u0445 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u0447\u0435\u0442\u043a\u0438\u043c\u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438,\n\u0448\u0432\u043e\u0432, \u0447\u0430\u0449\u0435 \u0432\u0435\u0440\u0445\u043d\u0435\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u044e\u0449\u0435\u0435\u0441\u044f \u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0447\u0430\u0441\u0442\u0438\n\u043a\u0432\u0430\u0434\u0440\u0430\u043d\u0442 \u043e\u0440\u0431\u0438\u0442\u044b. \u0427\u0430\u0449\u0435 \u043d\u0435 \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b, \u0447\u0430\u0449\u0435 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043b\u043e\u0431\u043d\u043e-\n\u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 \u044d\u043a\u0437\u043e\u0444\u0442\u0430\u043b\u044c\u043c\u0430. \u0441\u043a\u0443\u043b\u043e\u0432\u043e\u0433\u043e \u0448\u0432\u0430, \u043d\u0435 \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u0442\n\u0411\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e \u0432\u0435\u043a\u0430 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442. \u0418\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435 \u0438 \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u0438\u0435\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u0440\u0430\u044f \u043e\u0440\u0431\u0438\u0442\u044b \u0432 \u0437\u043e\u043d\u0435\n\u043a\u0438\u0441\u0442\u044b. \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043a\u0438\u0441\u0442\u044b. \u041f\u0440\u0438\n\u0440\u0430\u0437\u043d\u043e\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0435\u0439 \u2013 \u043a\u043e\u0442\u043e\u043c\u043a\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u043a\u043e\u0442\u043e\u043c\u043a\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u043a\u0438\u0441\u0442\u0435 \u043e\u0440\u0431\u0438\u0442\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430\n\u0434\u0435\u0440\u043c\u043e\u0438\u0434\u043d\u0430\u044f \u043a\u0438\u0441\u0442\u0430 \u043e\u0440\u0431\u0438\u0442\u044b \u043c\u043e\u0436\u0435\u0442 \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0430\u0445, \u0432 \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0435 \u0437\u0430\n\u0432\u044b\u0437\u0432\u0430\u0442\u044c \u044d\u043a\u0437\u043e\u0444\u0442\u0430\u043b\u044c\u043c \u0441\u043e \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u043c. \u0441\u043a\u0443\u043b\u043e\u0432\u044b\u043c \u043e\u0442\u0440\u043e\u0441\u0442\u043a\u043e\u043c \u2013 \u043e\u0432\u0430\u043b\u044c\u043d\u044b\u0439\n\u043a\u043e\u0441\u0442\u043d\u044b\u0439 \u0434\u0435\u0444\u0435\u043a\u0442.\n\u041f\u0440\u0438 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043e\u043f\u0443\u0445\u043e\u043b\u0438\n\u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u2013 \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c,\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u044e\u0449\u0430\u044f\u0441\u044f \u0432 \u0432\u0435\u0440\u0445\u043d\u0435-\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u043c\n\u043a\u0432\u0430\u0434\u0440\u0430\u043d\u0442\u0435 \u043e\u0440\u0431\u0438\u0442\u044b \u0432\u043d\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e\n\u043a\u043e\u043d\u0443\u0441\u0430.\n\n\u041f\u043b\u0435\u043e\u043c\u043e\u0440\u0444\u043d\u0430\u044f \u0430\u0434\u0435\u043d\u043e\u043c\u0430 \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u0430\u044f \u041a\u0422, \u041c\u0420\u0422 \u043e\u0440\u0431\u0438\u0442, \u043f\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u041c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439\n\u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c \u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043e\u0440\u0431\u0438\u0442\u044b \u0441 \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u043f\u0442\u043e\u0437. \u0421\u043c\u0435\u0449\u0435\u043d\u0438\u0435\n\u0436\u0435\u043b\u0435\u0437\u044b.2% \u0432\u0441\u0435\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0433\u043b\u0430\u0437\u043d\u043e\u0433\u043e \u044f\u0431\u043b\u043e\u043a\u0430 \u043a\u043d\u0438\u0437\u0443 \u0438 \u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u043e.\n9\n\n\u043e\u0440\u0431\u0438\u0442\u044b. 50% \u0432\u0441\u0435\u0445 \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u0443\u043d\u043a\u0442\u0430\u0442\u0430. \u0423\u0417\u0418 \u2013 \u0441\u0435\u043c\u0438\u043e\u0442\u0438\u043a\u0430:\n\u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b. \u0411\u043e\u043b\u0435\u0435 95%\u0432\u0441\u0435\u0445 \u041b\u0443\u0447\u0435\u0432\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430: \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0410-\u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435-\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430\n\u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c \u2013 \u043e\u0431\u044a\u0435\u043c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430\u044f, \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043e\u0442 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0434\u043e\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0439 \u043e\u0440\u0431\u0438\u0442\u044b. \u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b, \u0432\u044b\u0441\u043e\u043a\u043e\u0439.\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u0435\u0435 \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u043c \u0412-\u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u2013 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u0441 \u0440\u0435\u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0433\u043b\u0430\u0434\u043a\u0438\u043c\u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438, \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u043e\n\u043f\u0440\u0438\u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u043a\u043e\u0441\u0442\u043d\u044b\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440. \u043f\u0441\u0435\u0432\u0434\u043e\u043a\u0430\u043f\u0441\u0443\u043b\u043e\u0439, \u043d\u0435\u044d\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435, \u043c\u043e\u0436\u0435\u0442\n\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f: \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0432\u0435\u0440\u0445\u043d\u0438\u0439 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043a\u0438\u0441\u0442\u043e\u0437\u043d\u044b\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f.\n\u044d\u043a\u0441\u0442\u0440\u0430\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0433\u043c\u0435\u043d\u0442 \u043e\u0440\u0431\u0438\u0442\u044b, \u041a\u0422-\u0441\u0435\u043c\u0438\u043e\u0442\u0438\u043a\u0430: \u042d\u043a\u0441\u043a\u0430\u0432\u0430\u0446\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u044b\u0445\n\u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u043e\u043f\u0443\u0445\u043e\u043b\u044c \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440, \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u0441\u043b\u0435\u0437\u043d\u0443\u044e \u044f\u043c\u043a\u0443\n\u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432 \u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u043e\u043b\u0435 (2/3\u0441\u043b\u0443\u0447\u0430\u0435\u0432). \u0422\u043e\u0447\u0435\u0447\u043d\u044b\u0435 \u043e\u0431\u044b\u0437\u0432\u0435\u0441\u0442\u0432\u043b\u0435\u043d\u0438\u044f\n\u0441\u043b\u0435\u0437\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b. \u0432 \u0442\u043e\u043b\u0449\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 (1/3 \u0441\u043b\u0443\u0447\u0430\u0435\u0432)\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430\n\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438\n\u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u041b\u0438\u043c\u0444\u043e\u043f\u0440\u043e\u043b\u0438\u0444\u0435\u0440\u0430- \u041a \u043d\u0438\u043c \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a\u0430\u043a \u041a\u0422, \u041c\u0420\u0422 \u043e\u0440\u0431\u0438\u0442, \u0423\u0417\u0418 \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u043e\u0432 \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435:\n\n\u0442\u0438\u0432\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f: \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435, \u0442\u0430\u043a \u0438 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u0437\u043e\u043d. \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u043c\n\u043b\u0438\u043c\u0444\u043e\u0438\u0434\u043d\u0430\u044f \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f. \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438: \u041b\u0414\u0413, \u0449\u0435\u043b\u043e\u0447\u043d\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u0435 \u043e\u0440\u0431\u0438\u0442\u044b. \u0412 50% \u0441\u043b\u0443\u0447\u0430\u044f\u0445\n\u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f, \u041b\u0438\u043c\u0444\u043e\u0438\u0434\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f(10-40%): \u0444\u043e\u0441\u0444\u043e\u0442\u0430\u0437\u0430. \u0426\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0433\u043b\u0430\u0437\u043d\u043e\u0433\u043e \u044f\u0431\u043b\u043e\u043a\u0430\n\u043d\u0435\u0445\u043e\u0434\u0436\u043a\u0438\u043d\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0443\u043d\u043a\u0442\u0430\u0442\u0430 \u043d\u0435 \u043a\u043d\u0438\u0437\u0443. \u041f\u0440\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u044b\n\u043b\u0438\u043c\u0444\u043e\u043c\u0430. \u0434\u043e\u0431\u0440\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u043b\u0438\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f, \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0432\u043d\u043e, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043e\u043f\u0443\u0445\u043e\u043b\u044c \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438\n\u0430\u0442\u0438\u043f\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f. \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043e\u0441\u043c\u043e\u0442\u0440\u0435.\n\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0439 \u0418\u0413\u0425. \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u043e\u0436\u0438 \u043d\u0435\u0442\u0438\u043f\u0438\u0447\u043d\u043e (\u0435\u0433\u043e\n\u043b\u0438\u043c\u0444\u043e\u043c\u043e\u0439 \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e \u0434\u043b\u044f \u0422 - \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0445\n\u043b\u0438\u043c\u0444\u043e\u043c\u0430, \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0449\u0430\u044f\u0441\u044f \u0438\u0437 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043b\u0438\u043c\u0444\u043e\u043c \u0438 \u043b\u0435\u0439\u043a\u043e\u0437\u043e\u0432. \u041e\u043a\u043e\u043b\u043e 50%\n\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0441\u043e \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043b\u0438\u043c\u0444\u043e\u043f\u0440\u043e\u043b\u0438\u0444\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439\n\u043e\u0431\u043e\u043b\u043e\u0447\u043a\u043e\u0439 \u043b\u0438\u043c\u0444\u043e\u0438\u0434\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0442 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0443\u044e\n(MALT); \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u0430\u044f \u043d\u0435\u0445\u043e\u0434\u0436\u043a\u0438\u043d\u0441\u043a\u0443\u044e \u043b\u0438\u043c\u0444\u043e\u043c\u0443. \u041d\u0435\u0440\u0435\u0434\u043a\u043e\n\u043a\u0440\u0443\u043f\u043d\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f \u043b\u0438\u043c\u0444\u043e\u043c\u0430 \u0438\u0437 \u0412- \u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442\u0441\u044f \u0441 \u041d\u0425\u041b \u0434\u0440\u0443\u0433\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438.\n\u043a\u043b\u0435\u0442\u043e\u043a, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439\n\u043b\u0438\u043c\u0444\u043e\u043f\u0440\u043e\u043b\u0438\u0444\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441;\n\u043f\u0440\u043e\u0447\u0438\u0435: \u043b\u0438\u043c\u0444\u043e\u043c\u0430 \u0411\u0443\u0440\u043a\u0438\u0442\u0442\u0430, \u0422-\n\n\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f \u043b\u0438\u043c\u0444\u043e\u043c\u0430. \u041b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0432\n\u043f\u0435\u0440\u0435\u0434\u043d\u0435\u043c \u044d\u043a\u0441\u0442\u0440\u0430\u043a\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u043e\u0442\u0434\u0435\u043b\u0435\n10\n\n\u043e\u0440\u0431\u0438\u0442\u044b; \u0446\u0435\u043d\u0442\u0440 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\n\u043f\u0440\u043e\u0435\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432 \u0432\n\u0432\u0435\u0440\u0445\u043d\u0435\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0432\u0430\u0434\u0440\u0430\u043d\u0442, \u0441\u043e\n\u0441\u0442\u0435\u043b\u044f\u0449\u0438\u043c\u0441\u044f \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0432\n\u0434\u0440\u0443\u0433\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044b \u0433\u043b\u0430\u0437\u043d\u0438\u0446\u044b. \u0412 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\n\u0447\u0430\u0441\u0442\u043e \u0432\u043e\u0432\u043b\u0435\u043a\u0430\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0437\u043d\u0430\u044f \u0436\u0435\u043b\u0435\u0437\u0430. \u0412\n25% \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u043f\u043e\u0440\u0430\u0436\u0430\u