0\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u043e \u0424\u0417\u0422.\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u043a \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\n\u0424\u0417\u0422 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u0424\u0417\u0422\n\n\u0415\u0441\u043b\u0438 \u0442\u0435\u0440\u043f\u0438\u044f \u0424\u0417\u0422 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430 \u2013 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\n\u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0424\u0417\u0422\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\n\n\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0438\n\u0415\u0441\u043b\u0438 \u0442\u0435\u0440\u043f\u0438\u044f \u0424\u0417\u0422 \u041d\u0415\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430 \u2013\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 (\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f.\n\u0443\u0440\u043e\u0432\u043d\u044f Lyso-GB3)\n24\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 2\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043e\u0442\u043c\u0435\u043d\u044b \u0424\u0417\u0422 [51]\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043e\u0442\u043c\u0435\u043d\u044b \u0438\n\n\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u0438\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439\n\u041f\u0440\u043e\u043f\u0443\u0441\u043a \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u043c > 50% \u0438\u043d\u0444\u0443\u0437\u0438\u0439 1\n\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0436\u0438\u0437\u043d\u0435\u0443\u0433\u0440\u043e\u0436\u0430\u044e\u0449\u0438\u0435 \u0438\u043b\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441\n\n\u0438\u043d\u0444\u0443\u0437\u0438\u0435\u0439 \u0440\u0435\u0430\u043a\u0446\u0438\u0438, \u043d\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043d\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0443, 1\n\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0430\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0441\u0438\u044f\n\u0416\u0435\u043b\u0430\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 1\n\u0422\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0430\u0434\u0438\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043f\u043e\u0447\u0435\u043a, \u0431\u0435\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438\n\n\u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0438 \u043f\u043e\u0447\u043a\u0438, \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 2A\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e (IV \u043a\u043b\u0430\u0441\u0441 \u043f\u043e