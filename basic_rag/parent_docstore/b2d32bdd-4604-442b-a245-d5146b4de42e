8\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c 2 \u0433\u043e\u0434\u0430.\n\u0418\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442- \u0438\u043d\u0433\u0438\u0431\u0438 \u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0432 \u0412\n\u0442\u043e\u0440\u044b \u0424\u041d\u041e \u0430\u043b\u044c\u0444\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u0435\u0441\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430: [2,4,5,9,10,13,15,17,3\n\u2713 \u043f\u0440\u0438 \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430 \u043e\u0442 15 \u043a\u0433 3,34,39]\n\u0434\u043e <30 \u043a\u0433 \u043f\u043e 20 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 14\n\u0434\u043d\u0435\u0439,;\n\u0410\u0434\u0430\u043b\u0438\u043c\u0443\u043c\u0430\u0431 \u2713 \u043f\u0440\u0438 \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430 \u226530\u043a\u0433 \u2013\n\n40\u043c\u0433 (\u0432 \u0434\u043e\u0437\u0435 24 \u043c\u0433/\u043c2) 1 \u0440\u0430\u0437 \u0432 14\n\u0434\u043d\u0435\u0439.\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 \u0432\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438..\n\u0412\u043d\u0443\u0442\u0440\u044c, \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430: 10 \u043c\u0433 \u0421\n\u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c. [5,9,10,15,17,18,33]\n\u041f\u043e\u0441\u043b\u0435 5 \u0434\u043d\u0435\u0439: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b\n\u0434\u043e 20 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c, \u0447\u0435\u0440\u0435\u0437\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 2 \u043d\u0435\u0434\u0435\u043b\u0438: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e 30 \u043c\u0433\n\u0410\u043f\u0440\u0435\u043c\u0438\u043b\u0430\u0441\u0442*\n\u0444\u043e\u0441\u0444\u043e\u0434\u0438\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u044b 4 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430: 3 \u2013 5 \u043b\u0435\u0442 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438\n\u043e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n\u0422\u0440\u0435\u0442\u044c\u044f \u043b\u0438\u043d\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0421 [2,5,9,10,15,17]\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430:\n\u2713 \u043c\u0435\u043d\u0435\u0435 40 \u043a\u0433: 4 \u043c\u0433/\u043a\u0433 \u043d\u0430\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 1 \u0440\u0430\u0437 \u0432 4 \u043d\u0435\u0434\u0435\u043b\u0438;\n\u2713 \u0431\u043e\u043b\u0435\u0435 40 \u043a\u0433: 150 \u043c\u0433 1 \u0440\u0430\u0437\n\u041a\u0430\u043d\u0430\u043a\u0438\u043d\u0443\u043c\u0430\u0431*\n\u0432 4 \u043d\u0435\u0434\u0435\u043b\u0438\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430: 3 \u2013 5 \u043b\u0435\u0442\n\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0418\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f\n(\u043c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n\u043a \u0418\u041b-1\u03b2)\n\u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0421\n2\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438, \u043d\u043e \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 100 [2,5,9,10,15,17,39]\n\u043c\u0433/\u0441\u0443\u0442, \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0432 \u043e\u0434\u043d\u043e \u0438\n\u0442\u043e\u0436\u0435 \u0432\u0440\u0435\u043c\u044f. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0410\u043d\u0430\u043a\u0438\u043d\u0440\u0430\n\u043a\u0443\u0440\u0441\u0430: 3 \u2013 5 \u043b\u0435\u0442 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438\n\u043e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n23\n\n\u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0421\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430: [2,5,9,10,15,17,33,39\n\u2713 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 <30 \u043a\u0433 ]\n1 \u0440\u0430\u0437 \u0432 3 \u043d\u0435\u0434\u0435\u043b\u0438;\n\u2713 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439> 30 \u043a\u0433\n\u0418\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e 1 \u0440\u0430\u0437 \u0432 2 \u043d\u0435\u0434\u0435\u043b\u0438.\n(\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u0430 \u0418\u041b \u0422\u043e\u0446\u0438\u043b\u0438\u0437\u0443\u043c\u0430\u0431 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430: 3 \u2013 5 \u043b\u0435\u0442\n6) \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n\n\u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e, \u043e\u0442 500 \u0421\n\u0426\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043c\u0433/\u043c2 \u0434\u043e 1 \u0433/\u043c2 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 [5,9,10,15,17,33,34]\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442, \u0426\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430, \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e,\n\u0430\u043b\u043a\u0438\u043b\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u0442\u0438\u043f\u0430.\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0448\u0435\u0441\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u0433\u0440\u0443\u043f\u043f\u0430\n\u0410\u0446\u0435\u0442\u0438\u043b\u0441\u0430\u043b\u0438\u0446\u0438\u043b \u0412\u043d\u0443\u0442\u0440\u044c, 1 \u2013 3 \u043c\u0433/\u043a\u0433 \u0432\u0435\u0441\u0430 1 \u2013 2 \u0421 [10,15]\n\u0410\u043d\u0442\u0438\u0430\u0433\u0440\u0435\u0433\u0430\u043d\u0442\u044b \u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430: 3 \u043c\u0435\u0441\u044f\u0446\u0430.\n\u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e 75 \u2013 \u0421 [9,10,33]\n100 \u0415\u0414/\u043a\u0433 \u0432\u0435\u0441\u0430 (\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\n\u0413\u0435\u043f\u0430\u0440\u0438\u043d\n5000 \u0415\u0414), 2 \u2013 4 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, 10\n\u0434\u043d\u0435\u0439.\n\u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, 1 \u043c\u0433/\u043a\u0433 \u0432\u0435\u0441\u0430, \u0421 [9,10,33]\n\u042d\u043d\u043e\u043a\u0441\u0430\u043f\u0430\u0440\u0438\u043d\n\u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441\u043e\u0432 10 \u0434\u043d\u0435\u0439\n\u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0432 \u0421 [9,10,33]\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430:\n\u0414\u043e 5 \u043a\u0433 -200 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442 (\u0432 2\n\u0410\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u044b\n\u043f\u0440\u0438\u0435\u043c\u0430);\n5 \u2013 10 \u043a\u0433 \u2013 190 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442 (\u0432\n2 \u043f\u0440\u0438\u0435\u043c\u0430);\n\u041d\u0430\u0434\u0440\u043e\u043f\u0430\u0440\u0438\u043d\n10 \u2013 20 \u043a\u0433 \u2013 175 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442\n(\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430);\n20 \u2013 30 \u043a\u0433 \u2013 160 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442\n(\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430);\n\u0411\u043e\u043b\u0435\u0435 30 \u043a\u0433 \u2013 150 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442\n(\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430).\n\u041a\u0443\u0440\u0441 10 \u0434\u043d\u0435\u0439.\n\u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b \u0412\u043d\u0443\u0442\u0440\u044c \u043f\u043e 10 \u2013 20 \u043c\u0433, 2 \u0440\u0430\u0437\u0430 \u0432 \u0421 [9,15]\n\u0441\u0443\u0442\u043a\u0438, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0430 \u0444\u043e\u043d\u0435\n\u043f\u0440\u0438\u0435\u043c\u0430 \u041d\u041f\u0412\u0421 \u0438 \u0413\u041a\u0421\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u043f\u0440\u043e\u0442\u043e\u043d\u043e\u0432\u043e\u0433\u043e \u042d\u0437\u043e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b \u0421 1 \u043c\u0435\u0441\u044f\u0446\u0430 \u0436\u0438\u0437\u043d\u0438, \u0432\u043d\u0443\u0442\u0440\u044c, 10 \u2013 \u0421 [9,15]\n\u043d\u0430\u0441\u043e\u0441\u0430 20 \u043c\u0433, 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438,\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0430 \u0444\u043e\u043d\u0435 \u043f\u0440\u0438\u0435\u043c\u0430\n\u041d\u041f\u0412\u0421 \u0438 \u0413\u041a\u0421\n\u0424\u0430\u043c\u043e\u0442\u0438\u0434\u0438\u043d \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0421 [9]\n24\n\n\u2713 \u0434\u043e 10 \u043b\u0435\u0442 \u2013 20 \u043c\u0433 1 \u0440\u0430\u0437 \u0432\n\n\u0441\u0443\u0442\u043a\u0438;\n\u2713 \u0441\u0442\u0430\u0440\u0448\u0435 10 \u043b\u0435\u0442 \u2013 40 \u043c\u0433 1\n\u0440 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 3 \u0434\u043d\u044f \u043d\u0430\n\u0444\u043e\u043d\u0435 \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0413\u041a\u0421.\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0412\u043d\u0443\u0442\u0440\u044c, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0421 [9,15]\n\u043a\u0430\u043b\u044c\u0446\u0438\u044f: \u043a\u0430\u043b\u044c\u0446\u0438\u044f \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430:\n\u0446\u0438\u0442\u0440\u0430\u0442\u0430 \u2713 \u0434\u0435\u0442\u044f\u043c \u043e\u0442 5 \u2013 12 \u043b\u0435\u0442 \u043f\u043e\n\u0442\u0435\u0442\u0440\u0430\u0433\u0438\u0434\u0440\u0430\u0442* \u0438 500 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c;\n\u043a\u0430\u043b\u044c\u0446\u0438\u044f \u2713 \u0441\u0442\u0430\u0440\u0448\u0435 12\u043b\u0435\u0442 \u043f\u043e 1 \u0442\u0430\u0431\n\u043a\u0430\u0440\u0431\u043e\u043d\u0430\u0442* 2\u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0420\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440 \u043a\u0430\u043b\u044c\u0446\u0438\u0435\u0432\u043e -\n\u0414\u043b\u0438\u0442\u0435\