u0410., \u0415\u043f\u0438\u0444\u0430\u043d\u043e\u0432 \u0410.\u0412. \u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f \u0432 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.\u2013 \u041c.:\u0413\u042d\u041e\u0422\u0410\u0420 \u2013\n\u041c\u0435\u0434\u0438\u0430, 2010.\n\n5. \u0418\u0432\u0430\u043d\u043e\u0432 \u0421.\u041c. \u041b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445 \u0432 \u0434\u0435\u0442\u0441\u043a\u043e\u043c\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435.-\u041c\u043e\u0441\u043a\u0432\u0430, 2012.\n6. \u041a\u0430\u0440\u0430\u0447\u0435\u0432\u0446\u0435\u0432\u0430 \u0422.\u0412. \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u0444\u0438\u0437\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0432 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438.- \u041c\u043e\u0441\u043a\u0432\u0430.\n7. \u041a\u043e\u0440\u0436 \u0410.\u0410., \u0411\u043e\u043d\u0434\u0430\u0440\u0435\u043d\u043a\u043e \u041d.\u0421. \u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043a\u043e\u0441\u0442\u0435\u0439 \u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u0443 \u0434\u0435\u0442\u0435\u0439.\n\u0425\u0430\u0440\u044c\u043a\u043e\u0432: \u00ab\u041f\u0440\u0430\u043f\u043e\u0440\u00bb, 1994\n\n8. \u041b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438: \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f\n\u0432\u0440\u0430\u0447\u0435\u0439 /