043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0416\u0414\u041f\u0411\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u041b\u0418\u041f\u041f (\u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u2022 \u2022\n\u0411\u0410\u041a: \u0410\u041b\u0422, \u0410\u0421\u0422, \u0429\u0424, \u0413\u0413\u0422\u041f, \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0439 \u043f\u0440\u0438\u0435\u043c\n\u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b\u043e\u043c \u0438\n\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d \u043f\u043e \u0444\u0440\u0430\u043a\u0446\u0438\u044f\u043c; \u0433\u0435\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432\n\u0434\u0440\u0443\u0433\u0438\u043c\u0438\n\u2022 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435;\nIg E;\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438)\n\u2022\n\u2022 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439,\nANA, ASMA, LKM, SLA, pANCA;\n\u0432\u044b\u0437\u0432\u0430\u0432\u0448\u0438\u0445 \u0446\u0438\u0442\u043e\u043b\u0438\u0437.\n\u2022\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0446\u0438\u0442\u043e\u043b\u0438\u0437\u0430 \u0410\u041c\u0410, AMA-M2;\n\u043a\u0430\u043a \u043e\u0431\u0449\u0435\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u2022 Anti-HAV IgM, Anti-HEV Ig M,\nAnti-HCV HBsAg;\n\u2022\n\u041f\u0426\u0420 HCV RNA (\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439);\n\u2022\n\u041f\u0426\u0420 H\u0412V DNA (\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439).\nHELLP-\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u2022 \u2022\n\u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u2193 Hb;\n\u2022 \u2022\n\u0411\u0410\u041a: \u0410\u041b\u0422, \u0410\u0421\u0422, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d \u043f\u043e \u0448\u0438\u0441\u0442\u043e\u0446\u0438\u0442\u044b, \u044d\u0445\u0438\u043d\u043e\u0446\u0438\u0442\u044b \u0432 \u043c\u0430\u0437\u043a\u0435;\n\u0444\u0440\u0430\u043a\u0446\u0438\u044f\u043c, \u041b\u0414\u0413; \u2022\n\u2191 \u043d\u0435\u043f\u0440\u044f\u043c\u043e\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438\n\u2022\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430; \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0430;\n\u2022 \u2022\n\u041e\u0410\u041c; \u0410\u0421\u0422 > 70 \u041c\u0415/\u043b;\n\u2022 \u2022\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u044f. \u0422\u0446 < 100 000/\u043c\u043c\u00b3;\n\u2022\n\u041b\u0414\u0413 > 600 \u041c\u0415/\u043b;\n17\n\n\u2022\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u0438;\n\u2022\n\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u044f (87%)\n\u042d\u043a\u043b\u0430\u043c\u043f\u0441\u0438\u044f, \u2022 \u2022\n\u0411\u0410\u041a: \u0410\u041b\u0422, \u0410\u0421\u0422, \u0429\u0424; \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 20-\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0438\n\u043f\u0440\u0435\u044d\u043a\u043b\u0430\u043c\u043f\u0