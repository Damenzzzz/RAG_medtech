0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0413\u0440\u0443\u043f\u043f\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 PCSK9* \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u043e\u0434\u0438\u043d \u0438\u0437\n\n25\n\n\u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u044d\u0442\u0430\u043f\u043e\u0432 \u043b\u0438\u043f\u0438\u0434\u0441\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0433\u0435\u0442\u0435\u0440\u043e\u0437\u0438\u0433\u043e\u0442\u043d\u043e\u0439 \u0438\n\n\u0433\u043e\u043c\u043e\u0437\u0438\u0433\u043e\u0442\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u043e\u0439 (\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u0432 \u0441\u043f\u0438\u0441\u043e\u043a \u043e\u0440\u0444\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432) \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439\n\u0433\u0438\u043f\u0435\u0440\u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d\u0435\u043c\u0438\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0438 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u0442\u0438\u043d\u043e\u0432.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 18. \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100%\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f).\n\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u04