f\u0430 \u0438 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439\n\n\u043f\u043e\u043c\u043f\u044b \u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b 40 \u043c\u0433 \u0432 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0421\n(\u043d\u0430 \u0444\u043e\u043d\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0421\u0413\u041a\u0421, \u043f\u0440\u0438 per os\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0413\u042d\u0420\u0411)\n\n\u041f\u0440\u043e\u0441\u0442\u0430\u0446\u0438\u043a\u043b\u0438\u043d\u044b \u0418\u043b\u043e\u043f\u0440\u043e\u0441\u0442 \u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e\n\u0438\u043b\u043e\u043f\u0440\u043e\u0441\u0442 2,5-5 \u043c\u043a\u0433 \u0421\n\u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0431\u0443\u043b\u0430\u0439\u0437\u0435\u0440 6-9\n\u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438\n\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0421\u0438\u043b\u0434\u0435\u043d\u0430\u0444\u0438\u043b \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\n\u0446\u0413\u041c\u0424-\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439 (\u0442\u0438\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u0437\u044b \u043f\u043e\u0434 \u0421\n\u0444\u043e\u0441\u0444\u043e\u0434\u0438\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u044b \u0442\u0438\u043f\u0430 5 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e\n(\u0424\u0414\u042d -5) \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432 \u041b\u0410)\n\n\u0421\u0413\u041a\u0421 (\u043f\u0440\u0438 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0438 \u0418\u041b\u0424) \u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0412\u04