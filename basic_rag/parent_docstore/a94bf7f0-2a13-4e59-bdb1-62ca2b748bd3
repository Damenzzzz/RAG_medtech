u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u043f\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0431\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043b\u0435\u0447\u0438\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043a\u0430\u043a \u0411\u0410.\n\n\u2022 \u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430 \u043f\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0431\u043d\u043e\u0433\u043e \u043a\u0443\u0440\u0441\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430.\n\u2022 \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438 \u0441\u043f\u0438\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0434\u043b\u044f\n\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0411\u0410 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434\n\u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432, \u0438\u043b\u0438, \u0435\u0441\u043b\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043c\u0435\u043d\u044b\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0432.\n\u2022 \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0411\u0410 \u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c\u0438\n\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438 \u0441\u043f\u0438\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0411\u0413\u0420 \u0438/\u0438\u043b\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 [1,17].\n\n2.3 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 [1,26]\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0411\u0410 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445\n\u041f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0441\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u043c\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442\n\u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0439 \u043a\u0430\u043a\n\n\u041e\u0424\u04121/\u0424\u0416\u0415\u041b <0,7 \u0434\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u0430:\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438:\n\u2022 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0430\u0448\u043b\u044f;\n\u2022 \u0433\u0438\u043f\u0435\u0440\u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c;\n\n\u2022 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0445 \u0441\u0432\u044f\u0437\u043e\u043a;\n\u2022 \u0413\u042d\u0420\u0411 (\u0433\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c);\n\u2022 \u0440\u0438\u043d\u0438\u0442\u044b;\n\u2022 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0430, \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439;\n\u2022 \u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0439 \u0444\u0438\u0431\u0440\u043e\u0437.\n\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438:\n\u2022 \u0425\u041e\u0411\u041b;\n\u2022 \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u044b;\n\u2022 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e;\n\n\u2022 \u043e\u0431\u043b\u0438\u0442\u0435\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u0438\u0442;\n\u2022 \u0441\u0442\u0435\u043d\u043e\u0437 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439;\n\u2022 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u0438\u0445;\n\n\u2022 \u0441\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 9. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u043f\u0440\u0438 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0411\u0410:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041c\u0435\u0442\u043e\u0434\u044b \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u0425\u041e\u0411\u041b, \u0421\u0445\u043e\u0434\u043d\u043e\u0441\u0442\u044c \u0421\u043f\u0438\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0441 \u041d\u0430\u0447\u0430\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0440\u0430\u043d\u0435\u0435 20 \u043b\u0435\u0442, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\nAsthma- \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0438, \u043f\u0440\u043e\u0431\u043e\u0439 \u0441 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u0443\u0440\u0435\u043d\u0438\u044f \u0438\u043b\u0438\nCOPD \u0447\u0430\u0441\u0442\u044b\u0435 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f, \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u043c, \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446. \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b\noverlap \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 \u043e\u0442 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0443\u0445\u0443\u0434\u0448\u0430\u044e\u0442\u0441\u044f \u043d\u043e\u0447\u044c\u044e \u0438\u043b\u0438 \u0443\u0442\u0440\u043e\u043c, \u0441\u0432\u044f\u0437\u0430\u043d\u044b \u0441\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u043f\u0438\u043a\u0444\u043b\u043e\u0443\u043c\u0435\u0442\u0440\u0438\u0438, \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u043c \u0441 \u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u0430\u043c\u0438 \u0438\u043b\u0438\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441\u0442\u0430\u0440\u0448\u0435 40 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u043a\u0440\u043e\u0442\u044b, \u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044f\u043c\u0438\n\u043b\u0435\u0442, \u043a\u0443\u0440\u0435\u043d\u0438\u0435 \u0432 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0432\u0430\u0440\u044c\u0438\u0440\u0443\u044e\u0442 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0443\u0442\u043e\u043a \u0438\u043b\u0438\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442 \u043d\u0435\u0434\u0435\u043b\u044c\n\u0431\u0440\u043e\u043d\u0445\u0438\u0442\u0430 \u0438 \u0438\u043a\u0430 in vitro / in vivo \u0421\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u0438\u043b\u0438 \u043b\u0438\u0447\u043d\u044b\u0439 \u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u043d\u044b\u0439\n\u0433\u0438\u043f\u0435\u0440\u0438\u043d\u0444\u043b\u044f\u0446\u0438\u0438 \u043d\u0430 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u0430\u043d\u0430\u043c\u043d\u0435\u0437. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u043d\u0435\u0435\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0410\u0441\u0442\u043c\u044b.\n\u041a\u0422 \u0424\u0412\u0414 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0432\n\u043c\u0435\u0436\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u0438\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u043e\n\u0432\u0430\u0440\u044c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043a \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u043c\n\u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u0430\u043c, \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0445\n\u0430\u043d\u0430\u043c\u043d\u0435\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u0430\u0441\u0442\u043c\u043e\u0439.\n\u042d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u0438\u044f \u043c\u043e\u043a\u0440\u043e\u0442\u044b.\n\u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0418\u043d\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0420\u0438\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0412\u0414\u041f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0435\n\u0412\u0414\u041f (\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043e\u0434\u044b\u0448\u043a\u0430 \u0438\u043b\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u044b\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439, \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u041b\u041e\u0420-\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0435\u0445\u0432\u0430\u0442\u043a\u0438 \u0432\u043e\u0437\u0434\u0443\u0445\u0430, \u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u0432\u0440\u0430\u0447\u0430, \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.\n\u043a\u0430\u0448\u043b\u044f \u043f\u0440\u0438 \u043f\u0440\u0435\u0432\u0430\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u043d\u0442\u0433\u0435\u043d \u0438/\u0438\u043b\u0438 \u041a\u0422\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u043a\u0430\u0448\u043b\u044f \u043d\u0430\u0434 \u043f\u0440\u0438\u0434\u0430\u0442\u043e\u0447\u043d\u044b\u0445 \u043f\u0430\u0437\u0443\u0445\n\u0412\u0414\u041f, \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438 \u043d\u043e\u0441\u0430, \u0433\u0440\u0443\u0434\u043d\u043e\u0439\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438, \u043a\u043b\u0435\u0442\u043a\u0438,\n\u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0445 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0439 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\n\u0441\u0432\u044f\u0437\u043e\u043a, \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u041b\u041e\u0420-\u0432\u0440\u0430\u0447\u0430\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0435\n\u0442\u0435\u043b\u0430, \u043f\u043e\u043b\u0438\u043f\u043e\u0437\n\u0438 \u0442.\u043f.)\n\u0413\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0424\u0413\u0414\u0421, \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0435 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u043b\u0438 \u043f\u043e\u0447\u0442\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435\n\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u0435\u0430\u043b\u044c\u043d\u043e \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0424\u0413\u0414\u0421, \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u044b \u043d\u0430\n\u0440\u0435\u0444\u043b\u044e\u043a\u0441 \u0439 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0438, \u0440\u041d \u041d\u0420. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u043e\u0442 \u0430\u043d\u0442\u0438\u0440\u0435\u0444\u043b\u044e\u043a\u0441\u043d\u043e\u0439\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430 \u044f\u0437\u0432\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0430,\n\u044d\u0440\u043e\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u0433\u0430\u0441\u0442\u0440\u0438\u0442\u0430\n\u0438 \u0442.\u043f.\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0430\n\u043e\u0442 \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0427\u0430\u0441\u0442\u044b\u0435 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u044f, \u0410\u043b\u043b\u0435\u0440\u0433\u043e\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0442\u0438\u0442\u0440\u043e\u0432 \u043e\u0431\u0449\u0435\u0433\u043e IgE \u0438\n\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439 \u043a\u0430 in vitro, \u0430\u043d\u0430\u043b\u0438\u0437 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 IgE \u0438 IgE \u043a Aspergillus spp.\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e \u044d\u0444\u0444\u043