439\u043d\u043e\u0439\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439 \u0437\u0430\u0441\u0442\u043e\u0439\u043d\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f\n\n\u0425\u041e\u0411\u041b, \u0430\u0441\u0442\u043c\u0443 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438)\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0451\u0433\u043e\u0447\u043d\u044b\u0435 \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438)\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438)\n\u00ab\u0411\u041e\u0421 2\u00bb (\u0411\u041e\u0421, \u00ab\u0421\u0430\u043d\u0430\u0446\u0438\u044f \u0422\u0411\u0414\u00bb \"\u0420\u0430\u043d\u043d\u0438\u0439 \u043f/\u043e \u043f\u0435\u0440\u0438\u043e\u0434, \u0434\u043e 48\n\n\u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439 \u0433\u0438\u043f\u043e\u043f\u043b\u0430\u0437\u0438\u0438, (\u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u0447\u0430\u0441\u00bb (\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u0438\u0438, \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u044b, \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0443 \u0437\u0430\u0441\u0442\u043e\u0439\u043d\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438,\n\u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 \u0418\u0412\u041b) \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u043e\u0439\n\u043f\u0440\u0438\u0435\u043c\u043e\u0432 \u043f\u043e\u0441\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u0438)\n\n\u0434\u0440\u0435\u043d\u0430\u0436\u0430)\n\u00ab\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\u00bb \u00ab\u0411\u041e\u0421\u00bb (\u0411\u041e\u0421, \u00ab\u0420\u0435\u043a\u0440\u0443\u0442\u043c\u0435\u043d\u0442 \u0438 \u0434\u0440\u0435\u043d\u0430\u0436\u00bb\n(\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439 \u0431\u0440\u043e\u043d\u0445\u0438\u0442, (\u043f\u0440\u0438 \u043e\u0442\u0435\u043a\u0435 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438\n\u0433\u0435\u043d\u0435\u0437\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0425\u041e\u0411\u041b, \u0430\u0441\u0442\u043c\u0443 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043b\u044e\u0431\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438)\n\n\u0433\u0438\u043f\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e) \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0451\u0433\u043e\u0447\u043d\u044b\u0435\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438)\n\u00ab\u041e\u0420\u0414\u0421\u00bb (\u043e\u0441\u0442\u0440\u044b\u0439 \u00ab\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\u00bb \u00ab\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\u00bb (\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0434\u0438\u0441\u0442\u0440\u0435\u0441\u0441 (\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043b\u044e\u0431\u043e\u0433\u043e \u0433\u0435\u043d\u0435\u0437\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f\n\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c) \u0433\u0435\u043d\u0435\u0437\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u041e\u0420\u0414\u0421);\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u041e\u0420\u0414\u0421);\n\u00ab\u0410\u043b\u044c\u0432\u0435\u043e\u043b\u0438\u0442\u00bb \u00ab\u041e\u0420\u0414\u0421\u00bb (\u041e\u0420\u0414\u0421 \u00ab\u041e\u0420\u0414\u0421\u00bb (\u041e\u0420\u0414\u0421 \u043b\u044e\u0431\u043e\u0439\n(\u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043b\u044e\u0431\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438, \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438, \u0442\u044f\u0436\u0435\u043b\u0430\u044f\n\n\u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445, \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f\u044f \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f\u044f \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f)\n\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u0438\u0442\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f)\n\u0433\u0435\u043d\u0435\u0437\u0430)\n\u00ab\u0411\u0443\u043b\u043b\u044b, \u043a\u0438\u0441\u0442\u044b\u00bb \u00ab\u0420\u0435\u043a\u0440\u0443\u0442\u043c\u0435\u043d\u0442 \u0438 \u00ab\u0411\u041e\u0421\u00bb (\u0411\u041e\u0421, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439\n\n(\u0411\u0443\u043b\u043b\u0435\u0437\u043d\u0430\u044f \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0434\u0440\u0435\u043d\u0430\u0436\u00bb (\u043f\u0440\u0438 \u043e\u0442\u0435\u043a\u0435 \u0431\u0440\u043e\u043d\u0445\u0438\u0442, \u0425\u041e\u0411\u041b, \u0430\u0441\u0442\u043c\u0443 \u0438\n\u043b\u0435\u0433\u043a\u0438\u0445, \u043a\u0438\u0441\u0442\u044b \u043b\u0435\u0433\u043a\u0438\u0445) \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u043b\u044e\u0431\u043e\u0439 \u0434\u0440\u0443\u0433\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0451\u0433\u043e\u0447\u043d\u044b\u0435\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438) \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438)\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 2.\n\n\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0412\u0410\u0422 \u0441 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u043c \u0438 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439 (\u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440\u0435 \u0412\u0410\u041b\u0422)\n\n\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c \u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430\n\u0422\u0435\u043a\u0441\u0442 \u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n(\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f\n\u0438\u0437\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u0435\u0439)\n\n\u0411\u041e\u0421 1\n\u0411\u0440\u043e\u043d\u0445\u043e\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\n\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c.\n\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432\n\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439,\n\u043d\u0435\u0431\u0443\u043b\u0430\u0439\u0437\u0435\u0440\u043d\u043e\u0439 \u0438\n\u0421\u0420\u0410\u0420-\u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0411\u041e\u0421 2\n\n\u0411\u0440\u043e\u043d\u0445\u043e\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\n\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u04