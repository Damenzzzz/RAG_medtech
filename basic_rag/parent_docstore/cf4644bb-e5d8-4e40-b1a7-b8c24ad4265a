38\u0438, \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438,\n\u0442\u043e\u043d\u0437\u0438\u043b\u043b\u0438\u0442 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043d\u0430\u043b\u0435\u0442\u043e\u0432\u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043c\u0430\u0437\u043a\u0430 \u0438\u0437 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u03c3- \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438\n\u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u0445 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d; \u0433\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0442\u0440\u0435\u043f\u0442\u043e\u043a\u043e\u043a\u043a; \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432 \u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0435.\n\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0432\u044b\u0441\u043e\u043a\u0430\u044f 39\u00b0\u0421, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f;\n\n\u0440\u0435\u0437\u043a\u0430\u044f \u0431\u043e\u043b\u044c \u043f\u0440\u0438 \u0433\u043b\u043e\u0442\u0430\u043d\u0438\u0438. \u042f\u0440\u043a\u0430\u044f\n\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438 \u0431\u0435\u0437 \u043e\u0442\u0435\u043a\u0430\n\u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d. \u041d\u0430\u043b\u0435\u0442\u044b \u043d\u0430 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445\n\u0436\u0435\u043b\u0442\u043e\u0432\u0430\u0442\u043e-\u0431\u0435\u043b\u044b\u0435, \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u0434\n\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043f\u043e \u0442\u0438\u043f\u0443 (\u00ab-\u0442\u043a\u0430\u043d\u044c\u00bb), \u043b\u0435\u0433\u043a\u043e\n\u0441\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0443\n\u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043d\u044b\u043c\u0438 \u0441\u0442\u0435\u043a\u043b\u0430\u043c\u0438..\n\u0413\u0440\u0438\u0431\u043a\u043e\u0432\u0430\u044f \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438, \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0412 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u0435\u043c\n\n\u0430\u043d\u0433\u0438\u043d\u0430 \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043d\u0430\u043b\u0435\u0442\u043e\u0432 \u043c\u0430\u0437\u043a\u0430 \u0438\u0437 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0443 \u0434\u0435\u0442\u0435\u0439\n(\u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437 \u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u0445 \u0434\u0440\u043e\u0436\u0436\u0435\u0432\u044b\u0435 \u0433\u0440\u0438\u0431\u044b; \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0438\u043b\u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u043e\u0435\n\u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438) \u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438; \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435; \u0441\u043b\u0430\u0431\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0441 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439; \u0411\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442.\n\u041d\u0430\u043b\u0435\u0442\u044b \u043d\u0430 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445 \u0440\u044b\u0445\u043b\u044b\u0435,\n\u0442\u0432\u043e\u0440\u043e\u0436\u0438\u0441\u0442\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430, \u043a\u0440\u043e\u0448\u0430\u0449\u0438\u0435\u0441\u044f,\n\n\u043b\u0435\u0433\u043a\u043e \u0441\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f, \u043e\u0431\u043d\u0430\u0436\u0430\u044f\n\u00ab\u043b\u0430\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e\u00bb \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u0443\u044e.\n\u0410\u043d\u0433\u0438\u043d\u0430 \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043d\u0430\u043b\u0435\u0442\u043e\u0432 \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u043b\u0430\u0431\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\n\u0421\u0438\u043c\u0430\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e- \u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u0445 \u043c\u0430\u0437\u043a\u0430 \u0438\u0437 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u0441\u0443\u0431\u0444\u0435\u0431\u0440\u0438\u043b\u044c\u043d\u043e\u0439\u0438\u043b\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439\n\n13\n\n\u0412\u0435\u043d\u0441\u0435\u043d\u0430- \u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438; Bac.fusiformis\u0438Sp.buccalis; \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439, \u0433\u043d\u0438\u043b\u043e\u0441\u0442\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0445 \u0438\u0437\u043e \u0440\u0442\u0430.\n\u041f\u043b\u0430\u0443\u0442\u0430 \u041e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f,\n\u0441\u043b\u0430\u0431\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0438 \u043d\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u041d\u0430\u043b\u0435\u0442\u044b\n\u043d\u0430 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0435 \u0437\u0435\u043b\u0435\u043d\u043e\u0432\u0430\u0442\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430,\n\n\u0442\u0432\u043e\u0440\u043e\u0436\u0438\u0441\u0442\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430, \u0441 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439\n\u0432 \u043a\u0440\u0430\u0442\u0435\u0440\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435 \u0438\u0437\u044a\u044f\u0437\u0432\u043b\u0435\u043d\u0438\u0435.\n\u0418\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0411\u043e\u043b\u0438 \u0432 \u0433\u043e\u0440\u043b\u0435 \u043f\u0440\u0438 \u0433\u043b\u043e\u0442\u0430\u043d\u0438\u0438; 1.\u041e\u0410\u041a:\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0437\u0430 \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u0441 \u0443\u043f\u043e\u0440\u043d\u043e\u0439\n\u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u043e\u0437 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0435\u043c\u0430 \u0448\u0435\u0438. \u0441\u0447\u0435\u0442 \u043b\u0438\u043c\u0444\u043e-, \u043c\u043e\u043d\u043e\u0446\u0438\u0442\u043e\u0437\u0430, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u043e\u0439;\n\n\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u043c\u043e\u043d\u043e-\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043e\u0432, \u0411\u043e\u043b\u0438 \u0432 \u0433\u043e\u0440\u043b\u0435 \u0440\u0430\u0437\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441 \u043d\u043e\u0441\u043e\u0432\u044b\u043c\n\u0440\u043e\u0442\u043e\u0433\u043b\u043e\u0442\u043a\u0435; \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0421\u041e\u042d; \u043e\u0442\u0442\u0435\u043d\u043a\u043e\u043c \u0433\u043e\u043b\u043e\u0441\u0430;\n2. \u0418\u0424\u0410: \u0430\u043d\u0442\u0438-\u0412\u042d\u0411-Ig\u041c, \u0430\u043d\u0442\u0438- \u041e\u0442\u0435\u043a \u0448\u0435\u0438 \u043d\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d, \u043f\u0440\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0435\n\u0412\u042d\u0411-IgG \u043a \u043a\u0430\u043f\u0441\u0438\u0434\u043d\u043e\u043c\u0443, \u0440\u0430\u043d\u043d\u0435\u043c\u0443 \u0433\u043e\u043b\u043e\u0432\u044b \u044f\u0441\u043d\u043e \u0432\u0438\u0434\u043d\u044b \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0435\n\n\u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430\u043c \u0432\u0438\u0440\u0443\u0441\u0430 \u042d\u043f\u0448\u0442\u0435\u0439\u043d-\u0411\u0430\u0440\u0440; \u0437\u0430\u0434\u043d\u0435\u0448\u0435\u0439\u043d\u044b\u0435\u043b\u0438\u043c\u0444\u043e\u0443\u0437\u043b\u044b, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0432\n\u0432\u0438\u0434\u0435 \u0446\u0435\u043f\u043e\u0447\u0435\u043a \u0432\u0434\u043e\u043b\u044c \u0437\u0430\u0434\u043d\u0435\u0433\u043e \u043a\u0440\u0430\u044f \u0433\u0440\u0443\u0434\u0438\u043d\u043d\u043e-\n\u043a\u043b\u044e\u0447\u0438\u0447\u043d\u043e-\u0441\u043e\u0441\u0446\u0435\u0432\u0438\u0434\u043d\u044b\u0445 \u043c\u044b\u0448\u0446;\u0413\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f\n\u0438 \u043e\u0442\u0435\u043a \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d \u0441 \u043e\u0431\u0438\u043b\u044c\u043d\u044b\u043c\u0438 \u043d\u0430\u043b\u0435\u0442\u0430\u043c\u0438\n\n\u0431\u0435\u043b\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430, \u043b\u0435\u0433\u043a\u043e \u0441\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f, \u043a\u0440\u043e\u0448\u0430\u0442\u0441\u044f;\n\u0413\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u0441\u044b\u043f\u044c, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0436\u0435\u043b\u0442\u0443\u0448\u043d\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430.\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439:\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u0413\u0440\u0438\u043f\u043f, \u0413\u0440\u0443\u0431\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c; \u0418\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d\u0442\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u0410\u043d\u0430\u043c\u043d\u0435\u0437: \u0441\u0435\u0437\u043e\u043d\u043d\u0430\u044f\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u043e\u0441\u0442\u0440\u044b\u0439 \u041e\u0441\u0438\u043f\u043b\u043e\u0441\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0430; \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u043f\u043e \u0433\u0440\u0438\u043f\u043f\u0443;\n\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0442\u0440\u0430\u0445\u0435 \u0418\u043d\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u043e\u0434\u044b\u0448\u043a\u0430 \u041e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u0438\u0442 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0432 1-\u0435 \u0441\u0443\u0442\u043a\u0438,\n\n14\n\n\u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0422-39\u00b0\u0421 \u0441 \u043e\u0437\u043d\u043e\u0431\u043e\u043c;\n\u0413\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0441 \u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043b\u0431\u0430, \u043d\u0430\u0434\u0431\u0440\u043e\u0432\u043d\u044b\u0445 \u0434\u0443\u0433, \u0433\u043b\u0430\u0437\u043d\u044b\u0445\n\u044f\u0431\u043b\u043e\u043a, \u043c\u0438\u0430\u043b\u044c\u0433\u0438\u044f, \u0433\u0438\u043f\u0435\u0440\u0435\u0441\u0442\u0435\u0437\u0438\u044f;\n\n\u041f\u0430\u0440\u0430\u0433\u0440\u0438\u043f\u043f, \u0413\u0440\u0443\u0431\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c; \u0418\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d\u0442\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u0410\u043d\u0430\u043c\u043d\u0435\u0437: \u044d\u043f\u0438\u0434\u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0432 \u043c\u0435\u0436\u0441\u0435\u0437\u043e\u043d\u044c\u0435\n\u043e\u0441\u0442\u0440\u044b\u0439 \u041e\u0441\u0438\u043f\u043b\u043e\u0441\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0430; (\u043e\u0441\u0435\u043d\u044c, \u0432\u0435\u0441\u043d\u0430);\n\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0442\u0440\u0430\u0445\u0435 \u0418\u043d\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u043e\u0434\u044b\u0448\u043a\u0430 \u041f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435 \u0438\u043b\u0438 \u043f\u043e\u0434\u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e; \u0441\u043b\u0430\u0431\u043e\n\u0438\u0442 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f;\n\n\u0413\u0440\u0443\u0431\u044b\u0439 \u00ab\u043b\u0430\u044e\u0449\u0438\u0439\u00bb \u043a\u0430\u0448\u0435\u043b\u044c.\n\n\u0410\u0434\u0435\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u043d \u0413\u0440\u0443\u0431\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c; \u0418\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d\u0442\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u041e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c\n\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f, \u041e\u0441\u0438\u043f\u043b\u043e\u0441\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0430; \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0438 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\u043c\n\n\u043e\u0441\u0442\u0440\u044b\u0439 \u0418\u043d\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u043e\u0434\u044b\u0448\u043a\u0430 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0440\u0430\u0437\u043d\u043e\u0439 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438;\n\u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0442\u0440\u0430\u0445\u0435 \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\n\u0438\u0442 \u043f\u043e\u043b\u0437\u0443\u0447\u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0441\u0432\u0435\u0440\u0445\u0443 \u0432\u043d\u0438\u0437:\n\u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0438\u0442\u0430 (\u0431\u043e\u043b\u0438 \u0432 \u0433\u043b\u0430\u0437\u0430\u0445,\n\n\u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435), \u0440\u0438\u043d\u0438\u0442 (\u043d\u0430\u0441\u043c\u043e\u0440\u043a \u0438\n\u0437\u0430\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u043e\u0441\u0430, \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0442\u0441\u044f\n\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0435 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0437 \u043d\u043e\u0441\u0430),\n\u043f\u0430\u0441\u0442\u043e\u0437\u043d\u043e\u0441\u0442\u044c \u043b\u0438\u0446\u0430;\n\n\u0427\u0443\u0432\u0441\u0442\u0432\u043e \u043f\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435, \u0441\u0443\u0445\u043e\u0439\n\u043a\u0430\u0448\u0435\u043b\u044c, \u0433\u0440\u0430\u043d\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442;\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0433\u0435\u043f\u0430\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f,\n\u043b\u0438\u043c\u0444\u043e\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0434\u0438\u0430\u0440\u0435\u044f.\n\n\u0418\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c; 1.\u041e\u0410\u041a: \u0410\u043d\u0430\u043c\u043d\u0435\u0437 \u2013 \u043f\u0440\u043e\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430\n\u0442\u0435\u043b\u043e \u041e\u0434\u044b\u0448\u043a\u0430 \u0412 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u044b (\u0440\u0435\u0431\u0435\u043d\u043e\u043a \u00ab\u043f\u043e\u0434\u0430\u0432\u0438\u043b\u0441\u044f\u00bb);\n2. \u041e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0412\u043d\u0435\u0437\u0430\u043f\u043d\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0434\u044b\u0445\u0430\u043d\u0438\u044f: \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 (\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\n\n15\n\n\u0441\u0432\u044f\u0437\u0438 \u0441 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430; \u043a\u0430\u0448\u043b\u044f \u0438/\u0438\u043b\u0438 \u0443\u0434\u0443\u0448\u044c\u044f) \u043d\u0430 \u0444\u043e\u043d\u0435 \u043f\u043e\u043b\u043d\u043e\u0433\u043e\n2. \u041f\u0440\u044f\u043c\u0430\u044f \u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f;\n3.\u0411\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\n4. \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u0439, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u044f\u0432\u043b\u0435\u043d\u0438\u0439;\n\n\u041a\u0430\u0448\u0435\u043b\u044c \u0440\u0430\u0437\u043d\u043e\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0439, \u0438\u043d\u043e\u0433\u0434\u0430\n\u0441\u043f\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u043c\u0438 \u0447\u0430\u0449\u0435 \u0432 \u0441\u0432\u044f\u0437\u0438 \u0441\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u043b\u0430, \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b\n\u0446\u0438\u0430\u043d\u043e\u0437\u0430 \u0438 \u0440\u0432\u043e\u0442\u044b.\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435\n\n\u043e\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0438\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435, \u0441\u0432\u0438\u0441\u0442\u044f\u0449\u0438\u0435 \u0445\u0440\u0438\u043f\u044b\n\u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u041a\u0430\u0448\u0435\u043b\u044c; 2. \u041e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0410\u043d\u0430\u043c\u043d\u0435\u0437 \u2013 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0441 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439\n\u0441\u0442\u0440\u0438\u0434\u043e\u0440 \u041e\u0434\u044b\u0448\u043a\u0430 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0434\u044b\u0445\u0430\u043d\u0438\u044f: \u043f\u0435\u0440\u0432\u044b\u0445 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0436\u0438\u0437\u043d\u0438(\u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0443 \u0440\u0435\u0431\u0435\u043d\u043a\u0430\n\u0441\u0442\u0440\u0438\u0434\u043e\u0440\u043e\u0437\u043d\u043e\u0433\u043e \u0434\u044b\u0445\u0430\u043d\u0438\u044f);\n\n\u041a\u0430\u0448\u0435\u043b\u044c \u00ab\u043a\u0443\u0434\u0430\u0445\u0442\u0430\u044e\u0449\u0438\u0439\u00bb, \u0448\u0443\u043c\u043d\u043e\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0441\n\u043e\u0441\u043e\u0431\u044b\u043c \u043f\u0440\u0438\u0437\u0432\u0443\u043a\u043e\u043c \u043d\u0430 \u0432\u0434\u043e\u0445\u0435, \u0441 \u0432\u0442\u044f\u0436\u0435\u043d\u0438\u0435\u043c \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0433\u0440\u0443\u0434\u0438\u043d\u044b, \u0433\u043e\u043b\u043e\u0441 \u0437\u0432\u043e\u043d\u043d\u044b\u0439;\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u0441", "type": "Document"}}