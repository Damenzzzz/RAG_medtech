33\u043e \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\n\n\u0412\u043e\u0437\u0440\u0430\u0441\u0442 \uf03c1 \u0433\u043e\u0434\u0430 1-2 \u0433\u043e\u0434\u0430 2-3 \u0433\u043e\u0434\u0430 \uf03e3 \u043b\u0435\u0442\n\u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 6 \u043c\u0433 8 \u043c\u0433 10 \u043c\u0433 12 \u043c\u0433\n\u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d 4 \u043c\u0433 6 \u043c\u0433 8 \u043c\u0433 10 \u043c\u0433\n\n\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438(9-24 \u043d\u0435\u0434\u0435\u043b\u0438, 25-40 \u043d\u0435\u0434\u0435\u043b\u0438):\n\n\u2022 \u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 10\u043c\u0433/\u043c2/\u0434\u0435\u043d\u044c \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u043e 3 \u0434\u043d\u044f \u043a\u0430\u0436\u0434\u044b\u0435 2 \u043d\u0435\u0434\u0435\u043b\u0438\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e \u0432 3 \u043f\u0440\u0438\u0435\u043c\u0430;\n\n\u2022 \u042d\u0442\u043e\u043f\u043e\u0437\u0438\u0434 150\u043c\u0433/\u043c2 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e 1-3 \u0447\u0430\u0441\u0430, \u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435 2 \u043d\u0435\u0434\u0435\u043b\u0438,\n\n\u0440\u0430\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 0,9% \u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u043d\u0430\u0442\u0440\u0438\u044f \u0438\u043b\u0438 5% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435 \u0433\u043b\u044e\u043a\u043e\u0437\u044b \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 0,4\u043c\u0433/\u043c\u043b\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430;\n\u2022 \u0426\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043f\u043e\u0447\u0435\u043a \u0432\u043d\u0443\u0442\u0440\u044c \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430,\n\u0434\u043e\u0437\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0443\u0440\u043e\u0432\u043d\u044f \u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u0430 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c", "type": "Document"}}