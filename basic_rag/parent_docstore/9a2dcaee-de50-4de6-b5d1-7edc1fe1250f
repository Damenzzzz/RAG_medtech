42 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0441\u043d\u0435. \u041f\u0440\u0438\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0433\u043b\u0438\u043a\u043e\u0433\u0435\u043d\u0430 \u0432 \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0430\u043b\u044c\u043d\u044b\u0445\n\u043a\u043b\u0435\u0442\u043a\u0430\u0445 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043e\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u043d\u0438\u0435 \u0434\u0435\u0441\u043d\u044b \u0439\u043e\u0434\u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u043c\u0438\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\u043c\u0438 \u043e\u0442 \u0441\u0432\u0435\u0442\u043b\u043e-\u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u043e\u0433\u043e \u0434\u043e \u0442\u0435\u043c\u043d\u043e-\u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430. \u041f\u0440\u043e\u0431\u0430-\n\n\u0428\u0438\u043b\u043b\u0435\u0440\u0430-\u041f\u0438\u0441\u0430\u0440\u0435\u0432\u0430 \u043f\u0440\u0438 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f.\n\u2022 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430 \u0420\u041c\u0410 - \u0420\u041c\u0410 (\u043f\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u043e-\u043c\u0430\u0440\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e \u2013\n\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u044b\u0439) \u0438\u043d\u0434\u0435\u043a\u0441 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0441\u0435\u0445 \u0437\u0443\u0431\u043e\u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0438 \u043d\u0438\u0436\u043d\u0435\u0439\n\u0447\u0435\u043b\u044e\u0441\u0442\u0438, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430. \u041f\u0440\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0434\u043e 25% -\u043b\u0435\u0433\u043a\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430, \u0434\u043e 50% -\n\u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430, \u0431\u043e\u043b\u0435\u0435 50%- \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430.\n\u2022 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0413\u0440\u0438\u043d\u0430-\u0412\u0435\u0440\u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430. \u0413\u0438\u0433\u0438\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\n\u0438\u043d\u0434\u0435\u043a\u0441 \u0413\u0440\u0438\u043d\u0430-\u0412\u0435\u0440\u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043c\u044f\u0433\u043a\u0438\u0445 \u0438 \u0442\u0432\u0435\u0440\u0434\u044b\u0445 \u0437\u0443\u0431\u043d\u044b\u0445\n\u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0413\u0440\u0438\u043d\u0430-\u0412\u0435\u0440\u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430 \u043f\u0440\u0438 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0435\n\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f.\n\u2022 \u0420\u0435\u043d\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043e\u0442\u0440\u043e\u0441\u0442\u043a\u0430 \u043f\u0440\u0438\n\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0435 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442. \u041e\u0440\u0442\u043e\u043f\u0430\u043d\u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\u043b\u0438 \u043f\u0430\u043d\u043e\u0440\u0430\u043c\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0434\u043b\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043e\u0442 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u043f\u0430\u0440\u043e\u0434\u043e\u043d\u0442\u0438\u0442\u0430.\n\n12.5 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0443\u0437\u043a\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\u2022 \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u043e\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 (\u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442,\n\n\u0433\u0438\u043f\u0435\u0440\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0438 \u043a\u043e\u0440\u044b \u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432) \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432 \u0434\u0435\u0441\u043d\u0435, \u0447\u0442\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\n\n\u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u043c \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435\u043c. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043c \u0432\u0440\u0430\u0447\u0430\n\u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0430.\n\n\u2022 \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445 \u043a\u0440\u043e\u0432\u0438 (\u043b\u0435\u0439\u043a\u043e\u0437, \u0430\u0433\u0440\u0430\u043d\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0437,\n\u0430\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043d\u0435\u043c\u0438\u044f) \u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439, \u044f\u0437\u0432\u0435\u043d\u043d\u044b\u0439 \u0438 \u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0432\n\u0434\u0435\u0441\u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c. \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u043a\u0430\u043a\n\n\u0434\u043b\u044f \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438, \u0442\u0430\u043a \u0438 \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043c \u0432\u0440\u0430\u0447\u0430-\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430.\n\n\u2022 \u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433\u0430 \u2013 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442, \u043a\u0430\u043a\n\u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e\n\n\u0442\u0440\u0430\u043a\u0442\u0430, \u0447\u0442\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441 \u0443\u0447\u0430\u0441\u0442\u0438\u0435\u043c \u0432\u0440\u0430\u0447\u0430-\u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433\u0430.\n\n12.6 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 - 3. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0444\u043e\u0440\u043c\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430.\n\nNo \u0424\u043e\u0440\u043c\u0430 \u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u0441 \u041e\u0431\u0449\u0438\u0435 \u041e\u0442\u043b\u0438\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0430. \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u0443\u044e \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\n\u0442\n\n1 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0426\u0438\u0430\u043d\u043e\u0442\u0438\u0447\u043d\u043e\u0441\u0442 \u041f\u0440\u0438 \u043f\u0430\u0440\u043e\u0434\u043e\u043d\u0442\u0438\u0442\u0435. \u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0430\u0440\u043e\u0434\u043e\u043d\u0442\u0438\u0442 \u044c, \u043e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c -\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442. \u043b\u0435\u0433\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438\n\u043a\u0440\u0430\u044f, \u043f\u0440\u0438 \u0437\u0443\u0431\u043e\u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e\n\n\u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f,\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f\n\n\u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0432\u043e\u0441\u0442 \u043f\u0430\u0440\u043e\u0434\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435\n\u044c. \u043a\u0430\u0440\u043c\u0430\u043d\u044b\n\u0433\u043b\u0443\u0431\u0438\u043d\u043e\u0439 3-3,5\n\n\u043c\u043c. \u041e\u0433\u043e\u043b\u0435\u043d\u0438\u0435\n\u0448\u0435\u0435\u043a \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\n\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0437\u0443\u0431\u043e\u0432.\n\u041d\u0430\n\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435-\n\n\u0440\u0435\u0437\u043e\u0440\u0431\u0446\u0438\u044f\n\u043a\u043e\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439\n\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0438\n\n\u0432\u0435\u0440\u0448\u0438\u043d\n\u043c\u0435\u0436\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u044b\n\n\u0445 \u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043e\u043a,\n\u043e\u0441\u0442\u0435\u043f\u043e\u0440\u043e\u0437 \u0438\n\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u0432\u044b\u0441\u043e\u0442\u044b\n\u043c\u0435\u0436\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u043e\n\n\u0439 \u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0438 \u0432\n\u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 1/3\n\n\u0434\u043b\u0438\u043d\u044b \u043a\u043e\u0440\u043d\u044f.\n\n2 \u0413\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a \u0424\u0438\u0431\u0440\u043e\u043c\u0430\u0442\u043e\u0437 \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0420\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044f. \u0438\u0439 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442, \u0434\u0435\u0441\u0435\u043d. \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043a\u0440\u0430\u044f\n\n\u0444\u0438\u0431\u0440\u043e\u0437\u043d\u0430\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u0444\u0438\u0431\u0440\u043e\u043c\u0430\u0442\u043e\u0437\u0435\n\u0444\u043e\u0440\u043c\u0430. \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\n\n\u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u0432\u0435\u0441\u0442\u0438\u0431\u0443\u043b\u044f\u0440\u043d\u043e\u0439,\n\u043a\u0440\u0430\u044f. \u043d\u043e \u0438 \u0441 \u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438,\n\n\u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043d\u0435\n\u0442\u043e\u043b\u044c\u043a\u043e\n\n\u043c\u0430\u0440\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f, \u043d\u043e\n\u0438 \u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u0430\u044f\n\n\u0434\u0435\u0441\u043d\u0430. \u0412 \u0440\u044f\u0434\u0435\n\u0441\u043b\u0443\u0447\u0430\u0435\u0432\n\u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f\n\n\u043a\u043e\u0441\u0442\u043d\u0430\u044f \u0442\u043a\u0430\u043d\u044c\n\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u043e\u0433\u043e\n\n\u043e\u0442\u0440\u043e\u0441\u0442\u043a\u0430.\n\n3 \u0413\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a \u041b\u0435\u0439\u043a\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0414\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u041e\u0431\u0449\u0438\u0435. \u0438\u0439 \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442, \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u043e\u0442\u0435\u0447\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430. \u0434\u0435\u0441\u043d\u044b \u043f\u0440\u0438 \u043a\u0440\u0430\u044f, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043b\u0435\u0439\u043a\u043e\u0437\u0430\n\u043b\u0435\u0439\u043a\u043e\u0437\u0435. \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u2013 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n\n\u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u043e\u0431\u0449\u0435\u0433\u043e\n\u0434\u0435\u0441\u043d\u044b. \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f,\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\n\u043e\u0431\u0449\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430\n\u043a\u0440\u043e\u0432\u0438.\n\n4 \u042f\u0437\u0432\u0435\u043d\u043d\u044b\u0439 \u041e\u0441\u0442\u0440\u044b\u0439 \u043b\u0435\u0439\u043a\u043e\u0437. \u041d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u041f\u0440\u0438 \u043e\u0441\u0442\u0440\u043e\u043c. \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442. \u043e\u0431\u0449\u0435\u0433\u043e \u043b\u0435\u0439\u043a\u043e\u0437\u0435 -\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f - \u0431\u043b\u0435\u0434\u043d\u043e\u0441\u0442\u044c\n\u043d\u0435\u0434\u043e\u043c\u043e\u0433\u0430\u043d\u0438\u0435, \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438,\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0438,\n\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0442\u0435\u043b\u0430. \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\n\u041d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043a\u0440\u0430\u044f\n\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0430 \u0444\u043e\u043d\u0435\n\u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043d\u0435\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u043e\u0439\n\n\u043a\u0440\u0430\u044f, \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438.\n\n\u0437\u0430\u043f\u0430\u0445 \u0438\u0437\u043e \u0440\u0442\u0430. \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u043e\u0431\u0449\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430\n\n\u043a\u0440\u043e\u0432\u0438.\n\u041d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\n\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f,\n\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n\n5 \u042f\u0437\u0432\u0435\u043d\u043d\u044b\u0439 \u0410\u0433\u0440\u0430\u043d\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0437. \u0411\u043e\u043b\u044c, \u044f\u0437\u0432\u0435\u043d\u043d\u043e- \u041f\u0440\u0438\n\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442. \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u0433\u0440\u0430\u043d\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0437\u0435 -\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435\n\n\u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043f\u0440\u0438\u0435\u043c\n\u043a\u0440\u0430\u044f. \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432,\n\u043b\u0443\u0447\u0435\u0432\u043e\u0435\n\u043e\u0431\u043b\u0443\u0447\u0435\u043d\u0438\u0435.\n\n\u041d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435\n\n\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0441\u043d\u044b, \u043d\u043e\n\u0438 \u0434\u0440\u0443\u0433\u0438\u0445\n\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430.\n\n\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u043e\u0431\u0449\u0435\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430\n\u043a\u0440\u043e\u0432\u0438.\n\n\u041d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\n\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f,\n\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n\n6 \u042f\u0437\u0432\u0435\u043d\u043d\u044b\u0439 \u042f\u0437\u0432\u0435\u043d\u043d\u043e- \u0411\u043e\u043b\u044c, \u044f\u0437\u0432\u0435\u043d\u043d\u043e- \u041d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442. \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435\n\u0433\u0438\u043d\u0433\u0438\u0432\u043e\u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e\n\n\u0412\u0435\u043d\u0441\u0430\u043d\u0430. \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043a\u0440\u0430\u044f, \u043d\u043e \u0438 \u0434\u0440\u0443\u0433\u0438\u0445\n\u043a\u0440\u0430\u044f. \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\n\u041d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\n\u043e\u0431\u0449\u0435\u0433\u043e \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f. \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430. \u0412\n\n\u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u043d\u0435\u043a\u0440\u043e\u0437\u0430\n\u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f\n\n\u0444\u0443\u0437\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438 \u0438\n\u0441\u043f\u0438\u0440\u043e\u0445\u0435\u0442\u044b\n\u0412\u0435\u043d\u0441\u0430\u043d\u0430.\n\n7 \u042f\u0437\u0432\u0435\u043d\u043d\u044b\u0439 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u044b \u0411\u043e\u043b\u044c, \u044f\u0437\u0432\u0435\u043d\u043d\u043e- \u041f\u0440\u0438\n\u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442. \u0439 \u044f\u0437\u0432\u0435\u043d\u043d\u043e- \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\n\u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043c \u044f\u0437\u0432\u0435\u043d\u043d\u043e-\n\n\u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442. \u0434\u0435\u0441\u043d\u0435\u0432\u043e\u0433\u043e \u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\n\u043a\u0440\u0430\u044f. \u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442\u0435 - \u0432\n\n\u041d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u043f\u0440\u0438\u0435\u043c\n\u043e\u0431\u0449\u0435\u0433\u043e \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445\n\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f. \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432.\n\u041d\u0435\u043a\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435", "type": "Document"}}