\u0440\u043d\u044b\u0445 \u0437\u043e\u043d \u0433\u0438\u043f\u043e\u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0441\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u043e\u043b\u043e\u0447\u043d\u043e\u0439 \u043b\u0438\u043c\u0444\u043e\u043e\u0442\u0442\u043e\u043a\u0430 \u043d\u0435\u0447\u0435\u0442\u043a\u0438\u043c\u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445\n\u0436\u0435\u043b\u0435\u0437\u044b \u2022 \u043c\u0430\u043c\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432; \u0433\u0438\u043f\u043e\u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b\n/\u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043d\u0430\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0437\u043b\u044b\n\n\u043c\u0430\u043c\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f/ \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u0437\u043e\u043d.\n\u2022 \u0442\u043e\u043c\u043e\u0441\u0438\u043d\u0442\u0435\u0437 \u041c\u0430\u043c\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f, \u0442\u043e\u043c\u043e\u0441\u0438\u043d\u0442\u0435\u0437: \u043d\u0435\u0447\u0435\u0442\u043a\u043e\n\u2022 \u0434\u0443\u043a\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u043e\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u044b\u0435 \u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u044f \u0441 \u043b\u0443\u0447\u0438\u0441\u0442\u044b\u043c\u0438\n\u2022 \u043c\u0430\u0437\u043e\u043a-\u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043e\u043a \u0438\u0437 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438 \u0441/ \u0431\u04