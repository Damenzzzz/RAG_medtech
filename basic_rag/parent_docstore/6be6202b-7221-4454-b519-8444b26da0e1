-2003\u0433 \u0441\u0442\u0440. 25;\n21) \u0410\u0434\u0438\u043b\u044c\u0431\u0430\u0435\u0432 \u0413.\u0411., \u041a\u0438\u043c \u0413.\u0413., \u041c\u0443\u0445\u0430\u043c\u0431\u0435\u0442\u043e\u0432\u0430 \u0413.\u0410.. \u041f\u0443\u0442\u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043c\u0435\u0441\u0442\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u043a\u0430 \u0432\u0435\u0440\u0445\u043d\u0435\u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e\u0439 \u043f\u0430\u0437\u0443\u0445\u0438 //\n\n\u0412\u0435\u0441\u0442\u043d\u0438\u043a \u0420\u041e\u041d\u0426 \u0438\u043c. \u041d. \u041d. \u0411\u043b\u043e\u0445\u0438\u043d\u0430 \u0420\u0410\u041c\u041d, 2009\u0433. \u0442. 20, No2 (\u043f\u0440\u0438\u043b.1),\u0441.54, \u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b\n\u0415\u0432\u0440\u0430\u0437\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0430 \u043f\u043e \u043e\u043f\u0443\u0445\u043e\u043b\u044f\u043c \u0433\u043e\u043b\u043e\u0432\u044b \u0438 \u0448\u0435\u0438, 2009 \u0433.,\u041c\u0438\u043d\u0441\u043a, \u0411\u0435\u043b\u0430\u0440\u0443\u0441\u044c;\n22) \u0412\u0434\u043e\u0432\u0438\u043d\u0430 \u0421.\u041d., \u0410\u043d\u0434\u0440\u0435\u0435\u0432 \u0412.\u0413., \u041f\u0430\u043d\u043a\u0440\u0430\u0442\u043e\u0432 \u0412.\u0410, \u0420\u043e\u0436\u043d\u043e\u0432 \u0412.\u0410..\u041a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435\n\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u04