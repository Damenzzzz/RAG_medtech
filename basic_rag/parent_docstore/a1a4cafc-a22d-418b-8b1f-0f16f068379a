u0430 \u0410\u0439\u0433\u0443\u043b\u044c \u041a\u0430\u043d\u0430\u0442\u043e\u0432\u043d\u0430 \u2013 \u043c\u0430\u0433\u0438\u0441\u0442\u0440, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u043c\u0430\u0442\u043a\u0438 \u041a\u0424\n\n\u00abUMC\u00bb \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u0442\u0432\u0430 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u0430; \u0434\u0435\u0442\u0441\u043a\u0438\u0439\n\u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433.\n4) \u0416\u0435\u0442\u0438\u043c\u043a\u0430\u0440\u0438\u043d\u043e\u0432\u0430 \u0413\u0430\u0443\u0445\u0430\u0440 \u0415\u0440\u043b\u0430\u043d\u043e\u0432\u043d\u0430 \u2013 \u0432\u0440\u0430\u0447 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433 \u041a\u0424 \u00abUMC\u00bb\n\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u0442\u0432\u0430 \u0438 \u0434\u0435\u0442\u0441\u0442\u0432\u0430.\n\n7.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n7.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n1) \u0428\u0430\u0440\u0438\u043f\u043e\u0432\u0430 \u041c\u0430\u0439\u0440\u0430 \u041d\u0430\u0431\u0438\u043c\u0443\u0440\u0430\u0442\u043e\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440,\n\u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a, \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433 \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440\n\n\u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb, \u0433. \u0410\u043b\u043c\u0430\u0442\u044b;\n2) \u041a\u0430\u043b\u0438\u0430\u0441\u043a\u0430\u0440\u043e\u0432\u0430 \u041a\u0443\u043b\u044c\u043f\u0430\u0448 \u0421\u0430\u0433\u044b\u043d\u0434\u044b\u043a\u043e\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a,\n\u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0443\u0447\u043d\u043e\u0433\u043e \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0446\u0435\u043d\u0442\u0440\u0430, \u0433\u043b\u0430\u0432\u043d\u044b\u0439\n\u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433/\u0433\u0435\u043f\u0430\u0442\u043e\u043b\u043e\u0433 \u041c\u0417 \u0420\u041a.\n7.4 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0447\u0435\u0440\u0435\u0437 5 \u043b\u0435\u0442\n\n\u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043e\u0