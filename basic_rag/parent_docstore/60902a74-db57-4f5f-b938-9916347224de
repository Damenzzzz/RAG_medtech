u0441\u0442\u0435\u0439 \u0440\u0438\u0441\u043a\u0430(II) \u0438 \u0440\u0438\u0441\u043a \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0430 \u0441\n\u043f\u043e\u0441\u0442\u043c\u0435\u043d\u043e\u043f\u0430\u0443\u0437\u0435 \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c FRAX. \u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u0440\u0438\u0447\u0438\u043d\u044b\n\u0438 \u043c\u0443\u0436\u0447\u0438\u043d\u044b \u0432 \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0433\u043e \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u2265 50 \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c DXA- \u043f\u0440\u0438 \u0430\u043d\u043e\u043c\u0430\u043b\u044c\u043d\u044b\u0445\n\u043b\u0435\u0442, \u041c\u041f\u041a \u0443 \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043e\u0432 \u0443 \u0412\u0418\u0427- \u0438\u0441- \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u0445 \u041c\u041f\u041a\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 T-\u0431\u0430\u043b\u043b \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043d\u0438\u0437\u043a\u0430\u044f(VI)\n\u2264 -2,5 \u043b\u044e\u0434\u0435\u0439\n\n\u0416\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u041f\u0440\u043e\u0442\u0435\u043a\u0430\u0435\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u2265 1 \u0411\u043e\u043a\u043e\u0432\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0430\n\u043f\u0440\u0435\u043c\u0435\u043d\u043e\u043f\u0430\u0443\u0437\u0435 \u0438 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e \u0434\u043e \u0440\u0438\u0441\u043a\u0430:(III) \u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430\n\u043c\u0443\u0436\u0447\u0438\u043d\u044b \u0432 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0430 \u0416\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u043f\u043e\u0441\u0442\u043c\u0435\u043d\u043e\u043f\u0430\u0443\u0437\u0435 (\u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u044b\u0439 \u0438 \u0433\u0440\u0443\u0434\u043d\u043e\u0439\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 < 50 \u041c\u0443\u0436\u0447\u0438\u043d\u044b \u2265 50 \u043b\u0435\u0442 \u043e\u0442\u0434\u0435\u043b\u044b) \u043f\u0440\u0438 \u043d\u0438\u0437\u043a\u043e\u0439 \u041c\u041f\u041a\n\u043b\u0435\u0442, \u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u0427\u0430\u0441\u0442\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 40-50 \u043b\u0435\u0442 \u0441 \u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430, \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u041c\u041f\u041a \u043f\u0440\u0438 \u0412\u0418\u0427 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043e\u0432 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430\nZ-\u0431\u0430\u043b\u043b \u2264 -2 \u0438 \u0420\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441 (>20% 10-\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u0439 \u0440\u0438\u0441\u043a \u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\u043c DXA, \u0430\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0442\u044c \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430 - \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043e\u0446\u0435\u043d\u043a\u0438 \u0442\u0430\u043a\u0436\u0435, \u0435\u0441\u043b\u0438 \u0438\u043c\u0435\u0435\u0435\u0442\u0441\u044f\n\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c \u0434\u043e 10-15% FRAX \u0431\u0435\u0437 DXA) \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0442\u0435\u0440\u044f\n\u041c\u043d\u043e\u0433\u043e\u0444\u0430\u043a\u0442\u043e\u0440\u043d\u0430\u044f \u041d\u0438\u0437\u043a\u043e\u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c \u0432 \u0440\u043e\u0441\u0442\u0430 \u0438\u043b\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u044f \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u043a\u0438\u0444\u043e\u0437. (\u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\n\u0423\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u0412\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a \u043f\u0430\u0434\u0435\u043d\u0438\u0439 (IV) \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u044b \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438\n\u041c\u041f\u041a, \u0440\u0438\u0441\u043a\u0430 \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0430\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0438\u043f\u043e\u0433\u043e\u043d\u0430\u0434\u0438\u0437\u043c\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u043e\u0435 \u0432 \u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430 \u0432\u043c\u0435\u0441\u0442\u043e\n(\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u2013 \u0441\u043c.\n\u043d\u0430\u0447\u0430\u043b\u0435 \u0410\u0420\u0422 \u0431\u043e\u043a\u043e\u0432\u043e\u0439 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u044b\n\u041d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438)\n\u0417\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\n\u041f\u0440\u0438\u0435\u043c \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0445\n\u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u041c\u041f\u041a DXA-\u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435).\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0438\u0434\u043e\u0432 (\u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0447\u0435\u043c\n\u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u043f\u0440\u0438\u0435\u043c\u0430\n5 \u043c\u0433 \u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043d\u0430 \u0438\u043b\u0438 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442 \u0432\n\u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0410\u0420\u0412-\n\u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 >3 \u043c\u0435\u0441.)\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432(I)\n\u0414\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0432\u044b\u0448\u0435\u0443\u043f\u043e\u043c\u044f\u043d\u0443\u0442\u044b\u043c\u0438 \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u043c\u0438\n\u0440\u0438\u0441\u043a\u0430, \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\nDXA, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043d\u0430\u0447\u0430\u0442\u044c \u0410\u0420\u0422.\n\u041e\u0446\u0435\u043d\u0438\u0442\u044c \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432\n\u0440\u0438\u0441\u043a\u0430 \u043d\u0430 \u0440\u0438\u0441\u043a \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0430, \u043f\u0443\u0442\u0435\u043c\n\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 DXA \u0432\n\u043e\u0446\u0435\u043d\u043a\u0443, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u0443\u044e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e\nFRAX\u00ae (www.shef.ac.uk/FRAX)\n\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u0441\u0442\u0430\u0440\u0448\u0435 40 \u043b\u0435\u0442\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u043d\u0435\u0434\u043e\u043e\u0446\u0435\u043d\u043a\u0430 \u0440\u0438\u0441\u043a\u0430 \u0434\u043b\u044f\n\u0412\u0418\u0427-\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u0412\u0418\u0427 \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u043a\u0430\u043a\n\u043a\u043e\u0441\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u0440\u0438\u0447\u0438\u043d\u0443(V)\n\u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430\n\u041e\u0441\u0442\u0435\u043e\u043c\u0430\u043b\u044f\u0446\u0438\u044f \u041d\u0430\u0440\u0443\u0448\u0435\u043d\u043d\u0430\u044f \u0422\u0435\u043c\u043d\u0430\u044f \u043a\u043e\u0436\u0430 \u0423 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043f\u0440\u0438\n\u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0434\u