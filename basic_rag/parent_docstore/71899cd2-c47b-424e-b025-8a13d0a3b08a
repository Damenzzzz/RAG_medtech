\u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f (III-\u0421);\uf020\n\n\u2022 \u0414\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d \u0441 \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0435\u0439 (\u0431\u0435\u0437 \u043f\u0440\u0435\u044d\u043a\u043b\u0430\u043c\u043f\u0441\u0438\u0438) \u043f\u0440\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u2265\n37 \u043d\u0435\u0434\u0435\u043b\u044c \u0438 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 39 \u043d\u0435\u0434\u0435\u043b\u044c +6 \u0434\u043d\u0435\u0439, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438, \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043e\u0431\u0441\u0443\u0434\u0438\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0438 (I-\u0412) [1,6,10,11];\uf020\n\u2022 \u0420\u043e\u0434\u044b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u044b \u0436\u0435\u043d\u0449\u0438\u043d\u0430\u043c \u0441 \u043b\u044e\u0431\u044b\u043c \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c\n\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u043b\u044e\u0431\u043e\u0439 \u0441\u0440\u043e\u043a \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u04