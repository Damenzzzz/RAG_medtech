2\u043e\u0434\u043d\u043e\u0439 \u0432\u043e\u0434\u043e\u0439, \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043d\u0435\u0432\u0440\u0438\u0442\u044b,\n\u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0443 \u0431\u0430\u0441\u0441\u0435\u0439\u043d, \u0431\u0430\u043d\u044f, \u0432\u043e\u0434\u043e\u0435\u043c. \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 \u0436\u0435\u043d\u0449\u0438\u043d. \u043b\u0438\u0446\u0435\u0432\u043e\u0433\u043e,\n\u0442\u0435\u043b\u0430 \u0442\u0440\u043e\u0439\u043d\u0438\u0447\u043d\u043e\u0433\u043e\n\u043d\u0435\u0440\u0432\u0430,\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\n\u0447\u0435\u0441\u043a\u0438\u0439\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\n\u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0437\u043a\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d \u043c\u043e\u0436\u0435\u0442 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d \u0440\u0435\u0437\u043a\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d \u043c\u043e\u0436\u0435\u0442\n\u0440\u043e\u0433\u043e\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0434\u0440\u0435\u0432\u043e\u0432\u0438\u0434\u043d\u044b\u0439 \u0431\u0435\u043b\u044b\u0439, \u0441 \u0440\u0430\u0437\u043b\u0438\u0442\u044b\u043c \u043a\u043e\u043b\u044c\u0446\u0435\u0432\u0438\u0434\u043d\u044b\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0441\u0442\u0440\u043e\u043c\u0430\u043b\u044c\u043d\u044b\u0439,\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0430 \u043b\u0430\u043d\u0434\u043a\u0430\u0440\u0442\u043e\u043e\u0431\u0440\u0430\u0437 \u043a\u0440\u0430\u0435\u043c, \u0441 \u0440\u0430\u043d\u043d\u0435\u0439 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439\n- \u043d\u044b\u0439 \u00ab\u043a\u0440\u043e\u0448\u043a\u043e\u0432\u0438\u0434\u043d\u044b\u0439\u00bb \u043d\u0435\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0435\u0439 -\n\n\u0434\u0438\u0441\u043a\u043e\u0432\u0438\u0434\u043d\u044b\u0439 \u00ab\u0442\u0432\u043e\u0440\u043e\u0436\u0438\u0441\u0442\u044b\u0439\u00bb,\n\u0441 \u043d\u0435\u0447\u0435\u0442\u043a\u0438\u043c\u0438\n\u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438\n\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0430 / \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u043d\u0438\u0436\u0435\u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0430 /\n\u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0439 \u0431\u0430\u043a. \u043f\u043e\u0441\u0435\u0432 \u043d\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u044b \u0418\u0424\u0410 \u0431\u0430\u043a. \u043f\u043e\u0441\u0435\u0432 \u043d\u0430 \u0441\u0440\u0435\u0434\u0435 - \u0430\u043d\u0430\u043b\u0438\u0437\u044b \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u0441\u043f\u0435\u0446. -\n\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u043d\u0430 \u0412\u041f\u0413 \u0421\u0430\u0431\u0443\u0440\u043e \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043c\u0430\u0440\u043a\u0435\u0440\u044b 6\n\u0441\u0440\u0435\u0434\u0430\u0445\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n1. \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f: \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430, \u043e\u0442\u0435\u043a\u0430\n\u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u0440\u0435\u0437\u043e\u0440\u0431\u0446\u0438\u044f \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0430, \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u043d\u043e\u0439 \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u0438, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\n\u0437\u0440\u0435\u043d\u0438\u044f, \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0443\u0433\u0440\u043e\u0437\u044b \u043f\u0435\u0440\u0444\u043e\u0440\u0430\u0446\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b.\n\n2. \u041c\u041a\u041b \u0441 \u0446\u0435\u043b\u044c\u044e \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u043f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u0439, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u044d\u0440\u043e\u0437\u0438\u0438, \u0434\u0435\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u0438.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c: III;\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0421\u0442\u043e\u043b No15.\n\u041c\u044f\u0433\u043a\u0438\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u044b\u0435 \u043b\u0438\u043d\u0437\u044b \u0433\u0438\u0434\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0435, \u0441\u0438\u043b\u0438\u043a\u043e\u043d-\u0433\u0438\u0434\u0440\u043e\u0433\u0435\u043b\u0435\u0432\u044b\u0435, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0441\u043e \u0441\u043c\u0435\u043d\u043e\u0439 \u043a\u0430\u0436\u0434\u044b\u0435 2 \u043d\u0435\u0434\u0435\u043b\u0438, \u043f\u0440\u0438 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0430\u0445 \u2013 \u0437\u0430\u043c\u0435\u043d\u0430\n\u043d\u0435 \u0440\u0435\u0436\u0435 1 \u0440\u0430\u0437\u0430 \u0432 7-10 \u0434\u043d\u0435\u0439.\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\u2022 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u044d\u0440\u043e\u0437\u0438\u0438, \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0435 \u043a \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\n\u0424\u0438\u0437\u0438\u043e\u043b\u0435\u0447\u0435\u043d\u0438\u0435: He-Ne (\u0433\u0435\u043b\u0438\u0439-\u043d\u0435\u043e\u043d\u043e\u0432\u044b\u0439) \u043b\u0430\u0437\u0435\u0440 \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u0441\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u0442\u0435\u0447\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e No3-7.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435: \u043a\u0435\u0440\u0430\u0442\u043e\u043f\u0440\u043e\u0442\u0435\u043a\u0442\u043e\u0440\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f.\n\n\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u044d\u0440\u043e\u0437\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b:\n\n\u0424\u043e\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0438\u043b\u043b \u044f\u0446\u0438\u0438 \u2013 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 30 \u043c\u0438\u043d.\n\u0421\u0443\u043b\u044c\u0444\u0430\u0446\u0438\u043b \u043d\u0430\u0442\u0440\u0438\u0439* 30% (\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c),\n\u0421\u0443\u043b\u044c\u0444\u0430\u0446\u0438\u043b \u043d\u0430\u0442\u0440\u0438\u0439* 20% (\u0434\u0435\u0442\u044f\u043c/ \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u043f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435).\n\u041f\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u0438\u043d\u0441\u0442\u0438\u043b\u043b\u044f\u0446\u0438\u0439 \u2013 \u0437\u0430\u043b\u043e\u0436\u0438\u0442\u044c \u0434\u0435\u043a\u0441\u043f\u0430\u043d\u0442\u0435\u043d\u043e\u043b (\u041a\u043e\u0440\u043d\u0435\u0440\u0435\u0433\u0435\u043b\u044c)\n\u0432 \u043a\u043e\u043d\u044a\u044e\u043d\u043a\u0442\u0438\u0432\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u043b\u043e\u0441\u0442\u044c, 30-40 \u043c\u0438\u043d\u0443\u0442 \u2013 \u0441 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u043c\u0438 \u0433\u043b\u0430\u0437\u0430\u043c\u0438.\n2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u2013 3 \u0434\u043d \u044f, 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c \u2013 3 \u0434\u043d\u044f\n\n\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430: \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438:\n\n\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u044d\u0440\u043e\u0437\u0438\u0438 /\u043f\u043e\u043b\u043d\u0430\u044f \u0440\u0430\u0437\u043c\u0435\u0440 \u044d\u0440\u043e\u0437\u0438\u0438\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u043d\u044b\u043c\n\u041c\u041a\u041b**\n\n\u041e\u0431\u0448\u0438\u0440\u043d\u0430\u044f \u044d\u0440\u043e\u0437\u0438\u044f\n\u0432 \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0437\u043e\u043d\u0435", "type": "Document"}}