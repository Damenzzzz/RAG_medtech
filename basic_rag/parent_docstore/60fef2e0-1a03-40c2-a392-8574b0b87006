430\u043c\u0435\u0442\u0440\u043e\u0432 \u0411\u0428. \u041f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438\n\n\u0446\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0434\u0435\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0440\u0435\u0436\u0435 1 \u0440\u0430\u0437\u0430 \u0432 \u043c\u0435\u0441\u044f\u0446,\n\u0430 \u043f\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u0438 - \u0447\u0435\u0440\u0435\u0437 12 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434\u0430 (\u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u044f\u0436\u0451\u043b\u043e\u0439 \u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e\n\u043c\u043e\u0437\u0433\u0430). \u041e\u0441\u043c\u043e\u0442\u0440\u044b \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430, \u0441\u0442\u043e\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430, \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0435 \u0440\u0435\u0436\u0435 1\n\n\u0440\u0430\u0437\u0430 \u0432 3 \u043c\u0435\u0441\u044f\u0446\u0430. \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0411\u0428 \u0434\u043e\u043b\u0436\u043d\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043f\u043e