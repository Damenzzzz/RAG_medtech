33\u0438\u0435 \u0432\u0438\u0434\u044b \u0434\u0438\u0435\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438.\n\n\u2212 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:\n\u041e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u0435 \u043d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0438 \u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0430\u043c\u0438:\n\n\u2022 \u0422\u0440\u0438\u043c\u0435\u043f\u0435\u0440\u0438\u0434\u0438\u043d;\n\n7\n\n\u2022 \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b;\n\u2022 \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b;\n\u2022 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d;\n\n\u2022 \u041a\u0435\u0442\u043e\u0440\u043e\u043b\u0430\u043a.\n\n\u0414\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f\n\u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b: \u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b, \u043b\u0438\u043d\u043a\u043e\u0437\u0430\u043c\u0438\u0434\u044b, \u0433\u043b\u0438\u043a\u043e\u043f\u0435\u043f\u0442\u0438\u0434\u044b.\n\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0447\u043d\u044f \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0434\u043b\u044f \u043f\u0435\u0440\u0438\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u043e\n\n\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u043c\u0438\u043a\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0435.\n\n\u2212 \u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432[2,5]:\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2. \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 (\u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f)\nNo \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442, \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0444\u043e\u0440\u043c\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\n\u043d\u043e\u0441\u0442\u0438\n\u041c\u0435\u0441\u0442\u043d\u043e\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b:\n\n1 \u041f\u0440\u043e\u043a\u0430\u0438\u043d \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 - 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0412(13,15,17)\n0,25%,0,5%, 1%, 2%. \u041d\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438\n\u0431\u043e\u043b\u0435\u0435 15 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0432\n\u0442\u0435\u043b\u0430. \u041d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\n\u0434\u0435\u0442\u044f\u043c \u0434\u043e 12 \u043b\u0435\u0442\n2 \u041b\u0438\u0434\u043e\u043a\u0430\u0438\u043d \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1% \u0438 1 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0410\n2%. \u0414\u0435\u0442\u044f\u043c \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c \u0432\u0438\u0434\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 (13,14,15,16,\n\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438 \u043e\u0431\u0449\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0432 17)\n\u043b\u0438\u0434\u043e\u043a\u0430\u0438\u043d\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\n\u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 3\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b\n\u0442\u0435\u043b\u0430. \u041d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u0434\u0435\u0442\u044f\u043c \u0434\u043e 12 \u043b\u0435\u0442\n\n\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438\n3 \u0422\u0440\u0438\u043c\u0435\u043f\u0435\u0440\u0438\u0434\u0438\u043d \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1%, 1-3 \u0441\u0443\u0442. \u0412 (10,12,\n2%. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 2 \u043b\u0435\u0442 \u2013 0,1 14,16)\n\u2013 0,5 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c \u0434\u043e 2-\u0445\n\u043b\u0435\u0442\n\n4 \u0422\u0440\u0430\u043c\u0430\u0434\u043e\u043b \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1-3 \u0441\u0443\u0442. \u0410 (10,12,\n14,16,17)\n50\u043c\u0433/\u043c\u043b. \u0412\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u0432, \u0432/\u043c,\n\u043f/\u043a \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0434\u0435\u0442\u044f\u043c \u0434\u043e 12\n\u043b\u0435\u0442 - 1-2\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b, \u0441\u0442\u0430\u0440\u0448\u0435\n12 \u043b\u0435\u0442 - 50-100\u043c\u0433.\n\n\u041d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438 (\u041d\u041f\u0412\u0421)\n\n8\n\n5 \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0438 200\u043c\u0433- \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1-5 \u0441\u0443\u0442 \u0410\n\n60 \u043c\u0433 \u043d\u0430 1 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, 3-4 (17,18,19,20)\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 1,5 \u0433 - 2,0 \u0433.\n\u0421\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438 125, 250 \u043c\u0433:\n\u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 10-15 \u043c\u0433/\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0451\u043d\u043a\u0430, 2-3 \u0440\u0430\u0437\u0430\n\u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f 120 \u043c\u0433/5 \u043c\u043b, \u0434\u043b\u044f\n\u043f\u0440\u0438\u0435\u043c\u0430 \u0432\u043d\u0443\u0442\u0440\u044c: \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 -\n10-15 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, 4 \u0440\u0430\u0437\u0430\n\u0432 \u0441\u0443\u0442\u043a\u0438\n\n6 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0441\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d\u0430 100 1-5 \u0441\u0443\u0442 \u0410 (17,20,22)\n\u043c\u0433/5\u043c\u043b - 200 \u043c\u043b, \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430\n\u0432\u043d\u0443\u0442\u0440\u044c, 7-10 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b\n\u0442\u0435\u043b\u0430, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 - 30 \u043c\u0433/\u043a\u0433.\n\n7 \u041a\u0435\u0442\u043e\u0440\u043e\u043b\u0430\u043a \u0420\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0439 1-5 \u0434\u043d\u0435\u0439 \u0410 (10,11,12,\n14,16,17)\n30\u043c\u0433/\u043c\u043b. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435\n15 \u043b\u0435\u0442 \u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432/\u043c 10-30\n\u043c\u0433, \u043a\u0430\u0436\u0434\u044b\u0435 6\u0447.\n\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438\n8 \u