u20132 \u0440\u0430\u0437\u0430 D[1,9-12]\n0,25, 0,5% (\u0442\u0443\u0431\u0430) \u0432 \u0434\u0435\u043d\u044c (\u0441\u043b\u0430\u0431\u044b\u0435 I)\n\u0413\u0438\u0434\u0440\u043e\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043d\u0430\u2013 \u043d\u0430\u0440\u0443\u0436\u043d\u043e 1\u20132 \u0440\u0430\u0437\u0430 D[1,9-12]\n17 \u0431\u0443\u0442\u0438\u0440\u0430\u0442 - 0,1% \u0432 \u0434\u0435\u043d\u044c (\u0441\u043b\u0430\u0431\u044b\u0435 I)\n(\u0442\u0443\u0431\u0430)\n\u0413\u0438\u0434\u0440\u043e\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043d\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u043e 1\u20132 \u0440\u0430\u0437\u0430 D[1,9-12]\n\u0430\u0446\u0435\u0442\u0430\u0442 - 0,1, 0,25, \u0432 \u0434\u0435\u043d\u044c (\u0441\u043b\u0430\u0431\u044b\u0435 I)\n\n1,0, 5,0% (\u0442\u0443\u0431\u0430)\n\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: * - \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u043e \u0434\u043d\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432 \u0420\u041a\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442- \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e-\n\u0432\u0435\u043d\u043d\u0430\u044f \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e-\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438 \u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d - 5 \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0438 \u043a\u0443\u0440\u0441\u043e\u0432\u0430\u044f \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0433\u043b\u044e\u043a\u043e- D[1]\n\n\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b \u043c\u0433 (\u0442\u0430\u0431), 30 \u043c\u0433 \u0434\u043e\u0437\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0434- \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435\n(\u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f (\u0430\u043c\u043f) \u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438- \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043c\u0430\u043b\u043e\u044d\u0444-\n\u043e\u0434\u0438\u043d \u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0432 \u0437\u0430\u0432\u0438\u0441\u0438- \u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b. \u041f\u0440\u0438\u043c\u0435\u043d\u044f-\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0438\u0437 \u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u044e\u0442\u0441\u044f \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\u0433\u0440\u0443\u043f\u043f\u044b) \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043a\n\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d - 5, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0438 \u043a\u0443\u0440\u0441\u043e\u0432\u0430\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c \u0432\u044b\u0431\u043e\u0440\u0430. D[1]\n4, 1,5 \u043c\u0433 (\u0442\u0430\u0431), 4 \u0434\u043e\u0437\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0434- \u0414\u043e\u0437\u0430 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438-\n\u043c\u0433 (\u0430\u043c\u043f) \u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438- \u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0432 \u0437\u0430\u0432\u0438\u0441\u0438- \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0440\u0430-\n\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0447\u043e\u043c \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0432\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435-\n\u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0438 \u043a\u0443\u0440\u0441\u043e\u0432\u0430\u044f \u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435- D[1]\n\u043d \u2013 4, 16 \u043c\u0433 (\u0442\u0430\u0431), \u0434\u043e\u0437\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0434- \u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0441\u043d\u044f\u0442\u0438\u044f\n4 \u043c\u0433 (\u0430\u043c\u043f) \u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438- \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0432 \u0437\u0430\u0432\u0438\u0441\u0438- \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d-\n\n\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043d\u044b\u043c \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e-\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u044b.\n\u041d\u0430\u0440\u0443\u0436\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u041a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e- \u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u0430 \u0434\u0438- 1 \u2013 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 D[1,9-12]\n\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0435- \u043f\u0440\u043e\u043f\u0438\u043e\u043d\u0430\u0442 (1\u043c\u0433) + \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438 \u0432\u0442\u043e-\n\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u0433\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d\u0430 \u0440\u0438\u0447\u043d\u043e\u0439 \u043f\u0438\u043e\u0433\u0435\u043d\u043d\u043e\u0439,\n\u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0433\u043e \u0441\u0443\u043b\u044c\u0444\u0430\u0442 (1 \u043c\u0433) + \u0433\u0440\u0438\u0431\u043a\u043e\u0432\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u043b\u043e\u0442\u0440\u0438\u043c\u0430\u0437\u043e\u043b (10\n(\u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u043c\u0433) (\u0442\u0443\u0431\u0430)\n\u043e\u0434\u0438\u043d \u0413\u0438\u0434\u0440\u043e\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043d 1 \u2013 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c D[1,9-12]\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0438\u0437 (1\u043c\u0433) + \u043d\u0430\u0442\u0430\u043c\u0438- \u043d\u0430\u0440\u0443\u0436\u043d\u043e\n\u0433\u0440\u0443\u043f\u043f\u044b) \u0446\u0438\u043d(10 \u043c\u0433) + \u043d\u0435-\n\u043e\u043c\u0438\u0446\u0438\u043d (3500 \u0415\u0414)\n(\u0442\u0443\u0431\u0430)\n\n\u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d (1 1 \u2013 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c D[1,9-12]\n\u043c\u0433) + \u0433\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d \u043d\u0430\u0440\u0443\u0436\u043d\u043e\n(1 \u043c\u0433) (\u0442\u0443\u0431\u0430)\n\n3.4 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.5 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435:\n\u0414\u0438\u0441\u043f\u0430\u043d\u0441\u0435\u0440\u043d\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u043f\u043e \u043c\u0435\u0441\u0442\u0443 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0443 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 (\u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043a\u043e\u0442\u043e-\n\u0440\u043e\u0433\u043e \u0440\u0435\u0448\u0430\u044e\u0442\u0441\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444-\n\u0444\u0435\u043a\u0442\u043e\u0432 \u043e\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0434\u0438\u0435\u0442\u044b, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430).\n\n3.6 \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438-\n\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\u2022 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0439 \u043d\u0430 \u043a\u043e\u0436\u0435;\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u044b\u0445 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0439;\n\n\u2022 \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u044d\u0440\u043e\u0437\u0438\u0439;\n\u2022 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u043d\u0430 \u043a\u043e\u0436\u0435;\n\u2022 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043d\u0438.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418:\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435, \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\n\u0444\u043e\u0440\u043c\u044b \u0413\u0414.\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043d\u0435\u0442.\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1-7]:\n\u041f\u0440\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0445, \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u0413\u0414 \u0438 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0438 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0440\u0435-\n\n\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435.\n\n5.1 \u043a\u0430\u0440\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 (\u0441\u0445\u0435\u043c\u044b, \u0430\u043b\u0433\u043e\u0440\u0438\u0442-\n\n\u043c\u044b):\n\u041c\u0430\u0440\u0448\u0440\u0443\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441 \u0413\u0414\n\u041d\u0418\u041a\u0412\u0418, \u043e\u0431\u043b\u0430\u0441\u0442\u043d\u043e\u0439 (\u0433\u043e\u0440\u043e\u0434- \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435, \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0444\u043e\u0440-\n\u0441\u043a\u043e\u0439) \u043a\u043e\u0436\u043d\u043e- \u043c\u044b \u0413\u0414;\n\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0432 \u0430\u043c\u0431\u0443-", "type": "Document"}}