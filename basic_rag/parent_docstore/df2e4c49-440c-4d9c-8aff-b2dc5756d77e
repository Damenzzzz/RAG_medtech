35 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u044f/\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 (HAI >3) \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e 14 \u043e\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u043f\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u2022 \u2193 \u0434\u043e\u0437\u044b \u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u0430 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 6 \u043d\u0435\u0434\u0435 (2,5 (\u0437\u0430\u043f\u0430\u0437\u0434\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 3-6 \u043c\u0433/\u043d\u0435\u0434;) \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043e\u0442\u043c\u0435\u043d\u043e\u0439 AZA", "type": "Document"}}