\u043c\u043e\u0442\u043e\u0440\u043d\u043e-\u044d\u0432\u0430\u043a\u0443\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0438 \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u043e\u0439\n\u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0436\u0435\u043b\u0443\u0434\u043a\u0430.\n\n2\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0430\u0441\u0442\u0440\u043e\u0434\u0443\u043e\u0434\u0435\u043d\u0438\u0442 \u2013 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0435 \u0438\u043b\u0438\n\n\u0434\u0438\u0444\u0444\u0443\u0437\u043d\u043e\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u0441\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u043e\u0439 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0436\u0435\u043b\u0443\u0434\u043a\u0430\n\u0438 \u0434\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u0438\u043f\u0435\u0440\u0441\u0442\u043d\u043e\u0439 \u043a\u0438\u0448\u043a\u0438 \u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0445 \u0438 \u043c\u043e\u0442\u043e\u0440\u043d\u043e-\n\u044d\u0432\u0430\u043a\u0443\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 [3].\n\n9. \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f (\u00ab\u0421\u0438\u0434\u043d\u0435\u0439\u0441\u043a\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u00bb, 1996 \u0432 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1 - \u0425\u044c\u044e\u0441\u0442\u043e\u043d\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0430\u0441\u0442\u0440\u0438\u0442\u043e\u0432\n\n\u0422\u0438\u043f \u0433\u0430\u0441\u0442\u0440\u0438\u0442\u0430 \u042d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0421\u0438\u043d\u043e\u043d\u0438\u043c\u044b\n(\u043f\u0440\u0435\u0436\u043d\u0438\u0435 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438)\nHelicobacter pylori \u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u044b\u0439\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439\n\u041d\u0435\u0430\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0413\u0430\u0441\u0442\u0440\u0438\u0442 \u0442\u0438\u043f\u0430 \u0412\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0413\u0438\u043f\u0435\u0440\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u0438\u0442\n\u0413\u0430\u0441\u0442\u0440\u0438\u0442 \u0442\u0438\u043f\u0430 \u0410\n\u0414\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u0438\u0442 \u0442\u0435\u043b\u0430 \u0436\u0435\u043b\u0443\u0434\u043a\u0430\n\u0410\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0418\u043c\u043c\u0443\u043d\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0413\u0430\u0441\u0442\u0440\u0438\u0442 \u0442\u0435\u043b\u0430 \u0436\u0435\u043b\u0443\u0434\u043a\u0430,\n\u0430\u0443\u0442\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u044b\u0439\n\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441 \u0412 -\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u043e\u0439\n12\n\u0430\u043d\u0435\u043c\u0438\u0435\u0439 \u0438 \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0439 \u0441\u0435\u043a\u0440\u0435\u0446\u0438\u0435\u0439\nHelicobacter pylori\n\u0410\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u0438\u0442\n\u041d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0438\u0442\u0430\u043d\u0438\u044f\n\u043c\u0443\u043b\u044c\u0442\u0438\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0438\u043f\u0430 \u0410 \u0438 \u0412\n\u0424\u0430\u043a\u0442\u043e\u0440\u044b \u0441\u0440\u0435\u0434\u044b\n\u041e\u0441\u043e\u0431\u044b\u0435 \u0444\u043e\u0440\u043c\u044b\n\u0425\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0438\n\u0416\u0435\u043b\u0447\u044c\n\u0420\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0433\u0430\u0441\u0442\u0440\u0438\u0442 \u0442\u0438\u043f\u0430 \u0421\n\u0425\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041f\u0440\u0438\u0450\u043c \u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0445\n\u0420\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0440\u0435\u0444\u043b\u044e\u043a\u0441-\u0433\u0430\u0441\u0442\u0440\u0438\u0442\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0420\u0430\u0434\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u041b\u0443\u0447\u0435\u0432\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u0418\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0418\u043c\u043c\u0443\u043d\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b\n\u041b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439\n\u0413\u043b\u044e\u0442\u0435\u043d \u0413\u0430\u0441\u0442\u0440\u0438\u0442, \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\nHelicobacter pylori \u0446\u0435\u043b\u0438\u0430\u043a\u0438\u0435\u0439\n\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u041a\u0440\u043e\u043d\u0430\n\u0421\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437\n\u0413\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0439 \u0413\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u0430\u0442\u043e\u0437 \u0412\u0435\u0433\u0435\u043d\u0435\u0440\u0430 \u0418\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0433\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u0430\u0442\u043e\u0437\n\u0418\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0435 \u0442\u0435\u043b\u0430\n\u0418\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u041f\u0438\u0449\u0435\u0432\u0430\u044f \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u044f\n\u042d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439 \u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u044b\n\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u0438 (\u043a\u0440\u043e\u043c\u0435 \u041d\u0440)\n\u0414\u0440\u0443\u0433\u0438\u0435\n\u0413\u0440\u0438\u0431\u044b\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\u041f\u0430\u0440\u0430\u0437\u0438\u0442\u044b\n\u0413\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0439\n\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u041c\u0435\u043d\u0435\u0442\u0440\u0438\u0435\n\u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0433\u0430\u0441\u0442\u0440\u043e\u0434\u0443\u043e\u0434\u0435\u043d\u0438\u0442\u0430:\n3\n\n\u0412 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u0447\u0430\u0449\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0410.\u0412. \u041c\u0430\u0437\u0443\u0440\u0438\u043d\u0430 \u0438\n\n\u0441\u043e\u0430\u0432\u0442., 1994 \u0441 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f\u043c\u0438 [10].\n\nI. \u041f\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044e:\n\n\u2022 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439;\n\u2022 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0439.\n\nII. \u041f\u043e \u043d\u0430\u043b\u0438\u0447\u0438\u044e \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0441\u0442\u0438 H. pylori (\u041d\u0420-\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439,\n\u043d\u0435\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439).\n\nIII. \u041f\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430:\n\u2022 \u0433\u0430\u0441\u0442\u0440\u0438\u0442: \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 (\u0430\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439, \u0444\u0443\u043d\u0434\u0430\u043b\u044c\u043d\u044b\u0439), \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0439;\n\n\u2022 \u0434\u0443\u043e\u0434\u0435\u043d\u0438\u0442: \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 (\u0431\u0443\u043b\u044c\u0431\u0438\u0442), \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0439.", "type": "Document"}}