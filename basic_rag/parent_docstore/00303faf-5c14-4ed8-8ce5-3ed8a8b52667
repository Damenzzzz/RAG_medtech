43a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433 - \u043f\u0440\u0438 \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0449\u0435\u0439 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438,\n\u043a\u0430\u0440\u0434\u0438\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445;\n\u2022 \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433 \u2013 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u0440\u0435\u0442\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u0438 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445.\n2.6 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0420\u043e\u0434\u043e\u0432\u0430\u044f \u0430\u0441\u0444\u0438\u043a\u0441\u0438\u044f \u0447\u0430\u0441\u0442\u043e \u041d\u0421\u0413, \u041c\u0420\u0422, \u041a\u0422, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438\n\n\u0442\u0440\u0430\u0432\u043c\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0442 \u0440\u043e\u0434\u043e\u0432\u044b\u0435 \u042d\u042d\u0413 \u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0442\u0440\u0430\u0432\u043c\u044b, \u043d\u043e \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0442\u043a\u0430\u043d\u0435\u0439 \u0438 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e,\n\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0442 \u0432\u043e\n\u0437\u0432\u0435\u043d\u044c\u0435\u0432 \u0438\u0445 \u0432\u0440\u0435\u043c\u044f \u0440\u043e\u0434\u043e\u0432.\n\u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f\n\u0420\u0414\u0421 \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0420\u0435\u043d\u0442\u0433\u0435\u043d \u043b\u0435\u0433\u043a\u0438\u0445- \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u0443\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u043c\u0435\u043d\u0435\u0435 34 \u043a\u0430\u0440\u0442\u0438\u043d\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439 \u0432\n\u043f\u043d\u0435\u0432\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u043d\u0438 \u0436\u0438\u0437\u043d\u0438,\n\u043d\u0435\u0434\u0435\u043b\u044c- \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\n\u043b\u0435\u0433\u043a\u0438\u0445 \u0432 \u0432\u0438\u0434\u0435 \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0435\n\u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0440\u0430\u043d\u043d\u0438\u043c\u0438\n\u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430\u00bb \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u043c \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043e\u043c\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u043c\u0438\n\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0443\u0440\u0444\u0430\u043a\u0442\u0430\u043d\u0442\u0430 \u0438\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438. \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0445 \u043d\u0435\u0437\u0440\u0435\u043b\u043e\u0441\u0442\u044c\u044e \u043b\u0435\u0433\u043a\u0438\u0445\n\u0431\u0440\u043e\u043d\u0445\u043e\u0433\u0440\u0430\u043c\u043c\n\n\u041d\u0411\u041e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u041f\u0440\u0435\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043a\u0440\u043e\u0435\u0442\u0441\u044f \u0432 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433\u043e\u0432\u044b\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445\n\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u043e\u0431\u043c\u0435\u043d\u0430\n\u0431\u0435\u043b\u043a\u0430 \u0438\u043b\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430, \u0432 \u0421\u043a\u0440\u0438\u043d\u0438\u043d\u0433\u043e\u0432\u044b\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0447\u0435\u0433\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043c \u0434\u0435\u0444\u0435\u043a\u0442\u0430\n\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445- \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0445 \u0433\u0435\u043d\u043e\u0432,\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0422\u041c\u0421 \u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0449\u0438\u0445\n\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0437\u043c\u0430. \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u044f. \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0435\n\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435\n\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044e\u0442\n\u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043e\u0434\u043d\u0438\u0445\n\u0432\u0435\u0449\u0435\u0441\u0442\u0432 (\u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442\u044b) \u0432\n\u0434\u0440\u0443\u0433\u0438\u0435 (\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b).\n\u041f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u043c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432,\n\u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0449\u0438\u0445\n\u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c\n\n\u0438\u043b\u0438 \u043d\u0430\u0440\u0443\u0448\u0430\u044e\u0449\u0438\u0445\n\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u0441\u0438\u043d\u0442\u0435\u0437\u0430\n\u0434\u0440\u0443\u0433\u0438\u0445 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\n\u0432\u0430\u0436\u043d\u044b\u0445 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0439.\n\u041f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0413\u0440\u0443\u043f\u043f\u0430 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u041a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0438 \u0414\u043b\u044f \u0432\u0441\u0435\u0445 \u0412\u0423\u0418 \u0435\u0441\u0442\u044c \u0440\u044f\u0434\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 \u044d\u043c\u0431\u0440\u0438\u043e\u043d\u0430, \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043e\u0431\u0449\u0438\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432.\n\u043f\u043b\u043e\u0434\u0430 \u0438\u043b\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u043d\u044b\u0439\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e, IgM/IgG-\u0430\u043d\u0442\u0438\u0442\u0435\u043b \u0430\u043a\u0443\u0448\u0435\u0440\u0441\u043a\u043e-\n\u0432\u044b\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u0432\u0438\u0440\u0443\u0441\u0430\u043c\u0438, \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f\u043c\u0438, \u0438\u043c\u043c\u0443\u043d\u043e\u0431\u043b\u043e\u0442\u0442\u0438\u043d\u0433\u0430, \u0430\u043d\u0430\u043c\u043d\u0435\u0437.\n\u043f\u0440\u043e\u0441\u0442\u0435\u0439\u0448\u0438\u043c\u0438 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u044e\u0442 \u0438\u043d\u0434\u0435\u043a\u0441 \u041f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u0430\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0438 IgG- \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438.\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b \u0438 \u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u0432\u044b\u044f\u0432\u043b\u044f\u044e\u0442 \u043c\u043e\u0447\u0435\u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a\u043b\u0430\u0441\u0441\u0430 \u043c\u0430\u0442\u0435\u0440\u0438.\u0418\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n\nIgM \u0438 IgG \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043b\u044e\u0431\u044b\u0445\n\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\u043c \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\n\u0418\u0424\u0410. \u041f\u0426\u0420- \u0443 \u043c\u0430\u0442\u0435\u0440\u0438. \u0414\u043b\u044f \u0432\u0441\u0435\u0445 \u0412\u0423\u0418\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430. \u0435\u0441\u0442\u044c \u0440\u044f\u0434 \u043e\u0431\u0449\u0438\u0445\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432. \u0421\u0445\u043e\u0436\u0435\u0441\u0442\u044c\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c\u0438\n\u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043c\u0438:\n\u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u0435\u0439. \u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430\n\u0432\u043d\u0443\u0442\u0440\u0438\u0443\u0442\u0440\u043e\u0431\u043d\u043e\u0433\u043e\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f,\n\u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f,\n\u0441\u0442\u0438\u0433\u043c\u044b\n\u0434\u0438\u0441\u044d\u043c\u0431\u0440\u0438\u043e\u0433\u0435\u043d\u0435\u0437\u0430,\n\u0440\u0430\u043d\u043d\u044f\u044f \u0438\u043b\u0438\n\u043f\u0440\u043e\u043b\u043e\u0433\u043d\u0438\u0440\u043e\u0