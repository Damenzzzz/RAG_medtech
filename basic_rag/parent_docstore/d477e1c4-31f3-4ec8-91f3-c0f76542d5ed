\u2022 \u041f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 60 \u043c\u0438\u043d. \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u0445.\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439\n\u0410\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433 No1 \u041f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0433\u0438\u043f\u043e\u0442\u0435\u0440\u043c\u0438\u0438.\n\u0436\u0438\u0437\u043d\u0435\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438,\n\u2022 \u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043d\u0430\u0440\u043a\u043e\u0437, \u041f\u0440\u0438 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043a\u043e\u0430\u0433\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438: \u043f\u043e\u0441\u043b\u0435 8-10\n\u043a\u0440\u043e\u0432\u043e\u043f\u043e\u0442\u0435\u0440\u0438, \u043b\u0435\u0447\u0435\u0431\u043d\u044b\u0445\n\u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439, \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e- \u2022 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439, \u0434\u0438\u0443\u0440\u0435\u0437\u0430 \u0434\u043e\u0437 \u042d\u041c \u0438 \u0432\u043e\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0441\u0432\u0435\u0440\u0442\u044b\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043e\n\u0442\u0440\u0430\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0410\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433 No2 (\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c): \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0438 \u0440\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u043e\u0440\u0430 VII 90 \u043c\u043a\u0433/\u043a\u0433.\n\u041f\u043e\u0441\u043b\u0435 \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0432\n\u0410\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433 No1: \u0413\u043e\u0442\u043e\u0432\u0438\u0442 \u2022 \u0432\u0432\u043e\u0434\u0438\u0442 \u0432\u0442\u043e\u0440\u0443\u044e \u0434\u043e\u0437\u0443 \u0442\u0440\u0430\u043d\u0435\u043a\u0441\u0430\u043c\u043e\u0432\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u044b 1000 \u043c\u0433 \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0441\u043e\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 1 \u043c\u043b/\u043c\u0438\u043d \u0447\u0435\u0440\u0435\u0437 30 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0432\u043e\u0439 \u0434\u043e\u0437\u044b\n\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0430 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u2022 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u0443\u0435\u0442 \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443,\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439, \u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u0438 \u2022 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u041a\u041e\u0421 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u0438,\n\u0442\u0440\u0430\u0445\u0435\u0438 \u0422\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u043e\u043b\u043e\u0433 \u0438\n\u2022 \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043b\u0430\u0441\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f/\u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043b\u0430\u0441\u0442\u043e\u043c\u0435\u0442\u0440\u0438\u044f [ROTEM/TEG]); NB! \u0414\u0430\u043d\u043d\u044b\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u043f\u043e \u0431\u043e\u0440\u044c\u0431\u0435 \u0441 \u041f\u0420\u041a \u043d\u043e\u0441\u0438\u0442\n\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0441\u0442\u043a\u0430:\n\u2022 \u0432\u0432\u043e\u0434\u0438\u0442 \u0432\u0430\u0437\u043e\u043f\u0440\u0435\u0441\u0441\u043e\u0440\u044b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440. \u041a\u0430\u0436\u0434\u043e\u0435 \u0440\u043e\u0434\u043e\u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\u0433\u043e\u0442\u043e\u0432\u044f\u0442 \u043a\u0440\u043e\u0432\u044c \u0438\n\u0410\u043a\u0443\u0448\u0435\u0440\u043a\u0430 No1: \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u043f\u043e\u0434 \u0441\u0432\u043e\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438\n\u043a\u0440\u043e\u0432\u0435\u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435\u043b\u0438\n\u2022 \u