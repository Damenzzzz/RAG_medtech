 \u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043c \u0438\u0437\u043e\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0439 - \u043d\u0430\n\u043a\u0440\u043e\u0432\u043e\u0442\u043e\u043a\u0430 \u0438 \u0432\u044b\u043c\u044b\u0432\u0430\u043d\u0438\u044f \u0432 \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0439\n\u04222-\u0432\u0437\u0432\u0435\u0448\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u0445.\n\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435\u043c \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u0444\u0430\u0437\u0435\n\u0413\u0438\u043f\u0435\u0440\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u0447\u0430\u0441\u0442\u043e\n\u043f\u0440\u0438 \u0423\u0417\u0414\u0413\n\u0433\u0435\u0442\u0435\u0440\u043e\u0433\u0435\u043d\u043d\u043e\u0435, \u0441 \u043d\u0435\u0440\u043e\u0432\u043d\u044b\u043c \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u043c,\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0430 \u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0430\u0437\u0435 \u0438\n\u0444\u0435\u043d\u043e\u043c\u0435\u043d\u043e\u043c \u0432\u044b\u043c\u044b\u0432\u0430\u043d\u0438\u044f \u0432 \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0439 \u0444\u0430\u0437\u0435\n\u0414\u0438\u0441\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0437\u0435\u043b \u0426\u041f \u0427\u0430\u0449\u0435 \u0433\u0438\u043f\u043e\u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0435 \u0424\u0430\u0437\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0413\u0438\u043f\u0435\u0440\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u04221-\u0438 \u0438\u0437\u043e- \u0438\u