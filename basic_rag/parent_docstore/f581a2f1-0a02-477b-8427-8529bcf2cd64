u0440\u0435\u0441\u0441\u043e\u0440\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u0430\u044f \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u0434\u043b\u044f\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u043c\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430, \u043c\u043e\u0436\u0435\u0442\n\n\u0443\u0445\u0443\u0434\u0448\u0438\u0442\u044c \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044e.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 5 - \u0412\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u0432 \u0438 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u043e\u0432 \u0446\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u0414\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u041f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438\n(\u0435\u0441\u043b\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u0438 \u0434\u043e\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438)\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\n\u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0414\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043c\u043b\u0430\u0434\u0448\u0435 5 \u0414\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043c\u043b\u0430\u0434\u0448\u0435 5 \u043b\u0435\u0442:\n\u0433\u0435\u043c\u043e\u0444\u0438\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043b\u0435\u0442: \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\u043f\u0430\u043b\u043e\u0447\u043a\u0438 \u0442\u0438\u043f\u0430 b \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u043f\u043e\u0440\u044f\u0434\u043a\u0435. \u043f\u043e\u0440\u044f\u0434\u043a\u0435.\n\n(Hib) \u041b\u0438\u0446\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 5 \u043b\u0435\u0442: \u041b\u0438\u0446\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 5 \u043b\u0435\u0442:\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0430 \u0434\u043e\u0437\u0430, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0430 \u0434\u043e\u0437\u0430,\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c\n\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 A \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f. (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\n\u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430\u043c \u043d\u0430\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044e \u0441\n\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 B \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 (\u043f\u043e\u0441\u043b\u0435\n\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430\u043c\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u044f\n\u0434\u043e\u0437\u0430. \u041f\u043e\u0441\u043b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u0438\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\nanti- HBs \u0441 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c\n\u0440\u0435\u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u0438, \u0435\u0441\u043b\u0438 \u043e\u0442\u0432\u0435\u0442\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043c\u0435\u043d\u0435\u0435 10 \u041c\u0415/\u041b.\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\n\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0442\u0438\u0442\u0440\u043e\u0432 anti-HBs)\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0433\u043e\u0434 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0433\u043e\u0434\n\u0433\u0440\u0438\u043f\u043f\u0430\n\n(\u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f)\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\u043a\u043e\u043a\u043b\u044e\u0448\u0430 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435\n\n\u041f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u0430\u044f \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f (\u0434\u043e\u043b\u0436\u043d\u0430 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u043a\u043e\u043d\u044a\u044e\u0433\u0430\u0442\u043d\u0430\u044f 13-\u0438 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u2013 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c,\n\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u0441\u043f\u0443\u0441\u0442\u044f 2 \u043c\u0435\u0441\u044f\u0446\u0430 \u0438\u043b\u0438 \u043f\u0440\u0438\n\u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0434\u0432\u0443\u0445\n\n\u043b\u0435\u0442 \u2013 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\n\u043f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u043e\u0439\n\u043f\u043e\u043b\u0438\u0441\u0430\u0445\u0430\u0440\u0438\u0434\u043d\u043e\u0439 \u0432\u0430\u043a\u0446\u0438\u043d\u044b )\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435\n(\u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f)\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c\n\n\u0431\u0435\u0448\u0435\u043d\u0441\u0442\u0432\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f (\u043d\u0435 \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\n\u0432\u043d\u0443\u0442\u0440\u0438\u043a\u043e\u0436\u043d\u043e.\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435).\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c\n\u0441\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u0430 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f 1 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f 1\n\u043a\u043e\u0440\u0438, \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438,\n\n\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u043f\u0430\u0440\u043e\u0442\u0438\u0442\u0430\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f; \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\n\u0433\u0440\u0438\u043f\u043f\u0430 (\u0436\u0438\u0432\u0430\u044f) \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u0432\u0430\u043a\u0446\u0438\u043d\u0443\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430\n\u0436\u0435\u043b\u0442\u043e\u0439 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430\n\u0431\u0430\u0446\u0438\u043b\u043b\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\n\n\u041a\u0430\u043b\u044c\u043c\u0435\u0442\u0442\u0430-\u0413\u0435\u0440\u0435\u043d\u0430\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f; \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\n\u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u0432\u0430\u043a\u0446\u0438\u043d\u0443\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430\n\n\u0433\u0435\u043c\u043e\u0444\u0438\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\n\u0433\u0440\u0438\u043f\u043f\u0430 \u0442\u0438\u043f\u0430 b (Hib)\n\n1 \u041c\u043e\u0436\u0435\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c\u0441\u044f \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0448\u0435\u0441\u0442\u0438 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u0435\u0441\u043b\u0438\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044f \u043e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f \u0434\u043e 12 - 15 \u043c\u0435\u0441\u044f\u0446\u0430 \u0436\u0438\u0437\u043d\u0438.\n\n\u2022 \u0412\u0418\u0427-\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u042f [13,14].\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 \u0448\u0438\u0440\u043e\u043a\u043e \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u0435\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \u043b\u0438\u0446,\n\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0412\u0418\u0427, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0430\u0434\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0438 \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0430\n\u0430\u043d\u0442\u0438\u0440\u0435\u0442\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e. \u041f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\n\u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c\u0443 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0443 CD4 \u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0443 CD4.\n\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u0435 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445\n\u0432\u0430\u043a\u0446\u0438\u043d, \u0445\u043e\u0442\u044f \u044d\u0442\u043e \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044e.\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u0438\u0432\u0438\u0432\u043a\u0438 \u043b\u0438\u0446\u0430\u043c,\n\n\u0436\u0438\u0432\u0443\u0449\u0438\u0445 \u0441 \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439 (\u0434\u0430\u043b\u0435\u0435 - \u041b\u0416\u0412):\n1) \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0438\u0432\u0438\u0432\u043a\u0438 \u043b\u0438\u0446 \u0441 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u043e\u043c \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0438 \u0434\u0435\u0442\u0435\u0439,\n\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u043e\u0442 \u0412\u0418\u0427-\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u0438, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435\n\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0432\u0440\u0430\u0447\u0430 \u0446\u0435\u043d\u0442\u0440\u0430 \u043f\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0435 \u0438 \u0431\u043e\u0440\u044c\u0431\u0435 \u0441\u043e \u0421\u041f\u0418\u0414;\n2) \u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u043b\u044e\u0434\u0435\u0439 \u0441\n\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0438\u043c\u043c\u0443\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043d\u0430 \u0442\u0435\u0445 \u0436\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u0445, \u0447\u0442\u043e\n\u0438 \u0434\u043b\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0445 \u043b\u044e\u0434\u0435\u0439;\n3) \u0436\u0438\u0432\u044b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b \u0412\u0418\u0427-\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0441\u043e\n\u0441\u0440\u0435\u0434\u043d\u0435\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0435\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441\n\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u0412\u0418\u0427-\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438;\n4) \u0443 \u041b\u0416\u0412, \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0438\u0445 \u0438\u043b\u0438 \u0438\u043c\u0435\u044e\u0449\u0438\u0445 \u0441\u043b\u0430\u0431\u043e\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0438, \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f \u0436\u0438\u0432\u044b\u043c\u0438 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u043c\u0438, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0442\u0430\u043a \u0436\u0435 \u043a\u0430\u043a \u0443\n\u043d\u0435\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0412\u0418\u0427\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 6- \u0412\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f \u0412\u0418\u0427-\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043b\u0438\u0446\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\n\u0418\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u043b\u0430\u043d\u04431\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0414\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043c\u043b\u0430\u0434\u0448\u0435 5 \u043b\u0435\u0442:\n\n\u043f\u0430\u043b\u043e\u0447\u043a\u0438 \u0442\u0438\u043f\u0430 b (Hib) \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u043b\u0430\u043d\u0443.\n\u041b\u0438\u0446\u0430 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 5 \u043b\u0435\u0442:\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0430 \u0434\u043e\u0437\u0430,\n\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 A \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0435\n(\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0412\u0418\u0427-\n\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043b\u0438\u0446 \u0441 \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u043c\u0438\n\u0440\u0438\u0441\u043a\u0430, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043c\u0443\u0436\u0447\u0438\u043d\u044b,\n\n\u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u044e\u0449\u0438\u0435 \u043f\u043e\u043b\u043e\u0432\u044b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b \u0441\n\u043c\u0443\u0436\u0447\u0438\u043d\u0430\u043c\u0438, \u0438\u043b\u0438 \u043b\u0438\u0446\u0430,\n\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u044e\u0449\u0438\u0435 \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0435\n\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u043a\u0438.\n\n\u041f\u0440\u0435\u0434\u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432: \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0430 \u0441 \u0432\u0430\u043a\u0446\u0438\u043d\u043e\u0439\n\u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 A.\n\u041f\u043e\u0441\u0442\u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430:\n\n\u0418\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u043d\u0430\u0440\u044f\u0434\u0443 \u0441 \u0432\u0430\u043a\u0446\u0438\u043d\u043e\u0439 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430\nA).\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 B \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u0421\u0445\u0435\u043c\u0443 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u0432\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435\u043c CD4\n\u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432:", "type": "Document"}}