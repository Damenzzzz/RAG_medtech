42\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n4. \u041c\u0430\u043a\u0430\u043b\u043a\u0438\u043d\u0430 \u041b\u0430\u0440\u0438\u0441\u0430 \u0413\u0435\u043d\u043d\u0430\u0434\u0438\u0435\u0432\u043d\u0430, \u041d\u0410\u041e \"\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\"\n\u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, PhD, MD, \u0434\u043e\u0446\u0435\u043d\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb.\n5. \u0413\u0430\u0431\u0431\u0430\u0441\u043e\u0432\u0430 \u0421\u0430\u0443\u043b\u0435 \u0422\u043b\u0435\u043c\u0431\u0430\u0435\u0432\u043d\u0430, \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e-\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439\n\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438, \u043c\u0430\u0433\u0438\u0441\u0442\u0440 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f, \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0446\u0435\u043d\u0442\u0440\u0430\n\n\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0441 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0435\u0439 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n6. \u041a\u043b\u043e\u0434\u0437\u0438\u043d\u0441\u043a\u0438\u0439 \u0410\u043d\u0442\u043e\u043d \u0410\u043d\u0430\u0442\u043e\u043b\u044c\u0435\u0432\u0438\u0447, \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438,\n\u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0410\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0420\u041e\u041e\n\u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0432\u0440\u0430\u0447\u0435\u0439-\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0432.\n\n7. \u0420\u0430\u043c\u0430\u0437\u0430\u043d\u043e\u0432\u0430 \u0420\u0430\u0439\u0433\u0443\u043b\u044c \u041c\u0443\u0445\u0430\u043d\u0431\u0435\u0442\u043e\u0432\u043d\u0430, \u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e-\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb \u0417\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0443\u0440\u0441\u043e\u043c\n105\n\n\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433, \u0447\u043b\u0435\u043d \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0439\n\n\u0430\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u043e\u0432.\n8. \u0411\u0430\u0439\u0434\u0443\u0440\u0438\u043d \u0421\u0435\u0440\u0438\u043a \u0410\u043c\u0430\u043d\u0433\u0435\u043b\u044c\u0434\u0438\u043d\u043e\u0432\u0438\u0447, \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\n\u0410\u0441\u0442\u0430\u043d\u0430\u00bb \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 No1, \u0432\u0440\u0430\u0447\n\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433, \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442, \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n\n9. \u0420\u0430\u0445\u0438\u043c\u0431\u0435\u043a\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440 \u0410\u044f\u043f\u0431\u0435\u043a\u043e\u0432\u0430, \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb\n\u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 No1, \u0432\u0440\u0430\u0447\n\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n10. \u041c\u0443\u043a\u0430\u0436\u0430\u043d\u043e\u0432 \u0410\u0434\u0438\u043b\u044c\u0431\u0435\u043a \u041a\u0430\u0438\u0440\u0431\u0435\u043a\u043e\u0432\u0438\u0447, \u0422\u041e\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440\u00bb \u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u041f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044f \u041f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0434\u043e\u0446\u0435\u043d\u0442, \u0432\u0440\u0430\u0447 \u0445\u0438\u0440\u0443\u0440\u0433.\n11. \u0422\u0443\u0440\u0433\u0430\u043d\u0431\u0435\u043a\u043e\u0432\u0430 \u0410\u0438\u0434\u0430 \u0410\u0441\u043a\u0430\u0440\u043e\u0432\u043d\u0430, \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041d\u0430\u0443\u0447\u043d\u043e-\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439\n\u0446\u0435\u043d\u0442\u0440 \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb \u041c\u0417 \u0420\u041a \u0417\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0435\u0439 \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\n\u0442\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u043a\u0430\u043d\u0435\u0439.\n\n2) \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\n\n3) \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442:\n\n1. \u0423\u0440\u0430\u0437\u043e\u0432\u0430 \u0421\u0432\u0435\u0442\u043b\u0430\u043d\u0430 \u041d\u0443\u0440\u0433\u043e\u0436\u0430\u0435\u0432\u043d\u0430 \u2013 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b No3 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb, \u0427\u043b\u0435\u043d \u00ab\u0410\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438 \u0430\u043b\u043b\u0435\u0440\u0433\u043e\u043b\u043e\u0433\u043e\u0432 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u043e\u0432\u00bb \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d.\n\n2. \u0422\u0443\u0440\u0433\u0443\u043d\u043e\u0432\u0430 \u041b\u044e\u0434\u043c\u0438\u043b\u0430 \u0413\u0435\u043d\u043d\u0430\u0434\u044c\u0435\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\n\u043a\u0430\u