{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_da5d0d185ab8", "title": "\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u041d\u0418\u0415 \u041f\u0420\u0415\u041f\u0410\u0420\u0410\u0422\u041e\u0412 \u0414\u041e\u041d\u041e\u0420\u0421\u041a\u041e\u0419 \u041a\u0420\u041e\u0412\u0418", "source_file": "2025_\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u041d\u0418\u0415_\u041f\u0420\u0415\u041f\u0410\u0420\u0410\u0422\u041e\u0412_\u0414\u041e\u041d\u041e\u0420\u0421\u041a\u041e\u0418_\u041a\u0420\u041e\u0412\u0418_3efda75270.pdf", "icd_codes": "B50", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0418\u0421\u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u041d\u0418\u0415 \u041f\u0420\u0415\u041f\u0410\u0420\u0410\u0422\u041e\u0412 \u0414\u041e\u041d\u041e\u0420\u0421\u041a\u041e\u0419 \u041a\u0420\u041e\u0412\u0418.pdf"}, "page_content": "\u2022 \u0414\u043b\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0432\u0435\u043d\u043e\u0437\u043d\u0443\u044e \u043b\u0438\u043d\u0438\u044e.\n\u2022 \u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u0438 \u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0435\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c\n\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0433\u043e.\n\u2022 \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0435\u0440\u0435\u0434 \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u0435\u0439 \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430.\n\n\u2022 \u0410\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d \u0447\u0435\u0440\u0435\u0437 1 \u0447\u0430\u0441 \u0438 24 \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u044f.\n\n\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0430\u043b\u043b\u043e\u0438\u043c\u043c\u0443\u043d\u043d\u043e\u0439 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u043c\u0430\u0441\u0441\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0438\u043c\u0435\u0442\u044c\n\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438:\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u043e\u0432 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432 \u0447\u0435\u043b\u043e\u0432\u0435\u043a (\u0413\u0410\u0422), \u043f\u0440\u043e\u0442\u0438\u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0443\n\u043c\u0430\u0442\u0435\u0440\u0438 \u0432\u044b\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430: \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0434\u043e\u043d\u043e\u0440\u043e\u0432,\n\u0442\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c\u0443 \u0413\u0410\u0422, \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u044b \u043c\u0430\u0442\u0435\u0440\u0438\u043d\u0441\u043a\u0438\u0435\n\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u043e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u044b \u043f\u0443\u0442\u0435\u043c \u0430\u0444\u0435\u0440\u0435\u0437\u0430, \u043f\u0440\u043e\u043c\u044b\u0442\u044b \u0434\u043b\u044f\n\u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0437\u043c\u044b, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0439 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430, \u0438 \u043e\u0431\u043b\u0443\u0447\u0435\u043d\u044b;\n\n\u0418\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435 \u043d\u0430 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e [13].\n\n\u2022 \u0412 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0438 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0446\u0435\u043b\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430, \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f\n\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 \u043a\u0440\u043e\u0432\u0438, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u0440\u0438\u0441\u043a\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u043e\u0431\n\u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430\u0445 \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u044e. \u042d\u0442\u0430 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u043b\u0435\u0436\u0430\u0442\u044c \u043d\u0430 \u043b\u0435\u0447\u0430\u0449\u0435\u043c\n\u0432\u0440\u0430\u0447\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043b\u0436\u0435\u043d \u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0449\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435.\n\n3. \u041e\u0420\u0413\u0410\u041d\u0418\u0417\u0410\u0426\u0418\u041e\u041d\u041d\u042b\u0415 \u0410\u0421\u041f\u0415\u041a\u0422\u042b \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b\u0410.\n3.1 \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u0434\u0430\u043d\u043d\u044b\u0445:\n\n1) \u0411\u043e\u0436\u0431\u0430\u043d\u0431\u0430\u0435\u0432\u0430 \u041d\u0438\u0448\u0430\u043d\u043a\u0443\u043b\u044c \u0421\u0435\u0439\u0442\u0431\u0435\u043a\u043e\u0432\u043d\u0430, \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u041d\u041c\u0423 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414.\n\u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb, \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n2) \u0421\u0443\u043b\u0435\u0439\u043c\u0435\u043d\u043e\u0432\u0430 \u0418\u043d\u0434\u0438\u0440\u0430 \u0415\u0441\u043a\u0435\u0440\u043c\u0435\u0441\u043e\u0432\u043d\u0430, \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0434\u043e\u0446\u0435\u043d\u0442\n\u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u041d\u041c\u0423 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb,\n\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433-\u043f\u0435\u0434\u0438\u0430\u0442\u0440, \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433.\n3) \u0410\u043b\u0442\u044b\u043d\u0431\u0430\u0435\u0432\u0430 \u0413\u0443\u043b\u044c\u043c\u0438\u0440\u0430 \u0411\u0435\u043a\u043d\u0430\u0437\u0430\u0440\u043e\u0432\u043d\u0430 PhD, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0410\u041e \u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438\n\u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb, \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n\n4) \u041a\u0430\u0440\u0438\u043d \u0411\u0435\u043a\u0442\u0443\u0440\u0433\u0430\u043d \u0422\u044b\u043d\u044b\u043c\u0431\u0430\u0435\u0432\u0438\u0447, \u043c\u0430\u0433\u0438\u0441\u0442\u0440, \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb, \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439 \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433 \u041c\u0417\n\u0420\u041a.\n\n3.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n\n3.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n\n1) \u0416\u0443\u0431\u0430\u043d\u044b\u0448\u0435\u0432\u0430 \u041a\u0430\u0440\u043b\u044b\u0433\u0430\u0448 \u0411\u0438\u0440\u0436\u0430\u043d\u043e\u0432\u043d\u0430, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e-\u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n\n2) \u041a\u0430\u0447\u0443\u0440\u0438\u043d\u0430 \u0414\u0438\u043b\u0430\u0440\u0430 \u0420\u0430\u0434\u0438\u043a\u043e\u0432\u043d\u0430, \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043a\u0430\u0444\u0435\u0434\u0440\u044b\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e-\u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430,\n\u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433.\n3) \u0423\u043c\u0431\u0435\u0442\u043e\u0432 \u041a\u0443\u0430\u043d\u044b\u0448 \u041e\u0440\u044b\u043d\u0431\u0430\u0441\u0430\u0440\u043e\u0432\u0438\u0447, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0430\u0444\u0435\u0440\u0435\u0437\u0430 \u0410\u041e\n\n\u00ab\u041d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb, \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u043e\u043b\u043e\u0433.\n4) \u0422\u0430\u0448\u0435\u043d\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u0422\u0430\u043b\u0438\u043f\u043e\u0432\u043d\u0430, \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f\n\u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u041d\u0410\u041e \u00ab\u041a\u0430\u0437\u041d\u041c\u0423 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430, \u0433\u043b\u0430\u0432\u043d\u044b\u0439\n\u0432\u043d\u0435\u0448\u0442\u0430\u0442\u043d\u044b\u0439 \u043f\u0435\u0434\u0438\u0430\u0442\u0440 \u041c\u0417 \u0420\u041a, \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n\n5) \u0427\u0430\u0440\u0438\u043f\u043e\u0432\u0430 \u0411\u0438\u0431\u0438\u0433\u0443\u043b\u044c \u0422\u043e\u043b\u0435\u0433\u0435\u043d\u043e\u0432\u043d\u0430, \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043d\u0435\u043e\u043d\u0430\u0442\u043e\u043b\u043e\u0433\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u041a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\u0444\u043e\u043d\u0434\u0430 \u00abUMC\u00bb.\n\n3.4 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0447\u0435\u0440\u0435\u0437 5\n\u043b\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0441 \u0434\u0430\u0442\u044b \u0435\u0433\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438\n\u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u043e\