44f\u0445 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0439 \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u043a\u0443\u0440\u0441 \u041a\u0421\n(\u0431\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 12 \u043c\u0433 \u0432/\u043c \u043a\u0430\u0436\u0434\u044b\u0435 24 \u0447\u0430\u0441\u0430) \u0434\u0432\u0430\u0436\u0434\u044b \u0441 \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c\n\u0447\u0435\u0440\u0435\u0437 24 \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0434\u043e\u0437\u044b \u043f\u0440\u0438 \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433\u0435;\n36\n\n\u2212 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438 \u0438\n\n\u043f\u043b\u043e\u0434\u0430 \u2013 \u043d\u0435\u0437\u0430\u043c\u0435\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435.\n\u2022\n\u0435\u0441\u043b\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0430 \u0443\u0436\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0440\u043e\u0434\u0430\u0445:\n\u2212 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0434\u0438\u0441\u0442\u0440\u0435\u0441\u0441\u0430, \u043a\u043e\u0430\u0433\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438,\n\u043c\u0443\u043b\u044c\u0442\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0444\u0443