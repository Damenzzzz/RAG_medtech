\u0430\u043d\u0438\u0435\u043c \u0431\u0435\u043b\u043a\u0430 \u0438 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u043e\u0432, \u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430\n\u0431\u043e\u0433\u0430\u0442\u044b\u0435 \u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c \u0438 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u043e\u043c D (\u0423\u0414 \u2013 \u0414);\n\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\u2022 \u0424\u0438\u0437\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f \u2013 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a, \u043b\u0430\u0437\u0435\u0440\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043c\u0430\u0433\u043d\u0438\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043f\u0430\u0440\u0430\u0444\u0438\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0444\u043e\u0440\u0435\u0437 (\u043f\u0440\u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0410\u0412\u0421) (\u0423\u0414 \u2013 \u0421);\n\n\u2022 \u0421\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0440\u0442\u0435\u0437\u044b \u0442\u0438\u043f\u0430 \u0448\u0438\u043d, \u043b\u043e\u043d\u0433\u0435\u0442, \u0441\u0442\u0435\u043b\u0435\u043a \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u0440\u0435\u0437\u044b \u0432 \u0432\u0438\u0434\u0435\n\u043b\u0435\u0433\u043a\u0438\u0445 \u0441\u044a\u0435\u043c\u043d\u044b\u0445 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u0432 [2 \u2013 4] (\u0423\u0414 \u2013 \u0414);\n\u2022 \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 (\u0423\u0414 \u2013 \u0414);\n\u2022 \u0421\u043b\u0443\u0445\u043e\u0432\u044b\u0435 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u044b (\u0423\u0414 \u2013 \u0421) \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f\u0445.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [1,2,6,7,9 \u2013 12,15,18, 21 - 33]:\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f\n\u0433\u0440\u0443\u043f\u043f\u0430/ \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0423\u0414\n\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u041e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n\u041a\u043e\u043b\u0445\u0438\u0446\u0438\u043d \u0434\u0435\u0442\u0438 4\u20136 \u043b\u0435\u0442 \u2013 \u043e\u0442 0,3 \u0434\u043e 1,8 \u043c\u0433, \u0434\u0435\u0442\u0438 \u041d\u0435 \u043c\u0435\u043d\u0435\u0435 5 \u043b\u0435\u0442 \u0410\n7\u201312 \u043b\u0435\u0442 \u2013 \u043e\u0442 0,9 \u0434\u043e 1,8 \u043c\u0433, \u0434\u0435\u0442\u0438\n\u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u2013 \u043e\u0442 1,2 \u0434\u043e 2,4 \u043c\u0433\n\u0413\u0435\u043d\u043d\u043e-\u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e-\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n\n\u042d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442 \u043f/\u043a, \u0441 2 \u043b\u0435\u0442 - 0,4 \u043c\u0433/\u043a\u0433 - 2 \u0440\u0430\u0437\u0430 \u0432 \u0420\u0430\u043d\u043d\u0435\u0435 \u0412\n\u043d\u0435\u0434. \u0438\u043b\u0438 \u0441 8 \u043b\u0435\u0442 \u0438 \u0441\u0442\u0430\u0440\u0448\u0435 - 0,8 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\u043c\u0433/\u043a\u0433/\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n\u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u0441 6 \u043b\u0435\u0442, 2\u20133 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438; \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a \u0421\n\u0438\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435\n\u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0441 6 \u043c\u0435\u0441, 10 \u2013 15 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442; \u043a\u0443\u0440\u0441\u044b\n\n\u043c\u043e\u043d\u0