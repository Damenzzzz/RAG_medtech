440\u0430\u043f\u0438\u0438\n\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\n\u0438\u0434\u0430\u043c\u0438 \u0434\u043e\u043b\u044c\u0448\u0435\n2- 4 \u043d\u0435\u0434.\n\n\u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0432\u043d\u0443\u0442\u0440\u044c \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 5 \u043c\u0433, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3\u20134 \u0412\n\u0432 \u0434\u043e\u0437\u0435 0,5-2 \u043c\u0433/\u043a\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0441\u0443\u0442. \u0438 \u0437\u0430\u0442\u0435\u043c\n\u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u0430\u044f\n\u043e\u0442\u043c\u0435\u043d\u0430\n\u041d\u0435\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0438\u0434\n\u0430\u043c\u0438 \u0434\u043e\u043b\u044c\u0448\u0435 2- 4\n\u043d\u0435\u0434.\n\n\u0410\u043d\u0442\u0438\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0442\n\u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u0432 \u0434\u043e\u0437\u0435 15 \u043c\u0433/\u043c2 1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0421\n\u0432\u043d\u0443\u0442\u0440\u044c \u0438 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432\u0440\u0435\u043c\u0435\u043d\u0438\n\u0412\u0438\u0442\u0430\u043c\u0438\u043d ( \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442\u043e\u043c)\n\u0424\u043e\u043b\u0438\u0435\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, \u043d\u0435 \u043c