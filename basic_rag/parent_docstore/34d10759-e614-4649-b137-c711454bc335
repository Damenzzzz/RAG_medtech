\u0437\u0438\u0438\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e 5\u201310 \u043c\u0438\u043d \u2014\n2 \u043c\u0433/\u043a\u0433, \u043f\u0440\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 1/2\u20131/3 \u043e\u0442\n\u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u043e\u0437\u044b \u0438\u043b\u0438\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043d\u0430\n\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435 \u0441\u043e\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 20\u201360 \u043a\u0430\u043f/ \u043c\u0438\u043d\n\n\u041d\u0430\u0440\u043a\u043e\u0437\u043d\u044b\u0435 \u0437\u0430\u043a\u0438\u0441\u044c \u0430\u0437\u043e\u0442\u0430 (1:1 \u0441 \u041e ) \u0438\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u043e A\n2\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u043b\u0438 \u0441\u0435\u0432\u043e\u0444\u043b\u044e\u0440\u0430\u043d\u043e\u043c\n\u041d\u0430\u0440\u043a\u043e\u0437\u043d\u044b\u0435 \u043f\u0440\u043e\u043f\u043e\u0444\u043e\u043b \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0438\u043b\u0438 \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e (\u224840 \u043c\u0433 \u0412\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043a\u0430\u0436\u0434\u044b\u0435 10 \u0441\u0435\u043a\u0443\u043d\u0434). \u0414\u043b\u044f\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u043e\u0431\u0449\u0435\u0439 \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u044f\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 4 -12 \u043c\u0433/\u043a\u0433/\u0447\n\u041d-\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0438, \u0441\u0443\u043a\u0441\u0430\u043c\u0435\u0442\u043e\u043d\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434 \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e, \u0412\n\u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u044b 1,5\u20132 \u043c\u0433/\u043a\u0433\n\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u044b\u0435 \u0444\u0435\u043d\u0442\u0430\u043d\u0438\u043b \u0414\u043b\u044f \u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u0438 \u0432\u0432\u043e\u0434\u044f\u0442 \u0432/\u043c \u0437\u0430 30 \u0412\n\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0438\u043d \u0434\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0432 \u0434\u043e\u0437\u0435 50 \u2013100 \u043c\u043a\u0433,\n\u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0438 5-6 \u043c\u043a\u0433/\u043a\u0433/\u0447\u0430\u0441, \u0434\u043b\u044f \u0432\u0432\u043e\u0434\u043d\u043e\u0439\n\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438 - \u0432/\u0432 \u0432 \u0434\u043e\u0437\u0435 100 \u2013 200 \u043c\u043a\u0433,\n\u0434\u043b\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0433\u043e\n\u0443\u0440\u043e\u0432\u043d\u044f \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0437\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u0436\u0434\u044b\u0435 10\n\u2013 30 \u043c\u0438\u043d 50 \u2013 150 \u043c\u043a\u0433\n\u041d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u043e\u0440\u0444\u0438\u043d \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e \u0421\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u044b, \u0432 \u0442.\u0447. \u0444\u0438\u0442\u043e\u043c\u0435\u043d\u0430\u0434\u0438\u043e\u043d \u0441 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0446\u0435\u043b\u044c\u044e A\n\u0444\u0430\u043a\u0442\u043e\u0440\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 30 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0437\u0430 3\u20134 \u0434\u043d\u044f\n\u0441\u0432\u0435\u0440\u0442\u044b\u0432\u0430\u043d\u0438\u044f \u0434\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438. \u0412/\u0432 \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e,\n\u043a\u0440\u043e\u0432\u0438, \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 1 \u043c\u0433/\u043c\u0438\u043d.\n\u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0442\u0438\u043a\u0438\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u043e\u0435 \u043c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434 \u0432/\u043c \u0438\u043b\u0438 \u0432/\u0432 \u043f\u043e 10 \u043c\u0433 (2 \u043c\u043b \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 B\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c- 5 \u043c\u0433/\u043c\u043b) 1\u20133 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u043d\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 20 \u043c\u0433,\n\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0434\u043e\u0444\u0430\u043c\u0438- \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 60 \u043c\u0433\n\u043d\u043e\u0432\u044b\u0445 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432\n\n\u0414\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a\u0438 \u0434\u043e\u043f\u0430\u043c\u0438\u043d \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 2- \u0421\n\u0438 20\u043c\u043a\u0433/\u043a\u0433/\u043c\u0438\u043d \u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0427\u0421\u0421 \u0438\n\u043d\u0435\u0433\u043b\u0438\u043a\u043e\u0437\u0438\u0434\u043d\u044b\u0435\u043a\u0430\u0440 \u0410\u0414\n\u0434\u0438\u043e\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0410\u0434\u0440\u0435\u043d\u043e-\u0438 \u0441\u0438\u043c\u043f\u0430\u0442\u043e- \u044d\u043f\u0438\u043d\u0435\u0444\u0440\u0438\u043d \u041f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e: \u043f/\u043a, \u0440\u0435\u0436\u0435 \u2014 \u0432/\u043c \u0438\u043b\u0438 \u0412\n\u043c\u0438\u043c\u0435\u0442\u0438\u043a\u0438 (\u03b1-, \u03b2-), \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e 0,2-0,75 \u043c\u043b\n\u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u044b\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041d - \u0430\u043d\u0442\u0438\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d- \u0444\u0430\u043c\u043e\u0442\u0438\u0434\u0438\u043d \u0432/\u0432 (\u0441\u0442\u0440\u0443\u0439\u043d\u043e \u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e), \u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0421\n2\n\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043e\u0437\u0430 - \u043f\u043e 20 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441\u043e\u0432\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u044d\u043f\u0438\u043b\u0435\u043f\u0442\u0438\u0447 \u0434\u0438\u0430\u0437\u0435\u043f\u0430\u043c \u0432/\u043c, \u0432/\u0432 - \u043f\u043e 10-20 \u043c\u0433 \u0421\n\u0435\u0441\u043a\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430,\n\u0430\u043d\u043a\u0441\u0438\u043e\u043b\u0438\u0442\u0438\u043a\u0438\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432- \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c-\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421 \u043d\u043e\u0441\u0442\u0438\n\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438, \u0446\u0435\u0444\u0435\u043f\u0438\u043c \u0432/\u0432 \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e \u0437\u0430 60 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u0412\n\u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 2 \u0433 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 30 \u043c\u0438\u043d\u0443\u0442.\n\u041f\u0440\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438\n(\u0431\u043e\u043b\u0435\u0435 12 \u0447) \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0446\u0435\u0444\u0435\u043f\u0438\u043c\u0430 2 \u0433\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438, \u0433\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d \u0432/\u043c 3\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, 2\u20133\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0412\n\u0430\u043c\u0438\u043d\u043e\u0433\u043b\u0438\u043a\u043e\u0437\u0438\u0434\u044b\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438, \u0430\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d \u0432/\u043c 0,25-0,5 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 6-8 \u0447; \u043f\u0440\u0438 \u0412\n\u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u044b \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2013 1-2 \u0433 3-4\n\u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438,\u043a\u0430\u0440\u0431 \u043c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c \u0432/\u0432 \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 15\u201330 \u0412\n\u0430\u043f\u0435\u043d\u0435\u043c\u044b \u043c\u0438\u043d \u0432 \u0434\u043e\u0437\u0435 \u0434\u043e 2 \u0433 (\u043e\u0431\u044b\u0447\u043d\u043e 0,5\u20131 \u0433)\n\u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447 \u0438\u043b\u0438 \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n5 \u043c\u0438\u043d (\u043e\u0442 5 \u0434\u043e 20 \u043c\u043b)\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u044b\u0435 \u043c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0441\u043e \u0412\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430. \u0414\u0440\u0443\u0433\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f 5\u043c\u043b/\u043c\u0438\u043d.\n\u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\n\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041f\u0440\u043e\u0441\u0442\u0430\u0433\u043b\u0430\u043d\u0434\u0438\u043d\u044b, \u043c\u0438\u0437\u043e\u043f\u0440\u043e\u0441\u0442\u043e\u043b \u0447\u0430\u0449\u0435 \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e. \u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2014 \u0412\n\u0442\u0440\u043e\u043c\u0431\u043e\u043a\u0441\u0430\u043d\u044b, 400\u2013800 \u043c\u043a\u0433. \u041f\u0440\u0438 \u043f\u043b\u043e\u0445\u043e\u0439\n\u043b\u0435\u0439\u043a\u043e\u0442\u0440\u0438\u0435\u043d\u044b, \u0438\u0445 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\n\u0430\u043d\u0430\u043b\u043e\u0433\u0438 \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043e\u0432\u043e\u0439 \u0434\u043e\u0437\u044b \u0434\u043e 100 \u043c\u0433.\n\u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442\u044b\n\u041c\u0435\u0441\u0442\u043d\u043e- \u043b\u0438\u0434\u043e\u043a\u0430\u0438\u043d \u0434\u043b\u044f \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0439 \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u0438 \u2014 \u043d\u0435 \u0410\n\u0430\u043d\u0435\u0441\u0442\u0435\u0442\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0431\u043e\u043b\u0435\u0435 4 \u043c\u0433/\u043a\u0433\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n\u041d-\u0445\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a\u0438, \u0430\u0442\u0440\u0430\u043a\u0443\u0440\u0438\u044f \u0431\u0435\u0437\u0438\u043b\u0430\u0442 \u0431\u043e\u043b\u044e\u0441\u043d\u043e 0,3\u20130,6 \u043c\u0433/\u043a\u0433, \u0434\u0430\u043b\u0435\u0435 \u043f\u043e \u0421\n\n\u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u044b 0,1\u20130,2 \u043c\u0433/\u043a\u0433 \u0434\u0440\u043e\u0431\u043d\u043e \u0438\u043b\u0438\n\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u043e \u0441\u043e\n\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 0,3\u20130,6 \u043c\u0433/\u043a\u0433/\u0447. \u041f\u0440\u0438\n\u044d\u043d\u0434\u043e\u0442\u0440\u0430\u0445\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u0438:\n\u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0432\u043d\u0430\u0447\u0430\u043b\u0435 0,4\u2013\n0,5 \u043c\u0433/\u043a\u0433, \u0437\u0430\u0442\u0435\u043c 0,25\u20130,35 \u043c\u0433/\u043a\u0433.\n\u041f\u0440\u0438 \u0433\u0438\u043f\u0435\u0440\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a\n\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u0443 \u2014 0,3\u20130,4 \u043c\u0433/\u043a\u0433\n\u0410\u043d\u0430\u043b\u044c\u0433\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0442\u0440\u0430\u043c\u0430\u0434\u043e\u043b \u0432/\u0432 (\u0441\u0442\u0440\u0443\u0439\u043d\u043e \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0438\u043b\u0438 B\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e), \u0432/\u043c, \u043f/\u043a. \u0420\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430\n[\u041e\u043f\u0438\u043e\u0438\u0434\u043d\u043e\u0435 50\u2013100 \u043c\u0433. \u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\u043d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435] \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0447\u0435\u0440\u0435\u0437\n30\u201360 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e 50 \u043c\u0433.\n\u041f\u043b\u0430\u0437\u043c\u043e\u0437\u0430\u043c\u0435\u0449\u0430\u044e\u0449 \u0436\u0435\u043b\u0430\u0442\u0438\u043d \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u0448\u043e\u043a\u0435 \u0434\u043e 20 \u043c\u043b/\u043a\u0433 \u0412\n\u0438\u0435 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u044b. \u0441\u0443\u043a\u0446\u0438\u043d\u0438\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u0447\u0430\u0441 (\u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u043e 0,33 \u043c\u043b \u043d\u0430 \u043a\u0433\n\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\u0436\u0435\u043b\u0430\u0442\u0438 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u043c\u0438\u043d\u0443\u0442\u0443).\n\u043d\u0430\n\u0410\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u044b \u044d\u043d\u043e\u043a\u0441\u0430\u043f\u0430\u0440\u0438\u043d \u043d\u0430\u0442\u0440\u0438\u044f \u0432/\u0432 \u0438\u043b\u0438 \u043f/\u043a \u2013 \u0432 \u0448\u043f\u0440\u0438\u0446\u0430\u0445 6000 \u0430\u043d\u0442\u0438- A\n\u0445\u0430 \u041c\u0415/0,6 \u043c\u043b.\n\n\u0410\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u044b \u0433\u0435\u043f\u0430\u0440\u0438\u043d \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e \u043f\u043e 5000 \u041c\u0415/\u0441\u0443\u0442 \u0441 A\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430\u043c\u0438 8 \u2013 12 \u0447.\n\u041f\u0440\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0437\u0430\u0445 \u043b\u0435\u043