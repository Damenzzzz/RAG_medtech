3a\u0433\n\n\u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430: 30\n\u043c\u0433/\u043a\u0433 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0414\u043e\u0437\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\n\u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 50 \u043a\u0433 \u0438 \u0432\u044b\u0448\u0435\n\n\u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u0430 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u0435\u043c\u0435\u043d\u0446\u0438\u0438 \u043f\u0440\u0438 \u0411\u0413\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 6 \u2013 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u0435\u043c\u0435\u043d\u0446\u0438\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0411\u0413 [48-50].\n\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438- \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u0410\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u043d\u044b\u0435 \u0420\u0438\u0432\u0430\u0441\u0442\u0438\u0433\u043c\u0438\u043d* \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0412\n\n28\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u2013 1,5 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c.\n\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043