\u043e \u043f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a, \u0434\u043b\u044f \u0412\n\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438\n\u0442\u0438 \u043a\u043e\u0436\u043d\u044b\u0445\n\u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432 \u0438\n\u0434\u0440\u0435\u043d\u0430\u0436\u043d\u044b\u0445\n\u0438\u043b\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\n\n14 \u0445\u043b\u043e\u0440\u0433\u0435\u043a\u0441\u0438\u0434\u0438\u043d 0,05% \u0432\u043e\u0434\u043d\u044b\u0439 \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u041f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a \u0410\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e \u0442\u0438\n\u0438\u043b\u0438 \u043d\u043d\u043e\u0433\u043e\n\u043f\u043e\u043b\u044f, \u0440\u0443\u043a\n\n\u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\n15 \u044d\u0442\u0430\u043d\u043e\u043b \u0440\u0430\u0441\u0442\u0432\u043e\u0440 70%; \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u041f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a \u0410\n\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e \u0442\u0438\n\u043d\u043d\u043e\u0433\u043e\n\u043f\u043e\u043b\u044f, \u0440\u0443\u043a\n\u0438\u043b\u0438 \u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\u0410\u043d\u0442\u0438\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n16 \u043f\u0430\u043d\u0442\u043e\u043f\u0440\u043e\u0437\u043e\u043b 40 \u043c\u0433 1-2 \u0440\u0430\u0437\u0430 \u0432\u043d\u0443\u0442\u0440\u044c 2-4 \u043d\u0435\u0434\u0435\u043b\u0438 \u043d\u0443\u0436\u043d\u043e \u0410\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\n\u0438\u043b\u0438 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\n17 \u0444\u0430\u043c\u043e\u0442\u0438\u0434\u0438\u043d 20 \u043c\u0433 1-2 \u0440\u0430\u0437\u0430 \u0432\u043d\u0443\u0442\u0440\u044c 4\u20138 \u043d\u0435\u0434 \u043d\u0443\u0436\u043d\u043e \u0410\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\n\u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\n\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0438 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n18 \u0430\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d \u0432\u043d\u0443\u0442\u0440\u044c, \u0440\u0430\u0437\u043e\u0432\u0430\u044f 4\u20136 \u0440\u0430\u0437 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c, \u043e\u0442 5\u201310 \u0434\u043d\u0435\u0439 \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a \u0410\n\u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0441\u0443\u0442\u043a\u0438 \u0432/\u0432, \u0432/\u043c \u0434\u043e 2\u20133 \u043d\u0435\u0434 \u0438 \u0433\u0440\u0443\u043f\u043f\u044b\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u2014 \u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u043b\u0443\u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\n0,25-0,5 \u0433, \u043a\u0438\u0445\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u2014 2\u2013 \u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u043e\u0432\n3 \u0433. \u0412/\u043c \u043f\u043e \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e\n0,25\u20130,5 \u0433 \u0441\u043f\u0435\u043a\u0442\u0440\u0430\n\u0438\u043b\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 6\u20138 \u0447\n19 \u0446\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c \u043f\u043e 0,5\u20132 \u0433 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0432\\\u043c, \u0432/\u0432 7-14 \u0434\u043d\u0435\u0439 \u0426\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410\n\u0441\u0443\u0442\u043a\u0438 \u044b 3-\u0433\u043e\n\u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\n\u0438\u043b\u0438\n20 \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d \u0441\u0440\u0435\u0434\u043d\u044f\u044f 1-2 \u0440\u0430\u0437\u0430 \u0432\\\u043c, \u0432/\u0432 7-14 \u0426\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 (\u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u044b 3-\u0433\u043e\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1\u20132 \u0442\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\u0433. 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f)\n\u0438\u043b\u0438 0,5\u20131 \u0433\n\u0438\u043b\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447.\n21 \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c 1 \u0433 \u0447\u0435\u0440\u0435\u0437 3-4 \u0440\u0430\u0437\u0430 \u0432\\\u043c, \u0432/\u0432 7-14 \u0434\u043d\u0435\u0439 \u0426\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410\n\u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447. \u0412 \u044b 3-\u0433\u043e\n\u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0434\u043e\u0437\u0443\n\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442\n\u0434\u043e 3 \u0438\u043b\u0438 4 \u0433 \u0432\n\u0438\u043b\u0438 \u0434\u0435\u043d\u044c\n\n22 \u0446\u0435\u0444\u0435\u043f\u0438\u043c 0,5\u20131 \u0433 (\u043f\u0440\u0438 2-3 \u0440\u0430\u0437\u0430 \u0432\\\u043c, \u0432/\u0432 7\u201310 \u0434\u043d\u0435\u0439 \u0438 \u0426\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410\n\u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0431\u043e\u043b\u0435\u0435 \u044b 4-\u0433\u043e\n\u0438\u043b\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u0434\u043e 2 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\u0433).\n23 \u0446\u0435\u0444\u043e\u043f\u0435\u0440\u0430\u0437\u043e\u043d \u0441\u0440\u0435\u0434\u043d\u044f\u044f \u043a\u0430\u0436\u0434\u044b\u0435 \u0432\\\u043c, \u0432/\u0432 7-10 \u0434\u043d\u0435\u0439 \u0426\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 12 \u0447\u0430\u0441\u043e\u0432 \u044b 3-\u0433\u043e\n\u0438\u043b\u0438 \u0434\u043b\u044f \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u2014 2\u2013\n4 \u0433, \u043f\u0440\u0438\n\u0442\u044f\u0436\u0435\u043b\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2014\n\u0434\u043e 8 \u0433; \u0434\u043b\u044f\n\u0434\u0435\u0442\u0435\u0439 \u2014 50\u2013\n200 \u043c\u0433/\u043a\u0433\n\n24 \u0430\u043c\u0438\u043a\u0430\u0446\u0438\u043d 10\u201315 \u043c\u0433/\u043a\u0433. 2-3 \u0440\u0430\u0437\u0430 \u0432/\u0432, \u0432/\u043c \u043f\u0440\u0438 \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435 \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a - \u0410\n\n\u043d\u0438\u0438 \u2014 3\u20137 \u0430\u043c\u0438\u043d\u043e\u0433\u043b\u0438\u043a\u043e\u0437\u0438\u0434\n\u0438\u043b\u0438 \u0434\u043d\u0435\u0439, \u044b\n\u043f\u0440\u0438 \u0432/\u043c \u2014\n\n7\u201310 \u0434\u043d\u0435\u0439.\n25 \u0433\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u2014 2-3 \u0440\u0430\u0437\u0430 \u0432/\u0432, \u0432/\u043c 7-8 \u0434\u043d\u0435\u0439 \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a - \u0412\n0,4 \u043c\u0433/\u043a\u0433, \u0430\u043c\u0438\u043d\u043e\u0433\u043b\u0438\u043a\u043e\u0437\u0438\u0434\n\u0438\u043b\u0438 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u2014 \u0434\u043e \u044b\n1,2 \u043c\u0433/\u043a\u0433., \u043f\u0440\u0438\n\u0442\u044f\u0436\u0435\u043b\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445\n\u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u2014\n0,8\u20131 \u043c\u0433/\u043a\u0433.\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u2014\n2,4\u20133,2 \u043c\u0433/\u043a\u0433,\n\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u2014\n5 \u043c\u0433/\u043a\u0433\n\n26 \u0434\u043e\u0440\u0438\u043f\u0435\u043d\u0435\u043c 500 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0432/\u0432 7-10 \u0434\u043d\u0435\u0439 \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 - \u0410\n\u0438\u043b\u0438 \u0447\u0430\u0441\u043e\u0432 \u043a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b\n27 \u043c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c 500 \u043c\u0433, \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0432/\u0432 7-10 \u0434\u043d\u0435\u0439 \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 - \u0410\n\u0432\u043d\u0443\u0442\u0440\u0438\u0431\u043e\u043b\u044c\u043d\u0438\u0447 \u0447\u0430\u0441\u043e\u0432 \u043a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b\n\u0438\u043b\u0438 \u043d\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2014\n1 \u0433\n28 \u0430\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u043f\u043e 500 \u043c\u0433/\u0441\u0443\u0442 1 \u0440\u0430\u0437 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c 3 \u0434\u043d\u044f \u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438- \u0410\n\u0438\u043b\u0438 \u0441\u0443\u0442\u043a\u0438 \u0430\u0437\u0430\u0