5, \u0433\u0435\u043c\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u044f \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u043e\u0439\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0413\u0411\u041d) \u2013 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u2013 \u0434\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0435\n\u0440\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u0446\u0435 \u043e\u0434\u043d\u043e\u0439 \u0434\u043e\u0437\u044b \u0430\u043d\u0442\u0438- \u0433\u0438\u043f\u0435\u0440\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0435\u043c\u0438\u044f \u0438 \u0442\u0434.) \u2013 \u043a\u0440\u043e\u0432\u0438 \u043f\u043b\u043e\u0434\u0443. \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0443\u0441\u043b\u043e\u0432\u043d\u043e \u043d\u0430 \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435\nRh(D) \u2013 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0430 \u0432 \u0440\u043e\u0434\u043e\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0432 \u0431\u043e\u043b\u0435\u0435 \u0420\u0414\u0421 \u043f\u043b\u043e\u0434\u0430\n2 \u043d\u0435\u0434\u0435\u043b\u0438 \u0440\u0430\u043d\u0435\u0435 \u0441\u0440\u043e\u043a\u0430\n\u0434\u043e\u0437\u0435: 1250 \u2013 1500 \u041c\u0415 \u2013 250 \u2013 \u0440\u0430\u043d\u043d\u0438\u0435 \u0441\u0440\u043e\u043a\u0438 \u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0438\u0434\u0430\u043c\u0438[ 8,11,12,15,20]\n\u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0445 \u0440\u043e\u0434\u043e\u0432\n300 \u043c\u043a\u0433. (\u0423\u0414 \u0410/ I)[4,5,13]\n18\n\n5.2 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u0420\u0435\u0436\u0438\u043c: \u043e\u0431\u0449\u0438\u0439.\n\u0414\u0438\u0435\u0442\u0430: \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439.\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0446\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430:\n\u25cf \u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0434\u043e \u0431\u043e\u043b\u0435\u0435 \u0437\u0440\u0435\u043b\u043e\u0433\u043e \u0433\u0435\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e\n\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u043f\u043b\u043e\u0434\u0430 \u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0436\u0438\u0437\u043d\u0435\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445;\n\u25cf \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0445\u043e\u0434\u043e\u0432:\n\uf0fc \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0443\u0442\u0435\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u0430\n\u0442\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438:\n\n\u0432\u043d\u0443\u0442\u0440\u0438\u0443\u0442\u0440\u043e\u0431\u043d\u0430\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044f \u0433\u0435\u043c\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437