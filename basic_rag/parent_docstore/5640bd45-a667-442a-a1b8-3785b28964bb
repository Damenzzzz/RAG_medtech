31.\n100 \u043c\u0433 2 \u0440/\u0434.\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043e\u0431\u0449\u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n\n\u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 5-7\n\u0434\u043d\u0435\u0439.\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f)\n\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\n\u043e\u0435\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\n\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043d\u043e\n\u043d\u043e\u0435\n\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435\n\u041b\u0421\n\u041f\u0440\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u0445\n\u0446\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432\u0430\u0437\u043e\u0441\u043f\u0430\u0437\u043c\u0430 (3-14\n\u0441\u0443\u0442\u043a\u0438 \u0440\u0430\u0437\u0440\u044b\u0432\u0430,\n30 \u043c\u0433 \u043f\u043e 1 \u0442\u0430\u0431 \u0434\u043e 3-6\n\u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\n\u0440\u0430\u0437/\u0441\u0443\u0442 \u0434\u043e\n\u0411\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434\n\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u0432\u044b\u0445 \u041d\u0438\u043c\u043e\u0434\u0438\u043f\u0438\u043d \u043c\u0438\u043a\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435 \u0412\n\u0446\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u043a\u0430\u043d\u0430\u043b\u043e\u0432 \u0441\u043a\u0438\u0445\n\u0432\u0430\u0437\u043e\u0441\u043f\u0430\u0437\u043c\u0430.\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439)\u0434\u043e\n\u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u0446\u0435\u0440\u0435\u0431\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0432\u0430\u0437\u043e\u0441\u043f\u0430\u0437\u043c\u0430.\n\u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b\n(\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 40 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432\n\u043f\u0440\u043e\u0442\u043e\u043d\u043e\u0432\u043e\u0439 \u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\n\u0413\u0430\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0442\n\u043f\u043e\u043c\u043f\u044b) \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0410\n\u0435\u043a\u0442\u043e\u0440\n20-30 \u043c\u0438\u043d\u0443\u0442. 20-40\n\u0438\u043b\u0438 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 per os.\n\u0413\u0430\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0442 \u0424\u0430\u043c\u043e\u0442\u0438\u0434\u0438\u043d 20 \u0438\u043b\u0438 40 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0410\n\n\u0435\u043a\u0442\u043e\u0440 (\u041d \u2013 \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0432\n2\n\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u043e\u0431\u043b\u043e\u043a \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2 \u043c\u0438\u043d.\n\u0430\u0442\u043e\u0440)\n\u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u043f\u043e 100-200 \u043c\u0433 1-\n2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0441\n\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c\n\u041a\u0430\u0440\u0431\u0430\u043c\u0430\u0437\u0435\u043f\u0438\u043d\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u043e\n(\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434\u043e\u0440\n\u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0441\u0443\u0434 \u043e\u0436\u043d\u043e\u0435\n\u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0410\n\u043e\u0440\u043e\u0436\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e)\n\u044d\u0444\u0444\u0435\u043a\u0442\u0430 (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435\n\u0447\u0435\u043c \u043d\u0430 200 \u043c\u0433/\u0441\u0443\u0442 \u0441\n\u0438\u043b\u0438\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 1 \u043d\u0435\u0434) \u0434\u043e\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0434\u043e\u0437\u044b -\n\u043f\u043e 400 \u043c\u0433 2-3 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438.\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438\n\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0434\u043b\u044f\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u2013 5-15\n\u043c\u0433/\u043a\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 2\n\u043f\u0440\u0438\u0435\u043c\u0430, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\n\u043e\u