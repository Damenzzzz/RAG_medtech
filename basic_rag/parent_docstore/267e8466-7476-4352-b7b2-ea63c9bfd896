6\u0435 \u043a \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437\n\n\u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u043e\u0432 \u0438 \u043e\u0434\u043d\u043e\u043c\u0443 \u0438\u0437 \u0442\u0440\u0435\u0445 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0440\u044f\u0434\u0430\n\n(\u043a\u0430\u043f\u0440\u0435\u043e\u043c\u0438\u0446\u0438\u043d\u0443, \u043a\u0430\u043d\u0430\u043c\u0438\u0446\u0438\u043d\u0443 \u0438\u043b\u0438 \u0430\u043c\u0438\u043a\u0430\u0446\u0438\u043d\u0443) [3, 4]\n\n1.8 \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f:\n\u043f\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0444\u043e\u0440\u043c\u0430\u043c:\n\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u043a\u043e\u0441\u0442\u0435\u0439 \u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432;\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u043e\u0441\u0442\u0438\u0442;\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u0438\u043d\u043e\u0432\u0438\u0442;\n\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0438\u0442;\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u043a\u043e\u043a\u0441\u0438\u0442;\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0433\u043e\u043d\u0438\u0442;\n\n\u2022 \u043f\u0440\u043e\u0447\u0435\u0435 \u043a\u043e\u0441\u0442\u0438 \u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u044b;\n\u2022 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u043c\u043e\u0447\u0435\u0432\u044b\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\