u044b\u0439 \u0442\u0440\u0430\u0445\u0435\u0438\u0442 J04.2 \u041e\u0441\u0442\u0440\u044b\u0439 \u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0442\u0440\u0430\u0445\u0435\u0438\u0442 J06 \u041e\u0441\u0442\u0440\u044b\u0435 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0438 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 J06.0 \u041e\u0441\u0442\u0440\u044b\u0439 \u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0444\u0430\u0440\u0438\u043d\u0433\u0438\u0442 J06.8 \u0414\u0440\u0443\u0433\u0438\u0435 \u043e\u0441\u0442\u0440\u044b\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 J06.9 \u041e\u0441\u0442\u0440\u0430\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u0430\u044f J10- J18 \u0413\u0440\u0438\u043f\u043f \u0438 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f J10 \u0413\u0440\u0438\u043f\u043f, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u044b\u0439 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0432\u0438\u0440\u0443\u0441\u043e\u043c \u0433\u0440\u0438\u043f\u043f\u0430 J11 \u0413\u0440\u0438\u043f\u043f, \u0432\