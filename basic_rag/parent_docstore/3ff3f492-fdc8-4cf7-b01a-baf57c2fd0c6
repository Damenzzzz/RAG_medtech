\u043e\u0434\u0443 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u2265 2 \u0441\u0443\u0442\u043e\u043a \u0432 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 90 \u0434\u043d\u0435\u0439, \u0432/\u0432 \u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u0438\u0430\u043b\u0438\u0437\u0430, \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u043d \u0432\n\u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0432 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 30 \u0434\u043d\u0435\u0439\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u0430: \u0430\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d, \u0430\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442 \u0438 \u0434\u0440. \u0418\u0417\u041f \u0432\u043d\u0443\u0442\u0440\u044c\n\u0410\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b: \u043c\u0430\u043a\u0440\u043e\u043b\u0438\u0434\u044b (\u0430\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d, \u043a\u043b\u0430\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d), \u0426\u0421 III (\u0446\u0435\u0444\u0438\u043a\u0441\u0438\u043c, \u0446\u0435\u0444\u043f\u043e\u0434\u043e\u043a\u0441\u0438\u043c)\n\u0438\u043b\u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d (\u043c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d, \u043b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d) \u0432\u043d\u0443\u0442\u0440\u044c\n\n37\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 3\n\n\u0410\u043b