u0443\u043a\u043b\u0435\u0430\u0440\u043d\u0430\u044f/\u043c\u0438\u043e\u0442\u0443\u0431\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c,\n\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u0442\u044f\u0436\u0451\u043b\u044b\u0439 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f,\n\u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0438\u043f \u043f\u0442\u043e\u0437, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c\n\u0433\u043b\u0430\u0437\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u044b\u0448\u0446,\n\u043f\u043b\u043e\u0445\u043e\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\n\n\u0426\u0435\u043d\u0442\u0440\u043e- \u0421\u043f\u043e\u0440\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u0414\u0438\u043d\u0430\u043c\u0438\u043d- \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e\n\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u0430\u044f/\u043c\u0438\u043e\u0442\u0443\u0431\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u0439, \u0410\u0420/\u0410\u0414 2(\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u044b\u0439 \u043a \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0449\u0438\u0439\u0441\u044f \u0442\u0438\u043f\n\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0438\u043f \u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u043e\u043c\u0443 \u0412 \u041d\u0430\u0447\u0430\u043b\u043e: \u043f\u043e\u0437\u0434\u043d\u0438\u0439\n\u0438\u043b\u0438 \u043f\u043e\u0437\u0434\u043d\u044f\u044f \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0438\u043f\u0443 \u0428\u041c\u0422 \u0438\u043b\u0438 DI- \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u0438\u043b\u0438\n\u0444\u043e\u0440\u043c\u0430 CMTB/19p13.2 \u0440\u0430\u043d\u043d\u0435\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043e, \u043e\u0431\u0449\u0430\u044f\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f,\n\u043b\u0438\u0446\u0435\u0432\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u043f\u0442\u043e\u0437,\n\u043b\u0438\u0446\u0435\u0432\u044b\u0435 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438\n\u0426\u0435\u043d\u0442\u0440\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u0430\u044f/\u043c\u0438\u043e\u0442\u0443\u0431\u0443\u043b\u044f\u0440 \u0410\u0414 \u0414\u0438\u043d\u0430\u043c\u0438\u043d 2 \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u043f\u043e\u0437\u0434\u043d\u0435\u043c \u0434\u0435\u0442\u0441\u0442\u0432\u0435,\n\u043d\u0430\u044f \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u043f\u043e\u0437\u0434\u043d\u044f\u044f \u043b\u0435\u0433\u043a\u0430\u044f \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u0430/\u0432\u0437\u0440\u043e\u0441\u043b\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0438\u043b\u0438 \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u0443\u0435\u0442\n\u0444\u043e\u0440\u043c\u0430 \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f, \u043f\u0442\u043e\u0437,\n\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0435 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043b\u0438\u0446\u0435\u0432\u044b\u0445 \u043c\u044b\u0448\u0446, \u043b\u0435\u0433\u043a\u0438\u0435\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n\n\u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u0434\u0438\u0441\u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u044f \u0441\u043f\u043e\u0440\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435, \u043e\u0431\u0449\u0430\u044f \u043d\u0435\n\u0432\u043e\u043b\u043e\u043a\u043e\u043d \u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0438\u043d\u043e\u0433\u0434\u0430\n\u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0441\u043a\u0435\u043b\u0435\u0442\u043d\u044b\u0435 \u0438\n\u043b\u0438\u0446\u0435\u0432\u044b\u0435 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438\n\u041c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u0441 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u043d\u044b\u043c\u0438 \u0410\u0420 \u0438\u043b\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u0435 \u0438 \u0443\n\u0442\u0435\u043b\u044c\u0446\u0430\u043c\u0438 \u0441\u043f\u043e\u0440\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u043e\u0431\u0449\u0430\u044f\n\u0439 \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c,\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043b\u0438\u0446\u0435\u0432\u0430\u044f,\n\u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u0438\u043b\u0438 \u0430\u0441\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0430\u044f\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0441\u043a\u0435\u043b\u0435\u0442\u043d\u044b\u0435\n\u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438\n\n\u041c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u0441 \u043f\u0430\u043b\u0