2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0441\u0442\u0430\u0440\u0448\u0438\u0439\n\u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0410\u041e\n\u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438 \u0438\u043c. \u0410.\u041d. \u0421\u044b\u0437\u0433\u0430\u043d\u043e\u0432\u0430\u00bb;\n5) \u041a\u0430\u043b\u0438\u0435\u0432\u0430 \u041c\u0438\u0440\u0430 \u041c\u0430\u0440\u0430\u0442\u043e\u0432\u043d\u0430 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\n\u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0410\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438 \u0438\u043c. \u0410.\u041d. \u0421\u044b\u0437\u0433\u0430\u043d\u043e\u0432\u0430\u00bb.\n3.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432:\u043d\u0435\u0442.\n3.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442: \u041c\u0438\u0435\u0440\u0431\u0435\u043a\u043e\u0432 \u0415\u0440\u0433\u0430\u043b\u0438 \u041c\u0430\u043c\u0430\u0442\u043e\u0432\u0438\