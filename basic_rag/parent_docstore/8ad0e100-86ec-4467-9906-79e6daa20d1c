441\u0442\u0438\nC)\n\n26\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0438\u0430 \u2013 12. \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u043d\u0435\u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 [1; 10\u201312]\n\nNo \u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430\n1. \u0414\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a, \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442 N-\u043c\u0435\u0442\u0438\u043b-D-\u0430\u0441\u043f\u0430\u0440\u0442\u0430\u0442\u0430 \u0430\u043c\u0430\u043d\u0442\u0430\u0434\u0438\u043d* \u0421 100\u043c\u0433 1 \u0440\u0430\u0437 \u0432 500\u043c\u0433 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0430\u043d\u0442\u0438\u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 (\u0433\u043b\u0443\u0442\u0430\u043c\u0430\u0442\u0430) \u0441\u0443\u0442\u043a\u0438\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n2. \u0414\u0440\u0443\u0433\u0438\u0435 \u043d\u0435\u0439\u0440\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442 \u0433\u043b\u0443\u0442\u0430\u043c\u0430\u0442\u043d\u044b\u0445 N-\u043c\u0435\u0442\u0438\u043b- \u043c\u0435\u043c\u0430\u043d\u0442\u0438\u043d \u0421 5\u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 30\u043c\u0433 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 D-\u0430\u0441\u043f\u0430\u0440\u0442\u0430\u0442 (NMDA)-\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432,\n\u0442\u043e\u0440\u043c\u043e\u0437\u0438\u0442 \u0433\u043b\u0443\u0442\u0430\u043c\u0430\u0442\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e\n\u043d\u0435\u0439\u0440\u043e\u0442\u0440\u0430\u043d\u0441\u043c\u0438\u0441\u0441\u0438\u044e \u0438\n\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u043d\u0435\u0439\u0440\u043e\u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432,\n\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0435\u0439\u0440\u043e\u043c\u043e\u0434\u0443\u043b\u0438\u0440\u0443\u044e\u0449\u0435\u0435\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.\n3. - \u041c-, \u041d- \u0438\u043d\u0433\u0438\u0431\u0438\u0440\u0443\u0435\u0442 \u0445\u043e\u043b\u0438\u043d\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u0443 \u0438 \u0434\u043e\u043d\u0435\u043f\u0435\u0437\u0438\u043b \u0410 5\u043c\u0433 10\u043c\u0433\n\u0445\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a\u0438, \u0432 \u0442.\u0447. \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0440\u0430\u0441\u043f\u0430\u0434 \u0430\u0446\u0435\u0442\u0438\u043b\u0445\u043e\u043b\u0438\u043d\u0430\n\u0430\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d-\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u043d\u044b\u0435\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n4. \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0441\u0435\u0432\u0434\u043e\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u044b\u0439 \u0440\u0438\u0432\u0430\u0441\u0442\u0438\u0433\u043c\u0438\u043d \u0410 1, 5 \u043c\u0433 12 \u043c\u0433\n\u0445\u043e\u043b\u0438\u043d\u043e\u043c\u0438\u043c\u0435\u0442\u0438\u043a \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u0430\u0446\u0435\u0442\u0438\u043b\u0445\u043e\u043b\u0438\u043d\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u044b \u0438 (\u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0435\n\u0431\u0443\u0442\u0438\u0440\u0438\u043b\u0445\u043e\u043b\u0438\u043d\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u044b \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f)\n\u043c\u043e\u0437\u0433\u0430 \u0412 (\u043f\u0441\u0438\u0445\u043e\u0437\u044b)\n5. \u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0435 \u043a\u043b\u043e\u0437\u0430\u043f\u0438\u043d \u0410\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u0438, \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u044b \u0432 \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0433\u0430\u043d\u0433\u043b\u0438\u044f\u0445 \u0438\n\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u043b\u0438\u043c\u0431\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.\n\u0434\u0438\u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u0430, \u0430\u043d\u0442\u0438\u043f\u0441\u0438\u0445\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435,\n6,25 \u043c\u0433 \u043d\u0430 \u043d\u043e\u0447\u044c 50 \u043c\u0433\n\u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u043e\u0435, \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0438\u0440\u0443\u044e\u0449\u0435\u0435,\n\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0435\u0435 \u0438\n\u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u03b2-\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0435\u0435\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n6. \u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u043e\u0432\u044b\u0435 5-\u041d\u04222- \u043a\u0432\u0435\u0442\u0438\u0430\u043f\u0438\u043d \u0421\n12,5 \u043c\u0433 \u043d\u0430 \u043d\u043e\u0447\u044c 200 \u043c\u0433 (\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a, \u0438 \u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0435, \u0438 \u03b11-\n27\n\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0435 \u0430\u0434\u0440\u0435\u043d\u043e\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u044b. 12,5 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 5-7\n\u0434\u0438\u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u0430, \u0410\u043d\u0442\u0438\u043f\u0441\u0438\u0445\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u043d\u0435\u0439)\n\n7. \u0425\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a, \u0442\u0440\u043e\u0441\u043f\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434\n\u043d\u0435\u0441\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0442\u043e\u043d\u0443\u0441\u0430 \u0433\u043b\u0430\u0434\u043a\u043e\u0439\n5 \u043c\u0433 2-3 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442 5 \u043c\u0433 3 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442\n\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u041c- \u043c\u0443\u0441\u043a\u0443\u043b\u0430\u0442\u0443\u0440\u044b \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f\n\u0445\u043e\u043b\u0438\u043d\u043e\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u044b\n8. \u0425\u043e\u043b\u0438\u043d\u043e\u043b\u0438\u0442\u0438\u043a, \u0442\u043e\u043b\u0442\u0435\u0440\u043e\u0434\u0438\u043d\n\u043d\u0435\u0441\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0442\u043e\u043d\u0443\u0441\u0430 \u0433\u043b\u0430\u0434\u043a\u043e\u0439\n1 \u043c\u0433 4 \u043c\u0433 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u041c- \u043c\u0443\u0441\u043a\u0443\u043b\u0430\u0442\u0443\u0440\u044b \u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f\n\u0445\u043e\u043b\u0438\u043d\u043e\u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u044b\n9. \u0410\u043d\u0442\u0438\u0434\u0435\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u044b \u0431\u043b\u043e\u043a\u0430\u0434\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0446\u0438\u0442\u0430\u043b\u043e\u043f\u0440\u0430\u043c\n10 \u043c\u0433 20 \u043c\u0433\n\u0433\u0440\u0443\u043f\u043f\u044b \u0421\u0418\u041e\u0417\u0421 \u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430\n10. \u0442\u0440\u0438\u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0431\u043b\u043e\u043a\u0430\u0434\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0430\u043c\u0438\u0442\u0440\u0438\u043f\u0442\u0438\u043b\u043b\u0438\u043d\n\u0430\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u044b \u043d\u043e\u0440\u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430, \u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430,\n6,25 \u043c\u0433 50 \u043c\u0433\n\u043d\u0430\u0442\u0440\u0438\u0435\u0432\