YH7/14q11.2 \u041d\u0430\u0447\u0430\u043b\u043e \u0432 \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u0435,\n\u0442\u0435\u043b\u0435\u0446/\u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u0441 \u0410\u0420:\u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e/3p22. \u041f\u041a\u041c\u0414 \u0438\u043b\u0438 \u043b\u043e\u043f\u0430\u0442\u043e\u0447\u043d\u043e-\n\u043b\u0438\u0437\u0438\u0441\u043e\u043c \u043c\u0438\u043e\u0444\u0438\u0431\u0440\u0438\u043b, 2-p21-32 \u043f\u043b\u0435\u0447\u0435\u0432\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u0438\u043b\u0438\n\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043c\u0438\u043e\u0441\u0442\u0438\u043d\u0430 \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f\nH-IBM3/\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u0441 \u0410\u0414 MYH2/17p13.1 \u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0430\u0440\u0442\u043e\u0433\u0440\u0438\u043f\u043e\u0437,\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043c\u0438\u043e\u0437\u0438\u043d\u0430 \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043f\u0430\u0440\u0435\u0437, \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445\n\u043b\u0435\u0433\u043a\u0430\u044f \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0438 \u043c\u0438\u0430\u043b\u0433\u0438\u0438\n\u041c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u0441 \u0442\u0443\u0431\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u041d\u0430\u0447\u0430\u043b\u043e: \u0434\u0435\u0442\u0441\u0442\u0432\u043e \u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0439\n\u0430\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u0435\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442, \u043f\u043e\u044f\u0441\u0442\u043d\u043e-\n\u0422\u0438\u043f1 \u0410\u0414 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u043d\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c\n\n\u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u041d\u0430\u0447\u0430\u043b\u043e: \u043c\u043b\u0430\u0434\u0435\u043d\u0447\u0435\u0441\u0442\u0432\u043e,\n\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u0430\u044f \u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u044f,\n\u0422\u0438\u043f2 \u0410\u0420 \u0443\u0442\u043e\u043c\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u044c\n\n\u041d\u0430\u0447\u0430\u043b\u043e \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445:\n\u043c\u0438\u0430\u043b\u0433\u0438\u044f.\n\n\u0422\u0438\u043f3 \u0441\u043f\u043e\u0440\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\n\u0439\n\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u043f\u043e \u0448\u043a\u0430\u043b\u0430\u043c\n\n\u041e\u0446\u0435\u043d\u043a\u0430 \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0439 \u0441\u0438\u043b\u044b \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 MRS\n(MedicalResearchCouncilParalysisScale, 1976)\n0 \u0431\u0430\u043b\u043b\u043e\u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439\u043d\u0435\u0442\n\n1 \u0431\u0430\u043b\u043b \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439\n\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u043d\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0442\u044c \u0441\u0438\u043b\u0443 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\n2 \u0431\u0430\u043b\u043b\u0430\n\n\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\n3 \u0431\u0430\u043b\u043b\u0430 \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0442\u044c \u0441\u0438\u043b\u0443 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0442\u044c\n4 \u0431\u0430\u043b\u043b\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e\u0441\u0438\u043b\u0443 \u0442\u044f\u0436\u0435\u0441\u0442\u0438, \u043d\u043e \u0438 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\n5 \u0431\u0430\u043b\u043b\u043e\u0432 \u043f\u043e\u043b\u043d\u0430\u044f\u0441\u043e\u0445\u0440\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439\u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\n\u0428\u043a\u0430\u043b\u0430\u0421\u043a\u043e\u0442\u0442\u0430 (Muscular Dystrophy Score, MDS)\n\n\u0412\u0438\u0434\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439, \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 \u0421\u043a\u043e\u0442\u0442\u0430\n1. \u041f\u043e\u0434\u044a\u0435\u043c\u0433\u043e\u043b\u043e\u0432\u044b\n2. \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u0441\u043e\u0441\u043f\u0438\u043d\u044b\u043d\u0430\u0436\u0438\u0432\u043e\u0442\u0447\u0435\u0440\u0435\u0437\u043f\u0440\u0430\u0432\u0443\u044e\u0441\u0442\u043e\u0440\u043e\u043d\u0443\n\n3. \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u0441\u043e\u0441\u043f\u0438\u043d\u044b\u043d\u0430\u0436\u0438\u0432\u043e\u0442\u0447\u0435\u0440\u0435\u0437\u043b\u0435\u0432\u0443\u044e\u0441\u0442\u043e\u0440\u043e\u043d\u0443\n\n4. \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u0441\u0436\u0438\u0432\u043e\u0442\u0430\u043d\u0430\u0441\u043f\u0438\u043d\u0443\u0447\u0435\u0440\u0435\u0437\u043f\u0440\u0430\u0432\u0443\u044e\u0441\u0442\u043e\u0440\u043e\u043d\u0443\n5. \u041f\u043e\u0432\u043e\u0440\u043e\u0442\u0441\u0436\u0438\u0432\u043e\u0442\u0430\u043d\u0430\u0441\u043f\u0438\u043d\u0443\u0447\u0435\u0440\u0435\u0437\u043b\u0435\u0432\u0443\u044e\u0441\u0442\u043e\u0440\u043e\u043d\u0443\n\n6. \u0421\u0430\u0434\u0438\u0442\u0441\u044f (\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u0438\u0434\u044f\u0447\u0435\u0435\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435)\n7. \u0421\u0438\u0434\u0438\u0442\n\n8. \u0412\u0441\u0442\u0430\u0435\u0442 (\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u0442\u043e\u044f\u0447\u0435\u0435\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435)\n\n9. \u0421\u0442\u043e\u0438\u0442\n10. \u0421\u0442\u043e\u0438\u0442\u043d\u0430\u043f\u044f\u0442\u043a\u0430\u0445\n\n11. \u0421\u0442\u043e\u0438\u0442\u043d\u0430\u043d\u043e\u0441\u043a\u0430\u0445\n12. \u0421\u0442\u043e\u0438\u0442\u043d\u0430\u043f\u0440\u0430\u0432\u043e\u0439\u043d\u043e\u0433\u0435\n\n13. \u0421\u0442\u043e\u0438\u0442\u043d\u0430\u043b\u0435\u0432\u043e\u0439\u043d\u043e\u0433\u0435\n\n14. \u041f\u0440\u044b\u0433\u0430\u0435\u0442\u043d\u0430\u043f\u0440\u0430\u0432\u043e\u0439\u043d\u043e\u0433\u0435\n\n15. \u041f\u0440\u044b\u0433\u0430\u0435\u0442\u043d\u0430\u043b\u0435\u0432\u043e\u0439\u043d\u043e\u0433\u0435\n16. \u0412\u0441\u0442\u0430\u0435\u0442\u0441\u043e\u0441\u0442\u0443\u043b\u0430\n\n17. \u0412\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0439\u0448\u0430\u0433\u043f\u0440\u0430\u0432\u043e\u0439\u043d\u043e\u0433\u043e\u0439(\u043f\u043e\u0434\u044a\u0435\u043c\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435)\n18. \u041d\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0439\u0448\u0430\u0433\u043f\u0440\u0430\u0432\u043e\u0439\u043d\u043e\u0433\u043e\u0439(\u0441\u043f\u0443\u0441\u043a\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435)\n\n19. \u0412\u043e\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0439\u0448\u0430\u0433\u043b\u0435\u0432\u043e\u0439\u043d\u043e\u0433\u043e\u0439(\u043f\u043e\u0434\u044a\u0435\u043c\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435)\n\n20. \u041d\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0439\u0448\u0430\u0433\u043b\u0435\u0432\u043e\u0439\u043d\u043e\u0433\u043e\u0439(\u0441\u043f\u0443\u0441\u043a\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435)\n\n\u041f\u043e\u0434\u0441\u0447\u0435\u0442\u0441\u0443\u043c\u043c\u044b\u0431\u0430\u043b\u043b\u043e\u0432 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f\u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439\u0441\u0445\u0435\u043c\u0435:\n2\u0431\u0430\u043b\u043b\u0430\u2013\u0434\u043b\u044f\u043a\u0430\u0436\u0434\u043e\u0433\u043e\u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f,\n1 \u0431\u0430\u043b\u043b \u2013 \u0435\u0441\u043b\u0438 \u0431\u044b\u043b\u0430 \u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u0438/\u0438\u043b\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0443\u0441\u0438\u043b\u0438\u0439,\n\n0 \u0431\u0430\u043b\u043b\u043e\u0432 \u2013 \u0435\u0441\u043b\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0431\u0430\u043b\u043b\u043e\u0432\u043f\u043e\u044d\u0442\u043e\u0439\u0448\u043a\u0430\u043b\u0435\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u044240,\u0430\u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435\u2013\n0\u0431\u0430\u043b\u043b\u043e\u0432.\n\n\u0428\u043a\u0430\u043b\u0430 \u0412\u0438\u043d\u044c\u043e\u0441\u0430\n\u0424\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043b\u0430\u0441\u0441\u044b \u0448\u043a\u0430\u043b\u044b \u0412\u0438\u043d\u044c\u043e\u0441\u0430\n\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442 \u0438\u043c\u0435\u0435\u0442 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043e\u0441\u0430\u043d\u043a\u0438 \u0438 \u043f\u043e\u0445\u043e\u0434\u043a\u0438, \u043d\u043e \u0445\u043e\u0434\u0438\u0442 \u0438 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043f\u043e\n1.\n\u0441\u0442\u0443\u043f\u0435\u043d\u044c\u043a\u0430\u043c \u0431\u0435\u0437 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0445\u043e\u0434\u0438\u0442,\u043d\u043e\u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435\u043f\u0440\u0438\u043f\u043e\u043c\u043e\u0449\u0438\u043f\u0435\u0440\u0438\u043b\n2.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442 \u0445\u043e\u0434\u0438\u0442, \u043d\u043e \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435 \u043d\u0430 8\n3.\n\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445\u0441\u0442\u0443\u043f\u0435\u043d\u0435\u0439\u043f\u0440\u0438\u043f\u043e\u043c\u043e\u0449\u0438\u043f\u0435\u0440\u0438\u043b\u0431\u043e\u043b\u0435\u0435\u0447\u0435\u043c \u0437\u0430 25\u0441\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0445\u043e\u0434\u0438\u0442,\u043d\u043e\u043d\u0435\u043c\u043e\u0436\u0435\u0442\u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f\u043f\u043e\u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435\n4.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0445\u043e\u0434\u0438\u0442\u0431\u0435\u0437\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438,\u043d\u043e\u043d\u0435\u043c\u043e\u0436\u0435\u0442\u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c\u043d\u043e\u0433\u0443\u0434\u043b\u044f\u0448\u0430\u0433\u0430\u043d\u0430\u0441\u0442\u0443\u043f\u0435\u043d\u0438\u0438\u043b\u0438\u043d\u0435\u043c\u043e\u0436\u0435\u0442\u0432\u0441\u0442\u0430\n5.\n\u0432\u0430\u0442\u044c \u0438\u0437\u043a\u0440\u0435\u0441\u043b\u0430\n6. \u041f\u0430\u0446\u0438\u0435\u043d\u0442 \u0445\u043e\u0434\u0438\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043a\u043e\u0440\u0441\u0435\u0442\u0435\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0432\u043a\u0440\u0435\u0441\u043b\u0435-\u043a\u0430\u0442\u0430\u043b\u043a\u0435.\u0421\u0438\u0434\u0438\u0442\u043f\u0440\u044f\u043c\u043e,\u043c\u043e\u0436\u0435\u0442\n7.\n\u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c\u043a\u0440\u0435\u0441\u043b\u043e\u043c\u0438\u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c\u0432\u0441\u0435\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441\u043a\u0440\u0435\u0441\u043b\u0430\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442 \u0432 \u043a\u0440\u0435\u0441\u043b\u0435-\u043a\u0430\u0442\u0430\u043b\u043a\u0435. \u0421\u0438\u0434\u0438\u0442 \u043f\u0440\u044f\u043c\u043e, \u043d\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c \u0432\u0441\u0435 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\n8.\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441 \u043a\u0440\u0435\u0441\u043b\u0430\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442 \u0432 \u043a\u0440\u0435\u0441\u043b\u0435-\u043a\u0430\u0442\u0430\u043b\u043a\u0435. \u0421\u0438\u0434\u0438\u0442 \u043f\u0440\u044f\u043c\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0435. \u041c\u043e\u0436\u0435\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c\n9.\n\u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0441 \u043a\u0440\u0435\u0441\u043b\u0430\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d\u043a\u043a\u0440\u043e\u0432\u0430\u0442\u0438.\u041d\u0435\u043c\u043e\u0436\u0435\u0442\u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0431\u0435\u0437\n10.\n\u043f\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0439 \u043f\u043e\u043c\u043e\u0449\u0438\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0430 \u2013 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0430\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0445 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439, \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0438 \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438;", "type": "Document"}}