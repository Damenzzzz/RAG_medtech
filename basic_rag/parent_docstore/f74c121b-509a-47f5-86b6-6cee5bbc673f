043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0432\u0438\u0440\u0443\u0441\u0430 \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0410\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412 \u0438 \u0432\u0438\u0440\u0443\u0441\u0430 \u042d\u043f\u0448\u0442\u0435\u0439\u043d\u0430- \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u043a\u0440\u043e\u0432\u0438 \u0438\n\u0411\u0430\u0440\u0440 invitro. \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043e, \u0447\u0442\u043e \u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430 \u0432 \u0441\u0432\u044f\u0437\u0438\n\u043d\u0438\u0437\u043a\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0437\u0438\u0434\u043e\u0432\u0443\u0434\u0438\u043d\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\ninvitro \u0438\u043d\u0433\u0438\u0431\u0438\u0440\u0443\u044e\u0442 \u0442\u0430\u043a\u0436\u0435 \u043c\u043d\u043e\u0433\u0438\u0435 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0444\u043e\u0440\u043c \u0430\u043d\u0435\u043c\u0438\u0438.\n\u0448\u0442\u0430\u043c\u043c\u044b Enterobacteriaceae,\n\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0448\u0442\u0430\u043c\u043c\u044b \u0440\u0430\u0437\u043d\u044b\u0445 \u0432\u0438\u0434\u043e\u0432\nShigella, Salmonella, Klebsiella,", "type": "Document"}}