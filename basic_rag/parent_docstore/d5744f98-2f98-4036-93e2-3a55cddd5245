6\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439 \u0438\u043b\u0438\n\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u043d\u043e\u0439 \u0434\u043e\u0437\u0435 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u043e \u00ab\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044e\u00bb \u043f\u0440\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0438 \u0438\u0437\u0436\u043e\u0433\u0438 (\u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c 1 \u0440\u0430\u0437\n\n\u0432 3 \u0434\u043d\u044f).\n\u0426\u0435\u043b\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u043e\u043a\u0438\u043d\u0435\u0442\u0438\u043a\u0430\u043c\u0438 \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0442\u043e\u043d\u0443\u0441\u0430 \u043d\u0438\u0436\u043d\u0435\u0433\u043e \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u043d\u043e\u0433\u043e\n\u0441\u0444\u0438\u043d\u043a\u0442\u0435\u0440\u0430, \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u043e\u043f\u043e\u0440\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0443\u0434\u043a\u0430. \u041f\u0440\u043e\u043a\u0438\u043d\u0435\u0442\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439 \u0442\u043e\u0448\u043d\u043e\u0442\u043e\u0439 \u0438 \u0440\u0432\u043e\u0442\u043e\u0439. \u0412\u0432\u0438\u0434\u0443\n\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0438 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u043