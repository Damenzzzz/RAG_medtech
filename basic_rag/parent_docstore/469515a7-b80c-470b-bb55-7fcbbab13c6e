38\u0435 \u0431\u0430\u043b\u043b\u043e\u0432 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 ECOG\n\n11. \u041e\u0420\u0413\u0410\u041d\u0418\u0417\u0410\u0426\u0418\u041e\u041d\u041d\u042b\u0415 \u0410\u0421\u041f\u0415\u041a\u0422\u042b \u041f\u0420\u041e\u0422\u041e\u041a\u041e\u041b\u0410:\n11.1 \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432:\n1) \u041a\u0430\u0438\u043c\u0431\u0435\u043a\u043e\u0432\u0430 \u0420\u0430\u0443\u0448\u0430\u043d \u0422\u043e\u0433\u0438\u0440\u043e\u0432\u043d\u0430 \u2013 \u0422\u041e\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440\u00bb \u0432\u0440\u0430\u0447 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433 \u2013 \u043e\u043d\u043a\u043e\u043b\u043e\u0433 \u043f\u0435\u0440\u0432\u043e\u0439 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439\n\n\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.\n2) \u041e\u043c\u0430\u0440\u043e\u0432\u0430 \u041b\u0435\u043d\u0430 \u0422\u0443\u043b\u0435\u0433\u0435\u043d\u043e\u0432\u043d\u0430 \u2013 \u0422\u041e\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0446\u0435\u043d\u0442\u0440\u00bb \u0432\u0440\u0430\u0447 \u0444\u0438\u0437\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.\n3) \u0411\u0430\u043b\u0442\u0430\u0431\u0435\u043a\u043e\u0432 \u041d\u0443\u0440\u043b\u0430\u043d \u0422\u0443\u0440\u0441\u0443\u04