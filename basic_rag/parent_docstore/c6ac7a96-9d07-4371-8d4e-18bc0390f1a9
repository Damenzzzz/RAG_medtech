\u0438\u0443\u043c\u0430.\n\u041f\u0412\u041f \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c, \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0435\u0441\u043b\u0438 \u043f\u043e\u043b\u044c\u0437\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u0440\u0438\u0441\u043a.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 13 - \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u044d\u043c\u043f\u0438\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043d\u0442\u0438\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0412\u041f:\n\u0413\u0440\u0443\u043f\u043f\u044b \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0410\u043b\u044c\u0442\u0435\u0440\u0430\u043d\u0442\u0438\u0432\u043d\u044b\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n\u0412\u041f \u0443 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442, - \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d,\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0431\u0435\u0437 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0430\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c, \u0446\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d,\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u04391, \u00b1 \u0430\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d, \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c \u0438\u043b\u0438\n\u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0432\u0448\u0438\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 3 \u043a\u043b\u0430\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u0446\u0435\u0444\u043f\u043e\u0434\u043e\u043a\u0441\u0438\u043c\n\u043c\u0435\u0441\u044f\u0446\u0430 \u0410\u0411\u041f, \u043d\u0435 \u0438\u043c\u0435\u044e\u0449\u0438\u0445 - \u043c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u0438\u043b\u0438\n\u0440\u0438\u0441\u043a\u0430 \u043f\u043e\u043b\u0438\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0445 \u043b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u0432/\u0432,\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u0435\u04392 \u0432\u043d\u0443\u0442\u0440\u044c\n\n\u0412\u041f \u0443 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442, - \u043c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u0438\u043b\u0438\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c\u0438 (\u0430\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c), \u043b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u0432/\u0432,\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u04381 \u0438/\u0438\u043b\u0438 \u0446\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d, \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d, \u0432\u043d\u0443\u0442\u0440\u044c\n\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0432\u0448\u0438\u043c\u0438 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 3 \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c \u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b\n\u043c\u0435\u0441 \u0410\u0411\u041f \u22652 \u0434\u043d\u0435\u0439 \u0438/\u0438\u043b\u0438 \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441\n\u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u0440\u0438\u0441\u043a \u043c\u0430\u043a\u0440\u043e\u043b\u0438\u0434\u0430\u043c\u0438 (\u0430\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d,\n\n\u043f\u043e\u043b\u0438\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0439 \u0444\u043b\u043e\u0440\u044b 2 \u043a\u043b\u0430\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d)\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u044d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c, \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d,\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u043e\u0439/\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c \u0446\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d, \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c\n\u043e\u0439 \u0430\u0441\u043f\u0438\u0440\u0430\u0446\u0438\u0435\u0439 \u0432/\u0432 + \u043a\u043b\u0438\u043d\u0434\u0430\u043c\u0438\u0446\u0438\u043d \u0438\u043b\u0438\n\u043c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0432/\u0432\n\u043f\u0438\u043f\u0435\u0440\u0430\u0446\u0438\u043b\u043b\u0438\u043d/\u0442\u0430\u0437\u043e\u0431\u0430\u043a\u0442\u0430\u043c,\n\n\u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0412\u041f - \u0446\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d, \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c, \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d, \u044d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c\n+\u043c\u0430\u043a\u0440\u043e\u043b\u0438\u0434\n\u0438\u043b\u0438\n- \u0446\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d, \u0446\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c, \u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d, \u044d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c +\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\n\n\u0418\u041b\u0418 \u0432\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d (1,0 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12\u0447\u0430\u0441\u043e\u0432)\n\u0418\u041b\u0418 \u043b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434 (600 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447\u0430\u0441)\n23\n\n\u0418\u041b\u0418 \u043f\u0438\u043f\u0435\u0440\u0430\u0446\u0438\u043b\u043b\u0438\u043d\u0430-\u0442\u0430\u0437\u043e\u0431\u0430\u043a\u0442\u0430\u043c (4.5 g\u043a\u0430\u0436\u0434\u044b\u0435 6\n\n\u0447\u0430\u0441\u043e\u0432), \u0418\u041b\u0418 \u0446\u0435\u0444\u0435\u043f\u0438\u043c (2,0 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441),\n\u0418\u041b\u0418 \u0446\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c (2,0 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441),\n\u0418\u041b\u0418 \u0430\u0437\u0442\u0440\u0435\u043e\u043d\u0435\u043c (2,0 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441)\n\u0418\u041b\u0418 \u043c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c (1,0 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447\u0430\u0441),\n\u0418\u041b\u0418 \u0438\u043c\u0438\u043f\u0435\u043d\u0435\u043c (500 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 6 \u0447\u0430\u0441).\n\u0418\u041b\u0418 \u0446\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c/\u0430\u0432\u0438\u0431\u0430\u043a\u0442\u0430\u043c (2000/500 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12\n\n\u0447\u0430\u0441)\n\u0412 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 (\u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438) \u0441\n\u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u0430\u043c\u0438 (\u043b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d, \u0446\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d)\n\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435:\n1 \u0425\u041e\u0411\u041b, \u0421\u0414, \u0425\u0421\u041d, \u0425\u0411\u041f, \u0446\u0438\u0440\u0440\u043e\u0437 \u043f\u0435\u0447\u0435\u043d\u0438, \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c, \u043d\u0430\u0440\u043a\u043e\u043c\u0430\u043d\u0438\u044f, \u0438\u0441\u0442\u043e\u0449\u0435\u043d\u0438\u0435, \u0430\u0441\u043f\u043b\u0435\u043d\u0438\u044f.\n2 \u041f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435 \u0432 \u0434\u043e\u043c\u0435 \u043f\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043b\u044b\u0445/\u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f\u0445 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0445\u043e\u0434\u0430; \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e \u043b\u044e\u0431\u043e\u043c\u0443\n\u043f\u043e\u0432\u043e\u0434\u0443 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u2265 2 \u0441\u0443\u0442\u043e\u043a \u0432 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 90 \u0434\u043d\u0435\u0439; \u0432/\u0432 \u0442\u0435\u0440\u0430\u043f\u0438\u044f; \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u0438\u0430\u043b\u0438\u0437\u0430; \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\n\u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0432 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 30 \u0434\u043d\u0435\u0439\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 14. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u044d\u0442\u0438\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0439 \u0410\u0411\u0422 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0412\u041f \u043f\u0440\u0438\n\n\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u044b\u043c\u0438 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f\u043c\u0438:\n\u0412\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044c \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u04301 \u0410\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b1\nS.pneumoniae \u0418\u0417\u041f: \u0426\u0421:\n\u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d- \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 - \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442 - \u0426\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c\n\u0448\u0442\u0430\u043c\u043c\u044b - \u0410\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c - \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d\n- \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d\n\u0424\u0425:\n- \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u041c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n\nS.pneumoniae \u0426\u0421: \u0412\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d\n\u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u043e\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0435 - \u0426\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c \u041b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434\n\u0448\u0442\u0430\u043c\u043c\u044b - \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d\n- \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d\n\u0424\u0425:\n- \u041c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\nH.influenzae \u0418\u0417\u041f: \u041a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b:\n- \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442 - \u0418\u043c\u0438\u043f\u0435\u043d\u0435\u043c\n- \u0410\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c - \u041c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c\n\u0426\u0421: - \u042d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c\n- \u0426\u0435\u0444\u0435\u043f\u0438\u043c\n- \u0426\u0435\u0444\u0438\u043a\u0441\u0438\u043c\n- \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d\n- \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d\n\u0424\u0425:\n\n- \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u041c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\nS.aureus \u043c\u0435\u0442\u0438\u0446\u0438\u043b\u043b\u0438\u043d- - \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442 \u0424\u0425:\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 - \u0410\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c - \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n\u0448\u0442\u0430\u043c\u043c\u044b \u0426\u0421: - \u041c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u0426\u0435\u0444\u0435\u043f\u0438\u043c\n- \u0426\u0435\u0444\u0438\u043a\u0441\u0438\u043c \u041b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434\n- \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d\n- \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d\n24\n\nS.aureus\u043c\u0435\u0442\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u043e- \u041b\u0438\u043d\u0435\u0437\u043e\u043b\u0438\u0434 \u0412\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d\n\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0435\u0448\u0442\u0430\u043c\u043c\u044b \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d2\n\nLegionella spp. \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d+ \u0414\u043e\u043a\u0441\u0438\u0446\u0438\u043a\u043b\u0438\u043d+\n\u0410\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d+\nEnterobacteriaceae(\u0411\u041b\u0420 \u0421 -) \u0426\u0421: \u041a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b:\n- \u0426\u0435\u0444\u0435\u043f\u0438\u043c - \u0418\u043c\u0438\u043f\u0435\u043d\u0435\u043c\n- \u0426\u0435\u0444\u043e\u0442\u0430\u043a\u0441\u0438\u043c - \u041c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c\n- \u0426\u0435\u0444\u0442\u0430\u0440\u043e\u043b\u0438\u043d - \u042d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c\n- \u0426\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d \u0424\u0425:\n\u0418\u0417\u0426\u0421: - \u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u0426\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c/\u0430\u0432\u0438\u0431\u0430\u043a\u0442\u0430\u043c - \u041c\u043e\u043a\u0441\u0438\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u041e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n- \u0426\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d\n\u0418\u0417\u041f:\n-\u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u043a\u043b\u0430\u0432\u0443\u043b\u0430\u043d\u0430\u0442\n- \u0410\u043c\u043f\u0438\u0446\u0438\u043b\u043b\u0438\u043d/\u0441\u0443\u043b\u044c\u0431\u0430\u043a\u0442\u0430\u043c\n\nEnterobacterales(\u0411\u041b\u0420\u0421 +) \u0418\u0417\u0426\u0421:\n\n- \u0426\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c/\u0430\u0432\u0438\u0431\u0430\u043a\u0442\u0430\u043c\n\u041a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b:\n- \u0418\u043c\u0438\u043f\u0435\u043d\u0435\u043c\n- \u041c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c\n- \u042d\u0440\u0442\u0430\u043f\u0435\u043d\u0435\u043c\nP. aeruginosa \u041a\u0430\u0440\u0431\u0430\u043f\u0435\u043d\u0435\u043c\u044b: - \u0422\u043e\u0431\u0440\u0430\u043c\u0438\u0446\u0438\u043d\n- \u0418\u043c\u0438\u043f\u0435\u043d\u0435\u043c\n- \u041c\u0435\u0440\u043e\u043f\u0435\u043d\u0435\u043c\n\u0426\u0421:\n- \u0426\u0435\u0444\u0435\u043f\u0438\u043c\n- \u0426\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c\n\u0418\u0417\u0426\u0421:\n- \u0426\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c/\u0430\u0432\u0438\u0431\u0430\u043a\u0442\u0430\u043c\n\n\u041f\u0438\u043f\u0435\u0440\u0430\u0446\u0438\u043b\u043b\u0438\u043d/\u0442\u0430\u0437\u043e\u0431\u0430\u043a\u0442\u0430\u043c3\n\u0426\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d3\n+ \u0410\u04133:\n- \u0410\u043c\u0438\u043a\u0430\u0446\u0438\u043d\n- \u0413\u0435\u043d\u0442\u0430\u043c\u0438\u0446\u0438\u043d\n\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0418\u0417\u041f \u2013 \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u043e\u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u044b\u0435 \u043f\u0435\u043d\u0438\u0446\u0438\u043b\u043b\u0438\u043d\u044b, \u0424\u0425 \u2013 \u0444\u0442\u043e\u0440\u0445\u0438\u043d\u043e\u043b\u043e\u043d\u044b, \u0426\u0421 \u2013 \u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b.\n1\u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043f\u0443\u0442\u044c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u044b\u0439; 2\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f\n\u041e\u0446\u0435\u043d\u043a\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u0410\u0411\u0422 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 48-72 \u0447\u0430\u0441\u0430 \u043e\u0442\n\u043d\u0430\u0447\u0430\u043b\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u041f\u0440\u0438 \u0435\u0435 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\n\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430, \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0422\u0412\u041f \u0438\n\u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0