8\u0435 \u0438 \u0442\u043e\u043b\u0441\u0442\u043e\u0441\u0442\u0435\u043d\u043d\u044b\u0435,\n16\n\n\u043b\u0438\u0446\u0435\u0432\u0430\u044f \u043a\u043e\u0441\u0442\u044c, \u0447\u0430\u0441\u0442\u043e\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a) \u0438\u0440\u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0435, 2-\n\u041c\u0420\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043b\u043e\u043f\u0430\u0441\u0442\u043d\u044b\u0435, \u0432\n\u043c\u043e\u0437\u0433\u0430 \u0444\u043e\u0440\u043c\u0435 \u043b\u0438\u0441\u0442\u0430\n\u0423\u0417\u0418 \u041e\u0411\u041f \u043a\u043b\u0435\u0432\u0435\u0440\u0430 \u0432\n\u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u0430\u0445\n\u043b\u0435\u0433\u043a\u043e\u0433\u043e, \u043d\u0435\n\u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u044e\u0442\n\u0440\u0435\u0431\u0435\u0440\u043d\u043e-\n\u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u0430\u043b\u044c\u043d\u044b\u0439\n\u0443\u0433\u043e\u043b,\n\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u044b\n\u0446\u0435\u043d\u0442\u0440\u0438\u043b\u043e\u0431\u0443\u043b\u044f\u0440\u043d\n\u043e.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\n\u2013 \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439\n\u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u0438\u0442 \u0441\n\n\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u0431\u0440\u043e\u043d\u0445\u043e\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\n-\u043a\u0438\u0445 \u0438\n\u043f\u0435\u0440\u0438\u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u044f\u0440-\n\u043d\u044b\u0445 \u043c\u0430\u043a\u0440\u043e\u0444\u0430\u0433\u043e\u0432,\n\u043a\u043b\u0435\u0442\u043a\u0438\n\u041b\u0430\u043d\u0433\u0435\u0440\u0433\u0430\u043d\u0441\u0430\n(\u0434\u0435\u043d\u0434\u0440\u0438\u0442\u043d\u044b\u0435\n\u043a\u043b\u0435\u0442\u043a\u0438 \u2013\u043e\u0434\u0438\u043d \u0438\u0437\n\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u043a\u043b\u0435\u0442\u043e\u043a\n\u043c\u043e\u043d\u043e\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u043e\u0433\n\u043e \u0440\u044f\u0434\u0430)\n\u0418\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041a\u0440\u043e\u0432\u043e\u0445\u0430\u0440\u043a\u0430\u043d\u044c\u0435, \u043e\u0434\u044b\u0448\u043a\u0430 \u0412\u0420\u041a\u0422 \u041e\u0413\u041a \u041e\u0441\u0442\u0440\u0430\u044f \u0444\u0430\u0437\u0430 \u2013\n\u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0439 \u043f\u0440\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435\n\u0433\u0435\u043c\u043e\u0441\u0438\u0434\u0435\u0440\u043e\u0437 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0443\u0447\u0430\u0441\u0442\u043a\u0438\n\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0442\u0435\u043b\u0430 \u0416\u0435\u043b\u0435\u0437\u043e \u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e\n\u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u043e\u0435 \u0441\u0442\u0435\u043a\u043b\u0430\u00bb \u0438/\u0438\u043b\u0438\n\u0411\u0410\u041b \u043a\u043e\u043d\u0441\u043e\u043b\u0438\u0434\u0430\u0446\u0438\u044f \u0432\n\u043f\u0440\u0438\u043a\u043e\u0440\u043d\u0435\u0432\u044b\u0445 \u0438\n\u043d\u0438\u0436\u043d\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u0430\u0445\n\u043b\u0435\u0433\u043a\u0438\u0445.\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0444\u0430\u0437\u0430 \u2013 \u0444\u0438\u0431\u0440\u043e\u0437 \u0441\n\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\n\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439\n\u0432 \u043d\u0438\u0436\u043d\u0438\u0445 \u0434\u043e\u043b\u044f\u0445.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438-\n\u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435\n\u043c\u0435\u0436\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u044b\n\u0445 \u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043e\u043a\n\u0440\u0430\u0437\u043d\u043e\u0439\n\n\u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u0438,\n\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u0430\u044f\n\u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f,\n\u043a\u043e\u043b\u043b\u0430\u0433\u0435\u043d\u043e\u0432\u044b\u0435\n17\n\n\u0432\u043e\u043b\u043e\u043a\u043d\u0430,\n\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0442\u043a\u0430\u043d\u0438,\n\u0433\u0438\u0430\u043b\u0438\u043d\u043e\u0432\u044b\u0435\n\u043d\u0430\u0441\u043b\u043e\u0435\u043d\u0438\u044f,\n\u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435\n\u0433\u0435\u043c\u043e\u0441\u0438\u0434\u0435\u0440\u0438\u043d\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0427\u0430\u0440\u0434\u0436\u0430- \u041e\u0434\u044b\u0448\u043a\u0430, \u043a\u0430\u0448\u0435\u043b\u044c, \u0412\u0420\u041a\u0422 \u041e\u0413\u041a \u041f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0421\u0442\u0440\u043e\u0441\u0441\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u044b \u0443\u0434\u0443\u0448\u044c\u044f, DLco, \u0441\u043f\u0438\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u044f\n\u0441\u0438\u043d\u0443\u0441\u0438\u0442 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439\n\u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043b\u043e\u0441\u043a\u0443\u0442\u0430 \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u044b \u043f\u043e\n\u0418\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0415, \u0442\u0438\u043f\u0443 \u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e\n\u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441\u0442\u0435\u043a\u043b\u0430\u00bb \u0438\nANCA \u043a\u043e\u043d\u0441\u043e\u043b\u0438\u0434\u0430\u0446\u0438\u0438,\n\u0446\u0435\u043d\u0442\u0440\u0438\u043b\u043e\u0431\u0443\u043b\u044f\u0440\u043d\n\u044b\u0435 \u043e\u0447\u0430\u0433\u0438,\n\n\u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435\n\u0441\u0442\u0435\u043d\u043e\u043a \u0431\u0440\u043e\u043d\u0445\u043e\u0432,\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n\u043a\u0430\u043b\u0438\u0431\u0440\u0430\n\u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0445\n\u0441\u043e\u0441\u0443\u0434\u043e\u0432.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438-\n\u043d\u0435\u043a\u0440\u043e\u0442\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\n\u0439 \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442,\n\u044d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u044c\u043d\u0430\u044f\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f\n\u0442\u043a\u0430\u043d\u0435\u0439 \u0438\n\u0432\u043d\u0435\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044f\n\u0433\u0440\u0430\u043d\u0443\u043b\u0435\u043c\u0430.\n\n\u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c, \u0412\u0420\u041a\u0422 \u041e\u0413\u041a \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u0431\u0440\u043e\u043d\u0445\u043e\u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0439 \u043a\u0440\u043e\u0432\u043e\u0445\u0430\u0440\u043a\u0430\u043d\u044c\u0435 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u044b\n\u0430\u0441\u043f\u0435\u0440\u0433\u0438\u043b\u0435\u0437 \u0411\u0410\u041b\u0416 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439\n\u0418\u043d\u044a\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u0430 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438,\n\u0441 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430\u043c\u0438 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u044b,\nAspergillus \u0438\u043c\u0435\u044e\u0449\u0438\u0435\n\u0418\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0415, \u00ab\u043b\u0435\u0442\u0443\u0447\u0438\u0439\u00bb\n\u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438-\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0433\u0438\u0444\u043e\u0432\n\u0430\u0441\u043f\u0435\u0440\u0433\u0438\u043b\u043b \u0441\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\n\u043d\u0435\u043a\u0440\u043e\u0437\u043e\u043c\n\u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0445\n\u0442\u043a\u0430\u043d\u0435\u0439\n\u041f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043d\u0438\u043e\u0437\u044b \u041e\u0434\u044b\u0448\u043a\u0430, \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0412\u0420\u041a\u0422 \u043b\u0435\u0433\u043a\u0438\u0445 \u041c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435\n\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0441 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \u0435 \u0444\u0438\u0431\u0440\u043e\u0437\u043d\u044b\u0445\n\u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043d\u0430 \u041a\u0422\n\u0444\u0430\u043a\u0442\u043e\u0440: \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0441 \u0431\u043e\u043b\u0435\u0435\n\u0432\u0440\u0435\u0434\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435 \u043f\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c\n18\n\n\u0434\u043e\u0431\u044b\u0447\u0435 \u0443\u0433\u043b\u044f, \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0444\u0438\u0431\u0440\u043e\u0437\u043e\u043c.\n\u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043f\u044b\u043b\u0435\u0432\u043e\u0439 \u0421\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 (\u043a\u0432\u0430\u0440\u0446, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u0443\u0433\u043e\u043b\u044c\u043d\u0430\u044f \u043f\u044b\u043b\u044c \u0438 \u0442.\u0434.). \u0438\u043c\u0435\u044e\u0442\n\u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u043a\n\u0441\u043b\u0438\u044f\u043d\u0438\u044e \u0438\n\u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0432\n\u0440\u0430\u043d\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044f\u0445.\n\u041f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u043e\u0435\n\u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435,\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\u043f\u043b\u0435\u0432\u0440\u044b\n\u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f,\n\u043a\u0430\u043a\n\u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\n\u0435 \u0442\u044f\u0436\u0438 \u0438\n\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u043f\u0430\u0440\u0438\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0439\n\u043f\u043b\u0435\u0432\u0440\u044b \u043a\u0430\u043a\n\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u0431\u043b\u044f\u0448\u043a\u0438.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 -\n\u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439\n\u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\n\u044b\u0439 \u0444\u0438\u0431\u0440\u043e\u0437\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u043f\u044b\u043b\u0435\u0432\u044b\u0445 \u0447\u0430\u0441\u0442\u0438\u0446\n\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442\n\u043f\u0440\u0438\u0447\u0438\u043d\u044b \u0431\u043e\u043b\u0435\u0437\u043d\u0438\n(\u0430\u0441\u0431\u0435\u0441\u0442, \u0445\u0440\u0438\u0437\u043e\u0442\u0438\u043b\n\u0438 \u0434\u0440.)\n\n\u041e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u041e\u0434\u044b\u0448\u043a\u0430, \u043a\u0430\u0448\u0435\u043b\u044c \u0441 \u0412\u0420\u041a\u0422 \u041e\u0413\u041a \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445 \u043f\u0440\u043e\u0436\u0438\u043b\u043a\u0430\u043c\u0438 \u043a\u0440\u043e\u0432\u0438. \u041f\u0440\u0438 \u0411\u0438\u043e\u043f\u0441\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u043d\u0435\u0440\u043e\u0432\u043d\u044b\u043c\u0438\n\u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0438 \u041e\u043d\u043a\u043e\u043c\u0430\u0440\u043a\u0435\u0440\u044b \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438\n\u043f\u0430\u0440\u0430\u043a\u0430\u043d\u043a\u0440\u043e\u0437\u043d\u043e\u0439 \u041f\u042d\u0422-\u041a\u0422 \u0432\u0441\u0435\u0433\u043e \u0442\u0435\u043b\u0430 \u0426\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0442\u0435\u043b\u0430 \u043a\u043b\u0435\u0442\u043a\u0438.\n\u0413\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u044f:\n\u0430\u0434\u0435\u043d\u043e\u043a\u0430\u0440\u0446\u0438\u043d\u043e\u043c\u0430,\n\u043f\u043b\u043e\u0441\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\n\u0439 \u0438\n\u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439\n\u0440\u0430\u043a\nCOVID-19 \u0412\u044b\u0441\u043e\u043a\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041a\u0422 \u043b\u0435\u0433\u043a\u0438\u0445 \u041a\u0422 \u043a\u0430\u0440\u0442\u0438\u043d\u0430\n\u043a\u0430\u0448\u0435\u043b\u044c \u041c\u043e\u043a\u0440\u043e\u0442\u0430, \u043c\u0430\u0437\u043e\u043a \u0438\u0437 \u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e\n\u043c\u0430\u043b\u043e\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439, \u0437\u0435\u0432\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0435\u043a\u043b\u0430\u00bb,\n\u043e\u0434\u044b\u0448\u043a\u0430, \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u0420\u041d\u041a SARS-CoV-2 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0435\n\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u0438 \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c. \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420 \u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u043e-\n\u041e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0438\u0430\u043b\u044c\u043d\u043e\u0435\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u044f\u0432\u043d\u044b\u0439 \u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\u0435,\n\u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u0431\u043e\u043b\u044c\u043d\u044b\u043c \u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435\n19\n\n\u043a\u043e\u0440\u043e\u043d\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u044b,\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u0443\u0442\u043e\u043b\u0449\u0435\u043d\u0438\u0435\n\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0441\u0442\u0435\u043d\u043a\u0438, \u043f\u0430\u0442\u0442\u0435\u0440\u043d\n\u00ab\u0441\u0435\u0442\u0447\u0430\u0442\u043e\u0441\u0442\u0438\u00bb\n\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u041e\u0434\u044b\u0448\u043a\u0430 \u043f\u0440\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u041a\u0422 \u041e\u0413\u041a \u041d\u0430 \u041a\u0422\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435, \u041c\u043e\u043a\u0440\u043e\u0442\u0430 \u043d\u0430 \u041c\u0411\u0422, \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\n\u043d\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c. Gene-Xpert \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b: \u043e\u0442\n\u041a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u0431\u043e\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u043b\u043a\u0438\u0445 \u043e\u0447\u0430\u0433\u043e\u0432\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043e\u043c, \u043b\u0438\u0431\u043e \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0433\u043e\n\u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u043d\u0430 \u043a\u0430\u043b\u0438\u0431\u0440\u0430 \u0438\n\u043f\u0435\