2\u0435\u043b\u0430 \u0432 \u0434\u0435\u043d\u044c \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e (\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u0435\u043b\u0438\u0442\u0441\u044f \u043d\u0430 4 \u043f\u0440\u0438\u0435\u043c\u0430) \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n10-14 \u0434\u043d\u0435\u0439;\n\u2022 \u0434\u0435\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u043b\u043e\u0441\u044c 8 \u043b\u0435\u0442, \u0438\u043b\u0438 \u0434\u0435\u0442\u0438 \u043c\u043e\u043b\u043e\u0436\u0435 8 \u043b\u0435\u0442, \u043d\u043e \u043c\u0430\u0441\u0441\u0430 \u0442\u0435\u043b\u0430\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 >45 \u043a\u0433: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0442\u0430\u043a\u0438\u0435 \u0436\u0435 \u0441\u0445\u0435\u043c\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0430\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d\u043e\u043c, \u043a\u0430\u043a \u0438\n\n\u043f\u0440\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445[29].\n\n\u042d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0433\u043e \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412[19, 39, 40, 42,43]:\n\u2022 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u043c\u043c\u0443\u043d\u043d\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u041b\u041f\u0421\u041d \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412 \u043f\u043e\n\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u04