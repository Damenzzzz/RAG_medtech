0435\u043d\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u0412\u0440\u0430\u0447\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u043d\u0430\u0442\u044c \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0440\u0430\u043d\u043d\u044e\u044e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u043d\u044c\u0448\u0435, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u043a\u0440\u043e\u0432\u044c \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b \u0434\u043b\u044f \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0438 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u043e\u0446\u0435\u043d\u043a\u0430 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439 \u0441 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439, \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439.\n\n\u0421\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0435\u043f\u0441\u0438\u0441\u0430 (\u0440\u0430\u043d\u0435\u0435 \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u0441\u0435\u043f\u0441\u0438\u0441). \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0448\u043a\u0430\u043b\u044b qSOFA, SOFA \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0439 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0435\u0439 \u0442\u0440\u0435\u0431\u0443\u044e\u0442 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0435\u043c\u043e\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b \u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f.\n\n\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u0438. \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0438 \u0430\u0440\u0442\u04