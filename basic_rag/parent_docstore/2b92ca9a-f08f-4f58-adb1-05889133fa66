\u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u043d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f. RPV\n\u043d\u0435\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u043c \u0432 \u0432\u043e\u0434\u0435 \u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u043c \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0435\npH.\nTDF/FTC/EFV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043d\u0435\u0442\n(300(i)/200/600 \u043c\u0433)\nT\u0410F/FTC/RPV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (25/200/25 \u043d\u0435\u0442 \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u043e\u0433\u043b\u043e\u0442\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0443\n\u043c\u0433) \u0446\u0435\u043b\u0438\u043a\u043e\u043c. \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0443 \u043d\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0440\u0430\u0437\u0436\u0435\u0432\u044b\u0432\u0430\u0442\u044c, \u0438\u0437\u043c\u0435\u043b\u044c\u0447\u0430\u0442\u044c \u0438\u043b\u0438 \u0434\u0440\u043e\u0431\u0438\u0442\u044c\nTDF/FTC/RPV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043d\u0435\u0442 \u0418\u0437\u043c\u0435\u043b\u044c\u0447\u0435\u043d\u0438\u0435 \u0442\u0430\u0431\u043b\u0435\u0442\u043e\u043a \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\n(300(i)/200/25 \u043c\u0433) \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c \u043d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f. RPV\n\u043d\u0435\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u043c \u0432 \u0432\u043e\u0434\u0435 \u0432 \u0448\u0438\u0440\u043e\u043a\u043e\u043c \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0435\npH.\n\u0418\u041f\nATV \u043a\u0430\u043f\u0441\u0443\u043b\u044b (150, 200, \u043d\u0435\u0442 \u0434\u0430 \u0422\u0440\u0443\u0434\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f; \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n300 \u043c\u0433) \u0435\u0434\u044b\nATV/\u0441 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (300/150 \u043d\u0435\u0442 \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u043e\u0433\u043b\u043e\u0442\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0443\n\u043c\u0433) \u0446\u0435\u043b\u0438\u043a\u043e\u043c. \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0443 \u043d\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0440\u0430\u0437\u0436\u0435\u0432\u044b\u0432\u0430\u0442\u044c, \u0440\u0430\u0437\u043b\u0430\u043c\u044b\u0432\u0430\u0442\u044c, \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044c \u0438\u043b\u0438\n\u0438\u0437\u043c\u0435\u043b\u044c\u0447\u0430\u0442\u044c\nDRV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (75,150, \u0434\u0430 \u041f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0434\u044b. \u0418\u0437\u043c\u0435\u043b\u044c\u0447\u0435\u043d\u043d\u044b\u0435\n400, 600, \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435\n800 \u043c\u0433) \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u0443\u0442\u0432\u0435\u0440\u0434\u043e\u0439 \u043f\u0438\u0449\u0438 \u0438\u043b\u0438 \u0432\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 (100 \u043c\u0433/\u043c\u043b) \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u044c\n\u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\nDRV/c \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (800/150 \u043d\u0435\u0442\n\u043c\u0433)\nLPV/r \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (200/50 \u043d\u0435\u0442 \u0421\u043f\u0438\u0440\u0442 42%, \u043d\u0435 \u0440\u0430\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0432 \u0432\u043e\u0434\u0435 (\u043c\u043e\u0436\u0435\u0442\n\u043c\u0433) \u0440\u0430\u0441\u0442\u0432\u043e\u0440 (80/20 \u043f\u0440\u043e\u0438\u0437\u043e\u0439\u0442\u0438 \u043e\u0441\u0430\u0436\u0434\u0435\u043d\u0438\u0435), \u0437\u0430\u043f\u0438\u0442\u044c \u043c\u043e\u043b\u043e\u043a\u043e\u043c\n\u043c\u0433/mL) (\u043d\u0435 \u0432\u043e\u0434\u043e\u0439); \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0435\u0434\u044b,\n\u0433\u043e\u0440\u044c\u043a\u0438\u0439 \u0432\u043a\u0443\u0441: \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438 \u0432 \u043c\u043e\u043b\u043e\u0447\u043d\u043e-\n\u0448\u043e\u043a\u043e\u043b\u0430\u0434\u043d\u043e\u043c \u043d\u0430\u043f\u0438\u0442\u043a\u0435\nRTV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (100 \u043c\u0433) \u043d\u0435\u0442 \u0421\u043f\u0438\u0440\u0442 43%, \u043d\u0435 \u0440\u0430\u0437\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0440\u0430\u0441\u0442\u0432\u043e\u0440 (\u043c\u043e\u0436\u0435\u0442\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 (80 \u043c\u0433/\u043c\u043b) \u043f\u0440\u043e\u0438\u0437\u043e\u0439\u0442\u0438 \u043e\u0441\u0430\u0436\u0434\u0435\u043d\u0438\u0435), \u0437\u0430\u043f\u0438\u0442\u044c \u043c\u043e\u043b\u043e\u043a\u043e\u043c\n(\u043d\u0435 \u0432\u043e\u0434\u043e\u0439); \u0433\u043e\u0440\u044c\u043a\u0438\u0439 \u0432\u043a\u0443\u0441; \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u0432\u043e\n\u0432\u0440\u0435\u043c\u044f \u0435\u0434\u044b\n\n\u0414\u0440\u0443\u0433\u0438\u0435\nDTG \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (50 \u043c\u0433) \u0434\u0430 \u0418\u0437\u043c\u0435\u043b\u044c\u0447\u0435\u043d\u043d\u044b\u0435 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u04