\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0443\u043b\u044c\u043c\u043e\u043d\u0438\u0442 + \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u041f\u0426\u0420-\u0426M\u0412-pos). \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u043e\u0432 \u0426\u041c\u0412 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420 \u0441 \u0447\u0430\u0441\u0442\u043e\u0442\u043e\u0439 1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0432\u0438\u0440\u0443\u0441\u0430 \u043d\u0430\u0447\u0430\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u044e. \u0412\u0418\u0420\u0423\u0421\u041d\u042b\u0415 \u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418 \u2013 \u041f\u0420\u041e\u0424\u0418\u041b\u0410\u041a\u0422\u0418\u041a\u0410 \u0418 \u041b\u0415\u0427\u0415\u041d\u0418\u0415 \u0410) \u0412\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u041f\u043b\u0430\u043d\u043e\u0432\u043e: 1) \u043f\u0440\u0438 \u043f\u043e\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0422\u0413\u0421\u041a \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u044f - IgG \u043a \u0432\u0438\u0440\u0443\u0441\u0430\u043c CMV, EBV, HSV1&2, HZV, Toxo \u041f\u0426\u0420 \u043a\u0440\u043e\u0432\u044c \u2013 CMV, EBV - \u0432\u0441\u0435\u043c \u041f\u0440\u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0445 \u2013 \u043c\u0430\u