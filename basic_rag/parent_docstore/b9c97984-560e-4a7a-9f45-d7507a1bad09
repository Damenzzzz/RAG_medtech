2\u0440\u044c \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c \u043f\u043e\n\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0441 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u044b\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c\n\n\u043b\u0430\u0431\u0435\u0442\u0430\u043b\u043e\u043b\u0430 \u043f\u0440\u0438 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0410\u0413 \u0443\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445.\n\u0412\u0430\u0437\u043e\u0434\u0438\u043b\u0430\u0442\u0438\u0440\u0443\u044e \u041c\u0430\u0433\u043d\u0438\u044f \u0441\u0443\u043b\u044c\u0444\u0430\u0442 \u041d\u0430\u0433\u0440\u0443\u0437\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 5 \u0433 (25% - 20 \u043c\u043b) \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0412\n\u0449\u0435\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e: \u0432\u0432\u043e\u0434\u0438\u0442\u044c \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 10-20\n\u043c\u0438\u043d\u0443\u0442 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c 1 \u2013 2\n\u0433/\u0447\u0430\u0441 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24 \u0447\u0430\u0441\u043e\u0432;\n\u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0441\u0443\u0434\u043e\u0440\u043e\u0433 \u0438\u043b\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0435 \u0441\u0443\u0434\u043e\u0440\u043e\u0433\n\u0432\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 2\u20134 \u0433 \u0441\u0443\u0445\u043e\u0433\u043e\n\u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0432/\u0432.\nNB! \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0432\u044b\u0431\u043