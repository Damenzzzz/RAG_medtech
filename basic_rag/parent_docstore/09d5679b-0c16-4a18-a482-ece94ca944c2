0438\u043d\u0430 \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 225 \u043c\u0433.\n\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0414\u0443\u043b\u043e\u043a\u0441\u0435\u0442\u0438\u043d 30 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u0441 \u0421\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\u043c \u0434\u043e 60 \u043c\u0433/\u0441\u0443\u0442.\n\u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 90 \u043c\u0433.\n\n\u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430 \u0438\n\u043d\u043e\u0440\u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430\n\u0422\u0435\u0442\u0440\u0430\u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441 \u041c\u0438\u0440\u0442\u0430\u0437\u0430\u043f\u0438\u043d* \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 15 \u043c\u0433 C\n\u043a\u0438\u0439 \u0432\u043d\u0443\u0442\u0440\u044c.\n\n\u0430\u043d\u0442\u0438\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442 \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 45 \u043c\u0433.\n\u0410\u043d\u0442\u0438\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d \u041c\u0438\u0430\u043d\u0441\u0435\u0440\u0438\u043d \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 30 \u043c\u0433 \u0421\n\u0442\u044b \u0432\u043d\u0443\u0442\u0440\u044c.\n\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438 \u0434\u043e 90\n\u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0410\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0435 \u041e\u043b\u0430\u043d\u0437\u0430\u043f\u0438\u043d** \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 5 \u043c\u0433 \u0421\n\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 20 \u043c\u0433.\n*\u041c\u0438\u0440\u0442\u0430\u0437\u0430\u043f\u0438\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u0435\u043d \u0434\u043b\u044f \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0441\u0443\u0438\u0446\u0438\u0434\u0430\u043b\u044c\u043d\u044b\u043c\u0438\n\n\u043c\u044b\u0441\u043b\u044f\u043c\u0438, \u0441 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c \u0441\u043d\u0430.\n**\u041e\u043b\u0430\u043d\u0437\u0430\u043f\u0438\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u0435\u043d \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u0438 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438 \u0441\n\u0433\u0438\u043f\u0435\u0440\u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c\u044e \u0438\u0434\u0435\u0439, \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u0438\n\u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 8.1 \u2013 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0442\u0440\u0435\u0432\u043e\u0433\u0438, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u0438, \u0430\u043f\u0430\u0442\u0438\u0438 \u043f\u0440\u0438 \u0411\u0413 \u0432 \u0434\u0435\u0442\u0441\u043a\u043e\u043c\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435.\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0442\u0438\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0421\u0435\u0440\u0442\u0440\u0430\u043b\u0438\u043d \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 6 \u043b\u0435\u0442, C\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0421\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f\n\n\u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 25 \u043c\u0433.\n\u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 200 \u043c\u0433.\n\u0421\u0435\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0424\u043b\u0443\u043e\u043a\u0441\u0435\u0442\u0438\u043d \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 6 \u043b\u0435\u0442, \u0421\n\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. 20 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0441\n\u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\u043c.\n\u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0441\u0435\u0440\u043e\u0442\u043e\u043d\u0438\u043d\u0430 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430: 40 \u043c\u0433.\n\n31\n\nNB! \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u0443\u0441\u0438\u043b\u0438\u0442\u044c \u0430\u043f\u0430\u0442\u0438\u044e,\n\u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u043d\u0435\u043d\u0443\u0436\u043d\u044b\u0445 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0438\u043b\u0438 \u0441\u043d\u0438\u0436\u0430\u0442\u044c \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0443.\n\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u043e\u0439 \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\n\u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0434\u043a\u0430 \u0434\u043d\u044f \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u0437\u0430\u043d\u044f\u0442\u0438\u0439. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435\n\n\u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043c\u043e\u0436\u0435\u0442 \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0440\u0435\u0436\u0438\u043c\u0430\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u044c \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0441\u0438\u0445\u043e\u0437\u043e\u0432 \u043f\u0440\u0438 \u0411\u0413", "type": "Document"}}