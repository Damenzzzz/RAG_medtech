{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_15968c3bb64e", "title": "\u0410\u041d\u041a\u0418\u041b\u041e\u0417\u0418\u0420\u0423\u042e\u0429\u0418\u0419 \u0421\u041f\u041e\u041d\u0414\u0418\u041b\u0418\u0422", "source_file": "2025_\u0410\u041d\u041a\u0418\u041b\u041e\u0417\u0418\u0420\u0423\u042e\u0429\u0418\u0418_\u0421\u041f\u041e\u041d\u0414\u0418\u041b\u0418\u0422_7376f3bef7.pdf", "icd_codes": "M08.1, M46.8", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0410\u041d\u041a\u0418\u041b\u041e\u0417\u0418\u0420\u0423\u042e\u0429\u0418\u0419 \u0421\u041f\u041e\u041d\u0414\u0418\u041b\u0418\u0422.pdf"}, "page_content": "\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438.\n\u2022 \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0438\u043d\u0442\u0435\u0440\u043a\u0443\u0440\u0440\u0435\u043d\u0442\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e\n\u0411\u041f\u0412\u041f/\u0413\u0418\u0411\u0422.\n\u2022 \u041e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (\u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\n\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445, \u0416\u041a\u0422, \u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442)\n\u2022 \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043f\u043e\u043b\u043d\u043e\u0439 \u0430\u0442\u0440\u0438\u043e\u0432\u0435\u043d\u0442\u0440\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u0431\u043b\u043e\u043a\u0430\u0434\u044b (\u0432 \u0446\u0435\u043b\u044f\u0445 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438\n\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0440\u0438\u0442\u043c\u0430) - \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0435 \u043a\u0430\u0440\u0434\u0438\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\n\u2022 \u041f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u044b\u0445 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043d\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445,\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0435\n\n32\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n5.1 \u043a\u0430\u0440\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430:\n\n\u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435/ \u0445\u0438-\n\u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u043d-\n\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f:\n\u0441\u043a \u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c\n- \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e-\n\u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442-\n\u0441\u0442\u0438,\n\u0434\u0435\u043b\u0435\u043d\u0438\u044f:\n- \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u0437\u0430-\n- \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f/ \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u0442\u0435-\n\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0433\u043e\n\u041e\u0431\u043b\u0430\u0441\u0442\u043d\u044b\u0435 \u0438 \u0433\u043e- \u043f\u0435\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f,\n\u0440\u043e\u0434\u0441\u043a\u0438\u0435 \u0441\u0442\u0430\u0446\u0438\u043e- - \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n- \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0445\u0438\u0440\u0443\u0440\u0433\u0438-\n\u043d\u0430\u0440\u044b - \u0438\u043d\u0438\u0446\u0438\u0430\u0446\u0438\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u043e\u043d-\n\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043d\u043e\u0439 \u0413\u0418\u0411\u0422\n\u0412\u041e\u041f \u041f\u041c\u0421\u041f: \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u0441\u043f\u0438\u043d\u0435, \u0430\u0441\u0441\u0438\u043c\u0435\u0442-\n\u0440\u0438\u0447\u043d\u044b\u0439 \u0430\u0440\u0442\u0440\u0438\u0442, \u044d\u043d\u0442\u0435\u0437\u0438\u0442\u044b, \u0434\u0430\u043a\u0442\u0438\u043b\u0438\u0442\n\u0420 \u0435 \u0432 \u043c \u0430 \u0442 \u043e -\n\u043b\u043e\u0433\n\u041f \u041c\u0421\u041f: \u041e\u043a\u0443\u043b\u0438\u0441\u0442 \u041f\u041c\u0421\u041f: \u0443\u0432\u0435\u0438\u0442, \u0438\u0440\u0438\u0434\u043e\u0446\u0438\u043a\u043b\u0438\u0442 + \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c-\n\u041e\u0431\u0441\u043b\u0435\u0434\u043e- \u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u0441\u043f\u0438\u043d\u0435 \u0438\u043b\u0438 \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043a \u0421\u043f\u0410\n\u0432 \u0430\u043d\u0438\u0435, \u0432\u0435- \u043f\u0430\u0446\u0438\u0435\u043d\u0442\n\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f\n\u0413\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043b\u043e\u0433 \u041f\u041c\u0421\u041f: \u0412\u0417\u041a + \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0431\u043e\u043b\u044c\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430,\n\u0432 \u0441\u043f\u0438\u043d\u0435 \u0438\u043b\u0438 \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043a \u0421\u043f\u0410\n\u0430\u043c\u0431\u0443\u043b\u0430-\n\u0442\u043e\u0440\u043d\u043e\u0435 \u043b\u0435-\n\u0447\u0435\u043d\u0438\u0435 \u0414\u0435\u0440\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u041f\u041c\u0421\u041f: \u043f\u0441\u043e\u0440\u0438\u0430\u0437 + \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0432\n\u0441\u043f\u0438\u043d\u0435 \u0438\u043b\u0438 \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043a \u0421\u043f\u0410\n\u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0420\u0435\u0436\u0438\u043c 3;\n\u0414\u0438\u0435\u0442\u0430 No15\n\u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043a\u0443\u0440\u0435\u043d\u0438\u044f;\n\u043b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430;\n5.3 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u041e\u0441\u043d\u043e\u0432\u0443 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0410\u0421 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u041d\u041f\u0412\u041f, \u0431\u0430\u0437\u0438\u0441\u043d\u044b\u0435\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b (\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u0440\u0442\u0440\u0438\u0442\u043e\u0432,\n\u0443\u0432\u0435\u0438\u0442\u043e\u0432), \u0413\u0418\u0411\u041f.\n\u0423 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u043c \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u043c \u041d\u041f\u0412\u041f \u043c\u043e\u0436\u043d\u043e\n\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0434\u043e\u0437 \u0413\u041a (250 - 1000 \u043c\u0433) \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1-3\n\u0434\u043d\u0435\u0439 (\u00ab\u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u044f\u00bb).\n\u0412 \u0441\u043e\u0441\u0442\u0430\u0432\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u044b [46], \u043f\u0440\u0435-\n\u043f\u0430\u0440\u0430\u0442\u044b, \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0449\u0438\u0435 \u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0440\u043a\u0443\u043b\u044f\u0446\u0438\u044e [55]. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u043e\u0432 \u0438 \u043f\u0440\u0435-\n\n\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0449\u0438\u0445 \u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0440\u043a\u0443\u043b\u044f\u0446\u0438\u044e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0437\u0430-\n\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432.\n33\n\n\u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439,\n\n\u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043