2 144\u00b113\nHt (%) 35\u00b13 38\u00b13 39\u00b13 44\u00b15\n\n12.4. \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f [2,3,6,7,8,9]:\n\n\u0423\u0417\u0418: \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0451\u043c\u0430 \u043f\u043b\u0430\u0446\u0435\u043d\u0442\u044b, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0435\u0451 \u0442\u043e\u043b\u0449\u0438\u043d\u044b, \u043c\u043d\u043e\u0433\u043e\u0432\u043e\u0434\u0438\u0435, \u0433\u0435\u043f\u0430\u0442\u043e \u2013\n\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f \u043f\u043b\u043e\u0434\u0430, \u0430\u0441\u0446\u0438\u0442, \u0433\u0438\u0434\u0440\u043e\u0442\u043e\u0440\u0430\u043a\u0441, \u0433\u0438\u0434\u0440\u043e\u043f\u0435\u0440\u0438\u043a\u0430\u0440\u0434, \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u044b\u0439 \u043e\u0442\u0435\u043a (\u0434\u0432\u043e\u0439\u043d\u043e\u0439\n\u043a\u043e\u043d\u0442\u0443\u0440).\n\u0414\u043e\u043f\u043f\u043b\u0435\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u041c\u041f\u041f\u041a: \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u043e\u043b\u043e-\u0434\u0438\u0430\u0441\u0442\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0438\n\u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0438 \u043f\u0443\u043f\u043e\u0432\u0438\u043d\u044b \u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u043a\u0430 \u0432\n\n\u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u04