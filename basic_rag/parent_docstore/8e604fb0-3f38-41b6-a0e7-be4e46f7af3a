043e\u0442\u0440 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n(\u0442\u0430\u0437\u043e\u0431\u0435\u0434\u0440\u0435\u043d\u043d\u044b\u0439 \u0438\u043c\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043b\u0435\u043d\u043e, \u0422\u0411\u0421/\u043d\u0435\u0432\u0440\u043e\u043e\u0441\u043c\u043e\u0442 \u0422\u0411\u0421/\u043f\u043e\u044f\u0441\u043d\u0438\u0446\u044b,\n\u0441\u0443\u0441\u0442\u0430\u0432 / \u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u044b\u0439 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b \u0440; \u0440\u0435\u043d\u0442\u0433\u0435\u043d \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\n\u043e\u0442\u0434\u0435\u043b) \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0422\u0411\u0421/\u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u043e\u0433 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043b\u0438 \u043e \u043e\u0442\u0434\u0435\u043b\u0430 (\u043f\u043e\n\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0432 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c)\n\u0442\u0430\u0437\u043e\u0431\u0435\u0434\u0440\u0435\u043d\u043d\u043e\u043c \u0441\u0443\u0441\u0442\u0430\u0432\u0435\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u0412 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u042b\u0425 \u0423\u0421\u041b\u041e\u0412\u0418\u042f\u0425 [3-20]:\n1) \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0420\u0435\u0436\u0438\u043c: \u0449\u0430\u0434\u044f\u0449\u0438\u0439 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c: \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043d\u0430\u0433\u0440\u0443\u0437\u043e\u043a, \u043f\u043e\u0434\u044a\u0451\u043c\u0430 \u0442\u044f\u0436\u0435\u0441\u0442\u0435\u0439, \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u043e\u0441\u0435\u0432\u044b\u0445 \u043d\u0430\u0433\u0440\u0443\u0437\u043e\u043a; \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c.\n\u041f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u2014 \u0442\u0440\u043e\u0441\u0442\u044c (\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0439 \u0440\u0443\u043a\u0435) \u0438/\u0438\u043b\u0438 \u043e\u0440\u0442\u0435\u0437/\u0431\u0440\u0435\u0439\u0441 \u0434\u043b\u044f \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043a\u0438\n[14].\n\u0414\u0438\u0435\u0442\u0430 No15, \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439, \u0442\u0440\u0435\u0431\u0443\u044e\u0449\u0438\u0445 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0435\u0442\u044b.\n\n\u041f\u0440\u0438 \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430/\u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n(\u043a\u0430\u043b\u043e\u0440\u0438\u0439\u043d\u044b\u0439 \u0434\u0435\u0444\u0438\u0446\u0438\u0442 + \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438), \u043a\u0430\u043a \u043c\u0435\u0442\u043e\u0434 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f\n\u0431\u043e\u043b\u0438 \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438 [15].\n2) \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [17]\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441 \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 (\u041d\u041f\u0412\u041f) \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u041d\u041f\u0412\u041f.\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u0433\u0440\u0443\u043f\u043f\u0430\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u0430\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0418\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0412\u043d\u0443\u0442\u0440\u044c 400 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 4-6 \u0447\u0430\u0441\u043e\u0432 \u0410\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u043b\u0438 600-800 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 6-8 \u0447\u0430\u0441\u043e\u0432.\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 5 \u0434\u043d\u0435\u0439.\n\u041a\u0440\u0435\u043c 5% \u043d\u0430\u0440\u0443\u0436\u043d\u043e 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u041d\u0435 \u0431\u043e\u043b\u0435\u0435 14 \u0434\u043d\u0435\u0439.\n\u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u041c\u0430\u0437\u044c, \u0433\u0435\u043b\u044c 1%, 2% \u043d\u0430\u0440\u0443\u0436\u043d\u043e 2 \u0440\u0430\u0437\u0430 \u0432 \u0410\n\u0434\u0435\u043d\u044c. 10-14\u043d\u0435\u0439.\n\u0432\u043d\u0443\u0442\u0440\u044c 50 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8-12 \u0447\u0430\u0441\u043e\u0432. \u041d\u0435\n\u0431\u043e\u043b\u0435\u0435 3-5 \u0434\u043d\u0435\u0439.\n\u041c\u0435\u043b\u043e\u043a\u0441\u0438\u043a\u0430\u043c \u0412\u043d\u0443\u0442\u0440\u044c 7,5-15 \u043c\u0433/\u0441\u0443\u0442. \u041a\u0430\u0436\u0434\u044b\u0435 24 \u0410\n\u0447\u0430\u0441\u0430. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430\n15 \u043c\u0433. \u041a\u0443\u0440\u0441 2-4 \u043d\u0435\u0434\u0435\u043b\u0438.\n\u042d\u0442\u043e\u0440\u0438\u043a\u043e\u043a\u0441\u0438\u0431 30\u201360 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c. \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0410\n3-5 \u0434\u043d\u0435\u0439\n\u041d\u0430\u043f\u0440\u043e\u043a\u0441\u0435\u043d \u0432\u043d\u0443\u0442\u0440\u044c 250 - 500\u043c\u0433 \u0432 1 -2 \u0440\u0430\u0437\u0430 \u0432 \u0410\n\n\u0434\u0435\u043d\u044c. \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 3-5 \u0434\u043d\u0435\u0439.\n\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435\n\u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b \u0412\u043d\u0443\u0442\u0440\u044c 20 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0434\u043e 14 \u0410\n\u043f\u043e\u043c\u043f\u044b \u0434\u043d\u0435\u0439.\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b \u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u041f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0431\u043e\u043b\u0435\u0432\u044b\u043c \u0412\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u043e\u043c \u0412\u043d\u0443\u0442\u0440\u0438\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e 1-2 \u043c\u043b,\n1 \u0440\u0430\u0437 \u0432 3 \u043c\u0435\u0441\u044f\u0446\u0430. \u041a\u0443\u0440\u0441 3-4 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438.\n3) \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u0442.\n\n4) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u0442\u0438\u043f\u0430 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 [22,23,24]:\n1) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\n\u2022 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f (\u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435\n\u043e\u0441\u0442\u0435\u043e\u0442\u043e\u043c\u0438\u0438, \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430);\n\u2022 \u0441\u0442\u043e\u0439\u043a\u0438\u0439 \u0431\u043e\u043b\u0435\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\n\u043f\u0440\u0438 \u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0433\u043e \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f;\n\u2022 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043e\u0441\u0438 \u043d\u0438\u0436\u043d\u0435\u0439\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438;\n\n\u2022 III-IV \u0441\u0442\u0430\u0434\u0438\u044f \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n\n2) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 (\u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e, \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0430\u044f\n\n\u0431\u043e\u043b\u044c, \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u043e\u0442\u0451\u043a, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439, \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438);\n\u2022 \u043e\u0441\u0442\u0440\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u0448\u0430\u044f \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u043c \u0441\u0443\u0441\u0442\u0430\u0432\u0435 \u0441 \u0431\u044b\u0441\u0442\u0440\u044b\u043c \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\u043c\n\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u0441\u0443\u0431\u0445\u043e\u043d\u0434\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c \u0438\u043b\u0438 \u043e\u0441\u0442\u0435\u043e\u043d\u0435\u043a\u0440\u043e\u0437;\n\u2022 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0441 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u043f\u043e\u0440\u044b,\n\u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u0432\u043d\u0443\u0442\u0440\u0438\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u043b\u043e\u043c \u0438\u043b\u0438 \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0439 \u0433\u0435\u043c\u0430\u0440\u0442\u0440\u043e\u0437;\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u043d\u0435\u0439\u0440\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 (\u0440\u0435\u0437\u043a\u0430\u044f \u0431\u043e\u043b\u044c,\n\n\u043f\u043e\u0445\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439).\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u0412 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u042b\u0425 \u0423\u0421\u041b\u041e\u0412\u0418\u042f\u0425 [25,26,27]:\n1) \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u0420\u0435\u0436\u0438\u043c: \u0412 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0449\u0430\u0434\u044f\u0449\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u0441 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u043d\u044b\u0439 \u0441\u0443\u0441\u0442\u0430\u0432, \u0440\u0430\u043d\u043d\u0435\u0439 \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 (\u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439), \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u043e\u0441\u0435\u0432\u044b\u0445 \u043d\u0430\u0433\u0440\u0443\u0437\u043e\u043a, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u043e\u0440\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432\n\n\u043f\u0440\u0435\u0434\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u0445.\n\n\u041b\u0435\u0447\u0435\u0431\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0438 \u0434\u0438\u0435\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f: \u0414\u0438\u0435\u0442\u0430 No15. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u0435\n\u043b\u0435\u0447\u0435\u0431\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0441 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435\u043c \u0431\u0435\u043b\u043a\u0430, \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u043e\u0432 \u0438 \u043c\u0438\u043a\u0440\u043e\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432,\n\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0441\u044b, \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0438\n\u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044e \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439.\n\u0414\u0438\u0435\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f. \u041f\u0440\u0438 \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430 \u0438 \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u0438\u0435\u0442\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\n\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043d\u0430 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u043a\u0430\u043a \u0444\u0430\u043a\u0442\u043e\u0440 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0438\n\u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430. \u0412 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0440\u0430\u0446\u0438\u043e\u043d\u0430 \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f.\n\u041b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 (\u041b\u0424\u041a): \u041b\u0435\u0447\u0435\u0431\u043d\u0430\u044f \u0444\u0438\u0437\u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\n\n\u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u043c \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0435\n\u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f, \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0451\u043c\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439, \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u043c\u044b\u0448\u0446\n\u043d\u0438\u0436\u043d\u0435\u0439 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0432\n\u043f\u0440\u0435\u0434\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c, \u0442\u0430\u043a \u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u0445.\n\n2) \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u0421 \u0446\u0435\u043b\u044c\u044e \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0430\u043d\u0442\u0438\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u0430\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430", "type": "Document"}}