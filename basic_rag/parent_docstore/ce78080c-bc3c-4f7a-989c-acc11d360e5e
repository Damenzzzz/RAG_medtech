445\u044f\u043d, \u0410.\u041c.\u0429\u0438\u043a\u043e\u0442\u0430, \u0410.\u0410.\u042f\u043b\u044b\u043c\u043e\u0432 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u00ab\u0448\u0438\u0440\u043e\u043a\u0438\u0445\u00bb \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u0439. \u0420\u0443\u0441\u0441\u043a\u0438\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0436\u0443\u0440\u043d\u0430\u043b, 2012)\n\n30\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 2\n\n\u0410\u043d\u0442\u0438\u0430\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0416\u0410: \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0435\n\u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f.\n(\u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0438\u0437 2015 ESC Guidelines for the management of patients with ventricular\narrhythmias and the prevention of sudden cardiac death)\n\n\u0410\u0410\u041f, \u043a\u043b\u0430\u0441\u0441 \u043f\u043e \u0427\u0430\u0441\u0442\u044b\u0435 \u0438 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0435 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u041a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\nVaughan- \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f\nWilliams\n\u041b\u0435\u0433\u043e\u0447\u043d\u044b\u0439 \u0444\u0438\u0431\u0440\u043e\u0437, \u0433\u0438\u043f\u043e- \u0438 \u0416\u0422, \u0424\u0416 \u0414\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u0433\u0438\u043f\u0435\u0440\u0442\u0438\u0440\u0435\u043e\u0438\u0434\u0438\u0437\u043c, \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438, \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u043c\u0438 QT-\n\u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u0435, \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b; \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0442\u0438\u043f\u044b\n\u0444\u043e\u0442\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d\u043e\u0433\u043e QT-\n\u0410\u043c\u0438\u043e\u0434\u0430\u0440\u043e\u043d\n\u043e\u043a\u0440\u0430\u0441\u043a\u0430 \u043a\u043e\u0436\u0438, \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430; \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f;\n(III)\n\u0433\u0435\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c, \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u0438\u0435 QT- \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u0431\u0435\u0437\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430, \u0416\u0422 \u0442\u0438\u043f\u0430 \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb. \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u0425\u0421\u041d.\n\u0411\u0440\u043e\u043d\u0445\u043e\u0441\u043f\u0430\u0437\u043c, \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f, \u0416\u042d, \u0416\u0422, \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0438\n\u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u0410\u0412- \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u0431\u043b\u043e\u043a\u0430\u0434\u0430, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u0431\u0435\u0437\n\u0411\u0435\u0442\u0430- \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u044f. \u043e\u0433\u043e QT- \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u043e\u0441\u0442\u0440\u0430\u044f \u0444\u0430\u0437\u0430 \u0438\u043d\u0444\u0430\u0440\u043a\u0442\u0430\n\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 (\u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d \u043f\u0440\u0438\n(II) \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u0438, \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u0438,\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430);\n\u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0425\u0421\u041d,\n\u0441\u0442\u0435\u043d\u043e\u043a\u0430\u0440\u0434\u0438\u044f \u041f\u0440\u0438\u043d\u0446\u043c\u0435\u0442\u0430\u043b\u0430.\n\u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0435 \u0422\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0421\u0421\u0423(\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 QRS, \u0410\u0412-\u0431\u043b\u043e\u043a\u0430\u0434\u0430, (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\u0414\u0438\u0437\u043e\u043f\u0438\u0440\u0430\u043c\u0438\u0434 \u043f\u0440\u043e\u0430\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0433\u043e\n(IA) (\u0422\u041f, \u043c\u043e\u043d\u043e\u043c\u043e\u0440\u0444\u043d\u0430\u044f \u0416\u0422, \u0416\u0422 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f; \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0444\u0430\u0440\u043a\u0442\n\u0442\u0438\u043f\u0430 \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb), \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430; \u0418\u0411\u0421; \u0425\u0421\u041d; \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412\n\u0430\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430; \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f.\n\u044d\u0444\u0444\u0435\u043a\u0442\u044b.\n\u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0435 \u0416\u042d, \u0416\u0422 \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0424\u041f/\u0422\u041f;\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 QRS, \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u0410\u0412-\u0431\u043b\u043e\u043a\u0430\u0434\u0430, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0433\u043e\n\u043f\u0440\u043e\u0430\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f; \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0444\u0430\u0440\u043a\u0442\n(\u0422\u041f, \u043c\u043e\u043d\u043e\u043c\u043e\u0440\u0444\u043d\u0430\u044f \u0416\u0422, \u0416\u0422 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430; \u0418\u0411\u0421; \u0425\u0421\u041d; \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412\n\u0424\u043b\u0435\u043a\u0430\u0438\u043d\u0438\u0434 \u0442\u0438\u043f\u0430 \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb), \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430; \u043a\u043b\u0430\u043f\u0430\u043d\u043d\u044b\u0435\n(IC) \u0441\u043c\u0435\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0441\u0435\u0440\u0434\u0446\u0430 \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c\n\u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u043c \u0438\u043d\u0444\u0430\u0440\u043a\u0442\u043e\u043c \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438; \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u0440\u0443\u0433\u0430\u0434\u0430;\n\u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430. \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0442\u0438\u043f\u044b \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n\u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d\u043e\u0433\u043e QT-\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 (\u043a\u0440\u043e\u043c\u0435\nLQTS3); \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u043c\u0438 QT-\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b.\n\u041c\u0435\u043a\u0441\u0438\u043b\u0435\u0442\u0438\u043d \u0422\u0440\u0435\u043c\u043e\u0440, \u0434\u0438\u0437\u0430\u0440\u0442\u0440\u0438\u044f, \u0416\u0422, \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n31\n\n(IB) \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u0431\u0435\u0437\n\u0433\u0430\u0441\u0442\u0440\u043e\u0438\u043d\u0442\u0435\u0441\u0442\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0425\u0421\u041d;\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f, \u043e\u0433\u043e QT- \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412 \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430;\n\u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f. \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0442\u0438\u043f\u044b \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n3 \u0442\u0438\u043f\u0430. \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d\u043e\u0433\u043e QT-\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 (\u043a\u0440\u043e\u043c\u0435\nLQTS3); \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u043c\u0438 QT-\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b.\n\u0421\u044b\u043f\u044c, \u043c\u0438\u0430\u043b\u0433\u0438\u0438, \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u044b, \u0416\u0422 \u0422\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0421\u0421\u0423(\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f, \u0432\u043e\u043b\u0447\u0430\u043d\u043e\u0447\u043d\u043e- \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\u041f\u0440\u043e\u043a\u0430\u0438\u043d\u0430\u043c\u0438\u0434 \u0430\u0433\u0440\u043e\u043d\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0437, \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0433\u043e\n(IA) \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 QT, \u0416\u0422 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f; \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0444\u0430\u0440\u043a\u0442\n\u0442\u0438\u043f\u0430 \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430; \u0418\u0411\u0421; \u0425\u0421\u041d; \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412\n\u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430; \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f,\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u0440\u0443\u0433\u0430\u0434\u0430.\n\n\u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u043e\u0435 \u0416\u042d, \u0416\u0422 \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0438\u043b\u0438\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u0433\u0430\u0441\u0442\u0440\u043e\u0438\u043d\u0442\u0435\u0441\u0442\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0424\u041f/\u0422\u041f; \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 QRS, \u0410\u0412-\u0431\u043b\u043e\u043a\u0430\u0434\u0430, \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n\u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u0432\u043d\u0443\u0442\u0440\u0438\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f;\n\u043f\u0440\u043e\u0430\u0440\u0438\u0442\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 (\u0422\u041f, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0444\u0430\u0440\u043a\u0442 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430;\n\u041f\u0440\u043e\u043f\u0430\u0444\u0435\u043d\u043e\u043d \u043c\u043e\u043d\u043e\u043c\u043e\u0440\u0444\u043d\u0430\u044f \u0416\u0422, \u0416\u0422 \u0442\u0438\u043f\u0430 \u0418\u0411\u0421; \u0425\u0421\u041d; \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412 \u043b\u0435\u0432\u043e\u0433\u043e\n(IC) \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb). \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430; \u043a\u043b\u0430\u043f\u0430\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438\n\u0441\u0435\u0440\u0434\u0446\u0430 \u0441 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438;\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u0440\u0443\u0433\u0430\u0434\u0430; \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435\n\u0442\u0438\u043f\u044b \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d\u043e\u0433\u043e QT-\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 (\u043a\u0440\u043e\u043c\u0435 LQTS3);\n\u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u043c\u0438 QT-\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b.\n\n\u0422\u043e\u0448\u043d\u043e\u0442\u0430, \u0434\u0438\u0430\u0440\u0435\u044f, \u0441\u043b\u0443\u0445\u043e\u0432\u044b\u0435 \u0438 \u0416\u0422, \u0424\u0416, \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0438\u043b\u0438\n\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0421\u0421\u0423 (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421);\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u044f, \u0443\u043a\u043e\u0440\u043e\u0447\u0435\u043d \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0410\u0412-\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f, \u043d\u043e\u0433\u043e (\u0431\u0435\u0437 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u042d\u041a\u0421); \u0442\u044f\u0436\u0435\u043b\u044b\u0435\n\u0433\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043d\u0435\u043c\u0438\u044f, \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0433\u043e\n\u0430\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0441\u0438\u044f, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 QT, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f; \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044b\u0439 \u0438\u043d\u0444\u0430\u0440\u043a\u0442\n\u0425\u0438\u043d\u0438\u0434\u0438\u043d (IA) \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430 QRS, \u0443\u0434\u043b\u0438\u043d\u0435\u043d\u0438\u0435 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430; \u0418\u0411\u0421; \u0425\u0421\u041d; \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u0430\u044f \u0424\u0412\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430 QT, \u043c\u043e\u043d\u043e\u043c\u043e\u0440\u0444\u043d\u0430\u044f \u0411\u0440\u0443\u0433\u0430\u0434\u0430. \u043b\u0435\u0432\u043e\u0433\u043e \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u0430; \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f;\n\u0416\u0422, \u0416\u0422 \u0442\u0438\u043f\u0430 \u00ab\u043f\u0438\u0440\u0443\u044d\u0442\u00bb. \u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0442\u0438\u043f\u044b \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n\u0443\u0434\u043b\u0438\u043d\u0435\u043d\u043d\u043e\u0433\u043e QT-\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430;\n\u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u043c\u0438 QT-\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b.\n\u0413\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u0442\u043e\u0448\u043d\u043e\u0442\u0430, LQTS3 \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0438\u043d\u0443\u0441\u043e\u0432\u0430\u044f \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u044f \u0438\u043b\u0438\n\u0437\u0430\u043f\u043e\u0440\u044b, \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u044f, \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u0421\u0421\u0421\u0423; \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0425\u0421\u041d;", "type": "Document"}}