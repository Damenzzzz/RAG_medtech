438\u0438.\n5) \u0410\u0431\u0438\u043b\u043e\u0432 \u0420\u0443\u0441\u043b\u0430\u043d \u0421\u0430\u0440\u0442\u0430\u0435\u0432\u0438\u0447 \u2013 \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041d\u0430\u0443\u0447\u043d\u043e-\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439\n\n\u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 - \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433.\n6) \u0418\u0445\u0430\u043c\u0431\u0430\u0435\u0432\u0430 \u0410\u0439\u043d\u0443\u0440 \u041d\u044b\u0433\u044b\u043c\u0430\u043d\u043e\u0432\u043d\u0430 \u2013 \u0410\u041e \u00ab\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440\n\u043d\u0435\u0439\u0440\u043e\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0438\u00bb \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433.\n\n17. \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\n\n18. \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b: \u0420\u0430\u0445\u0438\u043c\u043e\u0432 \u0421\u0435\u0440\u0438\u043a \u041a\u0443\u043b\u044c\u0447\u0430\u043d\u043e\u0432\u0438\u0447 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a,\n\u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043e\u0440\u0