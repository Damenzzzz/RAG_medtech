u0438\u0436\u0435\u043d\u0438\u0435\n\u043e\u0441\u0442\u0440\u043e\u0442\u044b \u0437\u0440\u0435\u043d\u0438\u044f\n4. \u0421\u0443\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f\n5. \u0416\u0430\u043b\u043e\u0431 \u043d\u0435\u0442\n\n\u0412\u0438\u0437\u043e\u043c\u0435 \u2022 \u0411\u0438\u043e\u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f: \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439 \u041e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u0441 \u0422\u043e\u043d\u043e\u043c\u0435\u0442\u0440\u0438 \u041f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u044f: \u0413\u043e\u043d\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u041c\u043e\u0440\u0444\u043e\u043c\u0435\u0442\u0440\u0438\u0447\n\u043c\u0435\u0442\u0440\u0438\u044f: \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u0440\u0430\u0434\u0443\u0436\u043d\u043e\u0439 \u043a\u043e\u043f\u0438\u044f: \u044f: \u0441\u0443\u0436\u0435\u043d\u0438\u0435: \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0430\u044f \u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437\n\u0441\u043d\u0438\u0436\u0435\u043d \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438. \u041f\u0440\u0438 \u0444\u0430\u043a\u043e\u043c\u043e\u0440\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0433\u0440\u0430\u043d\u0438\u0446 \u043f\u043e\u043b\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0434\u0438\u0441\u043a\u0430\n\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043c\u0435\u043b\u043a\u0430\u044f \u043f\u0435\u0440\u0435\u0434\u043d\u044f\u044f \u043a\u0430\u043c\u0435\u0440\u0430, \u0445\u0440\u0443\u0441\u0442\u0430\u043b\u0438\u043a \u0438 \u0412\u0413\u0414 \u0432\u044b\u0448\u0435 \u0437\u0440\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u043c\u0443\u0442\u043d\u044b\u0439, \u0441 \u043f\u0435\u0440\u043b\u0430\u043c\u0443\u0442\u0440\u043e\u0432\u044b\u043c \u043e\u0442\u0442\u0435\u043d\u043a\u043e\u043c; \u043f\u0440\u0438\n\u043e\u0441\u0442\u0440\u043e\u0442\u044b \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0433 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0443\u0433\u043b\u0430 \u043d\u0435\u0440\u0432\u0430:\n\u0443\u0432\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0435 - \u0437\u0430\u0434\u043d\u0438\u0435 \u0441\u0438\u043d\u0435\u0445\u0438\u0438,\n\u0437\u0440\u0435\u043d\u0438\u044f \u044d\u043a\u0441\u043a\u0430\u0432\u0430\u0446\u0438\u0438 \u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0437\u0430\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u0441\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0437\u0440\u0430\u0447\u043a\u0430. \u0413\u0438\u0444\u0435\u043c\u0430,\n\u043d\u0430 \u0434\u0438\u0441\u043a\u0435 \u043f\u043e\u043b\u0435 \u0437\u0440\u0435\u043d\u0438\u044f \u043a\u0430\u043c\u0435\u0440\u044b, \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u043d\u043e\u0439\n\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0441\u043e\u0441\u0443\u0434\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u0438\n\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e\u0439 \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0435. \u041f\u0440\u0438 \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043d\u0435\u0440\u0432\u0430, \u0433\u043e\u043d\u0438\u043e\u0441\u0438\u043d\u0435\u0445\u0438\u0439 \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438\n\u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0435 - \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439\n\u0434\u0435\u043a\u043e\u043b\u043e\u0440\u0430\u0446\u0438, \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e\n\u043a\u0430\u043c\u0435\u0440\u044b. \u041f\u0440\u0438 \u0444\u0430\u043a\u043e\u0442\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0439 - \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438\n\u044f \u0438 \u0442\u0435\u043b\u0430, + \u0442\u043a\u0430\u043d\u0438,\n\u0441\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0445\u0440\u0443\u0441\u0442\u0430\u043b\u0438\u043a\u0430, \u0433\u0440\u044b\u0436\u0430 \u0441\u0442\u0435\u043a\u043b\u043e\u0432\u0438\u0434\u043d\u043e\u0433\u043e\n\u0442\u0435\u043b\u0430. \u041f\u0440\u0438 \u043d\u0435\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 - \u043d\u0430\u043b\u0438\u0447\u0438\u0435 + \u0442\u043a\u0430\u043d\u0438 \u0432 \u0430\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f \u0433\u0438\u0444\u0435\u043c\u0430\n\u0443\u0433\u043b\u0443 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u043a\u0430\u043c\u0435\u0440\u044b \u0434\u0438\u0441\u043a\u0430\n\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u043d\u0435\u0440\u0432\u0430", "type": "Document"}}