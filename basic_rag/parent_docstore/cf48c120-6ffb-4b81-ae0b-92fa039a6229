-\u0435 \u0438\u0437\u0434., \u0438\u0441\u043f\u0440. \u0438 \u0434\u043e\u043f. - \u041c.: \u0413\u042d\u041e\u0422\u0410\u0420-\u041c\u0435\u0434\u0438\u0430, 2010. \u2013 752 \u0441. 33) \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438. \u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f. 2-\u0435 \u0438\u0437\u0434., \u0421.\u041b.\u041d\u0430\u0441\u043e\u043d\u043e\u0432\u0430, 2010\u0433 \u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f: \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e/ \u043f\u043e\u0434 \u0440\u0435\u0434. \u0415.\u041b. \u041d\u0430\u0441\u043e\u043d\u043e\u0432\u0430, \u0412.\u0410. \u041d\u0430\u0441\u043e\u043d\u043e\u0432\u043e\u0439. - \u041c.: \u0413\u042d\u041e\u0422\u0410\u0420-\u041c\u0435\u0434\u0438\u0430, 2010 \u0433. - 711 \u0441. 34) \u0411\u043e\u043b\u0438 \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430, \u0424\u0438\u043b\u043e\u043d\u0435\u043d\u043a\u043e \u0421.\u041f., \u042f\u043a\u0443\u0448\u0438\u043d \u0421.\u0421., 2010\u0433. 35) \u0414\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438: \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u0432\u0440\u0430\u0447\u0435\u0439/ \u043f\u043e\u0434 \u0440\u0435\u0434. \u043f\u0440\u043e\u0444. \u0412.\u0418. \u041c\u0430\u0437\u0443\u0440\u043e\u0432\u0430. \u2013 \u0421\u041f\u0431: \u0421\u043f\u0435\u0446\u041b\u0438\u0442, 2009\u0433. 192 \u0441. 36) \u041e\u0441\u0442\u0435\u043e\u0