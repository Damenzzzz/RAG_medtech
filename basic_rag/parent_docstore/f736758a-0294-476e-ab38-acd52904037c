\u0446\u0438\u044f \u0432\u0434\u044b\u0445\u0430\u0435\u043c\u043e\u0433\u043e \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430\n2\n\u0420\u0412 \u2013 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0440\u043e\u0432\u044c\n\u0420\u0421\u0422 \u2013 \u043f\u0440\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u0442\u043e\u043d\u0438\u043d\u043e\u0432\u044b\u0439 \u0442\u0435\u0441\u0442\nPD \u2013 \u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\n\u0440Es \u2013 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f\nPERDS - Peri-engraftment respiratory distress syndrome\nPTCy \u2013 \u043f\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043d\u0430\nPTLD - Posttransplant Lymphoproliferative Disease\nRIC\u2013 \u0440\u0435\u0436\u0438\u043c \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0439 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u0438;\nRSV \u2013 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e-\u0441\u0438\u043d\u0446\u0438\u0442\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0438\u0440\u0443\u0441\n\nTBI \u2013 totalbodyirradiation\nThio \u2013 \u0442\u0438\u043e\u0442\u0435\u043f\u0430\nTr \u2013 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b\nTreo \u2013 \u0442\u0440\u0435\u043e\u0441\u0443\u043b\u044c\u0444\u0430\u043d\n\nTx \u2013 \u0442\u0430\u043a\u0440\u043e\u043b\u0438\u043c\u0443\u0441\nS \u2013 Standardofcare\n\n5\n\nsO \u2013 \u0441\u0430\u0442\u0443\u0440\u0430\u0446\u0438\u044f\n2\nVRE \u2013 Vancomycin-Resistant Enterococci\n\n5. \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438/\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: 2015 \u0433\u043e\u0434.\n\n6. \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b.\n\n7. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0432\u0440\u0430\u0447\u0438 \u043e\u0431\u0449\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438,\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u043e\u043b\u043e\u0433\u0438, \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438, \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438.\n\n\u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 [1]\n\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u0435\u0433\u043b\u0438 \u0432\n\u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u0443 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439\n\u0410 \u0412\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0442\u0430-\u0430\u043d\u0430\u043b\u0438\u0437, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440\n\u0440\u0430\u043d\u0434\u043e\u043c\u0438\u0437\u0438\u0440\u043