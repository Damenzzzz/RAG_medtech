u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u044f (1,3). \u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442\n\u0438\u043b\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u044e\u0442 \u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044e \u0438\u0437-\u0437\u0430 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0439 \u0442\u043e\u0448\u043d\u043e\u0442\u044b \u0438 \u0440\u0432\u043e\u0442\u044b (1).\n\u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u0440\u0432\u043e\u0442\u0430, \u043a\u0430\u043a \u0442\u0430\u043a\u043e\u0432\u0430\u044f, \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0443\u0433\u0440\u043e\u0437\u0443 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443\n\n\u043d\u0435\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u0430\u044f \u0440\u0432\u043e\u0442\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044e, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044e \u0431\u0430\u043b\u0430\u043d\u0441\u0430 \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0442\u043e\u0432\n\u0438 \u043a \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u0438 (4,5).\n\u0424\u0430\u043a\u0442\u043e\u0440\u044b, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439:\n\u0412\u044b\u0441\u043e\u043a\u0430\u044f \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u0430\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432,\n\n\u041a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0420\u0435\u0436\u0438\u043c \u0438 \u0441\u043f\u043e\u0441\u043e\u0431 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0412\u044b\u0441\u043e\u043a\u0438\u0435 \u0434\u043e\u0437\u044b \u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 (6).\n\u041f\u043e\u0434 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0440\u0432\u043e\u0442\u044b \u0443 \u0431\u043e\u043b\u044c\u043d\u044b\u0445, \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0449\u0438\u0445\n\n\u0442\u043e\u0442 \u0438\u043b\u0438 \u0438\u043d\u043e\u0439 \u0446\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u043a \u0432 \u043c\u043e\u043d\u043e\u0440\u0435\u0436\u0438\u043c\u0435 \u0431\u0435\u0437 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,\n\u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0440\u0432\u043e\u0442\u0430 \u0431\u0443\u0434\u0435\u0442\n\u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u0443 90 % \u0431\u043e\u043b\u044c\u043d\u044b\u0445. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0443\u0440\u043e\u0432\u043d\u044f \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c MASCC / ESMO\n\n\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0432 \u0442\u0430\u0431\u043b. 1.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442\n\u0443\u0440\u043e\u0432\u043d\u044f \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c MASCC / ESMO.\n\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u044d\u043c\u0435\u0442\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u044b\u0435 \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u044b\u0435\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f per os\n\u0412\u044b\u0441\u043e\u043a\u04