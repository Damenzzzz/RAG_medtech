435 \u0433\u0430\u043f\u043b\u043e\u0438\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0439 \u0422\u041a\u041c. \u0411\u044b\u043b\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043e, \u0447\u0442\u043e \u0440\u0438\u0441\u043a \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f \u0443\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 < 5000 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 9% \u043f\u0440\u043e\u0442\u0438\u0432 54% \u0434\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 MAX MFI \u0414\u0421\u0410\n\u22655000.\n\n\u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u044e\u0442 \u043e \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u0438 \u0443\u0440\u043e\u0432\u043d\u0435 MFI\u22655000 \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0433\u043e \u043d\u0435\u043f\u0440\u0438\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f, \u043e\u0434\u043d\u0430\u043a\u043e \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u043e\u0439\u0442\u0438 \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c\n\u0443\u0440\u043e\u0432\u043d\u0435 MFI \u0434\u043e\u043d\u043e\u0440 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0445 \u0430\u043d\u0442\u0438\u0442\u0435\u043b.\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0414\u0421\u0410 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0434\u043e\u043d\u043e\u0440\u0430\n\n(\u0434\u043b\u044f \u0432\u044b\u0431\u043e\u0440\u0430 \u0434\u043e\u043d\u043e\u0440\u0430), \u0430 \u0442\u0430\u043a\u0436\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u0430 \u0434\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438.\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438 \u0434\u0435\u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f: \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439 \u0441\u0445\u0435\u043c\u044b \u043d\u0435\n\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.\n-\u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b: \u043f\u043b\u0430\u0437\u043c\u0430\u0444\u0435\u0440\u0435\u0437 1\u20134 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u043d\u0430 \u221210\u201317 \u0414\u043d\u0438, \u0438 \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435\n\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438.\n-\u0418\u043d\u0433\u0438\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0438\u0438 \u0430\u043d\u0442\u0438\u0442\u0435\u043b: \u0420\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431 375 \u043c\u0433/\u043c2 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n-\u041d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0430\u043d\u0442\u0438\u0442\u0435\u043b: \u0438\u043d\u0444\u0443\u0437\u0438\u044f 20\u201340 \u0435\u0434\u0438\u043d\u0438\u0446 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u043e\u0442\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f\n\u043e\u0431\u043c\u0435\u043d\u0430 \u0434\u043e\u043d\u043e\u0440\u0441\u043a\u0438\u043c\u0438 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u0430\u043c\u0438 \u0438\u043b\u0438 \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u043c \u0441\u043b\u043e\u0435\u043c \u0438\u0437 1 \u0435\u0434\u0438\u043d\u0438\u0446\u044b \u043a\u0440\u043e\u0432\u0438,\n\n\u0432 1-\u0439 \u0434\u0435\u043d\u044c.\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044e \u043d\u0435\u043f\u0440\u0438\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f/\u0433\u0438\u043f\u043e\u0444\u0443\u043d\u043a\u0446\u0438\u0438/\u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u044f:\n\u0412\u0430\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0438\u0445 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438:\n\n1. \u041e\u0442\u043c\u0435\u043d\u0430 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439, \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f\n\u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0438 (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u0431\u043e\u043b\u0435\u0435 \u0431\u044b\u0441\u0442\u0440\u0430\u044f \u043e\u0442\u043c\u0435\u043d\u0430 \u0418\u0421\u0422 \u043f\u0440\u0438 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u043c\n\u0445\u0438\u043c\u0435\u0440\u0438\u0437\u043c\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 RIC).\n2. \u0413-\u041a\u0421\u0424 \u0434\u043b\u044f \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043e\u0432 - 5 \u043c\u043a\u0433/\u043a\u0433/\u0441\u0443\u0442 \u044510 \u0434\u043d\u0435\u0439 \u0438\u043b\u0438 \u0434\u043e\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043e\u0432 \u22653 \u0445109/\u043b, +2 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0434\u043d\u044f.\n\n3. \u0410\u0433\u043e\u043d\u0438\u0441\u0442\u044b \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432 \u0442\u0440\u043e\u043c\u0431\u043e\u043f\u043e\u044d\u0442\u0438\u043d\u0430 (\u042d\u043b\u044c\u0442\u0440\u043e\u043c\u0431\u043e\u043f\u0430\u0433) - \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f\n\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2014 50 \u043c\u0433/\u0441\u0443\u0442\u043a\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e.\n\u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043e\u0442\u0432\u0435\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 2\u20134 \u043d\u0435\u0434\u0435\u043b\u0438 \u0434\u043e\u0437\u0443 \u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0434\u043e 75\u2013100\n\u043c\u0433/\u0441\u0443\u0442\u043a\u0438 (\u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u043e \u0430\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043d\u0435\u043c\u0438\u0438 \u0438\n\n\u043f\u043e\u0441\u0442\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f\u043c). \u0414\u0430\u043d\u043d\u044b\u0435 \u043e\u0431 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044e\n\u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432 \u0422\u041f\u041e \u044d\u043a\u0441\u0442\u0440\u0430\u043f\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u0438\u0437 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u043e \u0430\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0430\u043d\u0435\u043c\u0438\u0438 \u0438\n\n63\n\n\u043f\u043e\u0441\u0442\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\u043c. \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 Bento et al. (2019)\n\n\u043f\u043e\u043a\u0430\u0437\u0430\u043b\u043e, \u0447\u0442\u043e \u0443 60% \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043f\u043e\u0441\u0442\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0435\u0439\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b\u0441\u044f \u043e\u0442\u0432\u0435\u0442 \u043f\u0440\u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 8 \u043d\u0435\u0434\u0435\u043b\u044c.\n\u042d\u043b\u0442\u0440\u043e\u043c\u0431\u043e\u043f\u0430\u0433 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043d \u0434\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430 \u043a \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438,\n\u043d\u043e \u0447\u0435\u0442\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 [78].\n\n4. \u0418\u043d\u0444\u0443\u0437\u0438\u044f CD34+ \u043a\u043b\u0435\u0442\u043e\u043a (Boost \u0438\u043d\u0444\u0443\u0437\u0438\u044f). \u0427\u0435\u0442\u043a\u0438\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439 \u043a\u043e\u0433\u0434\u0430 \u0435\u0435\n\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u0435\u0442. \u041d\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0447\u0435\u0440\u0435\u0437 2\u20133 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0443\u0434\u0430\u0447\u043d\u043e\u0433\u043e\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u0435\u0440. \u0421 \u0438\u043b\u0438 \u0431\u0435\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0435\u0439: h\u0410\u0422G 20-30 \u043c\u0433/\u043a\u0433, 12-\u0447\u0430\u0441\u043e\u0432\u0430\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u044f, 1-2 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u043b\u0438\n\nr\u0410\u0422G 1,5-2,5\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 12-\u0447\u0430\u0441\u043e\u0432\u0430\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u044f, 1-2 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f [79].\n5. \u041c\u0435\u0437\u0435\u043d\u0445\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0435 \u043a\u043b\u0435\u0442\u043a\u0438 [80] - \u041c\u0421\u041a \u0432\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u0438\u043d\u0444\u0443\u0437\u0438\u044e \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0432 \u0434\u043e\u0437\u0435 1-2 \u043c\u043b\u043d \u043a\u043b\u0435\u0442\u043e\u043a/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0447\u0435\u0440\u0435\u0437\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0435\u043d\u043e\u0437\u043d\u044b\u0439 \u043a\u0430\u0442\u0435\u0442\u0435\u0440 \u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u0447\u0430\u0441\u0430 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u044f.\n\n\u041f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u044f \u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u043e\u043c \u0432 \u0434\u043e\u0437\u0435 1-2 \u043c\u0433/\u043a\u0433 \u0438 \u0430\u043d\u0442\u0438\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u043d\u044b\u043c\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u043c. \u0412\u0432\u043e\u0434\u044f\u0442 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u0438\u043b\u0438 \u043a\u0443\u0440\u0441\u043e\u043c \u0438\u0437 2\u20133 \u0438\u043d\u0444\u0443\u0437\u0438\u0439 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u0432\n\u043d\u0435\u0434\u0435\u043b\u044e. \u041c\u0421\u041a \u043c\u043e\u0433\u0443\u0442 \u0432\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043a\u0430\u043a \u043e\u0442 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0433\u043e \u0434\u043e\u043d\u043e\u0440\u0430, \u0442\u0430\u043a \u0438 \u043e\u0442\n\u0441\u0430\u043c\u043e\u0433\u043e \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 (\u0435\u0441\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b).\n\u0412 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u0445 \u041c\u0421\u041a \u0432\u0432\u043e\u0434\u044f\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u0434\u043d\u044f +28, \u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\n\n\u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438. \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u041c\u0421\u041a: \u0418\u043c\u043c\u0443\u043d\u043e\u043c\u043e\u0434\u0443\u043b\u044f\u0446\u0438\u044f\n(\u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \"\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u0445\u043e\u0437\u044f\u0438\u043d\u0430\" \u2014 \u0420\u0422\u041f\u0425). \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430\n\u043c\u0438\u043a\u0440\u043e\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0441\u0435\u043a\u0440\u0435\u0446\u0438\u0438 \u0446\u0438\u0442\u043e\u043a\u0438\u043d\u043e\u0432. \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0440\u0438\u0441\u043a\u0430\n\u0444\u0438\u0431\u0440\u043e\u0437\u0430 \u0438 \u0430\u043f\u043e\u043f\u0442\u043e\u0437\u0430 \u0432 \u043d\u0438\u0448\u0435 \u0433\u0435\u043c\u043e\u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a.\n\n\u041f\u0435\u0440\u0435\u0434 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u041c\u0421\u041a \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u0440\u0435\u0446\u0438\u0434\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442\u0430.\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435 30 \u0434\u043d\u0435\u0439 \u0441 \u0434\u043d\u044f \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u043a\u043b\u0435\u0442\u043e\u043a (\u04140) \u043f\u043e \u0443\u0440\u043e\u0432\u043d\u044e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u043b\u0430 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u043e\u0432 \u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439\n\n\u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0438 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u0439 (\u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0439 \u0432\u0437\u0432\u0435\u0441\u0438, \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0442\u0430\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432): \u04140 (\u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c), +30, +60, +90, +120, +150 \u0438 \u0434\u0435\u043d\u044c +180.\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0438 90 \u0434\u043d\u0435\u0439. \u041e\u0442\u0432\u0435\u0442 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c:", "type": "Document"}}