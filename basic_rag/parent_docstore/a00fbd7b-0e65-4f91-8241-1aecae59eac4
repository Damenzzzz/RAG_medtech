32\u043d\u043e\u0439\n\n\u043f\u043e\u043c\u043e\u0449\u0438: \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u0430\u044f \u0438 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440 \u0437\u0430\u043c\u0435\u0449\u0430\u044e\u0449\u0430\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c.\n\u0426\u0435\u043b\u044c \u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043f\u0430\u043b\u043b\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438 \u2013 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043d\u0438.\n\n3. \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043f\u0430\u043b\u043b\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438:\n\u041f\u041f \u0434\u0435\u0442\u044f\u043c \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u00ab\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\u00bb, \u00ab\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u044b\u0448\u043a\u0443\u00bb, \u00ab\u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\n\u0432 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0430\u0434\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u00bb, \u00ab\u041f\u041f \u0432 \u043a\u0440\u0438\u0437\u0438\u0441\u043d\u044b\u0445 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u0445\u00bb, \u00ab24 \u0447\u0430\u0441\u043e\u0432\u0430\u044f\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 7 \u0434\u043d\u0435\u0439 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e\u00bb, \u00ab\u043f\u0441\u0438\u0445\u043e\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u043c\u043