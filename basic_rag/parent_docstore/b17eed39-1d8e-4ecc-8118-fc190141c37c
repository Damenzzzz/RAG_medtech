30 \u043f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0430 \u043f\u0440\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c \u0431\u043e\u043b\u0435\u0432\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0430 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0430\u0441\u0442\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u0440\u0430\u0431\u043e\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438.\n\n2.2. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c (\u0441\u0445\u0435\u043c\u0430):\n\n\u0410\u043d\u0430\u043c\u043d\u0435\u0437 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0435\n\u0423\u0417\u0418\n\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\n\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u043c\u0430\u043b\u043e\u0433\u043e \u0442\u0430\u0437\u0430\n\u0443\u0437\u043a\u0438\u0445\n\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432\n2.3. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430: \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u043e\u0439 \u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439 \u0434\u0438\u0441\u043c\u0435\u043d\u043e\u0440\u0435\u0438\n\n\u0412\u043b\u0430\u0433\u0430\u043b\u0438\u0449\u043d\u043e\u0435\n\u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u044f \u041a\u043b\u0438\u043d\u0438\u043a\u0430 \u0423\u0417\u0418 \u041c\u0420\u0422\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u041f\u0440\u0438 \u0432\u0430\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0438\u043b\u0438\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438. \u0418\u043d\u043e\u0433\u0434\u0430 \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u043c\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f\n\u0432\u0437\u0434\u0443\u0442\u0438\u0435 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u0412 \u043d\u043e\u0440\u043c\u0435 \u041d\u043e\u0440\u043c\u0430\n\u0434\u0438\u0441\u043c\u0435\u043d\u043e\u0440\u0435\u044f\n\u043e\u0442\u0435\u043a\u0438, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043d\u0435\n\u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0438 \u0442.\u043f. \u043f\u0435\u0440\u0435\u0434 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u044f\u043c\u0438\n\u0420\u0435\u0442\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043c\u0430\u0442\u043a\u0438,\n\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0435\u0435\n\u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u0438,\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438, \u0431\u043e\u043b\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\n\u0423\u0417\u0418 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u042d\u043d\u0434\u043e\u043c\u0435\u0442\u0440\u0438\u043e\u0437 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0437\u0430 \u0448\u0435\u0439\u043a\u0443 \u042d\u043d\u0434\u043e\u043c\u0435\u0442\u0440\u0438\u043e\u0437\n\u044d\u043d\u0434\u043e\u043c\u0435\u0442\u0440\u0438\u043e\u0437\u0430\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u043e\u0442 \u043c\u0430\u0442\u043a\u0438, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u043c\u0435\u043d\u0430\u0440\u0445\u0435 \u043c\u0430\u0442\u043a\u0438 \u043f\u0435\u0440\u0435\u0434\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u044f\u043c\u0438,\n\u0430\u0441\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f \u043c\u0430\u0442\u043a\u0438\n\u0421\u0445\u0432\u0430\u0442\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u0431\u043e\u043b\u0438\n\u043c\u0430\u0442\u043a\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430,\n\u0432\u043d\u0438\u0437\u0443 \u0436\u0438\u0432\u043e\u0442\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u0431\u0443\u0433\u0440\u0438\u0441\u0442\u0430\u044f, \u043b\u0438\u0431\u043e\n\u041c\u0438\u043e\u043c\u0430 \u043c\u0430\u0442\u043a\u0438 \u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438, \u041c\u0438\u043e\u043c\u0430 \u043c\u0430\u0442\u043a\u0438 \u041c\u0438\u043e\u043c\u0430 \u043c\u0430\u0442\u043a\u0438\n\u043f\u0430\u043b\u044c\u043f\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0443\u0437\u043b\u044b\n\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432\u043d\u0438\u0437\u0443\n\u043c\u0438\u043e\u043c\u0430 \u043c\u0430\u0442\u043a\u0438\n\u0436\u0438\u0432\u043e\u0442\u0430\n\u0412 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u0434\u0430\u0442\u043a\u043e\u0432\n\u043c\u0430\u0442\u043a\u0438 \u043f\u0430\u043b\u044c\u043f\u0438\u0440\u0443\u0435\u0442\u0441\u044f\n\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u0437\n\u0413\u0438\u0434\u0440\u043e\u0441\u0430\u043b\u044c\u043f\u0438\u043d\u043a\u0441\n\u0432\u043d\u0438\u0437\u0443 \u0436\u0438\u0432\u043e\u0442\u0430; \u0432 \u0447\u0435\u0442\u043a\u0438\u0445 \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 (\u0433\u0438\u0434\u0440\u043e\u0441\u0430\u043b\u044c\u043f\u0438\u043d\u043a\u0441), \u0413\u0438\u0434\u0440\u043e\u0441\u0430\u043b\u044c\u043f\u0438\u043d\u043a\u0441\n\u0441\u0430\u043b\u044c\u043f\u0438\u043d\u0433\u043e\u043e\u0444\u043e\u0440\u0438\u0442 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f\n\u043e\u0441\u0442\u0440\u043e\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u00ab\u0442\u044f\u0436\u0435\u0441\u0442\u044c\u00bb \u0438\n\u043f\u0440\u0438\u0434\u0430\u0442\u043a\u043e\u0432 \u043c\u0430\u0442\u043a\u0438\n\u043f\u0440\u0438\u0434\u0430\u0442\u043a\u043e\u0432 \u043c\u0430\u0442\u043a\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u0440\u0438\u0434\u0430\u0442\u043a\u043e\u0432\n\u043c\u0430\u0442\u043a\u0438\n\u041f\u043e\u0440\u043e\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\u043c\u0430\u0442\u043a\u0438\n\u041d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u0430\u044f \u043c\u0430\u0442\u043a\u0430,\n\u041f\u043e\u0440\u043e\u043a\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 (\u0441\u0435\u0434\u043b\u043e\u0432\u0438\u0434\u043d\u0430\u044f, \u041f\u043e\u0440\u043e\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\u0441\u0435\u0434\u043b\u043e\u0432\u0438\u0434\u043d\u0430\u044f \u043c\u0430\u0442\u043a\u0430,\n\u043c\u0430\u0442\u043a\u0438 \u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438 \u0434\u0432\u0443\u0440\u043e\u0433\u0430\u044f \u043c\u0430\u0442\u043a\u0430, \u043c\u0430\u0442\u043a\u0438\n\u0434\u0432\u0435 \u043c\u0430\u0442\u043a\u0438\n\u0440\u0443\u0434\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u043d\u044b\u0439\n\u0440\u043e\u0433)\n\u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u0438\n\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0435 \u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438, \u0412\u041c\u0421 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0412\u041c\u0421 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\u0412\u041c\u0421 \u0423\u0441\u0438\u043a\u0438 \u0412\u041c\u0421\n\u0432 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u043a\u0438 \u043c\u0430\u0442\u043a\u0438\n\u0412\u041c\u0421\n\u0411\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438,\n\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432\u043d\u0438\u0437\u0443\n\u0436\u0438\u0432\u043e\u0442\u0430, \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0442\u0435\u0440\u044f\u0435\u043c\u043e\u0439 \u0432\n\u0412\u043d\u0443\u0442\u0440\u0438\u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0432\u0440\u0435\u043c\u044f \u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0438 \u0421\u0438\u043d\u0435\u0445\u0438\u0438 \u0432 \u0421\u0438\u043d\u0435\u0445\u0438\u0438 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\u0411\u0435\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u0441\u0438\u043d\u0435\u0445\u0438\u0438 \u043a\u0440\u043e\u0432\u0438 \u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043c\u0430\u0442\u043a\u0438 \u043c\u0430\u0442\u043a\u0438\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043c\u0435\u043d\u0441\u0442\u0440\u0443\u0430\u0446\u0438\u0439; \u0432\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0430\u0431\u043e\u0440\u0442\u044b, \u0440\u043e\u0434\u044b,\n\u0432\u043d\u0443\u0442\u0440\u0438\u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435\n\u043c\u0430\u043d\u0438\u043f\u0443\u043b\u044f\u0446\u0438\u0438\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\