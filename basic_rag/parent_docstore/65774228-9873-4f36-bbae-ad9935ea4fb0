e \u0442\u0435\u0445 \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u0430\n\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f [27].\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u041f\u042d\u041f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u043f\u043e\u0441\u043b\u0435 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0410\u042d, \u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u042d\u042d\u0413, \u041c\u0420\u0422 [27].\n\u0410\u043d\u0442\u0438\u043f\u0438\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\uf0fc \u043f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b 10 \u2013 15 \u043c\u0433/\u043a\u0433 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 4 \u0447\u0430\u0441\u043e\u0432;\n\n\uf0fc \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d 10 \u043c\u0433/\u043a\u0433 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3-\u0445 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438);\n\u0410\u043d\u0442\u0438\u044d\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n\uf0fc \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b;\n\n\u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u044f\u043c\u0438\n\u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0430.\n\nNB!\n\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u043c\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u043e\u0432 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\nNMDAR \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442\u043e\u043c \u043c\u043e\u0436\u0435\u0442 \u0443\u0445\u0443\u0434\u0448\u0438\u0442\u044c \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u044e \u0438\u043b\u0438 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a\n\u0437\u043b\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0443!\n\u041f\u0440\u0438 \u0434\u0438\u0437\u0430\u0432\u0442\u043e\u043d\u043e\u043c\u0438\u0438 \u0441 \u0431\u0440\u0430\u0434\u0438\u043a\u0430\u0440\u0434\u0438\u0435\u0439 \u0438 \u0431\u043b\u043e\u043a\u0430\u0434\u043e\u0439 \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430\n\u043d\u0435\u0439\u0440\u043e\u043b\u0435\u043f\u0442\u0438\u043a\u043e\u0432, \u0443\u0434\u043b\u0438\u043d\u044f\u044e\u0449\u0438\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b QT [21,27].\n\n\u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f.\n\u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u043a\u0438\u043d\u0435\u0437\u0438\u0439 \u0438 \u0441\u0442\u0435\u0440\u0435\u043e\u0442\u0438\u043f\u0438\u0439\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044f:\n\uf0fc \u0431\u0435\u043d\u0437\u043e\u0434\u0438\u0430\u0437\u0435\u043f\u0438\u043d\u044b;\n\n\uf0fc \u041f\u042d\u041f (\u0432\u0430\u043b\u044c\u043f\u0440\u043e\u0435\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430, \u043a\u0430\u0440\u0431\u0430\u043c\u0430\u0437\u0435\u043f\u0438\u043d);\n\u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438:\n\uf0fc \u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b;\n\uf0fc \u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u044b.\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438:\n\uf0fc \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432;\n\uf0fc \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438;\n\n\uf0fc \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0434\u044b\u0445\u0430\u043d\u0438\u044f;\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\n\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0442\u0438\n\u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0432\u044b\u0431\u043e\u0440\u0430\n\n\u041f\u0435\u0440\u0432\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0413\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e \u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u0410 [1,8,21]\n\n\u0438\u0434\u044b \u043d \u043b\u0438\u043d\u0438\u0438:\n\uf0fc \u0432/\u0432 30 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\n(max 1 \u0433/\u0441\u0443\u0442), \u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c\n1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c,\n\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 3 \u2013\n5 \u0434\u043d\u0435\u0439\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I\n\u043b\u0438\u043d\u0438\u0438:\n\u0432/\u0432, 30 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 (max 1\n\u0433/\u0441\u0443\u0442), \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u043a\u0443\u0440\u0441\n1 \u2013 3 \u0434\u043d\u0435\u0439;\n\n\u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u0410 [1,8,21]\n\u043b\u0438\u043d\u0438\u0438:\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\n\n(max 60 \u043c\u0433/\u0441\u0443\u0442),\n\u043a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430 1 \u0440\u0430\u0437\u0430\n\u0432 \u0434\u0435\u043d\u044c, \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u044f 1\n\u043d\u0435\u0434\u0435\u043b\u044f, \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c\n\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0410 [1,8,21]\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I\n\u043b\u0438\u043d\u0438\u0438:\n\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\n(max 60 \u043c\u0433/\u0441\u0443\u0442),\n\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e \u043a\u0443\u0440\u0441 1\n\u043d\u0435\u0434\u0435\u043b\u044f \u0441 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u044b\u043c\n\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0434\u043e\u0437\u044b\n\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u0410 [1,8,21]\n\u043b\u0438\u043d\u0438\u0438:\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 20\n\n\u043c\u0433/\u043c2/\u0441\u0443\u0442 \u0432 2 \u2013 3\n\u043f\u0440\u0438\u0435\u043c\u0430 (max \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 36 \u043c\u0433),\n\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 3\n\u0434\u043d\u044f\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I\n\n\u043b\u0438\u043d\u0438\u0438:\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 20\n\u043c\u0433/\u043c2/\u0441\u0443\u0442 \u0432 2-3 \u043f\u0440\u0438\u0435\u043c\u0430\n(max \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 36\n\n\u043c\u0433), \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430 3 \u0434\u043d\u044f, \u043f\u043e\u0432\u0442\u043e\u0440\n\u043a\u0443\u0440\u0441\u043e\u0432 \u043a\u0430\u0436\u0434\u044b\u0435 3-4\n\u043d\u0435\u0434\u0435\u043b\u0438\n\n\u0418\u043c\u043c\u0443\u043d\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a \u0412\u0412\u0418\u0413 \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I \u0410 [1,8,21]\n\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0418\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438 \u043b\u0438\u043d\u0438\u0438:\n\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0432/\u0432, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 0,4 \u2013 1\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u043b\u044f \u0433/\u043a\u0433/\u0441\u0443\u0442, \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e,\n\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0443\u0440\u0441\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 2 \u0433/\u043a\u0433,\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430 2 \u2013\n5 \u0434\u043d\u0435\u0439\n\n\u041f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u0438\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f I\n\u043b\u0438\u043d\u0438\u0438:\n\u0432/\u0432, 1 \u0440\u0430\u0437/\u0434\u0435\u043d\u044c,\n\n\u043a\u0443\u0440\u0441\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 1 \u2013 2\n\u0433/\u043a\u0433, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u043a\u0443\u0440\u0441\u0430 1 \u2013 2 \u0434\u043d\u044f, \u043f\u043e\u0432\u0442\u043e\u0440\n\u043a\u0443\u0440\u0441\u0430 \u2013 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\n\n\u0412\u0442\u043e\u0440\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0410\u043d\u0442\u0438\u043d\u0435\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441 \u0420\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431 \u0418\u043c\u043c\u0443\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f II \u0410 [1,8,21]\n\u043a\u0438\u0435 \u0438 \u043b\u0438\u043d\u0438\u0438:\n\n\u0438\u043c\u043c\u0443\u043d\u043e\u043c\u043e\u0434\u0443\u043b\u0438\u0440\u0443 \u2022 \u0432/\u0432, 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c,\n\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b. 