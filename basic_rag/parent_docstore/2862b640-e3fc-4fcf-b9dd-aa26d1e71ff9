{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_e2c56774aa6f", "title": "\u0413\u0415\u041d\u0418\u0422\u0410\u041b\u042c\u041d\u042b\u0419 \u0413\u0415\u0420\u041f\u0415\u0421", "source_file": "2025_\u0413\u0415\u041d\u0418\u0422\u0410\u041b\u042c\u041d\u042b\u0418_\u0413\u0415\u0420\u041f\u0415\u0421_e2321beeb2.pdf", "icd_codes": "A60.0, N77.0, N77.1, A60.1, A60.9", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0413\u0415\u041d\u0418\u0422\u0410\u041b\u042c\u041d\u042b\u0419 \u0413\u0415\u0420\u041f\u0415\u0421.pdf"}, "page_content": "\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432 \u044f\u0440\u043a\u043e\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430.\n\u041f\u0430\u0445\u043e\u0432\u0430\u044f \u041d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430- \u043c\u0438\u043a\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0442\u0435\u043b\u044c\u0446\u0430 \u0414\u043e\u043d\u043e\u0432\u0430\u043d\u0430\n\u0433\u0440\u0430\u043d\u0443- \u043d\u0438\u044f \u0443\u0437\u0435\u043b\u043a\u0430, \u043f\u0443\u0441\u0442\u0443\u043b\u044b, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0431- (Calimmatobacterium\n\n\u043b\u0435\u043c\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 granulomatis) \u043d\u0435 \u043e\u0431-\n\u0431\u044b\u0441\u0442\u0440\u043e \u0438\u0437\u044a\u044f\u0437\u0432\u043b\u044f\u044e\u0442\u0441\u044f, \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f-\u0442\u0435\u043b\u044c\u0446\u0430 \u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438\n\u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044f \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0414\u043e\u043d\u043e\u0432\u0430\u043d\u0430 \u043c\u0438\u043a\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435-\n\u0430\u0444\u0444\u0435\u043a\u0442-\u044f\u0437\u0432\u0443. \u041f\u043e \u043f\u0435\u0440\u0438- (Calimmatobacterium \u0441\u043a\u043e\u043c\n\n\u0444\u0435\u0440\u0438\u0438 \u0447\u0430\u0441\u0442\u043e granulomatis) \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0442 \u0434\u043e\u0447\u0435\u0440\u043d\u0438\u0435 \u044f\u0437-\n\u0432\u044b-\u0441\u0430\u0442\u0435\u043b\u043b\u0438\u0442\u044b. \u0425\u0430\u0440\u0430\u043a\u0442\u0435-\n\u0440\u0435\u043d \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0441\u043f\u0430\u0434\n\n\u0442\u043a\u0430\u043d\u0435\u0439, \u043a\u0440\u0430\u044f \u044f\u0437\u0432 \u043e\u0442\u0435\u0447-\n\u043d\u044b, \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u044b,\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u043f\u043e\u0434\u043d\u044f\u0442\u044b.\n\u0427\u0435\u0441\u043e\u0442\u043a\u0430 \u041c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u0442\u044c \u0441 \u044d\u0440\u043e- \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u041d\u0435\u0442 \u0447\u0435\u0441\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0437\u0443-\n\n\u0437\u0438\u0432\u043d\u044b\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0434\u043d\u044f \u043f\u0440\u0438 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e-\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432, \u043f\u0438\u0438\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u043c\u0438 \u0432\u0441\u043b\u0435\u0434-\n\u0441\u0442\u0432\u0438\u0435 \u0440\u0430\u0441\u0447\u0435\u0441\u043e\u0432 \u0438 \u043c\u0430\u0446\u0435-\n\u0440\u0430\u0446\u0438\u0438 \u043a\u043e\u0436\u0438 \u0441\u0435\u0440\u043e\u0437\u043d\u044b\u043c\n\n\u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u044b\u043c. \u041d\u0430\u043b\u0438\u0447\u0438\u0435\n\u0437\u0443\u0434\u044f\u0449\u0438\u0445 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0439 \u0432\n\u043c\u0435\u0436\u043f\u0430\u043b\u044c\u0446\u0435\u0432\u044b\u0445 \u043f\u0440\u043e\u043c\u0435-\n\u0436\u0443\u0442\u043a\u0430\u0445, \u043d\u0430 \u0437\u0430\u043f\u044f\u0441\u0442\u044c\u0435, \u0432\n\n\u043b\u043e\u043a\u0442\u0435\u0432\u044b\u0445 \u044f\u043c\u043a\u0430\u0445 \u0438 \u0432\n\u0434\u0440\u0443\u0433\u0438\u0445, \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u0434\u043b\u044f\n\u0447\u0435\u0441\u043e\u0442\u043a\u0438 \u043c\u0435\u0441\u0442\u0430\u0445.\n\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0421\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u044f\u0432- \u041d\u0435\u0442 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438-\n\n\u0411\u0435\u0445\u0447\u0435\u0442\u0430 \u043b\u0435\u043d\u0438\u0435\u043c \u0430\u0444\u0442\u043e\u0437\u043d\u044b\u0445 \u0431\u043e- \u0432\u0430\u044e\u0442 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438\n\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0445 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0439 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438-\n\u043d\u0430 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432. \u0437\u043d\u0430\u043a\u043e\u0432\n\u0412\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u044f \u0438\u043c\u0435\u044e\u0442\u0441\u044f\n\n\u0442\u0430\u043a\u0436\u0435 \u0432 \u0440\u043e\u0442\u043e\u0432\u043e\u0439 \u043f\u043e-\n\u043b\u043e\u0441\u0442\u0438-\u0430\u0444\u0442\u043e\u0437\u043d\u044b\u0439\n\u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u044b\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437.\n\n\u0424\u0438\u043a\u0441\u0438- \u0412\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0432 \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u043d\u0435\u0442 \u0422\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u0431\u0440\u0430\u043d-\n\u0440\u043e\u0432\u0430\u043d- \u043f\u0440\u0438\u0435\u043c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043c\u0435\u0434\u0438- \u043d\u044b\u0439 \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u043f\u043e\u043c\u043e-\n\u043d\u0430\u044f \u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0432 \u0441\u0443\u043b\u044c\u0444\u0430\u043d\u0438\u043b\u0430- \u0433\u0430\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\n\u044d\u0440\u0438\u0442\u0435\u043c\u0430 \u043c\u0438\u0434\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432, \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\n\u0441\u043d\u043e\u0442\u0432\u043e\u0440\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438\n\n\u0434\u0440. \u041c\u043e\u0436\u0435\u0442 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436-\n\u0434\u0430\u0442\u044c\u0441\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u044d\u0440\u043e\u0437\u0438\u0432\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432,\n\u043a\u0430\u043a \u043d\u0430 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430-\n\n\u043d\u0430\u0445, \u0442\u0430\u043a \u0438 \u0432 \u0440\u043e\u0442\u043e\u0432\u043e\u0439 \u043f\u043e-\n\u043b\u043e\u0441\u0442\u0438, \u0438 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445\n\u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u043a\u043e\u0436\u0438. \u0425\u0430\u0440\u0430\u043a-\n\u0442\u0435\u0440\u0435\u043d \u0441\u0438\u043c\u043f\u0442\u043e\u043c \u00ab\u0431\u044b\u0447\u044c\u0435-\n\n\u0433\u043e \u0433\u043b\u0430\u0437\u0430\u00bb-\u044d\u0440\u043e\u0437\u0438\u044f \u043e\u0431\u0440\u0430-\n\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\u0447\u0430\u0441\u0442\u0438 \u043f\u044f\u0442\u043d\u0430, \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432-\n\u043d\u043e\u0441\u0442\u044c \u043e\u043a\u0440\u0430\u0441\u043a\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e\n\n\u0443\u0431\u044b\u0432\u0430\u0435\u0442 \u043e\u0442 \u0446\u0435\u043d\u0442\u0440\u0430 \u043a \u043f\u0435-\n\u0440\u0438\u0444\u0435\u0440\u0438\u0438.\n\u042d\u0440\u0438\u0442\u0440\u043e- \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u043e\u0431\u0440\u0430- \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441- \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u043f\u043b\u0430\u0437\u0438\u044f \u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0440\u043e\u0437\u043e\u0432\u0430\u0442\u043e- \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u043a\u043b\u0438\u043d\u0438\u0447\u0435-\n\n\u041a\u0435\u0439\u0440\u0430 \u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u0431\u0430\u0440\u0445\u0430\u0442\u0438\u0441\u0442\u043e\u0439 \u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430\n\u0431\u043b\u044f\u0448\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u043d\u043e\u0433\u0434\u0430\n\u0438\u0437\u044a\u044f\u0437\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441 \u043f\u043e\u044f\u0432\u043b\u0435-\n\u043d\u0438\u0435\u043c \u0441\u0435\u0440\u043e\u0437\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u044f-\n\u0435\u043c\u043e\u0433\u043e.\n\n\u0412\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 50 \u043b\u0435\u0442.\n\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0422\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043b\u0435\u0438\u0442 \u043d\u0435\u0442 \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u041a\u0440\u043e\u043d\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u0442\u044c \u0441 \u043e\u0431- \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442\n\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u044f\u0437\u0432, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438-\n\n\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u043a\u0430\u043a \u043d\u0430 \u043d\u0430\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u0430\u0445, \u0442\u0430\u043a \u0438\n\u0432 \u043f\u0435\u0440\u0438\u0430\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u0430\u0431\u0434\u043e\u043c\u0438-\n\n\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u043b\u0438, \u0440\u0443\u0431\u0446\u044b\n\u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0440\u0430\u043d\u0435\u0435\n\u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u043e\u0439 \u0430\u043f\u043f\u0435\u043d\u0434-\n\u044d\u043a\u0442\u043e\u043c\u0438\u0438, \u0430\u0441\u0442\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\n\u0442\u0435\u043b\u043e\u0441\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u043d\u044b\u0445\n\u041a\u043e\u043d- \u041f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0442 \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u0442\u0430\u043a\u0442\u043d\u044b\u0439 \u0430\u043f\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u043d\u0430 \u043f\u043e\u043b\u043e\u0432\u044b\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442\n\u0434\u0435\u0440\u043c\u0430- \u043e\u0440\u0433\u0430\u043d\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u0431\u0440\u0430\u043d-\n\n\u0442\u0438\u0442, \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u043e\u0432, \u043c\u0430\u0437\u0435\u0439 \u0438 \u043d\u044b\u0439 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\n\u0442\u0440\u0430\u0432\u043c\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432. \u0412\u0441\u0442\u0440\u0435-\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u0447\u0430\u044e\u0442\u0441\u044f \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u043d\u0430 \u043b\u0430\u0442\u0435\u043a\u0441 \u0438\n\n\u0441\u043c\u0430\u0437\u043a\u0443 \u043f\u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043e\u0432.\n\u041c\u043e\u0433\u0443\u0442 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0442\u044c\u0441\u044f\n\u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u044d\u0440\u043e\u0437\u0438\u0439 \u043d\u0430\n\u043f\u043e\u043b\u043e\u0432\u043e\u043c \u0447\u043b\u0435\u043d\u0435\n\n\u041f\u0443\u0437\u044b\u0440- \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0443\u0437\u044b\u0440\u043d\u044b\u0445, \u0446\u0438\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\n\u043d\u044b\u0435 \u0430 \u0437\u0430\u0442\u0435\u043c \u044d\u0440\u043e\u0437\u0438\u0432\u043d\u043e- \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435, \u043f\u0440\u044f\u043c\u0430\u044f \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442\n\u0434\u0435\u0440\u043c\u0430- \u044f\u0437\u0432\u0435\u043d\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432, \u0432 \u0438\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e\u0440\u0435\u0441\u0446\u0435\u043d- \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438-\n\u0442\u043e\u0437\u044b \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043d\u0430 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u0446\u0438\u044f \u043d\u0430 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0446\u0438-\n\u043e\u0440\u0433\u0430\u043d\u0430\u0445. \u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\n\u0418\u043c\u0435\u044e\u0442\u0441\u044f \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u044f-\n\u0442\u0430\u043a\u0436\u0435 \u0438 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043c\u043e\u0439\n\u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u043a\u043e\u0436\u0438 - \u0432 \u0438\u043c\u043c\u0443\u043d\u043e\u0444\u043b\u044e\u043e-\n\u0440\u043e\u0442\u043e\u0432\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438. \u0440\u0435\u0441\u0446\u0435\u043d-\u0446\u0438\u0438\n\n\u0421\u0442\u0440\u0435\u043f- \u0413\u043d\u043e\u0439\u043d\u0438\u0447\u043a\u043e\u0432\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435- \u0432 \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u043c \u044d\u0440\u043e\u0437\u0438\u0439 -\n\u0442\u043e\u043a\u043e\u043a- \u0432\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u0438 \u044f\u0437\u0432 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u044e\u0442\n\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u0442\u044c \u0441 \u0441\u0442\u0440\u0435\u043f\u0442\u043e\u043a\u043e\u043a\u043a\u0438 \u0438 \u0441\u0442\u0430-\n\u043e\u0435 \u0438\u043c\u043f\u0435- \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u044d\u0440\u043e\u0437\u0438\u0432\u043d\u043e- \u0444\u0438\u043b\u043e\u043a\u043e\u043a\u043a\u0438\n\n\u0442\u0438\u0433\u043e, \u044f\u0437\u0432\u0435\u043d\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432\n\u0448\u0430\u043d\u043a\u0440\u0438-\n\u043a\u0440\u0438-\n\u0444\u043e\u0440\u043c\u043d\u0430\n\n\u044f \u043f\u0438-\n\u043e\u0434\u0435\u0440\u043c\u0438\u044f\n\u0411\u0430\u043b\u0430\u043d\u043e- \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d- \u043d\u0435\u0442 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u0435\u0442\n\u043f\u043e\u0441\u0442\u0438\u0442 \u043d\u044b\u0445 \u044d\u0440\u043e\u0437\u0438\u0439 \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043a\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u0441\u043e\u043e\u0442\u0432\u0435\u0442-\n\n\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u043c \u043b\u0438\u0441\u0442\u043a\u0435 \u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043a\u043b\u0438\u043d\u0438\u0447\u0435-\n\u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043f\u043b\u043e\u0442\u0438. \u0427\u0430\u0441\u0442\u043e \u0441\u043a\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0438\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u0440\u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430\n\u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u043c \u0442\u0435\u0447\u0435-\n\u043d\u0438\u0438 \u0443\u0440\u0435\u0442\u0440\u0438\u0442\u0430, \u0432\u0441\u043b\u0435\u0434-\n\n\u0441\u0442\u0432\u0438\u0435 \u043c\u0430\u0446\u0435\u0440\u0430\u0446\u0438\u0439\n\u0443\u0440\u0435\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u043e\u0442\u0434\u0435\u043b\u044f\u0435-\n\u043c\u044b\u043c.\n\u041d\u0435\u0440\u0435\u0434\u043a\u043e \u0432\u044b\u044f\u0432\u043b\u044f\u044e\u0442\n\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u0433\u043b\u044e\u043a\u043e-\n\u0437\u044b.\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1-12].\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c 2;\n\n\u2022 \u0421\u0442\u043e\u043b No15 (\u043e\u0431\u0449\u0438\u0439).\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435.\n\u0426\u0435\u043b\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0413\u0413;\n\n\u2022 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u043e\u0432 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043d\u0438\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432;\n\u2022 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u04