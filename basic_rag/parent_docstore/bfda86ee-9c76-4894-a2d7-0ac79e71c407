c\u0442\u0435\u0440\u043d\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u043a\u0443\u0440\u0441\n(0,5 \u043c\u0433/\u043a\u0433 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u043d\u044c) \u0438 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u0430\u044f \u043e\u0442\u043c\u0435\u043d\u0430 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 (\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043c\u0435\u043d\u044b \u2013\n\n\u043c\u0438\u043d\u0438\u043c\u0443\u043c 6 \u043d\u0435\u0434\u0435\u043b\u044c). \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0420\u0422\u041f\u0425 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430 \u043a \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0434\u043e\u0437\u0430\u043c \u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043e\u0432!\n\n2) \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0430\u0446\u0438\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0443\u043b\u0443\u0448\u0435\u043d\u0438\u044f \u0447\u0435\u0440\u0435\u0437 1 \u043c\u0435\u0441\u044f\u0446 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u0437\u0443\n\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u0430 \u043c\u0435\u043d\u0435\u0435 1\u043c\u0433/\u043a\u0433 \u0447\u0435\u0440\u