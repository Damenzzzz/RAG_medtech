u0440\u0438\u0435\u043c \u041d\u041f\u0412\u041f.\n\n5\n\n8.4 \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f HELLP-\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430: \u043e\u0431\u0449\u0435\u043f\u0440\u0438\u043d\u044f\u0442\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 HELLP-\n\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.\n\u0424\u0430\u043a\u0442\u043e\u0440\u0430\u043c\u0438 \u0440\u0438\u0441\u043a\u0430 HELLP-\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f:\n\u2022 \u043f\u0435\u0440\u0432\u043e\u0440\u043e\u0434\u044f\u0449\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0438 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430;\n\n\u2022 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0440\u0435\u044d\u043a\u043b\u0430\u043c\u043f\u0441\u0438\u0438;\n\u2022 \u043c\u043d\u043e\u0433\u043e\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c;\n\u2022 \u043c\u043d\u043e\u0433\u043e\u0432\u043e\u0434\u0438\u0435;\n\u2022 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0439 \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u043f\u0440\u0435\u044d\u043a\u043b\u0430\u043c\u043f\u0441\u0438\u0438, \u0441\u0430\u0445\u0430\u0440\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0431\u0435\u0442\u0430, \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u0438.\n\n9. \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0410 \u0418 \u041b\u0415\u0427\u0415\u041d\u0418\u0415 \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\u041f\u0440\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0440\u044f\u0434 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 (\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1), \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u0432\u0432\u0438\u0434\u0443 \u043f\u0440\u0438 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u0438\n\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1. \u0410\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435, \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438:\n\n\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0411\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\n\u2022 \u041e\u0426\u041a, \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0439 \u2022 \u0421\u043e\u043a\u0440\u0430\u0442\u0438\u043c\u043e\u0441\u0442\u044c \u0416\u041f; \u2022 \u041e\u0431\u044a\u0435\u043c \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u044b\n\n\u0432\u044b\u0431\u0440\u043e\u0441; \u2022 Hb; \u043f\u0435\u0447\u0435\u043d\u0438;\n\u2022 \u0429\u0424 (\u0437\u0430 \u0441\u0447\u0435\u0442 \u2022 Ht; \u2022 \u041f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0439 \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u043a;\n\u043f\u043b\u0430\u0446\u0435\u043d\u0442\u0430\u0440\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438); \u2022 \u041c\u043e\u0447\u0435\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430; \u2022 \u0410\u041b\u0422, \u0410\u0421\u0422;\n\u2022 \u0424\u0430\u043a\u0442\u043e\u0440\u044b \u0441\u0432\u0435\u0440\u0442\u044b\u0432\u0430\u043d\u0438\u044f; \u2022 \u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d; \u2022 \u0413\u0413\u0422\u041f;\n\n\u2022 5\u2019 \u043d\u0443\u043a\u043b\u0435\u043e\u0442\u0438\u0434\u0430\u0437\u0430 \u2022 \u041e\u0431\u0449\u0438\u0439 \u0431\u0435\u043b\u043e\u043a; \u2022 \u0411\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d;\n\u2022 \u0410\u043d\u0442\u0438\u0442\u0440\u043e\u043c\u0431\u0438\u043d III \u2022 \u041f\u0412\n\n6\n\n2) \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0432 \u0422\u0430\u0431\u043b\u0438\u0446\u0435 2:\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2. \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 \u043f\u0435\u0447\u0435\u043d\u0438, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0441 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e:\n\u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u044f \u0416\u0430\u043b\u043e\u0431\u044b \u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u0424\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435