----------|-------------------------|\n| >85 | 0 |\n| 65 - 84 | 25 |\n| 50 - 64 | 50 |\n| <49 | 100 |\n\n## d) \u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0434\u043e\u0437\u044b Mtx \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043c\u0443\u043a\u043e\u0437\u0438\u0442\u0430:\n\n| \u0421\u0442\u0435\u043f\u0435\u043d\u044c \u043c\u0443\u043a\u043e\u0437\u0438\u0442\u0430 | \u0420\u0435\u0434\u0443\u043a\u0446\u0438\u044f \u0434\u043e\u0437\u044b Mtx (%) |\n|--------------------|-------------------------|\n| I | 25 |\n| II | 50 |\n| III | 100 |\n| IV | 100 |\n\n- e) \u041f\u0440\u0438 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0438 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u044f\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430 (\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u044b\u043f\u043e\u0442, \u0430\u0441\u0446\u0438\u0442 \u0438 \u0442.\u0434.), \u0435\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u041f\u043e\u0441\u043b\u0435 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438, \u0434\u043e\u0437\u0430 Mtx \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u0430 25% \u0432 \u043f\u0435\u0440\u0432\u043e\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 (\u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432\u044b\u043f\u043e\u0442\u0430, \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445). \u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438, \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 Mtx \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e.\n- f) \u041a\u0430\u043b\u044c\u0446\u0438\u044f \u0444\u043e\u043b\u0438\u043d\u0430\u0442. \u0412\u0441\u0435\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0444\u043e\u043b\u0438\u0435\u0432\u043e\u0439 \u043a\u0438\u0441\u043b\u043e\u0442\u044b, \u0432 \u0434\u043e\u0437\u0435 30 \u043c\u0433/\u043c 2, \u0447\u0435\u0440\u0435\u0437 24\u0447 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 Mtx; \u0447\u0435\u0440\u0435\u0437 30\u0447 - \u043f\u043e\u0441\u043b\u0435 \u0432\u0442\u043e\u0440\u043e\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u0438 \u0447\u0435\u0440\u0435\u0437 36\u0447 - \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0435\u0442\u044c\u0435\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438. [KFS]\n\n## \u041c\u043e\u0444\u0435\u0442\u0438\u043b\u0430 \u043c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u0430\u0442/\u043c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u0430\u0442 \u043d\u0430\u0442\u0440\u0438\u044f/\u043c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430.\n\n- a) \u0420\u0430\u0441\u0447\u0435\u0442 \u0434\u043e\u0437\u044b.\n\nMMF \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u0434\u043e\u0437\u0435 30 \u043c\u0433/\u043a\u0433, \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430, \u043d\u043e \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3000 \u043c\u0433/\u0441\u0443\u0442.\n\n\u041f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u041c\u041cF \u043d\u0430 MPS/MP\u0410 \u0434\u043e\u0437\u0430 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c: 1000 \u043c\u0433 \u041c\u041cF = 720-750 \u043c\u0433 MPS/MPA. [50]\n\n\u041f\u0440\u0438\u0435\u043c MMF/MPS/MPA \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u0434\u043e \u0434\u043d\u044f +35. \u041f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f MMF/MPS/MPA \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430.\n\n- b) \u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f.\n- \u041c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e;\n- \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0434\u0438\u0430\u0440\u0435\u0438 \u0438\u043b\u0438 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f MMF/MPS/MPA \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043e\u0442\u043c\u0435\u043d\u0435\u043d;\n\n- \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u0438 IV \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432 \u043f\u043e\u0441\u0442\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u0431\u043e\u043b\u0435\u0435 21 \u0434\u043d\u044f, \u043f\u0440\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u0440\u0438\u0447\u0438\u043d, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u043e\u0437\u0443 MMF/MPS/MPA \u043d\u0430 20%;\n- \u00b7\n\nMMF/MPS \u043d\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u0435\u043d \u0432 \u043c\u043e\u043d\u043e\u0440\u0435\u0436\u0438\u043c\u0435, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 ( \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0410 ). [51]\n\n- \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u044f MMF/MPS/MPA \u043d\u0435 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044f. [45]; \u0432 \u0443\u0440\u043e\u0432\u0435\u043d\u044c\n\n## \u0410\u043d\u0442\u0438\u0442\u0438\u043c\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439 \u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d.\n\nATG \u043c\u043e\u0436\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0420\u0422\u041f\u0425 \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438. \u0414\u043e\u0437\u0430 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u0438\u0434\u0430:\n\n- \u041b\u043e\u0448\u0430\u0434\u0438\u043d\u044b\u0439 - 10-20 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442.\n- \u041a\u0440\u043e\u043b\u0438\u0447\u0438\u0439 - 2,5 (\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0434\u043e 5) \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\n\n\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u044f: PD \u0438\u043b\u0438 MPD1 \u043c\u0433/\u043a\u0433 \u0432/\u0432, \u043f\u0435\u0440\u0435\u0434 \u043a\u0430\u0436\u0434\u044b\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c ATG. [45]\n\n\u0410\u043d\u0430\u043b\u0438\u0437 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f ATG \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0420\u0422\u041f\u0425, \u043f\u043e\u043a\u0430\u0437\u0430\u043b \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0436\u0438\u0437\u043d\u0435\u0443\u0433\u0440\u043e\u0436\u0430\u044e\u0449\u0435\u0439 \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 (GradeIII-IV) \u043f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 ATG. \u041e\u0434\u043d\u0430\u043a\u043e \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0431\u044b\u043b\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u043a\u0440\u043e\u043b\u0438\u0447\u044c\u0435\u0433\u043eATG. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u043d\u0435 \u043e\u0442\u043c\u0435\u0447\u0430\u043b\u043e\u0441\u044c ( \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0410 ). [52]\n\n\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0410TG\u043f\u0440\u0438 \u043d\u0435\u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0430\u043b\u043b\u043e\u0422\u041a\u041c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u043c \u043f\u043e\u0434\u0445\u043e\u0434\u043e\u043c.\n\n## \u0413\u041a\u0421.\n\n\u0413\u041a\u0421 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0420\u0422\u041f\u0425, \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u044b \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 \u0438/\u0438\u043b\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044e \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432. \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0413\u041a\u0421 \u043a \u0434\u0440\u0443\u0433\u0438\u043c \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c, \u043d\u0435 \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0420\u0422\u041f\u0425.\n\n\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f PD \u0438\u043b\u0438 MPD \u0432 \u0434\u043e\u0437\u0435 0,5 \u043c\u0433/\u043a\u0433 \u04452\u0440/\u0441\u0443\u0442, \u0432/\u0432. \u041f\u0440\u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f >14 \u0434\u043d\u0435\u0439, \u043e\u0442\u043c\u0435\u043d\u0430 \u0413\u041a\u0421 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e.[45]\n\n## \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432.\n\n- \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u043c \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u043c \u0432\u044b\u0448\u0435 (\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432);\n- \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430, \u0432\u0441\u0435 \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043e\u0442\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e;\n- \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430, \u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043e\u0442\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2-4 \u043d\u0435\u0434\u0435\u043b\u044c. [53]\n\n## 2. \u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0420\u0422\u041f\u0425 (\u0444\u043e\u0440\u0435\u0441\u0442\u0433\u0440\u0430\u0444\u0438\u043a)[54]\n\n## \u0422\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044f \u0413\u0421\u041a\n\n## \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043a\u043b\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442\u0430\n\n\u0412 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u0413\u0421\u041a \u043c\u043e\u0436\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f:\n\n- \u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0439 (BM) \u0438\u043b\u0438 \u043f\u0440\u0430\u0439\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 (G-BM) \u043a\u043e\u0441\u0442\u043d\u044b\u0439 \u043c\u043e\u0437\u0433;\n- \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0440\u043e\u0432\u044c \u043f\u043e\u0441\u043b\u0435 \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438 (G-PB);\n\n\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f G-PB.\n\n\u041a\u043e\u043d\u0435\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0421D34+ \u043a\u043b\u0435\u0442\u043e\u043a \u0432 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442\u0435 \u043c\u0435\u043d\u0435\u0435 2,0\u044510 6 \u043a\u043b\u0435\u0442\u043e\u043a/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 \u0440\u0430\u0441\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u043f\u043b\u043e\u0445\u0430\u044f \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f. [55,56]\n\n\u0414\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435\u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u0432\u0437\u0432\u0435\u0441\u044c \u0413\u0421\u041a \u043d\u0435 \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u044e\u0442 \u043a\u0440\u0438\u043e\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0446\u0438\u0438 \u0438 \u043e\u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0432 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440 (\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435) \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24-48 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0431\u043e\u0440\u0430.\n\n\u0413\u0421\u041a \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u043e\u0434\u0432\u0435\u0433\u0430\u0442\u044c\u0441\u044f \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e \u0438\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e \u0438\u0437\u043b\u0443\u0447\u0435\u043d\u0438\u044f.\n\n## \u041f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u0413\u0421\u041a\n\n\u0418\u043d\u0444\u0443\u0437\u0438\u044f \u0413\u0421\u041a \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0434\u0435\u043d\u044c 0. \u041f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u043c\u0438\u043a\u0441\u0442\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0442\u0430 (\u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438 \u043a\u043e\u0441\u0442\u043d\u043e-\u043c\u043e\u0437\u0433\u043e\u0432\u044b\u0435 \u0413\u0421\u041a) \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u0413\u0421\u041a \u0432 \u0440\u0430\u0437\u043d\u044b\u0435 \u0434\u043d\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u04140 \u0438 \u0414+1 \u0438\u043b\u0438 \u04140 \u0438 \u0414+7).\n\n\u041f\u0440\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0431\u043e\u043b\u0435\u0435 200 \u043c\u043b \u0432\u0437\u0432\u0435\u0441\u0438 \u0413\u0421\u041a, \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0430\u043d\u0442\u0438-\u0410 \u0438\u043b\u0438 \u0430\u043d\u0442\u0438-\u0412 \u0430\u043d\u0442\u0438\u0442\u0435\u043b \u0443 \u0440\u0435\u0446\u0438\u043f\u0438\u0435\u043d\u0442\u0430 (\u0442\u0438\u0442\u0440 \u0431\u043e\u043b\u0435\u0435 1:16), \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0438\u043b\u0438 \u0434\u0432\u0443\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0439 (\u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439) \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0410\u04120 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f - 1000 \u043c\u043b 0,9% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u043d\u0430\u0442\u0440\u0438\u044f \u0432/\u0432 \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 1 \u043c\u043b/\u043c\u0438\u043d \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0441 \u0438\u043d\u0444\u0443\u0437\u0438\u0435\u0439 \u0413\u0421\u041a, 2 \u043c\u043b/\u043c\u0438\u043d \u0447\u0435\u0440\u0435\u0437 30 \u043c\u0438\u043d\u0443\u0442 \u0438 \u043f\u0440\u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 - 3 \u043c\u043b/\u043c\u0438\u043d.\n\n\u0420\u0430\u0437\u043c\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u0438\u043e\u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0413\u0421\u041a \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u043d\u0430 \u0432\u043e\u0434\u044f\u043d\u043e\u0439 \u0431\u0430\u043d\u0435 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u0438 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0435 37-38 0 \u0421.\n\n\u041f\u0435\u0440\u0435\u0434 \u0438\u043d\u0444\u0443\u0437\u0438\u0435\u0439 \u0413\u0421\u041a \u0432 \u0