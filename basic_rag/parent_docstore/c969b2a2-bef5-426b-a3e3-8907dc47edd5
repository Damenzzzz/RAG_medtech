42\u043e\u043d\u0438\u044f (\u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c\n\n(\u0413\u0414) \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f) (\u041c\u0414) (\u0414\u041f)\n\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u041c\u0438\u043e\u043a\u043b\u043e\u043d\u043e-\u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0435 \u0421\u043e\u0447\u0435\u0442\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c\u0438, \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u0445 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u0438\n\u0444\u043e\u0440\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438, \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c\u0430\n\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u0445. \u041c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441 (\u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e\n\n\u0432\u0440\u0430\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u0438 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441- \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u043c\u044b\u0435), \u0438\u043d\u043e\u0433\u0434\u0430 \u0441\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0433\u043e\u043b\u043e\u0432\u044b, \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 - \u043d\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u043c\u0438 \u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u0442\u0443\u043b\u043e\u0432\u0438\u0449\u0430 \u0438 \u044d\u043f\u0438\u043b\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439. \u0423 \u043f\u0438\u0440\u0430\u043c\u0438\u0434\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430 \u0438\u043b\u0438\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0434\u0440\u0443\u0433\u0438\u0445 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\n\u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043f\u043e\u0434 \u00ab\u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f\n\u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0435\u0439\u00bb (DYT11) \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f.\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0435 \u041e\u0441\u043e\u0431\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\n\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u0438 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u0438 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441\u0430; \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442\n\u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u044d\u0442\u043e \u044f\u0432\u043b\u0435\u043d\u0438\u0435, \u043f\u043e \u0441\u0443\u0442\u0438, \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0438\u0437 \u043d\u0438\u0445:\n\u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0438 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0414\u041e\u0424\u0410-\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f\n\u0438\u0441\u0447\u0435\u0437\u0430\u044e\u0449\u0438\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u0431\u043e\u0439 \u00ab\u044d\u0441\u0441\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f (DRD, DOPA-\n\n\u0441\u043d\u0430. \u0424\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0449\u0438\u0435\u0441\u044f \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441\u00bb, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 responsive dystonia,\n\u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0435, \u043d\u0435\u0443\u0434\u043e\u0431\u043d\u044b\u0435 \u0443 \u043c\u043d\u043e\u0433\u0438\u0445 \u0438\u0437 \u044d\u0442\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0421\u0435\u0433\u0430\u0432\u044b),\n\u043f\u043e\u0437\u044b \u043c\u043e\u0433\u0443\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0412\u0438\u043b\u044c\u0441\u043e\u043d\u0430 -\n\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043b\u0438\u0448\u044c \u0441\u043b\u0430\u0431\u043e\u0437\u0430\u043c\u0435\u0442\u043d\u0430\u044f \u041a\u043e\u043d\u043e\u0432\u0430\u043b\u043e\u0432\u0430, Parkin-,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f PINK1-, \u0438 DJ-1-\n\n\u041f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f, \u0438\u043b\u0438 \u0443 \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439\n\u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c (PARK2,\n\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0447\u0438\u0441\u0442\u044b\u0439 6 \u0438 7), X-\u0441\u0446\u0435\u043f\u043b\u0435\u043d\u043d\u0430\u044f\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0437\u0430, \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f-\n\n\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u043e\u044f\u0441\u043d\u0438\u0447\u043d\u044b\u0439 \u043a\u0430\u043a \u0443 \u0434\u0440\u0443\u0433\u0438\u0445 \u0447\u043b\u0435\u043d\u043e\u0432 \u0442\u043e\u0439 \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c/\u0441\u0438\u043d\u0434\u0440\u043e\u043c\n\u0433\u0438\u043f\u0435\u0440\u043b\u043e\u0440\u0434\u043e\u0437 \u0441\u043e \u0436\u0435 \u0441\u0435\u043c\u044c\u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f LUBAG (DYT3),\n\u0441\u0433\u0438\u0431\u0430\u043d\u0438\u0435\u043c \u043d\u043e\u0433 \u0432 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438 \u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u0442\u0430\u0437\u043e\u0431\u0435\u0434\u0440\u0435\u043d\u043d\u044b\u0445 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441 \u0438 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f; \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f-\u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c\n\n\u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445 \u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 \u0432\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 (DYT12), \u0438\n\u0440\u043e\u0442\u0430\u0446\u0438\u0435\u0439 \u0440\u0443\u043a \u0438 \u043d\u043e\u0433. \u0412 \u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0435\u0439\u0440\u043e\u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0441\n\u0442\u0435\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445, \u043a\u043e\u0433\u0434\u0430 \u0438\u0437- \u043f\u043e\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0436\u0435\u043b\u0435\u0437\u0430 \u0432\n\u0437\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c \u043e\u0442 \u0431\u044b\u0441\u0442\u0440\u044b\u0445 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u043c \u043c\u043e\u0437\u0433\u0435 (NBIA,\n\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u00ab\u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u044b\u0445\u00bb \u0432\u043a\u043b\u044e\u0447\u0430\u044f PANK2- \u0438\n\u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0442\u043e\u043d\u0443\u0441\u0430 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 PLA2G6-\n\u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0441\u0442\u043e\u0439\u043a\u0430\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u043f\u043e \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c \u043d\u0435\u0439\u0440\u043e\u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e,\n\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u043e\u0437\u0430, \u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438 \u043d\u0435\u0439\u0440\u043e\u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u044e \u0438\n\u0433\u0438\u043f\u0435\u0440\u043a\u0438\u043d\u0435\u0437 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0440\u0443\u0433\u0438\u0435 \u0444\u043e\u0440\u043c\u044b). \u0412\n\u0438\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043e\u0446\u0435\u043d\u043a\u0438. \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f\n\u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f, \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0432\u044b\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f\n\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043d\u043e\u0432\u044b\u0435\n\n(\u0440\u0438\u0433\u0438\u0434\u043d\u043e\u0439) \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438. \u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0435,\n\u0420\u0430\u0437\u043b\u0438\u0447\u0430\u044e\u0442 \u0434\u0432\u0435 \u0444\u043e\u0440\u043c\u044b \u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0435 \u0438 X-\n\u0431\u043e\u043b\u0435\u0437\u043d\u0438: \u0444\u043e\u0440\u043c\u0430 \u0441 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u043d\u044b\u0435 \u0433\u0435\u043d\u044b,\n\u0440\u0430\u043d\u043d\u0438\u043c \u043d\u0430\u0447\u0430\u043b\u043e\u043c, \u043b\u0435\u0436\u0430\u0449\u0438\u0435 \u0432 \u043e\u0441\u043d\u043e\u0432\u0435\n\n\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u0441 \u043c\u0443\u0442\u0430\u0446\u0438\u0435\u0439 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438-\n\u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c \u043f\u043b\u0435\u0447\u0435 9-\u0439 \u043f\u0430\u0440\u043a\u0438\u043d\u0441\u043e\u043d\u0438\u0437\u043c\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u043c\n\u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b (9q34), \u0438 \u043f\u0440\u0438\u0441\u0432\u0430\u0438\u0432\u0430\u044e\u0442 \u043c\u0435\u0442\u043a\u0438\n\u0444\u043e\u0440\u043c\u0430 \u0441 \u043f\u043e\u0437\u0434\u043d\u0438\u043c DYTn \u0438\u043b\u0438 PARKn.\n\n\u043d\u0430\u0447\u0430\u043b\u043e\u043c, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u0441 \u0414\u041e\u0424\u0410-\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f\n\u043c\u0443\u0442\u0430\u0446\u0438\u0435\u0439 \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f,\n\u043f\u043b\u0435\u0447\u0435 8-\u0439 \u0438\u043b\u0438 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0448\u0430\u044f\u0441\u044f \u0440\u0430\u043d\u0435\u0435\n\u043a\u043e\u0440\u043e\u0442\u043a\u043e\u043c \u043f\u043b\u0435\u0447\u0435 18-\u0439 \u043a\u0430\u043a \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\n\u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b. \u0414\u0438\u0441\u0442\u043e\u043d\u0438\u044f, \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044f \u0441\n\u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0441 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c\u0438\n\u0433\u0435\u043d\u043e\u043c DYT1, \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u044f\u043c\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u043a\u043e\u0434\u0438\u0440\u0443\u044e\u0449\u0438\u043c \u0431\u0435\u043b\u043e\u043a \u0434\u043d\u044f (\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0421\u0435\u0433\u0430\u0432\u044b)\nTorsinA, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0432 \u0434\u0435\u0442\u0441\u043a\u043e\u043c\n\u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0439 \u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435. \u0412 \u043e\u0441\u043d\u043e\u0432\u0435\n\u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0439 \u0441 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0436\u0438\u0442\n\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u043c\u0443\u0442\u0430\u0446\u0438\u044f \u0433\u0435\u043d\u0430 GTP-\n\u0437\u0440\u0435\u043d\u0438\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0435\u0439, \u0446\u0438\u043a\u043f\u043e\u0433\u0438\u0434\u0440\u043e\u043b\u0430\u0437\u044b I \u043d\u0430\n\u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u043e \u0434\u043b\u0438\u043d\u043d\u043e\u043c \u043f\u043b\u0435\u0447\u0435 14-\u0439\n\u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e- \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b (14q22.3).\n\u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u043e\u043c\u0443 \u0442\u0438\u043f\u0443, \u0438 \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u2014 \u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\n\u043f\u0435\u043d\u0435\u0442\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c\u044e, \u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0439 \u0441 \u043d\u0438\u0437\u043a\u043e\u0439\n\u0440\u0430\u0432\u043d\u043e\u0439 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 30%. \u043f\u0435\u043d\u0435\u0442\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c\u044e.\n\u0412\u0442\u043e\u0440\u043e\u0439 \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c\n\n\u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0433\u0435\u043d - THAP1 - \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u043a\u043e\u043b\u0435\u0431\u043b\u0435\u0442\u0441\u044f \u0432\n\u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u044e \u043f\u043e \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043d\u044f, \u043d\u043e \u043d\u0430\n\u0442\u0438\u043f\u0443 DYT6, \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u043c\u043d\u043e\u0433\u0438\u0445 \u043b\u0435\u0442\n\n\u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e- \u0438\u043c\u0435\u0435\u0442 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u043a\n\u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044e \u043f\u043e \u043c\u0435\u0440\u0435\n\u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438 \u0441 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f.\n\n\u043f\u0435\u043d\u0435\u0442\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c\u044e\n\u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 60%.\n\u0410\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0435\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e\n\n\u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u043f\u0440\u0438\n\u0441\u043f\u043e\u0440\u0430\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043b\u0438\n\u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0441\n\u043d\u0435\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0435\u0439.\n\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\n\u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0430\n1-\u043c \u0438\u043b\u0438 2-\u043c\n\n\u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u044f\u0445 \u0436\u0438\u0437\u043d\u0438, \u0432\n1/3 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u2014 \u0434\u043e 15\n\u043b\u0435\u0442. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0434\u0435\u0431\u044e\u0442\u0430 \u0432\n\u0440\u0430\u043d\u043d\u0435\u043c \u0434\u0435\u0442\u0441\u043a\u043e\u043c\n\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435\n\u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\n\u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n\u0445\u043e\u0434\u044c\u0431\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435\n\n\u043f\u043e\u043d\u0430\u0447\u0430\u043b\u0443 \u0431\u044b\u0432\u0430\u0435\u0442\n\u0442\u0440\u0443\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\n\u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u041f\u0440\u0438\n\n\u0434\u0435\u0431\u044e\u0442\u0435 \u0432 \u0437\u0440\u0435\u043b\u043e\u043c\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435\n\u043d\u0430\u0441\u0438\u043b\u044c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442,\n\n\u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0442\u0443\u043b\u043e\u0432\u0438\u0449\u0430 \u0438\n\u0432\u0435\u0440\u0445\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439,\n\u0438 \u043b\u0438\u0448\u044c \u0432 1/3 \u0441\u043b\u0443\u0447\u0430\u0435\u0432\n\u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442 \u0432\n\n\u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0443\u044e\n\u0444\u043e\u0440\u043c\u0443.\n\n\u2022 \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 - \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u044b\u0435 \u0438 \u0437\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f,\n\u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0436\u0435\u0441\u0442\u044b:\n\u2022 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0435\u043c\u043e\u0440 - \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u044b\u0435 \u043f\u0443\u043b\u044c\u0441\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435, \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u044b\u0435, \u043d\u043e \u0447\u0430\u0441\u0442\u043e\n\u043d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435, \u0448\u0430\u0431\u043b\u043e\u043d\u043d\u044b\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u0438 \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0438\n\n\u0437\u0430\u0442\u0440\u043e\u043d\u0443\u0442\u044b\u0445 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0435\u0439 \u043c\u044b\u0448\u0446, \u0447\u0430\u0441\u0442\u043e \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043f\u0440\u0438 \u043f\u043e\u043f\u044b\u0442\u043a\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f\n\u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0439 (\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439) \u043f\u043e\u0437\u044b. \u0414\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0435\u043c\u043e\u0440 \u043c\u043e\u0436\u0435\u0442 \u043d\u0435 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f,\n\u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0431\u0435\u0437 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u044c\u0441\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u043e\u0437\u0435 (\u201c\u043d\u0443\u043b\u0435\u0432\u0430\u044f \u0442\u043e\u0447\u043a\u0430\u201d). \u0418\u043d\u043e\u0433\u0434\u0430 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0440\u0435\u043c\u043e\u0440 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e\n\n\u0442\u0440\u0443\u0434\u043d\u043e \u043e\u0442\u043b\u0438\u0447\u0438\u0442\u044c \u043e\u0442 \u044d\u0441\u0441\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u0440\u0435\u043c\u043e\u0440\u0430.\n\u2022 \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 - \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f, \u0447\u0430\u0441\u0442\u043e\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u0430\u044f \u043f\u0440\u0438 \u0434\u0438\u0441\u0442\u043e\u043d\u0438\u0438, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0431\u043e\u0439 \u043d\u0435\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u044b\u0435\n\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0442, \u043d\u043e \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0442\u0441\u044f \u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445", "type": "Document"}}