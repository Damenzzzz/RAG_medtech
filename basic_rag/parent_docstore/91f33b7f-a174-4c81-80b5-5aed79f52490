30\u0440\u0430\u0433\u0430\u043d\u0434\u0438\u043d\u0441\u043a\u0438\u0439 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439\n\u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u00bb, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433.\n\n3.2 \u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n\n3.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n1) \u0420\u0430\u043c\u0430\u0437\u0430\u043d\u043e\u0432\u0430 \u0420.\u041c. \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u0410\u041e \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f\u00bb.\n2) \u041a\u0435\u043c\u0430\u0439\u043a\u0438\u043d \u0412.\u041c. \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442\u0430 \u043e\u043d\u043a\u043e\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u04