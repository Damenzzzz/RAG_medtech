0438\u044f\u00bb\n(\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435).\n\nNo \u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e/ \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\n\u0444\u0430\u0440\u043c\u0430\u043a\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\n\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430\n1 \u041b\u0421 \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0449\u0438\u0435 \u0440\u0435\u043e\u043b\u043e\u0433\u0438\u044e \u043a\u0440\u043e\u0432\u0438\n1.1 \u041f\u0435\u043d\u0442\u043e\u043a\u0441\u0438\u0444\u0438\u043b\u043b\u0438\u043d \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0432\u0432\u043e\u0434\u044f\u0442 100 \u0421\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0423\u0414 [B] \u2013\n(\u0432\u0430\u0437\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440) \u043c\u0433 (5 \u043c\u043b \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430) \u0432 250- \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0443 33,34\n\n500 \u043c\u043b 0,9 % \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441\n\u0438\u0437\u043e\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0442\u044f\u0436\u0451\u043b\u043e\u0439\n\u043d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434\u0430 \u0438\u043b\u0438 5 % \u0438\u0448\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0433\u043b\u044e\u043a\u043e\u0437\u044b (\u0432 \u0431\u043e\u043b\u0435\u0437\u043d\u044c\u044e \u0441\u0435\u0440\u0434\u0446\u0430\n\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 90-180 \u043c\u0438\u043d); \u0432 \u0438\u043b\u0438\n\u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c\u0438\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u0435\u043d\u043e\u0437\u0430\u043c\u0438\n\u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e 200- \u043a\u0440\u043e\u0432\u0435\u043d\u043e\u0441\u043d\u044b\u0445\n\n300 \u043c\u0433 (10-15 \u043c\u043b). \u0441\u043e\u0441\u0443\u0434\u043e\u0432,\n\u041f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u0442\u0435\u0440\u0430\u043f\u0438\u044e \u0441\u043d\u0430\u0431\u0436\u0430\u044e\u0449\u0438\u0445\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0439 \u043c\u043e\u0437\u0433.\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e\n\n\u0442\u0430\u0431\u043b\u0435\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439\n\u0444\u043e\u0440\u043c\u043e\u0439\n\u043f\u0435\u043d\u0442\u043e\u043a\u0441\u0438\u0444\u0438\u043b\u0438\u043d\u0430.\n2 \u041b\u0421, \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0449\u0438\u0435 \u043d\u0435\u0439\u0440\u043e-\u043c\u044b\u0448\u0435\u0447\u043d\u0443\u044e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\n\n2.1 \u041d\u0435\u043e\u0441\u0442\u0438\u0433\u043c\u0438\u043d\u0430 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u2013 \u0423\u0414 [\u0412] \u2013\n\u0431\u0440\u043e\u043c\u0438\u0434 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e \u0432 \u0434\u043e\u0437\u0435 0,5-2 \u043c\u0433 35,36\n(\u0430\u043d\u0442\u0438\u0445\u043e\u043b\u0438\u043d\u044d\u0441\u0442\u0435\u0440\u0430 (1-4 \u043c\u043b) 1-2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0437\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e) \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0437\u043e\u0432\u0430\u044f\n\n\u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 2 \u043c\u0433,\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f 6 \u043c\u0433.\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f (\u043a\u0440\u043e\u043c\u0435\n\u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u0438,\n\n\u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0440\u0438\u0437\u0430,\n\u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439\n\u0430\u0442\u043e\u043d\u0438\u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430 \u0438\n\u043c\u043e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u0443\u0437\u044b\u0440\u044f,\n\n\u043f\u0435\u0440\u0435\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438\n\n15\n\n\u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442\u0430\u043c\u0438) 25-30\n\u0434\u043d\u0435\u0439. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439\n\u043a\u0443\u0440\u0441 \u0447\u0435\u0440\u0435\u0437 3-4 \u043d\u0435\u0434\u0435\u043b\u0438.\n\n3 \u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u043e-\u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438 \u0441\u043f\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u043f\u0440\u0438\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u0440\u0435\u0437\u0430\u0445 \u0438 \u043f\u0430\u0440\u0430\u043b\u0438\u0447\u0430\u0445\n3.1 \u0411\u0430\u043a\u043b\u043e\u0444\u0435\u043d \u041e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u0442 \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441 IA (\u0434\u043b\u044f\n\n0,75 \u0434\u043e 2 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u043c\u043f\u044b)\n\u0442\u0435\u043b\u0430. \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u0441 IIB (\u0434\u043b\u044f\n\u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0434\u043e\u0437\u044b 5 \u043c\u0433, \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\n\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0435\u043c\u043e\u0439 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c. \u043d\u043e\u0433\u043e\n\u0441\u0443\u0442\u043a\u0438. \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\n\n\u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0442\u044c \u0438\u044f)\n\u0432\u043d\u0435\u0437\u0430\u043f\u043d\u043e, \u0423\u0414 [\u0410] \u2013\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e 37\n\u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0435\n\n\u0433\u0430\u043b\u043b\u044e\u0446\u0438\u043d\u0430\u0446\u0438\u0439 \u0438\n\u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435\n\u0441\u043f\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439.\n\n3.2 \u0411\u043e\u0442\u0443\u043b\u043e\u0442\u043e\u043a\u0441\u0438\u043d 10-20 \u0415\u0414/\u043a\u0433 \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0423\u0414 [\u0410] \u2013\n\u0442\u0438\u043f\u0430 \u0410 \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e. \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 38\n\u041e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e. \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\n\u0442\u043e\u043b\u044c\u043a\u043e\n\u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\n\u044b\u043c \u0432\n\u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\n\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u043c.\n\n3.3 \u0422\u0438\u0437\u0430\u043d\u0438\u0434\u0438\u043d \u041a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0423\u0414 [\u0412] \u2013\n(\u043c\u0438\u043e\u0440\u0435\u043b\u0430\u043a\u0441\u0430\u043d\u0442 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 37\n\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0430\u0437\u043c\u0430: \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f) \u0432\u043d\u0443\u0442\u0440\u044c, \u043f\u043e 2-4 \u043c\u0433 3 \u0440\u0430\u0437\u0430 \u0432 \u044e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f\n\u0434\u0435\u043d\u044c; \u0432 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 2\n\u2013 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430 \u043d\u043e\u0447\u044c \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 2-4 \u043c\u0433. \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043f\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\n\u0441\u043a\u0435\u043b\u0435\u0442\u043d\u044b\u0445 \u043c\u044b\u0448\u0446, \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e,\n\u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u0441\n\u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0443\u0447\u0435\u0442\u043e\u043c\n\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438: \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0438\n\u0434\u043e\u0437\u0430 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438.\n\n16\n\n\u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e.\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 \u043f\u043e 2 \u043c\u0433\n3 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c, \u0437\u0430\u0442\u0435\u043c\n\u0441\u0443\u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043e\u0437\u0443\n\u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442\n\n\u043d\u0430 2-4 \u043c\u0433 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430\u043c\u0438\n\u043e\u0442 3-4 \u0434\u043e 7 \u0434\u043d\u0435\u0439. \u041e\u0431\u044b\u0447\u043d\u043e\n\u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439\n\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u0444\u0444\u0435\u043a\u0442\n\n\u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438\n\u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u0437\u0435 \u043e\u0442 12 \u0434\u043e\n24 \u043c\u0433, \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439\n\u043d\u0430 3 \u0438\u043b\u0438 4 \u043f\u0440\u0438\u0435\u043c\u0430 \u0447\u0435\u0440\u0435\u0437\n\n\u0440\u0430\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438\n\u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\u0434\u043e\u0437\u0430 \u2013 36 \u043c\u0433.\n\n4 \u0410\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041b\u0421\n4.1 \u041a\u0435\u0442\u043e\u043f\u0440\u043e\u0444\u0435\u043d \u0421\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438 \u0432/\u0432 \u2013 \u0423\u0414 [\u0412] \u2013\n(\u041d\u041f\u0412\u0421) \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 200-300 \u043c\u0433 39\n(\u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c\n\n300 \u043c\u0433), \u0434\u0430\u043b\u0435\u0435\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435\n\u043a\u0430\u043f\u0441\u0443\u043b\u044b 150\u043c\u0433 1 \u0440/\u0434, \u0438\u043b\u0438\n\n\u043a\u0430\u043f\u0441. \u0422\u0430\u0431. 100 \u043c\u0433 2 \u0440/\u0434.\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u0449\u0435\u0433\u043e\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n\u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 5-7 \u0434\u043d\u0435\u0439.\n\n4.2 \u041b\u043e\u0440\u043d\u043e\u043a\u0441\u0438\u043a\u0430\u043c \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0440\u0443\u0439\u043d\u043e \u2013 \u0423\u0414 [\u0412] \u2013\n(\u041d\u041f\u0412\u0421) (\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u043b\u0438\u0432\u0430\u043d\u0438\u044f 39\n\u043b\u0438\u043e\u0444\u0438\u043b\u0438\u0437\u0430\u0442 \u0434\u043b\u044f 15 \u0441) \u0438\u043b\u0438\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e\n\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u0432/\u0432, (\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438\n\u0432/\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f, 8\u043c\u0433, 5 \u0441) \u0432\u0432\u043e\u0434\u044f\u0442 \u043f\u043e 8-16\n\u0442\u0430\u0431\u043b 8 \u043c\u0433 \u043c\u0433/\u0441\u0443\u0442; \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\n16 \u043c\u0433.\n\n4.3 \u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0432\u0432\u043e\u0434\u044f\u0442 \u2013 \u0423\u0414 [\u0412] \u2013\n(\u041d\u041f\u0412\u0421) \u0432\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e \u043f\u0443\u0442\u0435\u043c 39\n\u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438 \u0432\n\u044f\u0433\u043e\u0434\u0438\u0447\u043d\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u044