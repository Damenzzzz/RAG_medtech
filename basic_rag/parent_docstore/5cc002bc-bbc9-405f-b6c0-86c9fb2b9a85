442\u0430\u043c \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0444\u0430\u043a\u0442\u043e\u0440\u044b, \u043f\u043e\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0435 \u0440\u0438\u0441\u043a\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0413\u041a: \u043d\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0442\u044c \u0432 \u043f\u0438\u0449\u0443 \u0441\u043b\u0430\u0434\u043a\u0438\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b,\n\n\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043c\u0435\u0434 \u0438 \u0441\u043b\u0430\u0434\u043a\u0438\u0435 \u0444\u0440\u0443\u043a\u0442\u044b, \u043f\u043e\u0432\u044b\u0448\u0430\u044e\u0449\u0438\u0435 \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u043e\u0433\u043e \u0441\u0430\u0445\u0430\u0440\u043d\u043e\u0433\u043e\n\u0434\u0438\u0430\u0431\u0435\u0442\u0430, \u0442\u0430\u043a\u0436\u0435, \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043e\u0441\u0442\u0440\u043e\u0439 \u043f\u0438\u0449\u0438.\n\n\u2212 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u041e\u0441\u043d\u043e\u0432\u0443 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0418\u0412\u041c \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0413\u041a. \u0420\u0430\u043d\u043d\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u044b\u0445 3\u2013\u0445\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432) \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441 \