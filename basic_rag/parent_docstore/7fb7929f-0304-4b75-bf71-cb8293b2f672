435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0442\u044c \u043f\u043e \u0438\u043d\u0434\u0435\u043a\u0441\u0443\n\n\u041a\u0430\u0440\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e (0-100%) \u0438\u043b\u0438 \u0428\u043a\u0430\u043b\u0435 ECOG-\u0412\u041e\u0417 (0-4 \u0431\u0430\u043b\u043b\u0430).\n\u0418\u043d\u0434\u0435\u043a\u0441 \u041a\u0430\u0440\u043d\u043e\u0432\u0441\u043a\u043e\u0433\u043e \u0410\u043a\u0442 \u0428\u043a\u0430\u043b\u0430 ECOG - \u0412\u041e\u0417 \u0411\u0430\u043b\u043b\n\n\u0438\u0432\u043d\u043e\n\u0441\u0442\u044c,\n%\n\n\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435, \u0436\u0430\u043b\u043e\u0431 \u043d\u0435\u0442 100 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c 0\n\n\u0421\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043a \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 90 \u0415\u0441\u0442\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, 1\n\n\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u043e \u0431\u043b\u0438\u0436\u0435 \u043a \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043b\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\n\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0441 \u0443\u0441\u0438\u043b\u0438\u0435\u043c 80\n\n\u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044f 70 \u0411\u043e\u043b\u044c\u0448\u0435 50% \u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e 2\n\u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u043d\u0435 \u0432\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u043f\u043e\u0441\u0442\u0435\u043b\u0438, \u043d\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f\n\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u0432 \u043e\u0442\u0434\u044b\u0445\u0435 \u043b\u0451\u0436\u0430\n\n\u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0440\u043e\u0439 \u0432 \u043f\u043e\u043c\u043e\u0449\u0438, \u043d\u043e 60\n\u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u0441\u0430\u043c \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u0442\u044c\n\n\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0441\u0432\u043e\u0438\u0445\n\u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0435\u0439\n\n\u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 50 \u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0438 \u0432 3\n\u043f\u043e\u043c\u043e\u0449\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0441\u0442\u0435\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 50% \u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e\n\n\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438\n\n\u0418\u043d\u0432\u0430\u043b\u0438\u0434, \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 40\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438, \u0432 \u0442.\u0447.\n\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439\n\n\u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u043d\u043e\u0441\u0442\u044c, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 30 \u041d\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0442\u044c 4\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0441\u0435\u0431\u044f, \u043f\u0440\u0438\u043a\u043e\u0432\u0430\u043d \u043a \u043f\u043e\u0441\u0442\u0435\u043b\u0438\n\n\u0422\u044f\u0436\u0435\u043b\u044b\u0439 \u0431\u043e\u043b\u044c\u043d\u043e\u0439. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b 20\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0435\n\u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u0423\u043c\u0438\u0440\u0430\u044e\u0449\u0438\u0439 10\n\n16\n\n\u041c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0448\u043a\u0430\u043b\u0430 \u0420\u044d\u043d\u043a\u0438\u043d\u0430\n\n\u041d\u0435\u0442 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 0\n\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u0436\u0438\u0437\u043d\u0435\u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438: \u043d\u0430\u043b\u0438\u0447\u0438\u0435 1\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e