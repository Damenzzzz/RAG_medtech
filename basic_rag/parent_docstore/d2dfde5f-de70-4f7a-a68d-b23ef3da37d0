2\u0435\u0433\u043e\u0440\u0438\u0438 \u0440\u0422 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c \u0422.\n\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435. \u041f\u0440\u0438 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0440\u0422 \u0440\u0430\u0437\u043c\u0435\u0440 \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0435\u0441\u0442\u044c \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430 \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u043e\u0433\u043e\n\u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430. \u0415\u0441\u043b\u0438 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 in situ (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, 4 \u0441\u043c) \u0438 \u043c\u0430\u043b\u044b\u0439\n\u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, 0,5 \u0441\u043c), \u043e\u043f\u0443\u0445\u043e\u043b\u044c \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0440\u04221.\n\u0430\n\u0440N \u2013 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0435 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0437\u043b\u044b\n\n\u0414\u043b\u044f \u0433\u0438\u0441\u0442\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u044f\u0442\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u043e\u0434\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u0441