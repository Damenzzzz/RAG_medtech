34\u043e\u043c \u0437\u0430\n\u043d\u0438\u043c\u0438 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u043a\u0430\u0440\u0430\u043d\u0442\u0438\u043d\u0430;\n\u25cf \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442 \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 (\u043f\u0440\u0438 \u043d\u0435\u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438\n\n\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e-\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0435\u0440);\n\u25cf \u043f\u0440\u0438 \u043d\u0435\u0437\u0430\u0449\u0438\u0449\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430\u0445 \u0441 \u043c\u0443\u0436\u0447\u0438\u043d\u0430\u043c\u0438, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0448\u0438\u043c\u0438 \u0411\u0412\u0412\u041c\n\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0441 \u0434\u0430\u0442\u044b \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438\u043b\u0438 \u0411\u0412\u0412\u042d \u0434\u043e\n7 \u043d\u0435\u0434\u0435\u043b\u044c \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0437\u0434\u043e\u0440\u043e\u0432\u043b\u0435\u043d\u0438\u044f, \u0438\u043b\u0438 \u0434\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u0432\u0443\u0445 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0441\u043f\u0435\u0440\u043c\u044b \u043d\u0430 \u0432\u0438\u0440\u0443\u0441 \u041c\u0430\u0440\u0431\u0443\u0440\u0433.\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0441\u043b\u0443\u0447\u0430\u044f \u0411\u0412\u0412\u042d, \u0411\u0412\u0412\u041c [3]:\n\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043b\u0443\u0447\u0430\u044f \u0411\u0412\u0412\u042d\n\u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\n\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0431\u0449\u0438\u0445 \u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435, \u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435,\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0435\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e \u043d\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0445\n\u0441\u043b\u0443\u0447\u0430\u0439, \u0438/\u0438\u043b\u0438 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u043c\u0443 \u0441\u043b\u0443\u0447\u0430\u044e,\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0418 \u0418\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439:\n- \u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e; \u043e\u0434\u0438\u043d \u0438\u0437 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0435\n- \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0434\u043e 38- \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435:\n39 \u0421; \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432:\n\u2022 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n- \u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438 \u2022 \u0421\u0432\u044f\u0437\u044c \u0441 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u043c \u043e\u0447\u0430\u0433\u043e\u043c \u0432\n\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\n(\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u043d\u0435\u0434\u043e\u043c\u043e\u0433\u0430\u043d\u0438\u0435, \u0410\u0444\u0440\u0438\u043a\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1-3 \u043d\u0435\u0434\u0435\u043b\u044c\n\u043a\u043b\u0430\u0441\u0441\u0430 IgM \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435\n\u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430); \u0434\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f;\n\u043a\u0440\u043e\u0432\u0438 \u043a \u0432\u0438\u0440\u0443\u0441\u0443 \u0411\u0412\u0412\u042d \u0438\u043b\u0438 \u043a\n- \u043c\u0438\u0430\u043b\u0433\u0438\u0438, \u0430\u0440\u0442\u0440\u0430\u043b\u0433\u0438\u0438; \u2022 \u041a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c\u0438\n\u0432\u0438\u0440\u0443\u0441\u0443 \u0411\u0412\u0412\u041c \u0432 \u0422\u0424 \u0418\u0424\u0410;\n- \u043f\u044f\u0442\u043d\u0438\u0441\u0442\u043e-\u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c; \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e\n\u2022 \u043f\u043e\u043b\u0438\u043c\u0435\u0440\u0430\u0437\u043d\u0430\u044f \u0446\u0435\u043f\u043d\u0430\u044f\n- \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d (\u00ab\u0448\u0430\u0440 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430;\n\u0440\u0435\u0430\u043a\u0446\u0438\u044f \u0441 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0439\n\u0432 \u0433\u043e\u0440\u043b\u0435\u00bb); \u2022 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\n\u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0442\u0430\u0437\u043e\u0439 (\u041e\u0422-\u041f\u0426\u0420)\n-\u043d\u0435\u0443\u043a\u0440\u043e\u0442\u0438\u043c\u0430\u044f \u0440\u0432\u043e\u0442\u0430, \u0431\u043e\u043b\u0438 \u0432 \u0432\u043d\u0443\u0442\u0440\u0438\u0431\u043e\u043b\u044c\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u0438\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0420\u041d\u041a \u0432\u0438\u0440\u0443\u0441\u0430\n\u0436\u0438\u0432\u043e\u0442\u0435, \u0434\u0438\u0430\u0440\u0435\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e\n\u0411\u0412\u0412\u042d \u0438\u043b\u0438 \u0432\u0438\u0440\u0443\u0441\u0430 \u0411\u0412\u0412\u041c\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430; \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n- \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0441\n\u043a\u043e\u0436\u043d\u044b\u043c\u0438 \u043a\u0440\u043e\u0432\u043e\u0438\u0437\u043b\u0438\u044f\u043d\u0438\u044f\u043c\u0438,\n\u043e\u0440\u0433\u0430\u043d\u043d\u044b\u043c\u0438 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f\u043c\u0438,\n\u043a\u0440\u043e\u0432\u0430\u0432\u043e\u0439 \u0440\u0432\u043e\u0442\u043e\u0439;\n- \u0441\u043c\u0435\u0440\u0442\u044c, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0432\n\u043d\u0430\u0447\u0430\u043b\u0435 2-\u0439 \u043d\u0435\u0434\u0435\u043b\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043e\u0442\n\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043f\u043e\u0442\u0435\u0440\u0438 \u043a\u0440\u043e\u0432\u0438,\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438,\n\u0433\u0438\u043f\u043e\u0432\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e-\u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u0448\u043e\u043a\u0430.\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0441\u043b\u0443\u0447\u0430\u044f \u0436\u0435\u043b\u0442\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 [10]:\n\n\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043b\u0443\u0447\u0430\u044f \u0436\u0435\u043b\u0442\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430\n\u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0441\u043b\u0443\u0447\u0430\u0439\n\n\u041e\u0441\u0442\u0440\u043e\u0