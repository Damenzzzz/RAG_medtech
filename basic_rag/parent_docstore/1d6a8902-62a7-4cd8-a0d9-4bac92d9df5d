441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0438 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u043c \u226491% (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043d\u0430\n\n\u0444\u043e\u043d\u0435 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0438);\n\u2022 \u0410\u0414 \u0432 \u043f\u043e\u043a\u043e\u0435 <90/60 \u043c\u043c \u0440\u0442. \u0441\u0442. \u0438\u043b\u0438> 140/90 \u043c\u043c.\u0440\u0442.\u0441\u0442.\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439: \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f\n\u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u043e \u0438\u0437\n\n\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439:\n\u2022 \u0438\u043d\u0434\u0435\u043a\u0441 \u043e\u0434\u044b\u0448\u043a\u0438 \u043f\u043e \u0428\u043a\u0430\u043b\u0435 \u0411\u043e\u0440\u0433\u0430> 3 (\u043e\u0431\u0449\u0430\u044f \u043e\u0446\u0435\u043d\u043a\u0430: 10 \u0431\u0430\u043b\u043b\u043e\u0432);\n\u2022 \u0441\u0442\u0435\u0441\u043d\u0435\u043d\u0438\u0435 \u0432 \u0433\u0440\u0443\u0434\u0438, \u043e\u0434\u044b\u0448\u043a\u0430;\n\n\u2022 \u0433\u043e\u043b\u043e\u0432\u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435, \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c;\n\u2022 \u043f\u043e\u043c\u0443\u0442\u043d\u0435\u043d\u0438\u0435 \u0437\u0440\u0435\u043d\u0438\u044f;\n\u2022 \u0443\u0447\u0430\u0449\u0435\u043d\u043d\u043e\u0435 \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043d\u0438\u0435, \u043d\u0435 \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u043f\u0440\u0438 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435;\n\u2022 \u043e\u0431\u0438\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0431\u0430\u043b\u0430\u043d\u0441\u0430;\n\n\u2022 \u0434\u0440\u0443\u0433\u0438\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0432\u0440\u0430\u0447 \u043a\u0430\u043a \u043d\u0435\u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0434\u043b\u044f\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439.\n\n\u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 (\u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n(\u043a\u043e\u0434 \u043f\u043e \u041c\u041a\u0411-\u0425) \u0411\u0421\u0424 \u0438 (\u0438\u043b\u0438) \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f)\n\u041a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u044b\u0439 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440/\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\nZ87.0 \u0412 \u043b\u0438\u0447\u043d\u043e\u043c \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0428\u0420\u041c 2 (d230.2) \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\n\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0441\u0430\u043c\u043e\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f, \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\nZ 86.1 \u0412 \u043b\u0438\u0447\u043d\u043e\u043c \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u043e\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0445\u043e\u0434\u0438\u0442 \u0432 \u0442\u0443\u0430\u043b\u0435\u0442, \u0435\u0441\u0442 \u0438\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0438 \u043f\u0430\u0440\u0430\u0437\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0434\u0440. \u0432\u0438\u0434\u044b \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438;\n\u0431\u043e\u043b\u0435\u0437\u043d\u0438 (b440.2) \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0434\u044b\u0445\u0430\u043d\u0438\u044f\n\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u043f\u043e \u041c\u041a\u0411-10, \u0420\u041f - \u0441\u0440\u0435\u0434\u043d\u0438\u0439\n\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u00ab\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0428\u0420\u041c 3 (d230.3) \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u043e\u0432 \u043f\u043e \u043a\u043e\u0434\u0430\u043c \u041c\u041a\u0411 10 \u0441 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u0438\n\u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u0443\u0442\u043e\u0447\u043d\u044f\u044e\u0449\u0435\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u043f\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0432\u0441\u0435\u0445 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447: \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435,\n\u043a\u043e\u0434\u0443 XXI \u043a\u043b\u0430\u0441\u0441\u0430 \u041c\u041a\u0411 \u2013 10 \u0434\u043b\u044f \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u043d\u0438\u0435, \u0442\u0443\u0430\u043b\u0435\u0442;\n\u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 (b440.3) \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 II - \u0428 \u0434\u044b\u0445\u0430\u043d\u0438\u044f\n\u044d\u0442\u0430\u043f\u043e\u0432\u00bb, \u043f\u0440\u0438\u043a\u0430\u0437\u0430 \u041c\u0417 \u0420\u041a \u041a\u0420 \u0414\u0421\u041c- \u0420\u041f \u2013 \u0441\u0440\u0435\u0434\u043d\u0438\u0439\n9/2020 No98 \u00ab\u041e\u0431 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0438 \u041f\u0440\u0430\u0432\u0438\u043b\n\u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u0428\u0420\u041c 4 (d230.4) \u0420\u0435\u0437\u043a\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438, \u0432 \u0442\u043e\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0441\u0430\u043c\u043e\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438\n\n6\n\n\u0447\u0438\u0441\u043b\u0435 \u0434\u0435\u0442\u0441\u043a\u043e\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u0432\u0441\u0435\u0445 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447: \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435, \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u043d\u0438\u0435,\n\u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438 \u00bb \u043e\u0442 10.02.2020 \u0442\u0443\u0430\u043b\u0435\u0442;\n(b440.4) \u0440\u0435\u0437\u043a\u043e \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439\n\u0434\u044b\u0445\u0430\u043d\u0438\u044f\n\n5. \u042d\u0442\u0430\u043f\u044b \u0438 \u043e\u0431\u044a\u0435\u043c\u044b \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438:\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u0438 \u0444\u043e\u0440\u043c\u044b\n\u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438\n\n\u2022 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f \u0441 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c\n\u0442\u0435\u043b\u0435\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439;\n\u2022 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440 \u0441 \u043a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u044b\u043c \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u043c/ \u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 - \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0430\u0447\u0430\n\u041f\u041c\u0421\u041f \u0437\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u043c, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0448\u0438\u043c \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044e\n\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0430\u0447\u0430/\u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0430\n\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e\n\u041c\u0435\u0442\u043e\u0434\u044b \u043e\u0446\u0435\u043d\u043a\u0438\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438\n2 \u044d\u0442\u0430\u043f 3 \u044d\u0442\u0430\u043f \u0432\u0440\u0430\u0447\u0430/\n(\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u043d\u044b\u0439) (\u043f\u043e\u0437\u0434\u043d\u0438\u0439) \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0430\n\u2713 \u0427\u0414\u0414 \u0432 \u043f\u043e\u043a\u043e\u0435\n\u2713 \u0427\u0414\u0414 \u043f\u0440\u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\n10-14 \u0434\u043d\u0435\u0439. \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\n\u043d\u0435\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u041e\u0431\u0437\u0432\u043e\u043d 1-4 \u0440\u0430\u0437\u0430\n7-14 \u0434\u043d\u0435\u0439 \u0412 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u2713 \u043f\u0443\u043b\u044c\u0441\u043e\u043a\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f\n\u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e\n\u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c (\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438)\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u2713 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438\n\u2713 \u0427\u0414\u0414 \u0432 \u043f\u043e\u043a\u043e\u0435\n\u2713 \u0427\u0414\u0414 \u043f\u0440\u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f 10-14 \u0434\u043d\u0435\u0439. \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\n\u041e\u0431\u0437\u0432\u043e\u043d 4-5 \u0440\u0430\u0437\n\u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0431\u0435\u0437 14-21 \u0434\u0435\u043d\u044c \u0412 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u2713 \u041f\u0443\u043b\u044c\u0441\u043e\u043a\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f\n\u0432 \u043d\u0435\u0434\u0435\u043b\u044e\n\u0418\u0412\u041b \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c (\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438)\n\u2713 \u041f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438\n\u2713 \u0427\u0414\u0414 \u0432 \u043f\u043e\u043a\u043e\u0435\n\u2713 \u0427\u0414\u0414 \u043f\u0440\u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f 14-21 \u0434\u043d\u0435\u0439. \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\n\u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0441 14-28 \u0434\u043d\u0435\u0439 \u0412 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u0415\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u2713 \u043f\u0443\u043b\u044c\u0441\u043e\u043a\u0441\u0438\u043c\u0435\u0442\u0440\u0438\u044f\n\u0418\u0412\u041b \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c (\u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438)\n\u2713 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438\n7\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 - \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0430\u0447\u0430\n\u041f\u041c\u0421\u041f \u0437\u0430 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u043c, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0448\u0438\u043c \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044e \u043f\u0440\u0438 \u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438,\n\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043a\u043e\u0440\u043e\u043d\u0430\u0432\u0438\u0440\u0443\u0441\u043d\u0443\u044e \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044e COVID-19\n\n\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0430\u0447\u0430/\u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0430\n\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\n\u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e\u0433\u043e\n\u041c\u0435\u0442\u043e\u0434\u044b \u043e\u0446\u0435\u043d\u043a\u0438\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438\n2 \u044d\u0442\u0430\u043f 3 \u044d\u0442\u0430\u043f \u0432\u0440\u0430\u0447\u0430/\n(\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u043d\u044b\u0439) (\u043f\u043e\u0437\u0434\u043d\u0438\u0439) \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0430\n\u2713 \u0427\u0414\u0414 \u0432 \u043f\u043e\u043a\u043e\u0435\n\u2713 \u0427\u0414\u0414 \u043f\u0440\u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f\n\u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435\n\u04