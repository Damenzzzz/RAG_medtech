u0435\u0439.\n\u0418\u043b\u0438\n\u0410\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d 250, \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0438\u0437 D\n500 \u043c\u0433 (\u0442\u0430\u0431). \u0440\u0430\u0441\u0447\u0435\u0442\u0430 10 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3\u2013\u0445\n\n\u0434\u043d\u0435\u0439 \u0438\u043b\u0438 \u0432 \u20131\u2013\u0439 \u0434\u0435\u043d\u044c 10\n\u043c\u0433/\u043a\u0433, \u0437\u0430\u0442\u0435\u043c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 4\n\u0434\u043d\u0435\u0439 5 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 1\n\u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013 1 \u0433\n\u0432 1\u2013\u0439 \u0434\u0435\u043d\u044c, \u0437\u0430\u0442\u0435\u043c \u0441\u043e 2\u2013\u0433\u043e \u043f\u043e\n5\u2013\u0439 \u0434\u0435\u043d\u044c 500 \u043c\u0433 1 \u0440\u0430\u0437 \u0432\n\u0441\u0443\u0442\u043a\u0438.\n\u0418\u043b\u0438\n\u041a\u043b\u0430\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u2013 7,5 D\n250; 500 \u043c\u0433 (\u0442\u0430\u0431). \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438. \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013\n500\u20131000 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u041a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430 \u2013 2 \u0440\u0430\u0437\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438. \u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 7 \u2013\n10 \u0434\u043d\u0435\u0439.\n\n\u0418\u043b\u0438\n\u0414\u043e\u043a\u0441\u0438\u0446\u0438\u043a\u043b\u0438\u043d\u0430 \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 D\n\u0433\u0438\u0434\u0440\u043e\u0445\u043b\u043e\u0440\u0438\u0434, 12 \u043b\u0435\u0442 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u043c\u0435\u043d\u0435\u0435\n\u043c\u043e\u043d\u043e\u0433\u0438\u0434\u0440\u0430\u0442 100 \u043c\u0433 50 \u043a\u0433 \u0432 1\u2013\u0439 \u0434\u0435\u043d\u044c \u2013 4 \u043c\u0433/\u043a\u0433\n(\u0442\u0430\u0431). \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438, \u0432\n\u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0434\u043d\u0438 \u2013 2 \u043c\u0433/\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0441\n\u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u0431\u043e\u043b\u0435\u0435 50 \u043a\u0433 \u0438\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0443\u0442\u043a\u0438\n200 \u043c\u0433 \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e, \u0437\u0430\u0442\u0435\u043c\n\u043f\u043e 100 \u043c\u0433 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 10\u201314 \u0434\u043d\u0435\u0439.\n\u0418\u043b\u0438\n\u0426\u0438\u043f\u0440\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 D\n\n250, 500 \u043c\u0433 (\u0442\u0430\u0431). 18 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u043f\u043e 250\u2013\n500 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041a\u0443\u0440\u0441\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 5\u201315 \u0434\u043d\u0435\u0439.\n\u0418\u043b\u0438\n\u041e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d 200 \u043c\u0433 \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 D\n(\u0442\u0430\u0431). 18 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u043f\u043e 200\u2013\n400 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u041a\u0443\u0440\u0441\n\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 7\u201310 \u0434\u043d\u0435\u0439.\n\u0418\u043b\u0438\n\n\u041b\u0435\u0432\u043e\u0444\u043b\u043e\u043a\u0441\u0430\u0446\u0438\u043d \u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 D\n250, 500 \u043c\u0433 (\u0442\u0430\u0431). 18 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u043f\u043e 250\u2013\n500 \u043c\u0433 1\u20132 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u2013 7\u201314 \u0434\u043d\u0435\u0439.\n\n\u0414\u0435\u0437\u0438\u043d\u0442\u043e\u043a\u0441 \u0422\u0438\u043e\u0441\u0443\u043b\u044c\u0444\u0430\u0442\u0430 \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c \u0432 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c D\n\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b \u043d\u0430\u0442\u0440\u0438\u044f, 30%-10,0 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 \u0434\u043d\u0435\u0439. > 40 \u043a\u0433.\n\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043c\u043b (\u0430\u043c\u043f) \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u043f\u0440\u0438\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0438\n\u043d\u0430 \u043a\u043e\u0436\u0435\n(\u043c\u043e\u043a\u043d\u0443\u0442\u0438\u0435,\n\u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u044f).\n\u041d\u0430\u0442\u0440\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434 \u2013 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0441\u043e D\n200, 400 \u043c\u043b \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 40 - 60 \u043a\u0430\u043f\u0435\u043b\u044c \u0432\n\n(\u0444\u043b\u0430\u043a\u043e\u043d\u044b \u0434\u043b\u044f \u043c\u0438\u043d\u0443\u0442\u0443, \u043d\u0430 \u043a\u0443\u0440\u0441 5 - 10\n\u0438\u043d\u0444\u0443\u0437\u0438\u0439) \u0432\u043b\u0438\u0432\u0430\u043d\u0438\u0439\n\u0413\u0438\u043f\u043e\u0441\u0435\u043d\u0441\u0438 \u041a\u0430\u043b\u044c\u0446\u0438\u044f \u0433\u043b\u044e\u043a\u043e\u043d\u0430\u0442, \u0432/\u043c, \u0432/\u0432 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e 1 \u0440\u0430\u0437 \u0432 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c D\n\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u0443\u044e 10%-10,0 \u043c\u043b (\u0430\u043c\u043f) \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 \u0434\u043d\u0435\u0439. > 40 \u043a\u0433.\n\u0449\u0438\u0435 \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u043f\u0440\u0438\n\u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u043c\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0438\n\u043d\u0430 \u043a\u043e\u0436\u0435.\n\u0421\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430 \u041a\u0435\u0442\u043e\u0442\u0438\u0444\u0435\u043d 1 \u043c\u0433 \u041f\u043e 1 \u0442\u0430\u0431. \u2013 1-2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0432 D\n\u0442\u043e\u0440\u044b (\u0442\u0