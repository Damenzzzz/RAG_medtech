5\u0441\u043a\u043e\u0433\u043e \u041d\u0435\u043e\u0442\u043b\u043e\u0436\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u0440\u0438\n\u043a\u0440\u0438\u0437\u0430 \u0433\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043a\u0440\u0438\u0437\u0435.\n\n\u0421\u043e\u0433\u0440\u0435\u0432\u0430\u043d\u0438\u0435 \u0442\u0435\u043b\u0430 (\u0433\u0440\u0435\u043b\u043a\u0438),\n1. \u0412\u044b\u044f\u0441\u043d \u0438\u0442\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0436\u0430\u043b\u043e\u0431: (\u0431\u043b\u0435\u0434\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u0436\u0438, \u0436\u0435\u043b\u0442\u0443\u0445\u0430,\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 2 \u043c\u0433/\u043a\u0433\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e, \u0430\u0434\u0438\u043d\u0430\u043c\u0438\u044f, \u0431\u043e\u043b\u0438 \u0432 \u0436\u0438\u0432\u043e\u0442\u0435,\n\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u0430 (\u043c\u0435\u0442\u0438\u043f\u0440\u0435\u0434\u0430) \u0438 10000 \u0415\u0414\n\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u0440\u0432\u043e\u0442\u0430, \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0446\u0432\u0435\u0442\u0430\n\u0433\u0435\u043f\u0430\u0440\u0438\u043d\u0430 (\u0434\u043b\u044f \u0434\u0435\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u043c\u043e\u0447\u0438);\n2. \u0412\u044b\u044f\u0441\u043d\u0438\u0442\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u044b \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f: \u043c\u0438\u043a\u0440\u043e\u0446\u0438\u0440\u043a\u0443\u043b\u044f\u0446\u0438\u0438 \u0438 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f\n(\u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0438\u0432\u0438\u0432\u043a\u0438, \u043f\u0440\u0438\u0435\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u0439), \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u0430\u044f\n\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0432 \u0438 \u0434\u0440. \u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f, \u043e\u0431\u0435\u0437 \u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430,\n3. \u041f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0435 \u0430\u043d\u0430\u043c\u043d\u0435\u0437 \u0436\u0438\u0437\u043d\u0438 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 - \u043f\u0440\u0438\n\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043a\u0438\u0441\u043b\u043e\u0440\u043e\u0434\u0430.\n\u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u043d\u0430\u044f\n\u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u043d\u0430\u043b\u0438\u0447\u0438\u044e \u0433\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0430\u043d\u0435\u043c\u0438\u0438, \u0416\u041a\u0411\n4. \u0412\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u044b\u0435 (\u043e\u0441\u043c\u043e\u0442\u0440): \u041e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0431\u0449\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\n\u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e;\n5. \u041e\u0441\u043c\u043e\u0442\u0440 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e\n6. \u041e\u0446\u0435\u043d\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432: \u041e\u0431\u0449\u0438\u0439\n\u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432,\n\u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u041e\u0410\u041c, \u0411/\u0445 \u043a\u0440\u043e\u0432\u0438, \u043f\u0440\u043e\u0431\u0430 \u041a\u0443\u043c\u0431\u0441\u0430;\n\n\u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 6\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0439 \u0433\u0440\u0430\u0444\u0438\u043a \u0432\u0430\u043a\u0446\u0438\u043d\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0435\u0442\u0435\u0439 \u0441 \u0421\u041a\u0411\n(\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0412, \u0421)\n\n31\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438, \u0441\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u0430, \u043a\u043e\u043a\u043b\u044e\u0448\u0430, 3 \u043c\u0435\u0441.\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0438\u043f \u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 +\n\u043a\u043e\u043d\u044c\u044e\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 13 \u0441\u0435\u0440\u043e\u0442\u0438\u043f\u043e\u0432\n\u043f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u0430\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438, \u0441\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u0430, \u043a\u043e\u043a\u043b\u044e\u0448\u0430, 4 \u043c\u0435\u0441.\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0438\u043f \u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 +\n\u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u043c\u0435\u043d\u0438\u043d\u0433\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0442\u0438\u043f \u0421\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438, \u0441\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u0430, \u043a\u043e\u043a\u043b\u044e\u0448\u0430, 5 \u043c\u0435\u0441.\n\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0438\u043f \u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 +\n\u043a\u043e\u043d\u044c\u044e\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 13 \u0441\u0435\u0440\u043e\u0442\u0438\u043f\u043e\u0432\n\u043f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u0430 + \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u043c\u0435\u043d\u0438\u043d\u0433\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u043e\u0439\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0442\u0438\u043f \u0421\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412* + \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 12 \u043c\u0435\u0441.\n\u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0438\u043f \u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 + \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\n\u043c\u0435\u043d\u0438\u043d\u0433\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0442\u0438\u043f \u0421\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u043a\u043e\u0440\u0438, \u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438 \u0438 \u043f\u0430\u0440\u043e\u0442\u0438\u0442\u0430 + 13 \u043c\u0435\u0441.\n\n\u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412* + \u043a\u043e\u043d\u044c\u044e\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 13 \u0441\u0435\u0440\u043e\u0442\u0438\u043f\u043e\u0432 \u043f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u0430\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438, \u0441\u0442\u043e\u043b\u0431\u043d\u044f\u043a\u0430, \u043a\u043e\u043a\u043b\u044e\u0448\u0430, 18 \u043c\u0435\u0441.\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430, \u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0438\u043f \u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 +\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 \u0412*\n\u041