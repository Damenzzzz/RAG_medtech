38 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\nV \u0420\u0435\u0437\u043a\u043e\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u0442\u043e\u043b\u0449\u0438\u043d\u0430 \u0435\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 1,15 \u043c\u043c,\n\n\u043a\u043b\u0435\u0442\u043a\u0438 \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u044f \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0435, \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f\n\u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430\n\n\u041a\u043b\u0438\u043d\u0438\u043a\u043e-\u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u042d\u042d\u0414 \u043f\u043e \u0422.\u0423.\u0413\u043e\u0440\u0433\u0438\u043b\u0430\u0434\u0437\u0435 \u0441 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u0430\u043c\u0438 [4,5]\n\n\u0421\u0442\u0430- \u0416\u0430\u043b\u043e\u0431\u044b \u041e\u0441\u0442\u0440\u043e\u0442\u0430 \u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u041e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u041c\u0435\u0442\u043e\u0434\u044b\n\u0434\u0438\u044f \u0437\u0440\u0435\u043d\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u0440\u0430\u0434\u0443\u0436\u043d\u043e\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u043e\u0433\n\u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u043e \u043b\u0435\u0447\u0435\u043d\u0438\u044f\nI \u041d\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u041d\u0435 \u041d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u041d\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0430 \u041d\u0435\u0442 \u041a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u0430\n\u0435\u043d\u043d\u044b\u0435 \u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u043d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d \u0430 \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u044f, \u041b\u0430\u0437\u0435\u0440\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u043d\u044b\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u041a\u0440\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0435\n\u0441\u043a\u043b\u0430\u0434\u043a\u0438 \u0414\u041c\nII \u041d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d \u041c\u0435\u043d\u044f\u0435\u0442 \u0421\u0442\u043e\u0439\u043a\u0438\u0439 \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u042f\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u0440\u0438\u0442\u0430, \u041c\u044f\u0433\u043a\u0438\u0435\n\u043d\u043e\u0435 \u0441\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u043e\u0442\u0435\u0447\u043d\u0430 \u043f\u0438\u0433\u043c\u0435\u043d\u0442 \u043d\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u044b\u0435\n\u0447\u0443\u0432\u0441\u0442\u0432\u043e \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u044f \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u043b\u0438\u043d\u0437\u044b,\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433 \u0444\u043e\u043d\u0435 \u0435\u0433\u043e \u043a\u0430\u043f\u0441\u0443\u043b\u0435 \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u0430\u044f\n\u043e \u0442\u0435\u043b\u0430, \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u043e\u0439 \u0445\u0440\u0443\u0441\u0442\u0430\u043b\u0438\u043a\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435 \u0437\u0430\u043f\u043e\u0442\u0435\u043b\u043e\u0441\u0442\u0438 \u0438 \u043b\u0430\u0437\u0435\u0440\u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u0441\u043a\u043e\u0435 \u0440\u0430\u0441\u043f\u044b\u043b\u0435\u043d\u0438\u044f \u043a\u0440\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u043f\u043e\u043a\u0440\u0430\u0441\u043d\u0435\u043d \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430, \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0438\u0435 \u0441\u043a\u043b\u0430\u0434\u043a\u0438 \u0414\u041c, \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a (\u0441\u0438\u043d\u0435\u0445\u0438\u043e\u0442\u043e\u043c\u0438\u044f,\n\u0437\u0430\u0434\u043d\u0438\u0445 \u0441\u043b\u043e\u0435\u0432 \u043a\u0435\u0440\u0430\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430\n\u0441\u0442\u0440\u043e\u043c\u044b, )\n\u043d\u0435\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0435\u043a\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f\nIII \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b \u0421\u043d\u0438\u0436\u0435\u043d \u0414\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u041e\u0442\u0435\u0447\u043d\u0430, \u0418\u0440\u0438\u0434\u043e\u0446\u0438\u043a\u043b\u0438\u0442 \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\n\u0435 \u0430 \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u044f, \u0440\u0438\u0433\u0438\u0434\u043d\u0430, \u0430\n\u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435\n\u0438\u0435, \u043d\u0435\u043c \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430, \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\n\u0441\u0432\u0435\u0442\u043e\u0431\u043e\u044f\u0437\u043d \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u043d\u043d\u044b\u0435 \u0441\u043e\u0441\u0443\u0434\u044b,\n\u044c, \u0441\u043a\u043b\u0430\u0434\u0447\u0430\u0442\u043e\u0441\u0442\u044c \u0437\u0430\u0434\u043d\u0438\u0435\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438 \u0414\u041c, \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u0441\u0438\u043d\u0435\u0445\u0438\u0438\n\u0435, \u0431\u043e\u043b\u0438, \u043e\u0442\u0435\u043a \u0441\u0442\u0440\u043e\u043c\u044b,\n\u0447\u0430\u0449\u0435 \u0441\u0442\u043e\u0439\u043a\u0438\u0439\n\u043a\u043e\u043b\u044e\u0449\u0438\u0435 \u0431\u0443\u043b\u043b\u0435\u0437\u043d\u044b\u0439 \u043e\u0442\u0435\u043a\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f\nIV \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d \u0420\u0435\u0437\u043a\u043e \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u041e\u0442\u0435\u0447\u043d\u0430, \u0412\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\n\u044b\u0435 \u0441\u043d\u0438\u0436\u0435\u043d \u043e\u0442\u0435\u043a \u0432\u0441\u0435\u0445 \u0441\u043b\u043e\u0435\u0432, \u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430 \u0438\u0440\u0438\u0434\u043e\u0446\u0438\u043a\u043b\u0438\u0442, \u0430\n\u0441\u0432\u0435\u0442\u043e\u0431\u043e\u044f\u0437\u043d \u0430 \u043d\u0430 \u044d\u043d\u0434\u043e\u0442\u0435\u043b\u0438\u0438 \u043d\u043d\u044b\u0435 \u0441\u043e\u0441\u0443\u0434\u044b, \u043f\u043e\u043c\u0443\u0442\u043d\u0435\u043d\u0438\u0435 \u0411\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u044c, \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u043d\u0438\u0435 \u0445\u0440\u0443\u0441\u0442\u0430\u043b\u0438\u043a\u0430, \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435\n\u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430, \u0441\u0438\u043d\u0435\u0445\u0438\u0438, \u0440\u0435\u0442\u0440\u043e\u043a\u043e\u0440\u043d\u0435\u0430\u043b\u044c-\n\u0438\u0435, \u044d\u043a\u0441\u0441\u0443\u0434\u0430\u0442\u0430, \u0437\u0440\u0430\u0447\u043a\u043e\u0432\u0430\u044f \u043d\u0430\u044f \u043f\u043b\u0435\u043d\u043a\u0430\n\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u044d\u043a\u0441\u0441\u0443\u0434\u0430\u0442\u0438\u0432\u043d\u0430\n\u0435 \u0438 \u0431\u043e\u043b\u044c \u0432 \u0441\u043a\u043b\u0430\u0434\u0447\u0430\u0442\u043e\u0441\u0442\u044c \u044f \u043f\u043b\u0435\u043d\u043a\u0430\n\u0433\u043b\u0430\u0437\u0443, \u0414\u041c \u0438 \u043e\u0442\u0435\u043a\n\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043c\u044b,\n\u0431\u043e\u043b\u044c \u0431\u0443\u043b\u043b\u0435\u0437\u043d\u044b\u0439 \u043e\u0442\u0435\u043a\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f \u0441\n\u044d\u0440\u043e\u0437\u0438\u044f\u043c\u0438,\n\u043e\u0447\u0430\u0433\u043e\u0432\u043e\u0439\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0435\u0439,\n\n\u0438\u0437\u044a\u044f\u0437\u0432\u043b\u0435\u043d\u0438\u0435\u043c,\n\u0432\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435\u043c\n\u0441\u043e\u0441\u0443\u0434\u043e\u0432\nV \u0420\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d \u0421\u043d\u0438\u0436\u0435\u043d \u0421\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e\u0435 \u0421\u0443\u0431- \u0438\u043b\u0438 \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u0430\u044f \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\n\u0438\u0435 \u0430 \u0434\u043e \u043f\u043e\u043c\u0443\u0442\u043d\u0435\u043d\u0438\u0435 \u0430\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u0430, \u0433\u043b\u0430\u0443\u043a\u043e\u043c\u0430 \u0430\n\u0433\u043b\u0430\u0437\u043d\u043e\u0433\u043e \u0441\u0432\u0435\u0442\u043e\u043e \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u0437\u0430\u0434\u043d\u0438\u0435 \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\n\u044f\u0431\u043b\u043e\u043a\u0430, \u0449\u0443- \u043d\u0435\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0439 \u0441\u0438\u043d\u0435\u0445\u0438\u0438, \u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430 \u0449\u0435\u043d\u0438\u044f \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u2013 \u0437\u0430\u0440\u0430\u0449\u0435\u043d\u0438\u0435\n\u044f \u0431\u043e\u043b\u044c \u0432 \u0437\u0430\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 \u0437\u0440\u0430\u0447\u043a\u0430,\n\u0433\u043b\u0430\u0437\u0443, \u0441\u043b\u043e\u0435\u0432 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u043e\u0431\u043b\u0438\u0442\u0435\u0440\u0430\u0446\u0438\u044f\n\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0440\u0443\u0431\u0446\u043e\u0432\u043e\u0439 \u0443\u0433\u043b\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439\n\u0431\u043e\u043b\u044c \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e\u0439 \u043a\u0430\u043c\u0435\u0440\u044b\n\u0442\u043a\u0430\u043d\u044c\u044e \u0441\n\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u043c\u0438\n\u0438\u0437\u044a\u044f\u0437\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438\n\n\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u0430 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u0439\n\u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b (International Committee for Classification of Corneal Dystrophies \u2013 IC3D)\n[11] \u043f\u043e \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0438 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0443\u0440\u043e\u0432\u043d\u044e \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430:\n\u2022 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f 1: \u0447\u0435\u0442\u043a\u0430\u044f \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0433\u0435\u043d \u0431\u044b\u043b \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0438\n\n\u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d. \u041c\u0443\u0442\u0430\u0446\u0438\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b;\n\u2022 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f 2: \u0447\u0435\u0442\u043a\u0430\u044f \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0431\u044b\u043b\u0430 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0441 1 \u0438\u043b\u0438\n\u0431\u043e\u043b\u0435\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u043c\u0438 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u043d\u044b\u043c\u0438 \u043b\u043e\u043a\u0443\u0441\u0430\u043c\u0438, \u043d\u043e \u0433\u0435\u043d(\u044b) \u0435\u0449\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442\n\n\u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c;\n\u2022 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f 3: \u0447\u0435\u0442\u043a\u0430\u044f \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0435\u0449\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e\n\u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0441 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u043d\u044b\u043c \u043b\u043e\u043a\u0443\u0441\u043e\u043c;\n\u2022 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f 4: \u044d\u0442\u0430 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442 \u043d\u043e\u0432\u044b\u0439 \u0438\u043b\u0438 \u0440\u0430\u043d\u0435\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439\n\n\u0442\u0438\u043f \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b, \u043f\u0440\u0438 \u043d\u0435 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430\u0445.\n\n2. \u041c\u0415\u0422\u041e\u0414\u042b, \u041f\u041e\u0414\u0425\u041e\u0414\u042b \u0418 \u041f\u0420\u041e\u0426\u0415\u0414\u0423\u0420\u042b \u0414\u0418\u0410\u0413\u041d\u041e\u0421\u0422\u0418\u041a\u0418:\n\u0416\u0430\u043b\u043e\u0431\u044b:\n\n\u2022 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435/\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0437\u0440\u0435\u043d\u0438\u044f;\n\u2022 \u0431\u043e\u043b\u044c;\n\u2022 \u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435;\n\n\u2022 \u0441\u0432\u0435\u0442\u043e\u0431\u043e\u044f\u0437\u043d\u044c;\n\u2022 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430, \u00ab\u043f\u0435\u0441\u043a\u0430\u00bb \u043f\u043e\u0434 \u0432\u0435\u043a\u0430\u043c\u0438.\n\u0410\u043d\u0430