u0441\u0442\u0435\u0439\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 \u0441\u0435\u043a. 1 - \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u043e\u0441\u044f\u0442 \u043f\u043e\u0434\u043d\u044f\u0442\u044c \u0438 \u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0440\u0443\u043a\u0438 \u043d\u0430 45\n\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043c\u0435\u043d\u0435\u0435 10 \u0441\u0435\u043a.\n\u0433\u0440\u0430\u0434\u0443\u0441\u043e\u0432 \u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043b\u0435\u0436\u0430 \u0438\u043b\u0438 \u043d\u0430 90 \u0433\u0440\u0430\u0434\u0443\u0441\u043e\u0432 \u0432\n2 - \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043d\u0435 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0438\u043b\u0438 \u043d\u0435\n\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0441\u0438\u0434\u044f. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435, \u0435\u0441\u043b\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u043d\u0435\n\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442 \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u043e \u043f\u0440\u043e\n\u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u044b - \u0432\u0440\u0430\u0447 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\n\u0438\u0437\u0432\u043e\u0434\u044f\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043b\u0435 \u0442\u044f\u0436\u0435\u0441\u0442\u0438.\n\u043f\u043e\u043c\u0435\u0449\u0430\u0435\u0442 \u0440\u0443\u043a\u0443 \u0432 \u043d\u0443\u0436\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u0414\u0430\u043d\u043d\u044b\u043c\n3 - \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0434\u0430\u044e\u0442 \u0431\u0435\u0437 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f\n\u0442\u0435\u0441\u0442\u043e\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0441\u0438\u043b\u0430. \u0411\u0430\u043b\u043b\u044b\n\u0441\u0438\u043b\u0435 \u0442\u044f\u0436\u0435\u0441\u0442\u0438. 4- \u043d\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439.\n\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0440\u0443\u043a\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\n5 - \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c (\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\n\u0430\u043c\u043f\u0443\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430, \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0443\u0441\u0442\u0430\u0432)\n0 - \u043d\u043e\u0433\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u0441\u0435\u043a.\n1 - \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043c\u0435\u043d\u0435\u0435 5 \u0441\u0435\u043a.\n2- \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043d\u0435 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0438\u043b\u0438 \u043d\u0435\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043d\u0438\u0436\u043d\u0438\u0445 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439\n\u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442 \u043f\u043e\u0434\u043d\u044f\u0442\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u043e\n\u041f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442 \u043f\u0430\u0440\u0435\u0442\u0438\u0447\u043d\u0443\u044e \u043d\u043e\u0433\u0443 \u0432 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043b\u0435\u0436\u0430 \u043d\u0430\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u044f\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043b\u0435 \u0442\u044f\u0436\u0435\u0441\u0442\u0438.\n30 \u0433\u0440\u0430\u0434\u0443\u0441\u043e\u0432 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e - 5 \u0441\u0435\u043a\u0443\u043d\u0434.\n3 - \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u0430\u0434\u0430\u044e\u0442 \u0431\u0435\u0437 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u044f\n\u0411\u0430\u043b\u043b\u044b \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u043d\u043e\u0433\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\n\u0441\u0438\u043b\u0435 \u0442\u044f\u0436\u0435\u0441\u0442\u0438. 4- \u043d\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439.\n5 - \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c (\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044c\n\u0430\u043c\u043f\u0443\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430, \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0443\u0441\u0442\u0430\u0432).\n\u041e\u0446\u0435\u043d\u043a\u0430 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439\n\u0414\u0430\u043d\u043d\u044b\u0439 \u0442\u0435\u0441\u0442 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442 \u0430\u0442\u0430\u043a\u0441\u0438\u044e, \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044e\n0 - \u0410\u0442\u0430\u043a\u0441\u0438\u0438 \u043d\u0435\u0442.\n\u043c\u043e\u0437\u0436\u0435\u0447\u043a\u0430.\n1 - \u0410\u0442\u0430\u043a\u0441\u0438\u044f \u0432 \u043e\u0434\u043d\u043e\u0439\n\u041f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u043f\u0430\u043b\u044c\u0446\u0435-\u043d\u043e\u0441\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0431\u0430 \u0438 \u043f\u044f\u0442\u043e\u0447\u043d\u043e-\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438. 2 -\n\u043a\u043e\u043b\u0435\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u0430. \u041e\u0446\u0435\u043d\u043a\u0430 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0438\u0438\n\u0410\u0442\u0430\u043a\u0441\u0438\u044f \u0432 \u0434\u0432\u0443\u0445\n\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0441 \u0434\u0432\u0443\u0445 \u0441\u0442\u043e\u0440\u043e\u043d.\n\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u044f\u0445.\nUN - \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e (\u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f\n\u043f\u0440\u0438\u0447\u0438\u043d\u0430)\n\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 0 - \u043d\u043e\u0440\u043c\u0430.\n\u0438\u0441\u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0438\u0433\u043e\u043b\u043a\u0438, \u0432\u0430\u043b\u0438\u043a\u0430 \u0434\u043b\u044f 1 - \u043b\u0435\u0433\u043a\u0438\u0435 \u0438\u043b\u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 2 - \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0438\u043b\u0438 \u043f\u043e\u043b\u043d\u043e\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n0 = \u041d\u043e\u0440\u043c\u0430.\n\u0412\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0440\u0435\u0447\u0438 1 = \u041b\u0435\u0433\u043a\u0430\u044f \u0438\u043b\u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0434\u0438\u0437\u0430\u0440\u0442\u0440\u0438\u044f; \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u043e\u0441\u044f\u0442 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u0434\u043f\u0438\u0441\u0438 \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430\u0445 \u0437\u0432\u0443\u043a\u0438 \u0441\u043c\u0430\u0437\u0430\u043d\u044b, \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0441\u043b\u043e\u0432 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442\n\u0434\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0440\u0435\u0447\u0438 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0435\u043d\u0438\u044f.\n2 = \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0434\u0438\u0437\u0430\u0440\u0442\u0440\u0438\u044f; \u0440\u0435\u0447\u044c \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u0442\u0440\u