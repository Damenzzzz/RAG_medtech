e\u0437 - \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u0440\u0438\u043c\u0435\u0442\u043e\u043f\u0440\u0438\u043c-\u0441\u0443\u043b\u044c\u0444\u043e\u043c\u0435\u0442\u043e\u043a\u0441\u0430\u0437\u043e\u043b\u0430\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442 \u043f\u0438\u0440\u0438\u043c\u0435\u0442\u0430\u043c\u0438\u043d+\u0441\u0443\u043b\u044c\u0444\u0430\u0434\u043e\u043a\u0441\u0438\u043d 1 \u0442\u0430\u0431\u043b. (525 \u043c\u0433) \u043d\u0430 20 \u043a\u0433 \u0432\u0435\u0441\u0430 1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e. \u041d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u0442\u043e\u043a\u0441\u043e\u043f\u043b\u0430\u0437\u043c\u0435\u043d\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0438\u043b\u0438 \u043f\u0440\u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043e\u0442 IgM-\n\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0434\u043e\u043d\u043e\u0440\u0430. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u0435\u043d\n\u0442\u0440\u0438\u043c\u0435\u0442\u043e\u043f\u0440\u0438\u043c/\u0441\u0443\u043b\u044c\u0444\u0430\u043c\u0435\u0442\u043e\u043a\u0441\u0430\u0437\u043e\u043b\u0443.\n\u041f\u0435\u043d\u0442\u0430\u043c\u0438\u0434\u0438\u043d \u0438\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u044f \u0441\u0442\u0430\u0440\u0442 \u0434\u0435\u043d\u044c -8.\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 \u043f\