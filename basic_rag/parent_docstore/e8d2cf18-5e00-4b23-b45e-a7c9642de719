3e\u043d\u0445\u0438\u0442), \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u043c\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u0448\u0435\u043b\u044c. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e\n\u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0411\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e\u0433\u043e\n\n\u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u043e \u043a\u0430\u0448\u043b\u044e, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\u043c\u0435\u0434\u0438\u0446\u0438\u043d\u044b.\n\n3\n\n2.2 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0434\u043b\u044f \u0431\u0440\u043e\u043d\u0445\u0438\u0442\u0430 \u0441 \u0437\u0430\u0442\u044f\u0436\u043d\u044b\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0435\u043c: (\u0441\u0445\u0435\u043c\u0430)\n[5]:\n\n4\n\n5\n\n2.3 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u041c\u0443\u043a\u043e\u0432\u0438\u0441\u0446\u0438\u0434\u043e\u0437 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c - \u0425\u043b\u043e\u0440\u0438\u0434\u044b \u0432 - \u0417\u0430\u0442\u044f\u0436\u043d\u0430\u044f \u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u0430\u044f\n\u043f\u043e\u0442\u043e\u0432\u043e\u0439 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0436\u0435\u043b\u0442\u0443\u0445\u0430\n- \u041a\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 - \u0421\u043e\u043b\u0435\u043d\u044b\u0439 \u0432\u043a\u0443\u0441 \u043a\u043e\u0436\u0438\n- \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 - \u041e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0432\n\u0430\u043d\u0430\u043b\u0438\u0437 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438.\n-\u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0438\u043b\u0438\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n- \u041d\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044b\u0439,\n\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439, \u043c\u0430\u0441\u043b\u044f\u043d\u0438\u0441\u0442\u044b\u0439\n\u0438 \u0437\u043b\u043e\u0432\u043e\u043d\u043d\u044b\u0439 \u0441\u0442\u0443\u043b\n-\u041f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438\n\u0445\u043b\u043e\u0440\u0438\u0434\u043e\u0432 \u0432 \u043f\u043e\u0442\u043e\u0432\u043e\u0439\n\n\u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438.\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 -\u0426\u0438\u043b\u0438\u0430\u0440\u043d\u0430\u044f -\u0414\u0435\u043a\u0441\u0442\u0440\u0430\u043a\u0430\u0440\u0434\u0438\u044f\n\u0446\u0438\u043b\u0438\u0430\u0440\u043d\u0430\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0438\u043e\u043f\u0441\u0438\u044f -\u041e\u0442\u0438\u0442\u044b\n\u0434\u0438\u0441\u043a\u0435\u043d\u0435\u0437\u0438\u044f \u043a\u0430\u0448\u0435\u043b\u044c (\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f -\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435\n\u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f) \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n-\u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u0430\u043d\u0430\u043b\u0438\u0437\n\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c - \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u041c\u0430\u043d\u0442\u0443 -\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f\n(> 30 \u0434\u043d\u0435\u0439); - \u0414\u0438\u0430\u0441\u043a\u0438\u043d\u0442\u0435\u0441\u0442 \u041c\u0430\u043d\u0442\u0443;\n\n-\u041f\u043b\u043e\u0445\u043e\u0435 -\u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0441\u043a\u043e\u043f\u0438\u044f - \u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435/\u043e\u0442\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0432 \u043c\u043e\u043a\u0440\u043e\u0442\u044b \u043d\u0430 \u041c\u0411\u0422 \u0438 \u0434\u0438\u0430\u0441\u043a\u0438\u043d\u0442\u0435\u0441\u0442\n\u0432\u0435\u0441\u0435 \u0438\u043b\u0438 \u043f\u043e\u0442\u0435\u0440\u044f \u0432\u0435\u0441\u0430; \u043c\u0435\u0442\u043e\u0434\u043e\u043c Gextert -\u041f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0438\u043a\u043e-\n-\u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u043f\u0440\u0438\n\u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438 \u043c\u043e\u043a\u0440\u043e\u0442\u044b \u0443\n\u0434\u0435\u0442\u0435\u0439.\n\n\u0412\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0430\u0448\u0435\u043b\u044c -\u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 -\u0421\u0442\u0435\u043d\u043e\u0437 \u0442\u0440\u0430\u0445\u0435\u0438 \u0438\u043b\u0438 \u0431\u0440\u043e\u043d\u0445\u0430\n\u043f\u043e\u0440\u043e\u043a\u0438 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 -\u043f\u043e\u0434\u0430\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0441\u0442\u0435\u043d\u043a\u0438\n\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e -\u0411\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0442\u0440\u0430\u0445\u0435\u0438 \u0438\u043b\u0438 \u0431\u0440\u043e\u043d\u0445\u0430\n\u0434\u0435\u0440\u0435\u0432\u0430 -\u0434\u043e\u0431\u0430\u0432\u043e\u0447\u043d\u044b\u0439 \u0442\u0440\u0430\u0445\u0435\u0430\u043b\u044c\u043d\u044b\u0439\n(\u0442\u0440\u0430\u0445\u0435\u043e\u043c\u0430\u043b\u044f\u0446\u0438\u044f; \u0431\u0440\u043e\u043d\u0445\n\u0442\u0440\u0430\u0445\u0435\u043e-\n\u0431\u0440\u043e\u043d\u0445\u043e\u043c\u0430\u043b\u044f\u0446\u0438\u044f )\n\n\u0418\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0442\u0435\u043b\u043e \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u0448\u0435\u043b\u044c; -\u0411\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f; - \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e\n\u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0435 -\u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434- \u0442\u0435\u043b\u0430 \u0432 \u0431\u0440\u043e\u043d\u0445\u0430\u0445;\n\u043f\u0443\u0442\u0435\u0439 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f \u043d\u0438\u0436\u043d\u0438\u0445 \u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 -\u0430\u0442\u0435\u043b\u0435\u043a\u0442\u0430\u0437 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439\n\u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0443\u0442\u0435\u0439. \u0442\u043a\u0430\u043d\u0438;\n- \u044d\u043d\u0434\u043e\u0431\u0440\u043e\u043d\u0445\u0438\u0442\n\n6\n\n7\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u043d\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u043e\u0434\u044a\u0435\u043c\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b - \u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c;\n\u2022 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u0430\u044f \u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f (\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0435 \u0442\u0435\u043f\u043b\u043e\u0435 \u043f\u0438\u0442\u044c\u0435);\n\u2022 \u043f\u043e\u043e\u0449\u0440\u0435\u043d\u0438\u0435 \u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0432\u0441\u043a\u0430\u0440\u043c\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u0438 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443;\n\n\u2022 \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0441\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u043e-\u0433\u0438\u0433\u0438\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 (\u043f\u0440\u043e\u0432\u0435\u0442\u0440\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0439,\n\u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0430 \u0441 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u043c\u0438).\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u041e\u041e\u0411:\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0421\u0430\u043b\u044c\u0431\u0443\u0442\u0430\u043c\u043e\u043b, \u0412\u043d\u0443\u0442\u0440\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\n\u0431\u0440\u043e\u043d\u0445\u043e\u0434\u0438\u043b\u044f\u0442\u0430\u0442\u043e\u0440 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0431\u0440\u043e\u043d\u0445\u043e\u0440\u0430\u0441\u0448\u0438\u0440\u044f\u044e\u0449\u0435\u0433\u043e\n\u0430\u044d\u0440\u043e\u0437\u043e\u043b\u044c 100 \u043c\u043a\u0433 \u0438\u043b\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 - \u043f\u043e 2-4 \u043c\u0433 3-4\n\u0438\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u0438 \u0432 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442, \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u043e\u0439 \u0434\u043e\u0437\u0435 \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0430\n\u0434\u043e 8 \u043c\u0433 4 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442. \u0414\u0435\u0442\u044f\u043c \u0432\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 6-12 \u043b\u0435\u0442 - \u043f\u043e 2 \u043c\u0433 3-\n4 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442; \u0434\u0435\u0442\u044f\u043c 2-6 \u043b\u0435\u0442 - 1-2\n\u043c\u0433 3 \u0440\u0430\u0437\u0430/\u0441\u0443\u0442.\n\u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0418\u043f\u0440\u0430\u0442\u0440\u043e\u043f\u0438\u044f \u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0439\n\u0431\u0440\u043e\u043d\u0445\u043e\u0434\u0438\u043b\u044f\u0442\u0430\u0442\u043e\u0440 \u0431\u0440\u043e\u043c\u0438\u0434/\u0444\u0435\u043d\u043e\u0442\u0435\u0440\u043e\u043b \u043f\u043e \u0431\u0440\u043e\u043d\u0445\u043e\u0434\u0438\u043b\u044f\u0442\u0430\u0442\u043e\u0440\n20 \u043c\u043b 4 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432\n\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u043e\u0439 \u0434\u043e\u0437\u0435;\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100%\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u0410\u043d\u0442\u0438\u043f\u0438\u0440\u0435\u0442\u0438\u043a \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b\n\u0420\u0430\u0437\u043e\u0432\u044b\u0435 \u0434\u043e\u0437\u044b \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430\n\n\u0432\u043d\u0443\u0442\u0440\u044c \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 10-15 \u043c\u0433/\u043a\u0433.\n\u0421\u0440\u0435\u0434\u043d\u044f\u044f \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438\n\u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 10-12 \u043c\u0433/\u043a\u0433\n\n\u2022 \u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0411\u0411 [3,4]:\n8\n\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u0417\u0430\u