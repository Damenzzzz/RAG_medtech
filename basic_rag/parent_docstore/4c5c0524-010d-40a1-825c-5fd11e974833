7\u0438\u043e\u043b\u043e\u0433 o\n\u041a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u0435\u0439 \u0438 \u0435\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u043c\no\n\u041f\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u0443 \u0432 \u043b\u0438\u0442\u043e\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e o\n\u0421\u043e\u0433\u043d\u0443\u0442\u044c \u043e\u0431\u0430 \u0431\u0435\u0434\u0440\u0430, \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u043b\u0435\u043d\u0438 \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u043b\u0438\u0436\u0435 \u043a \u0433\u0440\u0443\u0434\u0438 o\n2. \u041f\u0440\u0438\u0435\u043c \u041c\u0430\u043a-\u0420\u043e\u0431\u0435\u0440\u0442\u0430\n\u0410\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u043d\u0430\u0434\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043d\u0430 \u0441\u043e\u0433\u043d\u0443\u0442\u044b\u0435 \u043a\u043e\u043b\u0435\u043d\u0438, \u043f\u0440\u0438\u0436\u0438\u043c\u0430\u044f \u0438\u0445 o\n\u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043a \u0433\u0440\u0443\u0434\u0438\n\u041f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043b\u0435\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u044f\u0441\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043f\u0440\u0438\u0435\u043c\n\u0412\u0441\u0442\u0430\u0442\u044c \u0441\u0431\u043e\u043a\u0443 \u0440\u043e\u0436\u0435\u043d\u0438\u0446\u044b \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0441\u043f\u0438\u043d\u043a\u0438 \u043f\u043b\u043e\u0434\u0430 \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c o\n\u0440\u0443\u043a\u0438 \u043d\u0430\u0434 \u043b\u043e\u0431\u043a\u043e\u043c, \u043a\u0430\u043a \u043f\u0440\u0438 \u0421\u041b\u0420\n3. \u041d\u0430\u0434\u043b\u043e\u0431\u043a\u043e\u0432\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u041f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0435 \u0438\u043b\u0438 \u00ab\u0442\u043e\u043b\u0447\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435\u00bb \u043d\u0430\u0434\u0430\u0432\u043b\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 o\n\u043a\u043e\u0441\u043e-\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u043e\u0442 \u0441\u043f\u0438\u043d\u043a\u0438 \u043a \u0433\u0440\u0443\u0434\u0438\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0440\u0438\u0435\u043c \u041c\u0430\u043a-\u0420\u043e\u0431\u0435\u0440\u0442\u0430 o\n\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u044d\u043f\u0438\u0437\u0438\u043e\u0442\u043e\u043c\u0438\u0438 (\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c o\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0432 \u044d\u043f\u0438\u0437\u0438\u043e\u0442\u043e\u043c\u0438\u0438)\n4. \u042d\u043f\u0438\u0437\u0438\u043e\u0442\u043e\u043c\u0438\u044f \u041f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u043f\u043e\u043b\u044f \u0438 o\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u044e\n\u041f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u044d\u043f\u0438\u0437\u0438\u043e\u0442\u043e\