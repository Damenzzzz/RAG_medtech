u043e\u0442\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f.\n\n\u0412 2014 \u0433\u043e\u0434\u0443 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0430. [174]\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0420\u0422\u041f\u0425, \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043e\u0440\u0433\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f (NIH Consensus Conference,\n2014)\n\n\u0421\u0438\u043c\u043f\u043e\u0442\u043e\u043c\u044b \u0411\u0430\u043b\u043b\u044b\n0 1 2 3\n\u041e\u0431\u0449\u0435\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 0 \u0431\u0430\u043b\u043b\u043e\u0432 1 \u0431\u0430\u043b\u043b 2 \u0431\u0430\u043b\u043b\u0430 3-4 \u0431\u0430\u043b\u043b\u0430\n\n\u043f\u043e ECOG", "type": "Document"}}