\u0441\u043a\u0430 (at risk)\n\u043a\u043b\u0430\u043f\u0430\u043d\u043d\u043e\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0441\u0435\u0440\u0434\u0446\u0430\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u043c \u043a\u043b\u0430\u043f\u0430\u043d\u043d\u044b\u043c \u043f\u043e\u0440\u043e\u043a\u043e\u043c\n\u0424\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e\u0441\u044f \u043f\u043e\u0440\u043e\u043a\u0430\nB \u0441\u0435\u0440\u0434\u0446\u0430 \u043b\u0451\u0433\u043a\u043e\u0439-\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u0438;\n(progressive)\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\u0422\u044f\u0436\u0451\u043b\u043e\u0433\u043e \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0433\u043e \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e (\u0442\u044f\u0436\u0451\u043b\u043e\u0433\u043e) \u043f\u043e\u0440\u043e\u043a\u0430 \u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0441\u0435\u0440\u0434\u0446\u0430,\nC\n\u043f\u043e\u0440\u043e\u043a\u0430 (asymptomatic severe) \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u044e\u0449\u0435\u0433\u043e \u0431\u0435\u0437 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439:\n\u041f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u043d\u043e\u043c (compensated) \u041b\u0416 \u0438 \u041f\u0416 (\u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0435\n\u04211\n\u0440\u0435\u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435)\n\n\u0421 \u0440\u0430