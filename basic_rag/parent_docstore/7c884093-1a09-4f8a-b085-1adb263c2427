439 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430\nM 17.1 \u0414\u0440\u0443\u0433\u043e\u0439 \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437 FA01.2 \u0414\u0440\u0443\u0433\u043e\u0439 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0439 \u043e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442\n\u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430\n\u041c17.2 \u041f\u043e\u0441\u0442\u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437 FA01.Z \u041e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\n\u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0439 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0451\u043d\u043d\u044b\u0439\n\u041c17.3 \u0414\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u0441\u0442\u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 FA01.Z \u041e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\u044b \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439\n\u041c17.4 \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0435 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\u044b FA01.Z \u041e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\n\u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0435 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439\n\u041c17.5 \u0414\u0440\u0443\u0433\u0438\u0435 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0435 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\u044b FA01.Z \u041e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439\n\u041c17.9 \u0413\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437 \u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439 FA01.Z \u041e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u0438\u0442 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430,\n\n\u043d\u0435\u0443\u0442\u043e\u0447\u043d\u0435\u043d\u043d\u044b\u0439\n\n2) \u0414\u0430\u0442\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0438 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: 2015 \u0433\u043e\u0434 (\u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\n\n2022 \u0433\u043e\u0434).\n\n3) \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\n\u041c\u041a\u0411 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439;\n\u0413\u0410 \u0433\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437\n\n\u0410\u041b\u0422 \u0430\u043b\u0430\u043d\u0438\u043d\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\u0410\u0421\u0422 \u0430\u0441\u043f\u0430\u0440\u0442\u0430\u0442\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\nASA American Society of Anesthesiologists \u2014 \u0410\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\n\u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u043e\u0432\n\u0413\u041a \u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b\n\n\u041a\u0422 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u041c\u0420\u0422 \u043c\u0430\u0433\u043d\u0438\u0442\u043d\u043e-\u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u041d\u041f\u0412\u0421 \u043d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\n\u041e\u0410 \u043e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u043e\u0437\n\u041e\u0410\u041a \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438\n\n\u041e\u0410\u041c \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438\n\u0421\u041e\u042d \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043e\u0441\u0435\u0434\u0430\u043d\u0438\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432\n\u0421\u0420\u0411 \u0421- \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a\n\n\u0421\u041e\u042d \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043e\u0441\u0435\u0434\u0430\u043d\u0438\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432\n\u0422\u042d\u041b\u0410 \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u044f \u043b\u0451\u0433\u043e\u0447\u043d\u043e\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0438\nTKA total knee arthroplasty \u2014 \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e\n\n\u0441\u0443\u0441\u0442\u0430\u0432\u0430\n\u0423\u0417\u0418 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\nUKA unicompartmental knee arthroplasty \u2014 \u043e\u0434\u043d\u043e\u043c\u044b\u0449\u0435\u043b\u043a\u043e\u0432\u043e\u0435\n\n\u044d\u043d\u0434\u043e\u043f\u0440\u043e\u0442\u0435\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430.\n\u042d\u041a\u0413 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u043c\u043c\u0430.\n\n\u0424\u041d \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\n\u0420\u041a\u0418 \u0440\u0430\u043d\u0434\u043e\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u043e\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435\n\n4) \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438, \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u044b, \u0432\u0440\u0430\u0447\u0438 \u043e\u0431\u0449\u0435\u0439\n\n\u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438-\u043e\u0440\u0442\u043e\u043f\u0435\u0434\u044b, \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u043e\u043b\u043e\u0433\u0438.\n\n5) \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432: \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435.\n\n6) \u0428\u043a\u0430\u043b\u0430 \u0443\u0440\u043e\u0432\u043d\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438:\n\u0410 \u0412\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043c\u0435\u0442\u0430-\u0430\u043d\u0430\u043b\u0438\u0437, \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u0420\u041a\u0418 \u0438\u043b\u0438 \u043a\u0440\u0443\u043f\u043d\u043e\u0435\n\u0420\u041a\u0418 \u0441 \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u043e\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\u044e (++) \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u0438, \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b\n\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b \u043d\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u044e.\n\u0412 \u0412\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 (++) \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u0437\u043e\u0440 \u043a\u043e\u0433\u043e\u0440\u0442\u043d\u044b\u0445 \u0438\u043b\u0438\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u043b\u0443\u0447\u0430\u0439-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0438\u043b\u0438 \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 (++) \u043a\u043e\u0433\u043e\u0440\u0442\u043d\u043e\u0435 \u0438\u043b\u0438\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u043b\u0443\u0447\u0430\u0439-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0441 \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u043e\u0448\u0438\u0431\u043a\u0438 \u0438\u043b\u0438 \u0420\u041a\u0418 \u0441 \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c (+) \u0440\u0438\u0441\u043a\u043e\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u0438,\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b \u043d\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e\n\u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u044e.\n\u0421 \u041a\u043e\u0433\u043e\u0440\u0442\u043d\u043e\u0435 \u0438\u043b\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u043b\u0443\u0447\u0430\u0439-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0438\u043b\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u043e\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u0437 \u0440\u0430\u043d\u0434\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u0438 \u0441 \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u043e\u0448\u0438\u0431\u043a\u0438 (+), \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b \u043d\u0430\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u044e \u0438\u043b\u0438 \u0420\u041a\u0418 \u0441 \u043e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u0438\u043c \u0438\u043b\u0438 \u043d\u0435\u0432\u044b\u0441\u043e\u043a\u0438\u043c\n\u0440\u0438\u0441\u043a\u043e\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u0438 (++ \u0438\u043b\u0438 +), \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442\n\n\u0431\u044b\u0442\u044c \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u044b \u043d\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u044e\nD \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0441\u0435\u0440\u0438\u0438 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0438\u043b\u0438 \u043d\u0435\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u043b\u0438 \u043c\u043d\u0435\u043d\u0438\u0435\n\u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432\n\n7) \u0422\u0435\u0440\u043c\u0438\u043d\u044b \u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f [1]: \u0413\u043e\u043d\u0430\u0440\u0442\u0440\u043e\u0437 (\u043e\u0441\u0442\u0435\u043e\u0430\u0440\u0442\u0440\u043e\u0437 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430) \u2014\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0435\u0435\u0441\u044f \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u043c\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0433\u043e \u0445\u0440\u044f\u0449\u0430, \u0441\u0443\u0431\u0445\u043e\u043d\u0434\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u0441\u0442\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e\n\u0441\u0443\u0441\u0442\u0430\u0432\u0430, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0435\u0435\u0441\u044f \u0431\u043e\u043b\u044c\u044e, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430\n\u0436\u0438\u0437\u043d\u0438.\n\n8) \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f [1-3]:\n1. \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f American College of Rheumatology \u043f\u043e \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438:\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 (\u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439);\n\u2022\n\u0432\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0439 (\u043f\u043e\u0441\u0442\u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439, \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0439, \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0432\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u0438\u043b\u0438\n\u2022\n\u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0451\u043d\u043d\u044b\u0445 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u043a\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0443\u0441\u0442\u0430\u0432\u0430).\n2. \u041f\u043e \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0442\u0430\u0434\u0438\u0438\n\u2022 I \u0441\u0442\u0430\u0434\u0438\u044f \u2014 \u0441\u043e\u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 (\u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0435 \u043e\u0441\u0442\u0435\u043e\u0444\u0438\u0442\u044b);\n\u2022 II \u0441\u0442\u0430\u0434\u0438\u044f \u2014 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u0441\u0443\u0436\u0435\u043d\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0449\u0435\u043b\u0438, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043e\u0441\u0442\u0435\u043e\u0444\u0438\u0442\u043e\u0432;\n\u2022 III \u0441\u0442\u0430\u0434\u0438\u044f \u2014 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0435 \u0441\u0443\u0436\u0435\u043d\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0449\u0435\u043b\u0438, \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0441\u0442\u0435\u043e\u0444\u0438\u0442\u044b,\n\u0441\u0443\u0431\u0445\u043e\u043d\u0434\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u043a\u043b\u0435\u0440\u043e\u0437;\n\u2022 IV \u0441\u0442\u0430\u0434\u0438\u044f \u2014 \u0440\u0435\u0437\u043a\u043e\u0435 \u0441\u0443\u0436\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0449\u0435\u043b\u0438, \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u0430\u044f", "type": "Document"}}