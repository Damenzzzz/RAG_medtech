u0432\u0435\u043d\u043d\u043e. \u0414\u0435\u0442\u044f\u043c 2-5 \u043b\u0435\u0442 - 250 \u043c\u0433/\u0441\u0443\u0442.; 5-10 \u043b\u0435\u0442 - 250- 10\n375 \u043c\u0433/\u0441\u0443\u0442., \u0441\u0442\u0430\u0440\u0448\u0435 10 \u043b\u0435\u0442 - 500 \u043c\u0433/\u0441\u0443\u0442.\n\u0421\u0443\u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043e\u0437\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 2\n\u041c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b. \u043f\u0440\u0438\u0435\u043c\u0430. \u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f - 10 \u0434\u043d\u0435\u0439.\n\u0414\u0435\u0442\u044f\u043c \u0434\u043e 1 \u0433\u043e\u0434\u0430 - \u043f\u043e 125 \u043c\u0433/\u0441\u0443\u0442., 2-4 \u0433\u043e\u0434\u0430 -\n\u043f\u043e 250 \u043c\u0433/\u0441\u0443\u0442., 5-8 \u043b\u0435\u0442 - \u043f\u043e 375 \u043c\u0433/\u0441\u0443\u0442.,\n\u0441\u0442\u0430\u0440\u0448\u0435 8 \u043b\u0435\u0442 - \u043f\u043e 500 \u043c\u0433/\u0441\u0443\u0442. (\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430).\n24. Per os. \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0438 7\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 960 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c\n\u0438\u043b\u0438 \u043f\u043e 480 \u043c\u0433 \u2013 \u0434\u0432\u0430\u0436\u0434\u044b, \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u043c\n\u041a\u043e-\u0442\u0440\u0438\u043c\u043e\u043a\u0441\u0430\u0437\u043e\u043b.\n\u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u0435\u043c\n480 \u043c\u0433 \u0442\u0440\u0438\u0436\u0434\u044b \u0432 \u0441\u0443\u0442\u043a\u0438.\n25. \u0412\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435\u0447\u043d\u043e, \u0414\u0435\u0442\u044f\u043c 6-12 \u043b\u0435\u0442 \u2013 \u0432 \u0434\u043e\u0437\u0435 240 \u043c\u0433 \u0434\u0432\u0430\u0436\u0434\u044b \u0432 7\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0441\u0443\u0442\u043a\u0438, \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u044f 12-\u0447\u0430\u0441\u043e\u0432\u043e\u0439 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b,\n\u0434\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013 \u043f\u043e 480\n\u043c\u0433 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\n\u0432\u0432\u043e\u0434\u044f\u0442 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0434\u0432\u0430\u0436\u0434\u044b \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u0442\u0430\u043a\u0438\u0445\n\u041a\u043e-\u0442\u0440\u0438\u043c\u043e\u043a\u0441\u0430\u0437\u043e\u043b.\n\u0434\u043e\u0437\u0430\u0445: \u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043e\u0442 6 \u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e 5\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u2013 \u043f\u043e 120 \u043c\u0433, \u043c\u0430\u043b\u044b\u0448\u0430\u043c \u043e\u0442 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u0434\u043e 5 \u043b\u0435\u0442 \u2013 \u043f\u043e 240 \u043c\u0433, \u0434\u0435\u0442\u044f\u043c 6-12 \u043b\u0435\u0442 \u2013 \u043f\u043e\n480 \u043c\u0433, \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u043e\u0442 12 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013\n\u043f\u043e 960-1920 \u043c\u0433\n26. Per os. \u041f\u0440\u0438 \u043f\u0440\u0438\u0435\u043c\u0435 \u0432\u043d\u0443\u0442\u0440\u044c \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u2014 2-3 \u0433/\u0441\u0443\u0442 7\n\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430. \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445\n\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c 4-5 \u0433/\u0441\u0443\u0442 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445\n\u0421\u043f\u0438\u0440\u0430\u043c\u0438\u0446\u0438\u043d.\n\u0434\u043e\u0437\u0430\u0445. \u0414\u0435\u0442\u044f\u043c \u2014 50-100 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0432\n\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445.\n27. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u2014 \u043f\u043e 500 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447, 7\n\u0421\u043f\u0438\u0440\u0430\u043c\u0438\u0446\u0438\u043d. \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2014 \u043f\u043e 1 \u0433 \u043a\u0430\u0436\u0434\u044b\u0435 8\n\u0447.\n28. Per os. \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439: \u0435\u0441\u043b\u0438 \u0432\u0435\u0441 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 7\n\u0431\u043e\u043b\u0435\u0435 10 \u043a\u0433, \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 10\n\u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u0430 \u043f\u043e\u0442\u043e\u043c \u043f\u043e 5 \u043c\u0433/\u043a\u0433, \u043b\u0438\u0431\u043e\n\u0410\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d.\n3 \u0434\u043d\u044f \u043f\u043e 10 \u043c\u0433/\u043a\u0433. \u041f\u0440\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445\n\u0436\u0435\u043b\u0443\u0434\u043a\u0430 1000 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 3 \u0434\u043d\u044f, \u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0432\n\u0441\u043e\u0441\u0442\u0430\u0432\u0435 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0435 \u041b\u0421 (\u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0438\u0441\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0437\u0430, \u043e\u0434\u0438\u043d \u0438\u0437:)\n29. \u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b. Per os. \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u043e 3 \u043b\u0435\u0442 10\n(\u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0439 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b). \u041f\u0440\u0438\n\u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a \u0434\u043e\u0437\u0430\n\u0444\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 3\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438. \u0414\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c\n\u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u043e\u043c, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u0435\u0439, \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 3-12 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u2013 12 \u043c\u0433/\u043a\u0433.\n\n19\n\n30. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041f\u0440\u0438 \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0444\u043b\u044e\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u0430 \u0434\u0435\u0442\u044f\u043c \u043f\u0440\u0438 10\n\u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043d\u043e\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u043a\u043e\u0436\u0438 \u0438 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439\n\u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b. \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1 \u2013 3 \u043c\u0433/\u043a\u0433\n\u041f\u0440\u0438 \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0445 \u043c\u0438\u043a\u043e\u0437\u0430\u0445 \u0434\u043e\u0437\u0430 \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f\n\u0434\u043e 6 \u2013 12 \u043c\u0433/\u043a\u0433.\n31. Per os. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u043c\u043b\u0430\u0434\u0448\u0435 2 10\n\u0412\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b. \u043b\u0435\u0442. \u0414\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 3 \u0434\u043e 12 \u043b\u0435\u0442: 50\n\u043c\u0433/\u043a\u0433.\n32. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432, \u043d\u0430\u0441\u044b\u0449\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u0430 (\u0432\u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f) \u2014 6 10\n\u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u0430\n\u0412\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b.\n(\u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u044b\u0445 24 \u0447) \u2014 3\u20134 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12\n\u0447 (\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439).\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u041b\u0421 (\u0441\u043c. \u041a\u041f \u00ab\u0412\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u041b\u0421, \u0432\u043b\u0438\u044f\u044e\u0449\u0438\u0435 \u043d\u0430 \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u044e\n33. \u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0413\u0435\u043f\u0430\u0440\u0438\u043d \u0432\u0432\u043e\u0434\u044f\u0442 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, 2\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e. \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f\n\u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u0437\u0430 - 75-100 \u041c\u0415/\u043a\u0433\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 \u043c\u0438\u043d\u0443\u0442,\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u0430: \u0434\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 1-3\n\u0413\u0435\u043f\u0430\u0440\u0438\u043d.\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 - 25-30 \u041c\u0415/\u043a\u0433/\u0447 (800 ME /\u043a\u0433/\u0441\u0443\u0442),\n\u0434\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 4-12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 - 25-30\n\u041c\u0415/\u043a\u0433/\u0447 (700 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442), \u0434\u0435\u0442\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 1\n\u0433\u043e\u0434\u0430 -18-20 ME /\u043a\u0433/\u0447 (500 ME /\u043a\u0433/\u0441\u0443\u0442)\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e.\n\u0424\u0440\u0430\u043a\u0446\u0438\u0438 \u043f\u043b\u0430\u0437\u043c\u044b \u043a\u0440\u043e\u0432\u0438 \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f (\u043e\u0434\u0438\u043d \u0438\u0437:)\n34. \u0412\u0432\u043e\u0434\u044f\u0442 \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c 2\n\u0448\u043e\u043a\u0435, \u0433\u0438\u043f\u043e\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\u0435\u043c\u0438\u0438,\n\u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d 10%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u0438. \u0423 \u0434\u0435\u0442\u0435\u0439 \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3 \u043c\u043b/\u043a\u0433\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438.\n35. \u0412\u0432\u043e\u0434\u044f\u0442 \u0432/\u0432 \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 2\n\u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d 20%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 0.5-1 \u0433/\u043a\u0433. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043c\u043e\u0436\u043d\u043e\n\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0443 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445 \u0433\u0440\u0443\u0434\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439.\n\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f (\u0434\u043e\u0442\u0430\u0446\u0438\u044f \u0432 \u0440\u0430\u043d\u043d\u0438\u0439 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434)\n36. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0438 \u0434\u0435\u0442\u0438 \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430: 2\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f \u0434\u043e\u0437\u0430 - 0.5-4 \u0433\n\u0442\u0440\u0438\u0433\u043b\u0438\u0446\u0435\u0440\u0438\u0434\u043e\u0432 \u043d\u0430 \u043a\u0433/\u0441\u0443\u0442, \u0438\u043b\u0438 30 \u043c\u043b 10%,\n\u0438\u043b\u0438 15 \u043c\u043b 20% \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043d\u0430 \u043a\u0433/\u0441\u0443\u0442.\n\u0416\u0438\u0440\u043e\u0432\u0430\u044f \u044d\u043c\u0443\u043b\u044c\u0441\u0438\u044f\n\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c\n\u0434\u043b\u044f 0.17 \u0433/\u043a\u0433/\u0447 \u0438\u043b\u0438 4 \u0433/\u043a\u0433/\u0441\u0443\u0442.\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0423 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445 \u0438 \u0443 \u0434\u0435\u0442\u0435\u0439, \u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0441\n\u043f\u0438\u0442\u0430\u043d\u0438\u044f. \u043d\u0438\u0437\u043a\u043e\u0439 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430, \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\n\u0438\u043d\u0444\u0443\u0437\u0438\u044e \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0443\u0442\u043e\u043a.\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0430\u044f 0.5-1\n\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e 2\n\u0433/\u043a\u0433/\u0441\u0443\u0442.\n37. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 2 \u043b\u0435\u0442: 0,35\u20130,45 2\n\u0433/\u043a\u0433/\u0441\u0443\u0442 (\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u