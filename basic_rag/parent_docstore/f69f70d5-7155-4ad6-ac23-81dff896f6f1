{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_1ca45ca56d37", "title": "\u0410\u0425\u0410\u041b\u0410\u0417\u0418\u0418 \u041f\u0418\u0429\u0415\u0412\u041e\u0414\u0410 \u0423 \u0414\u0415\u0422\u0415\u0419", "source_file": "2025_\u0410\u0425\u0410\u041b\u0410\u0417\u0418\u0418_\u041f\u0418\u0429\u0415\u0412\u041e\u0414\u0410_\u0423_\u0414\u0415\u0422\u0415\u0418_34169dfe2e.pdf", "icd_codes": "K22.0", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0410\u0425\u0410\u041b\u0410\u0417\u0418\u0418 \u041f\u0418\u0429\u0415\u0412\u041e\u0414\u0410 \u0423 \u0414\u0415\u0422\u0415\u0419.pdf"}, "page_content": "\u043c\u0433/\u0441\u0443\u0442. \u0421\u0443\u0442\u043e\u0447\u043d\u0443\u044e \u0434\u043e\u0437\u0443 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 2 \u043f\u0440\u0438\u0435\u043c\u0430. \u041a\u0443\u0440\u0441 \u043b\u0435\u0447\u0435\u043d\u0438\u044f -\n10 \u0434\u043d\u0435\u0439. \u0414\u0435\u0442\u044f\u043c \u0434\u043e 1 \u0433\u043e\u0434\u0430 - \u043f\u043e 125\n\u043c\u0433/\u0441\u0443\u0442., 2-4 \u0433\u043e\u0434\u0430 - \u043f\u043e 250 \u043c\u0433/\u0441\u0443\u0442., 5-8\n\u043b\u0435\u0442 - \u043f\u043e 375 \u043c\u0433/\u0441\u0443\u0442., \u0441\u0442\u0430\u0440\u0448\u0435 8 \u043b\u0435\u0442 - \u043f\u043e\n500 \u043c\u0433/\u0441\u0443\u0442. (\u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430).\n24. \u041a\u043e-\u0442\u0440\u0438\u043c\u043e\u043a\u0441\u0430\u0437\u043e\u043b. Per os. \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0438 7\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 960 \u043c\u0433 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432\n\u0434\u0435\u043d\u044c \u0438\u043b\u0438 \u043f\u043e 480 \u043c\u0433 \u2013 \u0434\u0432\u0430\u0436\u0434\u044b, \u043f\u0440\u0438\n\u0442\u044f\u0436\u0435\u043b\u043e\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u0435\u043c 480 \u043c\u0433 \u0442\u0440\u0438\u0436\u0434\u044b \u0432\n\u0441\u0443\u0442\u043a\u0438.\n25. \u041a\u043e-\u0442\u0440\u0438\u043c\u043e\u043a\u0441\u0430\u0437\u043e\u043b. \u0412\u043d\u0443\u0442\u0440\u0438\u043c\u044b\u0448\u0435 \u0414\u0435\u0442\u044f\u043c 6-12 \u043b\u0435\u0442 \u2013 \u0432 \u0434\u043e\u0437\u0435 240 \u043c\u0433 \u0434\u0432\u0430\u0436\u0434\u044b 7\n\u0447\u043d\u043e, \u0432 \u0441\u0443\u0442\u043a\u0438, \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u044f 12-\u0447\u0430\u0441\u043e\u0432\u043e\u0439\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b, \u0434\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0438\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e.\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013 \u043f\u043e 480 \u043c\u0433 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c.\n\u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0432\u0432\u043e\u0434\u044f\u0442 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e\n\u0434\u0432\u0430\u0436\u0434\u044b \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u0442\u0430\u043a\u0438\u0445 \u0434\u043e\u0437\u0430\u0445:\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u043e\u0442 6 \u043d\u0435\u0434\u0435\u043b\u044c \u0434\u043e 5\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u2013 \u043f\u043e 120 \u043c\u0433, \u043c\u0430\u043b\u044b\u0448\u0430\u043c \u043e\u0442 6\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e 5 \u043b\u0435\u0442 \u2013 \u043f\u043e 240 \u043c\u0433, \u0434\u0435\u0442\u044f\u043c 6-\n12 \u043b\u0435\u0442 \u2013 \u043f\u043e 480 \u043c\u0433, \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u043e\u0442 12\n\u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u2013 \u043f\u043e 960-1920 \u043c\u0433.\n26. \u0421\u043f\u0438\u0440\u0430\u043c\u0438\u0446\u0438\u043d. Per os. \u041f\u0440\u0438 \u043f\u0440\u0438\u0435\u043c\u0435 \u0432\u043d\u0443\u0442\u0440\u044c \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u2014 2-3 7\n\u0433/\u0441\u0443\u0442 \u0432 2 \u043f\u0440\u0438\u0435\u043c\u0430. \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c 4-5 \u0433/\u0441\u0443\u0442\n\u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445. \u0414\u0435\u0442\u044f\u043c \u2014 50-100\n\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u0437\u0430\u0445.\n27. \u0421\u043f\u0438\u0440\u0430\u043c\u0438\u0446\u0438\u043d. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u2014 \u043f\u043e 500 \u043c\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 7\n8 \u0447, \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\u0445 \u2014 \u043f\u043e 1 \u0433\n\u043a\u0430\u0436\u0434\u044b\u0435 8 \u0447.\n28. \u0410\u0437\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d. Per os. \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439: \u0435\u0441\u043b\u0438 \u0432\u0435\u0441 7\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0431\u043e\u043b\u0435\u0435 10 \u043a\u0433, \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 10 \u043c\u0433/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430, \u0430\n\u043f\u043e\u0442\u043e\u043c \u043f\u043e 5 \u043c\u0433/\u043a\u0433, \u043b\u0438\u0431\u043e 3 \u0434\u043d\u044f \u043f\u043e 10\n\u043c\u0433/\u043a\u0433. \u041f\u0440\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u0445 \u0436\u0435\u043b\u0443\u0434\u043a\u0430\n1000 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 3 \u0434\u043d\u044f, \u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0432\n\u0441\u043e\u0441\u0442\u0430\u0432\u0435 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0435 \u041b\u0421 (\u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u0438\u0441\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u0437\u0430, \u043e\u0434\u0438\u043d \u0438\u0437:)\n29. \u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b. Per os. \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d \u0434\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u043e 3 10\n\u043b\u0435\u0442 (\u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0439 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439\n\u0444\u043e\u0440\u043c\u044b). \u041f\u0440\u0438 \u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u0435 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445\n\u043e\u0431\u043e\u043b\u043e\u0447\u0435\u043a \u0434\u043e\u0437\u0430 \u0444\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 3 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438. \u0414\u043b\u044f\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0433\u0440\u0438\u0431\u043a\u043e\u0432\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 \u0443\n\u0434\u0435\u0442\u0435\u0439 \u0441\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u043c \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u043e\u043c, \u0443\n\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u0435\u0439, \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\n\u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 3-12 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438.\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f\n\u0434\u0435\u0442\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u2013 12 \u043c\u0433/\u043a\u0433.\n30. \u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041f\u0440\u0438 \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0444\u043b\u044e\u043a\u043e\u043d\u0430\u0437\u043e\u043b\u0430 \u0434\u0435\u0442\u044f\u043c 10\n\u043f\u0440\u0438 \u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043d\u043e\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u043a\u043e\u0436\u0438 \u0438\n\u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0438\u0437 \u0440\u0430\u0441\u0447\u0435\u0442\u0430 1 \u2013 3 \u043c\u0433/\u043a\u0433\n\u041f\u0440\u0438 \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0445 \u043c\u0438\u043a\u043e\u0437\u0430\u0445 \u0434\u043e\u0437\u0430\n\u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f \u0434\u043e 6 \u2013 12 \u043c\u0433/\u043a\u0433.\n31. \u0412\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b. Per os. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 10\n\u043c\u043b\u0430\u0434\u0448\u0435 2 \u043b\u0435\u0442. \u0414\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u043e\u0442 3 \u0434\u043e\n17\n\n12 \u043b\u0435\u0442: 50 \u043c\u0433/\u043a\u0433.\n32. \u0412\u043e\u0440\u0438\u043a\u043e\u043d\u0430\u0437\u043e\u043b. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432, \u043d\u0430\u0441\u044b\u0449\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u0430 (\u0432\u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f) 10\n\u2014 6 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447,\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0434\u043e\u0437\u0430 (\u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u044b\u0445\n24 \u0447) \u2014 3\u20134 \u043c\u0433/\u043a\u0433 \u043a\u0430\u0436\u0434\u044b\u0435 12 \u0447 (\u0432\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0439).\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u041b\u0421 (\u0441\u043c. \u041a\u041f \u00ab\u0412\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439\u00bb)\n\u041b\u0421, \u0432\u043b\u0438\u044f\u044e\u0449\u0438\u0435 \u043d\u0430 \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u044e\n33. \u0413\u0435\u043f\u0430\u0440\u0438\u043d. \u041f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, \u0413\u0435\u043f\u0430\u0440\u0438\u043d \u0432\u0432\u043e\u0434\u044f\u0442 \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e, 2\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e, \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0438\u043b\u0438 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e.\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0434\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u043e\u0437\u0430 - 75-\n100 \u041c\u0415/\u043a\u0433 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u0431\u043e\u043b\u044e\u0441\u043d\u043e \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 10 \u043c\u0438\u043d\u0443\u0442, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f\n\u0434\u043e\u0437\u0430: \u0434\u0435\u0442\u0438 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 1-3 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 - 25-\n30 \u041c\u0415/\u043a\u0433/\u0447 (800 ME /\u043a\u0433/\u0441\u0443\u0442), \u0434\u0435\u0442\u0438 \u0432\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 4-12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 - 25-30 \u041c\u0415/\u043a\u0433/\u0447\n(700 \u041c\u0415/\u043a\u0433/\u0441\u0443\u0442), \u0434\u0435\u0442\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 1 \u0433\u043e\u0434\u0430 -\n18-20 ME /\u043a\u0433/\u0447 (500 ME /\u043a\u0433/\u0441\u0443\u0442)\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e.\n\u0424\u0440\u0430\u043a\u0446\u0438\u0438 \u043f\u043b\u0430\u0437\u043c\u044b \u043a\u0440\u043e\u0432\u0438 \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f (\u043e\u0434\u0438\u043d \u0438\u0437:)\n34. \u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d 10%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0412/\u0432 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0448\u043e\u043a\u0435, 2\n\u0433\u0438\u043f\u043e\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\u0435\u043c\u0438\u0438, \u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u0438.\n\u0423 \u0434\u0435\u0442\u0435\u0439 \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u0437\n\u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3 \u043c\u043b/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438.\n35. \u0410\u043b\u044c\u0431\u0443\u043c\u0438\u043d 20%. \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0420\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 0.5- 2\n1 \u0433/\u043a\u0433. \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0443\n\u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445 \u0433\u0440\u0443\u0434\u043d\u044b\u0445 \u0434\u0435\u0442\u0435\u0439.\n\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f (\u0434\u043e\u0442\u0430\u0446\u0438\u044f \u0432 \u0440\u0430\u043d\u043d\u0438\u0439 \u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434)\n36. \u0416\u0438\u0440\u043e\u0432\u0430\u044f \u044d\u043c\u0443\u043b\u044c\u0441\u0438\u044f \u0434\u043b\u044f \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u041d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0438 \u0434\u0435\u0442\u0438 \u0440\u0430\u043d\u043d\u0435\u0433\u043e 2\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430: \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f \u0434\u043e\u0437\u0430 - 0.5-4 \u0433\n\u0442\u0440\u0438\u0433\u043b\u0438\u0446\u0435\u0440\u0438\u0434\u043e\u0432 \u043d\u0430 \u043a\u0433/\u0441\u0443\u0442, \u0438\u043b\u0438 30 \u043c\u043b\n\u043f\u0438\u0442\u0430\u043d\u0438\u044f.\n10%, \u0438\u043b\u0438 15 \u043c\u043b 20% \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043d\u0430\n\u043a\u0433/\u0441\u0443\u0442. \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n\u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 0.17 \u0433/\u043a\u0433/\u0447 \u0438\u043b\u0438 4 \u0433/\u043a\u0433/\u0441\u0443\u0442.\n\u0423 \u043d\u0435\u0434\u043e\u043d\u043e\u0448\u0435\u043d\u043d\u044b\u0445 \u0438 \u0443 \u0434\u0435\u0442\u0435\u0439,\n\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0441 \u043d\u0438\u0437\u043a\u043e\u0439 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430,\n\u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0438\u043d\u0444\u0443\u0437\u0438\u044e\n\u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0443\u0442\u043e\u043a.\n\u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0430\u044f 0.5-1\n\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e 2\n\u0433/\u043a\u0433/\u0441\u0443\u0442.\n37. \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 \u0412\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 2 \u043b\u0435\u0442: 0,35\u2013 2\n\u0434\u043b\u044f \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e 0,45 \u0433/\u043a\u0433/\u0441\u0443\u0442 (\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e 2\u20133 \u0433\n\u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442/\u043a\u0433/\u0441\u0443\u0442); \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f\n\u043f\u0438\u0442\u0430\u043d\u0438\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 14\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u2014 75 \u043c\u043b/\u043a\u0433 (\u0447\u0442\u043e\n\u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 4% \u0438\u043b\u0438\n\u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u043e 3 \u0433 \u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442, 12 \u0433\n5%. \u0434\u0435\u043a\u0441\u0442\u0440\u043e\u0437\u044b \u0438 3 \u0433 \u043b\u0438\u043f\u0438\u0434\u043e\u0432 \u043d\u0430 1 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b\n\u0442\u0435\u043b\u0430). \u041d\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c \u0434\u043e\u0437\u0443 3\n\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0430\u043c\u0438\u043d\u043e\u043a\u0438\u0441\u043b\u043e\u0442 \u04