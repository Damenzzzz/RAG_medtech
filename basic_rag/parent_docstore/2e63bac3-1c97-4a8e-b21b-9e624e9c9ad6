0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439\n\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438: \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u0441\u0435\u0440\u043e-\u043f\u0435\u043f\u0435\u043b\u044c\u043d\u044b\u0439 \u0446\u0438\u0430\u043d\u043e\u0437,\n\u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 II \u0442\u043e\u043d\u0430 \u043d\u0430\u0434 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0435\u0439, \u0442\u0430\u0445\u0438\u043a\u0430\u0440\u0434\u0438\u044f, \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u0435\u043a\u0438.\n\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\u2022 \u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438\n\u2022 \u0421-\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0431\u0435\u043b\u043e\u043a (\u0421\u0420\u0411)\n\u2022 \u041a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430\n\n\u2022 ENA, ANA, \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u0438\u0434\u043d\u044b\u0439 \u0444\u0430\u043a\u0442\u043e\u0440\n\u2022 \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0430\u0437\u043e\u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u043a\u0440\u043e\u0432\u0438\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u2022 Pro-BNP \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043f\u0440\u0430\u0432\u043e\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0439\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u041b\u0410\u0413\n\u2022 \u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432 \u0432\u0438\u0440\u0443\u0441\u043e\u0432: CMV, EBV, \u0433\u0435\u0440\u043f\u0435\u0432\u0438\u0440\u0443\u0441\u044b\n\n\u2022 \u0414-\u0434\u0438\u043c\u0435\u0440\n\u2022 \u0410\u041f\u0424\n\u2022 \u0410\u043d\u0442\u0438\u043d\u0443\u043a\u043b\u0435\u0430\u0440\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 (\u0410\u041d\u0424), \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0442\u043e\u043f\u043e\u0438\u0437\u043e\u043c\u0435\u0440\u0430\u0437\u04351 (scl-70),\n\n\u0430\u043d\u0442\u0438\u0446\u0435\u043d\u0442\u0440\u043e\u043c\u0435\u0440\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 (\u0410\u0426\u0410), \u0430\u043d\u0442\u0438-PM/Scl, \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443\n\u0446\u0438\u0442\u0440\u0443\u043b\u043b\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c\u0443 \u043f\u0435\u043f\u0442\u0438\u0434\u0443 (\u0410\u0426\u0426\u041f), \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0434\u0432\u0443\u0441\u043f\u0438\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0414\u041d\u041a, Smith-\n\u0430\u043d\u0442\u0438\u0433\u0435\u043d (\u0430\u043d\u0442\u0438-Sm), \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0440\u0438\u0431\u043e\u043d\u0443\u043a\u043b\u0435\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443, \u0430\u043d\u0442\u0438\u0441\u0438\u043d\u0442\u0435\u0442\u0430\u0437\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\n\n(\u0430\u043d\u0442\u0438-Jo-1-\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430);\n\n\u0423 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438 \u043d\u0430 \u041a\u0422 \u041e\u0413\u041a \u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0421\u0417\u0421\u0422 \u043f\u0440\u0438\n\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433\u043e\u0432\u044b\u0445 \u0430\u0443\u0442\u043e\u0438\u043c\u0443\u043d\u043d\u044b\u0445 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432\n\u0434\u043e\u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435:\n\n6\n\n\uf0d8 \u043c\u0438\u043e\u0437\u0438\u0442\u0430: \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u043a\u0438\u043d\u0430\u0437\u0430, \u043c\u0438\u043e\u0433\u043b\u043e\u0431\u0438\u043d, \u0430\u043b\u044c\u0434\u043e\u043b\u0430\u0437\u0430,\n\n\u0430\u043d\u0442\u0438\u0446\u0435\u043d\u0442\u0440\u043e\u043c\u0435\u0440\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430:\n\uf0d8 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0439 \u0441\u043a\u043b\u0435\u0440\u043e\u0434\u0435\u0440\u043c\u0438\u0438: \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a Scl-70 / \u0442\u043e\u043f\u043e\u0438\u0437\u043e\u043c\u0435\u0440\u0430\u0437\u0435-\n\n1, \u0430\u043d\u0442\u0438\u0446\u0435\u043d\u0442\u0440\u043e\u043c\u0435\u0440\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430;\n\uf0d8 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430 \u0428\u0435\u0433\u0440\u0435\u043d\u0430: \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a SSA / Ro \u0438 SSB / La \u0432 \u043a\u0440\u043e\u0432\u0438;\n\uf0d8 \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u0430: PR3 (c-ANCA), \u041c\u041f\u041e (p-ANCA).\n\n\u0412\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0421\u0417\u0421\u0422 \u0443 \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u0441 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438 \u0432 \u043b\u0435\u0433\u043a\u0438\u0445\n\u0438\u0441\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0418\u041b\u0424.\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\n\u041e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u2013 \u0438\u043c\u0435\u0435\u0442 \u043d\u0438\u0437\u043a\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\n\u043f\u0440\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0435 \u0418\u041b\u0424. \u0412 \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0432\u044b\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f:\n\n\u2022 \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u0430\u044f \u043c\u0435\u043b\u043a\u043e\u0441\u0435\u0442\u0447\u0430\u0442\u0430\u044f (\u043c\u0435\u043b\u043a\u043e\u044f\u0447\u0435\u0438\u0441\u0442\u0430\u044f) \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0433\u043e\n\u0440\u0438\u0441\u0443\u043d\u043a\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430\n\u2022 \u0434\u0432\u0443\u0445\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f\u044f \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0441 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432, \u043d\u0430\u0434 \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u043e\u0439; \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0435\u043c\u0430\n\n\u043b\u0435\u0433\u043a\u0438\u0445 \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043a\u0443\u043f\u043e\u043b\u0430 \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u044b \u0438 \u0431\u043e\u043b\u0435\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\n\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u0442\u0435\u043d\u0438;\n\u2022 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u043d\u0435\u0439 \u043b\u0435\u0433\u043a\u0438\u0445 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f\n\u043a\u0443\u043f\u043e\u043b\u0430 \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043c\u044b, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u043b\u0435\u0433\u043e\u0447\u043d\u044b\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439 \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u041b\u0410\u0413,\n\n\u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u0431\u0440\u043e\u043d\u0445\u043e\u043f\u0443\u043b\u044c\u043c\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432.\n\n\u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f (\u041a\u0422\u0412\u0420) \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u043c \u0418\u041b\u0424\n( \u0442\u0430\u0431\u043b\u0438\u0446\u0430 1).\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 1. \u041f\u0430\u0442\u0442\u0435\u0440\u043d\u044b \u041a\u0422\u0412\u0420 \u043f\u0440\u0438 \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u043c \u0444\u0438\u0431\u0440\u043e\u0437\u0435\n\n\u041a\u0430\u0440\u0442\u0438\u043d\u0430 \u041a\u0422\u0412\u0420\n\n\u041f\u0430\u0442\u0442\u0435\u0440\u043d \u041e\u0418\u041f \u041f\u0430\u0442\u0442\u0435\u0440\u043d \u041d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0439 \u041f\u0430\u0442\u0442\u0435\u0440\u043d \u041a\u0422\u0412\u0420,\n\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0439 \u041e\u0418\u041f \u043f\u0430\u0442\u0442\u0435\u0440\u043d \u041e\u0418\u041f \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u043d\u0430\n\u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0414\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e \u0412\u044b\u0441\u043e\u043a\u0430\u044f \u041d\u0438\u0437\u043a\u0430\u044f \u041e\u0447\u0435\u043d\u044c \u043d\u0438\u0437\u043a\u0430\u044f\n\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u0438 \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0432\u043e\u0435\u0440\u043d\u043e\u0441\u0442\u044c\n(>90%)\n\u043f\u043e \u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n(70-80%) (51-69%) (\u226450%)\n\u041e\u0418\u041f\n\u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u2022 \u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435 \u2022 \u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435 \u2022 \u0414\u0438\u0444\u0444\u0443\u0437\u043d\u043e\u0435 \u041f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\n\u043d\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043d\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0438\u0431\u0440\u043e\u043d\u0445\u043e\u0432\u0430\u0441\u043a\u0443\u043b\u044f\n\u0441\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0431\u0435\u0437 \u0440\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f,\n\u0438 \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0438 \u0431\u0430\u0437\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u043d\u0442\u0430\u043a\u0442\u043d\u044b\n\u2022 \u0427\u0430\u0441\u0442\u043e \u2022 \u0427\u0430\u0441\u0442\u043e (\u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n(\u0447\u0435\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u0447\u0435\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n7\n\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u041d\u0421\u0418\u041f)\n\u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0441 \u0437\u043e\u043d\u0430\u043c\u0438 \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0441\n\u041f\u0435\u0440\u0438\u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\n\u0444\u0438\u0431\u0440\u043e\u0437\u0430) \u0441\u0435\u0442\u0447\u0430\u0442\u043e\u0441\u0442\u044c\u044e \u0438\n\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\n\u2022 \u0414\u0438\u0444\u0444\u0443\u0437\u043d\u043e\u0435 \u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438\n(\u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u0430\u043c\u0438/\n\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n\u0438\u043d\u043e\u0433\u0434\u0430 \u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u043e\u044d\u043a\u0442\u0430\u0437\u0430\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\n\u2022 \u0410\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d \u043c\u0438)\n\u0441\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437\u0430)\n\u043e\u0435\n\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0412\u0435\u0440\u0445\u043d\u044f\u044f \u0438\u043b\u0438\n\u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0447\u0430\u0441\u0442\u044c\n\u043b\u0435\u0433\u043a\u043e\u0433\u043e (\u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c\n\u0444\u0438\u0431\u0440\u043e\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0433\u043e\n\u0413\u041f, \u0417\u0421\u0422-\u0418\u0417\u041b \u0438\n\u0441\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437\u0430)\n\u0421\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438\u043d\u0442\u0430\u043a\u0442\u043d\u044b\n(\u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0437\u0430\u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u044c \u041d\u0421\u0418\u041f\n\u0438\u043b\u0438 \u0418\u041f, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0443\u044e\n\u0441 \u043a\u0443\u0440\u0435\u043d\u0438\u0435\u043c)\n\u041a\u0422\u0412\u0420- \u2022 \u00ab\u0421\u043e\u0442\u044b\u00bb \u0441 \u2022 \u0421\u0435\u0442\u0447\u0430\u0442\u044b\u0439 \u041a\u0422\u0412\u0420-\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u2022 \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u0440\u0438\u0441\u0443\u043d\u043e\u043a \u0441 \u0444\u0438\u0431\u0440\u043e\u0437\u0430 \u043b\u0435\u0433\u043a\u0438\u0445, \u043b\u0435\u0433\u043a\u0438\u0445:\n\u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u0430\u043c\u0438/ \u0442\u0430\u0440\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 o \u041a\u0438\u0441\u0442\u044b\n\u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u043e\u044d\u043a\u0442\u0430\u0437\u0430 \u0431\u0440\u043e\u043d\u0445\u043e\u044d\u043a\u0442\u0430\u0437\u0430\u043c\u0438/ \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043d\u0430 (\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u041b\u0410\u041c,\n\u043c\u0438 \u0438\u043b\u0438 \u0431\u0435\u0437 \u043d\u0438\u0445 \u0431\u0440\u043e\u043d\u0445\u0438\u043e\u043b\u043e\u044d\u043a\u0442\u0430\u0437\u0430 \u043a\u0430\u043a\u0443\u044e-\u043b\u0438\u0431\u043e \u041b\u041b\u041a\u0413, \u041b\u0418\u041f, \u0414\u0418\u041f)\n\u2022 \u041d\u0435\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e \u043c\u0438 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0443\u044e o \u041c\u043e\u0437\u0430\u0438\u0447\u043d\u043e\u0441\u0442\u044c\n\u0443\u0442\u043e\u043b\u0449\u0435\u043d\u043d\u044b\u0435 \u2022 \u041c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u044b \u0441\n\u043c\u0435\u0436\u0434\u043e\u043b\u044c\u043a\u043e\u0432\u044b\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0437\u043e\u043d\u044b \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u043c \u0442\u0440\u043e\u0439\u043d\u043e\u0439\n\u043f\u0435\u0440\u0435\u0433\u043e\u0440\u043e\u0434\u043a\u0438 \u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438\n\u2022 \u041e\u0431\u044b\u0447\u043d\u043e \u0441\u0442\u0435\u043a\u043b\u0430\u00bb (\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0413\u041f)\n\u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442\u0441\u044f \u0441 \u2022 \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c o \u041f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u043d\u0438\u0435\n\u0440\u0435\u0442\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e \u0441\u0442\u0435\u043a\u043b\u0430\u00bb\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438, \u0441\u0443\u0431\u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0445 (\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0413\u041f,\n\u0443\u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0438 \u0437\u043e\u043d \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435\n\u00ab\u043c\u0430\u0442\u043e\u0432\u043e\u0433\u043e \u043a\u0443\u0440\u0435\u043d\u0438\u0435\u043c\n\u0441\u0442\u0435\u043a\u043b\u0430\u00bb \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f,\n\u2022 \u041c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435\n\u0443\u0447\u0430\u0441\u0442\u043a\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f,\n\u043e\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435\n\u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0444\u0438\u0431\u0440\u043e\u0437\u0430)\no \u041c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435\n\u0446\u0435\u043d\u0442\u0440\u0438\u043b\u043e\u0431\u0443\u043b\u044f\u0440\u043d\u044b\u0435\n\u043c\u0438\u043a\u0440\u043e\u0443\u0437\u0435\u043b\u043a\u0438 (\u0413\u041f,\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f,\n\u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441\n\u043a\u0443\u0440\u0435\u043d\u0438\u0435\u043c)\n8\n\no \u0423\u0437\u0435\u043b\u043a\u0438\n\n(\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n\u0441\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437)\no \u041a\u043e\u043d\u0441\u043e\u043b\u0438\u0434\u0430\u0446\u0438\u044f\n(\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0443\u044e\u0449\u0443\u044e\u0441\u044f\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044e, \u0434\u0440.)\n\u2022 \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\n\u0441\u0440\u0435\u0434\u043e\u0441\u0442\u0435\u043d\u0438\u0438:\no \u041f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\n\u0435\n\u0431\u043b\u044f\u0448\u043a\u0438/\u0443\u043f\u043b\u043e\u0442\u043d\u0435\u043d\u0438\n\u044f (\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c\n\u0430\u0441\u0431\u0435\u0441\u0442\u043e\u0437)\no \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\n\u0439 \u043f\u0438\u0449\u0435\u0432\u043e\u0434\n\n(\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0417\u0421\u0422\n\n\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u043c\u0438, \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0449\u0438\u043c\u0438 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u04