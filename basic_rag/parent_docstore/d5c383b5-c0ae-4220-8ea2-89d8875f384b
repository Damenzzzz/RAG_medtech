0424\u0435\u043a\u0441\u043e\u0444\u0435\u043d\u0430\u0434\u0438\u043d - \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e, 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438, D\n120, 180 \u043c\u0433 (\u0442\u0430\u0431) \u043a\u0443\u0440\u0441 10 \u0434\u043d\u0435\u0439\n\u0418\u043b\u0438\n\u0414\u0438\u043c\u0435\u0442\u0438\u043d\u0434\u0435\u043d 1 \u043c\u043b \u2013 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 20\u201340 \u043a\u0430\u043f\u0435\u043b\u044c 3 D\n\n20 \u043a\u0430\u043f\u0435\u043b\u044c \u2013 1 \u043c\u0433 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435, \u0432\n(\u043a\u0430\u043f\u043b\u0438) \u0441\u0440\u0435\u0434\u043d\u0435\u043c10\u201315 \u0434\u043d\u0435\u0439.\n\u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435 \u0410\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d 250, \u0414\u0435\u0442\u044f\u043c \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u0434\u043e 3 \u043b\u0435\u0442 \u2013 \u041d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u0440\u0438 D\n\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 500 \u043c\u0433 (\u0442\u0430\u0431). 30 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442\u043a\u0438 \u0432 2\u20133 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u043c\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043f\u0440\u0438\u0435\u043c\u0430, \u043e\u0442 3 \u0434\u043e 10 \u043b\u0435\u0442 \u2013 \u043f\u043e \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438.\n\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433 375 \u043c\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438, \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u0438\u043d\n\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\