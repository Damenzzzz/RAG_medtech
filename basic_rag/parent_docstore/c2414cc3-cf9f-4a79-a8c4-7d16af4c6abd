3f\u0430\u0442\u0442\u0435\u0440\u043d \u041f\u043e\u0437\u0434\u043d\u0438\u0435: \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u0430\u044f\n(\u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435); \u0438\u0437\u043e\u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0444\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u043b\u0438\n\u043c\u043d\u043e\u0433\u043e\u043e\u0447\u0430\u0433\u043e\u0432\u044b\u0435\n\n\u0441\u0443\u0434\u043e\u0440\u043e\u0433\u0438; \"\u043f\u0438\u043a-\n\u0432\u043e\u043b\u043d\u0430\" \u043e\u0442 1,0 \u0434\u043e 1,5\n\u0413\u0446\n\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b <24 \u0447\u0430\u0441\u043e\u0432 2\u201314 \u0434\u043d\u0435\u0439 \u041e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0447\u0430\u0441\u043e\u0432\n\u044c-\u043d\u043e\u0441\u0442\u044c \u0434\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445\n\n\u043d\u0435\u0434\u0435\u043b\u044c\n\u0418\u0441\u0445\u043e\u0434 \u041e\u043a\u043e\u043b\u043e 100% \u2500 \u0412 80% \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u041e\u043a\u043e\u043b\u043e 50% \u0443\u043c\u0438\u0440\u0430\u044e\u0442;\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439; \u0443 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u2013\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f, \u0435\u0441\u043b\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\n\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u0431\u043e\u043b\u0435\u0435\n5\u20137 \u0434\u043d\u0435\u0439\n\n2. \u041c\u0415\u0422\u041e\u0414\u042b, \u041f\u041e\u0414\u0425\u041e\u0414\u042b \u0418 \u041f\u0420\u041e\u0426\u0415\u0414\u0423\u0420\u042b \u0414\u0418\u0410\u0413\u04