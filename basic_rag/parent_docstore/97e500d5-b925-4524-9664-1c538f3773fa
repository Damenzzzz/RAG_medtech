3a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043d\u0435\u0442.\n\n6.3 \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n1) \u0411\u0430\u0442\u043f\u0435\u043d\u043e\u0432\u0430 \u0413\u0443\u043b\u044c\u043d\u0430\u0440\u0430 \u0420\u044b\u0441\u043a\u0435\u043b\u044c\u0434\u044b\u0435\u0432\u043d\u0430 \u2013 \u0434\u043e\u043a\u0442\u043e\u0440 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043a\u043e\u0441\u043c\u0435\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e\n\n\u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb, \u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0441\u043a\u043e\u0439 \u0410\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438\n\u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433\u043e\u0432, \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u043a\u043e\u0441\u043c\u0435\u0442\u043e\u043b\u043e\u0433\u043e\u0432.\n2) \u0425\u0430\u0431\u0438\u0436\u0430\u043d\u043e\u0432 \u0410\u0441\u043a\u0430\u0440 \u0411\u043e\u043b\u0430\u0442\u043e\u0432\u0438\u0447 \u2013 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0432\u0435\u043d\u0435\u0440\u043e\u043b\u043e\u0433,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 