30\u043f\u0438\u0438 \u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0448\u043e\u043a\u0430 (\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 D).\n\u2022 \u0424\u0435\u043d\u0438\u043b\u044d\u0444\u0440\u0438\u043d\u043d\u0435\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\u0448\u043e\u043a\u0430, \u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c\n\u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u043a\u043e\u0433\u0434\u0430 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043d\u043e\u0440\u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430\u0441\u0432\u044f\u0437\u0430\u043d\u043e \u0441 \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u044b\u043c\u0438\u0430\u0440\u0438\u0442\u043c\u0438\u044f\u043c\u0438, \u0441\u043d\u0438\u0436\u0435\u043d\n\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u044b\u0439 \u0432\u044b\u0431\u0440\u043e\u0441, \u0441\u0442\u043e\u0439\u043a\u043e \u0441\u043d\u0438\u0436\u0435\u043d\u043d\u043e\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441\u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043e\u043c \u0438\u043d\u0438\u0437\u043a\u0438\u043c\u0438 \u0434\u043e\u0437\u0430\u043c\u0438\u0432\u0430\u0437\u043e\u043f\u0440\u0435\u0441\u0441\u0438\u043d\u0430, \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0446\u043