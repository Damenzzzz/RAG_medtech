{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_c03863058aa7", "title": "\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418, \u0412\u042b\u0417\u0412\u0410\u041d\u041d\u042b\u0415 \u0412\u0418\u0420\u0423\u0421\u041e\u041c \u041f\u0420\u041e\u0421\u0422\u041e\u0413\u041e \u0413\u0415\u0420\u041f\u0415\u0421\u0410", "source_file": "2025_\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418_\u0412\u042b\u0417\u0412\u0410\u041d\u041d\u042b\u0415_\u0412\u0418\u0420\u0423\u0421\u041e\u041c_\u041f\u0420\u041e\u0421\u0422\u041e\u0413\u041e_\u0413\u0415\u0420\u041f\u0415\u0421\u0410_d0fedf8717.pdf", "icd_codes": "G02.0, G05.1", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0418\u041d\u0424\u0415\u041a\u0426\u0418\u0418, \u0412\u042b\u0417\u0412\u0410\u041d\u041d\u042b\u0415 \u0412\u0418\u0420\u0423\u0421\u041e\u041c \u041f\u0420\u041e\u0421\u0422\u041e\u0413\u041e \u0413\u0415\u0420\u041f\u0415\u0421\u0410.pdf"}, "page_content": "\u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435\n\u0434\u043b\u044f\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0412\u0435\u0442\u0440\u044f\u043d\u0430\u044f \u043e\u0441\u043f\u0430 \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0418\u0424\u0410 \u043d\u0430 Ig\u041c \u043a \u0432\u0438\u0440\u0443\u0441\u0443 Herpeszoster. \u0422\u043e\u043b\u0447\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0435 -\n\u0441\u044b\u043f\u044c, \u0427\u0430\u0449\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0441\u044b\u043f\u0438\n\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043a\u043b\u0438\u043d\u0438\u043a\u0438. (\u043f\u044f\u0442\u043d\u043e\uf0ae\u043f\u0430\u043f\u0443\u043b\u0430\uf0ae\u0432\u0435\u0437\u0438\u043a\u0443\u043b\u0430\uf0ae\u043a\u043e\u0440\u043e\u0447\u043a\u0430)\n\u041e\u043f\u043e\u044f\u0441\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0418\u0424\u0410 \u043d\u0430 Ig\u041c \u043a \u0432\u0438\u0440\u0443\u0441\u0443 Herpeszoster. \u0412\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0435 \u043f\u043e \u0445\u043e\u0434\u0443 \u043d\u0435\u0440\u0432\u043e\u0432\n\u0433\u0435\u0440\u043f\u0435\u0441 \u0441\u044b\u043f\u044c, \u0427\u0430\u0449\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 (\u0441\u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0432\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c) \u0441\n\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043a\u043b\u0438\u043d\u0438\u043a\u0438. \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u043c \u0431\u043e\u043b\u0435\u0432\u044b\u043c \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u043e\u043c\n\n\u041f\u0443\u0437\u044b\u0440\u0447\u0430\u0442\u043a\u0430 \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0441\u0435\u0432 \u0433\u043d\u043e\u0439\u043d\u043e\u0433\u043e \u0422\u043e\u043b\u0447\u043a\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u043e\u0435 \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u0435, \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0435\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0441\u044b\u043f\u044c, \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0438\u0437 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0441\u044b\u043f\u0438 \u043d\u0430 \u044d\u043a\u0437\u0430\u043d\u0442\u0435\u043c\u044b \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 14 \u0434\u043d\u0435\u0439 \u0436\u0438\u0437\u043d\u0438\n\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u043c\u0438\u043a\u0440\u043e\u0444\u043b\u043e\u0440\u0443.\n\u0421\u0442\u0440\u0435\u043f\u0442\u043e\u0434\u0435\u0440\u043c\u0438\u044f \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0411\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u0441\u0435\u0432 \u041d\u0435\u0442 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438, \u0432\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u044b\u043f\u044c \u0441\n\u0441\u044b\u043f\u044c \u043d\u0430 \u043a\u043e\u0436\u0435 \u043e\u0442\u0434\u0435\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0438\u0437 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0441\u044b\u043f\u0438 \u043d\u0430 \u0433\u043d\u043e\u0439\u043d\u044b\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u043c\n\u043c\u0438\u043a\u0440\u043e\u0444\u043b\u043e\u0440\u0443\n\n\u041f\u0443\u0441\u0442\u0443\u043b\u0435\u0437\u043d\u044b\u0439 \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u041d\u0435\u0442 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u043a \u043f\u0443\u0441\u0442\u043e\u0442\u0435\u043b\u044b\u0445,\n\u0441\u0438\u0444\u0438\u043b\u0438\u0434 \u0441\u044b\u043f\u044c \u043d\u0430 \u043a\u043e\u0436\u0435 \u0441\u0438\u0444\u0438\u043b\u0438\u0441 \u0442\u0430\u043a \u0438 \u043f\u0430\u043f\u0443\u043b\u0435\u0437\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432\n\n\u042d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u0412\u0435\u0437\u0438\u043a\u0443\u043b\u0435\u0437\u043d\u0430\u044f \u041f\u0426\u0420 \u043d\u0430 \u044d\u043d\u0442\u0435\u0440\u043e\u0432\u0438\u0440\u0443\u0441\u044b \u041c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u042d\u0412\u0418 \u2013\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0441\u044b\u043f\u044c \u0433\u0435\u0440\u043f\u0430\u043d\u0433\u0438\u043d\u0430, \u043a\u0430\u0442\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u0434\u0438\u0430\u0440\u0435\u044f,\n\u043c\u0438\u0430\u043b\u0433\u0438\u044f, \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0438\u0442, \u043f\u043e\u043b\u0438\u0440\u0430\u0434\u0438\u043a\u0443\u043b\u043e\u043d\u0435\u0432\u0440\u0438\u0442.\n\n3.\u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1,2,4,5,8,9,10]:\n\u041d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0434\u0435\u0442\u0438 \u0441 \u043b\u0435\u0433\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u044c\u044e \u0442\u044f\u0436\u0435\u0441\u0442\u0438.\n\u041f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u044d\u0442\u0438\u043e\u0442\u0440\u043e\u043f\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 \u0418\u0424\u041d.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u0420\u0435\u0436\u0438\u043c:\n\u2022 \u041f\u043e\u043b\u0443\u043f\u043e\u0441\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c (\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438).\nNB! \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u044b \u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e: \u0443\u0445\u043e\u0434 \u0437\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u043c\u0438 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u043c\u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430,\n\n\u0433\u043b\u0430\u0437, \u0442\u0443\u0430\u043b\u0435\u0442 \u043d\u043e\u0441\u0430.\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0421\u0442\u043e\u043b No13; \u0434\u0440\u043e\u0431\u043d\u043e\u0435 \u0442\u0435\u043f\u043b\u043e\u0435 \u043f\u0438\u0442\u044c\u0435,\u043c\u043e\u043b\u043e\u0447\u043d\u043e-\u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0434\u0438\u0435\u0442\u0430.\n\n3.2\u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u0441 \u0446\u0435\u043b\u044c\u044e \u0434\u0435\u0441\u0435\u043d\u0441\u0438\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0445\u043b\u043e\u0440\u043e\u043f\u0438\u0440\u0430\u043c\u0438\u043d 1-2 \u043c\u0433/\u043a\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 \u0440\u043e\u0442 \u0438\u043b\u0438\n\u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e, \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5-7 \u0434\u043d\u0435\u0439;\n\u043c\u0435\u0441\u0442\u043d\u043e: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c 5% \u043c\u0430\u0437\u044c \u0430\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440\u0430, 4-6 \u0430\u043f\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0439; \u0438\u043b\u0438 1% \u0441\u043f\u0438\u0440\u0442\u043e\u0432\u043e\u0433\u043e\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0431\u0440\u0438\u043b\u043b\u0438\u0430\u043d\u0442\u043e\u0432\u043e\u0439 \u0437\u0435\u043b\u0435\u043d\u0438 (\u0423\u0414 D)\u0438\u043b\u0438 2% \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u043e\u043c \u043f\u0435\u0440\u043c\u0430\u043d\u0433\u0430\u043d\u0430\u0442\u0430 \u043a\u0430\u043b\u0438\u044f(\u0423\u0414\n\nD); \u0432\u044b\u0441\u044b\u043f\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0445 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430\u0445 \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0432\u043e\u0434\u043d\u044b\u043c\u0438 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\u043c\u0438\n\u0430\u043d\u0438\u043b\u0438\u043d\u043e\u0432\u044b\u0445 \u043a\u0440\u0430\u0441\u0438\u0442\u0435\u043b\u0435\u0439;\n\u2022 \u043f\u0440\u0438 \u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442\u0435, \u0433\u0438\u043d\u0433\u0438\u0432\u0438\u0442\u0435 \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0430\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440\u0430 100 \u043c\u0433 (\u0434\u0435\u0442\u044f\u043c \u0434\u043e 2-\u0445 \u043b\u0435\u0442), 200 \u043c\u0433\n(\u0434\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 2-\u0445 \u043b\u0435\u0442) 5 \u0440\u0430\u0437 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u0434\u043d\u0435\u0439 \u0432 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u043c\n\n\u0440\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u043c \u0418\u0424\u041d \u0430\u043b\u044c\u0444\u0430-2b \u0432 \u0432\u0438\u0434\u0435 \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0435\u0432 150000 \u041c\u0415,\n500000 \u041c\u0415, 1000000 \u041c\u0415; \u043f\u043e 1 \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044e 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e 10 \u0434\u043d\u0435\u0439;\n\u041f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0435\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0443\u0440\u0441\u043e\u0432\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0440\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u043c\n\u0418\u0424\u041d \u0430\u043b\u044c\u0444\u0430-2b \u0432 \u0432\u0438\u0434\u0435 \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0435\u0432 150000\u041c\u0415, 500000 \u041c\u0415, 1000000\n\n\u041c\u0415 \u043f\u043e 1 \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044e 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e.\n\u041a\u043b\u0438\u043d\u0438\u043a\u043e-\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u043a\u043e\u043d\u0432\u0430\u043b\u0435\u0441\u0446\u0435\u043d\u0442\u043e\u0432 \u043a\u0430\u0436\u0434\u044b\u0435 6 \u043c\u0435\u0441., \u0441\u0430\u043d\u0430\u0446\u0438\u044f\n\u043e\u0447\u0430\u0433\u043e\u0432 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438.\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:[1,2,4,5,8,9,10]\n\nNo \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0423\u0414\n\u043f/\u043f\n\u041d\u0443\u043a\u043b\u0435\u043e\u0437\u0438\u0434\u044b \u0438 \u043d\u0443\u043a\u043b\u0435\u043e\u0442\u0438\u0434\u044b\n1. \u0410\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440, \u0442\u0430\u0431., 200 \u043c\u0433; 400 \u043c\u0433, \u043f\u043e\u0440\u043e\u0448\u043e\u043a \u0434\u043b\u044f \u0413\u0435\u0440\u043f\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0410\n\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 \u0434\u043b\u044f \u0438\u043d\u0444\u0443\u0437\u0438\u0439 250 \u043c\u0433 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f\n\n\u0418\u043d\u0442\u0435\u0440\u0444\u0435\u0440\u043e\u043d\u044b\n2. \u0420\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0439 \u0418\u0424\u041d \u0430\u043b\u044c\u0444\u0430-2b, \u0441\u0443\u043f\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0435, \u0412\n\u043f\u043e 150000\u041c\u0415, 500000\u041c\u0415, 1000000\u041c\u0415 \u0438\u043c\u043c\u0443\u043d\u043e\u043c\u043e\u0434\u0443\u043b\u0438\u0440\u0443\u044e\n\n\u0449\u0435\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n3. \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b\u0441\u0438\u0440\u043e\u043f 60 \u043c\u043b \u0438 100\u043c\u043b, \u0432 5 \u043c\u043b \u2013 125 \u0410\u043d\u0430\u043b\u044c\u0433\u0435\u0437\u0438\u0440\u0443\u044e\u0449\u0435\u0435, \u0410\n\u043c\u0433; \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043f\u043e 0,2 \u0433 \u0438 0,5 \u0433; \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\n\n\u044c\u043d\u043e\u0435,\n\u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0435.\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n4. \u043a\u0440\u0435\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f 5%5 \u0433, \u043c\u0430\u0437\u044c \u043c\u0435\u0441\u0442\u043d\u043e, \u043d\u0430 \u043a\u043e\u0436\u0443 \u0410\n\n2,5% 5 \u0433\n\n\u0410\u043d\u0442\u0438\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u043d\u044b\u0439\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\n\n5. \u0425\u043b\u043e\u0440\u043e\u043f\u0438\u0440\u0430\u043c\u0438\u043d\u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 0,025, \u0430\u043c\u043f\u0443\u043b\u044b 2% \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0438 \u0421\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043f\u043e 1 \u043c\u043b \u043b\u0435\u0447\u0435\u043d\u0438\u0435\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\n\u043a\u0438\u0445\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439.\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432:\n\nNo \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421 \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0414\n\u043f/\u043f\n\u041f\u0440\u043e\u0447\u0438\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u0438 \u0434\u0435\u0437\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n1-\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0441\u043f\u0438\u0440\u0442\u043e\u0432\u043e\u0439 1% \u043f\u043e 10 \u043c\u043b \u0438 20 \u043c\u043b \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u0421\n\u043f\u0435\u0440\u043c\u0430\u043d\u0433\u0430\u043d\u0430\u0442\u0430 \u043a\u0430\u043b\u0438\u044f\u043f\u043e\u0440\u043e\u0448\u043e\u043a 5 \u0433 \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u0421\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.4 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435:\n\n\u2022 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u043e\u0441\u043c\u043e\u0442\u0440 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u