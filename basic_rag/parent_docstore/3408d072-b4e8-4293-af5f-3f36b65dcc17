u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043f\u0440\u0438\u043c\u0435\u0441\u044c \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u0414,\n\n\u043a\u0440\u043e\u0432\u0438 \u0432 \u043c\u043e\u0447\u0435, \u043f\u0430\u043b\u044c\u043f\u0438\u0440\u0443\u043c\u0430\u044f \u043f\u0430\u043b\u044c\u043f\u0438\u0440\u0443\u0435\u043c\u0430\u044f \u043e\u043f\u0443\u0445\u043e\u043b\u044c\n\u043e\u043f\u0443\u0445\u043e\u043b\u044c, \u043f\u043e\u0442\u0435\u0440\u044f \u0432\u0435\u0441\u0430\n\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0445\n\u0434\u0430\u043d\u043d\u044b\u0435 \u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430, \u044d\u0440\u0438\u0442\u0440\u043e-\u0446\u0438\u0442\u043e\u0432, \u043a\u0440\u043e\u0432\u0438 \u0438 \u043c\u043e\u0447\u0438\n\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u041e\u042d, \u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u044f \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f \u0440\u0435\u0434\u043a\u043e\n\u0414\u0430\u043d\u043d\u044b\u0435 \u0423\u0417\u0418 \u0412 \u043f\u043e\u0447\u043a\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0412 \u043f\u043e\u0447\u043a\u0435 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u044d\u0445\u043e\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0435 \u0442\u043a\u0430\u043d\u0435\u0432\u043e\u0439 \u043e\u043a\u0440\u0443\u0433\u043b\u043e\u0435 \u044d\u0445\u043e\u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e\u0435\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u0447\u0435\u0442\u043a\u0438\u043c\u0438\n\n\u0444\u043e\u0440\u043c\u044b, \u0431\u0435\u0437 \u0447\u0435\u0442\u043a\u0438\u0445 \u043a\u043e\u043d\u0442\u0443\u0440\u043e\u0432 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438,\n\u043f\u0440\u043e\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u0435 \u0427\u041b\u0421 \u0438\u043b\u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0443\u044e\u0449\u0435\u0435\u0441\u044f\n\u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0443\u044e \u0437\u0430\u0431\u0440\u044e\u0448\u0438\u043d\u043d\u0443\u044e \u0438\u043d\u0442\u0440\u0430\u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u043d\u043e \u0438\u043b\u0438\n\u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0443 \u044d\u043a\u0441\u0442\u0440\u0430\u0440\u0435\u043d\u0430\u043b\u044c\u043d\u043e\n\u0414\u0430\u043d\u043d\u044b\u0435 \u041a\u0422 \u0412 \u043f\u043e\u0447\u043a\u0435 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043a\u0430\u043d\u0435\u0432\u043e\u0435 \u0412 \u043f\u043e\u0447\u043a\u0435 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\n\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0439 \u0438\u043b\u0438 \u043e\u043a\u0440\u0443\u0433\u043b\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\n\u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b \u0441 \u0447\u0435\u0442\u043a\u0438\u043c\u0438 \u043a\u043e\u043d\u0442\u0443\u0440\u0430\u043c\u0438 \u0438\n\u0434\u0435\u043d\u0441\u0438\u0442\u043e\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0438 \u0441\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u043c\u0438 \u0434\u0