38\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\u0410\u043d\u0442\u0438\u043f\u0438\u0440\u0435\u0442\u0438\u043a \u041f\u0430\u0440\u0430\u0446\u0435\u0442\u0430\u043c\u043e\u043b 200 \u043c\u0433,\n500 \u043c\u0433 \u0442\u0430\u0431;\n\u0420\u0430\u0437\u043e\u0432\u044b\u0435 \u0434\u043e\u0437\u044b \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430\n\u0432\u043d\u0443\u0442\u0440\u044c \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 10-15 \u043c\u0433/\u043a\u0433.\n\u0421\u0440\u0435\u0434\u043d\u044f\u044f \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u043f\u0440\u0438\n\n\u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438\n\u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 10-12 \u043c\u0433/\u043a\u0433\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.4 \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0448\u043b\u044f;\n\u2022 \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0414\u041d;\n\n\u2022 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0427\u0414;\n\u2022 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044f \u0438 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u0