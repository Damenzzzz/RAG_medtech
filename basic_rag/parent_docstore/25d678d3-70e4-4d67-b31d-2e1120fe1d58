43c\u043a\u043d \u0432\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u043e\u043d\u0435.\n\n2.1 \u043b\u0435\u0447\u0435\u0431\u043d\u043e-\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c:\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435, \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435,\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\nI \u0441\u0442\u0430\u0434\u0438\u044f II \u0441\u0442\u0430\u0434\u0438\u044f III \u0441\u0442\u0430\u0434\u0438\u044f IV \u0441\u0442\u0430\u0434\u0438\u044f\n\n\u041c\u044f\u0433\u043a\u0430\u044f \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430\u044f \u043b\u0438\u043d\u0437\u0430 (\u041c\u041a\u041b)\n\n\u0424\u0422\u041a, \u043a\u0440\u043e\u0441\u0441\u043b\u0438\u043d\u043a\u0438\u043d\u0433\n\n\u0422\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b\n\n2.2 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444. \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u043f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u043e\u0442\u0435\u043a \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b 1. \u0431\u0438\u043e\u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u2013 1. \u0412 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435\n\u043a\u0435\u0440\u0430\u0442\u043e\u043f\u0430\u0442\u0438\u044f \u043e\u0442\u0435\u043a \u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\u0424\u0443\u043a\u0441\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439, \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430\n\n\u0431\u0443\u043b\u043b\u044b / \u044d\u0440\u043e\u0437\u0438\u0438 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435\n2. \u0423\u0417\u0418 \u2013 \u0431\u0435\u0437 \u0432\u0438\u0434\u0438\u043c\u043e\u0439 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430,\n\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0439 \u0442\u0440\u0430\u0432\u043c\u044b,\n\n\u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u043e\u0441\u0442\u0440\u044b\u0435/\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 / \u0442\u0440\u0430\u0432\u043c \u0432\u043d\u0443\u0442\u0440\u0438\u0433\u043b\u0430\u0437\u043d\u044b\u0435\n2. \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u0430\u0445\u0438\u043c\u0435\u0442\u0440\u0438\u044f \u2013 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u043e\u0442\u0435\u043a \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b;\n\n\u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b 2. \u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0432\u0441\u0435\u0433\u0434\u0430\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439/\u0434\u0438\u0444\u0444\u0443\u0437\u043d\u044b\u0439 \u0434\u0432\u0443\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0439;\n\u0441\u0432\u044b\u0448\u0435 1000 \u043c\u043a\u043d \u0432 3. \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439, \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d-\n\n\u043f/\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u043e\u043d\u0435. \u043d\u043e\u0441\u0442\u044c.\n\n\u043a\u0435\u0440\u0430\u0442\u0438\u0442 \u043e\u0442\u0435\u043a \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b 1. \u0431\u0438\u043e\u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u2013 1. \u0412 \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435\n\u043e\u0442\u0435\u043a \u0447\u0430\u0449\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439, \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430\n\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0439; \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e\n\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u043a\u0440\u043e\u0442\u0440\u0430\u0432\u043c\u0443, \u043e\u0436\u043e\u0433,\n\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442, \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0439 \u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u041c\u041a\u041b,\n\u0441\u043e\u0445\u0440\u0430\u043d\u043d\u044b\u0439 / \u043d\u0435\u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\n\u0434\u0435\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0432 \u0437\u043e\u043d\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u044b,\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0430 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435,\n\n2. \u0423\u0417\u0418 \u2013 \u0431\u0435\u0437 \u0432\u0438\u0434\u0438\u043c\u043e\u0439 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u0443\u044e \u041e\u0420\u0412\u0418,\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442.\u043f.;\n\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0439 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430\n\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 / \u0442\u0440\u0430\u0432\u043c \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435\n2. \u041a\u0435\u0440\u0430\u0442\u043e\u043f\u0430\u0445\u0438\u043c\u0435\u0442\u0440\u0438\u044f \u2013 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043e\u0442\u0435\u043a \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.\n\u043d\u0435\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439, \u043c\u0435\u043d\u0435\u0435 2. \u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0447\u0430\u0449\u0435\n\n800/1000 \u043c\u043a\u043d \u0432 \u043e\u0434\u043d\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0439;\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 / 3. \u0413\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u043f/\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u043e\u043d\u0435. \u043f\u0440\u0435\u0434\u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d-\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u043d\u043e\u0441\u0442\u044c \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442\n\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435.\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\u2022 \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f: \u043a\u0435\u0440\u0430\u0442\u043e\u043f\u0440\u043e\u0442\u0435\u043a\u0442\u043e\u0440\u043d\u0430\u044f, \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0433\u043e\n\n\u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u041f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0433\u043e \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u2013 \u0438\u043d\u0441\u0442\u0438\u043b\u043b\u044f\u0446\u0438\u0438\n\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432, \u043f\u0440\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0438 \u0412\u0413\u0414 \u2013 \u0438\u043d\u0441\u0442\u0438\u043b\u043b\u044f\u0446\u0438\u0438 \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432.\n\u2022 \u041c\u041a\u041b \u0441 \u0446\u0435\u043b\u044c\u044e \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b.\n\u2022 \u0444\u0438\u0437\u0438\u043e\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u0442\u0435\u043a\u0430 \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b.\n\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\u2022 \u0420\u0435\u0436\u0438\u043c: III;\n\n\u2022 \u0414\u0438\u0435\u0442\u0430: \u0421\u0442\u043e\u043b No15.\n\u041c\u044f\u0433\u043a\u0438\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u044b\u0435 \u043b\u0438\u043d\u0437\u044b \u0433\u0438\u0434\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0435, \u0441\u0438\u043b\u0438\u043a\u043e\u043d-\u0433\u0438\u0434\u0440\u043e\u0433\u0435\u043b\u0435\u0432\u044b\u0435, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e\n\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0441\u043e \u0441\u043c\u0435\u043d\u043e\u0439 \u043a\u0430\u0436\u0434\u044b\u0435 2 \u043d\u0435\u0434\u0435\u043b\u0438 \u2013 \u0441 \u0446\u0435\u043b\u044c\u044e \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n[12].\n\n\u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f:\n\u2022 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u044d\u0440\u043e\u0437\u0438\u0438,\n\u2022 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u0435 \u043a \u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n\u0424\u0438\u0437\u0438\u043e\u043b\u0435\u0447\u0435\u043d\u0438\u0435: He-Ne (\u0433\u0435\u043b\u0438\u0439-\u043d\u0435\u043e\u043d\u043e\u0432\u044b\u0439) \u043b\u0430\u0437\u0435\u0440 \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0440\u043e\u0433\u043e\u0432\u0438\u0446\u044b \u0441\n\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439, \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u0442\u0435\u0447\u043d\u043e\u0439 \u0446\u0435\u043b\u044c