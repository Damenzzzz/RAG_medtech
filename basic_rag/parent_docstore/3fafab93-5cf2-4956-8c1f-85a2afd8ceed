440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438\nBrucella, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043b\u0438\u043a\u0432\u043e\u0440\u0435, \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0418\u0424\u0410\n\u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043d\u0443\u0442\u0440\u0438\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439\n\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438) \u0430\u0440\u0442\u0440\u0438\u0442\u0430, \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438,\n\u043d\u0435\u0444\u0440\u0438\u0442, \u0440\u0435\u0436\u0435 \u043c\u0438\u043a\u0440\u043e\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043f\u043e\u0441\u0435\u0432\u044b\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0441\u043e\u0441\u0443\u0434\u0438\u0441\n\n\u0442\u043e\u0439 \u0438 \u043d\u0435\u0440\u0432\u043d\u043e\u0439\n\u041f\u0426\u0420 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u2013 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u0441\u0438\u0441\u0442\u0435\u043c,\n\u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0414\u041d\u041a \u0438 \u0420\u041d\u041a \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0414\u041d\u041a \u0438\n\u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0420\u041d\u041a \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f\n\u043c\u0438\u0433\u0440\u0438\u0440\u0443\u044e\u0449\u0435\u0439\n\u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420\n\u043a\u043e\u043b\u044c\u0446\u0435\u0432\u0438\u0434\u043d\u043e\u0439\n\u044d\u0440\u0438\u0442\u0435\u043c\u044b.\n\u041b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437,\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0421\u0420\u0411\n\n\u041f\u0430\u0440\u0430\u0437\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u041f\u0435\u0440\u0435\u043c\u0435\u0436\u0430\u044e\u0449\u0430\u044f\u0441 \u0410\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u2013 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0414\u041d\u041a\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0442\u043e\u043b\u0441\u0442\u044b\u0435 \u043a\u0430\u043f\u043b\u0438 \u0438 \u0442\u043e\u043d\u043a\u0438\u0439 \u043c\u0430\u043b\u044f\u0440\u0438\u0439\u043d\u043e\u0433\u043e\n(\u043c\u0430\u043b\u044f\u0440\u0438\u044f) \u0441 \u043e\u0437\u043d\u043e\u0431\u043e\u043c, \u043c\u0430\u0437\u043e\u043a (\u043d\u0435 \u043c\u0435\u043d\u0435\u0435 100 \u043f\u043b\u0430\u0437\u043c\u043e\u0434\u0438\u044f \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0438 \u043f\u043e\u043b\u0435\u0439 \u0437\u0440\u0435\u043d\u0438\u044f \u0432 \u0442\u043e\u043b\u0441\u0442\u043e\u0439 \u041f\u0426\u0420 \u0432 \u043a\u0440\u043e\u0432\u0438\n\n\u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u043a\u0430\u043f\u043b\u0435)\n\u0442\u043e\u0448\u043d\u043e\u0442\u0430 \u0438\n\u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u044c.\n\u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\n\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430,\n\u043b\u0435\u0433\u043a\u0438\u0445, \u043f\u043e\u0447\u0435\u043a \u0438\n\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u043a\u0438\u0448\u0435\u0447\n\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430.\n\n\u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0421\u041e\u042d.\n\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u043d\u0430 \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0435 \u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f, \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0431\u0430\u043a.\n\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0441\u0432\u0435\u0447\u0438 \u0434\u043e 38- \u0431\u0430\u043a\u043f\u043e\u0441\u0435\u0432 \u043f\u043e\u0441\u0435\u0432\u044b \u043d\u0430\n39\u00b0\u0421; \u043f\u0435\u0440\u0438\u043a\u0430\u0440\u0434\u0438\u0442, \u043c\u0438\u043a\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0438\n\n\u043f\u043b\u0435\u0432\u0440\u0438\u0442, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430\n\u043c\u0438\u043a\u0440\u043e\u043f\u043e\u043b\u0438\u0430\u0434\u0435\u043d\u0438\n\u041f\u0426\u0420 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u044f, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b\n\u0433\u043b\u0430\u0437, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\n\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0440\u0435\u0434\n\u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432, \u043a\u043e\u0441\u0442\u0435\u0439\n\u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u041e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439\n\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0445\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0438\u043d\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u0431 \u0430\u043d\u0430\u043b\u0438\u0437 GeneXpert.,\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 (\u043f\u043b\u0435\u0432\u0440\u0438\u0442,\n\u0414\u0438\u0430\u0441\u043a\u0438\u043d \u0442\u0435\u0441\u0442/\n\u043f\u0435\u0440\u0438\u043a\u0430\u0440\u0434\u0438\u0442 \u0438 \u0434\u0440.)\n\u041a\u0432\u0430\u043d\u0442\u0438\u0444\u0435\u0440\u043e\u043d\u043e\u0432\u044b\u0439\n\u041b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0438\n\u0442\u0435\u0441\u0442\n\u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0421\u041e\u042d.\n\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041e\u0413\u041a, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0438\n\u041f\u0440\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438\n\u041a\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u041a\u0422 \u041e\u0413\u041a: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u043c\u0438\u043a\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f\u043c\u0438\n\u043a\u043b\u0435\u0442\u043a\u0438 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0437\u0430\u0442\u0435\u043d\u0435\u043d\u0438\u044f,\n\u043f\u043e\u0447\u0435\u043a \u0438\n\u043a\u043e\u043b\u044c\u0446\u0435\u0432\u0438\u0434\u043d\u043e\u0439 \u0442\u0435\u043d\u0438 \u0432\n\u043c\u043e\u0447\u0435\u0432\u044b\u0432\u043e\u0434\u044f\u0449\u0438\u0445\n\u043f\u0443\u0442\u0435\u0439 \u2014\n\u043b\u0435\u0433\u043e\u0447\u043d\u043e\u043c \u043f\u043e\u043b\u0435\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041e\u0413\u041a, \u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u041a\u0422\n\u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\u0430. \u041a\u0422 \u043f\u043e\u0440\u0430\u0436\u0451\u043d\u043d\u044b\u0445 \u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432:\n\u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432\n\u0434\u0435\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0441\n\u043a\u043e\u0441\u0442\u043d\u044b\u043c\u0438\n\u0441\u0435\u043a\u0432\u0435\u0441\u0442\u0440\u0430\u043c\u0438,\n\u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u043e\u0433\u043e\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u0441\u0442\u0435\u0439 \u0438\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0442\u0435\u043d\u0438\n\u043c\u044f\u0433\u043a\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 (\u0437\u0430\n\u0441\u0447\u0435\u0442 \u0430\u0431\u0441\u0446\u0435\u0441\u0441\u0430)\n\n\u0411\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043e\u0447\u0430\u0433\u043e\u0432\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 \u0432\n\u0431\u0440\u043e\u043d\u0445\u0430\u0445\n\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0435 \u0434\u0435\u0444\u0435\u043a\u0442\u044b \u0438\u043c\u043c\u0443\u043d\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b:\n\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0435 \u041f\u043e\u043b\u0438\u043c\u043e\u0440\u0444\u0438\u0437\u043c \u0418\u043c\u043c\u0443\u043d\u043e\u0444\u0435\u043d\u043e\u0442\u0438\u043f\u0438\u0440\u043e\u0432\u0430 \u0418\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\n\u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0438\u0435 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432. \u0442\u0435\u0441\u0442\u044b: \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435\n\u0438\u0442\u044b \u043a\u0430\u0440\u0442\u0438\u043d\u044b,. \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0412-\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043a\u043b\u0435\u0442\u043e\u043a \u0438\u043b\u0438\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445\n\u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0443\u0431\u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0438\u0439 \u0412-", "type": "Document"}}