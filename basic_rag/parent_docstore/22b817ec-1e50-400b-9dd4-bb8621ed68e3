430\u043d\u043e\u0432 \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0441\u043f\u0440\u0430\u0432\u0430 \u043e\u0442 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0447\u0435\u0440\u0435\u0437 \u043f\u0443\u043f\u043e\u0447\u043d\u043e\u0435 \u043a\u043e\u043b\u044c\u0446\u043e \u0441\n\u043f\u0443\u043f\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u0446\u0430. \u041a\u043b\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u044b\u0436\u0435\u0432\u044b\u043c \u043c\u0435\u0448\u043a\u043e\u043c. \u041a\u043b\u0438\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u043f\u0443\u043f\u043e\u0432\u0438\u043d\u044b \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u0434\u043e 10 \u0441\u043c \u043f\u0443\u043f\u043e\u0432\u0438\u043d\u044b \u043d\u0430 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0438 15-20 \u0441\u043c\n\n\u0411\u0435\u0437 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0438 \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445 \u0421 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435\u043c \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438\u043b\u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430\n\n\u2022 \u0412 \u0436\u0435\u043b\u0443\u0434\u043e\u043a \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u044b\u0439 \u0437\u043e\u043d\u0434 \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0438 \u0434\u043b\u044f \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438\n\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0433\u043e;\n\u2022 \u0414\u0435\u0442\u044f\u043c \u0441 \u043d\u0438\u0437\u043a\u043e\u0439 \u043e\u0446\u0435\u043d\u043a\u043e\u0439 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 \u0410\u043f\u0433\u0430\u0440 (1-3 \u0431\u0430\u043b\u043b\u0430) \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f;\n\u2022 \u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043f\u0443\u043f\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0433\u043e \u043a\u0430\u0442\u0435\u0442\u0435\u0440\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0442\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u043e\u0433\u043e\n\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u0435\u0440\u0434\u0446\u0430 \u0438 \u043f\u0435\u0447\u0435\u043d\u0438, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u0430\u0442\u0435\u0442\u0435\u0440-\u043b\u0438\u043d\u0438\u044e, \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0435\u043d\u043e\u0437\u043d\u044b\u0439\n\u043a\u0430\u0442\u0435\u0442\u0435\u0440, \u0437\u0430\u0432\u043e\u0434\u0438\u043c\u044b\u0439 \u0447\u0435\u0440\u0435\u0437 \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0432\u0435\u043d\u0443;\n\u2022 \u041d\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0433\u0440\u044b\u0436\u0435\u0432\u043e\u0433\u043e \u043c\u0435\u0448\u043a\u0430 \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442 \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u043e\u0432\u0443\u044e (\u043f\u043e\u043b\u0438\u044d\u0442\u0438\u043b\u0435\u043d\u043e\u0432\u0443\u044e) \u0442\u0435\u0440\u043c\u043e\u0438\u0437\u043e\u043b\u0438\u0440\u0443\u044e\u0449\u0430\u044e \u043f\u043e\u0432\u044f\u0437\u043a\u0443 \u0438\u043b\u0438\n\u0441\u0443\u0445\u0443\u044e \u0432\u0430\u0442\u043d\u043e-\u043c\u0430\u0440\u043b\u0435\u0432\u0443\u044e \u043f\u043e\u0432\u044f\u0437\u043a\u0443\n\n\u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0432 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u043c \u043a\u044e\u0432\u0435\u0437\u0435 \u0432 \u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0432 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u043c \u043a\u044e\u0432\u0435\u0437\u0435 \u0432\n\u041e\u0420\u041d \u0438\u043b\u0438 \u043d\u0430 3 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043d\u0430 \u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u041e\u0420\u041d, \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0434\u0435\u0442\u0441\u043a\u0443\u044e (\u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u0443\u044e)\n\u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0439\u043a\u0438 \u0438\u043b\u0438 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0431\u0440\u0438\u0433\u0430\u0434\u0443.\n\u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0438 2-\u0445 \u0447\u0430\u0441\u043e\u0432\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430 \u043f\u043e \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438\n\u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439.\n\u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0447\u0435\u0440\u0435\u0437 6-8 \u0447\u0430\u0441\u043e\u0432\n\u041e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0438\n\n\u043d\u0435\u043d\u0430\u0442\u043e\u043b\u043e\u0433 \u0414\u0435\u0442\u0441\u043a\u0438\u0439 (\u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439) \u0445\u0438\u0440\u0443\u0440\u0433\n\n1.\u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0413\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u043e\u0431\u0449\u0435\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043b\u0438\u0437\u043c\u0430 (\u0435\u0441\u043b\u0438 \u043d\u0435\u0442\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f ( \u041e\u0410\u041a, \u041a\u0429\u0421, \u043d\u0435\u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0436.\u043a.\u0442.)\n\u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437\n\u043a\u0440\u043e\u0432\u0438, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b \u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u043a\u0440\u043e\u0432\u0438 \u0438 \u0440\u0435\u0437\u0443\u0441 \u0444\u0430\u043a\u0442\u043e\u0440\u0430, \u0423\u0417\u0418,\n\u043e\u0431\u0437\u043e\u0440\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0438\n1.\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 1.\u0423\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u0437 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438, \u041d\u0421\u0413,\n\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u043f\u0430\u0440\u0435\u043d\u0445\u0435\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u042d\u0425\u041e\u041a\u0413)\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438 2. \u041d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043a\u0438\u0448\u0435\u0447\u043d\u044b\u0445 \u0441\u0442\u043e\u043c\n2. \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n2.\u041e\u0442\u0441\u0440\u043e\u0447\u0435\u043d\u043d\u0430\u044f \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 3.\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u043e\u0439\n\u043f\u0440\u0435\u0434\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e\n(\u0441\u0438\u043b\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430) \u0447\u0435\u0440\u0435\u0437 7-10 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0439 \u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u0441\u0442\u0435\u043d\u043a\u0438\n26\n\u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0443\n\u0434\u043d\u0435\u0439 \u0432\u0442\u043e\u0440\u043e\u0439 \u044d\u0442\u0430\u043f 2.\u041e\u0442\u0441\u0440\u043e\u0447\u0435\u043d\u043d\u0430\u044f \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430\n3. \u041f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 (\u0441\u0438\u043b\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430) 7-10 \u0434\u043d\u0435\u0439 \u0432\u0442\u043e\u0440\u043e\u0439 \u044d\u0442\u0430\u043f\n\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438", "type": "Document"}}