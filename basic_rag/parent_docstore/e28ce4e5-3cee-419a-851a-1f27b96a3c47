5\u043d\u0442,\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043a\u0443\u0440\u0441\u043e\u043c \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438, \u043e\u0440\u0442\u043e\u043f\u0435\u0434\u0438\u0438 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439 No1\n\n\u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb.\n\n4) \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043d\u0435 \u0440\u0435\u0436\u0435 1 \u0440\u0430\u0437\u0430 \u0432 5 \u043b\u0435\u0442 \u0438 \u043d\u0435 \u0447\u0430\u0449\u0435 1\n\u0440\u0430\u0437\u0430 \u0432 3 \u0433\u043e\u0434\u0430 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043d\u043e\u0432\u044b\u0445 \u043c\u0435\u0442\u043e\u0434\u043e\u0432 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c\n\n\u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438;\n\n5) \u0421\u043f\u0438\u0441\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044b:\n1.National Institute for Health and Care Excellence. Osteoarthritis in over 16s: diagnosis\n\nand management (NG226). London: NICE; 2022.\n2.Kolasinski SL, Neogi T, Hochberg MC, et al. 2020 American College of\nRheumatology/Arthritis Foundation Guideline for the Management of Osteoarthritis of the\nHand, Hip, and Knee. Arthritis Care Res. 2020;72(2):149\u201