\u0441 \u044d\u0442\u0438\u043c \u0432\u044b\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f\n\n\u043f\u0440\u043e\u043b\u0435\u0436\u0435\u043d\u044c \u041a\u0412\u0414 \u0438\u043b\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0434\u0430.\n\u0424\u0430\u043a\u0442\u043e\u0440\u044b \u0440\u0438\u0441\u043a\u0430: \u0441\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442, \u0441\u0442\u0430\u0440\u0447\u0435\u0441\u043a\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442, \u0441\u043a\u043b\u0435\u0440\u043e\u0434\u0435\u0440\u043c\u0438\u044f.\n\u0421\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u043b\u0435\u0436\u0435\u043d\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u00ab\u0432\u0445\u043e\u0434\u043d\u044b\u043c\u0438 \u0432\u043e\u0440\u043e\u0442\u0430\u043c\u0438\u00bb \u0434\u043b\u044f \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u043b\u043e\u0436\u0430 \u041a\u0412\u0414 \u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0433\u043d\u043e\u0439\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438. \u041a\u043b\u0438\u043d\u0438\u043a\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f\n\n\u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438: \u043f\u043e\u043a\u0440\u0430\u0441\u043d\u0435\u043d\u0438\u0435, \u0438\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435, \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u043a\u043e\u0436\u0438 \u043d\u0430\u0434 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e\n\u041a\u0412\u0414. \u0412\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0432 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u0434\u0435\u0444\u0435\u043a\u0442, \u0447\u0