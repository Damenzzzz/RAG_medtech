438\u044f \u0432 \u043c\u043e\u0447\u0435;\n\u2022 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041f\u0422\u0413 \u0432 \u043a\u0440\u043e\u0432\u0438 (\u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c <20 \u043f\u0433 / \u043c\u043b \u0432 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438\n\n\u0433\u0438\u043f\u043e\u043a\u0430\u043b\u044c\u0446\u0438\u0435\u043c\u0438\u0438 \u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u0432 \u0434\u0432\u0443\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445);\n\u2022 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u043c\u0430\u0433\u043d\u0438\u044f \u0432 \u043a\u0440\u043e\u0432\u0438;\n\u2022 25-\u0433\u0438\u0434\u0440\u043e\u043a\u0441\u0438\u0432\u0438\u0442\u0430\u043c\u0438\u043d D \u0432 \u043a\u0440\u043e\u0432\u0438;\n\u2022 \u043e\u0441\u0442\u0435\u043a\u0430\u043b\u044c\u0446\u0438\u043d \u0432 \u043a\u0440\u043e\u0432\u0438;\n\n\u2022 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d/\u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430 \u043a\u0440\u043e\u0432\u0438;\n\u2022 24-\u0447\u0430\u0441\u043e\u0432\u0430\u044f \u043c\u043e\u0447\u0430 \u0434\u043b\u044f \u043a\u043b\u0438\u0440\u0435\u043d\u0441\u0430 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430 \u0438\u043b\u0438 \u0421\u041a\u0424;\n\u2022 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f: \u0435\u0441\u043b\u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043e\u0441\u043d\u043e\u0432\u0430 (\u043c\u043e\u043b\u043e\u0434\u043e\u0439\n\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442, \u0441\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u0445 \u0436\u0435\u043b\u0435\u0437).\n\n\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f:\n\u2022 \u042d\u041a\u0413 (\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b QT), \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u0443\u0442\u043e\u0447\u043d\u044b\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440 \u042d\u041a\u0413 \u043f\u043e \u0425\u043e\u043b\u0442\u0435\u0440\u0443;\n\n\u2022 \u0440\u0435\u043d\u0442\u0433\u0435\u043d (\u0447\u0435\u0440\u0435\u043f, \u0433\u0440\u0443\u0434\u043d\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430, \u043a\u043e\u0441\u0442\u0438 \u0442\u0430\u0437\u0430);\n\u2022 \u041a\u0422 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430;\n\u2022 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u043a \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u043c\u043e\u0447\u0435\u043a\u0430\u043c\u0435\u043d\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0438\u043b\u0438\n\n\u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f;\n\u2022 \u0440\u0435\u043d\u0442\u0433\u0435\u043d \u0434\u0435\u043d\u0441\u0438\u0442\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0432\u0443\u0445\u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\