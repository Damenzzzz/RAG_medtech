{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_aa7684ac235f", "title": "\u041a\u0430\u0440\u0438\u0435\u0441 \u0437\u0443\u0431\u043e\u0432 \u0443 \u0434\u0435\u0442\u0435\u0439", "source_file": "2025_\u041a\u0430\u0440\u0438\u0435\u0441_\u0437\u0443\u0431\u043e\u0432_\u0443_\u0434\u0435\u0442\u0435\u0438_3de214a55e.pdf", "icd_codes": "K02.0, K02.1, K02.2, K02.3", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041a\u0430\u0440\u0438\u0435\u0441 \u0437\u0443\u0431\u043e\u0432 \u0443 \u0434\u0435\u0442\u0435\u0439.pdf"}, "page_content": "\u043f\u043e\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f. \u0424\u043e\u0440\u043c\u0430\n\u043f\u043e \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\u0441\u043b\u0435\u0433\u043a\u0430 \u0432\u043e\u0433\u043d\u0443\u0442\u0430.\n\u0413\u0438\u043f\u043e\u043f\u043b\u0430\u0437\u0438\u044f \u0422\u0435\u0447\u0435\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e \u041e\u0441\u043c\u043e\u0442\u0440: \u043d\u0430 \u041f\u043e\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f\n\n\u044d\u043c\u0430\u043b\u0438 \u0431\u0435\u0441\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043d\u043e\u0435. \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u044d\u043c\u0430\u043b\u0438 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n(\u043f\u044f\u0442\u043d\u0438\u0441\u0442\u0430\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0437\u0443\u0431\u044b.\n\u0444\u043e\u0440\u043c\u0430) \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u041f\u044f\u0442\u043d\u0430 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u044b \u0432\n\u043c\u0435\u043b\u043e\u0432\u0438\u0434\u043d\u044b\u0435 \u043f\u044f\u0442\u043d\u0430 \u043d\u0435\u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0445 \u0434\u043b\u044f\n\n\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u0438\u0435\u0441\u0430 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445(\u043d\u0430\n\u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b \u0441 \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u0432\u044b\u043f\u0443\u043a\u043b\u044b\u0445\n\u0431\u043b\u0435\u0441\u0442\u044f\u0449\u0435\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445 \u0437\u0443\u0431\u043e\u0432, \u0432\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\u044e. \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0431\u0443\u0433\u0440\u043e\u0432).\n\n\u0417\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u0441\u0442\u0440\u043e\u0433\u0430\u044f\n\u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435 \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438\n\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0441\u0442\u044c\n\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0437\u0443\u0431\u043e\u0432\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n\u0441\u0440\u043e\u043a\u0430\u043c \u0438\u0445\n\u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438.\n\u0413\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u044f\u0442\u0435\u043d \u0431\u043e\u043b\u0435\u0435\n\n\u0447\u0435\u0442\u043a\u0438\u0435, \u0447\u0435\u043c \u043f\u0440\u0438\n\u043a\u0430\u0440\u0438\u0435\u0441\u0435. \u041f\u044f\u0442\u043d\u0430 \u043d\u0435\n\u043e\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u044e\u0442\u0441\u044f\n\u043a\u0440\u0430\u0441\u0438\u0442\u0435\u043b\u044f\u043c\u0438.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 No9. \u0414\u0430\u043d\u043d\u044b\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043a\u0430\u0440\u0438\u0435\u0441\u0430 \u0434\u0435\u043d\u0442\u0438\u043d\u0430 (\u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e\n\u043a\u0430\u0440\u0438\u0435\u0441\u0430 )\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\n\u041a\u0430\u0440\u0438\u0435\u0441 \u044d\u043c\u0430\u043b\u0438 \u0432 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u041e\u0441\u043c\u043e\u0442\u0440: \u0421\u043b\u0430\u0431\u044b\u0435 \u0431\u043e\u043b\u0438 \u043e\u0442\n\u0441\u0442\u0430\u0434\u0438\u0438 \u043f\u044f\u0442\u043d\u0430 \u0441 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438. \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u0421\u0442\u0435\u043d\u043a\u0438 \u0438 \u0434\u043d\u043e \u043d\u0435\u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0435\u0439.\n\u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u043d\u0430 \u0445\u043e\u043b\u043e\u0434\n\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u044d\u043c\u0430\u043b\u0438. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f. \u042d\u041e\u0414 \u2013\n\u0441\u043b\u043e\u044f, \u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c 26 \u043c\u043a\u0410. \u041f\u043e\u043b\u043e\u0441\u0442\u044c\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u044b\u0439 \u0434\u0435\u0444\u0435\u043a\u0442\u0430 \u043f\u0440\u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0430 \u0432\n\u043a\u0430\u0440\u0438\u0435\u0441 \u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u044d\u043c\u0430\u043b\u0438. \u041f\u0440\u0438\n\n\u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u0430\u044f \u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0431\u043e\u043b\u0435\u0435\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430\n\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0434\u043d\u0430 \u043f\u043e\u043b\u043e\u0441\u0442\u0438.\n\n\u0413\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u041a\u0430\u0440\u0438\u043e\u0437\u043d\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u0411\u043e\u043b\u0438 \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u043f\u043e\u0441\u043b\u0435\n\u043a\u0430\u0440\u0438\u0435\u0441 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0438 \u0435\u0435 \u043d\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f \u0441 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f. \u0411\u043e\u043b\u0438 \u043f\u043e\u043b\u043e\u0441\u0442\u044c\u044e \u0437\u0443\u0431\u0430. \u0414\u043d\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0435\u0439. \u0412\n\u043e\u0442 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445, \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438\n\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\n\n\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0432\u0435\u0440\u0434\u043e\u0435 \u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043d\u0430\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0435\u0439. \u043f\u043e\u043b\u043e\u0441\u0442\u0438. \u042d\u041e\u0414 8-12\n\u043c\u043a\u0410.\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u041a\u0430\u0440\u0438\u043e\u0437\u043d\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u044c, \u0417\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\n\u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043d\u0442\u0438\u0442 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0438 \u0435\u0435 \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f. \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f \u0441 \u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435.\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c\u044e \u0437\u0443\u0431\u0430. \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u043d\u0430\n\u0417\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0438\n\n\u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442. \u042d\u041e\u0414\n\u0431\u0435\u0437\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0435. \u0441\u0432\u044b\u0448\u0435 100 \u043c\u043a\u0410. \u041d\u0430\n\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435\n\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f,\n\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0435 \u0434\u043b\u044f\n\u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0444\u043e\u0440\u043c\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\n\u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043d\u0442\u0438\u0442\u0430.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 No10. \u0414\u0430\u043d\u043d\u044b\u0435 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0433\u0438\u043f\u0435\u0440\u0435\u043c\u0438\u0438 \u043f\u0443\u043b\u044c\u043f\u044b\n\n(\u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u043a\u0430\u0440\u0438\u0435\u0441\u0430)\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0421\u0440\u0435\u0434\u043d\u0438\u0439 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u041e\u0441\u043c\u043e\u0442\u0440: \u041a\u0430\u0440\u0438\u043e\u0437\u043d\u0430\u044f \u0417\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u043a\u0430\u0440\u0438\u0435\u0441 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0438 \u0435\u0435 \u043f\u043e\u043b\u043e\u0441\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e \u043f\u043e\n\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f. \u0411\u043e\u043b\u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u044d\u043c\u0430\u043b\u0435\u0432\u043e\u0434\u0435\u043d\u0442\u0438\u043d\u043d\u043e\u043c\u0443\n\u043e\u0442 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043d\u044b\u0445, \u0417\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044e. \u042d\u041e\u0414- 6-\n\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e \u0432 8\u043c\u043a\u0410.\n\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u044d\u043c\u0430\u043b\u0435\u0432\u043e-\n\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0435\u0439 \u0434\u0435\u043d\u0442\u0438\u043d\u043d\u043e\u0433\u043e\n\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f.\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u043b\u043e\u0439\n\u0440\u0430\u0437\u043c\u044f\u0433\u0447\u0435\u043d\u043d\u043e\u0433\u043e\n\n\u0434\u0435\u043d\u0442\u0438\u043d\u0430.\n\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c\u044e \u0437\u0443\u0431\u0430 \u043d\u0435\u0442.\n\u041e\u0441\u0442\u0440\u044b\u0439 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u041e\u0441\u043c\u043e\u0442\u0440: \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u041f\u0440\u0438 \u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438\n\n\u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438. \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u0442\u044c, \u0434\u043d\u0430 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439\n\u043f\u0443\u043b\u044c\u043f\u0438\u0442 \u0421\u0430\u043c\u043e\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0435 \u043d\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0441 \u043f\u043e\u043b\u043e\u0441\u0442\u0438, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e,\n\u0431\u043e\u043b\u0438, \u043f\u043e\u043b\u043e\u0441\u0442\u044c\u044e \u0437\u0443\u0431\u0430. \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\u043e\n\u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043e\u0442 \u041f\u0440\u0438 \u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0432\u0441\u043a\u0440\u044b\u0442\u043e\u043c \u0443\u0447\u0430\u0441\u0442\u043a\u0435\n\u0432\u0441\u0435\u0445 \u0432\u0438\u0434\u043e\u0432 \u0434\u043d\u0430 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0431\u043e\u043b\u044c. \u0440\u043e\u0433\u0430 \u043f\u0443\u043b\u044c\u043f\u044b. \u042d\u041e\u0414 30-\n\n\u043c\u0435\u0445\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445, 40\u043c\u043a\u0410.\n\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0435\u0439. \u041f\u0440\u0438\n\n\u0437\u043e\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u0434\u043d\u0430\n\u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u044c\n\u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\n\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0430 \u043f\u043e \u0432\u0441\u0435\u043c\u0443\n\u0434\u043d\u0443.\n\n4) \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u041e\u0431\u0449\u0438\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043a\u0430\u0440\u0438\u0435\u0441\u043e\u043c \u0437\u0443\u0431\u043e\u0432 \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\n\u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u0430\u043f\u043e\u0432:\n\u2022 \u0434\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c\n\n\u043a\u0430\u0440\u0438\u0435\u0441\u043e\u0433\u0435\u043d\u043d\u0443\u044e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e \u0432 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430, \u043c\u0438\u043a\u0440\u043e\u0431\u043d\u044b\u0439 \u043d\u0430\u043b\u0435\u0442, \u0444\u0430\u043a\u0442\u043e\u0440\u044b,\n\u043e\u0431\u0443\u0441\u043b\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0434\u0435\u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0437\u0443\u0431\u043e\u0432;\n\u2022 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0433\u0438\u0433\u0438\u0435\u043d\u0435 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u0432\u044b\u0431\u043e\u0440\u0443 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0438\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0433\u0438\u0433\u0438\u0435\u043d\u044b, \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0438\u0433\u0438\u0435\u043d\u0430, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u043f\u043e \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0434\u0438\u0435\u0442\u044b;\n\n\u2022 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0430\u0440\u0438\u0435\u0441\u043e\u043c \u0437\u0443\u0431\u0430;\n\u2022 \u043f\u0440\u0438 \u043a\u0430\u0440\u0438\u0435\u0441\u0435 \u0441\u0442\u0430\u0434\u0438\u0438 \u0431\u0435\u043b\u043e\u0433\u043e \u043f\u044f\u0442\u043d\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0440\u0435\u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0443\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f;\n\u2022 \u043f\u0440\u0438 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432\u0448\u0435\u043c\u0441\u044f \u043a\u0430\u0440\u0438\u0435\u0441\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0444\u0442\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0443\u0431\u043e\u0432;\n\n\u2022 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043a\u0430\u0440\u0438\u043e\u0437\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0