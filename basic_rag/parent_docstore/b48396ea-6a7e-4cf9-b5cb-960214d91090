u0435 \u0433\u043e\u043d\u0430\u0434,\n\u0439 \u0444\u0435\u043c\u0438\u043d\u0438\u0437\u0430\u0446\u0438\u0438, \u043b\u0435\u0440\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u0432 \u043d\u043e\u0435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043d\u0435\u043e\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\n\u043d\u0435\u043f\u043e\u043b\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 (\u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u0430\n\u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u044b) \u0444\u0435\u043c\u0438\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445\n\u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u0433\u043e\u0440\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u043f\u0438\u044f\n\n\u043e\u0432\u043e\u0442\u0435\u0441\u0442\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u0435 46,\u0425\u0425; \u043e\u0432\u043e\u0442\u0435\u0441\u0442\u0438\u0441 \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0431\u044b, \u0431\u0438\u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c LS, \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0433\u043e\u043d\u0430\u0434,\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 46,\u0425Y; \u0442\u044f\u0436\u0438 (\u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e \u043d\u043e\u0435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u043d\u0435\u043e\u0432\u043b\u0430\u0433\u0430\u043b\u0438\u0449\n\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u043b\u0430 46,\u0425\u0425/46, \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u043c \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u0430\n(\u043f\u0440\u0435\u0436\u043d\u044f\u044f \u0425Y \u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u0430\u043c), \u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n\u0442\u0435\u0440\u043c\u0438\u043d\u043e\u043b\u043e\u0433\u0438\u044f - \u0441\u0435\u043c\u044f\u0432\u044b\u043d\u043e\u0441\u044f\u0449\u0438\u0435 \u0433\u043e\u0440\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u043f\u0438\u044f\n\u0438\u0441\u0442\u0438\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0442\u043e\u043a\u0438\n\u0433\u0435\u0440\u043c\u0430\u0444\u0440\u043e\u0434\u0438\u0442\u0438\u0437\u043c)\n46,\u0425\u0425\u043c\u0443\u0436\u0447\u0438\u043d\u0430 46,\u0425\u0425 \u044f\u0438\u0447\u043a\u0438 \u043c\u0443\u0436\u0441\u043a\u0438\u0435 \u043f\u043e\u043b\u043e\u0432\u044b\u0435 \u043c\u0443\u0436\u0441\u043a\u043e\u0439 \u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d\n(46XX malesyndrome) \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c (\u0442\u0435\u0441\u0442\u0438\u043a\u0443\u043b \u043e\u0440\u0433\u0430\u043d\u044b \u0442\u0438\u043f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439\n\u0441\u0442\u0432\u043e \u0433\u0435\u043d\u0430 \u044b) \u0441\u043f\u0435\u0440\u043c\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0437\nSRY\n46,\u0425Y \u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438\u044f 46,\u0425Y \u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438 \u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435 \u0442\u0440\u0443\u0431\u044b, \u0436\u0435\u043d\u0441\u043a\u0438\u0439 LS, \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0433\u043e\u043d\u0430\u0434,\n\u0433\u043e\u043d\u0430\u0434, \u043f\u043e\u043b\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u044f \u044f\u0438\u0447\u0435\u043a \u043c\u0430\u0442\u043a\u0430 \u0442\u0438\u043f \u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f\n(\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0421\u0432\u0430\u0439\u0435\u0440\u0430) (\u0442\u0435\u0441\u0442\u0438\u043a\u0443\u043b) \u0433\u043e\u0440\u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u042d\u041a\u041e \u0438\n\n\u043f\u043e\u0434\u0441\u0430\u0434\u043a\u0430 \u044d\u043c\u0431\u0440\u0438\u043e\u043d\u0430 \u0432\n\u043f\u043e\u043b\u043e\u0441\u0442\u044c \u043c\u0430\u0442\u043a\u0438\n46,\u0425Y\u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438\u044f 46,\u0425Y \u0434\u0438\u0441\u0433\u0435\u043d\u0435\u0437\u0438 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u0430 \u0431\u0438\u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c LS, \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0433\u043e\u043d\u0430\u0434,\n\u0433\u043e\u043d\u0430\u0434, \u043d\u0435\u043f\u043e\u043b\u043d\u0430\u044f \u044f \u044f\u0438\u0447\u0435\u043a \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0435\u043d\u0446\u0438\u044f \u043d\u043e\u0435 \u0424\u0435\u043c\u0438\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u0444\u043e\u0440\u043c\u0430 (\u0442\u0435\u0441\u0442\u0438\u043a\u0443\u043b) \u043c\u044e\u043b\u043b\u0435\u0440\u043e\u0432\u044b\u0445 \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u043d\u0430\u0440\u0443\u0436\u043d\u044b\u0445\n\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u0432 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n(\u043c\u0430\u0442\u043e\u0447\u043d\u044b\u0435\n\u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442\u044b)", "type": "Document"}}