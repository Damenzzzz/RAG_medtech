5\u0440\u0438\u0435\u043c\u0438\u0438) - \u0432\u044b\u0441\u043e\u043a\u043e \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0439 \u043c\u0435\u0442\u043e\u0434, \u043d\u043e\n\n\u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u043d\u0438\u0437\u043a\u043e\u0439 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e, \u0437\u0430\u0432\u0438\u0441\u044f\u0449\u0435\u0439 \u043e\u0442 \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0432\u0438\u043b \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f,\n\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f, \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 \u0438 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u0410\u0411\u0422 [29, 33, 46] [\u0423\u0414 \u2013 \u0412]\n\u2022 \u041f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0412\u041f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0446\u0430 (\u043c\u043e\u043a\u0440\u043e\u0442\u0430, \u043c\u0430\u0437\u043e\u043a \u0438\u0437\n\u043d\u043e\u0441\u043e\u0433\u043b\u043e\u0442\u043a\u0438 \u0438 \u0434\u0440.) \u043d\u0430 \u0433\u0440\u0438\u043f\u043f, COVID-19 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u041f\u0426\u0420 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0438 \u0433\u0440\u0438\u043f\u043f\u0430 \u0438\u043b\u0438\n\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c\n\u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u043e\u043c \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0421\u0418\u0417.\n\u2022 \u041f\u0426\u0420 \u043c\u0430\u0437\u043a\u0430 \u0438\u0437 \u043d\u043e\u0441\u043e\u0433\u043b\u043e\u0442\u043a\u0438 \u043d\u0430 \u0420\u041d\u041a \u0432\u0438\u0440\u0443\u0441\u043e\u0432 \u0433\u0440\u0438\u043f\u043f\u0430 \u0410, \u0412 (\u0432 \u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0435\u0437\u043e\u043d).\n\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0435:\n\n\u2022 \u041a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438 \u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u0435,\n\u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0438\u0445 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u0445 \u0432 \u0442\u043e\u0439 \u0436\u0435 \u0434\u043e\u043b\u0435 (\u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0435) \u043b\u0435\u0433\u043a\u043e\u0433\u043e,\n\n\u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u0432\u0438\u0440\u0443\u0441\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445, \u043f\u0440\u0438\n\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u043e\u0442 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u0439 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0443\u0445\u0443\u0434\u0448\u0435\u043d\u0438\u0438\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 [\u0423\u0414 \u2013 \u0421]. \u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442 \u0434\u043b\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445 - \u0441\u043f\u0438\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u041a\u0422.\n\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0435 \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u043a\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\n\u0442\u043e\u043b\u0449\u0438\u043d\u043e\u0439 \u0441\u0440\u0435\u0437\u0430 10 \u043c\u043c \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u044e\u0442 \u041a\u0422 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f [2, 35, 46];\n\n\u2022 \u0423\u0417\u0418 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 - \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0432 \u041e\u0410\u0420\u0418\u0422 \u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0412\u0411 \u0434\u043b\u044f\n\u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u043e\u0446\u0435\u043d\u043a\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438, \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u041e\u0420\u0414\u0421.\n\u2022 \u0423\u0417\u0418 \u043f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0441\u0442\u0435\u0439 - \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u044d\u043a\u0441\u0441\u0443\u0434\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\n\u043f\u043b\u0435\u0432\u0440\u0438\u0442\u0430 [\u0423\u0414 \u2013 C];\n\u2022 \u042d\u041a\u0413 \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u043e\u0442\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u0445 \u0432\u0441\u0435\u043c \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c;\n\u2022 \u0423\u0417\u0418 \u0441\u0435\u0440\u0434\u0446\u0430 (\u042d\u0425\u041e-\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f) \u043f\u0440\u0438 \u0442\u044f\u0436\u0435\u043b\u043e\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u0412\u041f \u0438 \u0434\u043b\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0441 \u0437\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u043c\u0438 \u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0432 \u043c\u0430\u043b\u043e\u043c \u043a\u0440\u0443\u0433\u0435\n\n\u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u044f\u043c\u0438 \u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0438 (\u0422\u042d\u041b\u0410).\n\u2022 \u0424\u0438\u0431\u0440\u043e\u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0434\u043b\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0412\u041f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f\n\u043f\u0440\u043e\u043c\u044b\u0432\u043d\u044b\u0445 \u0432\u043e\u0434 \u0431\u0440\u043e\u043d\u0445\u043e\u0432 \u0434\u043b\u044f \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0438\u043b\u0438 \u0441 \u043b\u0435\u0447\u0435\u0431\u043d\u043e-\u0441\u0430\u043d\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439\n\n\u0446\u0435\u043b\u044c\u044e \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043d\u0430\u0433\u043d\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 [1-3,46]. [\u0423\u0414 \u2013 \u0421]\n\u0423\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0435\u0432, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0412\u041f \u0441 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\u043c\u0438, \u043e\u0446\u0435\u043d\u043a\u0438\n\u0434\u0435\u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439, \u043e\u0431\u044a\u0435\u043c \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e-\n\n\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0432 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439\n\u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.\n\u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e \u0412\u041f \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 \u043d\u0435\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438\n\u043b\u0435\u0433\u043a\u0438\u0445 (\u043d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0435\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445,\n\n\u0422\u042d\u041b\u0410, \u043e\u0442\u0435\u043a \u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u0434\u0440.) \u0438 \u0441\u043e \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430\u043c\u0438\n(\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437, \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435 \u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438, \u043f\u0430\u0440\u0430\u0437\u0438\u0442\u043e\u0437\u044b \u0438 \u0434\u0440.)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 4 \u2013 \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u0412\u041f:\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0412\u041f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n10\n\n\u0422\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 \u0421\u0445\u043e\u0436\u0430\u044f \u0441 \u0412\u041f \u041a\u0422-\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0440\u0438 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0438 \u0445\u043e\u0442\u044f\n\u043b\u0435\u0433\u043a\u0438\u0445 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430, \u0431\u044b \u0432 \u043e\u0434\u043d\u043e\u043c \u043c\u0430\u0437\u043a\u0435 \u043c\u0438\u043a\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0439\n\n\u043a\u0430\u0440\u0442\u0438\u043d\u0430, \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430.\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u043c\u043e\u043a\u0440\u043e\u0442\u044b,\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u0424\u0411\u0421 \u0441 \u0437\u0430\u0431\u043e\u0440\u043e\u043c\n\u043f\u0440\u043e\u043c\u044b\u0432\u043d\u044b\u0445 \u0432\u043e\u0434\n\u041d\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430 \u0421\u0445\u043e\u0436\u0430\u044f \u0441 \u0412\u041f \u041a\u0422-\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e.\n\u043d\u0438\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 \u0432 \u042d\u043d\u0434\u043e\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b.\n\u043a\u0430\u0440\u0442\u0438\u043d\u0430, \u0430\u043d\u0433\u0438\u043e\u0440\u0435\u0436\u0438\u043c\u0435 \u0441 \u0410\u0434\u0435\u043d\u043e\u043c\u0430 \u0431\u0440\u043e\u043d\u0445\u0430. \u041b\u0438\u043c\u0444\u043e\u043c\u0430.\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u043c, \u0424\u0411\u0421 \u0441 \u0432\u0437\u044f\u0442\u0438\u0435\u043c\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043d\u044b\u0445 \u0432\u043e\u0434,\n\u0431\u0440\u0430\u043d\u0448- \u0438\u043b\u0438\n\u0449\u0438\u043f\u043a\u043e\u0432\u0430\u044f\u0431\u0438\u043e\u043f\u0441\u0438\u044f\n\u0422\u0440\u043e\u043c\u0431\u043e- \u0421\u0445\u043e\u0436\u0430\u044f \u0441 \u0412\u041f \u041a\u0422-\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u041e\u0441\u0442\u0440\u043e \u0432\u043e\u0437\u043d\u0438\u043a\u0448\u0430\u044f \u043e\u0434\u044b\u0448\u043a\u0430,\n\u044d\u043c\u0431\u043e\u043b\u0438\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 \u0432 \u0446\u0438\u0430\u043d\u043e\u0437, \u0442\u0430\u0445\u0438\u043f\u043d\u043e\u044d. \u041d\u0430\u043b\u0438\u0447\u0438\u0435\n\u043b\u0435\u0433\u043e\u0447\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u0430, \u0430\u043d\u0433\u0438\u043e\u0440\u0435\u0436\u0438\u043c\u0435 \u0441 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432 \u0440\u0438\u0441\u043a\u0430 \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0439\n\u0430\u0440\u0442\u0435\u0440\u0438\u0438 \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u0438. \u041a\u0440\u043e\u0432\u043e\u0445\u0430\u0440\u043a\u0430\u043d\u044c\u0435,\n\u0441\u0438\u043c\u0442\u043e\u043c\u044b, \u0414-\u0434\u0438\u043c\u0435\u0440\u044b. \u043f\u0443\u043b\u044c\u0441 \u0441\u0432\u044b\u0448\u0435 100 \u0432 \u043c\u0438\u043d.\n\n\u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f \u0423\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0414-\u0434\u0438\u043c\u0435\u0440\u043e\u0432.\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438.\n\u0417\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u0421\u0445\u043e\u0436\u0430\u044f \u0441 \u0412\u041f \u042d\u041a\u0413, \u042d\u0425\u041e-\u041a\u0413, \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e\n\u0441\u0435\u0440\u0434\u0435\u0447\u043d\u0430\u044f \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041d\u0423\u041f (\u043d\u0430\u0442\u0440\u0438\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043a\u0430\u0440\u0442\u0438\u043d\u0430, \u0443\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043b\u0435\u0432\u043e\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043a\u043e\u0432\u043e\u0439\n\u0441\u0442\u044c \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u0435\u043f\u0442\u0438\u0434) \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0410\u043d\u0430\u043c\u043d\u0435\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043b\u0435\u0432\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u0441\u0435\u0440\u0434\u0446\u0430\n(\u0418\u0411\u0421,\u0410\u0413). \u041e\u0442\u0435\u0447\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c.\n\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u044d\u0444\u0444\u0435\u043a\u0442 \u043e\u0442\n\u0434\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u043e\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0425\u0421\u041d\n\u041f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u044b\u043f\u043e\u0442, \u0437\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u0432 \u043d\u0438\u0436\u043d\u0438\u0445 \u043e\u0442\u0434\u0435\u043b\u0430\u0445\n\u043b\u0435\u0433\u043a\u0438\u0445 \u043d\u0430 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435\n\u041e\u0440\u0442\u043e\u043f\u043d\u043e\u044d, \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f.\n\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u043a\u0430\u0448\u043b\u044f, \u043e\u0434\u044b\u0448\u043a\u0438 \u0438\n\u0441\u0432\u0438\u0441\u0442\u044f\u0449\u0438\u0445 \u0445\u0440\u0438\u043f\u043e\u0432 \u0432 \u043d\u043e\u0447\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f,\n\u0432 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438\n\u0418\u0417\u041b \u0420\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u041a\u0422-\u0433\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u041a\u0422-\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 2-\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0435\u0433\u043e\n\u043d\u0435\u0438\u0444\u0435\u043a\u0446. \u0436\u0430\u043b\u043e\u0431\u044b: \u043a\u0430\u0448\u0435\u043b\u044c, \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430.\n\u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u043e\u0434\u044b\u0448\u043a\u0430. \u041f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438\n\u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e\n(\u0441\u0430\u0440\u043a\u043e\u0438\u0434\u043e\u0437, \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u043e\u0432 \u0438\u043b\u0438 \u0414\u0411\u0421\u0422.\n\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u043f\u043e\n\u0414\u0411\u0421\u0422, \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430: \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u041f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e (\u0431\u043e\u043b\u0435\u0435\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0441\n\u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u044b, \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c, \u043c\u0435\u0441\u044f\u0446\u0430). \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\n\u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 (\u0431\u043e\u043b\u0435\u0435 2 \u043c\u0435\u0441). \u041d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\n\u043c, \u0424\u0411\u0421 \u0441 \u0432\u0437\u044f\u0442\u0438\u0435\u043c\n\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u0438. \u041d\u0430 \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438. \u041f\u043e\n\u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u2013 \u043f\u0440\u043e\u043c\u044b\u0432\u043d\u044b\u0445 \u0432\u043e\u0434, \u0434\u0430\u043d\u043d\u044b\u043c \u0442\u0440\u0430\u043d\u0441\u0431\u0440\u043e\u043d\u0445\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043b\u0438\n\u044c\u043d\u044b\u0435 \u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u0431\u0440\u0430\u043d\u0448- \u0438\u043b\u0438 \u0442\u0440\u0430\u043d\u0441\u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0438\u043e\u043f\u0441\u0438\u0438 \u043b\u0435\u0433\u043a\u0438\u0445\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438) \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f. \u0449\u0438\u043f\u043a\u043e\u0432\u0430\u044f \u0431\u0438\u043e\u043f\u0441\u0438\u044f. \u2013 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0418\u0417\u041b.\n\u0422\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u0430\u044f\n\u0431\u0438\u043e\u043f\u0441\u0438\u044f \u043f\u043e\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\u041f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438\n\u0414\u0411\u0421\u0422, \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u043e\u0432 -\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435\n\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435\n11\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.", "type": "Document"}}