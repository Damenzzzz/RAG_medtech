u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0445\n\n\u0432\u0430\u043a\u0446\u0438\u043d - \u0422\u0430\u0431\u043b\u0438\u0446\u0430 4\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 4 - \u0412\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f \u043b\u0438\u0446, \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044e\n\u0433\u0435\u043c\u043e\u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a (\u0422\u0413\u0421\u041a)\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438\n\u0418\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u0434\u043e\u0437\u044b (3-\u043a\u0440\u0430\u0442\u043d\u043e) \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u0432 \u043e\u0434\u0438\u043d\n\n\u0434\u0438\u0444\u0442\u0435\u0440\u0438\u0438 \u043c\u0435\u0441\u044f\u0446 (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 6-12 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a)\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u0434\u043e\u0437\u044b (3 -\u043a\u0440\u0430\u0442\u043d\u043e), \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c \u0432 \u043e\u0434\u0438\u043d\n\u0433\u0435\u043c\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0439 \u043f\u0430\u043b\u043e\u0447\u043a\u0438 \u043c\u0435\u0441\u044f\u0446 (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 6-12 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a)\n\u0442\u0438\u043f\u0430 b (Hib)\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 6 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 A \u0422\u0413\u0421\u041a): \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d \u0441 \u0432\u0430\u043a\u0446\u0438\u043d\u043e\u0439 \u043f\u0440\u043e\u0442\u0438\u0432 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 A;\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u0434\u043e\u0437\u044b (0,2.4.) (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 6-12 \u043c\u0435\u0441\u044f\u0446\u0430\n\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u0430 B \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a);\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u0441 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c\n\u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u0438\u0442\u0440\u043e\u0432 anti-HBs \u0441\n\u0440\u0435\u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u0435\u0439, \u0435\u0441\u043b\u0438 \u043e\u0442\u0432\u0435\u0442 \u043d\u0438\u0436\u0435 10 \u041c\u0415/\u041b.\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0442\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c\n\n\u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 (\u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0442\u0438\u0442\u0440\u043e\u0432 anti-HBs).\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0433\u043e\u0434, \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 4-6 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435\n\u0433\u0440\u0438\u043f\u043f\u0430 \u0422\u0413\u0421\u041a.\n(\u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f)\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u0434\u043e\u0437\u044b \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 \u0438 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432 \u0434\u043e 18 \u043b\u0435\u0442\n\u043a\u043e\u043a\u043b\u044e\u0448\u0430 (\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 1 \u043c\u0435\u0441\u044f\u0446), 1 \u0434\u043e\u0437\u0430 \u0434\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 \u043e\u0442 18\n\u043b\u0435\u0442 (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 6-12 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a)\n\u041f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u0430\u044f \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u0434\u043e\u0437\u044b (\u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 3-9 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a\n\n\u043a\u043e\u043d\u044a\u044e\u0433\u0430\u0442\u043d\u0430\u044f 13-\u0438 \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430 \u043f\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438. 3\n\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u0434\u043e\u0437\u044b \u0432\u0430\u043a\u0446\u0438\u043d\u044b Pneu-C-13 \u0441 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u043e\u043c \u043c\u0435\u0436\u0434\u0443\n(Pneu-C-13) \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u043c\u0438, \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c, 4 \u043d\u0435\u0434\u0435\u043b\u0438, \u0438 \u0437\u0430\u0442\u0435\u043c \u043e\u0434\u043d\u0430 \u0434\u043e\u0437\u0430\n\u0432\u0430\u043a\u0446\u0438\u043d\u044b Pneu-P-23 \u043d\u0430 6-12 \u043c\u0435\u0441\u044f\u0446 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0434\u043e\u0437\u044b\n\nPneu-C-13)\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f: 3 \u043a\u0440\u0430\u0442\u043d\u043e \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u043e\u043c 1 \u043c\u0435\u0441\u044f\u0446 \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441\n\u043f\u043e\u043b\u0438\u043e\u043c\u0438\u0435\u043b\u0438\u0442\u0430 6-12 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a\n(\u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f)\n\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\u0431\u0435\u0448\u0435\u043d\u0441\u0442\u0432\u0430\n\u0416\u0438\u0432\u044b\u0435 \u0432\u0430\u043a\u0446\u0438\u043d\u044b\n\n\u0411\u0426\u0416-\u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0430\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u043a\u043e\u0440\u0438, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 1 \u0434\u043e\u0437\u0430 1, \u0437\u0430\u0442\u0435\u043c 2-\u0443\u044e\n\u043a\u0440\u0430\u0441\u043d\u0443\u0445\u0438, \u0434\u043e\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0435\u0445 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435.\n\u044d\u043f\u0438\u0434\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0415\u0441\u043b\u0438 \u043d\u0435\u0442 \u0441\u0435\u0440\u043e\u043a\u043e\u043d\u0432\u0435\u0440\u0441\u0438\u0438 \u0447\u0435\u0440\u0435\u0437 24 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a, \u0442\u043e\n\n\u043f\u0430\u0440\u043e\u0442\u0438\u0442\u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u043e\u0439 \u0434\u043e\u0437\u044b \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0412\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u041c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u0447\u0435\u0442\u043a\u0438\u0435 \u044d\u043f\u0438\u0434\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f 1\n\u0436\u0435\u043b\u0442\u043e\u0439 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 24 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a\n\n1 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u043c\u0435\u0441\u044f\u0446\u0430 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\n\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430 \u043f\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0430.\n\n\u2022 \u0422\u0420\u0410\u041d\u0421\u041f\u041b\u0410\u041d\u0422\u0410\u0426\u0418\u042f \u0426\u0415\u041b\u042c\u041d\u041e\u0413\u041e \u041e\u0420\u0413\u0410\u041d\u0410[6 \u2013 12].\n\u041f\u0435\u0440\u0435\u0434 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0435\u0439 \u0446\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430\n\n\u041a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0430\u043c \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u044e \u0446\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430 \u0432 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u043c \u043f\u043e\u0440\u044f\u0434\u043a\u0435\n\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433