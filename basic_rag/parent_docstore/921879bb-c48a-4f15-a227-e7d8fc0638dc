1\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\n\u0416\u0430\u043b\u043e\u0431\u044b \u0438 \u0430\u043d\u0430\u043c\u043d\u0435\u0437:\n\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u044e\u0442 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b:\n\u2022 \u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0435 \u0438\u043b\u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0435, \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c \u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u0432 \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0435:\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0437 \u043a\u0438\u0448\u043a\u0438 \u0432 \u0432\u0438\u0434\u0435 \u043a\u0440\u043e\u0432\u0438 \u0438 \u0441\u043b\u0438\u0437\u0438, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c\u044b\n\n\u0438\u0441\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 \u2013 \u043b\u0435\u043d\u0442\u043e\u0432\u0438\u0434\u043d\u044b\u0439 \u043a\u0430\u043b, \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430 \u0432 \u043f\u0440\u044f\u043c\u043e\u0439 \u043a\u0438\u0448\u043a\u0435.\n\u2022 \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u044b\u0435, \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0440\u043e\u0441\u0442\u043e\u043c \u043e\u043f\u0443\u0445\u043e\u043b\u0438, \u0447\u0442\u043e \u043f\u0440\u0438\u