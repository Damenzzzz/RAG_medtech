40\u0430\u043b\u044c\u043d\u043e\u0435 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 48 \u0447\u0430\u0441\u043e\u0432; [4,6,7,\n\u0438\u043b\u0438 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 150\u043c\u0433 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0432\u043d\u0443\u0442\u0440\u044c 150 \u043c\u0433 1 \u2022 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043e\u0431\u0449\u0435\u0433\u043e 12,14]\n\n\u043f\u0440\u043e\u043b\u043e\u043d\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0440/\u0434, 100 \u043c\u0433 2 \u0440/\u0434 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n100\u043c\u0433. \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 5-7 \u0434\u043d\u0435\u0439, \u0441\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,\n\u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0439 \u0438\n\n\u0431\u043e\u043b\u0435\u0443\u0442\u043e\u043b\u044f\u044e\u0449\u0435\u0439 \u0446\u0435\u043b\u044c\u044e.\n3. \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u0414\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0438 \u0434\u0435\u0442\u0435\u0439 \u0441 12 \u043b\u0435\u0442 \u0438\u0431\u0443\u043f\u0440\u043e\u0444\u0435\u043d \u2022 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 3-\u0445 \u0434\u043d\u0435\u0439 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 A\n100 \u043c\u0433/5 \u043c\u043b100\u043c\u043b \u0438\u043b\u0438 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442 \u043f\u043e 200 \u043c\u0433 3\u20134 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0414\u043b\u044f \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430; [4,6,7,\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e 200 \u043c\u0433; \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u2022 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 5-\u0442\u0438 \u0434\u043d\u0435\u0439 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 22]\n\n\u0432\u043d\u0443\u0442\u0440\u044c 600 \u043c\u0433 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445 \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u0434\u043e 400 \u043c\u0433 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\n10\n\n3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0441 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439,\n\u0421\u0443\u0441\u043f\u0435\u043d\u0437\u0438\u044f, \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 5-10 \u043c\u0433/\u043a\u0433 \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0439 \u0438\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 3-4 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438. \u0431\u043e\u043b\u0435\u0443\u0442\u043e\u043b\u044f\u044e\u0449\u0435\u0439 \u0446\u0435\u043b\u044c\u044e.\n\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430\n\u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c 30 \u043c\u0433 \u043d\u0430 \u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0432\n\u0441\u0443\u0442\u043a\u0438.\n4. \u0430\u0446\u0435\u0442\u0430\u043c\u0438\u043d\u043e\u0444\u0435\u043d 200 \u043c\u0433 \u0412\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u0438 \u0434\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435 12 \u043b\u0435\u0442 \u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 \u2022 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0435\u0447\u0435\u043d\u0438\u044f A\n\n\u0438\u043b\u0438 500\u043c\u0433; \u0434\u043b\u044f \u043f\u0440\u0438\u0435\u043c\u0430 \u0431\u043e\u043b\u0435\u0435 40 \u043a\u0433: \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 500 \u043c\u0433-1,0 \u0433 \u0434\u043e 4 \u0440\u0430\u0437 \u0432 \u043f\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 [4,6,7,\n\u0432\u043d\u0443\u0442\u0440\u044c 120 \u043c\u0433/5 \u043c\u043b \u0438\u043b\u0438 \u0441\u0443\u0442\u043a\u0438. \u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0437\u043e\u0432\u0430\u044f \u0434\u043e\u0437\u0430 \u2013 1,0 \u0433. \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a\u0430 \u0438 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 22]\n\u0440\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e 125 \u043c\u0433, 250 \u0418\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u0438\u0435\u043c\u0430\u043c\u0438 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 4 \u0447\u0430\u0441\u043e\u0432. \u0436\u0430\u0440\u043e\u043f\u043e\u043d\u0438\u0436\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043d\u0435\n\u04