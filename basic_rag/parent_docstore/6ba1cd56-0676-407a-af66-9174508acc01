34\u0435\u043d\u044c, 5\u0434/\u0432 \u043c\u0435\u0441\u044f\u0446 \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0438\u043b\u0438 6 \u043c\u0433/\u043c2/\u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 6-\n12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\nChlamydia Psittaci: \u0414\u0438\u0441\u0441\u0435\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f:\n\u2022 \u0434\u043e\u043a\u0441\u0438\u0446\u0438\u043a\u043b\u0438\u043d 100 \u043c\u0433/\u0441\u0443\u0442, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3 \u043d\u0435\u0434\u0435\u043b\u044c \u2022 \u041c\u043e\u043d\u043e\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f:\n- \u0440\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431 375 \u043c\u0433/\u043c2/4\u0440 \u0445 \u043d\u0435\u0434 +/-;\nBorrelia Burgdorferi: - \u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 10\u043c\u0433/\u043c2/\u0434\u0435\u043d\u044c \u0445 6-12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432;\n\n\u2022 \u0434\u043e\u043a\u0441\u0438\u0446\u0438\u043a\u043b\u0438\u043d 100 \u043c\u0433/\u0441\u0443\u0442 \u0438\u043b\u0438 \u0430\u043c\u043e\u043a\u0441\u0438\u0446\u0438\u043b\u043b\u0438\u043d, - \u0424\u043b\u0443\u0434\u0430\u0440\u0430\u0431\u0438\u043d 30\u043c\u0433/\u043c2/\u0432 \u043c\u0435\u0441\u044f\u0446 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 6\n\u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3 \u043d\u0435\u0434\u0435\u043b\u044c \u043c\u0435\u0441\u044f\u0446\u0435\u0432.\n\nCampylobacter Jejuni: \u041f\u043e\u043b\u0438\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f (2 \u043b\u0438\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438):\n\u2022 \u044d\u0440\u0438\u0442\u0440\u043e\u043c\u0438\u0446\u0438\u043d \u0438\u043b\u0438 \u0444\u0442\u043e\u0440