043e\u043b\u0435\u0437\u043d\u044c \u0412\u0435\u0440\u0434\u043d\u0438\u0433\u0430\u2013\u0413\u043e\u0444\u0444\u043c\u0430\u043d\u0430, \u0431\u043e\u043b\u0435\u0437\u043d\u044c\n\n\u0414\u0430\u043d\u043e\u043d, \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u043e\u043c\u0430, \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0414\u044e\u0448\u0435\u043d\u0430, \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435\n\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0435 \u0438 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043b\u0438\u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438, \u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0438,\n\u043a\u0430\u0440\u0434\u0438\u0442\u044b, \u0433\u0438\u043f\u043e\u0442\u0438\u0440\u0435\u043e\u0437.\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u043f\u0440\u0438 \u041c\u0411\u041f\n\n8\n\n\u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u043e\u0440\u043c\u044b \u041e\u0431\u0449\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0413\u043b\u0438\u043a\u043e\u0433\u0435\u043d\u043e\u0437\u044b (III \u0430, IV,VII \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u041a\u0410\u0413\n\u0442\u0438\u043f\u044b) \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u041a\u041a,\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0433\u043b\u0438\u043a\u043e\u0433\u0435\u043d\u0430\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0412\u0435\u0440\u0434\u043d\u0438\u0433\u0430- \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, II \u0442\u0438\u043f \u042d\u041c\u0413; \u0444\u0438\u0431\u0440\u0438\u043b\u043b\u044f\u0446\u0438\u0438, \u0444\u0430\u0441\u0446\u0438\u043a\u0443\u043b\u044f\u0446\u0438\u0438\n\u0413\u043e\u0444\u0444\u043c\u0430\u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043c\u044b\u0448\u0446.\n\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0414\u0430\u043d\u043e\u043d \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0410\u0413\n\u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u0433\u043b\u0438\u043a\u043e\u0433\u0435\u043d\u0430 \u0432\n\u043b\u0438\u0437\u043e\u0441\u043e\u043c\u0430\u0445, \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0414\u044e\u0448\u0435\u043d\u0430 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0433\u0438\u043f\u043e-\u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, \u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0439 \u0442\u0438\u043f \u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f,\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u043d\u044b\u0439 \u0441 \u043f\u043e\u043b\u043e\u043c; \u043e\u0447\u0435\u043d\u044c \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c\n\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0410\u041b\u0422, \u0410\u0421\u0422, \u041a\u0424\u041a;\n\u043c\u0438\u043e\u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0441\u0438\u0445\u043e-\u0440\u0435\u0447\u0435\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f;\n\u0443\u0440\u043e\u0432\u043d\u044f \u041a\u0424\u041a, \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u043d\u043e\u043f\u0430\u0442\u0438\u044f\n\u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f\n\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0438\u043b\u0438 \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435\n\u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u041b\u0422, \u0410\u0421\u0422, \u041a\u0424\u041a; \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0430\u044f\n\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u044b\u0448\u0446.\n\u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043b\u0430\u043a\u0442\u0430\u0442/\u043f\u0438\u0440\u0443\u0432\u0430\u0442 \u0432\n\u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0443\u043b\u044c\u0442\u0438\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0441\u0442\u044c \u043a\u0440\u043e\u0432\u0438; \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0424\u041a \u0432 \u043a\u0440\u043e\u0432\u0438.\n\u0433\u0435\u043d\u043e\u043c\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0424\u041a;\n\u0440\u0438\u0442\u043c\u0430 \u0441\u0435\u0440\u0434\u0446\u0430, \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0430\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0439 \u043c\u044b\u0448\u0446\u044b\n\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043c\u043e\u0442\u043e\u0440\u043d\u044b\u0435, \u0431\u043e\u043b\u044c, \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f \u0438 \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0424\u041a, \u041a\u041a; \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\n\u0441\u0435\u043d\u0441\u043e\u0440\u043d\u044b\u0435 \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u043c\u044b\u0448\u0446 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u043e \u043d\u0435\u0440\u0432\u0430\u043c \u043f\u0440\u0438 \u042d\u041d\u041c\u0413;\n\u043f\u043e\u043b\u0438\u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438 \u0433\u0438\u043f\u043e\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439.\n\u0433\u0438\u043f\u043e\u0442\u0438\u0440\u0435\u043e\u0437 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u043c\u0430\u043a\u0440\u043e\u0433\u043b\u043e\u0441\u0441\u0438\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0424\u041a, \u041a\u041a; \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u0443\u0440\u043e\u0432\u043d\u044f \u0422\u0422\u0413, \u0442\u0440\u0438\u0439\u043e\u0434\u0442\u0438\u0440\u043e\u043d\u0438\u043d\u0430; \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430\n\u043f\u0441\u0438\u0445\u043e-\u0440\u0435\u0447\u0435\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\n\u0411\u041f\u041f\u041d [20, 28]\n\u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0411\u0435\u043a\u043a\u0435\u0440\u0430, \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u043e\u043c\u0430, \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0440\u0438\u0433\u0438\u0434\u043d\u043e\u0433\u043e\n\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430, \u0441\u043f\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043c\u0438\u043e\u0442\u0440\u043e\u0444\u0438\u0438, \u043d\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043c\u0438\u043e\u0442\u0440\u043e\u0444\u0438\u0438, \u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u0437\u0438\u0442\u044b,\n\u043f\u043e\u043b\u0438\u043c\u0438\u043e\u0437\u0438\u0442\u044b, \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0414\u0430\u043d\u043e\u043d, \u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u044f.\n\n\u041d\u043e\u0437\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041e\u0431\u0449\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0444\u043e\u0440\u043c\u044b\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0411\u0435\u043a\u043a\u0435\u0440\u0430 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0433\u0438\u043f\u043e-\u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u0431\u0435\u043b\u043a\u0430 \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u043d\u0430;\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043f\u0441\u0435\u0432\u0434\u043e\u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0438, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0438\u043e\u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f, \u043e\u0440\u0433\u0430\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u0438.\n\u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u0438, \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f\n\u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0443\u043b\u044c\u0442\u0438\u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0430\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043c\u044b\u0448\u0446; \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f\n\u0433\u0435\u043d\u043e\u043c\u0430 \u043c\u0438\u0442\u043e\u0445\u043e\u043d\u0434\u0440\u0438\u0439.\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0440\u0438\u0433\u0438\u0434\u043d\u043e\u0433\u043e \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f, \u0433\u0438\u043f\u043e\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f \u0440\u0430\u043d\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0443\u0440\u044b \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445, \u0440\u0438\u0433\u0438\u0434\u043d\u044b\u0439\n\u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a\u0430 \u043f\u043e\u0437\u0432\u043e\u043d\u043e\u0447\u043d\u0438\u043a.\n\u0441\u043f\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, 2 \u0442\u0438\u043f \u042d\u041c\u0413, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043c\u0438\u043e\u043b\u0438\u0437\u0430, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439\n\u0430\u043c\u0438\u043e\u0442\u0440\u043e\u0444\u0438\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u041a\u0424\u041a, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0444\u0438\u0431\u0440\u0438\u043b\u043b\u044f\u0446\u0438\u0439,\n\u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u0438.\n\u043d\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f, \u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439,\n\u0430\u043c\u0438\u043e\u0442\u0440\u043e\u0444\u0438\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438; \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\n\u0441\u0442\u043e\u043f\u044b \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0441\u0432\u043e\u0434\u043e\u043c \u0438 \u044d\u043a\u0441\u0442\u0435\u043d\u0437\u0438\u0435\u0439\n\n9\n\n\u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0444\u0430\u043b\u0430\u043d\u0433.\n\u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u0437\u0438\u0442\u044b \u043a\u0430\u0440\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0438, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432\n\u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0441\u0435\u0440\u0434\u0446\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0445 \u043a\u0440\u043e\u0432\u0438\n\u043f\u043e\u043b\u0438\u043c\u0438\u043e\u0437\u0438\u0442\u044b \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0431\u043e\u043b\u0435\u0432\u043e\u0439 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0432\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0445 \u043a\u0440\u043e\u0432\u0438; \u0431\u043e\u043b\u0435\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0432 \u043c\u044b\u0448\u0446\u0430\u0445;\n\u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u044f.\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0414\u0430\u043d\u043e\u043d \u041c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u0430\u0440\u0438\u0442\u043c\u0438\u0438, \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0439\n\u043e\u0440\u0433\u0430\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0438 \u0441\u0435\u0440\u0434\u0446\u0430 \u0443\n\u0433\u0438\u043f\u0435\u0440\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445; \u0442\u0435\u0441\u0442 \u043d\u0430 \u041a\u0410\u0413 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439,\n\u043a\u0430\u0440\u0434\u0438\u043e\u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u0431\u0435\u043b\u043a\u0430 LAMP-2\n\u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u043c\u044b\u0448\u0446 \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043b\u0435\u0431\u0430\u043d\u0438\u0435 \u043c\u044b\u0448\u0435\u0447\u043d\u043e\u0439 \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\u043e\u0442\u0434\u0435\u043b\u043e\u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0435\u0439, \u0441\u0443\u0442\u043e\u043a; \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u043b\u044b \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0434\u044b\u0445\u0430,\n\u0430\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0437\u0435\u0440\u0438\u043d\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0431\u0430.\n\n13. \u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f [23-26]:\n\u2022 \u0432\u044b\u0437\u0432\u0430\u0442\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430;\n\n\u2022 \u0441\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438;\n\u2022 \u0437\u0430\u043c\u0435\u0434\u043b\u0438\u0442\u044c \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438\n\u043e\u0442 \u0441\u0442\u0430\u0434\u0438\u0438 \u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432;\n\n\u2022 \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0436\u0438\u0437\u043d\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430.\n\n14. \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n14.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n\n\u2022 \u0420\u0435\u0436\u0438\u043c \u0434\u043d\u044f;\n\u2022 \u0414\u0438\u0435\u0442\u0430 \u2013 \u0432\u044b\u0441\u043e\u043a\u043e\u0431\u0435\u043b\u043a\u043e\u0432\u0430\u044f, \u043d\u0438\u0437\u043a\u043e\u0443\u0433\u043b\u0435\u0432\u043e\u0434\u043d\u0430\u044f, \u043e\u0431\u043e\u0433\u0430\u0449\u0435\u043d\u043d\u0430\u044f L-\u0430\u043b\u0430\u043d\u0438\u043d\u043e\u043c [27];\n\u2022 \u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u2013 \u043f\u0441\u0438\u0445\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f;\n\n14.2.(cid:2) \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435:\n14.2.1 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435, \u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u043e\u0435 \u043d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435:\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u0444\u043e\u0440\u043c\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430\n(\u0438\u043c\u0435\u044e\u0449\u0438\u0445 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f).\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u0440\u0438 \u0411\u041f: \u0424\u0417\u0422, \u043f\u043e\u