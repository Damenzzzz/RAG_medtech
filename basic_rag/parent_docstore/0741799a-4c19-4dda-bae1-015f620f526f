d\u0438\u0439:\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0433\u0438\u043f\u043e\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u0438 -\u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u044f,\n\u0430\u0434\u0438\u043d\u0430\u043c\u0438\u044f,\n\u2022 \u0433\u0438\u043f\u043e\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u044f, \u043f\u0430\u0440\u0435\u0437 \u043a\u0438\u0448\u0435\u0447\u043d\u0438\u043a\u0430;\n\u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u0446\u0438\u0434\u043e\u0437\u0430 -\n\n\u043c\u0440\u0430\u043c\u043e\u0440\u043d\u043e\u0441\u0442\u044c \u0438 \u0446\u0438\u0430\u043d\u043e\u0437 \u043a\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432, \u0448\u0443\u043c\u043d\u043e\u0435\n\u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0434\u044b\u0445\u0430\u043d\u0438\u0435, \u0441\u043f\u0443\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f.\n\u0412\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u0438 \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\n\u0425\u043e\u043b\u0435\u0440\u0430 \u0411\u043e\u043b\u044c \u0432 \u0436\u0438\u0432\u043e\u0442\u0435 \u043d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0430. \u0421\u0442\u0443\u043b \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439, \u0446\u0432\u0435\u0442 \u0440\u0438\u0441\u043e\u0432\u043e\u0433\u043e\n\u043e\u0442\u0432\u0430\u0440\u0430 \u0431\u0435\u0437 \u0437\u0430\u043f\u0430\u0445\u0430, \u0438\u043d\u043e\u0433\u0434\u0430 \u0441 \u0437\u0430\u043f\u0430\u0445\u043e\u043c \u0441\u044b\u0440\u043e\u0439 \u0440\u044b\u0431\u044b. \u0420\u0432\u043e\u0442\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043f\u043e\u0441\u043b\u0435 \u0434\u0438\u0430\u0440\u0435\u0438. \u0411\u044b\u0441\u0442\u0440\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u044d\u043a\u0441\u0438\u043a\u043e\u0437\u0430. \u0418\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u044f\n\u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0442\u0435\u043b\u0430.\n\n\u0421\u0430\u043b\u044c\u043c\u043e\u043d\u0435\u043b\u043b\u0435\u0437 \u0412\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b \u0441 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c \u0437\u0430\u043f\u0430\u0445\u043e\u043c, \u0447\u0430\u0441\u0442\u043e \u0441 \u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u0437\u0435\u043b\u0435\u043d\u0438\n\u0438 \u0446\u0432\u0435\u0442\u0430 \u0431\u043e\u043b\u043e\u0442\u043d\u043e\u0439 \u0442\u0438\u043d\u044b. \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430,\n\u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f.\n\u041a\u0438\u0448\u0435\u0447\u043d\u044b\u0439 \u0438\u0435\u0440\u0441\u0438\u043d\u0438\u043e\u0437 \u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430. \u0418\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u043f\u0443\u043f\u043a\u0430 \u0438\u043b\u0438\n\u043f\u0440\u0430\u0432\u043e\u0439 \u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041e\u0431\u0438\u043b\u044c\u043d\u044b\u0439, \u0437\u043b\u043e\u0432\u043e\u043d\u043d\u044b\u0439, \u043d\u0435\u0440\u0435\u0434\u043a\u043e \u0441\n\u043f\u0440\u0438\u043c\u0435\u0441\u044c\u044e \u0441\u043b\u0438\u0437\u0438 \u0438 \u043a\u0440\u043e\u0432\u0438 \u0441\u0442\u0443\u043b. \u0412 \u043e\u0431\u0449\u0435\u043c \u0430\u043d\u0430\u043b\u0438\u0437\u0435 \u043a\u0440\u043e\u0432\u0438\n\u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0437 \u0441 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u0435\u0437\u043e\u043c.\n\u041e\u041a\u0418, \u0432\u044b\u0437\u0432\u0430\u043d\u043d\u0430\u044f \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\u0438 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430\u043c\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043a\u0442\u0430\n\u0443\u0441\u043b\u043e\u0432\u043d\u043e-\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u043c\u0438 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435 \u0433\u043e\u0434\u0430 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u0438\u0442 \u0438 \u044d\u043d\u0442\u0435\u0440\u0438\u0442, \u0440\u0435\u0436\u0435 \u2014\n\u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430\u043c\u0438 \u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u043e\u043a\u043e\u043b\u0438\u0442, \u044d\u043d\u0442\u0435\u0440\u043e\u043a\u043e\u043b\u0438\u0442. \u0423 \u0434\u0435\u0442\u0435\u0439 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u0436\u0438\u0437\u043d\u0438\n\u043a\u043b\u0438\u043d\u0438\u043a\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0441\u0440\u043e\u043a\u043e\u0432 \u0438\u043d\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u0423\n\u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u0436\u0438\u0437\u043d\u0438 \u043a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u043d\u0435\u0440\u0435\u0434\u043a\u043e\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0442\u043e\u043a\u0441\u0438\u043a\u043e\u0437\u0430 \u0438 \u044d\u043a\u0441\u0438\u043a\u043e\u0437\u0430 I\u2014II \u0441\u0442\u0435\u043f\u0435\u043d\u0438.\n\n\u0414\u0438\u0430\u0440\u0435\u044f \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u043e- \u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u043e\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430.\n\u0428\u0438\u0433\u0435\u043b\u043b\u0435\u0437 \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438, \u0447\u0430\u0441\u0442\u044b\u0439, \u0441\u043a\u0443\u0434\u043d\u044b\u0439, \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\n\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u043c\u0443\u0442\u043d\u043e\u0439 \u0441\u043b\u0438\u0437\u0438, \u043d\u0435\u0440\u0435\u0434\u043a\u043e \u2013 \u0437\u0435\u043b\u0435\u043d\u0438 \u0438 \u043a\u0440\u043e\u0432\u0438 \u0436\u0438\u0434\u043a\u0438\u0439 \u0441\u0442\u0443\u043b.\n\u042d\u043d\u0442\u0435\u0440\u043e\u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0435 \u042d\u041f\u042d: \u0440\u0430\u043d\u043d\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u0440\u0435\u0431\u0435\u043d\u043a\u0430; \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e; \u043d\u0435\u0447\u0430\u0441\u0442\u0430\u044f, \u043d\u043e\n\u044d\u0448\u0435\u0440\u0438\u0445\u0438\u0438 (\u042d\u041f\u042d) \u0443\u043f\u043e\u0440\u043d\u0430\u044f \u0440\u0432\u043e\u0442\u0430; \u043c\u0435\u0442\u0435\u043e\u0440\u0438\u0437\u043c; \u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b;\n\n\u042d\u0422\u042d: \u041d\u0430\u0447\u0430\u043b\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043e\u0441\u0442\u0440\u043e\u0435, \u0441 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\n\u042d\u043d\u0442\u0435\u0440\u043e\u0438\u043d\u0432\u0430\u0437\u0438\u0432\u043d\u044b\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u0440\u0432\u043e\u0442\u044b, \u00ab\u0432\u043e\u0434\u044f\u043d\u0438\u0441\u0442\u043e\u0439\u00bb \u0434\u0438\u0430\u0440\u0435\u0438. \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0442\u0435\u043b\u0430 \u0447\u0430\u0449\u0435\n\u044d\u0448\u0435\u0440\u0438\u0445\u0438\u0438 (\u042d\u0418\u042d)\n\u0432\u0441\u0435\u0433\u043e \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u044b \u0438\u043b\u0438 \u0441\u0443\u0431\u0444\u0435\u0431\u0440\u0438\u043b\u044c\u043d\u0430\u044f. \u0418\u0441\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f\n\u043b\u0438\u0448\u0435\u043d\u044b \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0430\u043b\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0430\u0445\u0430, \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0438\u043c\u0435\u0441\u0438\n\u0432 \u043d\u0438\u0445 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442, \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442 \u0440\u0438\u0441\u043e\u0432\u044b\u0439 \u043e\u0442\u0432\u0430\u0440. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f\n\u044d\u043a\u0441\u0438\u043a\u043e\u0437.\n\n\u042d\u0418\u042d:\n\u042d\u043d\u0442\u0435\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u0433\u0435\u043d\u043d\u044b\u0435 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e,\n\u044d\u0448\u0435\u0440\u0438\u0445\u0438\u0438 (\u042d\u0422\u042d) \u043e\u0441\u0442\u0440\u043e, \u0441 \u043f\u043e\u0434\u044a\u0435\u043c\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b \u0442\u0435\u043b\u0430, \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0439 \u0431\u043e\u043b\u0438, \u0442\u043e\u0448\u043d\u043e\u0442\u044b,\n\u043d\u0435\u0440\u0435\u0434\u043a\u043e \u2014 \u0440\u0432\u043e\u0442\u044b, \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u0431\u043e\u043b\u0435\u0439 \u0432 \u0436\u0438\u0432\u043e\u0442\u0435. \u041e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438\u043b\u0438\n\u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0436\u0438\u0434\u043a\u0438\u0439 \u0441\u0442\u0443\u043b \u0441 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u043f\u0440\u0438\u043c\u0435\u0441\u044f\u043c\u0438.\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0412\u041e\u0417 \u0438 ESPGHAN/ESPID (2008, 2014):\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0443 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u043f\u043e \u0412\u041e\u0417:\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432 % \u043f\u043e \u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0432\n\u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044e \u043a \u043c\u0430\u0441\u0441\u0435 \u0442\u0435\u043b\u0430 \u043c\u043b/\u043a\u0433 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\n\u041d\u0435\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 <5% <50 \u043c\u043b/\u043a\u0433\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f\n\u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c 5-10% 50-100 \u043c\u043b/\u043a\u0433\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f\n\n\u041e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 >10% >100 \u043c\u043b/\u043a\u0433\n\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0444\u043e\u0440\u043c\u0435\n\u0422\u044f\u0436\u0435\u0441\u0442\u044c \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438 \u0432 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0430\u0445 \u043e\u0442 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0434\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\n\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u041b\u0435\u0433\u043a\u0430\u044f % \u0421\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0422\u044f\u0436\u0435\u043b\u0430\u044f %\n%\nDell (1973) 5 5-10 10 -15\n\nRobson (1987) 4-5 6-9 \u2265 10\n\nESPGHAN \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0448\u043a\u0430\u043b\u0443 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438\n(Clinical Dehydration Scale \u2013 CDS), \u0433\u0434\u0435 0 \u0431\u0430\u043b\u043b\u043e\u0432 \u2013 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u043e\u0442\n1 \u0434\u043e 4 \u0431\u0430\u043b\u043b\u043e\u0432 \u2013 \u043b\u0435\u0433\u043a\u0430\u044f \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u044f, 5\u20138 \u0431\u0430\u043b\u043b\u043e\u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438\n\u0442\u044f\u0436\u0435\u043b\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438.\n\nClinical Dehydration Scale (CDS):\n\u041f\u0440\u0438\u0437\u043d\u0430\u043a \u0411\u0430\u043b\u043b\u044b\n0 1 2\n\n\u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434 \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0416\u0430\u0436\u0434\u0430, \u0412\u044f\u043b\u043e\u0441\u0442\u044c,\n\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e, \u0441\u043e\u043d\u043b\u0438\u0432\u043e\u0441\u0442\u044c\n\u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\n\u0413\u043b\u0430\u0437\u043d\u044b\u0435 \u044f\u0431\u043b\u043e\u043a\u0438 \u041d\u0435 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0421\u043b\u0435\u0433\u043a\u0430 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0417\u0430\u043f\u0430\u0432\u0448\u0438\u0435\n\n\u0421\u043b\u0438\u0437\u0438\u0441\u0442\u044b\u0435 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u0412\u043b\u0430\u0436\u043d\u044b\u0435 \u0441\u0443\u0445\u043e\u0432\u0430\u0442\u044b\u0435 \u0421\u0443\u0445\u0438\u0435\n\u0421\u043b\u0435\u0437\u044b \u0421\u043b\u0435\u0437\u043e\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432 \u0421\u043b\u0435\u0437\u043e\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0421\u043b\u0435\u0437\u044b\n\u043d\u043e\u0440\u043c\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442\n\n\u0422\u044f\u0436\u0435\u0441\u0442\u044c \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u043f\u043e \u0418\u0412\u0411\u0414\u0412 \u0443 \u0434\u0435\u0442\u0435\u0439 \u0434\u043e 5 \u043b\u0435\u0442 [1, 2]:\n\n\u041d\u0435\u0442 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u0422\u044f\u0436\u0435\u043b\u043e\u0435 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435\n\u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435\n\n\u041d\u0435\u0442 \u0434\u0432\u0443\u0445 \u2022 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u043e \u0438\u043b\u0438 \u2022 \u0437\u0430\u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c/\u043f\u043e\u043d\u0438\u0436\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u0435 \u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c\n\u0434\u0432\u0443\u0445 \u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u043c\u043e\u0441\u0442\u044c; \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f;\n\u0431\u043e\u043b\u0435\u0435 \u043e\u0431\u0435\u0437\u0432\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u2022 \u0437\u0430\u043f\u0430\u0432\u0448\u0438\u0435 \u0433\u043b\u0430\u0437\u0430; \u2022 \u043f\u044c\u0435\u0442 \u043f\u043b\u043e\u0445\u043e, \u0438\u043b\u0438 \u043d\u0435\n\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u2022 \u043a\u043e\u0436\u043d\u0430\u044f \u0441\u043a\u043b\u0430\u0434\u043a\u0430 \u043c\u043e\u0