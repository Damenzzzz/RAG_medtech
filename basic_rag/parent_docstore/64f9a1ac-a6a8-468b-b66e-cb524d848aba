5\u0440\u0438\u043e\u0434\u0435\n\u043c\u0435\u0442\u0430\u043c\u0438\u0437\u043e\u043b 1-2 ml 50% 2-3 \u0440\u0430\u0437\u0430 \u0432/\u0432, \u043f\u043e \u043c\u0435\u0440\u0435 \u043d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0421\n\u043d\u0430\u0442\u0440\u0438\u044f \u0438\u043b\u0438 \u0432/\u043c \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a \u2013 \u0434\u043b\u044f\n2,0-5,0 \u043c\u043b- \u0432\u043d\u0443\u0442\u0440\u044c, \u0431\u043e\u043b\u0438 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f\n\u0438\u043b\u0438 25% 500 \u043c\u0433\n\u043a\u0435\u0442\u043e\u043f\u0440\u043e\u0444\u0435\u043d 150 \u043c\u0433, 2-3 \u0440\u0430\u0437\u0430 \u0432/\u043c, \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2-3 \u043d\u0435\u043d\u0430\u0440\u043a\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0410\n100 \u043c\u0433; \u0432/\u0432, \u0434\u043d\u0435\u0439 \u0430\u043d\u0430\u043b\u044c\u0433\u0435\u0442\u0438\u043a \u2013 \u0434\u043b\u044f\n100\u2013200 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u044f\n\n\u0410\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u0446\u0435\u0444\u0442\u0430\u0437\u0438\u0434\u0438\u043c 0,5\u20132 \u0433 2-3 \u0440\u0430\u0437\u0430 \u0432 \u0432\\\u043c, \u043e\u0442 7-14 \u0434\u043d\u0435\u0439 \u0446\u0435\u0444\u0430\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u044b 3- \u0410\n\u0438\u043b\u0438 \u0441\u0443\u0442\u043a\u0438 \u0432/\u0432 \u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f\n\u0446\u0435\u0444\u0442\u0440\u0438\u0430\u043a\u0441\u043e\u043d 1,0 \u0433 1-2 \u0440\u0430\u0437\u