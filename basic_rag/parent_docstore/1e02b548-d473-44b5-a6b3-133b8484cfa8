2\u044f\u0436\u0435\u043b\u044b\u0445 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 D\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u041f\u0426\u0420 \u0434\u043e 6\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0434\u043e\u0437\u044b\n\u0430\u043d\u0442\u0438\u0442\u0438\u043c\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u043e\u0433\u043e \u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0430 (\u0435\u0441\u043b\u0438\n\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f) \u0438\u043b\u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f\n\u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043b\u0438\u043c\u0444\u043e\u0446\u0438\u0442\u043e\u0432\n\u0431\u043e\u043b\u0435\u0435 300 \u043a\u043b\u0435\u0442\u043e\u043a \u0432 \u043c\u043a\u043b.\n2. \u041c\u0438\u0435\u043b\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f. \u041f\u0440\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438\n\u0443\u0440\u043e\u0432\u043d\u044f \u043b\u0435\u0439\u043a\u043e\u0446\u0438\u0442\u043e\u0432 \u043c\u0435\u043d\u0435\u0435 1 \u0442\u044b\u0441/\u043c\u043a\u043b\n\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0434\u043e\u0437\u044b \u043d\u0430 50% \u0438 \u043e\u0442\u043c\u0435\u043d\u0430\n\n94\n\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u043c\u0435\u043d\u0435\u0435 0,5 \u0442\u044b\u0441/\u043c\u043a\u043b.\n\u0414\u043e\u0437\u0430 \u0441\u043d\u0438\u0436\u0430\u0435\u0442\u0441\u044f \u0434\u043e 0,75 \u043c\u0433/\u043c2 \u043f\u0440\u0438 \u0421\u041a\u0424 30-\n50 \u043c\u043b/\u043c\u0438\u043d \u0438 \u043e\u0442\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438\n\u043c\u0435\u043d\u0435\u0435 30 \u043c\u043b/\u043c\u0438\u043d/1.73 \u043c2.\n3. \u041d\u0435\u0439\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c. \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u043e\u0442\u043c\u0435\u043d\u044b\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430.\n\u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 [195, 196, \u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u0435\u043d \u043f\u0440\u0438 \u0420\u0422\u041f\u0425 \u043a\u043e\u0436\u0438 (77% \u043e\u0442\u0432\u0435\u0442\u043e\u0432), \u043f\u0435\u0447\u0435\u043d\u0438 (72% 1. \u041c\u0438\u0435\u043b\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u0432 15% \u0441\u043b\u0443\u0447\u0430\u0435\u0432. \u041d\u0435 D\n197] \u043e\u0442\u0432\u0435\u0442\u043e\u0432). \u041c\u043e\u0436\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0420\u0422\u041f\u0425 \u043a\u0438\u0448\u043a\u0438 (50% \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u043e\u0442\u0432\u0435\u0442\u043e\u0432), \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0440\u0442\u0430 (42,5% \u043e\u0442\u0432\u0435\u0442\u043e\u0432) \u0438 \u043b\u0435\u0433\u043a\u0438\u0445. \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f.\n\u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435:5-10 \u043c\u0433 \u0432/\u0432 \u0438\u043b\u0438 10-15 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c, \u0434\u0430\u043b\u0435\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 3\n2. \u0418\u043c\u0435\u0435\u0442\u0441\u044f \u0440\u0438\u0441\u043a \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043c\u0443\u043a\u043e\u0437\u0438\u0442\u0430 (\u0432\n\u0438\u043b\u0438 4 \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f (\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u043f\u043e\u0441\u043b\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\u0445 \u043f\u043e \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425 \u0441\u043b\u0443\u0447\u0430\u0438\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u043c\u043e\u0436\u0435\u0442 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0434\u043e\n\u043c\u0443\u043a\u043e\u0437\u0438\u0442\u0430 \u043d\u0435 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u044b)\n7 \u0434\u043d\u0435\u0439) \u0434\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430,\n\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438 \u0420\u0422\u041f\u0425 \u0438\u043b\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 (\u043c\u0443\u043a\u043e\u0437\u0438\u0442\nIII-IV \u0441\u0442\u0435\u043f\u0435\u043d\u0438, \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f).\n\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0434\u043e 6 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0439, \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u043e\u0442 2 \u0434\u043e 3 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0439.\n\u0414\u043e\u0437\u0430 Mtx \u0441\u043d\u0438\u0436\u0430\u0435\u0442\u0441\u044f \u0434\u043e 5 \u043c\u0433 \u0432/\u0432 (10 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c) \u043f\u0440\u0438 \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u0438\n\u043c\u0435\u043d\u0435\u0435 2 \u0442\u044b\u0441/\u043c\u043a\u043b \u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0438 \u043c\u0435\u043d\u0435\u0435 50 \u0442\u044b\u0441/\u043c\u043a\u043b.\n\u0426\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 [198] \u041d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u043e\u0442\u0432\u0435\u0442\u043e\u0432 \u043f\u0440\u0438 \u0420\u0422\u041f\u0425 \u043a\u043e\u0436\u0438 (100% \u041c\u0438\u0435\u043b\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f\n\u043f\u043e\u043b\u043d\u044b\u0445 \u043e\u0442\u0432\u0435\u0442\u043e\u0432), \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u0440\u0442\u0430 (50% \u043f\u043e\u043b\u043d\u044b\u0445, 50% \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445), \u0446\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441\u0430, \u043f\u043e\u043b\u0438\u043e\u043c\u043e\u0432\u0438\u0440\u0443\u0441\u0430.\n\u043f\u0435\u0447\u0435\u043d\u0438 (60% \u043f\u043e\u043b\u043d\u044b\u0445, 10% \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445). \u041f\u0440\u0438 \u0420\u0422\u041f\u0425 \u043a\u0438\u0448\u043a\u0438\n\u043d\u0435\u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u0435\u043d (\u043d\u0435\u0442 \u043f\u043e\u043b\u043d\u044b\u0445 \u043e\u0442\u0432\u0435\u0442\u043e\u0432, 29% \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445).\n\u0414\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: 1000 \u043c\u0433/\u043c2 \u0432/\u0432 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438, \u0431\u0435\u0437\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0443\u0440\u043e\u043c\u0438\u0442\u0435\u043a\u0441\u0430\u043d\u0430, \u043a\u043e\u043b\u043e\u043d\u0438\u0435\u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u0445\n\u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432\n\u0410\u043d\u0442\u0438\u0442\u0438\u043c\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439 \u0418\u043d\u0444\u0443\u0437\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043f\u0430\u043b\u0430\u0442\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438, 1. \u0410\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u0438 D\n\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d [199, 200, 201] \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0410\u0414, SO2, \u0427\u0421\u0421. \u0414\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0430\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u043e\u043a. \u041f\u0435\u0440\u0435\u0434 \u043f\u0435\u0440\u0432\u044b\u043c\n\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u044b \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u043a\u043e\u0436\u043d\u0430\u044f\n\u043b\u0435\u0433\u043a\u0438\u0445 \u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0430\u043d\u0430\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0448\u043e\u043a\u0430 \u0438\n\u043f\u0440\u043e\u0431\u0430 (0,1 \u043c\u043b \u0432 \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0438 1:1000). \u041f\u0435\u0440\u0435\u0434\n\u0434\u0440\u0443\u0433\u0438\u0445 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0430\u043b\u043b\u0435\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u0439\n\u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u041a\u0440\u043e\u043b\u0438\u0447\u0438\u0439 \u0430\u043d\u0442\u0438\u0442\u0438\u043c\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439 \u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d: \u0412/\u0432 0,5 \u043c\u0433/\u043a\u0433 \u0432 \u0434\u043b\u044f\n\u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\u044f \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0413\u041a\u0421\n\u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0434\u043e 1-1,5 \u043c\u0433/\u043a\u0433 \u0434\u043b\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445.\n(\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0438\u043b\u0438 \u043c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u043d\u0435\n\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u0430\u044f \u0434\u043e\u0437\u0430 6-7,5 \u043c\u0433/\u043a\u0433. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043a\u0443\u0440\u0441\u0430\n\u043c\u0435\u043d\u0435\u0435 1\u043c\u0433/\u043a\u0433)\n95\n\n4-7 \u0434\u043d\u0435\u0439. 2. \u0421\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u0430\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u044c (5-10%) \u2013\n\u041b\u043e\u0448\u0430\u0434\u0438\u043d\u043d\u044b\u0439 \u0430\u043d\u0442\u0438\u0442\u0438\u043c\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0439 \u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d: \u0412/\u0432 15 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 No6 \u0434\u0438\u0441\u043f\u043d\u043e\u0435, \u0430\u0440\u0442\u0440\u0430\u043b\u0433\u0438\u0438, \u0431\u043e\u043b\u0438 \u0432 \u0433\u0440\u0443\u0434\u043d\u043e\u0439\n\u043a\u043b\u0435\u0442\u043a\u0435, \u0441\u043f\u0438\u043d\u0435, \u0434\u0438\u0430\u0440\u0435\u044f, \u0442\u043e\u0448\u043d\u043e\u0442\u0430, \u0440\u0432\u043e\u0442\u0430.\n3. \u041c\u0438\u0435\u043b\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u2013 \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f,\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f.\n4. \u0412\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439\n\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u041f\u0426\u0420 \u0434\u043e 6\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0441\u043b\