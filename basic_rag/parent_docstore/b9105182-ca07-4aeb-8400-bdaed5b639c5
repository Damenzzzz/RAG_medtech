38\u044f\n\n\u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\n\u044b\u0439\n(Intermediate)\n\u0441 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c\n\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0440\u0438\u0441\u043a\u0430\n(R.O.)\n\u041f\u043b\u043e\u0445\u043e\u0439 \u0412\u0435\u0442\u0432\u044c \u0410: \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435\n(Worse) \u0431\u0435\u0437 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0432\u0435\u0442\u0432\u044c \u0412\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0432 \u0412\u0435\u0442\u0432\u044c \u0412: \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f\n\u043e\u0440\u0433\u0430\u043d\u0430\u0445 \u0440\u0438\u0441\u043a\u0430\n(R.O.)\n\n\u041f\u043b\u043e\u0445\u043e\u0439 \u0422\u0435\u0440\u0430\u043f\u0438\u044f \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f\n(Worse) \u0441\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c\n\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0440\u0438\u0441\u043a\u0430\n(R.O.)\n12 \u043c\u0435\u0441\u044f\u0446 \u041e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435 \u0411\u041f\u0410 (NAD) \u0421\u0422\u041e\u041f (\u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0435\u0439 \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u2013\n\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\n\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430)\n\n12.12.2 \u0413\u0420\u0423\u041f\u041f\u0410 2 \u0413\u0420\u0423\u041f\u041f\u0410 \u041d\u0418\u0417\u041a\u041e\u0413\u041e \u0420\u0418\u0421\u041a\u0410 (\u201c LOW RISK \u201d).\n\n\u0441\u0440\u043e\u043a \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u0432\u0435\u0442 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n6-\u044f \u043d\u0435\u0434\u0435\u043b\u044f \u041f\u043e\u0441\u043b\u0435 1-\u0433\u043e \u0411\u041f\u0410 (NAD) \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f,\n\u043a\u0443\u0440\u0441\u0430 \u0425\u043e\u0440\u043e\u0448\u0438\u0439 \u0420\u0430\u043d\u0434\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u044f: LR6 \u0438\u043b\u0438\n\u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 (Better) LR12\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b 2-\u0439 \u043a\u0443\u0440\u0441 \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u0439 (Intermediate) \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u041f\u043b\u043e\u0445\u043e\u0439 (Worse) 2-\u0439 \u043a\u0443\u0440\u0441 \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\n48\n\n12-\u044f \u043d\u0435\u0434\u0435\u043b\u044f \u041f\u043e\u0441\u043b\u0435 2-\u0433\u043e \u0411\u041f\u0410 (NAD) \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u043a\u0443\u0440\u0441\u0430 \u0425\u043e\u0440\u043e\u0448\u0438\u0439\n\u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 (Better)\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0439 (Intermediate)\n\n\u041f\u043b\u043e\u0445\u043e\u0439 (Worse) \u041e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\n\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440\u043e\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\n7-\u044f \u043d\u0435\u0434\u0435\u043b\u044f \u0438\u043b\u0438 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0411\u041f\u0410 (NAD) \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n13-23 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449 \u0425\u043e\u0440\u043e\u0448\u0438\u0439\n\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (LR (Better)\n12) \u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0439 (Intermediate)\n\n\u041f\u043b\u043e\u0445\u043e\u0439 (Worse) \u041e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0442\u0430\u043a\u0442\u0438\u043a\u0438 \u0441\n\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440\u043e\u043c\n6 \u043c\u0435\u0441\u044f\u0446 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0411\u041f\u0410 (NAD) \u041f\u0422 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 (LR6) \u0421\u0422\u041e\u041f\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\n\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n(LR12) \u0425\u043e\u0440\u043e\u0448\u0438\u0439 \u041f\u0422 12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 (LR12)\n(Better) \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u0439 (Intermediate)\n\u041f\u043b\u043e\u0445\u043e\u0439 (worse) \u0420\u0435-\u0441\u0442\u0430\u0440\u0442 \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043f\u043b\u0435\u0447\u043e \u0412.\n\u041c\u0435\u0441\u044f\u0446 6-12 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0411\u041f\u0410 (NAD) \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449 \u0425\u043e\u0440\u043e\u0448\u0438\u0439\n\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (LR (Better)\n12) \u041f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0439 (Intermediate)\n\n\u041f\u043b\u043e\u0445\u043e\u0439 (worse) \u0420\u0435-\u0441\u0442\u0430\u0440\u0442 \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u043f\u043b\u0435\u0447\u043e \u0412\n\u041c\u0435\u0441\u044f\u0446 12 \u041e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435 \u0421\u0422\u041e\u041f\n\n\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449 (\u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u0435\u0440\u0441\u0438\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\n\u0435\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 (LR \u043e\u0447\u0430\u0433\u043e\u0432 \u0438\u043b\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445\n12) \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u2013\n\u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\n\n\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440\u043e\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430)\n\n12.12.3 \u0413\u0420\u0423\u041f\u041f\u0410 3. \u041f\u0410\u0426\u0418\u0415\u041d\u0422\u042b \u0421 \u041c\u0423\u041b\u042c\u0422\u0418\u0424\u041e\u041a\u0410\u041b\u042c\u041d\u042b\u041c\n\u041f\u041e\u0420\u0410\u0416\u0415\u041d\u0418\u0415\u041c \u041a\u041e\u0421\u0422\u0415\u0419 \u0418\u041b\u0418 \u041d\u0410\u041b\u0418\u0427\u0418\u0415\u041c \u00ab\u0421\u041f\u0415\u0426\u0418\u0410\u041b\u042c\u041d\u042b\u0425 \u041e\u0427\u0410\u0413\u041e\u0412\u00bb\n\n\u042f\u041c\u0420 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u0438\\\u0438\u043b\u0438 \u041a\u0422 \u2013 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435) \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430 \u0438\u043b\u0438 \u0441\u043f\u0438\u043d\u043d\u043e\u0433\u043e\n\u043c\u043e\u0437\u0433\u0430 \u0434\u043e\u043b\u0436\u043d\u043e \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u0440\u0438 \u043e\u0446\u0435\u043d\u043a\u0435 \u043e\u0442\u0432\u0435\u0442\u0430 \u043d\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u044e, \u0435\u0441\u043b\u0438\n\u0438\u043c\u0435\u044e\u0442\u0441\u044f \u043e\u0447\u0430\u0433\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441 \u0438\u043d\u0442\u0440\u0430\u043a\u0440\u0430\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u043b\u0438\u0431\u043e\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u043f\u0438\u043d\u043d\