31\u0430\u0432\u043e\u0447\u043d\u044b\u043c\u0438 \u0442\u0435\u0441\u0442\u0430\u043c\u0438 (\u043b\u0430\u043a\u0442\u0430\u0442,\n\n\u0433\u043b\u044e\u043a\u043e\u0437\u0430, \u043a\u0430\u0440\u0431\u043e\u043a\u0441\u0438\u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d)\n\u2022 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0442\u0440\u043e\u043c\u0431\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438\n(\u0410\u0427\u0422\u0412) \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0435\n\n\u2022 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0440\u043e\u043c\u0431\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u043c \u041f\u0422\u0418 \u0438\n\u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f (\u041c\u041d\u041e) \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430\n\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u0435 (\u041f\u0412-\u041f\u0422\u0418-\u041c\u041d\u041e)\n\u2022 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0442\u0440\u043e\u043c\u0431\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 (\u0422\u0412) \u0432 \u043f\u043b\u0430\u0437\u043c\u0435 \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 \u0430\u043d\u0430\u043b\u