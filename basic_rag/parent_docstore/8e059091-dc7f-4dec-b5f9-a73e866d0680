u0432\u043d\u0443\u0442\u0440\u044c \u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0433\u0440\u0438\u0431\u043a\u043e\u0432\u043e\u0435 \u0410\n\u0441\u0443\u0442\u043a\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e, \u0434\u043b\u044f\n\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f\n\u043c\u0438\u043a\u043e\u0437\u043e\u0432\n\n\u0410\u043d\u0442\u0438\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043f\u0430\u043d\u0442\u043e\u043f\u0440\u043e\u0437\u043e\u043b 40 \u2013 80 \u043c\u0433 1-2 \u0440\u0430\u0437\u0430 \u0432\u043d\u0443\u0442\u0440\u044c 2-4 \u043d\u0435\u0434\u0435\u043b\u0438 \u0430\u043d\u0442\u0438\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0439 \u0410\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 - \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\n\u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043f\u044b\n\u043e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b 1,4-20\u043c\u0433/\u043a\u0433 1 \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c \u0432\u043d\u0443\u0442\u0440\u044c 1 \u043c\u0435\u0441\u044f\u0446 \u0430\u043d\u0442\u0438\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0439 \u0410\n\u0432 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 - \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442 \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043f\u044b\n\u0438 \u043e\u0442 \u0432\u0435\u0441\u0430\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\n\u0440\u0430\u043d\u0438\u0442\u0438\u0434\u0438\u043d 2-3\u043c\u0433/\u043a\u0433 2 \u0440\u0430\u0437\u0430 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c 4\u20138 \u043d\u0435\u0434 \u0430\u043d\u0442\u0438\u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0440\u043d\u044b\u0439 \u0410\n\u0434\u0435\u043d\u044c \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u2013 \u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\n\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u043e\u0432\u044b\u0445 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0440\u043e\u0432\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u044b\u0435, \u0441\u043f\u0430\u0437\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435, \u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435,\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u044b\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\u043c\u0435\u0442\u043e\u043a\u043b\u043e\u043f\u0440\u0430\u043c\u0438\u0434 5\u201310 \u043c\u0433; 3 \u0440\u0430\u0437\u0430 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c, \u043f\u043e \u043f\u0440\u043e\u043a\u0438\u043d\u0435\u0442\u0438\u043a, \u0412\n10 \u043c\u0433; \u0441\u0443\u0442\u043a\u0438 \u0432/\u043c, \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0432\u043e\u0442\u043d\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n10 \u043c\u0433 \u0432/\u0432\n\n10\n\n\u0434\u0440\u043e\u0442\u0430\u0432\u0435\u0440\u0438\u043d \u0412\u043d\u0443\u0442\u0440\u044c \u2014 2\u20133 \u0440\u0430\u0437\u0430 \u0432 \u0432\u043d\u0443\u0442\u0440\u044c, \u043f\u043e \u043c\u0435\u0440\u0435 \u0441\u043f\u0430\u0437\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0421\n\n\u043f\u043e 0,04\u2013 \u0441\u0443\u0442\u043a\u0438 \u043f/\u043a, \u0432/\u043c \u043a\u0443\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e\n0,08 \u0433. \u0441\u043f\u0430\u0437\u043c\u0430\n\u0412/\u043c, \u043f/\u043a \u2014\n2\u20134 \u043c\u043b\n\u0430\u0442\u0440\u043e\u043f\u0438\u043d\u0430 0,00025- \u043f\u0435\u0440\u0435\u0434 \u043f/\u043a, \u0434\u043b\u044f \u041c-\u0445\u043e\u043b\u0438\u043d\u043e\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440 \u0412\n\u0441\u0443\u043b\u044c\u0444\u0430\u0442 0,005-0,001 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0432/\u0432, \u043f\u0440\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u0446\u0438\n\u043c\u0433 \u0432/\u043c \u0438\n1 %\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430\n\u0414\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 4\u043c\u0433/1\u043c\u043b \u043f\u0440\u0438 \u0432/\u043c \u0432 \u0433\u043b\u044e\u043a\u043e\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0439 \u0410\n\u0443\u0440\u0433\u0435\u043d\u0442\u043d\u044b\u0445 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442,\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u0445 \u043e\u0442 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\n\u0431\u043e\u043b\u044c\u043d\u043e\u0433\u043e\n\n\u043a\u0430\u043b\u0438\u044f \u0445\u043b\u043e\u0440\u0438\u0434 40-50 \u043c\u043b 1 \u0440\u0430\u0437 \u0432/\u0432, \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0412\n2,5 \u0433 \u0432 500 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u044b\u0445\n\u043c\u043b \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043e\u0432\n\u0432 \u043a\u0440\u043e\u0432\u0438\n\u0410\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\n\u043f\u043e\u0432\u0438\u0434\u043e\u043d \u2013 \u0439\u043e\u0434 10% \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u043f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a, \u0434\u043b\u044f \u0412\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043a\u043e\u0436\u043d\u044b\u0445\n\u0442\u0438 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432 \u0438 \u0434\u0440\u0435\u043d\u0430\u0436\u043d\u044b\u0445\n\u0441\u0438\u0441\u0442\u0435\u043c\n\u0445\u043b\u043e\u0440\u0433\u0435\u043a\u0441\u0438\u0434\u0438\u043d 0,05% \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u043f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a \u0410\n\u0432\u043e\u0434\u043d\u044b\u0439 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\n\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d \u0442\u0438\n\u043e\u0433\u043e \u043f\u043e\u043b\u044f,\n\u0440\u0443\u043a \u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\u044d\u0442\u0430\u043d\u043e\u043b, \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0434\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u043f\u043e \u043c\u0435\u0440\u0435 \u0410\n70%; \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d \u0442\u0438\n\u043e\u0433\u043e \u043f\u043e\u043b\u044f,\n\u0440\u0443\u043a \u0445\u0438\u0440\u0443\u0440\u0433\u0430\n\u043f\u0435\u0440\u0435\u043a\u0438\u0441\u044c 3% \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u0414\u043b\u044f \u043d\u0430\u0440\u0443\u0436\u043d\u043e \u043f\u043e \u043c\u0435\u0440\u0435 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a \u2013 \u043e\u043a\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u044c, \u0410\n\u0432\u043e\u0434\u043e\u0440\u043e\u0434\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043c\u0435\u0441\u0442\u043d\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441 \u0434\u043b\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0440\u0430\u043d\n\u0440\u0430\u043d \u0442\u0438\n\u0417\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c\n\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d 10%-200 \u0414\u043e\u0437\u0430 \u0438 \u0432/\u0432 \u043f\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0412\n\u043c\u043b, 20%- \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446 \u043a\u0430\u043f\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f\n100,0 \u043c\u043b. \u0438\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u0442 - \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043e\u0442 \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u0438\u043f\u043e\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0435\u043c\u0438\u0438\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d\u0430\n\u0432 \u043a\u0440\u043e\u0432\u0438.\n\u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043d\u0430\u044f \u041f\u043e 1-2 \u0440\u0430\u0437\u0430 \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b \u043f\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 \u0410\n\u0432\u0437\u0432\u0435\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u044c\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043a\u0440\u043e\u0432\u0438 - \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043b\u0435\u0439\u043a\u043e\u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432 \u0430\u043d\u0435\u043c\u0438\u0438\n\u0430\u043d\u043d\u0430\u044f, 350 \u043c\u043b\n\u0441\u0432\u0435\u0436\u0435\u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435 220 \u043c\u043b 1-2 \u0440\u0430\u0437\u0430 \u0432/\u0432 \u043a\u0430\u043f\u0435\u043b \u043f\u043e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 \u0410\n\u043d\u043d\u0430\u044f \u043f\u043b\u0430\u0437\u043c\u0430 \u044c\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043a\u0440\u043e\u0432\u0438- \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438\n\n11\n\n\u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u0430,\n\n\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f 1 \u043a \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u041a\u041f.\n\n7) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432:\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0430\u043d\u0435\u0441\u0442\u0435\u0437\u0438\u043e\u043b\u043e\u0433\u0430 \u2013 \u043f\u0440\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0435 \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438;\n\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430 \u2013 \u0432 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0442\u044f\u0436\u0451\u043b\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0438\n\u043e\u0431\u044a\u0451\u043c \u0434\u0435\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u043e\u0433\u0430, \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0430, \u0443\u0440\u043e\u043b\u043e\u0433\u0430, \u0433\u0438\u043d\u0435\u043a\u043e\u043b\u043e\u0433\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0437\u043a\u0438\u0445\n\n\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u043e\u0432 \u2013 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c.\n\n8) \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0438 \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438:\n\u0412 \u043f\u0430\u043b\u0430\u0442\u044b \u0440\u0435\u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0431\u043e\u043b\u044c\u043d\u044b\u0435\n\n\u0441 \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0433\u0435\u043c\u043e\u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u044d\u0442\u0438\u043e\u043b\u043e\u0433\u0438\u0438 (\u043e\u0441\u0442\u0440\u0430\u044f \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\n\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0442\u0440\u0430\u0432\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u043e\u043a, \u0433\u0438\u043f\u043e\u0432\u043e\u043b\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u043e\u043a,\n\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0435\u043d\u043d\u044b\u0439 \u0448\u043e\u043a \u0438 \u0434\u0440.), \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0434\u044b\u0445\u0430\u043d\u0438\u044f, \u0434\u0440\u0443\u0433\u0438\u043c\u0438\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c (\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439\n\u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043f\u0430\u0440\u0435\u043d\u0445\u0438\u043c\u0430\u0442\u043e\u0437\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0438 \u0434\u0440.), \u043e\u0441\u0442\u0440\u044b\u043c\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u043c\u0438\n\n\u043e\u0431\u043c\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432, \u0431\u043e\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432, \u043f\u043e\u0432\u043b\u0451\u043a\u0448\u0438\u0445 \u0437\u0430\n\u0441\u043e\u0431\u043e\u0439 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0436\u0438\u0437\u043d\u0435\u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u043f\u0440\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0443\u0433\u0440\u043e\u0437\u0435 \u0438\u0445\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f, \u0442\u044f\u0436\u0451\u043b\u044b\u043c\u0438 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438.\n\n9) \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u0438\u0448\u0435\u0447\u043d\u044b\u0445 \u0441\u0432\u0438\u0449\u0435\u0439.\n\n10) \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435\n\u2022 \u0414\u0438\u0435\u0442\u0430. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u0441\u0443\u0445\u043e\u044f\u0434\u0435\u043d\u0438\u0435 \u0438 \u0434\u0440\u043e\u0431\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435.\n\n\u2022 \u0420\u0435\u043d\u0442\u0435\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043f\u0430\u0441\u0441\u0430\u0436\u0430 \u0431\u0430\u0440\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 3 \u043c\u0435\u0441\u044f\u0446\u0430.\n\n13. \u041c\u0415\u0414\u0418\u0426\u0418\u041d\u0421\u041a\u0410\u042f \u0420\u0415\u0410\u0411\u0418\u041b\u0418\u0422\u0410\u0426\u0418\u042f: \u043d\u0435\u0442.\n\n14. \u041f\u0410\u041b\u041b\u0418\u0410\u0422\u0418\u0412\u041d\u0410\u042f \u041f\u041e\u041c\u041e\u0429\u042c: \u043d\u0435\u0442.\n\n15. \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0435:\n\n\u0410\u0414 \u2013 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\n\u0410\u041b\u0422 \u2013 \u0430\u043b\u0430\u043d\u0438\u043d\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\u0410\u0421\u0422 \u2013 \u0430\u0441\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438\u043d\u043e\u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0430\u0437\u0430\n\u0410\u0427\u0422\u0412 \u2013 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0435 \u0442\u0440\u043e\u043c\u0431\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043e\u0432\u043e\u0435\n\n\u0432\u0440\u0435\u043c\u044f\n\u0412\u0418\u0427 \u2013 \u0432\u0438\u0440\u0443\u0441 \u0438\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\n\u0416\u0415\u041b \u2013 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u0430\u044f \u0435\u043c\u043a\u043e\u0441\u0442\u044c \u043b\u0435\u0433\u043a\u0438\u0445\n\u0416\u041a\u0422 \u2013 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u044b\u0439 \u0442\u0440\u0430\u043a\u0442\n\n\u0418\u0412\u041b \u2013 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u044f \u043b\u0435\u0433\u043a\u0438\u0445\n\u0418\u0424\u0410 \u2013 \u0438\u043c\u043c\u0443\u043d\u043e\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437\n\u041a\u0422 \u2013 \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u043d\u0430\u044f \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f\n\u041c\u041d\u041e \u2013 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\n\n12\n\n\u041e\u0410\u041a \u2013 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438\n\n\u041e\u0410\u041c \u2013 \u043e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u043e\u0447\u0438\n\u0421\u041e\u042d \u2013 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043e\u0441\u0435\u0434\u0430\u043d\u0438\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u043e\u0432\n\u0423\u0417\u0418 \u2013 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0424\u0411\u0421 \u2013 \u0444\u0438\u0431\u0440\u043e\u0431\u0440\u043e\u043d\u0445\u043e\u0441\u043a\u043e\u043f\u0438\u044f\n\n\u0424\u042d\u0413\u0414\u0421 \u2013 \u0444\u0438\u0431\u0440\u043e\u044d\u0437\u043e\u0444\u0430\u0433\u043e\u0433\u0430\u0441\u0442\u0440\u043e\u0434\u0443\u043e\u0434\u0435\u043d\u043e\u0441\u043a\u043e\u043f\u0438\u044f\n\u042d\u041a\u0413 \u2013 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043a\u0430\u0440\u0434\u0438\u043e\u0433\u0440\u0430\u043c\u043c\u0430\n\u041a\u0429\u0421 \u2013 \u043a\u0438\u0441\u043b\u043e\u0442\u043d\u043e-\u0449\u0435\u043b\u043e\u0447\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\n\u041c\u041c\u0412 \u2013 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0438\u043d\u0443\u0442\u043d\u0430\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u044f\n\n\u041c\u041e\u0414 \u2013 \u041c\u0438\u043d\u0443\u0442\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043c \u0434\u044b\u0445\u0430\u043d\u0438\u044f\n\u041e\u0413\u041a \u2013 \u043e\u0440\u0433\u0430\u043d\u044b \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438\n\u0429\u0424 \u2013 \u0449\u0435\u043b\u043e\u0447\u043d\u0430\u044f \u0444\u043e\u0441\u0444\u0430\u0442\u0430\u0437\u0430\n\u0421\u041a\u0424 \u2013 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u043e\u0432\u043e\u0439 \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438\n\n16. \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0441 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u0434\u0430\u043d\u043d\u044b\u0445:\n1) \u0416\u0443\u0440\u0430\u0435\u0432 \u0428\u0430\u043a\u0438\u0440\u0431\u0430\u0439 \u0428\u0443\u043a\u0438\u0440\u043e\u0432\u0438\u0447 \u2013 \u0434.\u043c.\u043d., \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0410\u041e \u00ab\u041d\u041d\u0426\u0425 \u0438\u043c. \u0410.\u041d. \u0421\u044b\u0437\u0433\u0430\u043d\u043e\u0432\u0430\u00bb \u041c\u0417\u0421\u0420 \u0420\u041a.", "type": "Document"}}