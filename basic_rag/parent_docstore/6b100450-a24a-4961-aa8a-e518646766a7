d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u041c\u0435\u043a\u043a\u0435\u043b\u044f- \u0410\u0420\u0422 \u0410\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u0440\u0432\u043d\u043e\u0439\n\u0413\u0440\u0443\u0431\u0435\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043f\u043e\u043b\u0438\u0434\u0430\u043a\u0442\u0438\u043b\u0438\u044f,\n\u0444\u0438\u0431\u0440\u043e\u043a\u0438\u0441\u0442\u043e\u0437\u043d\u043e\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438\n\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0416\u0435\u043d\u0430 \u0410\u0420\u0422 \u0421\u0438\u043b\u044c\u043d\u043e \u0441\u0436\u0430\u0442\u0430\u044f \u0433\u0440\u0443\u0434\u043d\u0430\u044f \u043a\u043b\u0435\u0442\u043a\u0430 \u0441\n(\u0430\u0441\u0444\u0438\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e,\n\u0442\u043e\u0440\u0430\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u0441\u043a\u0435\u043b\u0435\u0442\u0430, \u043f\u043e\u043b\u0438\u0434\u0430\u043a\u0442\u0438\u043b\u0438\u044f,\n\u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f) \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0444\u0438\u0431\u0440\u043e\u0437 \u043f\u0435\u0447\u0435\u043d\u0438\n\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u0445 \u0410\u0414\u0422 (\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0421\u0430\u0445\u0430\u0440\u043d\u044b\u0439 \u0434\u0438\u0430\u0431\u0435\u0442 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e \u0437\u0440\u0435\u043b\u043e\u0433\u043e\n\u043a\u0438\u0441\u0442 \u0438 \u0434\u0438\u0430\u0431\u0435\u0442\u0430 \u0432\u0430\u0440\u0438\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430, \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432,\n\u0447\u0430\u0441\u0442\u043e \u0433\u0438\u043f\u0435\u0440\u0443\u0440\u0438\u043a\u0435\u043c\u0438\u044f, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u044b\u0435 \u043f\u0435\u0447\u0435\u043d\u0438\n\n\u043c\u0443\u0442\u0430\u0446\u0438\u0438)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 3. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\u0440\u0435\u0446\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u0438 \u0430\u0443\u0442\u043e\u0441\u043e\u043c\u043d\u043e-\u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u043e\u0433\u043e\n\u043f\u043e\u043b\u0438\u043a\u0438\u0441\u0442\u043e\u0437\u0430 \u043f\u043e\u0447\u0435\u043a [2,5]\n\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0410\u0420\u041f\u041a\u041f \u0410\u0414\u041f\u041a\u041f\n\u0427\u0430\u0441\u0442\u043e\u0442\u0430 1: 20 000 1: 400 \u2013 1000\n\u0413\u0438\u0441\u0442\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u041c\u0430\u0441\u0441\u0438\u0432\u043d\u043e, \u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u043e \u0412 \u0446\u0435\u043b\u043e\u043c \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0435, \u043d\u043e\n\u043f\u043e\u0447\u0435\u043a \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0447\u043a\u0438 \u043e\u0431\u044b\u0447\u043d\u043e \u0432 \u043c\u0435\u043d\u044c\u0448\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438\n\n(\u0431\u043e\u0431\u043e\u0432\u0438\u0434\u043d\u044b\u0435). \u043f\u043e\u0447\u043a\u0438.\n\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043a\u0438\u0441\u0442 \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0435 \u041a\u0438\u0441\u0442\u044b, \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0438\u0437 \u0432\u0441\u0435\u0445\n\u0441\u043e\u0431\u0438\u0440\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0442\u0440\u0443\u0431\u043e\u0447\u043a\u0438 \u0438 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u043d\u0435\u0444\u0440\u043e\u043d\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f\n\u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u043d\u0430\u043b\u044c\u0446\u044b. \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u0438.\n\n\u0423\u0417\u0418 \u0438 \u0434\u0438\u0430\u043c\u0435\u0442\u0440 \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0433\u0440\u0430\u043d\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u041a\u0438\u0441\u0442\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432 \u0432\n\u043a\u0438\u0441\u0442 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u00ab\u0441\u043e\u043b\u044c-\u043f\u0435\u0440\u0435\u0446\u00bb, \u043a\u043e\u0440\u043a\u043e\u0432\u043e\u043c \u0438 \u043c\u043e\u0437\u0433\u043e\u0432\u043e\u043c \u0441\u043b\u043e\u044f\u0445\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u044d\u0445\u043e\u0433\u0435\u043d\u043d\u043e\u0441\u0442\u044c (\u043e\u0431\u044b\u0447\u043d\u043e \u043c\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043a\u0438\u0441\u0442\n\u043a\u043e\u0440\u043a\u043e\u0432\u043e\u0433\u043e \u0438 \u043c\u043e\u0437\u0433\u043e\u0432\u043e\u0433\u043e \u0441\u043b\u043e\u0435\u0432 \u0443 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445).\n\n\u0438\u0437-\u0437\u0430 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0447\u0430\u0441\u0442\u043e \u0412 \u043d\u0430\u0447\u0430\u043b\u0435 \u043a\u0438\u0441\u0442\u044b \u043e\u0431\u044b\u0447\u043d\u043e\n\u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u0445 \u043a\u0438\u0441\u0442 (\u043e\u0431\u044b\u0447\u043d\u043e < 2 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435, \u043e\u0434\u043d\u0430\u043a\u043e \u043c\u043e\u0433\u0443\u0442\n\u043c\u043c); \u0441 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043e\u043c \u043a\u0438\u0441\u0442\u044b \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0442\u044c \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043c \u0432\n\u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u043e \u043c\u043d\u043e\u0433\u0438\u0445 \u0440\u0430\u043d\u043d\u0435\u043c \u0434\u0435\u0442\u0441\u0442\u0432\u0435.\n\u0441\u043c \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e \u0410\u0414\u041f\u041a\u041f.\n\n\u041f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438 \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u0430: \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u044f \u041a\u0438\u0441\u0442\u044b \u043f\u0435\u0447\u0435\u043d\u0438 \u0447\u0430\u0441\u0442\u043e \u0443\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043f\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u043e\u0439 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0440\u0435\u0434\u043a\u043e \u0443 \u0434\u0435\u0442\u0435\u0439.\n\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0438/\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0418\u043d\u043e\u0433\u0434\u0430 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f\n\u0444\u0438\u0431\u0440\u043e\u0437 \u043f\u0435\u0447\u0435\u043d\u0438 \u0441 \u043f\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u043e\u0439 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0438/\n\n\u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u0435\u0439 \u0436\u0435\u043b\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0444\u0438\u0431\u0440\u043e\u0437 \u043f\u0435\u0447\u0435\u043d\u0438.\n\u043f\u0440\u043e\u0442\u043e\u043a\u0430 \u0438 \u043f\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u044b\u043c\n\u0444\u0438\u0431\u0440\u043e\u0437\u043e\u043c (\u043a\u0430\u043a \u043f\u0440\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0438\n\u041a\u0430\u0440\u043e\u043b\u0438)\n\n\u0421\u043e\u043f\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0420\u0435\u0434\u043a\u043e \u043a\u0438\u0441\u0442\u044b \u0438/\u0438\u043b\u0438 \u0444\u0438\u0431\u0440\u043e\u0437 \u041a\u0438\u0441\u0442\u044b \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439\n\u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u043f\u043e\u0434\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b \u0436\u0435\u043b\u0435\u0437\u044b \u0438 \u0434\u0440\u0443\u0433\u0438\u0445\n\u044d\u043f\u0438\u0442\u0435\u043b\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432;\n\u0432\u043d\u0443\u0442\u0440\u0438\u0447\u0435\u0440\u0435\u043f\u043d\u044b\u0435 \u0430\u043d\u0435\u0432\u0440\u0438\u0437\u043c\u044b \u0443\n\n\u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 8 %\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u041f\u0435\u0440\u0438-/\u043d\u0435\u043e\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u041f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0430 3-5 \u0434\u0435\u043a\u0430\u0434\u0430\u0445 \u0432\n\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0435\u0440\u0438\u043e\u0434: \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u0432\u0438\u0434\u0435 \u0410\u0413, \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u0438,\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0438\u0441\u0442\u0440\u0435\u0441\u0441 \u0432 30-50%. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u0438 \u0438/\u0438\u043b\u0438 \u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439\n\n\u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u2013 \u043f\u043e\u0447\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438. \u0412\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e 2% - \u043d\u0430\u0447\u0430\u043b\u043e\n\u043f\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u044f \u0438 \u0432 \u0440\u0430\u043d\u043d\u0435\u043c \u0434\u0435\u0442\u0441\u0442\u0432\u0435.\n\u0434\u0440.\n\n\u0420\u0438\u0441\u043a \u0434\u043b\u044f \u0441\u0438\u0431\u0441\u043e\u0432 25% 50% (\u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c\n\u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u044b\u0445 \u043c\u0443\u0442\u0430\u0446\u0438\u0439)\n\u0420\u0438\u0441\u043a \u0434\u043b\u044f \u0434\u0435\u0442\u0435\u0439 < 1% (\u0435\u0441\u043b\u0438 \u0431\u0440\u0430\u043a 50% (\u0442\u0430\u043a\u0436\u0435 \u0434\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\u043e\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043d\u0435\u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u043d\u0435\u0442 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0439 \u043c\u0443\u0442\u0430\u0446\u0438\u0435\u0439)\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0432 \u0441\u0435\u043c\u044c\u044f\u0445\n\u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0445 \u0441\u0443\u043f\u0440\u0443\u0433\u043e\u0432)\n\u0411\u043e\u043b\u044c\u043d\u044b\u0435 \u0447\u043b\u0435\u043d\u044b \u0427\u0430\u0441\u0442\u043e \u043f\u043e\u0445\u043e\u0436\u0430\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0420\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u0447\u0430\u0441\u0442\u043e\n\n\u0441\u0435\u043c\u044c\u0438 \u043a\u0430\u0440\u0442\u0438\u043d\u0430 \u0443 \u0441\u0438\u0431\u0441\u043e\u0432 (\u0432 \u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u0432 \u0441\u0435\u043c\u044c\u0435. \u0412 \u0441\u043b\u0443\u0447\u0430\u0435\n\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e 20% \u0440\u0430\u043d\u043d\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0435\n\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0432\u043d\u0443\u0442\u0440\u0438\u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0435 \u0441\u0440\u043e\u043a\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432 50%.\n\u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438)\n\n\u0420\u043e\u0434\u0438\u0442\u0435\u043b\u0438 (\u043f\u043e\u0447\u043a\u0438) \u0411\u0435\u0437 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u041e\u0431\u044b\u0447\u043d\u043e \u043e\u0434\u0438\u043d \u0438\u0437 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u0439\n\u0441\u0442\u0430\u0440\u0448\u0435 30 \u043b\u0435\u0442 \u0438\u043c\u0435\u0435\u0442 \u043a\u0438\u0441\u0442\u044b \u0432\n\u043e\u0431\u0435\u0438\u0445 \u043f\u043e\u0447\u043a\u0430\u0445, \u043a\u0440\u043e\u043c\u0435 \u0441\u043b\u0443\u0447\u0430\u0435\u0432\n\u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u044b\u0445 \u043c\u0443\u0442\u0430\u0446\u0438\u0439\n\n\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u041d\u0435\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u0441 \u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0440\u0430\u043d\u043d\u0435\u0439\n\u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u043c \u0434\u0438\u0441\u0442\u0440\u0435\u0441\u0441- \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0430\u0446\u0438\u0438 \u0431\u043e\u043b\u0435\u0435\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u043e\u043c \u0432 \u043f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439, \u0447\u0435\u043c \u043f\u0440\u0438\n\u0441\u043b\u0443\u0447\u0430\u044f\u0445. \u0411\u043e\u043b\u0435\u0435 \u0410\u0420\u041f\u041a\u041f. \u0412\u043e \u00ab\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445\u00bb\n\n\u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u0443 \u0432\u044b\u0436\u0438\u0432\u0448\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u0442\u0425\u041f\u041d \u0443 50% \u0432\n\u043d\u043e\u0432\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 60 \u043b\u0435\u0442.\n\u0442\u0425\u041f\u041d \u0443 15% \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u0421\u0440\u0435\u0434\u043d\u0438\u0439 \u0432\u043e\u0437\u0440\u0430\u0441\u0442 \u0442\u0425\u041f\u041d 53 \u0438\n\u0427\u0430\u0441\u0442\u043e \u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f 69 \u043b\u0435\u0442 \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043c\u0443\u0442\u0430\u0446\u0438\u0438\n\n\u043f\u043e\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438 \u0433\u0435\u043d\u0430 PKD1 \u0438 \u0433\u0435\u043d\u0430 PKD2 -\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\n\n13. \u0426\u0435\u043b\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u0417\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0425\u0411\u041f (\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u043d\u0435\u043c\u0438\u0438, \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0410\u0414,\n\u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u0421\u041a\u0424).\n\n14. \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f***\n14.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 (\u0440\u0435\u0436\u0438\u043c, \u0434\u0438\u0435\u0442\u0430):\n\n\u2022 \u0414\u0438\u0435\u0442\u0430, \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443, \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0431\u0435\u043b\u043a\u0430 (1,5-2 \u0433/\u043a\u0433),\n\u043a\u0430\u043b\u043e\u0440\u0438\u0439.\n\u2022 \u0420\u0435\u0436\u0438\u043c \u043e\u0431\u0449\u0438\u0439.\n\n14.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0442\u0435\u043d\u0437\u0438\u0438:\n\n\u0438\u0410\u041f\u0424: \u044d\u043d\u0430\u043b\u0430\u043f\u0440\u0438\u043b 0,1-0,6\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u0444\u043e\u0437\u0438\u043d\u043e\u043f\u0440\u0438\u043b 5-10\u043c\u0433/\u0441\u0443\u0442. \u041d\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0410\u041f\u0424\n\u043f\u0440\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0438 \u0421\u041a\u0424 \u043c\u0435\u043d\u0435\u0435 30\u043c\u043b/\u043c\u0438\u043d/1,73\u043c2 [19,20].\n\u0411\u0420\u0410: \u0432\u0430\u043b\u0441\u0430\u0440\u0442\u0430\u043d 0,4-3\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 160\u043c\u0433/\u0441\u0443\u0442, \u043b\u043e\u0437\u0430\u0440\u0442\u0430\u043d 0,7-\n1,4\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e 100\u043c\u0433/\u0441\u0443\u0442 (D) [20].\n\u03b2-\u0431\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b: \u0430\u0442\u0435\u043d\u043e\u043b\u043e\u043b 1-2\u043c\u0433/\u043a\u0433, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 100\u043c\u0433/\u0441\u0443\u0442.\n\n\u0411\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b \u043a\u0430\u043b\u044c\u0446\u0438\u0435\u0432\u044b\u0445 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 (\u043d\u0438\u0444\u0435\u0434\u0438\u043f\u0438\u043d, \u0430\u043c\u043b\u043e\u0434\u0438\u043f\u0438\u043d) [21]. \u0410\u043c\u043b\u043e\u0434\u0438\u043f\u0438\u043d 0,1-\n0,2 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 0,6\u043c\u0433/\u043a\u0433 \u0438\u043b\u0438 20\u043c\u0433/\u0441\u0443\u0442. \u041d\u0438\u0444\u0435\u0434\u0438\u043f\u0438\u043d 0,5-2\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0432\n2-3 \u043f\u0440\u0438\u0435\u043c\u0430.\n\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u0411\u043b\u043e\u043a\u0430\u0442\u043e\u0440\u044b \u043f\u0440\u043e\u0442\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043f\u044b (\u043e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b 0,5-1,0\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442) \u043f\u0440\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0438\n\u0433\u0430\u0441\u0442\u0440\u043e\u0438\u043d\u0442\u0435\u0441\u0442\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u0438 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u0430\u043c\u0438;\n\u041a\u0430\u0440\u0431\u043e\u043d\u0430\u0442 \u043a\u0430\u043b\u044c\u0446\u0438\u044f (250-500\u043c\u0433/\u0441\u0443\u0442) \u0441 \u0446\u0435\u043b\u044c\u044e \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0438 \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437\u0430 [22];\n\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430 (\u0436\u0435\u043b\u0435\u0437\u0430 \u0441\u0443\u043b\u044c\u0444\u0430\u0442 \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0430\u043d\u0435\u043c\u0438\u0438 - \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0430\u043c \u0441 \u043c\u0430\u0441\u0441\u043e\u0439\n)\n\u0442\u0435\u043b\u0430 \u0441\u0432\u044b\u0448\u0435 50 \u043a\u0433: \u043f\u043e 1 \u043a\u0430\u043f\u0441\u0443\u043b\u0435. 1\u20132 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438, \u0434\u0435\u0442\u044f\u043c (\u0441 \u043c\u0430\u0441\u0441\u043e\u0439 \u0442\u0435\u043b\u0430 20\u201350 \u043a\u0433): \u043f\u043e\n1 \u043a\u0430\u043f\u0441\u0443\u043b\u0435 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438.\n\u0421\u0442\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u0433\u0435\u043c\u043e\u043f\u043e\u044d\u0437\u0430 (\u0440\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u044b\u0439 \u044d\u0440\u0438\u0442\u0440\u043e\u043f\u043e\u044d\u0442\u0438\u043d, 100-150 \u0435\u0434/\u043a\u0433/\u043d\u0435\u0434) \u2013\n\u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u0440\u0435\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043d\u0435\u043c\u0438\u0438, \u043d\u0435 \u043f\u043e\u0434\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044e \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 \u0436\u0435\u043b\u0435\u0437\u0430 \u0438\n\u043f\u0440\u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u0421\u041a\u0424 \u043c\u0435\u043d\u0435\u0435 60 \u043c\u043b/\u043c\u0438\u043d.\n\u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 \u043c\u043e\u0447\u0435\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b (\u0441\u043c. \u0442\u0430\u0431\u043b\u0438\u0446\u0443 4)\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 4 \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 \u043c\u043e\u0447\u0435\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b\n\u0410\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0438 \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 (\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442)", "type": "Document"}}