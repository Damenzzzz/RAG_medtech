c\u0442\u0430\u0442\n- \u0440\u043e\u0441\u0442 \u043a\u043e\u043b\u043e\u043d\u0438\u0439 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u0433\u0440\u0438\u0431\u043e\u0432 \u0415\u0441\u043b\u0438 \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u0421\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441\n\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c\u0438\n\u0431) \u041c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 1,2.\n\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438, \u043f\u043e\u0441\u043b\u0435\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\n\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435\u043c\u0438\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438. \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438.\n\u0414\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u044f 1 \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430: \u0418\u043c\u0435\u044e\u0442\u0441\u044f \u0432\u0441\u0435 \u0418\u043c\u0435\u044e\u0442\u0441\u044f\n\u043a\u0438\u0441\u0442\u0435\u0439 \u0438 \u0441\u0442\u043e\u043f \u2022 \u044d\u0440\u0438\u0442\u0435\u043c\u0430; \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435\n(\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u2022 \u043e\u0442\u0440\u0443\u0431\u0435\u0432\u0438\u0434\u043d\u043e\u0435 \u0438\u043b\u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435\n\u0433\u0440\u0438\u0431\u044b \u0440\u043e\u0434\u0430 \u043c\u0443\u043a\u043e\u0432\u0438\u0434\u043d\u043e\u0435 \u0448\u0435\u043b\u0443\u0448\u0435\u043d\u0438\u0435; \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\nTrichophyton \u2022 \u043c\u0430\u0446\u0435\u0440\u0430\u0446\u0438\u044f \u0440\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u0441\u043b\u043e\u044f; \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438\n(rubrum, \u2022 \u044d\u0440\u043e\u0437\u0438\u0438; \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b.\nmentagrophytes, \u2022 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u044b\u0435 \u0438\u043b\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\nvar. interdigitale). \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u0442\u0440\u0435\u0449\u0438\u043d\u044b; \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 No2, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u2022 \u043f\u0443\u0437\u044b\u0440\u044c\u043a\u0438 \u0438\u043b\u0438 \u043f\u0443\u0437\u044b\u0440\u0438. 3. \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 No2, 3.\n2 \u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u043d\u043e\u0433\u0442\u0435\u0439, \u0441\u043e\u0441\u043a\u043e\u0431\u0430 \u0447\u0435\u0448\u0443\u0435\u043a \u0441 \u0414\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\u043e\u0447\u0430\u0433\u043e\u0432 \u043d\u0430 \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u043a\u043e\u0436\u0435 - \u0432\u0438\u0434\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435\n\u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043d\u0438\u0442\u0435\u0439 \u043c\u0438\u0446\u0435\u043b\u0438\u044f, \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043d\u0435\n\n\u0441\u043f\u043e\u0440 \u0433\u0440\u0438\u0431\u043e\u0432. \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f, \u043c\u0435\u043d\u0435\u0435 3-\u0445 \u0440\u0430\u0437).\n\u0432\u044b\u0431\u043e\u0440\u0430 \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\n\u0430\u043d\u0442\u0438\u043c\u0438\u043a\u043e\u0442\u0438\u043a\u0430, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f No3.\n\u0441\u0442\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\n\u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\n\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f No3 \u0430)\n\u0438\u043b\u0438 \u0431).\n3 \u041a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n- \u0440\u043e\u0441\u0442 \u043a\u043e\u043b\u043e\u043d\u0438\u0439 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u0433\u0440\u0438\u0431\u043e\u0432 \u0415\u0441\u043b\u0438 \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u0421\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441\n\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c\u0438\n\u0431) \u041c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 1,2.\n\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438, \u043f\u043e\u0441\u043b\u0435\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\n\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435\u043c\u0438\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438. \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438.\n\n\u0414\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u044f 1 \u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u0430: \u0418\u043c\u0435\u044e\u0442\u0441\u044f \u0432\u0441\u0435 \u0418\u043c\u0435\u044e\u0442\u0441\u044f\n\u043d\u043e\u0433\u0442\u0435\u0432\u044b\u0445 1) \u0434\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 - \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435\n\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043e\u043a \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430 \u0442\u0435\u0440\u044f\u0435\u0442 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435\n(\u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0433\u0440\u0438\u0431\u044b \u0440\u043e\u0434\u0430 \u0431\u0435\u043b\u0435\u0441\u043e\u0439 \u0438\u043b\u0438 \u0436\u0435\u043b\u0442\u043e\u0439, \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438\nTrichophyton \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043d\u043e\u0433\u0442\u0435\u0432\u043e\u0439 \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b.\n(rubrum, \u0433\u0438\u043f\u0435\u0440\u043a\u0435\u0440\u0430\u0442\u043e\u0437; \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\nmentagrophytes, 2) \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u2013 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 No2, \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\nvar. interdigitale). \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e 3. \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 No2, 3.\n\u0434\u043e\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\n\u043d\u043e\u0433\u0442\u044f, \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u044f\u0442\u043d\u0430 \u0438\n\u043f\u043e\u043b\u043e\u0441\u043a\u0438, \u0431\u0435\u043b\u043e\u0433\u043e \u0437\u0430\u0442\u0435\u043c\n\u0436\u0435\u043b\u0442\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430, \u043d\u043e\u0433\u0442\u0435\u0432\u0430\u044f\n\u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f\n\u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u043e\u0439 \u0438 \u0440\u044b\u0445\u043b\u043e\u0439;\n3) \u043f\u0440\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0430 \u2013 \u0432\n\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043f\u043e\u043b\u0443\u043b\u0443\u043d\u0438\u044f\n\u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043f\u044f\u0442\u043d\u0430 \u0431\u0435\u043b\u043e\u0433\u043e\n\u0446\u0432\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e\n\u043f\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u044e\u0442\u0441\u044f \u043a \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u043c\u0443\n\u043a\u0440\u0430\u044e, \u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u043e\u043d\u0438\u0445\u043e\u043b\u0438\u0437\u0438\u0441;\n4) \u0442\u043e\u0442\u0430\u043b\u044c\u043d\u043e - \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u0444\u043e\u0440\u043c\u0430 - \u043d\u043e\u0433\u0442\u0435\u0432\u0430\u044f \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0430\n\u0436\u0435\u043b\u0442\u043e\u0432\u0430\u0442\u043e-\u0441\u0435\u0440\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430,\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043d\u0435\u0440\u043e\u0432\u043d\u0430\u044f,\n\u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0439 \u043f\u043e\u0434\u043d\u043e\u0433\u0442\u0435\u0432\u043e\u0439\n\u0433\u0438\u043f\u0435\u0440\u043a\u0435\u0440\u0430\u0442\u043e\u0437.\n2 \u041c\u0438\u043a\u0440\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u043d\u043e\u0433\u0442\u0435\u0439, \u0441\u043e\u0441\u043a\u043e\u0431\u0430 \u0447\u0435\u0448\u0443\u0435\u043a \u0441 \u0414\u043b\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438\n\u043e\u0447\u0430\u0433\u043e\u0432 \u043d\u0430 \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u043a\u043e\u0436\u0435 - \u0432\u0438\u0434\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435\n\n\u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043d\u0438\u0442\u0435\u0439 \u043c\u0438\u0446\u0435\u043b\u0438\u044f, \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 (\u043d\u0435\n\u0441\u043f\u043e\u0440 \u0433\u0440\u0438\u0431\u043e\u0432. \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f, \u043c\u0435\u043d\u0435\u0435 3-\u0445 \u0440\u0430\u0437).\n\u0432\u044b\u0431\u043e\u0440\u0430 \u041f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\n\u0430\u043d\u0442\u0438\u043c\u0438\u043a\u043e\u0442\u0438\u043a\u0430, \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 No3.\n\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0441\u0442\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\n\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 No3\n\u0430) \u0438\u043b\u0438 \u0431).\n3 \u041a\u0443\u043b\u044c\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\n- \u0440\u043e\u0441\u0442 \u043a\u043e\u043b\u043e\u043d\u0438\u0439 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439. \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\n\u0433\u0440\u0438\u0431\u043e\u0432 \u0415\u0441\u043b\u0438 \u0438\u043c\u0435\u044e\u0442\u0441\u044f \u0421\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441\n\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u043c\u0438\n\u0431) \u041c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 1,2.\n\u0431\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0442\u043e\u0434\u044b \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0438 \u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f. \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438, \u043f\u043e\u0441\u043b\u0435\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\n\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435\u043c\u0438\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438. \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438.\n\n2.2 \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0432\u0438\u0434\u0430 \u0432\u043e\u0437\u0431\u0443\u0434\u0438\u0442\u0435\u043b\u044f \u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\n\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0444\u0438\u0442\u0438\u0439 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0441 \u0448\u0438\u0440\u043e\u043a\u0438\u043c \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\n\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0439 \u043a\u043e\u0436\u043d\u043e\u0439 \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0440\u0443\u0431\u0440\u043e\u0444\u0438\u0442\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\n\u0441 \u043f\u0441\u043e\u0440\u0438\u0430\u0437\u043e\u043c, \u0441\u0435\u0431\u043e\u0440\u0435\u0439\u043d\u044b\u043c \u0434\u0435\u0440\u043c\u0430\u0442\u0438\u0442\u043e\u043c, \u044d\u043a\u0437\u0435\u043c\u043e\u0439, \u043a\u0440\u0430\u0441\u043d\u044b\u043c \u043f\u043b\u043e\u0441\u043a\u0438\u043c \u043b\u0438\u0448\u0430\u0435\u043c,\n\u0433\u0435\u0440\u043f\u0435\u0442\u0438\u0444\u043e\u0440\u043c\u043d\u044b\u043c \u0434\u0435\u0440\u043c\u0430\u0442\u0438\u0442\u043e\u043c \u0414\u044e\u0440\u0438\u043d\u0433\u0430, \u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u0432\u043e\u043b\u0447\u0430\u043d\u043a\u043e\u0439, \u043b\u0438\u043c\u0444\u043e\u043c\u043e\u0439 \u043a\u043e\u0436\u0438.\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u043f\u0430\u0445\u043e\u0432\u043e\u0439 \u044d\u043f\u0438\u0434\u0435\u0440\u043c\u043e\u0444\u0438\u0442\u0438\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442 \u0441 \u044d\u0440\u0438\u0442\u0440\u0430\u0437\u043c\u043e\u0439,\n\u0440\u0443\u0431\u0440\u043e\u043c\u0438\u043a\u043e\u0437\u043e\u043c, \u043f\u0441\u043e\u0440\u0438\u0430\u0437\u043e\u043c, \u043a\u0430\u043d\u0434\u0438\u0434\u043e\u0437\u043e\u043c.\n\u041c\u0438\u043a\u0440\u043e\u0441\u043f\u043e\u0440\u0438\u044e \u0438 \u0442\u0440\u0438\u0445\u043e\u0444\u0438\u0442\u0438\u044e \u0432/\u0447 \u0433\u043e\u043b\u043e\u0432\u044b \u0438 \u0433\u043b\u0430\u0434\u043a\u043e\u0439 \u043a\u043e\u0436\u0438 \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0442 \u043e\u0442\n\u0440\u043e\u0437\u043e\u0432\u043e\u0433\u043e \u043b\u0438\u0448\u0430\u044f \u0416\u0438\u0431\u0435\u0440\u0430, \u0441\u0435\u0431\u043e\u0440\u0435\u0438, \u043f\u0441\u043e\u0440\u0438\u0430\u0437\u0430.", "type": "Document"}}