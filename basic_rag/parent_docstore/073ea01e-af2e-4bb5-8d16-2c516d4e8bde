42\u0435\u0440\u0438\u0438 \u043e\u0446\u0435\u043d\u043a\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0431\u0430\u043b\u043b\u043e\u0432 \u043f\u043e \u0448\u043a\u0430\u043b\u0435 \u0448\u043a\u0430\u043b\u0430 NIHSS\n0 - \u0432 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0438, \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442.\n1 - \u0441\u043e\u043c\u043d\u043e\u043b\u0435\u043d\u0446\u0438\u044f, \u043d\u043e \u043c\u043e\u0436\u043d\u043e \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044c \u043f\u0440\u0438\n\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f - \u0443\u0440\u043e\u0432\u043d\u044f \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0438, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\n\u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u044b, \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u044b.\n(\u0435\u0441\u043b\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0435 2 - \u0441\u043e\u043f\u043e\u0440, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u0434\u043b\u044f\n\u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u0438, \u044f\u0437\u044b\u043a\u043e\u0432\u043e\u0433\u043e \u0431\u0430\u0440\u044c\u0435\u0440\u0430 - \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438\n\u0440\u0435\u0430\u043a\u0446\u0438\u0439) \u0437\u0430\u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u0430\u044f \u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u0430\u044f\n\u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0435\u0441\u0442\u0435\u0440\u0435\u043e\u0442\u0438\u043f\u043d\u044b\u0445\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439.\n3 - \u043a\u043e\u043c\u0430, \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0444\u043b\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u043c\u0438\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u0438\u043b\u0438 \u043d\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u043d\u0430 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0438\u0442\u0435\u043b\u0438.\n\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f - \u043e\u0442\u0432\u0435\u0442\u044b \u043d\u0430\n\u0432\u043e\u043f\u0440\u043e\u0441\u044b.\u0411\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u044f\u0442 \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u044b:\n0 - \u041f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b \u043d\u0430\n\"\u041a\u0430\u043a\u043e\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \u043c\u0435\u0441\u044f\u0446?\", \"\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0412\u0430\u043c \u043b\u0435\u0442?\"\n\u043e\u0431\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u0430. 1 -\n(\u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\n\u041f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u043e\u0434\u0438\u043d\n\u043f\u0440\u0438\u0447\u0438\u043d\u0435 \u0438\u043d\u0442\u0443\u0431\u0430\u0446\u0438\u0438 \u0438 \u0434\u0440. - \u0441\u0442\u0430\u0432\u0438\u0442\u044c\u0441\u044f 1 \u0431\u0430\u043b\u043b)\n\u0432\u043e\u043f\u0440\u043e\u0441. 2 - \u041d\u0435 \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u043d\u0430\n\u043e\u0431\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u0430.\n\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0431\u043e\u0434\u0440\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f - \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435\n\u043a\u043e\u043c\u0430\u043d\u0434 0 - \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u043e\u0431\u0435\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u043e\u0441\u044f\u0442 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0434\u0432\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 - \u043a\u043e\u043c\u0430\u043d\u0434\u044b. 1 - \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\n\u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0432\u0435\u043a\u0438, \u0441\u0436\u0430\u0442\u044c \u043d\u0435 \u043f\u0430\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u043e\u0434\u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0430.\n\u0440\u0443\u043a\u0443 \u0438\u043b\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0441\u0442\u043e\u043f\u043e\u0439 2 - \u043d\u0438 \u043e\u0434\u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u043d\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e.\n\u0414\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0433\u043b\u0430\u0437\u043d\u044b\u043c\u0438 \u044f\u0431\u043b\u043e\u043a\u0430\u043c\u0438 0 - \u043d\u043e\u0440\u043c\u0430.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u0440\u043e\u0441\u044f\u0442 \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u0442\u044c \u0437\u0430 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c 1 - \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447 \u0432\u0437\u043e\u0440\u0430.\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u043e\u043b\u043e\u0442\u043e\u0447\u043a\u0430. 2 - \u0442\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0433\u043b\u0430\u0437 \u0438\u043b\u0438 \u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447\n\u0432\u0437\u043e\u0440\u0430, \u043d\u0435 \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u0432\u0430\u0435\u043c\u044b\u0439 \u0432\u044b\u0437\u044b\u0432\u0430\u043d\u0438\u0435\u043c\n\u043e\u043a\u0443\u043b\u043e\u0446\u0435\u0444\u0430\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0444\u043b\u0435\u043a\u0441\u043e\u0432.\n\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u0435\u0439 \u0437\u0440\u0435\u043d\u0438\u044f\n0 - \u043d\u043e\u0440\u043c\u0430.\n\u041f\u0440\u043e\u0441\u0438\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043e\u043d \u0432\u0438\u0434\u0438\u0442 \u043f\u0430\u043b\u044c\u0446\u0435\u0432,\n1 - \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u0430\u044f\n\u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043b\u0435\u0434\u0438\u0442\u044c \u0437\u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u043c\n\u0433\u0435\u043c\u0438\u0430\u043d\u043e\u043f\u0441\u0438\u044f. 2 -\n\u043f\u0430\u043b\u044c\u0446\u0435\u0432\n\u043f\u043e\u043b\u043d\u0430\u044f\n\u0433\u0435\u043c\u0438\u0430\u043d\u043e\u043f\u0441\u0438\u044f.\n0 - \u043d\u043e\u0440\u043c\u0430.\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043b\u0438\u0446\u0435\u0432\u043e\u0433\u043e\n1 - \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447 (\u0430\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u044f).\n\u043d\u0435\u0440\u0432\u0430\n2 - \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447 - \u043f\u043e\u043b\u043d\u044b\u0439 \u0438\u043b\u0438 \u043f\u043e\u0447\u0442\u0438\n\u043f\u0440\u043e\u0441\u0438\u043c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0437\u0443\u0431\u044b, \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u0442\u044c\n\u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447 \u043d\u0438\u0436\u043d\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u043c\u044b\u0448\u0446.\n\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0431\u0440\u043e\u0432\u044f\u043c\u0438, \u0437\u0430\u0436\u043c\u0443\u0440\u0438\u0442\u044c\u0441\u044f\n3 - \u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447 (\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 \u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0439\n\u0438 \u043d\u0438\u0436\u043d\u0435\u0439", "type": "Document"}}