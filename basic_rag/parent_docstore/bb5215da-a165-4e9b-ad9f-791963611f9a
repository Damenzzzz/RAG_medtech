u0434\u043e\u0447\u043d\u044b\u0439 \u043d\u0435\u0439\u0442\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439\n\u0434\u0435\u0440\u043c\u0430\u0442\u043e\u0437) \u0416>\u041c\n\u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a \u0426\u041d\u0421: \u0422\u0440\u043e\u043c\u0431\u043e\u0437 \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0433\u043e \u0441\u0438\u043d\u0443\u0441\u0430, \u041f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0441 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0434 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u043c\n\u0438\u0435 \u0434\u0435\u043c\u0438\u0435\u043b\u0438\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430: \u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0430\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f, \u0438\u043d\u0441\u0443\u043b\u044c\u0442;\n\u041f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438\n\u0420\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0418\u043d\u0433\u0430\u043b\u044f\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b (\u0431\u0443\u0434\u0435\u0441\u043e\u043d\u0438\u0434 \u0438\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0431\u0435\u043a\u043b\u043e\u043c\u0435\u0442\u0430\u0437\u043e\u043d), \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0413\u041a\u0421, \u0430\u043d\u0442\u0438 \u0424\u041d\u041e\n\u0412\u0417\u041a \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b\n\u0423\u0440\u043e\u0433\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u044b \u041f\u043e\u0447\u0435\u0447\u043d\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c (2- \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f 15%);\n-\u043d\u0435\u0444\u0440\u043e\u043b\u0438\u0442\u0438\u0430\u0437 (\u043e\u043a\u0441\u0430\u043b\u0430\u0442\u043d\u044b\u0439,\n\u0443\u0440\u0430\u0442\u043d\u044b\u0439) (4-23%);\n-\u0422\u0443\u0431\u0443\u043b\u043e\u0438\u043d\u0442\u0435\u0440\u0441\u0442\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439-\n\u043d\u0435\u0444\u0440\u0438\u0442;\n-IgA \u043d\u0435\u0444\u0440\u043e\u043f\u0430\u0442\u0438\u044f\n- \u0438\u0434\u0438\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043d\u0430\u044f\n\u043c\u0430\u043a\u0440\u043e\u0433\u0435\u043c\u0430\u0442\u0443\u0440\u0438\u044f;\n-\u0410\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437: \u043c\u0443\u0436\u0441\u043a\u043e\u0439 \u043f\u043e\u043b \u0441\n\u043f\u0435\u0440\u0438\u0430\u043d\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c;\n-\u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u043f\u0440\u0438 \u0411\u041a\n\u041a\u043e\u0430\u0433\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u0438 \u0432\u0435\u043d\u043e\u0437\u043d\u044b\u0435 \u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u0438: \u041d\u0438\u0437\u043a\u0438\u0435 \u0434\u043e\u0437\u044b \u041d\u0424\u0413 \u0438\u043b\u0438 \u0444\u043e\u043d\u0434\u0430\u043f\u0430\u0440\u0438\u043d\u0443\u043a\u0441, \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442\u044b\n\u0442\u0440\u043e\u043c\u0431\u043e\u044d\u043c\u0431\u043e\u043b\u0438\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u0438 \u0432\u0435\u043d \u0438 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u0430 \u041a [\u0432\u0430\u0440\u0444\u0430\u0440\u0438\u043d, \u0438 \u043d\u043e\u0432\u044b\u0439 \u0430\u043d\u0442\u0430\u0433\u043e\u043d\u0438\u0441\u0442 \u043d\u0435-\n\u0422\u042d\u041b\u0410 \u0432\u0438\u0442\u0430\u043c\u0438\u043d \u041a: \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442\u044b:\n\u0434\u0430\u0431\u0438\u0433\u0430\u0442\u0440\u0430\u043d, \u0440\u0438\u0432\u0430\u0440\u043e\u043a\u0441\u0430\u0431\u0430\u043d, \u0430\u043f\u0438\u043a\u0441\u0430\u0431\u0430\u043d\n\u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u041f\u0421\u0425 \u0423\u0414\u0425\u041a\n\u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0416\u041a\u0422 \u041d\u0410\u0416\u0411\u041f \u0434\u043e 39-55% \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0438\u043d\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u041e\u0442\u043c\u0435\u043d\u0430 \u0433\u0435\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0447\u0435\u043d\u0438 \u0434\u043e 10-15%\n\u0442\u0440\u043e\u043c\u0431\u043e\u0437 \u0432\u043e\u0440\u043e\u0442\u043d\u043e\u0439 \u0432\u0435\u043d\u044b \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u041e\u0441\u0442\u0440\u044b\u0439 \u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442 \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442 \u041f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u043d\n\u0416\u041a\u0411 \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u0410\u043d\u0435\u043c\u0438\u044f \u0416\u0414\u0410 \u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430: \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435\n\u041212, \u0444\u043e\u043b\u0438\u0435\u0432\u043e \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043d\u0430\u044f \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u0413\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\u043c\n\u041b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0438\u043d\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u041a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0430\u043d\u0435\u043c\u0438\u0438\n\n\u041f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b \u0432 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u0444\u0430\u0437\u0443 \u0411\u041a, \u043f\u0440\u0438 \u0430\u043d\u0435\u043c\u0438\u0438\n\u043b\u0435\u0433\u043a\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438. \u041f\u0440\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430\u043c \u0441\n\u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0436\u0435\u043b\u0435\u0437\u0430, \u0443\u0440\u043e\u0432\u043d\u0435 \u041d\u0432<10\u0433/\u0434\u043b, \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u044d\u0440\u0438\u0442\u0440\u043e\u043f\u043e\u044d\u0442\u0438\u043d; \u0438 \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430 [1,2,7]. \u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\n\n\u0436\u0435\u043b\u0435\u0437\u043e-\u0441\u0430\u0445\u0430\u0440\u043e\u0437\u043d\u044b\u0435 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u044b \u0438 \u0436\u0435\u043b\u0435\u0437\u0430 \u043a\u0430\u0440\u0431\u043e\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u0442\u043e\u0437\u0430\u0442\u0430.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 13. \u0421\u0445\u0435\u043c\u0430 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438 \u0430\u043d\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\n\u0413\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d \u0433/\u0434\u043b \u0412\u0435\u0441 \u0442\u0435\u043b\u0430 <70 \u043a\u0433 \u0412\u0435\u0441 \u0442\u0435\u043b\u0430\u226570 \u043a\u0433\n10-12 (\u0436\u0435\u043d\u0449\u0438\u043d\u044b) 1000 \u043c\u0433 1500 \u043c\u0433\n10-13 (\u043c\u0443\u0436\u0447\u0438\u043d\u044b) 1500 \u043c\u0433 2000 \u043c\u0433\n7-10 1500 \u043c\u0433 2000 \u043c\u0433\n\n\u0423\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430 \u0430\u043d\u0435\u043c\u0438\u0438, \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0436\u0435\u043b\u0435\u0437\u0430 \u0432\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\n\n\u0434\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d\u0430 100 \u043c\u043a\u0433/\u043b. \u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435\n3 \u043c\u0435\u0441\u044f\u0446\u0430 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u0433\u043e\u0434\u0430 (\u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d, \u0444\u0435\u0440\u0440\u0438\u0442\u0438\u043d, \u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440\u0440\u0438\u043d \u0438 \u0421\u0420\u0411) [1,2,8]\n\u041f\u0440\u0438 \u0430\u043d\u0435\u043c\u0438\u0438, \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439 \u0441 \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u043e\u043c \u0436\u0435\u043b\u0435\u0437\u0430, \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a\u043e\u043c\u043e\u0440\u0431\u0438\u0434\u043d\u044b\u0445\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439 - \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u043c\u0430\u043b\u0438\u0433\u043d\u0438\u0437\u0430\u0446\u0438\u0439, \u043f\u043e\u0431\u043e\u0447\u043d\u044b\u0445 \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\n\n[1,2,8].\n\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043e\u043f\u043f\u043e\u0440\u0442\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 14 - \u041e\u043f\u043f\u043e\u0440\u0442\u0443\u043d\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438, \u0442\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\n\u0418\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f\n\u0412\u0418\u0427 (\u041dIV) \u0421\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u0421\u0435\u0440\u043e\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0435\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043a \u0418\u0421\n\u0412\u0413\u0421 (HCV) -HCV-Ab \u0418\u0421 \u043d\u0435 \u0443\u0445\u0443\u0434\u0448\u0430\u0435\u0442 \u0442\u0435\u0447\u0435\u043d\u0438\u044f\n-\u041f\u0440\u0438 (+) HCV-Ab \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u041f\u0426\u0420 \u043c\u043e\u043d\u043e\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0412\u0413\u0421\n(\u041d\u0421V-\u0420\u041d\u041a)\n\u0412\u0413\u0412, HBV- -HBsAg, anti-HBAbs, anti-HBcAb -\u0432\u0430\u043a\u0446\u0438\u043d\u0430\u0446\u0438\u044f [1,2]\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f -\u041f\u0440\u0438 (+) HBsAg \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u041f\u0426\u0420 (\u041dBV- -\u0434\u043e, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 12 \u043c\u0435\u0441\n\u0414\u041d\u041a) \u043f\u043e\u0441\u043b\u0435 \u0418\u0421-\u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0430\u043d\u0442\u0438\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0435\n-anti-HBAbs \u0430\u0433\u0435\u043d\u0442\u044b (\u043d\u0443\u043a\u043b\u0435\u043e\u0437\u0438\u0434\u044b/\u0430\u043d\u0430\u043b\u043e\u0433\u0438\n-HBsAg-\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043d\u0443\u043a\u043b\u0435\u043e\u0442\u0438\u0434\u043e\u0432)\n-\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f \u043e\u043a\u043a\u0443\u043b\u044c\u0442\u043d\u043e\u0433\u043e \u0412\u0413\u0412 \u0440\u0435\u0434\u043a\u043e \u043d\u0430 \u0418\u0421 -\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0432\u0438\u0440\u0435\u043c\u0438\u0438 (\u041dBV-\u0414\u041d\u041a)\n[1,2] \u043a\u0430\u0436\u0434\u044b\u0435 2-3 \u043c\u0435\u0441 [1,2]\n\u041c\u0438\u043a\u043e\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u044f -\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044f \u043b\u0430\u0442\u0435\u043d\u0442\u043d\u043e\u0433\u043e \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u043d\u0430 - \u0432 \u043c\u043e\u043c\u0435\u043d\u0442 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 - \u043f\u0435\u0440\u0435\u0434\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430: anti-TNF \u0442\u0435\u0440\u0430\u043f\u0438\u0438 [1,2]: \u0430\u043d\u0430\u043c\u043d\u0435\u0437, \u0440\u0435\u043d\u0442\u0433\u0435\u043d anti-TNF \u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439\n\u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438, \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0438\u043d\u043e\u0432\u044b\u0435 \u043a\u043e\u0436\u043d\u044b\u0435 - anti-TNF \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u043d\u0435 \u0440\u0430\u043d\u0435\u0435, \u0447\u0435\u043c \u0447\u0435\u0440\u0435\u0437\n\u0442\u0435\u0441\u0442\u044b \u0438 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0440\u043e\u043d-\u0433\u0430\u043c\u043c\u0430 \u0442\u0435\u0441\u0442\u044b 3 \u043c\u0435\u0441 \u043f\u043e\u0441\u043b\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f\n-\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043b\u0430\u0442\u0435\u043d\u0442\u043d\u043e\u0433\u043e \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430 \u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437\u0430\nC. difficile: \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043a\u0441\u0438\u043d\u043e\u0432 \u0410 \u0438 \u0412 -\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u0435\u043c \u0434\u0440.\u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u043e\u0432\n-\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0438 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0439 C.\ndifficile \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438: \u043c\u0435\u0442\u0440\u043e\u043d\u0438\u0434\u0430\u0437\u043e\u043b \u0438\n\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d\n-\u0432 \u0442\u044f\u0436\u0435\u043b\u044b\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u2013 \u0432\u0430\u043d\u043a\u043e\u043c\u0438\u0446\u0438\u043d\n\u0426\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e- -\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u043e\u0441\u0442\u0440\u043e\u0433\u043e \u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043e\u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u043e\u0433\u043e \u0433\u0430\u043d\u0446\u0438\u043a\u043b\u043e\u0432\u0438\u0440 5.0\u22127.5 \u043c\u0433/\u043a\u0433/12 \u0447\u0430\u0441\u043e\u0432 \u0432\n\u0432\u0438\u0440\u0443\u0441 \u043a\u043e\u043b\u0438\u0442\u0430 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c CMV IgM, \u0442\u0435\u0447\u0435\u043d\u0438\u0435 2-3 \u043d\u0435\u0434\u0435\u043b\u044c: \u043f\u0430\u0440\u0435\u043d\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e, \u043d\u0430\n\u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0442\u0438\u0442\u0440\u0430 IgG, \u0438\u043b\u0438 IgG-\u0430\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u044c. 3-5 \u0434\u0435\u043d\u044c \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043d\u0430 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0439\n-\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0441\u0435\u0440\u043e\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u0435\u043c\n\u041f\u0426\u0420 \u0431\u0438\u043e\u043f\u0441\u0438\u0439\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u0438 \u043a\u0440\u043e\u0432\u0438 [1,2].\n\u0412\u0438\u0440\u0443\u0441 \u043f\u0440\u043e\u0441\u0442\u043e\u0433\u043e -\u043f\u0440\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0435 \u043e\u0440\u043e\u0444\u0430\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043b\u0438 -\u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f\n\u0433\u0435\u0440\u043f\u0435\u0441\u0430 (\u0412\u041f\u0413) \u0433\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n-\u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u0412\u041f\u0413 - \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439\n\u043a\u043e\u043b\u0438\u0442, \u043f\u0440\u0438 \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u043c \u0442\u0435\u0447\u0435\u043d\u0438\u0438: \u0418\u0413\u0425 \u0438\u043b\u0438 -\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0418\u0421 \u0442\u0435\u0440\u0430\u043f\u0438\u044e, \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f\n\n\u041f\u0426\u0420 \u0431\u0438\u043e\u043f\u0441\u0438\u0439\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\u042d\u043f\u0448\u0442\u0435\u0439\u043d-\u0411\u0430\u0440\u0440 -\u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043d\u0430 \u042d\u0411\u0412 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 -\u0443 \u0441\u0435\u0440\u043e\u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u042d\u0411\u0412 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u0432\u0438\u0440\u0443\u0441 (\u042d\u0411\u0412) \u043f\u0435\u0440\u0435\u0434 \u0438\u043d\u0438\u0446\u0438\u0430\u0446\u0438\u0435\u0439 \u0418\u0421 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 [1,2]: IgM and anti-TNF \u043c\u043e\u043d\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u044f\nIgG \u043d\u0430 \u042d\u0411\u0412 \u043a\u0430\u043f\u0441\u0438\u0434\u043d\u044b\u0439 \u0430\u043d\u0442\u0438\u0433\u0435\u043d (VCA) \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u0435\u0435 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438 \u0441 \u0418\u0421\n-\u0442\u044f\u0436\u0435\u043b\u0430\u044f \u042d\u0411\u0412 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u044f \u043d\u0430 \u0444\u043e\u043d\u0435 \u0418\u0421\u0422 -\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u0438\u0440\u0443\u0441\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f, \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\n\u0418\u0421 \u0442\u0435\u0440\u0430\u043f\u0438\u044e [1,2]\n\n\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a \u0432\u0430\u043a\u0446\u0438\u043d\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0435 [2]:\n\u2022 \u0440\u0435\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u043d\u0442\u043d\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 HBV;\n\u2022 \u043f\u043e\u043b\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430\u044f \u0438\u043d\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043f\u043d\u0435\u0432\u043c\u043e\u043a\u043e\u043a\u043a\u043e\u0432\u0430\u044f \u0432\u0430\u043a\u0446\u0438\u043d\u0430;", "type": "Document"}}