440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u043e\u0431\u0438\u043b\u044c\u043d\u043e\n\n\u0434\u0435\u0441\u043a\u0432\u0430\u043c\u0430\u0446\u0438\u044f >5% \u043a\u0440\u043e\u0432\u044f\u043d\u0438\u0441\u0442\u044b\u0439 \u0441\u0442\u0443\u043b\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430 (\u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442\n\u043e\u0431\u044a\u0435\u043c\u0430 \u0441\u0442\u0443\u043b\u0430)\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430-25. \u041e\u0431\u0449\u0430\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0442\u044f\u0436\u0435\u0441\u0442\u0438 (\u043d\u0430\n\u043e\u0441\u043d\u043e\u0432\u0435 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0442\u044f\u0436\u0435\u043b\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432-\u043c\u0438\u0448\u0435\u043d\u0435\u0439) \u043e\u0441\u0442\u0440\u043e\u0439 \u0420\u0422\u041f\u0425\nGrade \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\n0 \u041d\u0435\u0442 \u0441\u0442\u0430\u0434\u0438\u0438 1\u20134 \u043b\u044e\u0431\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0430.\n\nI \u041a\u043e\u0436\u0430 \u0441\u0442\u0430\u0434\u0438\u0438 1\u20132 \u0431\u0435\u0437 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438, \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e \u0438\u043b\u0438 \u043d\u0438\u0436\u043d\u0435\u0433\u043e\n\u043e\u0442\u0434\u0435\u043b\u0430 \u0416\u041a\u0422.\nII \u0421\u044b\u043f\u044c \u0441\u0442\u0430\u0434\u0438\u0438 3 \u0438/\u0438\u043b\u0438 \u043f\u0435\u0447\u0435\u043d\u044c \u0441\u0442\u0430\u0434\u0438\u0438 1 \u0438/\u0438\u043b\u0438 \u0432\u0435\u0440\u0445\u043d\u0438\u0439 \u043e\u0442\u0434\u0435\u043b \