0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0420\u0422\u041f\u0425\n(\u0431\u0430\u043b\u043b\u044b \u043e\u0442 0 \u0434\u043e 3)\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c/ \u0411\u0430\u043b\u043b\u044b \u0421\u0438\u043c\u043f\u0442\u043e\u043c/ \u0411\u0430\u043b\u043b\u044b \u0421\u0438\u043c\u043f\u0442\u043e\u043c/ \u0411\u0430\u043b\u043b\u044b\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435\n\u0410\u0441\u0446\u0438\u0442 (\u0441\u0435\u0440\u043e\u0437\u0438\u0442) Myasthenia\ngravis \u042d\u043e\u0437\u0438\u043d\u043e\u0444\u0438\u043b\u0438\u044f\n\u0431\u043e\u043b\u0435\u0435 500\n\u043a\u043b/\u043c\u043a\u043b\n\u041f\u0435\u0440\u0438\u043a\u0430\u0440\u0434\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\n\u0432\u044b\u043f\u043e\u0442 \u043a\u0430\u044f \u0422\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\n\u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0430\u0442\u0438\u044f \u043d\u0438\u044f \u043c\u0435\u043d\u0435\u0435 100\n\u0442\u044b\u0441/\u043c\u043a\u043b\n\u041f\u043b\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u044b\u043f\u043e\u0442 \u041f\u043e\u043b\u0438\u043c\u0438\u043e\u0437\u0438\u0442 \u0414\u0440\u0443\u0433\u0438\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u041d\u0435\u0444\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041f\u043e\u0442\u0435\u0440\u044f\n\u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0431\u043e\u043b\u0435\u0435 5% \u0432\u0435\u0441\u0430\n\u0431\u0435\u0437 \u0416\u041a\u0422\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n86\n\n\u041e\u0431\u0449\u0430\u044f \u0442\u044f\u0436\u0435\u0441\u0442\u044c \u043d\u0435\u0442 \u0420\u0422\u041f\u0425 \u041b\u0435\u0433\u043a\u0430\u044f \u0420\u0422\u041f\u0425 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0420\u0422\u041f\u0425\n\u0420\u0422\u041f\u0425\n(\u043c\u043d\u0435\u043d\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f)\n\u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043e\u0431\u044a\u0435\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 (PhotographicRangeofMotion (P-\nROM)\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0420\u0422\u041f\u0425, \u043e\u0431\u0449\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u0441\u0442\u0438 (NIH Consensus Conference, 2014)\n\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u0442\u044f\u0436\u0435\u0441\u0442\u0438 \u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0411\u0430\u043b\u043b\u044b \u0412\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043b\u0435\u0433\u043a\u0438\u0445,\n\u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0431\u0430\u043b\u043b\u044b\n\u041b\u0435\u0433\u043a\u0430\u044f (mild) 1 \u0438\u043b\u0438 2 \u041d\u0435 \u0431\u043e\u043b\u0435\u0435 1 0\n\u0423\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f (moderate) 3 \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u041d\u0435 \u043c\u0435\u043d\u0435\u0435 1 0\n\u041f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 1 2 0\n0 0 1\n\u0422\u044f\u0436\u0435\u043b\u0430\u044f (severe) \u041f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 1 3\n2 \u0438\u043b\u0438 3\n\n\u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0420\u0422\u041f\u0425 (NIH Consensus Conference, 2014)\n\u041e\u0440\u0433\u0430\u043d \u0438\u043b\u0438 \u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u041d\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041e\u0431\u0449\u0438\u0435 \u0441 \u043e\u0441\u0442\u0440\u043e\u0439\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0420\u0422\u041f\u0425\n\u041a\u043e\u0436\u0430 \u041f\u043e\u0439\u043a\u0438\u043b\u043e\u0434\u0435\u0440\u043c\u0430 \u0414\u0435\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u041f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u042d\u0440\u0438\u0442\u0435\u043c\u0430\n\u041b\u0438\u0445\u0435\u043d\u043e\u0438\u0434\u043d\u044b\u0435 \u041f\u0430\u043f\u043f\u0443\u043b\u043e\u0441\u043a\u0432\u0430\u043c\u043e\u0437\u043d\u044b\u0435 \u0418\u0445\u0442\u0438\u043e\u0437 \u041c\u0430\u043a\u0443\u043b\u043e\u043f\u0430\u043f\u0443\u043b\u043b\u0435\u0437\u043d\u0430\u044f\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043e\u0447\u0430\u0433\u0438 \u0424\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0439 \u043a\u0435\u0440\u0430\u0442\u043e\u0437 \u0441\u044b\u043f\u044c\n\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0413\u0438\u043f\u043e\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u0417\u0443\u0434\n\u0441\u043a\u043b\u0435\u0440\u043e\u0434\u0435\u0440\u043c\u0430 \u0413\u0438\u043f\u0435\u0440\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f\n\u0421\u043a\u043b\u0435\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043b\u0438\u0445\u0435\u043d\n\u041d\u043e\u0433\u0442\u0438 \u0414\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f\n\u041f\u0440\u043e\u0434\u043e\u043b\u044c\u043d\u0430\u044f\n\u0438\u0441\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c\n\u041f\u0440\u043e\u0434\u043e\u043b\u044c\u043d\u0430\u044f\n\u0438\u0441\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c,\n\u0441\u043b\u043e\u0438\u0441\u0442\u043e\u0441\u0442\u044c,\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f\n\u043b\u043e\u043c\u043a\u043e\u0441\u0442\u044c,\n87", "type": "Document"}}