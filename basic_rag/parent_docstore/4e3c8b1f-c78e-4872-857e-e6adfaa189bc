 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438: \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438: \u2022 \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439:\n\u043e\u0441\u0442\u0435\u043e\u0433\u0435\u043d\u0435\u0437 (\u041a\u0414\u041e) \u0438 \u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u2022 \u0430\u043b\u043b\u0435\u0440\u0433\u0438 \u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0430 \u0432 \uf0fc \u0441\u0442\u0440\u043e\u0433\u043e\n\u0427\u0427\u041b\u041e: \u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u043d\u0430 \u043c\u0435\u0442\u0430\u043b\u043b; \u043d\u0438\u0435 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e- \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f\n\u043a\u043e\u0441\u0442\u0435\u0439 \u043b\u0438\u0446\u0435\u0432\u043e\u0433\u043e\n\u0441\u043a\u0435\u043b\u0435\u0442 [22,70,71,76] \u2022 \u043d\u0438\u0436\u043d\u0435\u0439 \u2022 \u043e\u0441\u0442\u0435\u043e\u043f\u043e \u043d\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043f\u0443\u0447\u043a\u0430 \u2013 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u0440\u0435\u0436\u0438\u043c\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u0430\u044f\n\u0447\u0435\u043b\u044e\u0441\u0442\u0438: \u0440\u043e\u0437; \u043e\u0441\u0442\u0435\u043e\u0442\u043e\u043c\u0438\u044f \u0434\u0435\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438. \u0434\u0438\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u044b\u0445\n\uf0fc \u043d\u0435\u0434\u043e\u0440 \u2022 \u0432\u044b\u0440\u0430\u0436\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0441\u0442\u0440\u043e\u0433\u043e \u0441 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u043e\u0432, \u043f\u043e\u0434\n\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432\u0435\u0442\u0432\u0438 \u0438/\u0438\u043b\u0438 \u043d\u043d\u044b\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0441\u0438\u0445\u0438\u043a\u0438. \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0423\u0417\u0418\n\u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043e\u0447\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430, \u0442\u0435\u043b\u0430 \u2022 \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0433\u043e \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0430 (\u043e\u0442 0.5 \u0434\u043e 2.0\n\u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438, \u043f\u044c\u0435\u0437\u043e-\u0441\u043a\u0430\u043b\u044c\u043f\u0435\u043b\u044f. \u043c\u043c \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438\n\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u043e\u0442 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430, \u0437\u043e\u043d\u044b\n\u0434\u0438\u0437\u043e\u043a\u043a\u043b\u044e\u0437\u0438\u0435\u0439; \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430 \u0438\n\uf0fc \u0434\u0435\u0444\u0435\u043a \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445);\n\u0442 \u0442\u0435\u043b\u0430 \u0438\u043b\u0438 \u0432\u0435\u0442\u0432\u0438 \u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438; \uf0fc \u043e\u0431\u0435\u0441\u043f\u0435\n\uf0fc \u0441\u0438\u043d\u0434\u0440 \u0447\u0435\u043d\u0438\u0435 \u0436\u0451\u0441\u0442\u043a\u043e\u0439 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0438\n\u043e\u043c \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438, \u043a\u0430\u043a \u043a\u043e\u0441\u0442\u043d\u044b\u0445 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u043e\u0432 \u0432\u043e\n\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432\n\u043d\u0435\u0434\u043e\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043d\u0438\u0436\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438; \u0434\u0438\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438 \u0438 \u0440\u0435\u0442\u0435\u043d\u0446\u0438\u0438,\n\uf0fc \u0441\u043e\u0447\u0435\u0442 \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0438\u0437\n\u0430\u043d\u043d\u043e\u0435 \u043d\u0435\u0434\u043e\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043d\u0438\u0436\u043d\u0435\u0439 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439\n\u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0435\u0439; \u0441\u043e\u0437\u0440\u0435\u0432\u0430\u043d\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e\n\u2022 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0440\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0430;\n\u0447\u0435\u043b\u044e\u0441\u0442\u0438:\n\uf0fc \u0432\u0435\u0440\u0445\u043d \u2022 \u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442 \u0438\u043b\u0438 \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u044f\u044f \u0440\u0435\u0442\u0440\u043e\u043c\u0438\u043a\u0440\u043e\u0433\u043d\u0430\u0442\u0438\u044f; \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u043c\u044f\u0433\u043a\u0438\u0445 \u0442\u043a\u0430\u043d\u0435\u0439 \u0432 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439:\n\uf0fc \u0434\u0435\u0444\u043e\u0440 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430, \u0433\u0430\u0439\u043c\u043e\u0440\u0438\u0442 \uf0fc \u0441\u043e\u0431\u043b\u044e\n\u043c\u0430\u0446\u0438\u044f \u043b\u0438\u0446\u0430 \u0432\u043e \u0444\u0440\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u0438\u043b \u0430\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u0438\n\u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u0438; \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438,\n\u2022 \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u0437\u043e\u043d\u044b \u0430\u043d\u0442\u0438\u0431\u0430\u043a\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f\n\u043b\u0438\u0446\u0430: \u0442\u0435\u0440\u0430\u043f\u0438\u044f.\n\uf0fc\u044d\u043a\u0437\u043e\u0444\u0442\u0430\u043b\u044c\u043c, \uf0fc \u0441\u043e\u0431\u043b\u044e\n\u043a\u0430\u043a \u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0434\u043e\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0434\u0435\u043d\u0438\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u0430 \u043f\u043e\u043b\u043e\u0441\u0442\u0438\n\u0441\u043a\u0443\u043b\u043e\u0430\u043b\u044c\u0432\u0435\u043e\u043b\u044f\u0440\u043d\u043e\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0442\u0430, \u0443\u0445\u043e\u0434 \u0437\u0430\n\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0430. \u0434\u0438\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\n\u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043e\u043c \u0432\u043e\u0432\u0440\u0435\u043c\u044f\n\u0434\u0438\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438 \u0438 \u0440\u0435\u0442\u0435\u043d\u0446\u0438\u0438;\n\u2022 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u044d\u0441\u0442\u0435\u0442\u0438\u043a\u0438 \u043b\u0438\u0446\u0430 \u0438\u043b\u0438 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439:\n\u043d\u0435\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \uf0fc \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439\n\u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434 \u043d\u0430 \u044d\u0442\u0430\u043f\u0435 3D\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0434\u043e\u043b\u0436\u043d\u043e\u043c\u0443 \u0432 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438\n\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\n\u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0434\u0438\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u0438 \u2013 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435\u043c\n\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0435\u043a\u0442\u043e\u0440\u0430\n\u0434\u0435\u0441\u0442\u0440\u0430\u0446\u0438\u0438\n\n\uf0fc \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f\n\u043a\u043e\u0440\u0440\u0438\u0433\u0438\u0440\u0443\u044e\u0449\u0430\u044f\n\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f.\n\u2022 \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430\n\u0438\u043d\u0442\u0440\u0430\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439:\n\u2022 \u0436\u0435\u0441\u0442\u043a\u0430\n\u044f \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u043a\u043e\u0441\u0442\u043d\u044b\u0445\n\u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u043e\u0432 \u043f\u043e\u0441\u043b\u0435\n\u043e\u0441\u0442\u0435\u043e\u0442\u043e\u043c\u0438\u0438, \u0447\u0442\u043e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\n\u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u043e\u0439\n\u043f\u043e\u0441\u043b\u0435\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0439;\nII. \u0423\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u2022\u041c\u0435\u0441\u0442\u043d\u043e- \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0434\u043b\u044f \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u2013 \u041e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430:\n\u0432\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043f\u043e \u043c\u0435\u0441\u0442\u043d\u044b\u0435: \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u043e\u0433\u043e\n\u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432 \u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438; \u0440\u0430\u0437\u043c\u0435\u0440\u0443 \u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432 \u0438\u043b\u0438 \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0438\u043e\u0434\u0435\u0440\u043c\u0438\u0438, \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0430\u043d\u0430\u0441\u0442\u043e\u043c\u043e\u0437\u0430: \u2022\u0421\u0442\u0440\u043e\u0433\u043e\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\n\u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e- \u0434\u0435\u0440\u043c\u0430\u0442\u0438\u0442\u043e\u0432, \u044d\u043a\u0437\u0435\u043c\u044b, \u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u2022\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0442\u0440\u043e\u043c\u0431\u043e\u0437\u0430 \u0432 \u043f\u0440\u0430\u0432\u0438\u043b \u0430\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u0438\n\u043c\u044f\u0433\u043a\u0438\u0445 \u0442\u043a\u0430\u043d\u0435\u0439 \u043b\u0438\u0446\u0435\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0448\u0435\u0438 \u0441\u0442\u043e\u043c\u0430\u0442\u0438\u0442\u043e\u0432; \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0437\u043e\u043d\u0435 \u0430\u043d\u0430\u0441\u0442\u043e\u043c\u043e\u0437\u0430 \u0430\u043d\u0442\u0438\u0441\u0435\u043f\u0442\u0438\u043a\u0438 \u043d\u0430 \u0432\u0441\u0435\u0445\n\u0433\u043e\u043b\u043e\u0432\u044b \u0438 \u043b\u0438\u0446\u0430 [] \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0442\u043a\u0430\u043d\u0438, \u041e\u0441\u0442\u0440\u044b\u0435 \u0438\u043b\u0438 \u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u0438. \u2022\u0437\u0430\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u0430\u044f \u044d\u0442\u0430\u043f\u0430\u0445\n\u043f\u0440\u0438\u043b\u0435\u0436\u0430\u0449\u0438\u0435 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435 \u041f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u0430\u043f\u0438\u043b\u043b\u044f\u0440\u043d\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u043a \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0434\u0435\u0444\u0435\u043a\u0442\u0430 \u0438\u043b\u0438 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u043d\u043e\u0439\u043d\u043e- \u0441\u043e\u0441\u0443\u0434\u043e\u0432 \u0438 \u043d\u0435\u0440\u0432\u043e\u0432\u2013 \u0442\u043a\u0430\u043d\u0435\u0439 \u043f\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u043c\u043e\u0433\u043e \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430;\n\u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438. \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043b\u043e\u0441\u043a\u0443\u0442\u0430 \u2022\u0410\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0435\n\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432 \u0447\u0435\u043b\u044e\u0441\u0442\u043d\u043e- \u0443\u043b\u044c\u0442\u0440\u0430\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u2022\u043d\u0435\u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0442\u043e\u043a\u0430 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u043d\u0438\u0435 \u0442\u043a\u0430\u043d\u0435\u0439\n\u2022\u041f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043b\u0438\u0446\u0435\u0432\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438; \u043f\u044c\u0435\u0437\u043e-\u0441\u043a\u0430\u043b\u044c\u043f\u0435\u043b\u044f; \u0438 \u043e\u0442\u0442\u043e\u043a\u0430 \u043a\u0440\u043e\u0432\u0438 \u043a \u043b\u043e\u0441\u043a\u0443\u0442\u0443 \u0432 \u0437\u043e\u043d\u0435\n\u043b\u043e\u0441\u043a\u0443\u0442\u0430\u043c\u0438 \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u043e\u0431\u0448\u0438\u0440\u043d\u044b\u0445 \u0438 \u0420\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0435 \u2022\u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435, \u043d\u0430\u0433\u043d\u043e\u0435\u043d\u0438\u0435, \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e\n\u043f\u0438\u0442\u0430\u044e\u0449\u0438\u0445 \u043d\u043e\u0436\u043a\u0430\u0445; \u043e\u0431\u044a\u0435\u043c\u043d\u044b\u0445 \u0434\u0435\u0444\u0435\u043a\u0442\u043e\u0432 \u0438 \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u0438\u0442\u044b; \u043e\u0442\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435. \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430;\n\u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0439 \u0427\u0427\u041b\u041e, \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c \u0420\u0438\u043d\u0438\u0442\u044b, \u043b\u0430\u0440\u0438\u043d\u0433\u0438\u0442\u044b, \u2022\u0422\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0433\u0435\u043c\u043e\u0441\u0442\u0430\u0437\n\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0435\u0441\u0442\u043d\u044b\u043c\u0438 \u0442\u043a\u0430\u043d\u044f\u043c\u0438 \u043d\u0435 \u0442\u043e\u043d\u0437\u0438\u043b\u043b\u0438\u0442\u044b \u0438 \u0434\u0440. \u0432\u0445\u043e\u0434\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\n\u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c, \u0430 \u0432\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u043c\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0439 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u043f\u043e \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435\u043c\n\u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0438 \u0442\u043a\u0430\u043d\u0435\u0439 \u2013 \u0441\u043e\u0441\u0435\u0434\u0441\u0442\u0432\u0443 \u0441 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u0445\n\u043d\u0435\u0446\u0435\u043b\u0435\u0441\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c. \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f \u0432 \u043a\u0440\u043e\u0432\u043e\u043f\u043e\u0442\u0435\u0440\u044c \u0432\n\u043e\u0441\u0442\u0440\u043e\u0439 \u0444\u0430\u0437\u0435. \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0435 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430;\n\u2022\u0421\u0432\u043e\u0431\u043e\u0434\u043d\u0430\u044f \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u0449\u0438\u0435: \u2022\u0411\u0435\u0440\u0435\u0436\u043d\u043e\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435\n\u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u043d\u0435\u0437\u0430\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u041e\u0441\u0442\u0440\u044b\u0435 \u0438\u043b\u0438 \u043a \u0441\u0448\u0438\u0432\u0430\u0435\u043c\u044b\u043c,\n\u0438 \u043c\u0435\u043b\u043a\u0438\u043c\u0438 \u0433\u0440\u0430\u043d\u0443\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0440\u0430\u043d\u044b \u0438 \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0435\u043c\u044b\u043c,\n\u043b\u043e\u0441\u043a\u0443\u0442\u0430\u043c\u0438 \u043a\u043e\u0436\u0438; \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u0435\u0444\u0435\u043a\u0442\u044b, \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u043c\n\u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0449\u0438\u0435\u0441\u044f \u043f\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0442\u043a\u0430\u043d\u044f\u043c, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043a\n\u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u0441\u0435\u0447\u0435\u043d\u0438\u044f \u0440\u0443\u0431\u0446\u043e\u0432, \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439; \u0442\u043a\u0430\u043d\u044f\u043c\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0420\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0449\u0435\u0433\u043e\n\u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0439 \u043f\u043e\u043a\u0440\u043e\u0432, \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u043e\u0433\u043e \u043b\u043e\u0436\u0430;\n\u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0439 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0435 \u0442\u0440\u0430\u043a\u0442\u0430; \u2022\u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0442\u0435\u0445\u043d\u0438\u043a\u0443\n\u0441\u043c\u043e\u0440\u0449\u0438\u0432\u0430\u043d\u0438\u0435 \u0421\u0443\u0431\u0444\u0438\u0431\u0440\u0438\u043b\u0438\u0442\u0435\u0442; \u043d\u0430\u043b\u043e\u0436\u0435\u043d\u0438\u044f\n\u041e\u0431\u0449\u0435\u0435 \u043d\u0435\u0434\u043e\u043c\u043e\u0433\u0430\u043d\u0438\u0435;", "type": "Document"}}