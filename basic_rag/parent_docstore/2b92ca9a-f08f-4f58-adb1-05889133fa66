u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u0442\u044c \u0432 \u2265 1 \u0434\u0435\u0446\u0438\u043b\u0438\u0442\u0440\u0435\n\u0432\u043e\u0434\u044b/\u0441\u043e\u043a\u0430 (\u0430\u043f\u0435\u043b\u044c\u0441\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0438\u043b\u0438\n\u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u043e\u0433\u043e), \u0433\u043e\u0440\u044c\u043a\u0438\u0439 \u0432\u043a\u0443\u0441\nZDV \u043a\u0430\u043f\u0441\u0443\u043b\u044b (250 \u043c\u0433) \u043d\u0435\u0442 \u043d\u0435\u0442 \u0412\u044f\u0436\u0443\u0449\u0438\u0439, \u0433\u043e\u0440\u044c\u043a\u0438\u0439 \u0432\u043a\u0443\u0441\n\u0441\u0438\u0440\u043e\u043f (10 \u043c\u0433/\u043c\u043b) \u041b\u0443\u0447\u0448\u0435: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0438\u0440\u043e\u043f \u0438\u043b\u0438 \u0432\u0432\u043e\u0434\u0438\u0442\u044c\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e \u043f\u043e 6 \u043c\u0433/\u043a\u0433 \u0432 \u0434\u0435\u043d\u044c \u0432 5%-\u043c\n\u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435 \u0433\u043b\u044e\u043a\u043e\u0437\u044b\nTAF/FTC \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (25/200 \u043c\u0433 \u043d\u0435\u0442 \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u043e\u0433\u043b\u043e\u0442\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0443\n\u0438 10/200 \u043c\u0433)(v) \u0446\u0435\u043b\u0438\u043a\u043e\u043c. \u0422\u0430\u0431\u043b\u0435\u0442\u043a\u0443 \u043d\u0435 \u0441\u043b\u0435\u0434\u0443\u0435\u0442\n\u0440\u0430\u0437\u0436\u0435\u0432\u044b\u0432\u0430\u0442\u044c, \u0440\u0430\u0437\u043b\u0430\u043c\u044b\u0432\u0430\u0442\u044c, \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044c \u0438\u043b\u0438\n\u0438\u0437\u043c\u0435\u043b\u044c\u0447\u0430\u0442\u044c\nTDF/FTC \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0434\u0430 \u041b\u0443\u0447\u0448\u0435: \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u0442\u044c \u0432 \u2265 1 \u0434\u0435\u0446\u0438\u043b\u0438\u0442\u0440\u0435\n(300(i)/200 \u043c\u0433) \u0432\u043e\u0434\u044b/\u0441\u043e\u043a\u0430 (\u0430\u043f\u0435\u043b\u044c\u0441\u0438\u043d\u043e\u0432\u043e\u0433\u043e \u0438\u043b\u0438\n\u0432\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u043e\u0433\u043e), \u0433\u043e\u0440\u044c\u043a\u0438\u0439 \u0432\u043a\u0443\u0441\nABC/3TC \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (600/300 \u043d\u0435\u0442 \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n\u043c\u0433) \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432\nZDV/3TC \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (300/150 \u0434\u0430 \u0420\u0430\u0437\u0431\u043e\u043b\u0442\u0430\u0442\u044c \u0432 \u0432\u043e\u0434\u0435 (\u2265 15 \u043c\u043b); \u0434\u0440\u0443\u0433\u043e\u0439\n\u043c\u0433) \u0432\u0430\u0440\u0438\u0430\u043d\u0442: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n\u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432\n\nABC/3TC/ZDV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u043d\u0435\u0442 \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445\n(300/150/300 \u043c\u0433) \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432\n\u041d\u041d\u0418\u041e\u0422\nEFV \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 (600 \u043c\u0433) \u0434\u0430 \u0422\u0440\u0443\u0434\u043d\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u044f\u0435\u0442\u0441\u044f; \u0440\u0430\u0441\u0442\u0432\u043e\u0440 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442\n\u043a\u0430\u043f\u0441