043d\u0444\u0435\u043a\u0446\u0438\u0438. \u041d\u0430\u043b\u0438\u0447\u0438\u0435\n\u0430\u043d\u0442\u0438\u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0445\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\n\n10\n\nIII. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415:\n\n\u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f \u0440\u0438\u0441\u043a\u0430 \u0440\u0435\u0437\u0443\u0441 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445.\n\u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0441 \u0440\u0435\u0437\u0443\u0441-\u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\n\u043a\u0440\u043e\u0432\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0433\u0440\u0443\u043f\u043f\u044b \u0440\u0438\u0441\u043a\u0430:\nI \u0433\u0440\u0443\u043f\u043f\u0430 \u0440\u0438\u0441\u043a\u0430: \u0411\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0441 \u0440\u0435\u0437\u0443\u0441 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u044c\u044e\n\u043a\u0440\u043e\u0432\u0438 \u0431\u0435\u0437 \u0442\u0438\u0442\u0440\u0430 \u0430\u043d\u0442\u0438\u0442\u0435\u043b.\nII \u0433\u0440\u0443\u043f\u043f\u0430 \u0440\u0438\u0441\u043a\u0430: \u0411\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0441 \u0440\u0435\u0437\u0443\u0441 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\