40 3 \u0442\u0440\u0438\u043c\u0435\u0441\u0442\u0440 \u041f\u043e\u0441\u043b\u0435\u0440\u043e\u0434\u043e\u0432\u044b\u0439\n\u043f\u0435\u0440\u0438\u043e\u0434\n\u0425\u0412\u0413, \u041f\u0411\u0426, \u041f\u0421\u0425, \u0410\u0418\u0413, \u0411\u0412\u041a, \u041d\u0410\u0421\u0413, \u0410\u0421\u0413\n\u041f\u0440\u0435\u0434\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435\n(\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0426\u041f \u0432 \u0438\u0445 \u0438\u0441\u0445\u043e\u0434\u0435), \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0411\u0430\u0434\u0434\u0430-\u041a\u0438\u0430\u0440\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f\n\u041e\u0441\u0442\u0440\u044b\u0435, \u043d\u0435 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u041e\u0412\u0413, \u0416\u041a\u0411 \u0441 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438, \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e-\u0438\u043d\u0434\u0443\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442,\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u0442\u0440\u044b\u0439 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u044b\u0439 \u0433\u0435\u043f\u0430\u0442\u0438\u0442\n\n\u0421\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u041d\u0435\u0443\u043a\u0440\u043e\u0442\u0438\u043c\u0430\u044f \u0440\u0432\u043e\u0442\u0430 -- -- --\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445\n\n10\n\n-- (\u041f\u0440\u0435) \u044d\u043a\u043b\u0430\u043c\u043f\u0441\u0438\u044f \u2013HELLP\n-- -- \u041e\u0441\u0442\u0440\u0430\u044f \u0436\u0438\u0440\u043e\u0432\u0430\u044f \u0434\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f \u043f\u0435\u0447\u0435\u043d\u0438\n\u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445\n-- -- \u0412\u043d\u0443\u0442\u0440\u0438\u043f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0439 \u0445\u043e\u043b\u0435\u0441\u0442\u0430\u0437 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 --\n\n3) \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0432 \u0422\u0430\u0431\u043b\u0438\u0446\u0435 4.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 4. \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\n\u041d\u0435\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u043d\u0430\u044f \u2022 \u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b \u2022 \u0440\u0432\u043e\u0442\u0430 \u0440\u0435\u0436\u0435 5 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438;\n\u0442\u043e\u0448\u043d\u043e\u0442\u0430 \u0438 \u0440\u0432\u043e\u0442\u0430 (\u0432 \u2022 \u0411\u0410\u041a: \u0410\u041b\u0422, \u0410\u0421\u0422, \u043a\u0430\u043b\u0438\u0439, \u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u043d\u043e-\n\u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c 50%\n\u043d\u0430\u0442\u0440\u0438\u0439, \u0445\u043b\u043e\u0440, \u043c\u0430\u0433\u043d\u0438\u0439, \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439;\n\u0441\u043b\u0443\u0447\u0430\u0435\u0432, \u041d\u0420\u0411 \u2013 \u0432 0,5-\n\u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d; \u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043a\u0435\u0442\u043e\u043d\u043e\u0432 \u0432 \u043c\u043e\u0447\u0435;\n1,5%)\n\u2022 \u043a\u0435\u0442\u043e\u043d\u044b \u043c\u043e\u0447\u0438. \u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0435\u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438, \u043f\u043e\u0442\u0435\u0440\u0438 \u0432\u0435\u0441\u0430\n\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0440\u0432\u043e\u0442\u044b \u043a\u0430\u043a\n\u043e\u0431\u0449\u0435\u0433\u043e \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\n\u0425\u0413, \u042f\u0411 \u2022 \u041e\u0410\u041a+ \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u2022 \u041d\u0430\u043b\u0438\u0447\u0438\u0435\n\u2022 \u043a\u0430\u043b \u043d\u0430 \u0441\u043a\u0440\u044b\u0442\u0443\u044e \u043a\u0440\u043e\u0432\u044c; \u044d\u043d\u0434\u043e\u0441\u043a\u043e\u043f\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e/\u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u2022 \u042d\u0413\u0414\u0421; \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0421\u041e\u0416 \u0438 \u0414\u041f\u041a\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0445\u0438\u0440\u0443\u0440\u0433\u0430.\n\u0418\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u044b\u0439 \u2022 \u041e\u0410\u041a+ \u2022 \u043e\u0441\u0442\u0440\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e;\n\u0433\u0430\u0441\u0442\u0440\u043e\u044d\u043d\u0442\u0435\u0440\u0438\u0442 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u2022 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0438\u043d\u0442\u043e\u043a\u0441\u0438\u043a\u0430\u0446\u0438\u0438;\n\u2022 \u043e\u0441\u0442\u0440\u043e\u0444\u0430\u0437\u043e\u0432\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u2022 \u0434\u0438\u0430\u0440\u0435\u0439\u043d\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c;\n\n\u2022 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043f\u0430\u0442\u043e\u0433\u0435\u043d\u043d\u044b\u0445\n(\u0421\u0420\u0411);\n\u043c\u0438\u043a\u0440\u043e\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u043e\u0432 \u0432 \u043a\u0430\u043b\u0435.\n\u2022 \u043a\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430;\n\u2022 \u0431\u0430\u043a\u0442\u0435\u0440\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n11\n\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u043b\u0430;\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\n\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0441\u0442\u0430.\n\u0412\u0413 \u2022 \u041e\u0410\u041a+ \u2022 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432 \u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435\n\n\u0442\u0440\u043e\u