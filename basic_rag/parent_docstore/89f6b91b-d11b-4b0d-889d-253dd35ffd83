\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0438 \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439:\n\n\u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u044f\u0438\u0447\u043d\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f\n\n\u0420\u043e\u0442\u0442\u0435\u0440\u0434\u0430\u043c\u0441\u043a\u043e\u043c\u0443 \u041a\u043e\u043d\u0441\u0435\u043d\u0441\u0443\u0441\u0443 \u043f\u043e \u0421\u0438\u043d\u0434\u0440\u043e\u043c\u0443 \u041f\u043e\u043b\u0438\u043a\u0438\u0441\u0442\u043e\u0437\u043d\u044b\u0445 \u042f\u0438\u0447\u043d\u0438\u043a\u043e\u0432 \u043e\u0442 2018 \u0433\u043e\u0434\u0430 [2]:\n\n\u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f\n\u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0412\u044b\u0448\u0435 \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\n\u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\n\u041f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u044f \u0449\u0438\u0442\u043e\u0432\u0438\u0434\u043d\u043e\u0439\n\u041d\u041c\u0426 \u0422\u0422\u0413 \u0433\u0438\u043f\u043e\u0442\u0438\u0440\u0435\u043e\u0437, \u043d\u0438\u0436\u0435\n\u0436\u0435\u043b\u0435\u0437\u044b\n\u043d\u0438\u0436\u043d\u0435\u0433\u043e\n\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\n\u0433\u0438\u043f\u0435\u0440\u0442\u0438\u0440\u0435\u043e\u0437\u0435\n\u0413\u0438\u043f\u0435\u0440\u043f\u0440\u043e\u043b\u0430\u043a\u0442\u0438\u043d\u0435\u043c\u0438\u044f \u041d\u041c\u0426, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u041f\u0440\u043e\u043b\u0430\u043a\u0442\u0438\u043d \u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e\n\u043e\u0432\u0443\u043b\u044f\u0446\u0438\u0438, \u0431\u0435\u0441\u043f\u043b\u043e\u0434\u0438\u0435, \u043f\u043e\u0440\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\n\u043f\u0440\u0438\u0431\u0430\u0432\u043a\u0430 \u0432 \u0432\u0435\u0441\u0435\n\u041d\u0435\u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0444\u043e\u0440\u043c\u044b \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u041d\u043e\u0440\u043c\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f 200-\n\u0412\u0414\u041a\u041d \u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0439 400\u043d\u0433/\u043c\u043b \u0432\n\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u0435\u0441\u0442-\n\u0434\u043e 08 \u0447. \u0441\u0438\u0441\u0442\u0435\u043c (\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\n\u0423\u0440\u043e\u0432\u0435\u043d\u044c 17- \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043d\u0430 3-5\n\u041e\u041f\u041a \u0434.\u043c.\u0446.), \u043d\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u041d\u041c\u0426, \u0433\u0438\u0440\u0441\u0443\u0442\u0438\u0437\u043c,\n\u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0430\n\u0433\u0438\u043f\u0435\u0440\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u0438\u044f\n\u043d\u0438\u0436\u043d\u0435\u0439 \u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u043d\u043e\u0440\u043c\u044b\n(200\u043d\u0433/\u043c\u043b) \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\n\u0442\u0435\u0441\u0442 \u0441 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\n\u0430\u043d\u0430\u043b\u043e\u0433\u043e\u043c \u0410\u041a\u0422\u0413\n(250\u043c\u043a\u0433) \u0434\u043e \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f\n17\u041e\u041f\u041a >1000\u043d\u0433/\u043c\u043b\n\u0422\u0430\u043a\u0436\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0440\u044f\u0434 \u0434\u0440\u0443\u0433\u0438\u0445 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439, \u0438\u043c\u0435\u044e\u0449\u0438\u0445 \u0441\u0445\u043e\u0434\u043d\u044b\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u044f\u0438\u0447\u043d\u0438\u043a\u0430 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\n\u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b.\n\u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0410\u043c\u0435\u043d\u043e\u0440\u0435\u044f (\u0430 \u043d\u0435 \u0425\u043e\u0440\u0438\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0433\u043e\u043d\u0430\u0434\u043e\u0442\u0440\u043e\u043f\u0438\u043d\n\u0411\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043e\u043b\u0438\u0433\u043e\u043c\u0435\u043d\u043e\u0440\u0435\u044f), \u043f\u0440\u043e\u0447\u0438\u0435 \u0425\u0413\u0427 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 (\u0425\u0413\u0427) \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043a\u0440\u043e\u0432\u0438 \u0438\u043b\u0438 \u0432 \u043c\u043e\u0447\u0435 (\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u044b\u0439)\n\u0410\u043c\u0435\u043d\u043e\u0440\u0435\u044f, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u0432\u0435\u0441\u0430/\u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430\n\u041b\u044e\u0442\u0435\u0438\u043d\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0433\u043e\u0440\u043c\u043e\u043d\n(\u0418\u041c\u0422), \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0435\n(\u041b\u0413) \u0438\n\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0432\n\u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u043e\u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0443\u044e\u0449\u0438\u0439\n\u0413\u0438\u043f\u043e\u0442\u0430\u043b\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435, \u043d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u0424\u0421\u0413, \u041b\u0413,\n\u0433\u043e\u0440\u043c\u043e\u043d (\u0424\u0421\u0413) \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435\n\u0430\u043c\u0435\u043d\u043e\u0440\u0435\u044f \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u044d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b\n\u043a\u0440\u043e\u0432\u0438 (\u0441\u043d\u0438\u0436\u0435\u043d\u044b \u0438\u043b\u0438 \u043d\u0430 \u043d\u0438\u0436\u043d\u0435\u0439\n\u0433\u0438\u043f\u0435\u0440\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u0438\u0438, \u0438\u043d\u043e\u0433\u0434\u0430\n\u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u043d\u043e\u0440\u043c\u044b), \u042d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b\n\u0432\u044b\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f\n\u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438 (\u0441\u043d\u0438\u0436\u0435\u043d)\n\u043c\u0443\u043b\u044c\u0442\u0438\u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435\n\u044f\u0438\u0447\u043d\u0438\u043a\u0438\n\u0410\u043c\u0435\u043d\u043e\u0440\u0435\u044f \u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442\u0441\u044f \u0441 \u0424\u0421\u0413 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438\n\u041f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0424\u0421\u0413, \u041b\u0413, (\u043f\u043e\u0432\u044b\u0448\u0435\u043d), \u044d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b\n\u043e\u0432\u0430\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f\n\u044d\u0441\u0442\u0440\u043e\u0433\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0430, \u044d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438 (\u0441\u043d\u0438\u0436\u0435\u043d)\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\n\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0440\u0438\u043b\u0438\u0432\u044b \u0436\u0430\u0440\u0430 \u0438\n\n\u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f\n\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0443\u0440\u043e\u0433\u0435\u043d\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b\n\u0422\u0435\u0441\u0442\u043e\u0441\u0442\u0435\u0440\u043e\u043d \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438,\n\u0414\u042d\u0410\u0421 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0438 \u043a\u0440\u043e\u0432\u0438\n(\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u044b)\n\u0412\u0438\u0440\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f (\u0432\u043a\u043b\u044e\u0447\u0430\u044f\n\u0442\u0435\u0441\u0442\u043e\u0441\u0442\u0435\u0440\u043e\u043d \u0423\u043b\u044c\u0442\u0440\u0430\u0441\u043e\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u044f\u0438\u0447\u043d\u0438\u043a\u043e\u0432 \u2013\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0433\u043e\u043b\u043e\u0441\u0430,\n\u0410\u043d\u0434\u0440\u043e\u0433\u0435\u043d- \u0414\u042d\u0410\u0421 \u043c\u0443\u043b\u044c\u0442\u0438\u0444\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u044f\u0438\u0447\u043d\u0438\u043a\u0438\n\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u043d\u0443\u044e \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u044e,\n\u043f\u0440\u043e\u0434\u0443\u0446\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u0423\u0417\u0418 \u041e\u041c\u0422 \u0438\u043b\u0438 \u043a\u0438\u0441\u0442\u043e\u0437\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\u043a\u043b\u0438\u0442\u043e\u0440\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044e),\n\u043e\u043f\u0443\u0445\u043e\u043b\u0438 \u041c\u0420\u0422 \u041c\u0430\u0433\u043d\u0438\u0442\u043d\u043e-\u0440\u0435\u0437\u043e\u043d\u0430\u043d\u0441\u043d\u0430\u044f\n\u0431\u044b\u0441\u0442\u0440\u0430\u044f \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0430\u0446\u0438\u044f\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432 \u0442\u043e\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f (\u041c\u0420\u0422)\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432 \u2013\n\u043d\u0435\u043e\u0434\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432\n\u041d\u0430\u0440\u044f\u0434\u0443 \u0441 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u0424\u0421\u0413, \u041b\u0413,\n\u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438, \u0441\u0445\u043e\u0434\u043d\u044b\u043c\u0438\n\u044d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b\n\u0441 \u0421\u041f\u041a\u042f (\u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0435 \u043f\u043e\n\u0442\u0435\u0441\u0442\u043e\u0441\u0442\u0435\u0440\u043e\u043d \u0421\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b \u0432\n\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0442\u0438\u043f\u0443,\n\u0414\u042d\u0410\u0421 \u0441\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u043e\u0447\u0435 (\u043f\u043e\u0432\u044b\u0448\u0435\u043d),\n\u0433\u0438\u043f\u0435\u0440\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u0438\u044f,\n\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b \u0432 \u0441\u043b\u044e\u043d\u0435 \u0432 \u043d\u043e\u0447\u043d\u044b\u0435\n\u0421\u0438\u043d\u0434\u0440\u043e\u043c \u0438\u043b\u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\n\u0438\u043d\u0441\u0443\u043b\u0438\u043d \u0447\u0430\u0441\u044b (\u043f\u043e\u0432\u044b\u0448\u0435\u043d), \u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u0439\n\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0418\u0446\u0435\u043d\u043a\u043e- \u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043a\n\u0423\u0417\u0418 \u041e\u041c\u0422 \u043d\u043e\u0447\u043d\u043e\u0439 \u0442\u0435\u0441\u0442 \u0441 \u0434\u0435\u043a\u0441\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d\u043e\u043c\n\u041a\u0443\u0448\u0438\u043d\u0433\u0430 \u0443\u0433\u043b\u0435\u0432\u043e\u0434\u0430\u043c), \u0438\u043c\u0435\u044e\u0442\u0441\u044f\n\u041c\u0420\u0422 (\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u044f\n\u0431\u043e\u043b\u0435\u0435 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432, \u0443\u0440\u043e\u0432\u043d\u044f \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\u0430 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b: \u043c\u0438\u043e\u043f\u0430\u0442\u0438\u044f,\n\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u0432\u0438 \u0443\u0442\u0440\u043e\u043c)\n\u043f\u043b\u0435\u0442\u043e\u0440\u0430, \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u044b\u0435\n\u043c\u043e\u0437\u0433\u0430\n\u0441\u0442\u0440\u0438\u0438, \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437 \u0438\n\u0433\u0438\u043f\u043e\u0444\u0438\u0437\u0430\n\u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f\n\u0424\u0421\u0413, \u041b\u0413,\n\u044d\u0441\u0442\u0440\u0430\u0434\u0438\u043e\u043b\n\u0442\u0435\u0441\u0442\u043e\u0441\u0442\u0435\u0440\u043e\u043d\n\u00ab\u041a\u0443\u0448\u0438\u043d\u0433\u043e\u0438\u0434\u0438\u0437\u0430\u0446\u0438\u044f\u00bb\n\u0414\u042d\u0410\u0421\n\u0432\u043d\u0435\u0448\u043d\u043e\u0441\u0442\u0438 \u0441\n\u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\n\u043f\u0435\u0440\u0435\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c\n\u0422\u043e\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u0443\u043b\u0438\u043d\n\u0436\u0438\u0440\u0430 \u043f\u043e \u0432\u0435\u0440\u0445\u043d\u0435\u043c\u0443 \u0442\u0438\u043f\u0443 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u043e\u0440\u0442\u0438\u0437\u043e\u043b\u0430\n\u0433\u0438\u043f\u0435\u0440\u043a\u043e\u0440\u0442\u0438\u0446\u0438\u0437\u043c \u0423\u0417\u0418 \u041e\u041c\u0422\n\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0441\u0442\u0440\u0438\u0438,\n\u041c\u0420\u0422\n\u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0438, \u043e\u0441\u0442\u0435\u043e\u043f\u043e\u0440\u043e\u0437,\n\u043d\u0430\u0434\u043f\u043e\u0447\u0435\u0447\u043d\u0438\u043a\u043e\u0432\n\u0440\u0435\u0437\u043a\u043e\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0410\u0414.\n\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e\n\u043c\u043e\u0437\u0433\u0430\n\u0433\u0438\u043f\u043e\u0444\u0438\u0437\u0430\n3. \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435:\n3.1 \u041d\u0435\u043c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [1, 2, 3]:\n\u2022 \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e \u043e\u0431\u0440\u0430\u0437\u0430 \u0436\u0438\u0437\u043d\u0438\n(\u0422\u041c\u041e\u0416), \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0443\u044e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0438 \u0434\u0438\u0435\u0442\u0443 (\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u0435\u043c\u0430\n\u0443\u0433\u043b\u0435\u0432\u043e\u0434\u043e\u0432), \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u044f \u0438 \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u043a \u0441\n\u0434\u0438\u0441\u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u044f\u0438\u0447\u043d\u0438\u043a\u043e\u0432.\n\n3.2 \u041c\u0435\u0434\u0438\u043a\u0430\u043c\u0435\u043d\u0442\u043e\u0437\u043d\u043e\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 [1, 2]:\n\nNB!\n\n\u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0443\u0436\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0438 \u0432\n\u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438.\n\n\u0421\u0445\u0435\u043c\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d \u043d\u0435\u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0432 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438:\n\n\u2022 \u041f\u0435\u0440\u0432\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0439 \u044d\u0442\u043e \u0433\u043e\u0440\u043c\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\u0446\u0435\u043f\u0446\u0438\u0438. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f\n\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0438\u0437\u043a\u043e\u0434\u043e\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u041a\u041e\u041a, \u0441 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435\u043c \u0433\u0435\u0441\u0442\u0430\u0433\u0435\u043d\u0430 \u0441\n\u0430\u043d\u0442\u0438\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u043d\u044b\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043c.\n\nNB!\n\n\u0421\u0442\u0430\u0440\u0442 \u0441 \u0433\u043e\u0440\u043c\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0440\u0430\u0446\u0435\u043f\u0442\u0438\u0432\u043e\u0432 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0443 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432 \u0441 \u043c\u0435\u043d\u0430\u0440\u0445\u0435\n\u0431\u043e\u043b\u044c\u0448\u0435 2- \u043b\u0435\u0442 \u043f\u0440\u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043b\u0438 \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0433\u0438\u043f\u0435\u0440\u0430\u043d\u0434\u0440\u043e\u0433\u0435\u043d\u0438\u0435\u0439 \u0441 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u043c\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u043e\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 IV \u0441\u0442\u0430\u0434\u0438\u0438 \u043f\u043e \u0422\u0430\u043d\u043d\u0435\u0440\u0443\n\n\u0412\u0442\u043e\u0440\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438: \u0431\u0438\u0433\u0443\u0430\u043d\u0438\u0434\u044b (\u043c\u0435\u0442\u0444\u043e\u0440\u043c\u0438\u043d). \u041b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0430\u0437\u043d\u0430\u0447\u0430\u0435\u0442\u0441\u044f\n\u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043e\u043b\u043e\u0433\u0430\u043c\u0438 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u0430 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443 \u00ab\u041e\u0436\u0438\u0440\u0435\u043d\u0438\u0435 \u0443\n\u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445\u00bb [5].\n\nNB!\n\u041d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0435\u0442\u0444\u043e\u0440\u043c\u0438\u043d \u0434\u043b\u044f \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0433\u0438\u0440\u0441\u0443\u0442\u0438\u0437\u043c\u0430, \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u044f!\n\n\u0421\u0445\u0435\u043c\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d, \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0432 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0438 \u0431\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442\u0438 [7]\n\n\u2022 \u041f\u0440\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u0430\u043d\u043e\u0432\u0443\u043b\u044f\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u043b\u043e\u043c\u0438\u0444\u0435\u043d\u0430\n\u0446\u0438\u0442\u0440\u0430\u0442 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u043b\u0438\u043d\u0438\u0438.\n\n\u041d\u0435\u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u044e \u043e\u0432\u0443\u043b\u044f\u0446\u0438\u0439 \u0435\u0441\u043b\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043a\u0438 \u0435\u0441\u0442\u044c\n\u0444\u0430\u043a\u0442\u043e\u0440\u044b \u0440\u0438\u0441\u043a\u0430, \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0449\u0438\u0435 \u043a \u0433\u0438\u043f\u0435\u0440\u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0435 \u044f\u0438\u0447\u043d\u0438\u043a\u043e\u0432:", "type": "Document"}}