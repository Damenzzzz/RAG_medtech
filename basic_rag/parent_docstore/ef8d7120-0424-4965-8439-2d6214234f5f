ab\u0422\u0435\u0440\u0430\u043f\u0438\u044f \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u044f\u00bb.\n\u0421\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 2 \u043a\u0443\u0440\u0441\u043e\u0432 2-CdA/Ara-C (\u041a\u043b\u0430\u0434\u0440\u0438\u0431\u0438\u043d/\u0426\u0438\u0442\u0430\u0440\u0430\u0431\u0438\u043d) [16]. \u041a\u0430\u0436\u0434\u044b\u0439 \u043a\u0443\u0440\u0441\n(\u0440\u0438\u0441\u0443\u043d\u043e\u043a 9) \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437:\n\n\u2022 \u0426\u0438\u0442\u043e\u0437\u0438\u043d\u0430 \u0430\u0440\u0430\u0431\u0438\u043d\u043e\u0437\u0438\u0434 (\u0426\u0438\u0442\u0430\u0440\u0430\u0431\u0438\u043d, Ara-C) 500\u043c\u0433/\u043c2 \u0432 250 \u043c\u043b/\u043c2\n\u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0430 2 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u0434\u043d\u0435\u0439 \u0432 \u0432\u0438\u0434\u0435 2-\u0447\u0430\u0441\u043e\u0432\u043e\u0439\n\u0432\u043d\u0443\u0442\u0440\u0438\u0432\u0435\u043d\u043d\u043e\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043d\u0430 1, 13, 25, 37, 49, 61, 73, 85, 97 \u0438 109 \u0447\u0430\u0441. \u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c,\n\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u0426\u0438\u0442\u0430\u0440\u0430\u0431\u0438\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1000\u043c\u0433/\u043c2. \u0412\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u0432 \u043f\u0435\u0440\u0432\u044b\u0439\n\n\u0434\u0435\u043d\u044c \u043a\u0443\u0440\u0441\u0430.\n\n28\n\n\u2022 2-\u0445\u043b\u043e\u0440\u043e\u0434\u0435\u0437\u043e\u043a\u0441\u0438\u0430\u0434\u0435\u043d\u043e\u0437\u0438\u043d (2-CdA, \u041a\u043b\u0430\u0434\u0440\u0438\u0431\u0438\u04