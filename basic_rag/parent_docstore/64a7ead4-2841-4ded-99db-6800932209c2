043b\u0438\u0447\u0438\u0438 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438, \u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430.\n\nFMF \u041a\u043e\u043b\u0445\u0438\u0446\u0438\u043d, \u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430 \u0438 \u043a\u0430\u043d\u0430\u043a\u0438\u043d\u0443\u043c\u0430\u0431\n\n\u0420\u0435\u0446\u0438\u0434\u0438\u0432\u0438\u0440\u0443\u044e\u0449\u0430\n\u041a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u044d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442 \u0438\n\u044f \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u2265 TRAPS\n\u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430\n38\u00b0C\n\u0410\u043d\u0430\u043a\u0438\u043d\u0440\u0430, \u044d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442, \u041d\u041f\u0412\u041f,\n\u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0438 \u0430\u043b\u043b\u043e\u0433\u0435\u043d\u043d\u044b\u0445\nHIDS\n\u0433\u0435\u043c\u0430\u0442\u043e\u043f\u043e\u044d\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a.\n\u041d\u041f\u0412\u041f, \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b,\nPFAPA \u0430\u0434\u0435\u043d\u043e\u0442\u043e\u043d\u0437\u0438\u043b\u043b\u044d\u043a\u0442\u043e\u043c\u0438\u044f, \u043a\u043e\u043b\u0445\u0438\u0446\u0438\u043d,\n\u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430\n\nFCAS\n\u0410\u043d\u0430\u043a\u0438\u043d\u0440\u0430 \u0438 \u043a\u0430\u043d\u0430\u043a\u0438\u043d\u0443\u043c\u0430\u0431\nMWS, \u0421IN\u0421\u0410\n\u041a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442,\nSyndrome\n\u041c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u043e\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430,\n\u041b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430 \u0441 BLAU\n\u0430\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d, \u0438\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431,\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c\n\u0430\u0434\u0430\u043b\u0438\u043c\u0443\u043c\u0430\u0431, \u0442\u043e\u0444\u0430\u0446\u0438\u0442\u0438\u043d\u0438\u0431\n\u043a\u043e\u0436\u0438 PAPA \u041a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u0440\u0435\u0442\u0438\u043d\u043e\u0438\u0434\u044b\n\u044d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442, \u0438\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431,\n\u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430\n\u0410\u043d\u0442\u0438\u0433\u0438\u0441\u0442\u0430\u043c\u0438\u043d\u044b, \u041d\u041f\u0412\u041f, \u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430,\nNLRP 12\n\u0438\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431, \u0430\u0434\u0430\u043b\u0438\u043c\u0443\u043c\u0430\u0431,\n\u0442\u043e\u0446\u0438\u043b\u0438\u0437\u0443\u043c\u0430\u0431, \u0446\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434,\n\u043a\u0430\u043d\u0430\u043a\u0438\u043d\u0443\u043c\u0430\u0431, \u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430,\n\u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b\nCANDLE \u041d\u041f\u0412\u041f, \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b\nJAK \u043a\u0438\u043d\u0430\u0437\u044b\n\u041d\u041f\u0412\u041f, \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430 \u0438\nMajeed\n\u043a\u0430\u043d\u0430\u043a\u0438\u043d\u0443\u043c\u0430\u0431, \u0431\u0438\u0441\u0444\u043e\u0441\u0444\u043e\u043d\u0430\u0442\u044b,\nSyndrome,\n\u0438\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431, \u044d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442,\nCRMO\n\u0430\u0434\u0430\u043b\u0438\u043c\u0443\u043c\u0430\u0431\n\u0412\u043e\u0441\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u043e\u0441\u0442\u0435\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\n\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f DIRA \u0410\u043d\u0430\u043a\u0438\u043d\u0440\u0430, \u043a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u041d\u041f\u0412\u041f,\n\u0438/\u0438\u043b\u0438\n\u0441\u0442\u0435\u0440\u0438\u043b\u044c\u043d\u044b\u0439\n\u043f\u0443\u0441\u0442\u0443\u043b\u0435\u0437 \u041a\u043e\u0440\u0442\u0438\u043a\u043e\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u044b, \u043c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442,\n\u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d, \u0430\u043d\u0430\u043a\u0438\u043d\u0440\u0430, \u0440\u0435\u0442\u0438\u043d\u043e\u0438\u0434\u044b,\nDITRA\n\u044d\u0442\u0430\u043d\u0435\u0440\u0446\u0435\u043f\u0442, \u0430\u0434\u0430\u043b\u0438\u043c\u0443\u043c\u0430\u0431,\n\u0438\u043d\u0444\u043b\u0438\u043a\u0441\u0438\u043c\u0430\u0431.\n\u0421\u0445\u0435\u043c\u0430 5. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0410\u0412\u0421 [9-11,15-24].\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 5. \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430:\n\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e \u041c\u041d\u041d \u0421\u043f\u043e\u0441\u043e\u0431 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043d\u043e\u0441\u0442\u0438\n\u0410\u043b\u043a\u0430\u043b\u043e\u0438\u0434 \u041a\u043e\u043b\u0445\u0438\u0446\u0438\u043d \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 (\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f): \u0410 [15-17]\n\n\u0442\u0440\u043e\u043f\u043e\u043b\u043e\u043d\u043e\u0432\u043e\u0433\u043e \u0440\u044f\u0434\u0430 \uf0fc \u0414\u043b\u044f \u0434\u0435\u0442\u0435\u0439\n\u043c\u043b\u0430\u0434\u0448\u0435 5 \u043b\u0435\u0442 \u22640,5 \u043c\u0433/\u0441\u0443\u0442\n\uf0fc \u0414\u0435\u0442\u044f\u043c \u043e\u0442 5 \u0434\u043e\n10 \u043b\u0435\u0442 \u043e\u0442 0,5 \u0434\u043e 1 \u043c\u0433/\u0441\u0443\u0442\n\n\uf0fc \u0414\u0435\u0442\u044f\u043c \u0441\u0442\u0430\u0440\u0448\u0435\n10 \u043b\u0435\u0442 \u0438 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u043c \u043e\u0442 1 \u0434\u043e\n1,5 \u043c\u0433/\u0441\u0443\u0442\n\n\uf0fc \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\n\u0440\u0430\u043d\u0435\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0432\u0448\u0438\u043c\u0438\n\u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u044f\u043c\u0438\n(\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u043e\u0447\u0435\u0447\u043d\u044b\u043c\n\n\u0430\u043c\u0438\u043b\u043e\u0438\u0434\u043e\u0437\u043e\u043c) \u0438\u043b\u0438\n\u0447\u0430\u0441\u0442\u044b\u043c\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430\u043c\u0438\n\u0410\u0412\u0421 \u0438\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u043e\u0439\n\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e\n\n\u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0410\u0412\u0421, \u0441\n\u0432\u043e\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435\u043c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445\n\u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c\n\u0441\u0443\u0441\u0442\u0430\u0432\u043e\u0432)[10] \u0431\u043e\u043b\u0435\u0435\n\n\u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u043e\u0437\u044b\n(\u0434\u043e 2 \u043c\u0433/\u0434\u0435\u043d\u044c)\n\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438\n\u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\n\n\u043f\u043e\u0447\u0435\u043a \u0438 \u043f\u0435\u0447\u0435\u043d\u0438.\n\n\u041a\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438\u0435\u043c\u0430: 2\n\u0440\u0430\u0437\u0430 \u0432 \u0434\u0435\u043d\u044c (\u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f\n\n\u0434\u043e\u0437\u0430 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0432 2\n\u043f\u0440\u0438\u0435\u043c\u0430)\n\u0421\u043f\u043e\u0441\u043e\u0431 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f: \u0447\u0435\u0440\u0435\u0437\n\u0440\u043e\u0442.\n\n\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c: \u043d\u0435 \u043c\u0435\u043d\u0435\u0435\n5 \u043b\u0435\u0442 \u0438 \u0431\u043e\u043b\u0435\u0435.\n\u0413\u041a\u0421 \u041c\u0435\u0442\u0438\u043b\u043f\u0440\u0435\u0434 \u0412\u043d\u0443\u0442\u0440\u044c, \u0432 \u0434\u043e\u0437\u0435 0,5-2 \u0412 [15,16,21]\n\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u043c\u0433/\u043a\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435\n\n3\u20134 \u0441\u0443\u0442. \u0438 \u0437\u0430\u0442\u0435\u043c\n\n\u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u0430\u044f \u043e\u0442\u043c\u0435\u043d\u0430\n\n\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0422\u0430\u0431\u043b\u0438\u0446\u0435 4***\n\u041f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d \u0412\u043d\u0443\u0442\u0440\u044c, \u0432 \u0434\u043e\u0437\u0435 0,5-2 \u043c\u0433/\u043a\u0433 \u0412 [15,16,21]\n\u0432 \u0441\u0443\u0442\u043a\u0438; \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3\u20134\n\n\u0441\u0443\u0442. \u0438 \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u0430\u044f\n\u043e\u0442\u043c\u0435\u043d\u0430 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0422\u0430\u0431\u043b\u0438\u0446\u0435\n4\n\u0411\u0435\u0442\u0430\u043c\u0435\u0442\u0430\u0437\u043e\u043d 0,2 \u043c\u0433/\u043a\u0433 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e. \u0412 [15,16,21]\n\n\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438\nPFAPA-\u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0435 \u0432\n\u043f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0438.\n\n\u041c\u043e\u0436\u043d\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u043d\u0430 2-\u0439\n\u0434\u0435\u043d\u044c, \u0435\u0441\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f\n\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430.\n\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043e\u043f\u0443\u0445\u043e\u043b\u0435\u0432\u043e\u0435 \u041c\u0435\u0442\u043e\u0442\u0440\u0435\u043a\u0441\u0430\u0442 \u0412\u043e\u0437\u0440\u0430\u0441\u0442: \u0441 1 \u0433\u043e\u0434\u0430. \u0412 [21]\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e. \u0432 \u0434\u043e\u0437\u0435 15 \u043c\u0433/\u043c2 1 \u0440\u0430\u0437 \u0432\n\u0410\u043d\u0442\u0438\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0442 \u043d\u0435\u0434\u0435\u043b\u044e, \u0432\u043d\u0443\u0442\u0440\u044c \u0438\u043b