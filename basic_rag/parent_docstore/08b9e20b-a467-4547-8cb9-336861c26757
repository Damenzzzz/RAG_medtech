\n\u043b\u0435\u0442 \u0438 \u0441\u0442\u0430\u0440\u0448\u0435, \u0438\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 30 \u043b\u0435\u0442 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0434\u0438\u0430\u0431\u0435\u0442\u0430 \u2265 15 \u043b\u0435\u0442, \u043b\u0438\u0431\u043e \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\n\n\u043c\u0438\u043a\u0440\u043e\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u044b\u0445 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439.\n\u0420\u0430\u043d\u043d\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0418\u0411\u0421 \u0443 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0418\u043d\u0444\u0430\u0440\u043a\u0442 \u043c\u0438\u043e\u043a\u0430\u0440\u0434\u0430 \u0438\u043b\u0438 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0435\u043d\u043e\u043a\u0430\u0440\u0434\u0438\u044f\n\u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432 (\u043e\u0442\u044f\u0433\u043e\u0449\u0435\u043d\u043d\u0430\u044f \u0443 \u043c\u0443\u0436\u0447\u0438\u043d \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 <55 \u043b\u0435\u0442, \u0443 \u0436\u0435\u043d\u0449\u0438\u043d <60 \u043b\u0435\u0442\n\u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c)\n\u0410\u043d\u0435\u0432\u0440\u0438\u0437\u043c\u0430 \u0430\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0430\u043e\u0440\u0442\u044b \u0420\u0430\u0437\u043c\u0435\u0440 \u0430\u043d\u0435\u0432\u0440\u0438\u0437\u043c\u044b \u2265 3,0 \u0441\u043c, \u043b\u0438\u0431\u043e \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\n\u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0435 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432 \u043d\u0430 \u0430\u043e\u0440\u0442\u0435.\n\u0421\u0435\u043c\u0435\u0439\u043d\u0430\u044f \u0433\u0438\u043f\u0435\u0440\u043b\u0438\u043f\u0438\u0434\u0435\u043c\u0438\u044f, \u043f\u043e II\u0430, IIb \u0438 III \u0442\u0438\u043f\n\u0434\u0430\u043d\u043d\u044b\u043c \u0430\u043d\u0430\u043c\u043d\u0435\u0437\u0430\n\u041e\u0436\u0438\u0440\u0435\u043d\u0438\u0435/\u0410\u0431\u0434\u043e\u043c\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0436\u0438\u0440\u0435\u043d\u0438\u0435 \u041f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0418\u041c\u0422 > 25 \u043a\u0433/\u043c2/ \u043e\u043a\u0440\u0443\u0436\u043d\u043e\u0441\u0442\u044c \u0442\u0430\u043b\u0438\u0438: \u0443\n\n\u043c\u0443\u0436\u0447\u0438\u043d \u2265 94 \u0441\u043c, \u0443 \u0436\u0435\u043d\u0449\u0438\u043d \u2265 80 \u0441\u043c\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0435\u043a \u0421\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043a\u043b\u0443\u0431\u043e\u0447\u043a\u043e\u0432\u043e\u0439 \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 <60\n\u043c\u043b/\u043c\u0438\u043d\n\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0420\u0435\u0432\u043c\u0430\u0442\u043e\u0438\u0434\u043d\u044b\u0439 \u0430\u0440\u0442\u0440\u0438\u0442, \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u043d\u0430\u044f\n\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0442\u043a\u0430\u043d\u0438 \u0432\u043e\u043b\u0447\u0430\u043d\u043a\u0430, \u043f\u0441\u043e\u0440\u0438\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0440\u0442\u0440\u0438\u0442,\n\u0430\u043d\u043a\u0438\u043b\u043e\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0441\u043f\u043e\u043d\u0434\u0438\u043b\u0