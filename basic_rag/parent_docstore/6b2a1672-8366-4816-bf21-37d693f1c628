n\u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043d\u0430 \u043f\u0435\u0440\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u0439.\n\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u0430\u0432\u0430\u0442\u044c \u0434\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u0438 \u043b\u0438\u0431\u043e \u0432 \u0432\u0438\u0434\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0445 \u0431\u043e\u043b\u044e\u0441\u043e\u0432 \u043b\u0438\u0431\u043e \u0432 I B\n\u0432\u0438\u0434\u0435 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0439 \u0438\u043d\u0444\u0443\u0437\u0438\u0438, \u0434\u043e\u0437\u0430 \u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u044b \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f\n\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0438 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\n\u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f \u043f\u0435\u0442\u043b\u0435\u0432\u044b\u0445 \u0434\u0438\u0443\u0440\u0435\u0442\u0438\u043a\u043e\u0432 \u0441 \u0442\u0438\u0430\u0437\u0438\u0434\u043d\u044b\u043c\u0438 \u0438\u043b\u0438 \u0441\u043f\u0438\u0440\u043e\u043d\u043e\u043b\u0430\u043a\u0442\u043e\u043d\u043e\u043c IIb C\n\n\u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0440\u0435\u0437\u0438\u0441\u0442\u0435\u043d\u0442\u043d\u044b\u043c \u043e\u0442\u0435\u043a\u043e\u043c \u0438\u043b\u0438\n\u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u043c \u043e\u0442\u0432\u0435\u0442\u043e\u043c \u043d\u0430 \u0442\u0435\u0440\u0430\u043f\u0438\u044e\n\u0412\u0430\u0437\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440\u044b\n\u0412/\u0432 \u0432\u0430\u0437\u043e\u0434\u0438\u043b\u044f\u0442\u0430\u0442\u043e\u0440\u044b \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0434\u043b\u044f \u043e\u0431\u043b\u0435\u0433\u0447\u0435\u043d\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 IIa B\n\n\u043f\u0440\u0438 \u041e\u0421\u041d \u0441 \u0421\u0410\u0414 > 90 \u043c\u043c \u0440\u0442.\u0441\u0442. (\u0438 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0437\u0438\u0438).\n\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0447\u0430\u0441\u0442\u043e \u0438\n\n17\n\n\u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432/\u0432 \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u043f\u0430\u0440\u0430\u0442\u0430\n\u0423 \u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u0441 \u041e\u0421\u041d \u0438 \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u0435\u0439 \u0432/\u0432 \u0432\u0430\u0437\u043e\u0434\u0438\u043b\u0430\u0442\u0430\u0442\u043e\u0440\u044b \u0441\u043b\u0435\u0434\u0443\u0435\u0442 IIa B\n\u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432\n\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u0432\u0435\u043d\u043e\u0437\u043d\u043e\u0433\u043e \u0437\u0430\u0441\u0442\u043e\u044f\n\n\u0418\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0435 \u0430\u0433\u0435\u043d\u0442\u044b - \u0434\u043e\u0431\u0443\u0442\u0430\u043c\u0438\u043d, \u0434\u043e\u043f\u0430\u043c\u0438\u043d, \u043b\u0435\u0432\u043e\u0441\u0438\u043c\u0435\u043d\u0434\u0430\u043d,\n\u0438\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u0444\u043e\u0441\u0444\u043e\u0434\u0438\u044d\u0441\u0442\u0435\u0440\u0430\u0437\u044b III (\u043c\u0438\u043b\u0440\u0438\u043d\u043e\u043d)(PDE III)\n\u0412/\u0432 \u0438\u043d\u0444\u0443\u0437\u0438\u044f \u0438\u043d\u043e\u0442\u0440\u043e\u043f\u043d\u044b\u0445 \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u043c \u043a\u0443\u0440\u0441\u043e\u043c \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c IIb C\n\u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0430 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0433\u0438\u043f\u043e\u0442\u043e\u043d\u0438\u0435\u0439 (\u0421\u0410\u0414 <90 \u043c\u043c \u0440\u0442.\u0441\u0442.) \u0438 / \u0438\u043b\u0438\n\n\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u043c\u0438 /\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u043c\u0438 \u0433\u0438\u043f\u043e\u043f\u0435\u0440\u0444\u0443\u0437\u0438\u0438, \u0434\u043b\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e\u0433\u043e\n\u0432\u044b\u0431\u0440\u043e\u0441\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u0443\u043b\u0443\u0447\u