u0414\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u041d\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041e\u0431\u0449\u0438\u0435 \u0441 \u043e\u0441\u0442\u0440\u043e\u0439\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0420\u0422\u041f\u0425\n\u041a\u043e\u0436\u0430 \u041f\u043e\u0439\u043a\u0438\u043b\u043e\u0434\u0435\u0440\u043c\u0430 \u0414\u0435\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u041f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u042d\u0440\u0438\u0442\u0435\u043c\u0430\n\u041b\u0438\u0445\u0435\u043d\u043e\u0438\u0434\u043d\u044b\u0435 \u041f\u0430\u043f\u043f\u0443\u043b\u043e\u0441\u043a\u0432\u0430\u043c\u043e\u0437\u043d\u044b\u0435 \u0418\u0445\u0442\u0438\u043e\u0437 \u041c\u0430\u043a\u0443\u043b\u043e\u043f\u0430\u043f\u0443\u043b\u043b\u0435\u0437\u043d\u0430\u044f\n\u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043e\u0447\u0430\u0433\u0438 \u0424\u043e\u043b\u043b\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u044b\u0439 \u043a\u0435\u0440\u0430\u0442\u043e\u0437 \u0441\u044b\u043f\u044c\n\u041b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0413\u0438\u043f\u043e\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u0417\u0443\u0434\n\u0441\u043a\u043b\u0435\u0440\u043e\u0434\u0435\u0440\u043c\u0430 \u0413\u0438\u043f\u0435\u0440\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f\n\u0421\u043a\u043b\u0435\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\u043b\u0438\u0445\u0435\u043d\n\u041d\u043e\u0433\u0442\u0438 \u0414\u0438\u0441\u0442\u0440\u043e\u0444\u0438\u044f\n\u041f\u0440\u043e\u0434\u043e\u043b\u044c\u043d\u0430\u044f\n\u0438\u0441\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c\n\u041f\u0440\u043e\u0434\u043e\u043b\u044c\u043d\u0430\u044f\n\u0438\u0441\u0447\u0435\u0440\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c,\n\u0441\u043b\u043e\u0438\u0441\u0442\u043e\u0441\u0442\u044c,\n\u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f\n\u043b\u043e\u043c\u043a\u043e\u0441\u0442\u044c,\n87\n\n\u041e\u043d\u0438\u0445\u043e\u043b\u0438\u0437\nPterygium unguis\n\u041f\u043e\u0442\u0435\u0440\u044f \u043d\u043e\u0433\u0442\u044f\n(\u043e\u0431\u044b\u0447\u043d\u043e\n\u0441\u0438\u043c\u043c\u0435\u0442\u0440\u0438\u0447\u043d\u0430\u044f,\n\u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u044e\u0449\u0430\u044f\n\u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e\n\u043d\u043e\u0433\u0442\u0435\u0439)\n\u0412\u043e\u043b\u043e\u0441\u044b \u043d\u0430 \u041f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0447\u0430\u0433\u043e\u0432 \u0418\u0441\u0442\u043e\u043d\u0447\u0435\u043d\u0438\u0435, \u0442\u0443\u0441\u043a\u043b\u043e\u0441\u0442\u044c,\n\u0433\u043e\u043b\u043e\u0432\u0435 \u0438 \u0442\u0435\u043b\u0435 \u0440\u0443\u0431\u0446\u043e\u0432\u043e\u0439 \u0438 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f \u0436\u0435\u0441\u0442\u043a\u043e\u0441\u0442\u044c\n\u043d\u0435\u0440\u0443\u0431\u0446\u043e\u0432\u043e\u0439 \u0432\u043e\u043b\u043e\u0441 \u0438 \u0433\u043d\u0435\u0437\u0434\u043d\u0430\u044f\n\u0430\u043b\u043b\u043e\u043f\u0435\u0446\u0438\u0438 (\u043f\u043e\u0441\u043b\u0435 \u0430\u043b\u043e\u043f\u0435\u0446\u0438\u044f\n\u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f (\u043d\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043c\u044b\u0435\n\u0432\u043e\u043b\u043e\u0441\u0438\u0441\u0442\u043e\u0433\u043e \u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u043c\u0438 \u0438\u043b\u0438\n\u043f\u043e\u043a\u0440\u043e\u0432\u0430, \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c\u0438)\n\u043d\u0430\u0440\u0443\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u041f\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0441\u0435\u0434\u0438\u043d\u0430\n\u0445\u0438\u043c\u0438\u043e\u0442\u0435\u0440\u0430\u043f\u0438\u0435\u0439)\n\u0412\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0432\u043e\u043b\u043e\u0441 \u043d\u0430\n\u0442\u0435\u043b\u0435\n\u0421\u043b\u0438\u0437\u0438\u0441\u0442\u0430\u044f \u041b\u0438\u0445\u0435\u043d\u043e\u0438\u0434\u043d\u044b\u0435 \u041a\u0441\u0435\u0440\u043e\u0441\u0442\u043e\u043c\u0438\u044f \u0413\u0438\u043d\u0433\u0438\u0432\u0438\u0442\n\u0440\u043e\u0442\u043e\u0432\u043e\u0439 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u041c\u0443\u043a\u043e\u0446\u0435\u043b\u0435 \u041c\u0443\u043a\u043e\u0437\u0438\u0442\n\u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0410\u0442\u0440\u043e\u0444\u0438\u044f \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u043e\u0439 \u042d\u0440\u0438\u0442\u0435\u043c\u0430\n\u0418\u0437\u044a\u044f\u0437\u0432\u043b\u0435\u043d\u0438\u0435 \u0411\u043e\u043b\u044c\n\u041f\u0441\u0435\u0432\u0434\u043e\u043c\u0435\u043c\u0431\u0440\u0430\u043d\u044b\n\u0413\u043b\u0430\u0437\u0430 \u041f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0443\u0445\u043e\u0441\u0442\u0438, \u0424\u043e\u0442\u043e\u0444\u043e\u0431\u0438\u044f\n\u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043f\u0435\u0441\u043a\u0430 \u0432 \u041f\u0435\u0440\u0438\u043e\u0440\u0431\u0438\u0442\u0430\u043b\u044c\u043d\u0430\u044f\n\u0433\u043b\u0430\u0437\u0430\u0445, \u0433\u0438\u043f\u0435\u0440\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f\n\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0411\u043b\u0435\u0444\u0430\u0440\u0438\u0442 (\u044d\u0440\u0438\u0442\u0435\u043c\u0430 \u0438\u043b\u0438\n\u0421\u041a\u041a \u043e\u0442\u0435\u0447\u043d\u043e\u0441\u0442\u044c)\n\u0420\u0443\u0431\u0446\u043e\u0432\u044b\u0439\n\u043a\u043e\u