u0438\u0440\u0443\u0431\u0438\u043d)\n\u2265 3 \u043d\u043e\u0440\u043c e/s\u22640,5; e>\u0432\u0435\u0440\u0445\u043d\u0435\u0439\n\u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0441\u043d\u043e\u0433\u043e\n\u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430\n<3 \u043d\u043e\u0440\u043c \u0412\u043e\u0437\u043c\u043e\u0436\u0435\u043d \u0442\u043e\u043b\u044c\u043a\u043e\n\u043f\u043e\u043b\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442\n\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u044f \u041a\u043e\u0436\u0430, % \u043e\u0442 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430 e-s \u226525%\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0413\u043b\u0430\u0437\u0430, \u0441\u043b\u0438\u0437\u0438\u0441\u0442\u0430\u044f \u0440\u043e\u0442\u043e\u0432\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438, \u0416\u041a\u0422, \u0448\u043a\u0430\u043b\u0430 NIH e-s\u22651\n\u041f\u0435\u0447\u0435\u043d\u043e\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u044b (\u0410\u043b\u0422, \u0429\u0424, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d)\ns\u22653 \u043d\u043e\u0440\u043c e-s\u22653 \u043d\u043e\u0440\u043c\ns<3 e-s\u22652\u043d\u043e\u0440\u043c\n\u041b\u0435\u0433\u043a\u0438\u0435, \u0448\u043a\u0430\u043b\u0430 NIH e-s\u22651\n\u0421\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u041b\u044e\u0431\u043e\u0439 \u043e\u0440\u0433\u0430\u043d \u041d\u0438\u0447\u0435\u0433\u043e \u0438\u0437\n\u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0433\u043e\n\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: e \u2013 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0431\u0430\u043b\u043b\u043e\u0432/\u043e\u0431\u044a\u0435\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\