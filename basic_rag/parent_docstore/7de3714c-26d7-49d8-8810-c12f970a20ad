\u0435\u0439.\n\n\u0414\u0438\u0430\u0433\u043d\u043e\u0437 \u041e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u041a\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430\n\u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u0413\u0435\u043c\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u0437\u044b \u0438 \u0413\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441-\u043c, 1. \u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 1.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u043b\u0438\u043c\u0444\u043e\u043c\u044b \u0431\u043e\u043b\u0438 \u0432 \u043a\u043e\u0441\u0442\u044f\u0445, \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\n\u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f. \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n2.\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n3.\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430 \u0445\u0438\u0442\u043e\u0442\u0440\u0438\u0430\u0437\u0438\u0434\u0430\u0437\u044b (\u0432\n\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0443\u0445\u0438\u0445 \u043f\u044f\u0442\u043d\u0430\u0445 \u043a\u0440\u043e\u0432\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u0442\u0430\u043d\u0434\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0441\u0441-\n4.\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438\u043b\u0438\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432 \u0444\u043b\u0443\u043e\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0438);\n\u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438 2.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d \u0433\u0435\u043d\n\u0445\u0438\u0442\u0440\u0438\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c\n\u043f\u043b\u0435\u0447\u0435 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d\n1q21q31);\n3.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u044b \u043a\u043b\u0435\u0442\u043a\u0438 \u0413\u043e\u0448\u0435\n\u043f\u0440\u0438 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0435 \u043a\u043b\u0435\u0442\u043e\u043a \u0432\n\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0435\n\u041f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043d\u044b\u0435 \u0413\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441-\u043c, 1. \u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 1.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u0430\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 (+/_) \u0431\u043e\u043b\u0438 \u0432 \u043a\u043e\u0441\u0442\u044f\u0445, \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\n\u0430\u043d\u0435\u043c\u0438\u0438 \u043f\u0430\u043d\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n2.\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n3.\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430 \u0445\u0438\u0442\u043e\u0442\u0440\u0438\u0430\u0437\u0438\u0434\u0430\u0437\u044b (\u0432\n\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0443\u0445\u0438\u0445 \u043f\u044f\u0442\u043d\u0430\u0445 \u043a\u0440\u043e\u0432\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u0442\u0430\u043d\u0434\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0441\u0441-\n4.\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438\u043b\u0438\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432 \u0444\u043b\u0443\u043e\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0438);\n\u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438 2.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d \u0433\u0435\u043d\n\u0445\u0438\u0442\u0440\u0438\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n\u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c\n\u043f\u043b\u0435\u0447\u0435 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d\n1q21q31);\n3.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u044b \u043a\u043b\u0435\u0442\u043a\u0438 \u0413\u043e\u0448\u0435\n\u043f\u0440\u0438 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0435 \u043a\u043b\u0435\u0442\u043e\u043a \u0432\n\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0435\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0413\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, 1.\u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 1.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u0445\u043e\u043b\u0435\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u0430\u043c\u0438\u043d\u0430\u0437, \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n\u043f\u0435\u0447\u0435\u043d\u0438, \u0446\u0438\u0440\u0440\u043e\u0437 \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d\u0430, 2.\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u043f\u0435\u0447\u0435\u043d\u0438 \u0432 \u0438\u0441\u0445\u043e\u0434\u0435 \u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441-\u043c, 3.\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430 \u0445\u0438\u0442\u043e\u0442\u0440\u0438\u0430\u0437\u0438\u0434\u0430\u0437\u044b (\u0432\n\u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441-\u043c, \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0443\u0445\u0438\u0445 \u043f\u044f\u0442\u043d\u0430\u0445 \u043a\u0440\u043e\u0432\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 \u0438 \u0431\u043e\u043b\u0435\u0432\u043e\u0439 \u0441-\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u0442\u0430\u043d\u0434\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0441\u0441-\n\u043d\u0435\u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 4.\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438\u043b\u0438\n\u0433\u0435\u043f\u0430\u0442\u0438\u0442\u043e\u0432 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432 \u0444\u043b\u0443\u043e\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0438);\n\u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438 2.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d \u0433\u0435\u043d\n8\n\n\u0445\u0438\u0442\u0440\u0438\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n5.\u0411/\u0445 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c\n6.\u0423\u0417\u0418, \u041a\u0422, \u041c\u0420\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u043f\u043b\u0435\u0447\u0435 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 1q21q31);\n\n\u0425\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u041e\u0441\u0441\u0430\u043b\u0433\u0438\u0438, \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 1..\u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 1.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432\n\u043e\u0441\u0442\u0435\u043e\u043c\u0438\u0435\u043b\u0438\u0442, \u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u0438 (\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\n\u043a\u043e\u0441\u0442\u043d\u044b\u0439 \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d\u0430,\n\u0442\u0443\u0431\u0435\u0440\u043a\u0443\u043b\u0435\u0437 2.\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f),\n3.\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- 2.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438 \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n4.\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430 \u0445\u0438\u0442\u043e\u0442\u0440\u0438\u0430\u0437\u0438\u0434\u0430\u0437\u044b (\u0432\n\u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438 \u0441\u0443\u0445\u0438\u0445 \u043f\u044f\u0442\u043d\u0430\u0445 \u043a\u0440\u043e\u0432\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0445\u0438\u0442\u0440\u0438\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0442\u0430\u043d\u0434\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0441\u0441-\n5.\u0411/\u0445 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438\u043b\u0438\n6.\u0423\u0417\u0418, \u041a\u0422, \u041c\u0420\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432 \u0444\u043b\u0443\u043e\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0438);\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 3.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d \u0433\u0435\u043d\n7.\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u0441\u0442\u043d\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c\n\u0442\u043a\u0430\u043d\u0438 (R, \u041c\u0420\u0422, \u041a\u0422) \u043f\u043b\u0435\u0447\u0435 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d\n1q21q31);\n4.\u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0433\u0435\u043c\u043e\u0440\u0440\u0430\u0433\u0438-\n\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0441-\u043c\u0430,\n5.\u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\n\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u044e\u0442\u0441\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440-\u043d\u044b\u0435\n\u0431\u0443\u043b\u0430\u0432\u043e\u0432\u0438\u0434\u043d\u044b\u0435 \u0438\u043b\u0438\n\u043a\u043e\u043b\u0431\u043e\u0432\u0438\u0434\u043d\u044b\u0435 \u0432\u0437\u0434\u0443\u0442\u0438\u044f\n\u0431\u043e\u043b\u044c\u0448\u0435\u0431\u0435\u0440\u0446\u043e\u0432\u043e\u0439 \u043a\u043e\u0441\u0442\u0438\n(\u201c\u041a\u043e\u043b\u0431\u044b \u042d\u0440\u043b\u0435\u043d\u043c\u0430\u0439\u0435\u0440\u0430\u201d).\n5.\u041d\u0435\u0442 \u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u0438\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0420\u0430\u043d\u043d\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f 1..\u041e\u0431\u0449\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438 \u0441 1.\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044f\n\u043d\u0430\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0431\u043e\u043b\u0435\u0437\u043d\u0438 (3-5 \u043c\u0435\u0441\u044f\u0446\u0435\u0432), \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u043e\u043c \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432, \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430\n\u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u043f\u0430\u0442\u0438\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0440\u0435\u0442\u0438\u043a\u0443\u043b\u043e\u0446\u0438\u0442\u043e\u0432, \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n(\u0431\u043e\u043b\u0435\u0437\u043d\u044c \u043e\u0431\u044a\u0435\u043c\u0430 \u0436\u0438\u0432\u043e\u0442\u0430, 2.\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\n\u041d\u0438\u043c\u0430\u043d\u043d\u0430\u2014\u041f\u0438\u043a\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0430 3.\u043c\u043e\u043b\u0435\u043a\u0443\u043b\u044f\u0440\u043d\u043e- \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u0430 \u0445\u0438\u0442\u043e\u0442\u0440\u0438\u0430\u0437\u0438\u0434\u0430\u0437\u044b (\u0432\n\u043f\u0441\u0438\u0445\u043e\u043c\u043e\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u0443\u0445\u0438\u0445 \u043f\u044f\u0442\u043d\u0430\u0445 \u043a\u0440\u043e\u0432\u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043c\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f, \u0441\u0443\u0434\u043e\u0440\u043e\u0433\u0438, \u0434\u0440. \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u0440\u043e\u0432\u0438, \u0442\u0430\u043d\u0434\u0435\u043c\u043d\u043e\u0439 \u043c\u0430\u0441\u0441-\n\u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f (\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043c\u0443\u0442\u0430\u0446\u0438\u0438 \u0441\u043f\u0435\u043a\u0442\u0440\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0438\u043b\u0438\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430, \u0431\u043e\u043b\u0438 \u0432 \u0433\u0435\u043d\u0430 SMPD1, NPC1 \u0438 \u0444\u043b\u0443\u043e\u0440\u0438\u043c\u0435\u0442\u0440\u0438\u0438);\n\u0436\u0438\u0432\u043e\u0442\u0435, \u043a\u0440\u043e\u0432\u043e\u0442\u043e\u0447\u0438\u0432\u043e\u0441\u0442\u044c, NPC2, \u0433\u0435\u043d\u0430 \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435- 2.\u043d\u0435 \u0432\u044b\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0433\u0435\u043d\n\u044d\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b, \u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n\u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u043e\u043c\n\u0434\u043b\u0438\u043d\u043d\u043e\u043c \u043f\u043b\u0435\u0447\u0435 \u043f\u043b\u0435\u0447\u0435 \u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d\n\u0445\u0440\u043e\u043c\u043e\u0441\u043e\u043c\u044b 1 (\u0440\u0435\u0433\u0438\u043e\u043d 1q21q31);\n1q21q31).\n4.\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0444\u0435\u0440\u043c\u0435\u043d\u0442\u043e\u0432\n\u0433\u043b\u044e\u043a\u043e\u0446\u0435\u0440\u0435\u0431\u0440\u043e\u0437\u0438\u0434\u0430\u0437\u044b \u0438\n\u0445\u0438\u0442\u0440\u0438\u043e\u0437\u0438\u0434\u0430\u0437\u044b,\n\u0441\u0444\u0438\u043d\u0433\u043e\u043c\u0438\u0435\u043b\u0438\u043d\u0430\u0437\u044b\n5.\u0411/\u0445 \u0430\u043d\u0430\u043b\u0438\u0437 \u043a\u0440\u043e\u0432\u0438\n6.\u0423\u0417\u0418, \u041a\u0422, \u041c\u0420\u0422 \u043e\u0440\u0433\u0430\u043d\u043e\u0432\n\u0431\u0440\u044e\u0448\u043d\u043e\u0439 \u043f\u043e\u043b\u043e\u0441\u0442\u0438\n7.\u0420\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n9", "type": "Document"}}