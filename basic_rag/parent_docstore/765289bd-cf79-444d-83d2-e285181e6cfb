438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412\n\n\u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043c\u0435\u043d\u0438 \u0421.\u0414. \u0410\u0441\u0444\u0435\u043d\u0434\u0438\u044f\u0440\u043e\u0432\u0430\u00bb\n\u0437\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438.\n\n17. \u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432: \u043e\u0442\u0441\u0443\u0442\u0441\u0432\u0443\u0435\u0442.\n\n18. \u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u044b:\n\n1) \u0411\u0438\u0433\u0430\u043b\u0438\u0435\u0432 \u041c\u0430\u0434\u0438 \u0425\u043e\u0434\u0436\u0430\u0435\u0432\u0438\u0447 \u2013 \u0434.\u043c.\u043d., \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u0440\u0430\u0447 \u0413\u041a\u041a\u041f\n\u00ab\u0428\u044b\u043c\u043a\u0435\u043d\u0442\u0441\u043a\u0430\u044f \u0413\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u0411\u043e\u043b\u044c\u043d\u0438\u0446\u0430 \u0421\u043a\u043e\u0440\u043e\u0439 \u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0439 \u041f\u043e\u043c\u043e\u0449\u0438\u00bb\n\n19. \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430: \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430 \u0447\u0435\u0440\u0435\u0