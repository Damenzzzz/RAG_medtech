\u0437 \u0442\u043e\u0447\u043d\u043e\u0439 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 V D\n\u043e\u0446\u0435\u043d\u043a\u0438\n\n\u0428\u043e\u0442\u043b\u0430\u043d\u0434\u0441\u043a\u0430\u044f \u043c\u0435\u0436\u0432\u0443\u0437\u043e\u0432\u0441\u043a\u0430\u044f \u0441\u0435\u0442\u044c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u044f\u0449\u0438\u0445 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u0432. \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0434\u043b\u044f\n\n\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432. \u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u043e\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e. \u041d\u043e\u044f\u0431\u0440\u044c 2015.\n\n1.7 \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435:\n\u0418\u0437\u043e\u0441\u0435\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c \u043a\u0440\u043e\u0432\u0438 \u043c\u0430\u0442\u0435\u0440\u0438 \u0438 \u043f\u043b\u043e\u0434\u0430[5] \u2013\n\u0433\u0443\u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u043c\u043c\u0443\u043d\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u0440\u0435\u0437\u0443\u0441 \u2013 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u0438 \u043d\u0430\n\n\u044d\u0440\u0438\u0442\u0440\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0433\u0435\u043d\u044b \u0440\u0435\u0437\u0443\u0441-\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043b\u043e\u0434\u0430, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u043c\n\u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0442\u0441\u044f \u0430\u043d\u0442\u0438\u0440\u0435\u0437\u0443\u0441\u043d\u