44c \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u0430\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u043d\u0438\u0437\u043a\u0430\u044f \u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u043e\u043f\u0430\u0441\u043d\u044b\u043c \u0434\u043b\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u0447\u0435\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0435\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f (\u0442\u0430\u0431\u043b\u0438\u0446\u0430 2). \u041f\u0440\u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f\n\n\u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0430\u043c\u0431\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u0430 2 - \u0418\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0430\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u044f \u0410\u0418\u0413\u0410\n\n12\n\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 \u0414\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0430 \u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435\n\n\u0410\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d 100-150 \u043c\u0433/\u0434\u0435\u043d\u044c \u0438\u043b\u0438 \u041e\u0442\u0432\u0435\u0442 \u043c\u0435\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0443 \u0422\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0434\u043e\u0437\u0438\u0440\u043e\u0432\u043a\u0438 \u0438\u0437-\u0437\u0430\n1\u20142,5 \u043c\u0433/\u0441\u0443\u0442 \u043d\u0430 1/3 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u04322 \u0443\u0437\u043a\u043e\u0433\u043e \u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u043a\u043d\u0430,\n(4\u20146 \u043c\u0435\u0441). \u0433\u0438\u043f\u0435\u0440\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438\u0437-\n\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0430\u044f \u0437\u0430 \u0433\u0435\u043d\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445\n\u0442\u0435\u0440\u0430\u043f\u0438\u044f (25 \u043c\u0433 \u0447\u0435\u0440\u0435\u0437 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0435\u0439 \u0438\u043b\u0438\n\u0434\u0435\u043d\u044c) \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438\n\u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438. \u0420\u0435\u0434\u043a\u043e\n\u043e\u0442 4 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0434\u043e 5\u20146 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f: \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c,\n\u043b\u0435\u0442 \u043f\u043e\u0442\u043b\u0438\u0432\u043e\u0441\u0442\u044c, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\u0442\u0440\u0430\u043d\u0441\u0430\u043c\u0438\u043d\u0430\u0437, \u0442\u044f\u0436\u0435\u043b\u0430\u044f\n\u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u044f \u0441 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439,\n\u043f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u0442.\n\u0426\u0438\u043a\u043b\u043e\u0444\u043e\u0441\u0444\u0430\u043c\u0438\u0434 100 \u043c\u0433/\u0434\u0435\u043d\u044c \u041e\u0442\u0432\u0435\u0442 \u043c\u0435\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0443 \u041f\u0440\u0438 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043b\u0435\u0447\u0435\u043d\u0438\u0438\n1/3 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0438\u043c\u0435\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439\n\u043c\u0443\u0442\u0430\u0433\u0435\u043d\u043d\u044b\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\n\n\u0426\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d \u0410 5 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 6 \u0434\u043d\u0435\u0439, \u0418\u043c\u0435\u044e\u0442\u0441\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430 \u0432\n\u0437\u0430\u0442\u0435\u043c \u0434\u043e 3 \u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435 \u043a\u0440\u043e\u0432\u0438,\n(\u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u0431 \u0433\u0438\u043f\u0435\u0440\u0442\u043e\u043d\u0438\u044f, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u0430\u044f\n\u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u0430 \u0432 \u043a\u0440\u043e\u0432\u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443 3\u20444 \u0443\u0442\u043e\u043c\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u044c, \u043f\u0430\u0440\u0435\u0441\u0442\u0435\u0437\u0438\u0438,\n\u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 200- \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0410\u0418\u0413\u0410 \u0441 \u0433\u0438\u043f\u0435\u0440\u043f\u043b\u0430\u0437\u0438\u044f \u0434\u0435\u0441\u0435\u043d,\n400\u043f\u0433/\u043c\u043b) \u0442\u0435\u043f\u043b\u043e\u0432\u044b\u043c\u0438 \u043c\u0438\u0430\u043b\u0433\u0438\u044f, \u0434\u0438\u0441\u043f\u0435\u043f\u0441\u0438\u044f,\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\u043c\u0438 \u0438 \u0433\u0438\u043f\u0435\u0440\u0442\u0440\u0438\u0445\u043e\u0437, \u0442\u0440\u0435\u043c\u043e\u0440\n\u0436\u0438\u0437\u043d\u0435\u0443\u0433\u0440\u043e\u0436\u0430\u044e\u0449\u0438\u043c,\n\u0440\u0435\u0444\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u043c\n\u0433\u0435\u043c\u043e\u043b\u0438\u0437\u043e\u043c 48\n\u041a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f\n\u0446\u0438\u043a\u043b\u043e\u0441\u043f\u043e\u0440\u0438\u043d\u0430,\n\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u0430 \u0438\n\u0434\u0430\u043d\u0430\u0437\u043e\u043b\u0430 \u0434\u0430\u043b\u0430 \u043f\u043e\u043b\u043d\u044b\u0439\n\u043e\u0442\u0432\u0435\u0442 \u0443 89% \u043f\u043e\n\u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 58%\n\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432,\n\u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u043d\u0430\n\u0442\u0435\u0440\u0430\u043f\u0438\u0438\n\u043f\u0440\u0435\u0434\u043d\u0438\u0437\u043e\u043b\u043e\u043d\u043e\u043c \u0438\n\u0434\u0430\u043d\u0430\u0437\u043e\u043b\u043e\u043c.\n\u041c\u0438\u043a\u043e\u0444\u0435\u043d\u043e\u043b\u0430\u0442\u0430 \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043e\u0437\u0430 500 \u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u0431\u043e\u043b\u0438 \u0432\n\u043c\u043e\u0444\u0435\u0442\u0438\u043b \u043c\u0433/\u0441\u0443\u0442 \u0441 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u043f\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044e \u0443 \u043f\u043e\u044f\u0441\u043d\u0438\u0446\u0435, \u0432\u0437\u0434\u0443\u0442\u0438\u0435 \u0436\u0438\u0432\u043e\u0442\u0430,\n\u0434\u043e 1000 \u043c\u0433/\u0441\u0443\u0442 \u043e\u0442 2 \u0434\u043e \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0430\u043d\u043e\u0440\u0435\u043a\u0441\u0438\u044f, \u0442\u043e\u0448\u043d\u043e\u0442\u0430\n13 \u043c\u0435\u0441 \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0439 \u0410\u0418\u0413\u0410 \u0441\n\u0442\u0435\u043f\u043b\u043e\u0432\u044b\u043c\u0438\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430\u043c\u0438. \u0411\u044b\u043b\n\u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d \u0432\n\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441\n\u0440\u0438\u0442\u0443\u043a\u0441\u0438\u043c\u0430\u0431\u043e\u043c \u0432\n\u0441\u043b\u0443\u0447\u0430\u0435 \u0440\u0435\u0444\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0439\n\n\u0410\u0418\u0413\u0410 \u043f\u043e\u0441\u043b\u0435 \u0422\u0413\u0421\u041a [7]\n\n13\n\n\u2212 \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043f\u0440\u0438 \u043d\u0435\u043e\u0442\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f\u0445:\n\n\u2022 \u043f\u0440\u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0438 \u043d\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0433\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043a\u0440\u0438\u0437\u0430 (\u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u0431\u043b\u0435\u0434\u043d\u043e\u0441\u0442\u044c,\n\u0436\u0435\u043b\u0442\u0443\u0448\u043d\u043e\u0441\u0442\u044c \u043a\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u043a\u0440\u043e\u0432\u043e\u0432, \u043f\u043e\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u0435 \u043c\u043e\u0447\u0438, \u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u0441\u0435\u0440\u0434\u0435\u0447\u043d\u043e-\n\u0441\u043e\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0430\u043d\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u043e\u043a, \u0430\u043d\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043e\u043c\u0430) \u2013 \u0432\u044b\u0437\u043e\u0432\n\u0431\u0440\u0438\u0433\u0430\u0434\u044b \u0421\u041c\u041f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 \u0432 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u044f\u0436\u0435\u0441\u0442\u0438\n\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f;\n\u2022 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e-\u0432\u0430\u0436\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439: \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0434\u044b\u0445\u0430\u043d\u0438\u044f, \u0447\u0430\u0441\u0442\u043e\u0442\u0430\n\u0438 \u0440\u0438\u0442\u043c\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u043f\u0443\u043b\u044c\u0441\u0430, 