435\u0434\u0435\u043b\u044c, \u0434\u0430\u043b\u0435\u0435 \u0424\u0435\u0431\u0440\u0438\u043b\u044c\u043d\u044b\u0435 \u0442\u0440\u0430\u043d\u0441\u0444\u0443\u0437\u0438\u043e\u043d\u043d\u044b\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 D\n\u0441\u0442\u0432\u043e\u043b\u043e\u0432\u044b\u0435 \u043a\u043b\u0435\u0442\u043a\u0438 [189, \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430 1 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 4\u0445\n190, 191, 192] \u043d\u0435\u0434\u0435\u043b\u044c\n\u0410\u043b\u0435\u043c\u0442\u0443\u0437\u0443\u043c\u0430\u0431 [193] \u0412/\u0432 \u0438\u043d\u0444\u0443\u0437\u0438\u044f, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 2\u0445 \u0447\u0430\u0441\u043e\u0432 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 1. \u041e\u0447\u0435\u043d\u044c \u0432\u044b\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0441\u043a \u0442\u044f\u0436\u0435\u043b\u044b\u0445 D\n3 \u043c\u0433. \u041f\u0440\u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u0443\u0442\u043e\u0447\u043d\u0430\u044f \u0434\u043e\u0437\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c\n\n93\n\n\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0434\u043e 10 \u043c\u0433. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0442\u0435\u0440\u0430\u043f\u0438\u0438 \u0432\u0438\u0440\u0443\u0441\u043d\u044b\u0445 \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0439 (\u0446\u0438\u0442\u043e\u043c\u0435\u0433\u0430\u043b\u043e\u0432\u0438\u0440\u0443\u0441,\n\u0438 \u043