0\u0435\u0440\u0430\u0441\u0447\u0435\u0442 \u0434\u043e\u0437 \u0442\u0430\u043a\u0436\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u043f\u0440\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0438\n\u043c\u0430\u0441\u0441\u044b \u0442\u0435\u043b\u0430 \u043d\u0430 10% \u0438 \u0431\u043e\u043b\u0435\u0435.\n\n\u0412\u0435\u043b\u0438\u0447\u0438\u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u0442\u0435\u043b\u0430 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c:\n\u041c2 = \u221a (\u0420\u041e\u0421\u0422 \u0432 \u0421\u041c \u0445 \u0412\u0415\u0421 \u0432 \u041a\u0413)/3600 \u0438\u043b\u0438\n\u041c2 = (4 \u0445 \u0432\u0435\u0441 + 7): (\u0432\u0435\u0441+90) (4, 7, 90 - \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u044b).\n\n\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u0445\u0435\u043c\u044b APT \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0410\u0420\u0412 - \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432\n\u0421\u043c\u0435\u043d\u0430 \u0410\u0420\u0412 - \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u043f\u0440\u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043d\u0435\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u043e\u0441\u0442\u0438:\n\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0422\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f \u0410\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442 (\u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u043e\u0441\u0442\u0438)\nAZT* \u0410\u043d\u0435\u043c\u0438\u044f, \u043d\u0435\u0439\u0442\u0440\u043e\u043f\u0435\u043d\u0438\u044f, \u0430\u0441\u0442\u0435\u043d\u0438\u044f, ABC, TDF\n\u0431\u0435\u0441\u0441\u043e\u043d\u043d\u0438\u0446\u0430, \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c, \u0442\u043e\u0448\u043d\u043e\u0442\u0430\n3\u0422\u0421 \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u043e\u043a\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u043d\u0435 \u0414\u0440\u0443\u0433\u0438\u0435 \u041d\u0418\u041e\u0422\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u044b\nTDF* \u041d\u0435\u0444\u0440\u043e\u043f\u0430\u0442\u0438\u044f, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u043c\u0438\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 ABC, AZT,\n\u043a\u043e\u0441\u0442\u0435\u0439\nABC \u0420\u0435\u0430\u043a\u0446\u0438\u044f \u0433\u0438\u043f\u0435\u0440\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 TDF, AZT\nEFV \u041d\u0435\u0439\u0440\u043e\u043f\u0441\u0438\u0445\u0438-\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f (\u0432 \u0442\u043e\u043c ETV, RPV, DTG\n\u0447\u0438\u0441\u043b\u0435 \u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f, \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0441\u043d\u0430,\n\u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c)\nETV \u0421\u044b\u043f\u044c RPV, DTG, \u0418\u041f\nRPV* \u0421\u044b\u043f\u044c; \u0433\u0435\u043f\u0430\u0442\u0438\u0442; \u0414\u0435\u043f\u0440\u0435\u0441\u044