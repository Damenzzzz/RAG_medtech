# Copy this file to .env and fill real keys.

ALEM_API_KEY=
EMBED_API_KEY=
RERANK_API_KEY=

# Optional final OpenAI/GPT layer. If unavailable, set OPENAI_FINAL_MODEL to an
# OpenAI-compatible model you can access, or configure the server to use Alem.
OPENAI_API_KEY=
OPENAI_FINAL_MODEL=gpt-5
OPENAI_REASONING_EFFORT=low

ALEM_BASE_URL=https://llm.alem.ai/v1
EMBED_MODEL=text-1024
RERANK_BASE_URL=https://llm.alem.ai/v1/rerank
RERANK_MODEL=reranker

BASIC_RAG_GLOBAL_TIMEOUT_SECONDS=180
BASIC_RAG_WORKERS=8
BASIC_RAG_DEMO_FAST_CACHE=1
BASIC_RAG_FINAL_MAX_TOKENS=5000
FINAL_ALLOW_OUT_OF_RAG=1
