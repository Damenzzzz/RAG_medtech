442 \u043c\u0435\u0442\u043e\u0434, \u043e\u0434\u043d\u0430\u043a\u043e \u0432 \u043b\u044e\u0431\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u0446\u0435 \u043a\u0440\u043e\u0432\u0438 \u0438\u043b\u0438\n\u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u043b\u0435\u0442\u043e\u043a\n\n\u0441\u0430\u043c\u043e\u0433\u043e \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u043b\u0435\u0442\u043a\u0438 \u044d\u043f\u0438\u0442\u0435\u043b\u0438\u044f), \u0447\u0442\u043e \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u044f\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044e\n\u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0431\u0435\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u043c\u0430\u0440\u043a\u0435\u0440\u043e\u0432 \u041c\u041e\u0411.\n\n3. \u041e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u044b \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430:\n\n1) \u0421\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430\n1. \u041a\u0435\u043c\u0430\u0439\u043a\u0438\u043d \u0412\u0430\u0434\u0438\u043c \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447, \u0422\u041e\u041e \"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440\" \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, \u0410\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439\n\u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440, \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0426\u0435\u043d\u0442\u0440\u0430\n\n\u043e\u043d\u043a\u043e\u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n2. \u041a\u043e\u043b\u0435\u0441\u043d\u0435\u0432 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0412\u0430\u043b\u0435\u0440\u044c\u0435\u0432\u0438\u0447, \u0422\u041e\u041e \"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440\" \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u0417\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n3. \u0416\u04af\u043d\u0456\u0441 \u0413\u04af\u043b\u0436\u0430\u043d\u0430\u0442 \u049a\u0443\u0430\u043d\u044b\u0448\u049b\u044b\u0437\u044b, \u0422\u041e\u041e \"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0443\u0447\u043d\u044b\u0439\n\n\u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0446\u0435\u043d\u0442\u0440\" \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u043f\u0435\u0440\u0432\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f\n\u0442\u0440\u0430\u043d\u0441\u043f\u043b\u0430\u043d\u0442\u0430\u0446\u0438\u0438 \u043a\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043c\u043e\u0437\u0433\u0430.\n4. \u041c\u0430\u043a\u0430\u043b\u043a\u0438\u043d\u0430 \u041b\u0430\u0440\u0438\u0441\u0430 \u0413\u0435\u043d\u043d\u0430\u0434\u0438\u0435\u0432\u043d\u0430, \u041d\u0410\u041e \"\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\"\n\u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0445 \u043d\u0430\u0443\u043a, PhD, MD, \u0434\u043e\u0446\u0435\u043d\u0442 \u043a\u0430\u0444\u0435\u0434\u0440\u044b \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\n\u0444\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u041d\u0410\u041e \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0410\u0441\u0442\u0430\u043d\u0430\u00bb.\n5. \u0413\u0430\u0431\u0431\u0430\u0441\u043e\u0432\u0430 \u0421\u0430\u0443\u043b\u0435 \u0422\u043b\u0435\u043c\u0431\u0430\u0435\u0432\u043d\u0430, \u0420\u0413\u041f \u043d\u0430 \u041f\u0425\u0412 \u00ab\u041a\u0430\u0437\u0430\u0445\u0441\u043a\u0438\u0439 \u043d\u0430\u0443\u0447\u043d\u043e-\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u043e\u043d\u043a\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0440\u0430\u0434\u0438\u043e\u043b\u043e\u0433\u0438\u0438\u00bb \u0432\u0440\u0430\u0447 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433 \u0432\u044b\u0441\u0448\u0435\u0439\n\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438, \u043c\u0430\u0433\u0438\u0441\u0442\u0440 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f, \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c \u0446\u0435\u043d\u0442\u0440\u0430", "type": "Document"}}