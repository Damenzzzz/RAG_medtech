42\u0432\u0435\u0442 \u043d\u0430 \u0431\u043e\u043b\u0435\u0432\u043e\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435 3\n(\u0434\u0435\u043a\u043e\u0440\u0442\u0438\u043a\u0430\u0446\u0438\u044f)\n\n\u041f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u043d\u0438\u0435 \u0432 \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0431\u043e\u043b\u0435\u0432\u043e\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435 2\n(\u0434\u0435\u0446\u0435\u0440\u0435\u0431\u0440\u0430\u0446\u0438\u044f)\n\n\u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439 1\n\n\u0418\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f:\n15 \u0431\u0430\u043b\u043b\u043e\u0432 \u2014 \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u0435 \u044f\u0441\u043d\u043e\u0435;\n10\u201414 \u0431\u0430\u043b\u043b\u043e\u0432 \u2014 \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u043e\u0435 \u0438 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u043e\u0433\u043b\u0443\u0448\u0435\u043d\u0438\u0435;\n9\u201410 \u0431\u0430\u043b\u043b\u043e\u0432 \u2014 \u0441\u043e\u043f\u043e\u0440;\n7\u20148 \u0431\u0430\u043b\u043b\u043e\u0432 \u2014 \u043a\u043e\u043c\u0430 1;\n5\u20146 \u0431\u0430\u043b\u043b\u043e\u0432 \u2014 \u043a\u043e\u043c\u0430 2;\n3 \u2013 4 \u0431\u0430\u043b\u043b\u0430 \u2014 \u043a\u043e\u043c\u0430 3.\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 2\n\n\u0410\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0448\u043a\u0430\u043b\u0430 mRS [21]\n\n\u0428\u043a\u0430\u043b\u0430 \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439\n0 \u041d\u0435\u0442 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 -\n1 \u041d\u0435\u0438\u043d\u0432\u0430\u043b\u0438\u0434\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0441\u0438\u043c\u043f\u0442\u043e\u043c, \u043d\u0435 \u041f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438\u0433\u0440\u044b/\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f\n\u043f\u0440\u0435\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435\n\u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438\u0433\u0440\u044b/\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0443 \u0440\u0435\u0431\u0435\u043d\u043a\u0430 \u0434\u0435\u0442\u0441\u0430\u0434\u0430 \u0438\u043b\u0438 \u0448\u043a\u043e\u043b\u044b\n2 \u041d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0438\u043c\u043f\u0442\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u0411\u0430\u0437\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u043f\u0440\u0438\u0435\u043c\n\u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u043f\u0438\u0449\u0438,\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438\u0433\u0440\u044b/\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0443 \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435, \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u043d\u0438\u0435,\n\u0440\u0435\u0431\u0435\u043d\u043a\u0430, \u043d\u043e \u043d\u0435 \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0440\u0430\u0441\u0447\u0435\u0441\u044b\u0432\u0430\u043d\u0438\u0435, \u0443\u043c\u044b\u0432\u0430\u043d\u0438\u0435,\n\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443 \u0431\u0430\u0437\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043a\u0443\u043f\u0430\u043d\u0438\u0435.\n3 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0411\u0430\u0437\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u043f\u0440\u0438\u0435\u043c\n\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u044e\u0442 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u043f\u0438\u0449\u0438,\n\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438\u0433\u0440\u044b/\u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435, \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u043d\u0438\u0435,\n\u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u043f\u043e\u043b\u043d\u043e\u0439 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0432 \u0440\u0430\u0441\u0447\u0435\u0441\u044b\u0432\u0430\u043d\u0438\u0435, \u0443\u043c\u044b\u0432\u0430\u043d\u0438\u0435,\n\u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443 \u0431\u0430\u0437\u043e\u0432\u044b\u043c \u043a\u0443\u043f\u0430\u043d\u0438\u0435.\n\u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445\n4 \u0423\u043c\u0435\u0440\u0435\u043d\u043d\u043e-\u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u044f\u0432\u043d\u043e \u0411\u0430\u0437\u043e\u0432\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438: \u043f\u0440\u0438\u0435\u043c\n\u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0432 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0432 \u0431\u0430\u0437\u043e\u0432\u044b\u0445 \u0436\u0438\u0434\u043a\u043e\u0441\u0442\u0438 \u0438 \u043f\u0438\u0449\u0438,\n\u0444\u0443\u043d\u043a\u0446\u0438\u044f\u0445 c\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443, \u0445\u043e\u0442\u044f \u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435, \u0440\u0430\u0437\u0434\u0435\u0432\u0430\u043d\u0438\u0435,\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442 \u043d\u0435 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u043c \u0440\u0430\u0441\u0447\u0435\u0441\u044b\u0432\u0430\u043d\u0438\u0435, \u0443\u043c\u044b\u0432\u0430\u043d\u0438\u0435,\n\u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438 \u043a\u0443\u043f\u0430\u043d\u0438\u0435.\n5 \u0422\u044f\u0436\u0435\u043b\u0430\u044f \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u0438\u0437\u0430\u0446\u0438\u044f, \u043f\u043e\u043b\u043d\u0430\u044f \u0412 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043a\u0440\u043e\u0432\u0430\u0442\u0438: \u043c\u043e\u0433\u0443\u0442\n\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u043c \u0431\u044b\u0442\u044c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u0441\u043e\u0437\u043d\u0430\u043d\u0438\u044f,\n\n\u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438 \u0430\u0436\u0438\u0442\u0430\u0446\u0438\u044f, \u0434\u0438\u0437\u0430\u0432\u0442\u043e\u043d\u043e\u043c\u0438\u044f,\n\u0442\u044f\u0436\u0435\u043b\u044b\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\n6 \u0421\u043c\u0435\u0440\u0442\u044c\n\n\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 3\n\n\u0410\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c (>70%) \u0430\u0441\u0441\u043e\u0446\u0438\u0430\u0446\u0438\u0438 \u0441 \u043e\u043f\u0443\u0445\u043e\u043b\u044c\u044e\n(\u043a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u043d\u043a\u043e\u043d\u0435\u0432\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430) [26].\n\n\u0410\u043d\u0442\u0438\u0442\u0435\u043b\u043e \u041d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u0435\u043d\u043e\u0442\u0438\u043f \u041e\u043f\u0443\u0445\u043e\u043b\u044c\n(\u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u043e\u0435\n\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435)\nHu (ANNA-1) \uf0fc \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u044f; \u041c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0438\n\uf0fc \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043d\u0435\u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e,\n\u0433\u0430\u0441\u0442\u0440\u043e\u0438\u043d\u0442\u0435\u0441\u0442\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u044d\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u043d\u044b\u0435 \u043e\u043f\u0443\u0445\u043e\u043b\u0438,\n\u043f\u0441\u0435\u0432\u0434\u043e\u043e\u0431\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f; \u043d\u0435\u0439\u0440\u043e\u0431\u043b\u0430\u0441\u0442\u043e\u043c\u0430.\n\uf0fc \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043c\u0438\u0435\u043b\u0438\u0442; \u0423 \u0434\u0435\u0442\u0435\u0439 \u043e\u0431\u044b\u0447\u043d\u043e \u043b\u0438\u043c\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0439\n\uf0fc \u043b\u0438\u043c\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442. \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442 \u043d\u0435\u043f\u0430\u0440\u0430\u043d\u0435\u043e\u043f\u043b\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439.\nCRMP5 (CV2) \uf0fc \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043c\u0438\u0435\u043b\u0438\u0442; \u0422\u0438\u043c\u043e\u043c\u0430 \u0438 \u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a\n\uf0fc \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u044f. \u043b\u0435\u0433\u043a\u043e\u0433\u043e.\n\u041f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0442\u0438\u043c\u043e\u043c\u043e\u0439 \u043c\u043e\u043b\u043e\u0434\u043e\u0433\u043e\n\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0447\u0430\u0441\u0442\u043e\n\n\u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u0442\u0441\u044f \u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0433\u0440\u0430\u0432\u0438\u0441,\n\u0447\u0435\u043c \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u044f.\nSOX1 \uf0fc \u043c\u0438\u0430\u0441\u0442\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u041c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e.\n\u041b\u0430\u043c\u0431\u0435\u0440\u0442\u0430-\u0418\u0442\u043e\u043d\u0430; \u0421\u0438\u043b\u044c\u043d\u0435\u0435 \u043a\u043e\u0440\u0440\u0435\u043b\u044f\u0446\u0438\u044f \u0441\n\uf0fc \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0437\u0436\u0435\u0447\u043a\u0430. \u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u043c \u0440\u0430\u043a\u043e\u043c \u043b\u0435\u0433\u043a\u043e\u0433\u043e,\n\u0447\u0435\u043c \u0441 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438.\nPCA2 ( MAP1B) \uf0fc \u0441\u0435\u043d\u0441\u043e\u043c\u043e\u0442\u043e\u0440\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u044f; \u041c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0438\n\uf0fc \u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0430\u044f \u043d\u0435\u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e,\n\u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u0430\u044f \u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f; \u0440\u0430\u043a \u043c\u043e\u043b\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b.\n\uf0fc \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043c\u0438\u0435\u043b\u0438\u0442.\n\u0410\u043c\u0444\u0438\u0444\u0438\u0437\u0438\u043d \uf0fc \u043f\u043e\u043b\u0438\u0440\u0430\u0434\u0438\u043a\u0443\u043b\u043e\u043f\u0430\u0442\u0438\u044f; \u041c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e, \u0440\u0430\u043a\n\uf0fc \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0430\u044f \u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u044f; \u043c\u043e\u043b\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b.\n\uf0fc \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043c\u0438\u0435\u043b\u0438\u0442;\n\n\uf0fc \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0441\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e\n\u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.\nRi (ANNA-2) \uf0fc \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c; \u0420\u0430\u043a \u043c\u043e\u043b\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b (\u0436\u0435\u043d\u0449\u0438\u043d\u044b),\n\uf0fc \u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c; \u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0438\n\uf0fc \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u043e\u043f\u0441\u043e\u043a\u043b\u043e\u043d\u0443\u0441- \u043d\u0435\u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e\n\u043c\u0438\u043e\u043a\u043b\u043e\u043d\u0443\u0441. (\u043c\u0443\u0436\u0447\u0438\u043d\u044b).\nYo ( PCA-1) \uf0fc \u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u041e\u0431\u044b\u0447\u043d\u043e \u0443 \u0436\u0435\u043d\u0449\u0438\u043d: \u0440\u0430\u043a \u044f\u0438\u0447\u043d\u0438\u043a\u043e\u0432,\n\u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c \u0440\u0430\u043a \u043c\u043e\u043b\u043e\u0447\u043d\u043e\u0439 \u0436\u0435\u043b\u0435\u0437\u044b.\nMa2 (Ma) \uf0fc \u043b\u0438\u043c\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442; \u041c\u043e\u043b\u043e\u0434\u044b\u0435 \u043c\u0443\u0436\u0447\u0438\u043d\u044b - \u0440\u0430\u043a \u044f\u0438\u0447\u0435\u043a,\n\uf0fc \u0434\u0438\u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442; \u043f\u043e\u0436\u0438\u043b\u044b\u0435 \u043c\u0443\u0436\u0447\u0438\u043d\u044b \u2013\n\uf0fc \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u043e\u0439 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u0438\u0442. \u043c\u0435\u043b\u043a\u043e\u043a\u043b\u0435\u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0430\u043a \u043b\u0435\u0433\u043a\u043e\u0433\u043e.\nTr (DNER) \uf0fc \u0431\u044b\u0441\u0442\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u041b\u0438\u043c\u0444\u043e\u043c\u0430 \u0425\u043e\u0434\u0436\u043a\u0438\u043d\u0430\n\u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\n\nKLHL11 \uf0fc \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c; \u041c\u043e\u043b\u043e\u0434\u044b\u0435 \u043c\u0443\u0436\u0447\u0438\u043d\u044b \u2013 \u0440\u0430\u043a \u044f\u0438\u0447\u0435\u043a.\n\uf0fc \u043c\u043e\u0437\u0436\u0435\u0447\u043a\u043e\u0432\u044b\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c.", "type": "Document"}}