35\u043f\u0430\u0442\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0438\n\u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0438\u0445 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f.\n\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u0434\u0438\u0438 \u041a\u0430\u0436\u0434\u044b\u0435 12 \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043a\u043e\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439\n\u0444\u0438\u0431\u0440\u043e\u0437\u0430 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0412\u0413\u0421 \u0438/\u0438\u043b\u0438 \u0412\u0413\u0412 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440,\n\u043f\u0435\u0447\u0435\u043d\u0438 \u0424\u0438\u0431\u0440\u043e\u0421\u043a\u0430\u043d, \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u044b\u0435\n\n\u043c\u0430\u0440\u043a\u0435\u0440\u044b \u0444\u0438\u0431\u0440\u043e\u0437\u0430)\n\u0423\u0417\u0418 \u043f\u0435\u0447\u0435\u043d\u0438 \u041a\u0430\u0436\u0434\u044b\u0435 6 \u0423 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u0446\u0438\u0440\u0440\u043e\u0437\u043e\u043c \u043f\u0435\u0447\u0435\u043d\u0438\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441 \u043a\u043e\u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0435\u0439\n\u0412\u0413\u0412 \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c\n\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0413\u0426\u041a(xiii)\n\u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u041e\u0446\u0435\u043d\u043a\u0430 \u0440\u0438\u0441\u043a\u0430(vi) + + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u0411\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\n\u043f\u043e\u0447\u0435\u043a \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u0445 \u0440\u0438\u0441\u043a\u0430 \u0425\u0417\u041f(vi) \u0438/\u0438\u043b\u0438\n\u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435\u043c \u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f\n\u043f\u0440\u0438\u0435\u043c\u0430 \u043d\u0435\u0444\u0440\u043e\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0445\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432(ix)\n\n\u043e\u0421\u041a\u0424 (CKD-EPI)(vii) + + \u041a\u0430\u0436\u0434\u044b\u0435 3-6\n\u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u041f\u043e\u043b\u043e\u0441\u043a\u043e\u0432\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 + + \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u041a\u0430\u0436\u0434\u044b\u0435 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u0435\u0441\u043b\u0438 \u043e\u0421\u041a\u0424\n\u043c\u043e\u0447\u0438(viii) <60 \u043c\u043b/\u043c\u0438\u043d \u0438\u043b\u0438 \u043f\u0440\u0438 \u0440\u0435\u0437\u043a\u043e\u043c\n\u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0438 \u043e\u0421\u041a\u0424(xiv). \u0415\u0441\u043b\u0438\n\u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u044f \u22651+ \u0438/\u0438\u043b\u0438 \u043e\u0421\u041a\u0424\n<60 \u043c\u043b/\u043c\u0438\u043d, \u0438\u0437\u043c\u0435\u0440\u0438\u0442\u044c \u0411\u041c/\u041a \u0438\u043b\u0438\n\u0410\u041c/\u041a(viii)\n\u0417\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u0411\u0438\u043e\u0445\u0438\u043c\u0438\u044f \u043a\u0440\u043e\u0432\u0438 \u043d\u0430 + + \u041a\u0430\u0436\u0434\u044b\u0435 6-12\n\u043a\u043e\u0441\u0442\u0435\u0439 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u0439 \u043a\u043e\u0441\u0442\u0435\u0439:\n\u043a\u0430\u043b\u044c\u0446\u0438\u0439, \u0444\u043e\u0441\u0444\u0430\u0442\u044b\n(PO4), \u0449\u0435\u043b\u043e\u0447\u043d\u0430\u044f\n\n\u0444\u043e\u0441\u0444\u0430\u0442\u0430\u0437\u0430\n\u041e\u0446\u0435\u043d\u043a\u0430 \u0440\u0438\u0441\u043a\u0430(X) + + \u0420\u0430\u0437 \u0432 2 \u0433\u043e\u0434\u0430 \u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441 \u043e\n\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0438 DXA \u0434\u043b\u044f\n(FRAX\u00ae(XI) \u0434\u043b\u044f\n\u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432.\n\u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0441\u0442\u0430\u0440\u0448\u0435 40\n\u043b\u0435\u0442)\n\u0412\u0438\u0442\u0430\u043c\u0438\u043d D 25(OH) \u0432\u0438\u0442\u0430\u043c\u0438\u043d D + \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c\n\u041d\u0435\u0439\u0440\u043e\u043a\u043e\u0433\u043d \u041e\u043f\u0440\u043e\u0441\u043d\u0438\u043a \u0434\u043b\u044f + + \u0420\u0430\u0437 \u0432 2 \u0433\u043e\u0434\u0430 \u0421\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u0432\u0441\u0435\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u0431\u0435\u0437\n\u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433\u0430\n\u0438\u0442\u0438\u0432\u043d\u044b\u0435 \u043e\u0442\u044f\u0433\u043e\u0449\u0430\u044e\u0449\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432. \u0412\n\u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0441\u043b\u0443\u0447\u0430\u0435 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0438\n\u0438\u043b\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432, \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043a\n\u043f\u0441\u0438\u0445\u043e\u0442\u0435\u0440\u0430\u043f\u0435\u0432\u0442\u0443 \u0434\u043b\u044f\n\u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f.\n\u0414\u0435\u043f\u0440\u0435\u0441\u0441\u0438\u044f \u041e\u043f\u0440\u043e\u0441\u043d\u0438\u043a + + \u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u041f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0441\u043a\u0440\u0438\u043d\u0438\u043d\u0433 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432\n\u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u0440\u0438\u0441\u043a\u043e\u043c\n\u0420\u0430\u043a \u041c\u0430\u043c\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0420\u0430\u0437 \u0432 1-3 \u0433\u043e\u0434\u0430 \u0416\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 50-70 \u043b\u0435\u0442\n\u041f\u0410\u041f-\u043c\u0430\u0437\u043e\u043a \u0420\u0430\u0437 \u0432 1-3 \u0433\u043e\u0434\u0430 \u0412\u0418\u0427-\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0436\u0435\u043d\u0449\u0438\u043d\u044b\n\u0441\u0442\u0430\u0440\u0448\u0435 21 \u0433\u043e\u0434\u0430 \u0438\u043b\u0438 \u0432\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 1 \u0433\u043e\u0434\u0430 \u043f\u043e\u0441\u043b\u0435 \u043d\u0430\u0447\u0430\u043b\u0430\n\u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0436\u0438\u0437\u043d\u0438\n\u0420\u0435\u043a\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0420\u0430\u0437 \u0432 1-3 \u0433\u043e\u0434\u0430 \u041c\u0421\u041c \u0438 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0434\u0438\u0441\u043f\u043b\u0430\u0437\u0438\u0435\u0439,\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0441