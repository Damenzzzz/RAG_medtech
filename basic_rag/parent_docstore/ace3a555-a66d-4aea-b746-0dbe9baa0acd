\u0441\u043a\u043e\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043e 3 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438,\n\u0434\u043e 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\n\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043b\u0435\u043a\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u043c\u0435\u043d\u0435\u0435 100% \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438\n\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f):\n\u0424\u0430\u0440\u043c\u0430\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0435 \u0421\u043f\u043e\u0441\u043e\u0431 \u0423\u0440\u043e\u0432\u0435\u043d\u044c\n\u0433\u0440\u0443\u043f\u043f\u0430 \u043d\u0435\u043f\u0430\u0442\u0435\u043d\u0442\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\n\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u041b\u0421\n\n\u041d\u0435\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u043d\u044b\u0435 \u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u043d\u0430\u0442\u0440\u0438\u044f 75-100 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c \u0421\n\u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0432\u043e\u0441\u043f\u043e\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 1 \u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 7-\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b 10 \u0434\u043d\u0435\u0439\n\u0414\u0438\u043a\u043b\u043e\u0444\u0435\u043d\u0430\u043a \u043d\u0430\u0442\u0440\u0438\u044f 75 \u043c\u0433 \u0432/\u043c 1 \u0440\u0430\u0437 \u0432 \u0421\n\u0441\u0443\u0442\u043a\u0438 10 \u0434\u043d\u0435\u0439\n\u041c\u0435\u043b\u043e\u043a\u0441\u0438\u043a\u0430\u043c 15 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c 1 \u0421\n\u0440\u0430\u0437 \u0432 \u0441\u0443\u0442\u043a\u0438 7-10\n\u0434\u043d\u0435\u0439\n\n\u0426\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u041c\u0435\u0442\u043e\u0442\u0440\u0438\u043a\u0441\u0430\u0442 15 \u043c\u0433 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e, \u0421\n\u0430\u043d\u0442\u0438\u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0442\u044b \u043f\u043e\u0434\u043a\u043e\u0436\u043d\u043e,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0418\u043c\u043c\u0443\u043d\u043e\u0434\u0435\u043f\u0440\u0435\u0441\u0441\u0430\u043d\u0442\u044b \u0410\u0437\u0430\u0442\u0438\u043e\u043f\u0440\u0438\u043d* 50-200 \u043c\u0433 \u0432 \u0421\n\u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0410\u043d\u0442\u0438\u043f\u0440\u043e\u043b\u0438\u0444\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435, \u041b\u0435\u0444\u043b\u0443\u043d\u0430\u043c\u0438\u0434 20 \u043c\u0433 \u0432 \u0441\u0443\u0442\u043a\u0438 \u0421\n\u0438\u043c\u043c\u0443\u043d\u043e\u0441\u0443\u043f\u0440\u0435\u0441\u0438\u0432\u043d\u044b\u0435 \u0432\u043d\u0443\u0442\u0440\u044c,\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0421\u0443\u043b\u044c\u0444\u0430\u043d\u0438\u043b\u0430\u043c\u0438\u0434\u043d\u044b\u0435 \u0421\u0443\u043b\u044c\u0444\u0430\u0441\u0430\u043b\u0430\u0437\u0438\u043d 500-3000 \u043c\u0433 \u0432 \u0421\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0441\u0443\u0442\u043a\u0438, \u0432\u043d\u0443\u0442\u0440\u044c,\n\u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u0412\u0430\u0437\u043e\u0434\u0438\u043b\u044f\u0442\u0438\u0440\u0443\u044e\u0449\u0438\u0435, \u0414\u0438\u043f\u0438\u0440\u0438\u0434\u0430\u043c\u043e\u043b 25 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c 3 \u0421\n\u0430\u043d\u0433\u0438\u043e\u043f\u0440\u043e\u0442\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043a\u0438, 1\n\n\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\n\u0418\u043d\u0433\u0438\u0431\u0438\u0442\u043e\u0440\u044b \u041d+-\u041a+- \u041e\u043c\u0435\u043f\u0440\u0430\u0437\u043e\u043b 20 \u043c\u0433 \u0432\u043d\u0443\u0442\u0440\u044c, 2 \u0421\n\u0410\u0422\u0424-\u0430\u0437\u044b. \u043d\u0435\u0434\u0435\u043b\u0438\n\u0424\u0435\u0440\u043c\u0435\u043d\u0442\u043d\u044b\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u041f\u0430\u043d\u043a\u0440\u0435\u0430\u0442\u0438\u043d 150000-400000 \u0421\n\u0415\u0414 \u0432 \u0441\u0443\u0442\u043a\u0438\n2-4 \u043d\u0435\u0434\u0435\u043b\u0438\n\u0413\u0435\u043f\u0430\u0442\u043e\u043f\u0440\u043e\u0442\u0435\u043a\u0442\u043e\u0440\u044b \u0423\u0440\u0441\u043e\u0434\u0435\u0437\u043e\u043a\u0441\u0438\u0445\u043e\u043b\u0435\u0432\u0430\u044f 10\u043c\u0433/\u043a\u0433/\u0441\u0443\u0442 \u0421\n\u043a\u0438\u0441\u043b\u043e\u0442\u0430 \u0432\u043d\u0443\u0442\u0440\u044c,\n\u0434\u043e 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432\n\u041f\u0440\u043e\u0442\u0438\u0432\u043e\u043c\u0438\u043a\u0440\u043e\u0431\u043d\u044b\u0435 \u0424\u043b\u0443\u043a\u043e\u043d\u0430\u0437\u043e\u043b 50-100 \u043c\u0433 \u0432 D\n\u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u0441\u0443\u0442\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u044c, 2\n\u043d\u0435\u0434\u0435\u043b\u0438\n\u041f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b \u043a\u0430\u043b\u044c\u0446\u0438\u044f, \u041a\u0430\u043b\u044c\u0446\u0438\u044f \u043a\u0430\u0440\u0431\u043e\u043d\u0430\u0442 1 \u0442\u0430\u0431 \u0432 \u0434\u0435\u043d\u044c \u0421\n\n\u0432\u0438\u0442\u0430\u043c\u0438\u043d\u0430 D3 2500\u043c\u0433, \u0432\u043d\u0443\u0442\u0440\u044c,\n\u0425\u043e\u043b\u0435\u043a\u0430\u043b\u044c\u0446\u0438\u0444\u0435\u0440\u043e\u043b 800 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\n\u041c\u0415\n*\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u0420\u041a\n\n3.3 \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0432\u043c\u0435\u0448\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043d\u0435\u0442.\n\n3.4 \u0414\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0435 \u0432\u0435\u0434\u0435\u043d\u0438\u0435: \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u044b \u0441 \u0411\u0428 \u0434\u043e\u043b\u0436\u043d\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043f\u043e\u0434 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c\n\n\u0434\u0438\u0441\u043f\u0430\u043d\u0441\u0435\u0440\u043d\u044b\u043c \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u043c \u0440\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430, \u0441\u0442\u043e\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0430, \u043e\u0444\u0442\u0430\u043b\u044c\u043c\u043e\u043b\u043e\u0433\u0430. \u041e\u0441\u043c\u043e\u0442\u0440\u044b\n\u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0435 \u0440\u0435\u0436\u0435 1 \u0440\u0430\u0437\u0430 \u0432 3 \u043c\u0435\u0441\u044f\u0446\u0430. \u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0439 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 (\u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435\n\u0438 \u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438) \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u044e\u0442\u0441\u044f 1 \u0440\u0430\u0437 \u0432 3 \u043c\u0435\u0441\u044f\u0446\u0430. \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\n\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0431\u0449\u0435\u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e, \u0431\u0438\u043e\u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u0432 \u043a\u0440\u043e\u0432\u0438 \u0443 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432,\n\n\u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0449\u0438\u0445 \u0446\u0438\u0442\u043e\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u044b, \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f 1 \u0440\u0430\u0437 \u0432\n\u043c\u0435\u0441\u044f\u0446, \u0437\u0430\u0442\u0435\u043c 1 \u0440\u0430\u0437 \u0432 2 \u043c\u0435\u0441\u044f\u0446\u0430.\n\n3.5 \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u2022 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u043a\u043b\u0438\u043d\u0438\u043a\u043e-\u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0440\u0435\u043c\u0438\u0441\u0441\u0438\u0438;\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043e\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0439.\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 [1-4,11]:\n\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u043e\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0441\u043b\u044e\u043d\u043d\u044b\u0445/\u0441\u043b\u0451\u0437\u043d\u044b\u0445 \u0436\u0435\u043b\u0451\u0437, \u043e\u0431\u043e\u0441\u0442\u0440\u0435\u043d\u0438\u0435 \u0445\u0440\u043e\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e\n\u0441\u0438\u0430\u043b\u0430\u0434\u0435\u043d\u0438\u0442\u0430;\n\n\u2022 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043b\u0438\u043c\u0444\u0430\u0434\u0435\u043d\u043e\u043f\u0430\u0442\u0438\u044f, \u0433\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f, \u0444\u043e\u043a\u0443\u0441\u044b \u043b\u0438\u043c\u0444\u043e\u0438\u0434\u043d\u043e\u0439\n\u0438\u043d\u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u0438 \u0432 \u043b\u0451\u0433\u043a\u0438\u0445;\n\u2022 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430;\n\u2022 \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0430\u0441\u043a\u0443\u043b\u0438\u0442\u0430, \u043f\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438 \u043a\u0440\u0430\u043d\u0438\u0430\u043b\u044c\u043d\u043e\u0439\n\n\u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u0438\u0438, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432 \u044d\u043d\u0446\u0435\u0444\u0430\u043b\u043e\u043c\u0438\u0435\u043b\u043e\u043f\u043e\u043b\u0438\u0440\u0430\u0434\u0438\u043a\u0443\u043b\u043e\u043d\u0435\u0439\u0440\u043e\u043f\u0430\u0442\u0438\u0438,\n\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043f\u043e\u0447\u0435\u043a, \u043b\u0435\u0433\u043a\u0438\u0445;\n\u2022 \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0430\u044f \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u0443\u0440\u0438\u044f (>0,5 \u0433/\u0441\u0443\u0442), \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f \u043c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f\n\u043a\u0440\u0438\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u0435\u043c\u0438\u044f, \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u043d\u043e\u043a\u043b\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u043c\u043c\u0443\u043d\u043e\u0433\u043b\u043e\u0431\u0443\u043b\u0438\u043d\u043e\u0432 \u0432 \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0435\n\n\u043a\u0440\u043e\u0432\u0438 \u0438 \u0438\u0445 \u043b\u0451\u0433\u043a\u0438\u0445 \u0446\u0435\u043f\u0435\u0439 \u0432 \u043c\u043e\u0447\u0435, \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u04214;\n\u2022 \u0433\u0435\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f: \u0430\u043d\u0435\u043c\u0438\u044f (\u0433\u0435\u043c\u043e\u0433\u043b\u043e\u0431\u0438\u043d <80 \u0433/\u043b), \u043b\u0435\u0439\u043a\u043e\u043f\u0435\u043d\u0438\u044f\n<2,0 \u0442\u044b\u0441./\u043c\u043a\u043b, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f <100 \u0442\u044b\u0441./\u043c\u043a\u043b;\n\n\u2022 \u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u043e-\u043a\u0438\u0448\u0435\u0447\u043d\u0430\u044f \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0430 (\u0441\u0442\u043e\u0439\u043a\u0438\u0435 \u0433\u0430\u0441\u0442\u0440\u0430\u043b\u0433\u0438\u0438, \u043e\u0442\u0440\u044b\u0436\u043a\u0430, \u0440\u0432\u043e\u0442\u0430);\n\u2022 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0443\u043b\u044c\u0441-\u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0438\u043d\u0444\u0443\u0437\u0438\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u043e\u0432 \u0433\u0435\u043d\u043d\u043e-\u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u043e\u0439 \u0442\u0435\u0440\u0430\u043f\u0438\u0438.\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438:\n\u2022 \u0422\u044f\u0436\u0435\u043b\u044b\u0435 \u0436\u0435\u043b\u0435\u0437\u0438\u0441\u0442\u044b\u0435 \u0438 \u0432\u043d\u0435\u0436\u0435\u043b\u0435\u0437\u0438\u0441\u0442\u044b\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0428\u0451\u0433\u0440\u0435\u043d\u0430.\n\n5. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0421\u0422\u0410\u0426\u0418\u041e\u041d\u0410\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [1-4, 11]:\n\n5.1 \u041a\u0430\u0440\u0442\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u0430:\n\n\u0420\u0435\u0441\u043f \u0443\u0431\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u0438 \u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435/\n\n\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f:\n\u0420\u0435\u0432\u043c\u0430\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 - \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438,\n\u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u044f: - \u043f\u043e\u043b\u0438\u043e\u0440\u0433\u0430\u043d\u043d\u0430\u044f\n- \u0443\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f/ \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c,\n\u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, - \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\n\u041e\u0431\u043b\u0430\u0441 \u0442\u043d\u044b\u0435 \u0438 - \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f \u0442\u0435\u0440\u0430\u043f\u0438\u0438, \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u0438,\n\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0438\u0435 - \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 - \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430.\n\u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u044b\n\n\u0420\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u044f", "type": "Document"}}