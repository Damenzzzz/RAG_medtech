1\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u0435 \u043a\u0438\u0441\u043b\u044b\u043c\n\u0436\u0435\u043b\u0443\u0434\u043e\u0447\u043d\u044b\u043c\n\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u044b\u043c\n\n\u0414\u0438\u0444\u0442\u0435\u0440\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u2022 \u043f\u043e\u043f\u0435\u0440\u0445\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u0438\u0449\u0435\u0439 \u2022 \u043e\u0441\u043c\u043e\u0442\u0440 \u0437\u0435\u0432\u0430 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u043b\u043e\u0442\u043d\u043e\u0439 \u0444\u0438\u0431\u0440\u043e\u0437\u043d\u043e\u0439,\n\u2022 \u043a\u0430\u0448\u0435\u043b\u044c \u2022 \u043b\u0430\u0440\u0438\u043d\u0433\u043e\u0441\u043a\u043e\u043f\u0438\u044f \u0442\u0440\u0443\u0434\u043d\u043e \u0441\u043d\u0438\u043c\u0430\u0435\u043c\u043e\u0439 \u043f\u043b\u0435\u043d\u043a\u0438 \u043d\u0430\n\u2022 \u041e\u0441\u0438\u043f\u043b\u043e\u0441\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0430 \u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445\n\u2022 \u0420\u0432\u043e\u0442\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\n\u0430\u043f\u043f\u0435\u0442\u0438\u0442\u0430\n\u2022 \u0431\u043e\u043b\u044c \u0432 \u0433\u043e\u0440\u043b\u0435\n\u2022 \u0444\u0438\u0431\u0440\u043e\u0437\u043d\u0430\u044f \u043f\u043b\u0435\u043d\u043a\u0430 \u043d\u0430\n\u043c\u0438\u043d\u0434\u0430\u043b\u0438\u043d\u0430\u0445\n\n\u2022 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435\n\u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b\n\u0434\u043e 39-40\u0421\n\u041f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u044f \u0443 \u0434\u0435\u0442\u0435\u0439 \u041a\u0430\u0448\u0435\u043b\u044c, \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435 \u0420\u0435\u043d\u0442\u0433\u0435\u043d \u043b\u0435\u0433\u043a\u0438\u0445 \u2022 \u041f\u0440\u0438 \u0440\u0435\u043d\u0442\u0433\u0435\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u0438\n\u0434\u044b\u0445\u0430\u043d\u0438\u044f, \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0435\u0434\u044b \u0433\u0440\u0443\u0434\u043d\u043e\u0439 \u043a\u043b\u0435\u0442\u043a\u0438 \u0432\u044b\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u043f\u043d\u0435\u0432\u043c\u043e\u043d\u0438\u0438\n\n3. \u0422\u0410\u041a\u0422\u0418\u041a\u0410 \u041b\u0415\u0427\u0415\u041d\u0418\u042f \u041d\u0410 \u0410\u041c\u0411\u0423\u041b\u0410\u0422\u041e\u0420\u041d\u041e\u041c \u0423\u0420\u041e\u0412\u041d\u0415 [7]: \u0432\u0441\u0435 \u0441\u043b\u0443\u0447\u0430\u0438\n\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0445 \u0442\u0435\u043b \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f \u043d\u0430 \u0438\u0445 \u0437\u0430\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435\n\n\u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438.\n\n3.1\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u0441\u0444\u0430\u0433\u0438\u0438;\n\u2022 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0444\u0438\u0437\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430;\n\n\u2022 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u043a\u0440\u043e\u0432\u0438;\n\u2022 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0431\u043e\u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0438\u043d\u0434\u0440\u043e\u043c\u0430;\n\n\u2022 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0430\u0441\u0441\u0430\u0436\u0430 \u043f\u0438\u0449\u0438\n\n4. \u041f\u041e\u041a\u0410\u0417\u0410\u041d\u0418\u042f \u0414\u041b\u042f \u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418 \u0421 \u0423\u041a\u0410\u0417\u0410\u041d\u0418\u0415\u041c \u0422\u0418\u041f\u0410\n\u0413\u041e\u0421\u041f\u0418\u0422\u0410\u041b\u0418\u0417\u0410\u0426\u0418\u0418:\n4.1 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u043d\u0435\u0442.\n\n4.2 \u041f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: \u0432\u0441\u0435 \u0441\u043b\u0443\u0447\u0430\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0445\n\u0438\u043d\u043e\u0440\u043e\u0434\u043d\u044b\u0445 \u0442\u0435\u043b \u043f\u0438\u0449\u0435\u0432\u043e\u0434\u0430 \u0438 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f \u043d\u0430 \u0438\u0445 \u0437\u0430\u0433\u043b\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0439\n\u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u042d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u0430\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e \u043c\u0435\u0441\u0442\u0443 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0439\n\n\u0441\