0438;\n2\n\u043e\u043f\u0443\u0445\u043e\u043b\u044c \u0431\u043e\u043b\u0435\u0435 4 \u0441\u043c \u0432 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u043c \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u0438\u043b\u0438 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u044e\u0449\u0430\u044f\u0441\u044f \u0434\u043e\n\u0422\n3\n\u044f\u0437\u044b\u043a\u043e\u0432\u043e\u0439 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043d\u0430\u0434\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u0438\u043a\u0430;\n\u043e\u043f\u0443\u0445\u043e\u043b\u044c \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b: \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u043c\u044b\u0448\u0446\u044b \u044f\u0437\u044b\u043a\u0430\n(\u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043e\u0447\u043d\u043e-\u044f\u0437\u044b\u0447\u043d\u0443\u044e, \u043f\u043e\u0434\u044a\u044f\u0437\u044b\u0447\u043d\u043e-\u044f\u0437\u044b\u0447\u043d\u0443\u044e, \u043d\u0435\u0431\u043d\u043e-\u044f\u0437\u044b\u0447\u043d\u0443\u044e \u0438 \u0448\u0438\u043b\u043e\u0432\u0438\u0434\u043d\u043e-\n\u0422\n4 \u044f\u0437\u044b\u0447\u043d\u0443\u044e), \u043c\u0435\u0434\u0438\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0443 \u043a\u0440\u044b\u043b\u043e\u0432\u0438\u0434\u043d\u043e\u0433\u043e \u043e\u0442\u0440\u043e\u0441\u0442\u043a\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043a\u043e\u0441\u0442\u0438,\n\u043d\u0438\u0436\u043d\u044e\u044e \u0447\u0435\u043b\u044e\u0441\u0442\u044c, \u0442\u0432\u0435\u0440\u0434\u043e\u0435 \u043d\u0451\u0431\u043e, \u0433\u043e\u0440\u0442\u0430\u043d\u044c; \u043a\u0440\u044b\u043b\u043e\u0432\u0438\u0434\u043d\u044b\u0435 \u043c\u044b\u0448\u0446\u044b, \u043a\u0440\u044b\u043b\u043e\u0432\u0438\u0434\u043d\u044b\u0435\n\n\u043e\u0442\u0440\u043e\u0441\u0442\u043a\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043a\u043e\u0441\u0442\u0438, \u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0442\u0435\u043d\u043a\u0443 \u043d\u043e\u0441\u043e\u0433\u043b\u043e\u0442\u043a\u0438, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0447\u0435\u0440\u0435\u043f\u0430\n\u0438\u043b\u0438 \u043d\u0430 \u0441\u0442\u0435\u043d\u043a\u0443 \u0441\u043e\u043d\u043d\u043e\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0438.\n\nN \u2013 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0435 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0443\u0437\u043b\u044b (\u044016 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0435):\n\nN \u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0434\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432;\nx\nN \u041d\u0435\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u043e\u0432;\n0\nN1 \u2013 \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u0432 \u043e\u0434\u043d\u043e\u043c \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0443\u0437\u043b\u0435 \u043d\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0434\u043e 3 \u0441\u043c \u0438\nN\n1 \u043c\u0435\u043d\u0435\u0435 \u0432 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u043c \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438;\nN \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u043a\u0430\u043a:\n2\nN \u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u043f\u0441\u0438\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u043c \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0443\u0437\u043b\u0435 \u0431\u043e\u043b\u0435\u0435 3 \u0441\u043c, \u043d\u043e \u043d\u0435\n2\u0430\n\u0431\u043e\u043b\u0435\u0435 6 \u0441\u043c \u0432 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u043c \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u0431\u0435\u0437 \u044d\u043a\u0441\u0442\u0440\u0430\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f;\n\u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u0432 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0438\u043f\u0441\u0438\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 6\u0441\u043c \u0432 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u043c\nN\n2b \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0438 \u0431\u0435\u0437 \u044d\u043a\u0441\u0442\u0440\u0430\u043d\u043e\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f;\n\u043c\u0435\u0442\u0430\u0441\u0442\u0430\u0437\u044b \u0432 \u0434\u0432\u0443\u0445\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0445 \u0438\u043b\u0438 \u043a\u043e\u043d\u0442\u0440\u043b\u0430\u0442\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u043b\u0438\u043c\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0443\u0437\u043b\u0430\u0445 \u043d\u0435\nN\n2\u