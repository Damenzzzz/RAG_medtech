{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"metadata": {"protocol_id": "nrchd_87839262c925", "title": "\u0411\u041e\u041b\u0415\u0417\u041d\u0418 \u041f\u0415\u0427\u0415\u041d\u0418, \u0421\u0412\u042f\u0417\u0410\u041d\u041d\u042b\u0415 \u0421 \u0411\u0415\u0420\u0415\u041c\u0415\u041d\u041d\u041e\u0421\u0422\u042c\u042e", "source_file": "2025_\u0411\u041e\u041b\u0415\u0417\u041d\u0418_\u041f\u0415\u0427\u0415\u041d\u0418_\u0421\u0412\u042f\u0417\u0410\u041d\u041d\u042b\u0415_\u0421_\u0411\u0415\u0420\u0415\u041c\u0415\u041d\u041d\u041e\u0421\u0422\u042c\u042e_2f7a2e0f1a.pdf", "icd_codes": "O21.1, O21.2, O26.6, O14.2, O82.0, O82.1, O82.2, O82.8, O82.9", "source": "nrchd_official", "year": "2025", "medicine": "", "url": "https://nrchd.kz/storage/documents/\u041a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u041f\u043e\u0442\u043e\u043a \u043a\u043b\u0438\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u044b/\u0411\u041e\u041b\u0415\u0417\u041d\u0418 \u041f\u0415\u0427\u0415\u041d\u0418, \u0421\u0412\u042f\u0417\u0410\u041d\u041d\u042b\u0415 \u0421 \u0411\u0415\u0420\u0415\u041c\u0415\u041d\u041d\u041e\u0421\u0422\u042c\u042e.pdf"}, "page_content": "\u2022\n\u0423\u0417\u0418-\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0436\u0438\u0440\u043e\u0432\u043e\u0433\u043e\n\u0433\u0435\u043f\u0430\u0442\u043e\u0437\u0430 \u043d\u0430 \u0423\u0417\u0418 \u041e\u0411\u041f.\n\u0418\u043c\u043c\u0443\u043d\u043d\u0430\u044f \u0438 \u2022 \u2022\n\u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u043f\u0435\u043d\u0438\u044f \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e\n\u0442\u0440\u043e\u043c\u0431\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f\n\u2022 \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0445 \u043f\u0440\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c \u0438\u043b\u0438\n\u0411\u0410\u041a: \u041e\u0431\u0449\u0438\u0439 \u0431\u0435\u043b\u043e\u043a, \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d,\n\u0422\u0426\u041f\u041f\n\u0434\u0430\u0436\u0435 \u2191 \u0443\u0440\u043e\u0432\u043d\u0435 \u043c\u0435\u0433\u0430\u043a\u0430\u0440\u0438\u043e\u0446\u0438\u0442\u043e\u0432;\n\u0410\u041b\u0422, \u0410\u0421\u0422, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d \u043f\u043e\n\u2022\n\u0444\u0440\u0430\u043a\u0446\u0438\u044f\u043c, \u0429\u0424, \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d, \u043c\u043e\u0440\u0444\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\n\u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430, \u043c\u043e\u0447\u0435\u0432\u0430\u044f \u043a\u0438\u0441\u043b\u043e\u0442\u0430, \u041b\u0414\u0413, \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u0430\u0445: \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0438\u0445\n\u0433\u043b\u044e\u043a\u043e\u0437\u0430, \u0421\u2013 \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a; \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u0432, \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435\n\u2022 \u043c\u0430\u043b\u043e\u0437\u0435\u0440\u043d\u0438\u0441\u0442\u044b\u0445 \u0433\u043e\u043b\u0443\u0431\u044b\u0445 \u043a\u043b\u0435\u0442\u043e\u043a,\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430;\n\u0442\u0430\u043a\u0436\u0435 \u0438\u0445 \u043f\u043e\u0439\u043a\u0438\u043b\u043e\u0446\u0438\u0442\u043e\u0437 \u0438\n\u2022\n\u043f\u0440\u044f\u043c\u0430\u044f \u043f\u0440\u043e\u0431\u0430 \u041a\u0443\u043c\u0431\u0441\u0430;\n\u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u0440\u043e\u0441\u0442\u0447\u0430\u0442\u044b\u0445 \u0444\u043e\u0440\u043c\n\u2022\n\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430;\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432;\n\u2022\n\u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u2022\n\u0430\u043d\u0435\u043c\u0438\u044f \u043f\u0440\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435;\n\u043a\u0440\u043e\u0432\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f\u0445;\n\u2022\n\u0433\u0438\u0441\u0442\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u2022\n\u043c\u0438\u0435\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430:\u2191 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0438\u043e\u043f\u0442\u0430\u0442\u0430\n\u043c\u0435\u0433\u0430\u043a\u0430\u0440\u0438\u043e\u0446\u0438\u0442\u043e\u0432, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438\n(\u0441\u0435\u043b\u0435\u0437\u0435\u043d\u043a\u0430, \u043b\u0438\u043c\u0444\u043e\u0443\u0437\u0435\u043b, \u0433\u0440\u0435\u0431\u0435\u043d\u044c\n\u043c\u0430\u043b\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\n\u043f\u043e\u0434\u0432\u0437\u0434\u043e\u0448\u043d\u043e\u0439 \u043a\u043e\u0441\u0442\u0438);\n\u043b\u0435\u0436\u0430\u0449\u0438\u0445 \u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0432,\n\u2022\n\u0423\u0417\u0418 \u041e\u0411\u041f; \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439\n\u2022 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043d\u0435\u0432\u0440\u043e\u043f\u0430\u0442\u043e\u043b\u043e\u0433\u0430 (\u043f\u0440\u0438\u0437\u043d\u0430\u043a\u043e\u0432 \u0440\u043e\u0441\u0442\u0430 \u043e\u043f\u0443\u0445\u043e\u043b\u0438) \u0432\n\u043a\u043e\u0441\u0442\u043d\u043e\u043c \u043c\u043e\u0437\u0433\u0435;\n\u2022\n\u043d\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\n\u0433\u0438\u043f\u043e\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u0446\u0438\u044f;\n\u2022\n\u0438\u043c\u043c\u0443\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0435\n\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435: \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0432\n\u043a\u0440\u043e\u0432\u0438 \u0430\u043d\u0442\u0438\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u0430\u0440\u043d\u044b\u0445\n\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u043e\u0430\u0441\u0441\u043e\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445(Tp\n22\n\nA-IgG)\u0430\u043d\u0442\u0438\u0442\u0435\u043b;\n\u2022\n\u041f\u0440\u0438 \u0442\u0440\u043e\u043c\u0431\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0422\u0426\u041f\u041f:\n- \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043d\u0435\u0432\u0440\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0439\n\u0441\u0438\u043c\u043f\u0442\u043e\u043c\u0430\u0442\u0438\u043a\u0438;\n- \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445\n\u0442\u0440\u043e\u043c\u0431\u043e\u0432.\n\u2022\n\u0441\u0443\u0441\u0442\u0430\u0432\u043d\u043e\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c;\n\u2022\n\u043a\u0435\u043f\u0430\u0442\u043e\u0441\u043f\u043b\u0435\u043d\u043e\u043c\u0435\u0433\u0430\u043b\u0438\u044f.\n\u0413\u0435\u043c\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u2022 \u2022\n\u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u0433\u0438\u043f\u0435\u0440\u043a\u0430\u043b\u0438\u0435\u043c\u0438\u044f;\n\u0443\u0440\u0435\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0441\u0438\u043d\u0434\u0440\u043e\u043c\n\u2022 \u2022\n\u0411\u0410\u041a: \u041a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d, \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u0430, \u0433\u0438\u043f\u043e\u043d\u0430\u0442\u0440\u0438\u0435\u043c\u0438\u044f;\n\u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u044b, \u043e\u0431\u0449\u0438\u0439 \u0431\u0435\u043b\u043e\u043a, \u0410\u041b\u0422, \u2022\n\u2191 \u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d\u0430;\n\u0410\u0421\u0422, \u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d \u043f\u043e \u0444\u0440\u0430\u043a\u0446\u0438\u044f\u043c, \u0421-\n\u2022\n\u2193 \u0421\u041a\u0424;\n\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a, \u041b\u0414\u0413;\n\u2022\n\u2191 \u043c\u043e\u0447\u0435\u0432\u0438\u043d\u044b;\n\u2022\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430;\n\u2022\n\u2191 \u041b\u0414\u0413.\n\u2022\n\u041a\u041e\u0421;\n\u2022\nANA, ENA, ANCA,\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0434\u0432\u0443\u0446\u0435\u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439 \u0414\u041d\u041a;\n\u2022\n\u043f\u0440\u043e\u0431\u0430 \u0420\u0435\u0431\u0435\u0440\u0433\u0430-\u0422\u0430\u0440\u0435\u0435\u0432\u0430;\n\u2022\n\u0423\u0417\u0418 \u043f\u043e\u0447\u0435\u043a.\n\u0421\u041a\u0412 \u2022 \u2022\n\u041e\u0410\u041a+\u0442\u0440\u043e\u043c\u0431\u043e\u0446\u0438\u0442\u044b; \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0438\n\u2022 \u043c\u0430\u043b\u044b\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438\n\u041e\u0410\u041c;\n\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u043c\u0443\n\u2022\n\u0411\u0410\u041a: \u041e\u0431\u0449\u0438\u0439 \u0431\u0435\u043b\u043e\u043a, \u0430\u043b\u044c\u0431\u0443\u043c\u0438\u043d,\n\u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0443\n\u0431\u0435\u043b\u043a\u043e\u0432\u044b\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438, \u0410\u041b\u0422, \u0410\u0421\u0422,\n\u0431\u0438\u043b\u0438\u0440\u0443\u0431\u0438\u043d \u043f\u043e \u0444\u0440\u0430\u043a\u0446\u0438\u044f\u043c, \u0421-\n\u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0431\u0435\u043b\u043e\u043a, \u0445\u043e\u043b\u0435\u0441\u0442\u0435\u0440\u0438\u043d,\n\u043a\u0440\u0435\u0430\u0442\u0438\u043d\u0438\u043d, \u0433\u043b\u044e\u043a\u043e\u0437\u0430, \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043e\u0447\u043d\u043e\u0435\n23\n\n\u0436\u0435\u043b\u0435\u0437\u043e;\n\u2022\n\u043a\u043e\u0430\u0433\u0443\u043b\u043e\u0433\u0440\u0430\u043c\u043c\u0430;\n\u2022\nANA, \u0410\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a\n\u043e\u0434\u043d\u043e\u0446\u0435\u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439, \u0434\u0432\u0443\u0446\u0435\u043f\u043e\u0447\u0435\u0447\u043d\u043e\u0439\n\u0414\u041d\u041a;\n\u2022\n\u04213-\u04214 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u043a\u043e\u043c\u043f\u043b\u0438\u043c\u0435\u043d\u0442\u0430;\n\u2022\n\u0432\u043e\u043b\u0447\u0430\u043d\u043e\u0447\u043d\u044b\u0439 \u0430\u043d\u0442\u0438\u043a\u043e\u0430\u0433\u0443\u043b\u044f\u043d\u0442;\n\u2022\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u0444\u043e\u0441\u0444\u043e\u043b\u0438\u043f\u0438\u0434\u0430\u043c;\n\u2022\n\u0430\u043d\u0442\u0438\u0442\u0435\u043b\u0430 \u043a \u043a\u0430\u0440\u0434\u0438\u043e\u043b\u0438\u043f\u0438\u043d\u0443.\n4) \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u04