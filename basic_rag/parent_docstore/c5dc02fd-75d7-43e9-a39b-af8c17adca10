3e\u0433\u043d\u043e\u0437 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439, \u043e\u0434\u043d\u0430\u043a\u043e\n\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u043d\u0438\u044f \u2013 \u0437\u0430\u0442\u044f\u0436\u043d\u043e\u0435, \u0441 \u0447\u0430\u0441\u0442\u044b\u043c\u0438 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430\u043c\u0438.\n\u041f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u043a\u0430: \u043f\u0440\u043e\u0444\u0438\u043b\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0435\u0440\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u0433\u0438\u0433\u0438\u0435\u043d\u0443 \u043a\u0440\u0430\u0435\u0432 \u0432\u0435\u043a,\n\u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0438\u043d\u0444\u0435\u043a\u0446\u0438\u0438 \u043f\u0435\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0442\u0440\u0435\u0437\u043a\u0430 \u0433\u043b\u0430\u0437\u0430, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043e\u0431\u0449\u0435\u0433\u043e\n\u0438\u043c\u043c\u0443\u043d\u0438\u0442\u0435\u0442\u0430.\n\n3.5 \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f:\n\u2022 \u0438\u0441\u0447\u0435\u0437\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u043e\u0432: \u043f\u043e\u043a\u0440\u0430\u0441\u043d\u0435\u043d\u0438\u044f \u0438 \u043e\u0442\u0435\u043a\u0430 \u043a\u0440\u0430\u0435\u0432 \u0432\u0435\u043a, \u0437\u0443\u0434\u0430, \u0436\u0436\u0435\u043d\u0438\u044f,\n\u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u0438\u043d\u043e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0430, \u0441\u043b\u0435\u0437\u043e\u0442\u0435\u0447\u0435\u043d\u0438\u044f, \u0447\u